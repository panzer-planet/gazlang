/*
 * A Brainfuck interpreter: the program is compiled to a list of instructions first, folding
 * runs like +++++ into one and pairing each [ with its ], then run on a tape of bytes.
 *
 *   bin/gaz examples/brainfuck.gaz [FILE | squares]
 *
 * Input for , comes from standard input. Without a file it runs the programs below; squares
 * runs a longer one.
 */
import "std/chars.gaz" use span;

// Hello World!, from the Wikipedia article
const HELLO = "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>.<-.<.+++.------.--------.>>+.>++.";

// The squares from 0 to 10000, by Daniel B. Cristofani
const SQUARES = "++++[>+++++<-]>[<+++++>-]+<+[>[>+>+<<-]++>>[<<+>>-]>>>[-]++>[-]+>>>+[[-]++++++>>>]<<<[[<++++++++<++>>-]+<.<[>----<-]<]<<[>>>>>[>>>[-]+++++++++<[>-<-]+++++++++>[-[<->-]+[<<<]]<[>+<-]>]<<-]<<-]";

// What an instruction does: the program's characters, with runs folded and [-] as Zero
enum Op {
    Add;        // add n to the cell, wrapping at 256 (a run of - adds what wraps round to it)
    Right;      // move n cells right
    Left;       // move n cells left
    Open;       // [: jump to n, the matching ], when the cell is 0
    Close;      // ]: jump back to n, the matching [, unless the cell is 0
    Output;
    Input;
    Zero;       // [-]: set the cell to 0
}

// An instruction keeps what it does; n is filled in later for an Open, once its ] is found
kind Instruction {
    fn _(pub readonly Op #op, pub int #n = 0);
}

// What the tape holds and where a program is, while it runs
kind Machine {
    list #tape = [0];
    int #at = 0;
    int #read = 0;
    string #output = "";

    fn _(string #input);

    pub fn run(list $code): string {
        $pc = 0;
        while ($pc < len($code)) {
            $instruction = $code[$pc];
            $n = $instruction.n;
            match ($instruction.op) {
                Op::Add => { #tape[#at] = (#tape[#at] + $n) & 255; }
                Op::Right => {
                    #at += $n;
                    while (#at >= len(#tape)) {
                        #tape[] = 0;
                    }
                }
                Op::Left => {
                    #at -= $n;
                    if (#at < 0) {
                        throw "The pointer moved left of the tape at instruction {$pc}";
                    }
                }
                Op::Open => {
                    if (#tape[#at] == 0) {
                        $pc = $n;
                    }
                }
                Op::Close => {
                    if (#tape[#at] != 0) {
                        $pc = $n;
                    }
                }
                Op::Output => { #output ..= chr(#tape[#at]); }
                Op::Input => {
                    // End of input leaves the cell as it is
                    if (#read < len(#input)) {
                        #tape[#at] = ord(#input[#read]);
                        #read++;
                    }
                }
                Op::Zero => { #tape[#at] = 0; }
            }
            $pc++;
        }
        return #output;
    }
}

// The program as a list of instructions, each [ paired with its ]
fn compile(string $source): list {
    $code = [];
    $open = [];
    $i = 0;
    while ($i < len($source)) {
        $c = $source[$i];
        match ($c) {
            "+", "-", ">", "<" => {
                // A run of one character
                $run = span($source, $i, $x -> $x == $c);
                $i += $run;
                $code[] = match ($c) {
                    "+" => Instruction(Op::Add, $run % 256),
                    "-" => Instruction(Op::Add, (256 - $run % 256) % 256),
                    ">" => Instruction(Op::Right, $run),
                    "<" => Instruction(Op::Left, $run),
                };
                continue;
            }
            "[" => {
                if (slice($source, $i, 3) == "[-]") {
                    $code[] = Instruction(Op::Zero);
                    $i += 3;
                    continue;
                }
                $open[] = len($code);
                $code[] = Instruction(Op::Open);
            }
            "]" => {
                if (len($open) == 0) {
                    throw "Unmatched ] at character {$i}";
                }
                [...$open, $start] = $open;
                $code[$start].n = len($code);
                $code[] = Instruction(Op::Close, $start);
            }
            "." => { $code[] = Instruction(Op::Output); }
            "," => { $code[] = Instruction(Op::Input); }
            default => {}           // anything else is a comment
        }
        $i++;
    }
    if (len($open) > 0) {
        throw "Unmatched [ at instruction " .. last($open);
    }
    return $code;
}

fn brainfuck(string $source, string $input = ""): string {
    return Machine($input).run(compile($source));
}

$arguments = args();
if (len($arguments) == 0) {
    print(brainfuck(HELLO));
    echo "Reversed by a program: " .. brainfuck(">,[>,]<[.<]", "stressed");
} else if ($arguments[0] == "squares") {
    $squares = split(trim(brainfuck(SQUARES)), "\n");
    echo "The squares up to 10000: " .. len($squares) .. " of them, the last " .. last($squares);
} else {
    print(brainfuck(read_file($arguments[0]), read_stdin()));
}
