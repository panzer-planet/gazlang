/*
 * sitecopy: copy the files of a tree that match a pattern into another tree, making folders as
 * needed, and skip each file whose copy is up to date. A copy keeps its source's mode and
 * modification time, so up to date means the same time and size. What a static site's deploy
 * step does.
 *
 *   gaz examples/sitecopy.gaz site public/'**' /var/www/site
 *   gaz examples/sitecopy.gaz --dry-run docs '**' '*.md' /tmp/docs
 *
 * Patterns are relative to the source: * and ? match within one name, [abc] one of a set, and
 * "**" as a whole name any number of folders. A name starting with a dot is matched only by a
 * pattern name that starts with one.
 *
 * What it shows: fs::glob(), file_info()'s modification times compared, make_dir() with its
 * parents and fs::copy() keeping the time. (The first example quotes its pattern oddly because a block comment
 * nests, and a slash right before a star would open another one.)
 */
import "std/cli.gaz";
import "std/fs.gaz";

kind Plan {
    pub list #copied = [];
    pub list #fresh = [];
}

// The files under $from matching any of $patterns, relative to $from, sorted and each once
fn matching(string $from, list $patterns): list {
    $found = {};
    $prefix = len($from) + 1;
    foreach ($patterns as $pattern) {
        foreach (fs::glob($from .. "/" .. $pattern) as $path) {
            if (file_info($path)["kind"] == "file") {
                $found[slice($path, $prefix)] = true;
            }
        }
    }

    return sort(keys($found));
}

/*
 * Whether $target is missing or differs from $source in modification time or size. A copy is
 * given its source's time, so any change to the source, even to an older version, shows.
 * ponytail: times are whole seconds, so a source changed to the same size within the second its
 * last copy was taken looks copied; nanoseconds in file_info() and set_mtime() would lift it.
 */
fn needs_copy(string $source, string $target): bool {
    $copy = file_info($target);
    if ($copy == null) {
        return true;
    }
    $original = file_info($source);

    return $original["mtime"] != $copy["mtime"] || $original["size"] != $copy["size"];
}

fn copy_file(string $source, string $target): null {
    make_dir(fs::parent($target), true);
    fs::copy($source, $target, true);
}

fn plan_and_copy(string $from, list $patterns, string $to, bool $dry_run): Plan {
    $plan = Plan();
    foreach (matching($from, $patterns) as $path) {
        $source = $from .. "/" .. $path;
        $target = $to .. "/" .. $path;
        if (!needs_copy($source, $target)) {
            $plan.fresh[] = $path;
            continue;
        }
        if (!$dry_run) {
            copy_file($source, $target);
        }
        $plan.copied[] = $path;
    }

    return $plan;
}

$cli = cli::Command("sitecopy", "Copy the files matching patterns into another tree, newer files only");
$cli.flag("dry-run", "n", "Say what would be copied, and copy nothing");
$cli.argument("source", "The tree to copy from");
$cli.rest("patterns", "Glob patterns, relative to the source, then the destination last");
$options = $cli.parse(args());

$rest = $options["patterns"];
if (len($rest) < 2) {
    print_error("sitecopy: give at least one pattern and a destination\n");
    exit(2);
}
$from = $options["source"];
$to = last($rest);
$patterns = slice($rest, 0, -1);
if (!is_dir($from)) {
    print_error("sitecopy: {$from} is not a directory\n");
    exit(1);
}

$plan = plan_and_copy($from, $patterns, $to, $options["dry-run"]);
$verb = $options["dry-run"] ? "would copy" : "copied";
foreach ($plan.copied as $path) {
    echo "{$verb} {$path}";
}
echo "{$verb} " .. len($plan.copied) .. " files, " .. len($plan.fresh) .. " already up to date";
