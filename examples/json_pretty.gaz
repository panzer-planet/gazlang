// Pretty-print JSON with two-space indentation, keeping key order.
//
//   bin/gazlang -f examples/json_pretty.gaz [-- FILE]
//
// With no file it formats the sample below; invalid JSON stops with an error and exit code 1.
include "../lib/json.gaz";

fn pretty($value, $indent = "") {
    $type = type_of($value);
    if (($type != "list" && $type != "map") || len($value) == 0) {
        // Scalars, [] and {} are already as short as they get
        return json::encode($value);
    }

    $inner = $indent .. "  ";
    $lines = [];
    foreach ($value as $key => $item) {
        $prefix = $type == "map" ? json::encode(to_string($key)) .. ": " : "";
        $lines[] = $inner .. $prefix .. pretty($item, $inner);
    }
    $brackets = $type == "map" ? "{}" : "[]";
    return $brackets[0] .. "\n" .. join($lines, ",\n") .. "\n" .. $indent .. $brackets[1];
}

$text = '{"name":"gazlang","version":2,"backends":["interpreter","vm"],"features":{"closures":true,"objects":null},"tags":[],"meta":{}}';
$arguments = args();
if (len($arguments) > 0) {
    $text = read_file($arguments[0]);
}

try {
    echo pretty(json::decode($text));
} catch ($e) {
    echo "Error: {$e.message}";
    exit(1);
}
