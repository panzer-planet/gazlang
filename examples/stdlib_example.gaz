// A tiny tokenizer built on the standard library.
// Run it on its own string, or pass a file:  php bin/gazlang -f examples/stdlib_example.gaz -- some_file.txt
include "../lib/chars.gaz";

function tokenize($source) {
    $tokens = [];
    $i = 0;
    while ($i < len($source)) {
        $c = $source[$i];
        $start = $i;
        if (is_space($c)) {
            $i = $i + 1;
        } else if (is_digit($c)) {
            while (is_digit(char_at($source, $i))) { $i = $i + 1; }
            $tokens[] = ["INTEGER", to_int(slice($source, $start, $i - $start))];
        } else if (is_alpha($c) || $c === "_") {
            while (is_alnum(char_at($source, $i)) || char_at($source, $i) === "_") { $i = $i + 1; }
            $tokens[] = ["WORD", slice($source, $start, $i - $start)];
        } else if (in_array($c, ["+", "-", "*", "/", "(", ")", ";"])) {
            $tokens[] = ["SYMBOL", $c];
            $i = $i + 1;
        } else {
            error("Unexpected character " + $c + " at position " + $i);
        }
    }
    return $tokens;
}

$source = "echo 12 * (x + 3);";
if (len(args()) > 0) {
    $source = read_file(args()[0]);
}

$tokens = tokenize($source);
echo $tokens;

// Count tokens per type with a map
$counts = [];
for ($t = 0; $t < len($tokens); $t = $t + 1) {
    $type = $tokens[$t][0];
    if (!has_key($counts, $type)) {
        $counts[$type] = 0;
    }
    $counts[$type] = $counts[$type] + 1;
}
$types = keys($counts);
for ($t = 0; $t < len($types); $t = $t + 1) {
    echo $types[$t] + ": " + $counts[$types[$t]];
}
echo type_of($tokens) + " of " + to_string(len($tokens));
