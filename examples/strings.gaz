// Strings: interpolation, escapes and the string builtins.
//
//   php bin/gazlang -f examples/strings.gaz

include "../lib/functional.gaz";

$name = "Gaz";
$user = {"name" => "Werner", "roles" => ["admin", "dev"]};
@visits = 41;

// Double quotes interpolate $name, one index like $list[0] or $map[key], and any
// expression starting with $ or @ inside braces
echo "Hello, $name!";                           // Hello, Gaz!
echo "Roles: $user[roles]";                     // Roles: ["admin", "dev"]
echo "{$user["name"]} has {@visits + 1} visits";   // Werner has 42 visits
echo "Missing: {$user["email"] ?? "none"}";     // Missing: none

// .. concatenates and converts like echo; + is only for numbers
echo "n = " .. 1 + 2 .. ", ok = " .. true;      // n = 3, ok = true

// Escapes in double quotes; single quotes are raw
echo "tab:\t| quote:\" | dollar: \$name | brace: \{\$x}";
echo 'raw: $name {$x} \n';
echo "\u{1F600} is " .. len("\u{1F600}") .. " bytes";   // strings are bytes

// Builtins
$csv = "  red, green ,blue  ";
$colours = map(split($csv, ","), trim);
echo $colours;                                  // ["red", "green", "blue"]
echo join($colours, " | ");                     // red | green | blue
echo upper(slice("gazlang", 0, 3)) .. lower("LANG");   // GAZlang
echo replace("a-b-c", "-", "::");               // a::b::c
echo index_of("hello world", "o") .. " " .. index_of("hello world", "o", 5);   // 4 7
echo index_of("hello", "z") ?? "not found";     // not found
echo starts_with("gazlang", "gaz") && ends_with("gazlang", "lang") && contains("gazlang", "zla");   // true
echo repeat("=-", 5);                           // =-=-=-=-=-
echo ord("A") .. " " .. chr(97);                // 65 a

// Indexing gives a one character string; past the end is an error unless asked with ??
$word = "gaz";
echo $word[0] .. ($word[3] ?? "?");            // g?

// Strings never silently turn into numbers: convert explicitly
echo to_int("42") + 1;                          // 43
echo to_float("2.5") * 2;                       // 5.0
echo "5" == 5;                                  // false
