$n = 5;
$fact = 1;
for ($i = 2; $i <= $n; $i = $i + 1) {
    $fact = $fact * $i;
}
echo "5! = " + $fact;

// Countdown
while ($n > 0) {
    echo $n;
    $n = $n - 1;
}
// First even number from 12 that is not a multiple of 3 (prints 14)
for ($n = 12; $n < 100; $n = $n + 1) {
    if ($n / 2 * 2 !== $n) { continue; }
    if ($n / 3 * 3 === $n) { continue; }
    echo $n;
    break;
}
