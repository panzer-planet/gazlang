// Functions, function values and closures.
//
//   php bin/gazlang -f examples/functions.gaz

include "../lib/functional.gaz";

// Named functions live at the top level and can be called before they are declared.
// $ variables are local to the call; @ variables are global.
echo fib(20);                                   // 6765

function fib($n) {
    return $n < 2 ? $n : fib($n - 1) + fib($n - 2);
}

// Defaults can use earlier parameters, and are evaluated on each call
function greet($name, $greeting = "Hello", $line = "$greeting, $name!") {
    return $line;
}
echo greet("Gaz");                              // Hello, Gaz!
echo greet("Gaz", "Howzit");                    // Howzit, Gaz!

// A bare function name is a value, builtins too
$shout = upper;
echo $shout("quiet");                           // QUIET
$handlers = {"double" => $x -> $x * 2, "length" => len};
echo $handlers["length"]("four");               // 4

// Anonymous functions: an expression body returns its value, a block body uses return
$square = $x -> $x * $x;
$clamp = ($x, $low = 0, $high = 10) -> {
    if ($x < $low) { return $low; }
    return $x > $high ? $high : $x;
};
echo map([-5, 3, 42], $clamp);                  // [0, 3, 10]
echo reduce(filter(map([1, 2, 3, 4], $square), $x -> $x % 2 == 0), ($sum, $x) -> $sum + $x, 0);   // 20

// Closures copy the variables they use when they are made...
$rate = 15;
$with_tax = $amount -> $amount + $amount * $rate / 100;
$rate = 0;
echo $with_tax(200);                            // 230.0

// ...and keep them between calls, so a closure can hold state
function counter($start = 0) {
    $n = $start;
    return () -> ++$n;
}
$tickets = counter(100);
$tickets();
echo $tickets();                                // 102
echo counter()();                               // 1: every counter() has its own $n

// A lambda assigned to a variable can call itself through it, and its
// captured variables are shared by the recursive calls: here, a memo
$memo = {};
$paths = $n -> $memo[$n] ??= ($n < 2 ? 1 : $paths($n - 1) + $paths($n - 2));
echo $paths(90);                                // 4660046610375530309

// A plain = inside a lambda makes a variable local to each call
$total = 0;
$sum_to = $n -> {
    $total = 0;
    for ($i = 1; $i <= $n; $i++) { $total += $i; }
    return $total;
};
echo $sum_to(100) .. " " .. $total;             // 5050 0

// Sorting with a comparator, stable: ties keep their order
$people = [{"name" => "Ada", "age" => 36}, {"name" => "Bob", "age" => 25}, {"name" => "Cy", "age" => 36}];
echo map(sort($people, ($a, $b) -> $b["age"] <=> $a["age"]), $p -> $p["name"]);   // ["Ada", "Cy", "Bob"]
