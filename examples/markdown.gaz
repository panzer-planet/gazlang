/*
 * Turn a little Markdown into HTML: headings, paragraphs, lists, block quotes, fenced code,
 * and inside text **bold**, *emphasis*, `code` and [links](url).
 *
 *   bin/gazlang -f examples/markdown.gaz [-- FILE]
 *
 * Without a file it converts the document below. Not CommonMark: a block is one kind of
 * thing, and emphasis doesn't nest inside itself.
 */

include "../lib/regex.gaz";

const DOCUMENT = "# GazLang notes

A *small* language with **values, not references**, and a VM in C.
Lines next to each other make one paragraph.

## What to try

- Run `bin/gazlang -f examples/markdown.gaz`
- Read [the reference](docs/language.md) and the **bold** parts
- Escape <html> & friends

1. Write a program
2. Find what *hurts*
3. Fix it

> Grow the language by writing real GazLang
> and fixing what hurts.

```
fn greet(\$name) {
    return \"Hello, {\$name} <3\";
}
```
";

// What a character stands for in HTML
fn escape($text) {
    return replace(replace(replace($text, "&", "&amp;"), "<", "&lt;"), ">", "&gt;");
}

// Text with its inline markup turned into tags; the text between is escaped
fn inline($text) {
    $html = "";
    $i = 0;
    while ($i < len($text)) {
        [$tag, $end] = inline_at($text, $i) ?? [escape($text[$i]), $i + 1];
        $html ..= $tag;
        $i = $end;
    }
    return $html;
}

// The markup starting at $i as [html, where it ends], or null when there is none
fn inline_at($text, $i) {
    // The longest delimiter first, so ** isn't read as two *
    foreach ([["**", "strong"], ["*", "em"], ["`", "code"]] as [$mark, $tag]) {
        if (!starts_with(slice($text, $i), $mark)) {
            continue;
        }
        $close = index_of($text, $mark, $i + len($mark));
        if ($close == null || $close == $i + len($mark)) {
            continue;
        }
        $inside = slice($text, $i + len($mark), $close - $i - len($mark));
        // Code is shown as it is; anything else may hold more markup
        $body = $tag == "code" ? escape($inside) : inline($inside);
        return ["<{$tag}>{$body}</{$tag}>", $close + len($mark)];
    }
    if ($text[$i] == "[") {
        $middle = index_of($text, "](", $i);
        $close = $middle == null ? null : index_of($text, ")", $middle);
        if ($close != null) {
            $label = slice($text, $i + 1, $middle - $i - 1);
            $url = slice($text, $middle + 2, $close - $middle - 2);
            return ["<a href=\"" .. replace(escape($url), "\"", "&quot;") .. "\">" .. inline($label) .. "</a>", $close + 1];
        }
    }
    return null;
}

// What kind of block a line belongs to
fn line_kind($line) {
    return match {
        trim($line) == "" => "blank",
        starts_with($line, "```") => "fence",
        starts_with($line, "#") => "heading",
        starts_with($line, "- ") => "ul",
        regex::search($line, '^[0-9]+\. ') => "ol",
        starts_with($line, ">") => "quote",
        default => "paragraph",
    };
}

// A line without the marker that made it a list item or a quote
fn unmarked($line, $kind) {
    return match ($kind) {
        "ul" => slice($line, 2),
        "ol" => slice($line, index_of($line, ". ") + 2),
        "quote" => trim(slice($line, 1)),
        default => $line,
    };
}

fn to_html($markdown) {
    $lines = split(replace($markdown, "\r\n", "\n"), "\n");
    $html = [];
    $i = 0;
    while ($i < len($lines)) {
        $line = $lines[$i];
        $kind = line_kind($line);
        match ($kind) {
            "blank" => { $i++; }
            "fence" => {
                // Everything up to the closing fence, as it is
                $code = [];
                $i++;
                while ($i < len($lines) && !starts_with($lines[$i], "```")) {
                    $code[] = escape($lines[$i]);
                    $i++;
                }
                $i++;
                $html[] = "<pre><code>" .. join($code, "\n") .. "</code></pre>";
            }
            "heading" => {
                $level = 0;
                while ($level < len($line) && $line[$level] == "#") {
                    $level++;
                }
                $level = min($level, 6);
                $html[] = "<h{$level}>" .. inline(trim(slice($line, $level))) .. "</h{$level}>";
                $i++;
            }
            default => {
                // A run of lines of the same kind is one block
                $run = [];
                while ($i < len($lines) && line_kind($lines[$i]) == $kind) {
                    $run[] = unmarked($lines[$i], $kind);
                    $i++;
                }
                $html[] = match ($kind) {
                    "ul", "ol" => "<{$kind}>\n" .. join(map($run, $item -> "  <li>" .. inline($item) .. "</li>"), "\n") .. "\n</{$kind}>",
                    "quote" => "<blockquote><p>" .. inline(join($run, " ")) .. "</p></blockquote>",
                    default => "<p>" .. inline(join($run, " ")) .. "</p>",
                };
            }
        }
    }
    return join($html, "\n");
}

$arguments = args();
echo to_html(len($arguments) > 0 ? read_file($arguments[0]) : DOCUMENT);
