// Kinds: fields, methods, inheritance, bound methods and to_string().
//
//   bin/gazlang -f examples/objects.gaz

abstract kind Shape {
    #name;
    fn _($name) { #name = $name; }
    abstract fn area();
    fn to_string() { return "{#name} with area " .. round(#area(), 2); }
}

kind Circle extends Shape {
    #radius;
    fn _($radius) {
        ##_("circle");
        #radius = $radius;
    }
    fn area() { return 3.14159 * #radius * #radius; }
    fn to_string() { return ##to_string() .. " (r = {#radius})"; }
}

kind Rectangle extends Shape {
    #width;
    #height;
    fn _($width, $height) {
        ##_($width == $height ? "square" : "rectangle");
        #width = $width;
        #height = $height;
    }
    fn area() { return #width * #height; }
}

$shapes = [Circle(1), Rectangle(2, 3), Rectangle(2, 2)];
foreach ($shapes as $shape) {
    echo $shape;                                // circle with area 3.14 (r = 1), rectangle with area 6.0, ...
}
$by_area = sort($shapes, ($a, $b) -> $a.area() <=> $b.area());
echo "smallest: {$by_area[0]}";                 // smallest: circle with area 3.14 (r = 1)
echo "circles: " .. len(filter($shapes, $s -> is_a($s, Circle)));   // circles: 1

// Objects are handles: every reference sees the same account
kind Account {
    #owner;
    #balance = 0;
    #history = [];
    fn _($owner) { #owner = $owner; }
    fn deposit($amount) {
        if ($amount <= 0) {
            error("Deposits must be positive, got {$amount}");
        }
        #balance += $amount;
        #history[] = "+{$amount}";
        return #;
    }
    fn withdraw($amount) {
        if ($amount > #balance) {
            error("{#owner} can't withdraw {$amount} from {#balance}");
        }
        #balance -= $amount;
        #history[] = "-{$amount}";
        return #;
    }
}

$account = Account("Werner");
$same = $account;
$same.deposit(100).withdraw(30);
echo $account;                                  // Account {#owner => "Werner", #balance => 70, #history => ["+100", "-30"]}
try {
    $account.withdraw(500);
} catch ($e) {
    echo "refused: {$e.message}";            // refused: Werner can't withdraw 500 from 70
}

// A bound method remembers its object; a closure made in a method keeps #
$pay = $account.deposit;
foreach ([5, 10] as $amount) {
    $pay($amount);
}
echo "balance after payments: {$account.balance}";   // balance after payments: 85

kind Counter {
    #counts = {};
    fn counter($key) {
        return () -> {
            #counts[$key] ??= 0;
            #counts[$key]++;
        };
    }
    fn to_string() { return "Counter {#counts}"; }
}
$counter = Counter();
$apples = $counter.counter("apples");
$apples();
$apples();
$counter.counter("pears")();
echo $counter;                                  // Counter {"apples" => 2, "pears" => 1}
