/*
 * A small terminal dashboard on std/term.gaz and std/tui.gaz: up and down pick a task, + and -
 * move its progress, q quits. Needs a terminal.
 *
 * Written in the clean code style: a kind for each thing (a task, the board), small methods whose
 * names say what they do, named layout numbers, the screen cut into Rects rather than columns
 * added up, and drawing and key handling kept apart from the state they show and change.
 */
import "std/term.gaz";
import "std/tui.gaz";

const MAX_WIDTH = 64;
const PADDING = 1;         // blank columns inside the box's edges, and blank rows above and below the tasks
const NAME_WIDTH = 28;
const GAP = 1;             // columns between a task's name and its bar
const HELP = "up/down pick   +/- change   q quit";

kind Task {
    fn _(pub string #name, pub int #done, pub int #total);

    pub fn advance(): null {
        #done = min(#done + 1, #total);
    }

    pub fn set_back(): null {
        #done = max(#done - 1, 0);
    }

    pub fn progress(): float {
        return #done / #total;
    }
}

kind Board {
    int #selected = 0;

    fn _(pub list #tasks);

    pub fn select_previous(): null {
        #selected = max(#selected - 1, 0);
    }

    pub fn select_next(): null {
        #selected = min(#selected + 1, len(#tasks) - 1);
    }

    pub fn selected_task(): Task {
        return #tasks[#selected];
    }

    pub fn is_selected(int $index): bool {
        return $index == #selected;
    }
}

// The box: a row a task, the help on the last row inside, and the padding between
fn draw_board(tui::Screen $screen, Board $board): null {
    $count = len($board.tasks);
    $panel = tui::Rect(1, 1, min($screen.cols, MAX_WIDTH), $count + 2 * PADDING + 3);
    tui::box($screen, $panel, "Tasks");
    [$body, $foot] = $panel.inset(1).split_bottom(1);
    $rows = $body.inset(PADDING);
    foreach ($board.tasks as $index => $task) {
        draw_task($screen, $rows.line($index), $task, $board.is_selected($index));
    }
    tui::label($screen, $foot.inset(PADDING, 0), HELP, "dim");
}

// One task on $line: its name, then its progress bar in the rest of the row
fn draw_task(tui::Screen $screen, tui::Rect $line, Task $task, bool $selected): null {
    [$name, $rest] = $line.split_left(NAME_WIDTH);
    [, $bar] = $rest.split_left(GAP);
    $marker = $selected ? "> " : "  ";
    tui::label($screen, $name, $marker .. $task.name, $selected ? "bold" : "");
    tui::progress($screen, $bar, $task.progress(), $selected ? "cyan" : "blue");
}

// What a key does to the board; "quit" ends the dashboard, as tui::interact asks
fn handle_key(Board $board, map $key): ?string {
    match (term::name($key)) {
        "up" => { $board.select_previous(); }
        "down" => { $board.select_next(); }
        "+", "=" => { $board.selected_task().advance(); }
        "-" => { $board.selected_task().set_back(); }
        "q", "ctrl+c" => { return "quit"; }
        default => {}
    }
    return null;
}

$board = Board([
    Task("Write the lexer", 10, 10),
    Task("Write the parser", 8, 10),
    Task("Write the code generator", 5, 10),
    Task("Write the VM", 3, 10),
    Task("Write the docs", 0, 10),
]);
tui::interact($screen -> draw_board($screen, $board), $key -> handle_key($board, $key));
