// A football league simulator: rated players, a double round-robin season with commentary
// on the opening match, the final table and the top scorers.
//
//   bin/gazlang -f examples/football.gaz -- [CLUBS] [SEED]
//
// CLUBS is how many clubs play, from 2 to 20 (4 by default), taken from the strongest down.
// Everything random is seeded: the squads are always the same, and the same season seed
// always plays the same season.
include "../lib/format.gaz" use pad_left, pad_right;
include "../lib/random.gaz";

// Players: a rating from 40 to 95, and every position turns it into attacking and defending

abstract kind Player {
    #name;
    pub #rating;
    kin #energy = 100;
    // What form() gives at the current energy, kept up to date by rest() and tire()
    kin #sharpness = 0;
    pub #goals = 0;
    pub #yellow_cards = 0;
    pub #sent_off = false;

    fn _($name, $rating) {
        #name = $name;
        #rating = $rating;
    }

    pub abstract fn position();
    pub abstract fn attacking();
    pub abstract fn defending();
    // How much running the position does, which tires the player
    pub abstract fn work_rate();

    // How well the player is playing right now. Ability grows with the square of the rating,
    // so a 90 is far more dangerous than a 70, and tiredness wears it down
    pub fn form() {
        $ability = #rating / 75.0;
        return 70 * $ability * $ability * (60 + #energy * 0.4) / 100;
    }

    pub fn tire($minutes) {
        #energy = max(#energy - $minutes * #work_rate(), 40);
        #sharpness = #form();
    }

    pub fn rest() {
        #energy = 100;
        #sharpness = #form();
        #yellow_cards = 0;
        #sent_off = false;
    }

    // A booking; the second yellow card is a red one
    pub fn book() {
        #yellow_cards++;
        #sent_off = #yellow_cards == 2;
        return #sent_off;
    }

    pub fn to_string() { return #name; }
    pub fn profile() { return "{#name} ({#position()} {#rating})"; }
}

kind Goalkeeper extends Player {
    pub fn position() { return "GK"; }
    pub fn work_rate() { return 0.2; }
    pub fn attacking() { return 0; }
    pub fn defending() { return #sharpness; }
}

kind Defender extends Player {
    pub fn position() { return "DF"; }
    pub fn work_rate() { return 0.8; }
    pub fn attacking() { return #sharpness * 0.2; }
    pub fn defending() { return #sharpness; }
}

kind Midfielder extends Player {
    pub fn position() { return "MF"; }
    pub fn work_rate() { return 1.3; }
    pub fn attacking() { return #sharpness * 0.6; }
    pub fn defending() { return #sharpness * 0.5; }
}

kind Forward extends Player {
    pub fn position() { return "FW"; }
    pub fn work_rate() { return 1.0; }
    pub fn attacking() { return #sharpness; }
    pub fn defending() { return #sharpness * 0.1; }

    // Strikers are at their sharpest while they are fresh
    pub fn form() { return ##form() * (#energy > 70 ? 1.1 : 0.9); }
}

// Teams

kind InvalidLineup extends Error {
    #team;
    fn _($team, $problem) {
        ##_("{$team} can't play: {$problem}");
        #team = $team;
    }
}

kind Team {
    pub #name;
    pub #formation;
    pub #players;
    // What the players on the pitch add up to (see summary()), forgotten whenever they change
    #cache;

    fn _($name, $formation, $players) {
        #name = $name;
        #formation = $formation;
        #players = $players;

        if (len($players) != 11) {
            error(InvalidLineup($name, len($players) .. " players instead of 11"));
        }
        $keepers = len(filter($players, $player -> is_a($player, Goalkeeper)));
        if ($keepers != 1) {
            error(InvalidLineup($name, "{$keepers} goalkeepers"));
        }
    }

    // The players on the pitch, how strongly they attack and defend together, who is in goal
    // and who might shoot, worked out in one go the first time it is needed after a change
    fn summary() {
        if (#cache != null) {
            return #cache;
        }
        $lineup = [];
        $attack = 0;
        $defence = 0;
        $keeper = null;
        $best_defender = null;
        $shooters = [];
        foreach (#players as $player) {
            if ($player.sent_off) {
                continue;
            }
            $lineup[] = $player;
            $attacking = $player.attacking();
            $defending = $player.defending();
            $attack += $attacking;
            $defence += $defending;
            if ($attacking > 0) {
                // The more attacking a player, the likelier to shoot
                $shooters[] = [$player, $attacking];
            }
            if (is_a($player, Goalkeeper)) {
                $keeper = $player;
            } else if ($best_defender == null || $defending > $best_defender.defending()) {
                $best_defender = $player;
            }
        }
        // With the goalkeeper sent off, the best defender left on the pitch goes in goal
        return #cache = {
            "lineup" => $lineup, "attack" => $attack, "defence" => $defence,
            "keeper" => $keeper ?? $best_defender, "shooters" => $shooters, "shooting" => $attack,
        };
    }

    pub fn on_pitch() { return #summary()["lineup"]; }
    pub fn attack() { return #summary()["attack"]; }
    pub fn defence() { return #summary()["defence"]; }
    pub fn goalkeeper() { return #summary()["keeper"]; }
    // Only players who attack at all are shooters, so their weights add up to the attack
    pub fn shooter() { return random::weighted(#summary()["shooters"], #summary()["shooting"]); }
    pub fn rating() { return round(reduce(#players, ($sum, $player) -> $sum + $player.rating, 0) / 11, 1); }

    // The players tired, rested or were sent off
    pub fn changed() { #cache = null; }

    pub fn tire($minutes) {
        foreach (#players as $player) {
            $player.tire($minutes);
        }
        #changed();
    }

    pub fn rest() {
        foreach (#players as $player) {
            $player.rest();
        }
        #changed();
    }

    pub fn to_string() { return #name; }
}

// A formation like "4-3-3": defenders, midfielders and forwards, ten outfield players in all
kind Formation {
    #name;
    #lines;

    fn _($name) {
        #name = $name;
        #lines = map(split($name, "-"), to_int);
        if (len(#lines) != 3 || reduce(#lines, ($sum, $n) -> $sum + $n, 0) != 10) {
            error("Not a formation: {$name}");
        }
    }

    // The kinds to fill the eleven with, goalkeeper first
    pub fn positions() {
        $positions = [Goalkeeper];
        foreach ([Defender, Midfielder, Forward] as $line => $kind) {
            for ($i = 0; $i < #lines[$line]; $i++) {
                $positions[] = $kind;
            }
        }
        return $positions;
    }

    pub fn to_string() { return #name; }
}

// Makes up squads: names from a pool, ratings spread around the club's level
kind Scout {
    #taken = {};

    pub fn team($name, $level, $formation) {
        $formation = Formation($formation);
        // Kinds are values: the formation says which ones to construct
        $players = map($formation.positions(), $kind -> $kind(#new_name(), #rating($level)));
        return Team($name, $formation, $players);
    }

    fn rating($level) {
        $rating = $level + rand_int(-9, 7);
        // Now and then a club has a star
        if (random::chance(0.08)) {
            $rating += 8;
        }
        return min(max($rating, 40), 95);
    }

    // Every name in the league is different
    fn new_name() {
        while (true) {
            $name = random::pick(FIRST_INITIALS) .. ". " .. random::pick(SURNAMES);
            if (! has_key(#taken, $name)) {
                #taken[$name] = true;
                return $name;
            }
        }
    }
}

const FIRST_INITIALS = [
    "A", "B", "C", "D", "E", "F", "G", "H", "I", "J", "K", "L", "M", "N", "O", "P", "R", "S", "T", "V", "W",
    "Y", "Z",
];

const SURNAMES = [
    "Abara", "Achebe", "Adeyemi", "Alvarez", "Andersen", "Bauer", "Becker", "Brandt", "Brennan", "Castillo",
    "Costa", "Dalton", "Diallo", "Dube", "Duarte", "Eriksen", "Ferreira", "Fischer", "Garcia", "Haddad",
    "Hale", "Hansen", "Ivanova", "Jansen", "Kamara", "Keane", "Kerr", "Kowalski", "Lindqvist", "Lopez",
    "Mbeki", "Mensah", "Moreau", "Morales", "Nakamura", "Novak", "Nwosu", "Okafor", "Olsen", "Ortega",
    "Park", "Petrov", "Quinn", "Rossi", "Ruiz", "Sato", "Silva", "Svensson", "Tanaka", "Vargas", "Walsh",
    "Wright", "Yilmaz", "Zielinski",
];

// What happens in a match

abstract kind Event {
    #minute;
    pub #team;
    fn _($minute, $team) {
        #minute = $minute;
        #team = $team;
    }
    pub abstract fn describe();
    pub fn to_string() { return pad_left("{#minute}'", 4) .. "  " .. #describe(); }
}

kind Goal extends Event {
    #scorer;
    #score;
    fn _($minute, $team, $scorer, $score) {
        ##_($minute, $team);
        #scorer = $scorer;
        #score = $score;
    }
    pub fn describe() { return "GOAL! {#scorer} scores for {#team}. {#score}"; }
}

kind Shot extends Event {
    #shooter;
    #keeper;
    fn _($minute, $team, $shooter, $keeper) {
        ##_($minute, $team);
        #shooter = $shooter;
        #keeper = $keeper;
    }
    // Without a keeper, the shot missed the target
    pub fn describe() {
        return #keeper == null ? "{#shooter} ({#team}) shoots wide" : "{#shooter} ({#team}) is denied by {#keeper}";
    }
}

kind Booking extends Event {
    #player;
    #red;
    fn _($minute, $team, $player, $red) {
        ##_($minute, $team);
        #player = $player;
        #red = $red;
    }
    pub fn describe() {
        return #red ? "RED CARD: {#player} ({#team}) is sent off" : "Yellow card for {#player} ({#team})";
    }
}

kind Whistle extends Event {
    #text;
    fn _($minute, $text) {
        ##_($minute, null);
        #text = $text;
    }
    pub fn describe() { return #text; }
}

kind Fixture {
    pub #home;
    pub #away;
    pub #home_goals = 0;
    pub #away_goals = 0;
    #listeners = [];

    fn _($home, $away) {
        #home = $home;
        #away = $away;
    }

    // $listener($event) is called for everything that happens
    pub fn on_event($listener) {
        #listeners[] = $listener;
        return #;
    }

    pub fn play() {
        #home.rest();
        #away.rest();
        for ($minute = 1; $minute <= 90; $minute++) {
            // Players tire as the match goes on
            if ($minute % 30 == 0) {
                #home.tire(30);
                #away.tire(30);
            }
            #minute($minute);
            if ($minute == 45) {
                #emit(Whistle(45, "Half time: {#}"));
            }
        }
        #emit(Whistle(90, "Full time: {#}"));
        return #;
    }

    fn minute($minute) {
        // A chance in about one minute in six, a foul in one in thirty, and most minutes nothing
        $roll = rand_float();
        if ($roll < 0.17) {
            // The home side gets a little more of the ball
            $home_attack = #home.attack() * 1.1;
            if (random::chance($home_attack / ($home_attack + #away.attack()))) {
                #attempt($minute, #home, #away);
            } else {
                #attempt($minute, #away, #home);
            }
        } else if ($roll < 0.2) {
            #foul($minute, random::chance(0.5) ? #home : #away);
        }
    }

    fn attempt($minute, $attackers, $defenders) {
        $shooter = $attackers.shooter();
        $keeper = $defenders.goalkeeper();

        // A better shooter against a weaker defence hits the target more often, and beats the keeper more often
        $on_target = $shooter.attacking() / ($shooter.attacking() + $defenders.defence() / 12);
        if (! random::chance($on_target * 0.8)) {
            #emit(Shot($minute, $attackers, $shooter, null));
            return;
        }
        if (random::chance($keeper.defending() / ($keeper.defending() + $shooter.attacking() * 1.1))) {
            #emit(Shot($minute, $attackers, $shooter, $keeper));
            return;
        }

        $shooter.goals++;
        if ($attackers == #home) {
            #home_goals++;
        } else {
            #away_goals++;
        }
        // The score as text now: the match itself will have moved on by the end
        #emit(Goal($minute, $attackers, $shooter, to_string(#)));
    }

    fn foul($minute, $team) {
        $player = random::weighted(map($team.on_pitch(), $player -> [$player, $player.defending() + 1]));
        $red = $player.book();
        if ($red) {
            $team.changed();
        }
        #emit(Booking($minute, $team, $player, $red));
    }

    fn emit($event) {
        foreach (#listeners as $listener) {
            $listener($event);
        }
    }

    pub fn to_string() { return "{#home} {#home_goals} - {#away_goals} {#away}"; }
}

// A league: everyone plays everyone home and away

kind Standing {
    #team;
    #played = 0;
    #won = 0;
    #drawn = 0;
    #lost = 0;
    pub #scored = 0;
    #conceded = 0;

    fn _($team) { #team = $team; }

    pub fn record($scored, $conceded) {
        #played++;
        #scored += $scored;
        #conceded += $conceded;
        if ($scored > $conceded) {
            #won++;
        } else if ($scored == $conceded) {
            #drawn++;
        } else {
            #lost++;
        }
    }

    pub fn points() { return #won * 3 + #drawn; }
    pub fn difference() { return #scored - #conceded; }

    pub fn to_string() {
        $difference = #difference() > 0 ? "+" .. #difference() : #difference();
        return pad_right(#team, 22) .. pad_left(#team.rating(), 6)
            .. join(map([#played, #won, #drawn, #lost, #scored, #conceded], $n -> pad_left($n, 4)), "")
            .. pad_left($difference, 5) .. pad_left(#points(), 5);
    }
}

kind League {
    #teams;
    #standings = {};

    fn _($teams) {
        #teams = $teams;
        foreach ($teams as $team) {
            #standings[$team.name] = Standing($team);
        }
    }

    // The matchdays of a double round-robin (the circle method) in an order drawn for the
    // season: everyone plays everyone at home and away, and every team plays once a matchday,
    // except that with an odd number of teams one of them rests each matchday
    fn fixtures() {
        $teams = random::shuffle(#teams);
        if (len($teams) % 2 == 1) {
            // Whoever is drawn against null rests
            $teams[] = null;
        }
        $count = len($teams);
        $first_half = [];
        for ($round = 0; $round < $count - 1; $round++) {
            $matchday = [];
            for ($i = 0; $i < intdiv($count, 2); $i++) {
                $pair = [$teams[$i], $teams[$count - 1 - $i]];
                if (in_array(null, $pair)) {
                    continue;
                }
                $matchday[] = ($round + $i) % 2 == 0 ? $pair : [$pair[1], $pair[0]];
            }
            $first_half[] = $matchday;
            // Keep the first team in place and turn the rest one step
            $turned = [$teams[0], $teams[$count - 1]];
            foreach (slice($teams, 1, $count - 2) as $team) {
                $turned[] = $team;
            }
            $teams = $turned;
        }

        $fixtures = $first_half;
        foreach ($first_half as $matchday) {
            $fixtures[] = map($matchday, $pair -> [$pair[1], $pair[0]]);
        }
        return $fixtures;
    }

    // Plays the season; $kick_off($match) is called as each match starts, and
    // $after_matchday($number, $matches) after each matchday
    pub fn play_season($kick_off, $after_matchday) {
        foreach (#fixtures() as $index => $matchday) {
            $matches = [];
            foreach ($matchday as [$home, $away]) {
                $match = Fixture($home, $away);
                $kick_off($match);
                $match.play();
                #standings[$home.name].record($match.home_goals, $match.away_goals);
                #standings[$away.name].record($match.away_goals, $match.home_goals);
                $matches[] = $match;
            }
            $after_matchday($index + 1, $matches);
        }
    }

    // Points, then goal difference, then goals scored, then name
    pub fn table() {
        return sort(#standings, ($a, $b) -> {
            if ($a.points() != $b.points()) {
                return $b.points() <=> $a.points();
            }
            if ($a.difference() != $b.difference()) {
                return $b.difference() <=> $a.difference();
            }
            if ($a.scored != $b.scored) {
                return $b.scored <=> $a.scored;
            }
            return $a.team.name <=> $b.team.name;
        });
    }

    pub fn top_scorers($count) {
        $scorers = [];
        foreach (#teams as $team) {
            foreach (filter($team.players, $player -> $player.goals > 0) as $player) {
                $scorers[] = {"player" => $player, "team" => $team};
            }
        }
        return slice(sort($scorers, ($a, $b) -> $b["player"].goals <=> $a["player"].goals), 0, $count);
    }
}

// Commentary on the first few matches of the season
kind Commentator {
    #remaining;
    fn _($matches) { #remaining = $matches; }

    pub fn kick_off($match) {
        if (#remaining == 0) {
            return;
        }
        #remaining--;
        echo "";
        foreach ([$match.home, $match.away] as $team) {
            echo "{$team} ({$team.formation}, rated {$team.rating()}): " .. join(map($team.players, $player -> $player.profile()), ", ");
        }
        echo "";
        // A bound method as the listener: it remembers which commentator it belongs to
        $match.on_event(#report);
    }

    fn report($event) { echo $event; }
}

// The clubs, strongest first: name, level (the squad's typical rating) and formation
$clubs = [
    ["Harbour City", 82, "4-3-3"], ["Northgate Rovers", 81, "4-4-2"], ["Riverside Athletic", 79, "4-3-3"],
    ["Kingsbridge Wanderers", 78, "3-5-2"], ["Valley United", 77, "4-4-2"], ["Port Albion", 76, "4-3-3"],
    ["Eastfield Town", 75, "4-5-1"], ["Castleton Forest", 74, "4-4-2"], ["Marsh Lane", 73, "3-4-3"],
    ["Oakham Athletic", 72, "4-3-3"], ["Westmoor Albion", 71, "4-4-2"], ["Redcliffe Rangers", 70, "5-3-2"],
    ["Hollins Park", 70, "4-4-2"], ["Stonebridge County", 69, "4-3-3"], ["Ashby Villa", 68, "4-5-1"],
    ["Fairhaven Borough", 67, "4-4-2"], ["Millbrook Dynamo", 66, "3-5-2"], ["Bramley Orient", 65, "4-4-2"],
    ["Greywater Celtic", 64, "5-4-1"], ["Dunmore United", 62, "4-4-2"],
];

// Print the usage and the problem, and stop with exit code 1
fn fail($message) {
    echo "Usage: bin/gazlang -f examples/football.gaz -- [CLUBS] [SEED]";
    echo "Error: {$message}";
    exit(1);
}

// A whole number from the command line, or $default when it wasn't given
fn number_argument($index, $name, $default) {
    $arguments = args();
    if (len($arguments) <= $index) {
        return $default;
    }
    try {
        return to_int($arguments[$index]);
    } catch (Error $e) {
        fail("{$name} must be a whole number, got \"{$arguments[$index]}\"");
    }
}

$count = number_argument(0, "CLUBS", 4);
$seed = number_argument(1, "SEED", 2026);
if ($count < 2 || $count > len($clubs)) {
    fail("CLUBS must be from 2 to " .. len($clubs) .. ", got {$count}");
}
if (len(args()) > 2) {
    fail("expected at most 2 arguments, got " .. len(args()));
}

// A squad has to be a proper eleven
try {
    Team("Sunday Strollers", Formation("4-4-2"), [Goalkeeper("J. Bloggs", 50), Goalkeeper("J. Doe", 50)]);
} catch (InvalidLineup $e) {
    echo "Refused: {$e.message}";
}

// The same squads whatever the season
rand_seed(1);
$scout = Scout();
$teams = [];
foreach (slice($clubs, 0, $count) as [$name, $level, $formation]) {
    $teams[] = $scout.team($name, $level, $formation);
}
echo "Season {$seed}: {$count} clubs, " .. $count * ($count - 1) .. " matches";

rand_seed($seed);
$league = League($teams);
$league.play_season(Commentator(1).kick_off, ($number, $matches) -> {
    if ($number != 1) {
        return;
    }
    echo "";
    echo "Matchday 1";
    foreach ($matches as $match) {
        echo pad_left($match.home, 22) .. "  " .. $match.home_goals .. " - " .. $match.away_goals .. "  " .. $match.away;
    }
});

echo "";
echo pad_right("", 26) .. "Rating" .. join(map(["P", "W", "D", "L", "F", "A"], $label -> pad_left($label, 4)), "") .. "   GD  Pts";
foreach ($league.table() as $position => $standing) {
    echo pad_left($position + 1, 2) .. ". " .. $standing;
}

echo "";
echo "Top scorers";
foreach ($league.top_scorers(10) as $row) {
    echo pad_left($row["player"].goals, 3) .. "  " .. $row["player"].profile() .. ", {$row["team"]}";
}
