// Globals use @ and are shared with every function; $ variables are local
@calls = 0;

// Functions can be called before they are declared
echo fib(10); // 55

function fib($n) {
    @calls = @calls + 1;
    if ($n < 2) {
        return $n;
    }
    return fib($n - 1) + fib($n - 2);
}

@calls = 0;
echo fib(5);  // 5
echo "fib(5) made " .. @calls .. " calls";

// Mutual recursion
function is_even($n) {
    if ($n === 0) { return true; }
    return is_odd($n - 1);
}

function is_odd($n) {
    if ($n === 0) { return false; }
    return is_even($n - 1);
}

echo is_even(10); // true

// A function without a return value gives null
function greet($name) {
    echo "Hello, " .. $name .. "!";
}

$result = greet("GazLang");
echo $result; // null
