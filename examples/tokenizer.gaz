/*
 * A tokenizer for a small C-like language, and a count of what it found.
 *
 *   bin/gazlang -f examples/tokenizer.gaz [-- FILE]
 *
 * With no file it tokenizes the snippet below.
 */
include "std/chars.gaz" use is_digit, is_alpha, is_alnum, is_space, span;

const KEYWORDS = ["if", "else", "while", "return", "function"];
// Two characters are tried before one, so "==" is never read as "=" twice
const OPERATORS = ["==", "!=", "<=", ">=", "->", "..", "&&", "||", "+", "-", "*", "/", "%", "=", "<", ">", "!", "(", ")", "{", "}", "[", "]", ",", ";"];

kind Token {
    fn _(pub #type, pub #text, pub #line);
    pub fn to_string() { return "{#line}: {#type} {#text}"; }
}

/*
 * Reads the source one token at a time. Each method is named for what it
 * reads, and leaves #pos just past it; errors name the line.
 */
kind Scanner {
    #pos = 0;
    #line = 1;
    fn _(#source);

    pub fn tokens() {
        $tokens = [];
        while (#pos < len(#source)) {
            $c = #source[#pos];
            match {
                $c == "\n" => { #line++; #pos++; }
                is_space($c) => { #pos++; }
                starts_with(#source, "//", #pos) => { #comment(); }
                is_digit($c) => { $tokens[] = #number(); }
                is_alpha($c) || $c == "_" => { $tokens[] = #word(); }
                $c == "\"" => { $tokens[] = #string(); }
                default => { $tokens[] = #operator(); }
            }
        }
        return $tokens;
    }

    fn comment() {
        #pos = index_of(#source, "\n", #pos) ?? len(#source);
    }

    /* The next $length characters, which are read now */
    fn take($length) {
        $text = slice(#source, #pos, $length);
        #pos += $length;
        return $text;
    }

    fn number() {
        return Token("number", #take(span(#source, #pos, $c -> is_digit($c) || $c == ".")), #line);
    }

    fn word() {
        $word = #take(span(#source, #pos, $c -> is_alnum($c) || $c == "_"));
        return Token(in_array($word, KEYWORDS) ? "keyword" : "name", $word, #line);
    }

    fn string() {
        $end = index_of(#source, "\"", #pos + 1);
        if ($end == null) {
            error("line {#line}: unterminated string");
        }
        $text = slice(#source, #pos, $end + 1 - #pos);
        #pos = $end + 1;
        return Token("string", $text, #line);
    }

    fn operator() {
        $two = slice(#source, #pos, 2);
        $op = in_array($two, OPERATORS) ? $two : #source[#pos];
        if (!in_array($op, OPERATORS)) {
            error("line {#line}: unexpected character \"$op\"");
        }
        #pos += len($op);
        return Token("operator", $op, #line);
    }
}

$source = 'fn greet(name) {
    // Say hello
    if (name != "") {
        return "Hello, " .. name;
    }
    return "Hello?";
}
';
$arguments = args();
if (len($arguments) > 0) {
    $source = read_file($arguments[0]);
}

try {
    $tokens = Scanner($source).tokens();
} catch ($e) {
    echo "Error: {$e.message}";
    exit(1);
}

foreach (slice($tokens, 0, 6) as $t) {
    echo $t;
}
echo "...";

$counts = {};
foreach ($tokens as $t) {
    $counts[$t.type] ??= 0;
    $counts[$t.type]++;
}
echo len($tokens) .. " tokens: $counts";
