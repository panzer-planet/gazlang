/*
 * backup: copy a directory tree into a new folder named for the moment, write a manifest of
 * what was copied (size and SHA-256 of every file), and keep only the newest backups.
 *
 *   gaz examples/backup.gaz ~/notes /backups/notes
 *   gaz examples/backup.gaz --keep 3 ~/notes /backups/notes
 *
 * Each backup is DESTINATION/2026-10-02T143005, files with their modes and symbolic links as
 * links; the manifest, MANIFEST.txt inside it, is written last, atomically and synced to the
 * disk, so a backup without one was interrupted, even by a power cut.
 *
 * What it shows: fs::copy_tree() (which keeps modes and links, and says what it left out: a pipe
 * or a socket), fs::walk(), readlink(), fs::write_atomic() for a file that is all there or not at
 * all, fs::remove_tree() for the old backups, and make_dir() with its parents.
 */
import "std/cli.gaz";
import "std/crypto.gaz";
import "std/date.gaz";
import "std/format.gaz";
import "std/fs.gaz";

const DEFAULT_KEEP = "5";
const MANIFEST = "MANIFEST.txt";
const STAMP_LENGTH = 17;           // "2026-10-02T143005"

kind Manifest {
    list #lines = [];
    pub list #skipped = [];
    pub int #files = 0;
    pub int #bytes = 0;

    // ponytail: the file is read whole to hash it, since sha256() takes a string, not a stream
    pub fn add_file(string $path, string $full_path): null {
        $data = read_file($full_path);
        #files++;
        #bytes += len($data);
        #lines[] = crypto::hex(sha256($data)) .. "  " .. len($data) .. "  " .. $path;
    }

    pub fn add_link(string $path, string $target): null {
        #lines[] = "link  " .. $path .. " -> " .. $target;
    }

    pub fn skip(string $path): null {
        #skipped[] = $path;
    }

    pub fn text(): string {
        $text = join(#lines, "\n") .. "\n";
        foreach (#skipped as $skipped) {
            $text ..= "skipped  " .. $skipped .. "\n";
        }

        return $text;
    }
}

// "2026-10-02T143005", in UTC: names that sort in the order they were made
fn stamp(int $now): string {
    $moment = date::utc().at($now);

    return date::iso($moment.days) .. "T" .. replace($moment.clock(), ":", "");
}

fn back_up(string $source, string $target): Manifest {
    $manifest = Manifest();
    foreach (fs::copy_tree($source, $target) as $left_out) {
        $manifest.skip($left_out);
    }
    foreach (fs::walk($target) as $path) {
        $full_path = $target .. "/" .. $path;
        $kind = file_info($full_path, false)["kind"];
        if ($kind == "file") {
            $manifest.add_file($path, $full_path);
        } else if ($kind == "link") {
            $manifest.add_link($path, readlink($full_path));
        }
    }

    return $manifest;
}

// The backups made in $root, oldest first: their names are stamps, so they sort by time
fn backups_in(string $root): list {
    return filter(list_dir($root), $name -> len($name) == STAMP_LENGTH && $name[10] == "T");
}

fn rotate(string $root, int $keep): null {
    $backups = backups_in($root);
    $old = slice($backups, 0, max(len($backups) - $keep, 0));
    foreach ($old as $name) {
        fs::remove_tree($root .. "/" .. $name);
        echo "removed old backup {$name}";
    }
}

$cli = cli::Command("backup", "Copy a directory into a new dated backup and keep the newest few");
$cli.option("keep", "k", "How many backups to keep", DEFAULT_KEEP);
$cli.argument("source", "The directory to back up");
$cli.argument("destination", "Where the backups go, each in a folder of its own");
$options = $cli.parse(args());

$keep = to_int($options["keep"], null);
if ($keep == null || $keep < 1) {
    print_error("backup: --keep wants a whole number of 1 or more, got {$options["keep"]}\n");
    exit(2);
}
$source = $options["source"];
if (!is_dir($source)) {
    print_error("backup: {$source} is not a directory\n");
    exit(1);
}

$root = $options["destination"];
make_dir($root, true);
$target = $root .. "/" .. stamp(time());
if (file_exists($target)) {
    print_error("backup: {$target} already exists; try again in a second\n");
    exit(1);
}

$manifest = back_up($source, $target);
fs::write_atomic($target .. "/" .. MANIFEST, $manifest.text());
echo "backed up {$manifest.files} files, " .. format::number($manifest.bytes, 0) .. " bytes, to {$target}";
foreach ($manifest.skipped as $skipped) {
    echo "left out {$skipped}, which is not a file, directory or link";
}
rotate($root, $keep);
