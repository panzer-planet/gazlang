// The self-hosted front end, as gazlang prints it: MODE is code (the bytecode, as -c prints
// it; see docs/bytecode.md), tokens (one LINE TYPE VALUE per line, as --tokens) or ast (the
// tree, as --ast; see Dumper below for the format). Without a FILE the source is read from
// standard input, as gazlang reads piped source: no file in its locations, and includes
// relative to the working directory.
// bin/gazlang -f compiler/gazlang.gaz -- MODE [FILE]
namespace gazlang;

include "codegen.gaz";

kind Dumper {
    // What the dump leaves out: where a node is, which the "@" lines and each node's line
    // show, the code generator's (existing), bookkeeping derived from what is shown (resolved),
    // or an index into the parser's table of member uses (use), which says nothing about
    // the source
    const SKIPPED = ["line", "file", "existing", "resolved", "use"];

    // The file of the last node that had a line, false before the first
    #file = false;

    // Print a tree. Each thing still to print is [label, value, indentation], the label being
    // what it is to its parent with the ": " after it, or nothing for the root. A stack
    // rather than recursion: a chain of operators is as deep on its left as it is long.
    fn dump($root) {
        $stack = [["", $root, ""]];
        while (len($stack) > 0) {
            $last = len($stack) - 1;
            [$label, $value, $indent] = $stack[$last];
            delete $stack[$last];

            $type = type_of($value);
            $children = null;
            if ($type == "object" && is_a($value, AST)) {
                // A node nothing was read for, like a block, has no line and belongs to no file
                if ($value.line != null && $value.file != #file) {
                    #file = $value.file;
                    echo "@ " .. #literal($value.file);
                }
                // "kind gazlang::NumAST" without the "kind ", the namespace and the "AST":
                // the node names are this format, so which namespace they sit in is noise
                $name = last(split(slice(to_string(kind_of($value)), 5, -3), "::"));
                echo $indent .. $label .. $name .. ($value.line == null ? "" : " {$value.line}");
                $children = fields($value);
                foreach (#SKIPPED as $name) {
                    if (has_key($children, $name)) {
                        delete $children[$name];
                    }
                }
            } else if ($type == "object") {
                // A token, which prints as --tokens shows it
                echo $indent .. $label .. $value;
            } else if (($type == "list" || $type == "map") && !#is_plain($value)) {
                echo $indent .. slice($label, 0, -1);
                $children = $value;
            } else {
                echo $indent .. $label .. #literal($value);
            }

            // A node's fields or a list or map's elements, each labelled with its name or key.
            // The last goes on first, so the first comes off, and is printed, next.
            if ($children != null) {
                foreach (reverse(keys($children)) as $label) {
                    $stack[] = ["{$label}: ", $children[$label], $indent .. "  "];
                }
            }
        }
    }

    // A plain value as a literal: a list prints its elements as literals, so a string is
    // quoted as the lexer read it. An empty map prints as [], the same as an empty list.
    fn literal($value) {
        return $value == {} ? "[]" : slice(to_string([$value]), 1, -1);
    }

    // Whether a list or map holds only scalars, at any depth, so it can be written as a literal
    fn is_plain($values) {
        foreach ($values as $value) {
            $type = type_of($value);
            if ($type == "object" || (($type == "list" || $type == "map") && !#is_plain($value))) {
                return false;
            }
        }

        return true;
    }
}

$args = args();
if (len($args) < 1 || len($args) > 2 || !in_array($args[0], ["code", "tokens", "ast"])) {
    print_error("Usage: gazlang -f compiler/gazlang.gaz -- code|tokens|ast [FILE]\n");
    exit(2);
}
[$mode, $path] = len($args) == 2 ? $args : [$args[0], null];
$text = $path == null ? read_stdin() : read_file($path);

if ($mode == "tokens") {
    // Streamed, so the tokens before a lexer error are still printed
    $lexer = Lexer($text);
    try {
        $type = null;
        while ($type != "EOF") {
            $token = $lexer.get_next_token();
            echo $token;
            $type = $token.type;
        }
    } catch (LexError $e) {
        // Raised again from the top level, so no trace of the lexer's calls is printed under it
        error($e.message);
    }
} else {
    try {
        $root = Parser(Lexer($text), $path).parse();
    } catch (ParseError $e) {
        // Raised again from the top level, so no trace of the parser's calls is printed under it
        error($e.message);
    }
    if ($mode == "ast") {
        Dumper().dump($root);
    } else {
        print(CodeGenerator($root).compile().write($path));
    }
}
