// The tree compiler/parser.gaz builds: one kind per node, named after what it is (BinOpAST,
// IfStatementAST), its fields what the code generator reads.
//
// Fields are declared in the order --ast prints them, since fields() gives them in that order:
// compiler/gazlang.gaz prints a tree from them, and the parser walks one to find the variables a
// lambda uses. A field the parser leaves empty is set to null, since fields() leaves out one
// that was never set.
//
// This file has no top level code, so it can be included.

namespace gazlang;

abstract kind AST {
    #line = null;
    #file = null;
}

// A node that is one token: a literal or a variable
abstract kind TokenValueNodeAST extends AST {
    #token;
    #value;

    fn _($token) {
        #token = $token;
        #value = $token.value;
    }
}

kind NumAST extends TokenValueNodeAST {}

kind StringAST extends TokenValueNodeAST {}

kind NullAST extends TokenValueNodeAST {
    fn _($token) {
        ##_($token);
        #value = null;
    }
}

kind BooleanAST extends TokenValueNodeAST {
    fn _($token) {
        ##_($token);
        #value = $token.type == "TRUE";
    }
}

// #value is the token's text, "$name" or "@name"
kind VariableAST extends TokenValueNodeAST {
    fn is_global() {
        return #value[0] == "@";
    }
}

kind UnaryOpAST extends AST {
    #op;
    #expr;

    fn _($op, $expr) {
        #op = $op;
        #expr = $expr;
    }
}

kind BinOpAST extends AST {
    #left;
    #token;
    #op;
    #right;

    fn _($left, $op, $right) {
        #left = $left;
        #token = $op;
        #op = $op;
        #right = $right;
    }
}

kind TernaryAST extends AST {
    #condition;
    #then;
    #else;

    fn _($condition, $then, $else) {
        #condition = $condition;
        #then = $then;
        #else = $else;
    }
}

abstract kind AbstractStatementAST extends AST {
    #expr;

    fn _($expr) {
        #expr = $expr;
    }
}

kind StatementAST extends AbstractStatementAST {}

kind EchoStatementAST extends AbstractStatementAST {}

kind CompoundAST extends AST {
    #statements = [];
}

// A list [1, 2] or, with #map, a map {"k" => 1}; each entry is [key, value], the key null in a list
kind ArrayLiteralAST extends AST {
    #entries;
    #map;

    fn _($entries, $map = false) {
        #entries = $entries;
        #map = $map;
    }
}

// An element of a list literal written ...$expr: the elements of the list #expr gives
kind SpreadAST extends AST {
    #expr;

    fn _($expr) {
        #expr = $expr;
    }
}

// $target[$index], or $target[] when #index is null
kind IndexAST extends AST {
    #target;
    #index;
    // Set by the code generator on the nodes it builds for a compound update, which reads the
    // current value strictly; not part of the tree
    #existing = false;

    fn _($target, $index) {
        #target = $target;
        #index = $index;
    }
}

// $target.name, or #name when the target is a ThisAST
kind PropertyAST extends AST {
    #target;
    #name;
    // Whether a #name is a field rather than a method, which the parser knows once the kinds are resolved
    #field = false;
    // Whether this is a kind's constant (#NAME), and if so its value, which the parser
    // works out once the kinds are resolved: a use of a constant is its value
    #constant = false;
    #value = null;
    // The "Kind::name" of the static field or static method this is, or null: a static is
    // reached by name, so #count in a method is a slot and #next() a plain call
    #static_name = null;
    // Where a #name's record is in Parser.member_uses, or null; not part of the tree
    #use = null;
    // As IndexAST's
    #existing = false;

    fn _($target, $name) {
        #target = $target;
        #name = $name;
    }
}

// A call on a value: $f(1), pick()(2)
kind CallValueAST extends AST {
    #callee;
    #args;

    fn _($callee, $args) {
        #callee = $callee;
        #args = $args;
    }
}

// $obj.name(args) or #name(args)
kind MethodCallAST extends AST {
    #property;
    #args;

    fn _($property, $args) {
        #property = $property;
        #args = $args;
    }
}

// A call by name: add(1, 2)
kind FunctionCallAST extends AST {
    #name;
    #args;

    fn _($name, $args) {
        #name = $name;
        #args = $args;
    }
}

// A bare function, kind or constant name used as a value
// A static field's default, which the code generator writes before the program's own first
// instruction: the value is a constant the parser worked out, so there is no order to define
kind StaticInitAST extends AST {
    #name;
    #value;

    fn _($name, $value) {
        #name = $name;
        #value = $value;
    }
}

kind FunctionRefAST extends AST {
    #name;
    // Whether the name is a constant's, and if so its value, which the parser works out once
    // the whole program is read: a use of a constant is its value
    #constant = false;
    #value = null;
    // The "Kind::name" of the static field this names, or null; a static field is a slot,
    // so Counter::count reads and writes one rather than being a value of its own
    #static_name = null;

    fn _($name) {
        #name = $name;
    }
}

// = and the compound assignments; #token says which
kind AssignAST extends AST {
    #left;
    #token;
    #right;

    fn _($left, $token, $right) {
        #left = $left;
        #token = $token;
        #right = $right;
    }
}

kind IncrementAST extends AST {
    #target;
    #op;
    #prefix;

    fn _($target, $op, $prefix) {
        #target = $target;
        #op = $op;
        #prefix = $prefix;
    }
}

// [$a, $b] on the left of = or in a foreach
kind ListPatternAST extends AST {
    #targets;

    fn _($targets) {
        #targets = $targets;
    }
}

kind LambdaAST extends AST {
    #params;
    #defaults;
    #arity;
    #body;
    // The outer variables it uses, which are copied into the closure when it is created
    #captures;
    // The captured name that holds the closure itself ($f = <lambda using $f>), or null
    #self = null;

    fn _($params, $defaults, $arity, $body, $captures) {
        #params = $params;
        #defaults = $defaults;
        #arity = $arity;
        #body = $body;
        #captures = $captures;
    }
}

// #subject is null when the arms are conditions; each arm is [values, body, is_block],
// the values null for the default arm
kind MatchAST extends AST {
    #subject;
    #arms;

    fn _($subject, $arms) {
        #subject = $subject;
        #arms = $arms;
    }
}

// The variable or # that a path of elements and fields starts at, or null if it starts anywhere else
fn path_root($node) {
    while (is_a($node, IndexAST) || is_a($node, PropertyAST)) {
        $node = $node.target;
    }

    // A qualified name can be a static field, which is a slot and so can be written; that it
    // is one rather than a constant or a kind is checked once the whole program is read
    if (is_a($node, FunctionRefAST) && contains($node.name, "::")) {
        return $node;
    }

    return is_a($node, VariableAST) || is_a($node, ThisAST) ? $node : null;
}

// # alone, the object a method runs on
kind ThisAST extends AST {}

// #else_if is the IfStatementAST of an else if, #else_body the block of an else; at most one is set
kind IfStatementAST extends AST {
    #condition;
    #if_body;
    #else_if;
    #else_body;

    fn _($condition, $if_body, $else_if = null, $else_body = null) {
        #condition = $condition;
        #if_body = $if_body;
        #else_if = $else_if;
        #else_body = $else_body;
    }
}

// #step is a for loop's third clause, which runs after the body and on continue
kind WhileStatementAST extends AST {
    #condition;
    #body;
    #step;

    fn _($condition, $body, $step = null) {
        #condition = $condition;
        #body = $body;
        #step = $step;
    }
}

// #key is null without one; #value is a variable or a list pattern of them
kind ForeachStatementAST extends AST {
    #iterable;
    #key;
    #value;
    #body;

    fn _($iterable, $key, $value, $body) {
        #iterable = $iterable;
        #key = $key;
        #value = $value;
        #body = $body;
    }
}

// break or continue; #token says which
kind LoopControlAST extends AST {
    #token;

    fn _($token) {
        #token = $token;
    }
}

kind ReturnStatementAST extends AST {
    #expr;

    fn _($expr) {
        #expr = $expr;
    }
}

kind DeleteStatementAST extends AST {
    #target;

    fn _($target) {
        #target = $target;
    }
}

// A function, or a method when #kind names its kind; an abstract method's body is empty
kind FunctionDeclarationAST extends AST {
    #name;
    #params;
    #defaults;
    #body;
    #arity;
    #kind = null;
    #abstract = false;

    fn _($name, $params, $defaults, $body, $arity) {
        #name = $name;
        #params = $params;
        #defaults = $defaults;
        #body = $body;
        #arity = $arity;
    }
}

// ##name, the parent kind's version of a method: a bound method, or a call when #args is a list
kind ParentMethodAST extends AST {
    #name;
    #args;
    // The kind whose version runs, which the parser knows once the kinds are resolved
    #definer = "";

    fn _($name, $args) {
        #name = $name;
        #args = $args;
    }
}

// Each catch is [kind name or null, variable, block]
kind TryStatementAST extends AST {
    #body;
    #catches;
    #finally;

    fn _($body, $catches, $finally) {
        #body = $body;
        #catches = $catches;
        #finally = $finally;
    }
}

kind KindDeclarationAST extends AST {
    #name;
    #parent;
    #abstract;
    // Each declared static field's default expression, and the line it is declared on, by name
    #statics = {};
    #static_lines = {};
    // Each declared static method's FunctionDeclarationAST, by name
    #static_methods = {};
    // Worked out once the whole program is read: every static, the parent's first, with the
    // kind that declares it, and which of them are methods
    #static_owners = {};
    #static_is_method = {};
    // Each declared field's default, or null, by name
    #fields = {};
    // The line each field is declared on, for errors about it
    #field_lines = {};
    // Each declared method's FunctionDeclarationAST, by name
    #methods = {};
    // Each declared constant's expression, and the line it is declared on, by name
    #constants = {};
    #constant_lines = {};
    // Worked out once the whole program is read: every constant, the parent's first, with the
    // kind that declares it
    #constant_owners = {};
    // Worked out once the whole program is read: every field, the parent's first, with the
    // kind that declares it; every concrete method with the kind whose version runs; and
    // every abstract method still to be defined, with the kind that declares it
    #layout = {};
    #members = {};
    #abstract_methods = {};
    // Whether those three have been worked out
    #resolved = false;

    fn _($name, $parent, $abstract) {
        #name = $name;
        #parent = $parent;
        #abstract = $abstract;
    }
}
