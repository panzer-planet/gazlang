/*
 * Templates: a .gazml file that is imported is translated here into GazLang source, which is
 * then lexed and parsed like any file, so the rest of the compiler, the VM and the bytecode
 * learn nothing. Each line of the template becomes one line of the source, so every error in
 * it, the parser's or the running program's, is reported at the template's own line.
 *
 *   namespace shop;                           namespace shop;
 *   @template user_page($user, $posts)        fn user_page($user, $posts) { $#html = "";
 *   <h1>{{ $user.name }}</h1>                 $#html ..= "<h1>"; $#html ..= Html::escape(...); ...
 *   @foreach ($posts as $post)                foreach ($posts as $post) {
 *   @endforeach                               }
 *   (after the last line)                     return Html($#html); }
 *
 * - The first line may be `namespace name;`, as in any file: the template's function is then
 *   `name::user_page`, and the types in its parameters are looked up there. `@template pub
 *   user_page(...)` makes it `pub`, as for a function. Without a namespace line it has none.
 * - `import "...";` lines may follow, before the @template line, as at the top of any file: a
 *   template is a module, and sees what it imports (another template, a kind its parameters
 *   name, the standard library). An import after the @template line is an error.
 * - The template's text is read as markup, as web::html reads a tagged string (a web::Scanner,
 *   before any source is written, since a <meta>'s content is placed only at its tag's end), and
 *   each {{ expression }} is written for where it lands: in text escaped, unless it is an Html
 *   (another template's result), which goes in as it is; in an attribute or a URL as web::write()
 *   writes it; as the whole of a quoted attribute's value through web::attribute(), so null leaves
 *   the attribute out; and where HTML escaping doesn't make a value safe (a <script>, an unquoted
 *   attribute, between attributes) it is an error at its line. The source imports std/web.gaz,
 *   on the @template line, only when a value needs it.
 * - {!! expression !!} goes in as it is whatever it is, through to_string(), since ..= refuses an
 *   Html, and wherever it is: it is the template's way to write what it has checked itself.
 * - A directive line stands where a line of markup can end: in text, inside <script> or <title>,
 *   between a tag's attributes, or in a comment; and each branch of an @if or @foreach ends where
 *   it began, so the text of all the branches, read one after another, places every value as any
 *   path through them would.
 * - @if (...), @elseif (...), @else, @endif, @foreach (...), @endforeach, each alone on its line,
 *   and a line holding one writes nothing. Another @word (CSS's @media) is text.
 * - {{-- comment --}} writes nothing (a line holding only one, not even its line end), and @{{
 *   writes {{.
 * - ponytail: an expression ends at the first }} or !!}, so one can't hold them, and none spans
 *   lines.
 */
namespace gazlang;

// ParseError; the parser imports this file too, a cycle each file being read once allows
import "./parser.gaz";
import "std/syntax.gaz" use TEMPLATE_BUFFER;
import "std/text.gaz" use quote;
import "std/web.gaz";

// The directives that open a block, and the one that closes each
const TEMPLATE_BLOCKS = {"if" => "endif", "foreach" => "endforeach"};
// How a value's writer is named in an error the scan or the running template raises
const TEMPLATE_WRITER = "{{ }}";

// What a piece of a template's line is: text, a {{ }} or a {!! !!}
enum PieceKind {
    Text;
    Value;
    Raw;
}

// One piece of a line: its text, or the expression inside a {{ }} or {!! !!}
readonly kind TemplatePiece {
    fn _(pub PieceKind #kind, pub string #text);
}

// A line of text, read into pieces, and its number
readonly kind TemplateText {
    fn _(pub int #number, pub list #pieces);
}

/*
 * An @if or @foreach not yet closed: where it opened, its @else's line once there is one, and
 * where in the markup it began, which each of its branches must end at too
 */
kind OpenBlock {
    pub ?int #else_line = null;

    fn _(pub string #word, pub int #line, pub string #place);
}

kind TemplateTranslator {
    #lines;
    // Each @if or @foreach not yet closed, innermost last
    #open = [];
    // Reads the template's text as markup, to place each {{ }}
    #scanner;

    fn _($text, #file) {
        #lines = split($text, "\n");
        #scanner = web::Scanner(TEMPLATE_WRITER, "The template", "a template");
    }

    // The template as GazLang source, with as many lines
    pub fn translate() {
        $source = [];
        $first = 0;
        if (#is_namespace_line(#lines[0])) {
            // Passed on as it is: the parser reads it as the first line of the file, so it checks the name
            $source[] = trim(#lines[0]);
            $first = 1;
        }
        // The imports after it too, a line each, so an error in one is at the template's own line
        while ($first < len(#lines) && is_import_line(#lines[$first])) {
            $source[] = trim(#lines[$first]);
            $first++;
        }
        $header_at = len($source);
        $source[] = #header(#lines[$first] ?? "", $first + 1);
        $last = len(#lines) - 1;
        // First every line is read and its text scanned, then written once every value is placed
        $read = [];
        for ($i = $first + 1; $i <= $last; $i++) {
            $read[] = #line(#lines[$i], $i + 1, $i < $last);
        }
        #check_closed();
        #scanned($last + 1, () -> #scanner.finish());
        $writer = TemplateWriter(#scanner.found, #file);
        foreach ($read as $line) {
            $source[] = is_a($line, TemplateText) ? $writer.source($line) : $line;
        }
        if ($writer.needs_web) {
            $source[$header_at] = "import \"std/web.gaz\"; " .. $source[$header_at];
        }
        $source[len($source) - 1] ..= " return Html(" .. TEMPLATE_BUFFER .. "); }";

        return join($source, "\n");
    }

    // Whether a line is "namespace name;", which a template may start with, as any file may
    fn is_namespace_line($text) {
        $trimmed = trim($text);

        return $trimmed == "namespace" || starts_with($trimmed, "namespace ");
    }

    // "@template name($a, $b)" (or "@template pub name(...)") as the function it declares, with its
    // output starting empty
    fn header($text, $number) {
        $trimmed = trim($text);
        if (!starts_with($trimmed, "@template ")) {
            #fail("A template starts with @template and the function it is, like @template page(\$title)", $number);
        }
        $declaration = trim(slice($trimmed, 10));
        $marker = "";
        if (starts_with($declaration, "pub ")) {
            $marker = "pub ";
            $declaration = trim(slice($declaration, 4));
        }

        return $marker .. "fn " .. $declaration .. " { " .. TEMPLATE_BUFFER .. " = \"\";";
    }

    // One line of the template: a directive's source, or its text read into pieces and scanned
    fn line($text, $number, $newline) {
        if (is_import_line($text)) {
            #fail("An import comes before @template, after the namespace line if there is one", $number);
        }
        $directive = #directive($text, $number);
        if ($directive != null) {
            return $directive;
        }
        if (is_comment_line($text)) {
            return "";
        }
        if ($newline) {
            $text ..= "\n";
        }
        $pieces = TemplateLine($text, $number, #file).read();
        foreach ($pieces as $piece) {
            #scan($piece, $number);
        }

        return TemplateText($number, $pieces);
    }

    // Read a piece of a line's text as markup, or place its value
    fn scan($piece, $number) {
        match ($piece.kind) {
            PieceKind::Text => { #scanned($number, () -> #scanner.feed($piece.text)); }
            PieceKind::Value => { #scanned($number, () -> #scanner.place()); }
            PieceKind::Raw => { #scanner.pass(); }
        }
    }

    // Run a step of the scan, a refusal from it being an error at the template's line
    fn scanned($number, $step) {
        try {
            $step();
        } catch (web::Refusal $e) {
            #fail($e.message, $number);
        }
    }

    // Where the markup read so far has stopped, which a directive line must be able to stand at
    fn resting_place($word, $number) {
        $place = #scanner.rest();
        if ($place == null) {
            #fail("@{$word} can't come in the middle of a tag's name, an attribute or an end tag: put it between attributes or outside the tag", $number);
        }

        return $place;
    }

    // A branch of $block ends here, which must be where the block began
    fn check_branch_ends($block, $word, $number) {
        $place = #resting_place($word, $number);
        if ($place != $block.place) {
            #fail("The branch before this @{$word} ends {$place}, but its @{$block.word} (line {$block.line}) began {$block.place}: each branch must end where it began", $number);
        }
    }

    // The source for a directive line, or null when the line isn't one
    fn directive($text, $number) {
        $trimmed = trim($text);
        if (!starts_with($trimmed, "@")) {
            return null;
        }
        $word = #directive_word($trimmed);
        $argument = trim(slice($trimmed, 1 + len($word)));

        return match ($word) {
            "if" => #open_block("if", $argument, $number, "if "),
            "foreach" => #open_block("foreach", $argument, $number, "foreach "),
            "elseif" => #continue_if("elseif", $argument, $number, "} else if "),
            "else" => #continue_if("else", $argument, $number, "} else"),
            "endif" => #close_block("if", $argument, $number),
            "endforeach" => #close_block("foreach", $argument, $number),
            default => null,
        };
    }

    // The letters after the @
    fn directive_word($trimmed) {
        $end = 1;
        while ($end < len($trimmed) && is_letter($trimmed[$end])) {
            $end++;
        }

        return slice($trimmed, 1, $end - 1);
    }

    fn open_block($word, $argument, $number, $keyword) {
        #check_condition($word, $argument, $number);
        #open[] = OpenBlock($word, $number, #resting_place($word, $number));

        return $keyword .. $argument .. " {";
    }

    // @elseif and @else, which belong to the @if open innermost
    fn continue_if($word, $argument, $number, $source) {
        $block = #innermost($word, $number);
        if ($block.word != "if") {
            #fail("@{$word} inside @{$block.word} (line {$block.line}): it belongs to an @if", $number);
        }
        if ($block.else_line != null) {
            #fail("@{$word} after the @else on line {$block.else_line}: the @else comes last", $number);
        }
        #check_branch_ends($block, $word, $number);
        if ($word == "elseif") {
            #check_condition($word, $argument, $number);

            return $source .. $argument .. " {";
        }
        #check_nothing_after($word, $argument, $number);
        $block.else_line = $number;

        return $source .. " {";
    }

    fn close_block($word, $argument, $number) {
        $block = #innermost("end{$word}", $number);
        if ($block.word != $word) {
            #fail("@end{$word} closes @{$block.word} (line {$block.line}), which @" .. TEMPLATE_BLOCKS[$block.word] .. " closes", $number);
        }
        #check_nothing_after("end{$word}", $argument, $number);
        #check_branch_ends($block, "end{$word}", $number);
        delete #open[len(#open) - 1];

        return "}";
    }

    fn innermost($word, $number) {
        if (len(#open) == 0) {
            #fail("@{$word} with nothing open for it to belong to", $number);
        }

        return last(#open);
    }

    // @if and @foreach take their condition in parentheses, as if and foreach do
    fn check_condition($word, $argument, $number) {
        if (!starts_with($argument, "(") || !ends_with($argument, ")")) {
            #fail("@{$word} takes its condition in parentheses, alone on the line: @{$word} (...)", $number);
        }
    }

    fn check_nothing_after($word, $argument, $number) {
        if ($argument != "") {
            #fail("@{$word} stands alone on its line", $number);
        }
    }

    fn check_closed() {
        if (len(#open) > 0) {
            $block = last(#open);
            #fail("@{$block.word} is never closed: it needs an @" .. TEMPLATE_BLOCKS[$block.word], $block.line);
        }
    }

    fn fail($message, $line) {
        throw ParseError($message, #file, $line);
    }
}

/*
 * A line of text in a template, read into pieces: its text, and the expression in each {{ }} and
 * {!! !!}. Text between the expressions is gathered into one piece, comments and all.
 */
kind TemplateLine {
    #pieces = [];
    #text = "";
    #at = 0;

    fn _(#line, #number, #file);

    pub fn read(): list {
        while (#at < len(#line)) {
            #step();
        }
        #flush_text();

        return #pieces;
    }

    // Take what comes next: text up to a {{, {!! or @{{, then that
    fn step() {
        $next = #next_opening();
        if ($next == null) {
            #text ..= slice(#line, #at);
            #at = len(#line);

            return;
        }
        [$at, $opening] = $next;
        #text ..= slice(#line, #at, $at - #at);
        #at = $at;
        match ($opening) {
            "@{{" => { #literal_braces(); }
            "{{--" => { #comment(); }
            "{!!" => { #expression("{!!", "!!}", false); }
            default => { #expression("{{", "}}", true); }
        }
    }

    // Where the next opening is and which it is, or null: the one that starts first
    fn next_opening() {
        $best = null;
        foreach (["@{{", "{{--", "{!!", "{{"] as $opening) {
            $at = index_of(#line, $opening, #at);
            if ($at != null && ($best == null || $at < $best[0])) {
                $best = [$at, $opening];
            }
        }

        return $best;
    }

    fn literal_braces() {
        #text ..= "{{";
        #at += 3;
    }

    fn comment() {
        $end = #closing("{{--", "--}}");
        #at = $end + 4;
    }

    fn expression($opening, $closing, $escaped) {
        $end = #closing($opening, $closing);
        $code = trim(slice(#line, #at + len($opening), $end - #at - len($opening)));
        if ($code == "") {
            #fail("{$opening} {$closing} holds nothing");
        }
        #flush_text();
        #pieces[] = TemplatePiece($escaped ? PieceKind::Value : PieceKind::Raw, $code);
        #at = $end + len($closing);
    }

    // Where the $closing for the $opening at #at is, on this line
    fn closing($opening, $closing) {
        $end = index_of(#line, $closing, #at + len($opening));
        if ($end == null) {
            #fail("{$opening} is never closed with {$closing} on its line");
        }

        return $end;
    }

    fn flush_text() {
        if (#text != "") {
            #pieces[] = TemplatePiece(PieceKind::Text, #text);
            #text = "";
        }
    }

    fn fail($message) {
        throw ParseError($message, #file, #number);
    }
}

/*
 * Writes a template's lines of text as source, once the scan has placed every value: each line
 * as statements appending to the output, on one line of source. A value in text is
 * Html::escape()'s, as it always was; anywhere else it is web.gaz's, and then the template
 * imports it (needs_web).
 */
kind TemplateWriter {
    pub #needs_web = false;
    // The next value's place among the slots
    #next = 0;
    #statements = [];
    #text = "";
    /*
     * Whether the text after the value just written starts with the quote that closes its
     * attribute, which web::attribute() wrote or left out with it
     */
    #skip_quote = false;

    fn _(#slots, #file);

    // A line of text as a line of source
    pub fn source(TemplateText $line): string {
        #statements = [];
        foreach ($line.pieces as $piece) {
            match ($piece.kind) {
                PieceKind::Text => { #add_text($piece.text); }
                PieceKind::Value => { #value($piece.text, $line.number); }
                PieceKind::Raw => { #raw($piece.text); }
            }
        }
        #flush_text();

        return join(#statements, " ");
    }

    fn add_text($text) {
        if (#skip_quote) {
            $text = slice($text, 1);
            #skip_quote = false;
        }
        #text ..= $text;
    }

    fn value($code, $number) {
        $slot = #slots[#next];
        #next++;
        if ($slot.whole()) {
            #whole_attribute($slot, $code, $number);

            return;
        }
        #flush_text();
        if ($slot.placement == web::Placement::Markup) {
            #append("Html::escape(" .. $code .. ")");

            return;
        }
        #needs_web = true;
        #append("web::write((" .. $code .. "), " .. #placement($slot) .. ", " .. quote(TEMPLATE_WRITER) .. ")");
    }

    // A value that is a quoted attribute's whole value: the attribute's opening, at the end of the
    // text gathered, is taken back, for web::attribute() to write or leave out with the value
    fn whole_attribute($slot, $code, $number) {
        if (!ends_with(#text, $slot.opening)) {
            throw ParseError("The template's text before a value isn't what the scan read: " .. quote($slot.opening), #file, $number);
        }
        #text = slice(#text, 0, len(#text) - len($slot.opening));
        #flush_text();
        #needs_web = true;
        #append("web::attribute(" .. quote($slot.opening) .. ", (" .. $code .. "), " .. #placement($slot) .. ", " .. quote(TEMPLATE_WRITER) .. ")");
        #skip_quote = true;
    }

    fn raw($code) {
        #flush_text();
        #append("to_string((" .. $code .. "))");
    }

    // A slot's placement as the source names it
    fn placement($slot) {
        return "web::Placement::" .. $slot.placement.value;
    }

    fn flush_text() {
        if (#text != "") {
            #append(quote(#text));
            #text = "";
        }
    }

    fn append($source) {
        #statements[] = TEMPLATE_BUFFER .. " ..= " .. $source .. ";";
    }
}

/*
 * Whether a line is an import (import "..."), which a template may have before its @template
 * line, as any file has at its top
 */
fn is_import_line($text) {
    return starts_with(trim($text), "import \"");
}

// A line holding one {{-- comment --}} and nothing else, which writes nothing, not even its line end
fn is_comment_line($text) {
    $trimmed = trim($text);

    return starts_with($trimmed, "{{--") && index_of($trimmed, "--}}") == len($trimmed) - 4;
}

fn is_letter($c) {
    return $c >= "a" && $c <= "z" || $c >= "A" && $c <= "Z";
}
