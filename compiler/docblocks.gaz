/*
 * Documentation comments ("docblocks") and the declarations they document, read from source
 * with the compiler's own lexer, so a comment is told from a string exactly. A docblock is a
 * block comment opened by a slash and two stars, followed by anything but the closing slash (an
 * empty comment written with two stars is a plain one), on the lines right above a
 * declaration, with no blank line between; a plain comment between them takes its place. Its
 * text is Markdown, given here without the comment's marks and the star down its side.
 *
 *   $outline = outline(read_file("lib/csv.gaz"));
 *   echo $outline.declarations[0].name;            // "parse"
 *
 * A convention that tools read (the website's library pages, the language server), not part of
 * the language: the compiler never imports this file, so nothing of it reaches the bytecode.
 * Source the lexer refuses is read up to where it fails, so a document being edited still has
 * the declarations above its mistake.
 */
namespace gazlang;

import "./lexer.gaz";
import "std/text.gaz" use trim_end, unindented;

// The words before a declaration that say how far it escapes or what sort it is
const DECLARATION_MODIFIERS = ["PUB", "KIN", "STATIC", "ABSTRACT"];

// The token types a bracket of each sort opens or closes, for keeping count of depth
const OPENERS = ["LEFT_PAREN", "LEFT_BRACKET", "LEFT_BRACE"];
const CLOSERS = ["RIGHT_PAREN", "RIGHT_BRACKET", "RIGHT_BRACE"];

// The tokens after which a statement, or a member of a kind, starts
const STATEMENT_ENDS = ["SEMICOLON", "LEFT_BRACE", "RIGHT_BRACE"];

/*
 * A declaration of a file: a function, kind or constant at the top level, or a member of a kind
 * (with #owner the kind's name). $signature is its source from its first word up to its body,
 * or to the end of the statement for one without; $line the line its first word is on; $doc
 * the docblock right above it, or null.
 */
pub kind Declaration {
    pub const FUNCTION = "function";
    pub const KIND = "kind";
    pub const CONSTANT = "constant";
    pub const FIELD = "field";
    pub const STATIC_FIELD = "static field";
    pub const METHOD = "method";
    pub const STATIC_METHOD = "static method";
    pub const CONSTRUCTOR = "constructor";

    fn _(
        pub string #what,
        pub string #name,
        pub bool #pub,
        pub ?string #owner,
        pub string #signature,
        pub int #line,
        pub ?string #doc
    ) {}
}

/*
 * What a file declares: its namespace (null without one), its overview (the first docblock of
 * the file, before its namespace line), its declarations in source order, and the paths its
 * imports name, as written
 */
pub kind Outline {
    fn _(pub ?string #namespace, pub ?string #overview, pub list #declarations, pub list #imports = []) {}
}

// The outline of GazLang source
pub fn outline(string $source): Outline {
    return OutlineReader($source).read();
}

// The outline of the file at $path; a template (.gazml), being markup, declares nothing here
pub fn outline_of_file(string $path): Outline {
    if (!ends_with($path, ".gaz")) {
        return Outline(null, null, []);
    }

    return outline(read_file($path));
}

// A token of the source and where it lies in it
kind SourceToken {
    fn _(pub string #type, pub #value, pub int #line, pub int #start, pub int #stop) {}
}

kind OutlineReader {
    #tokens = [];

    fn _(string #source) {
        $lexer = Lexer($source);
        try {
            $token = $lexer.get_next_token();
            while ($token.type != "EOF") {
                [$start, $stop] = $lexer.span();
                #tokens[] = SourceToken($token.type, $token.value, $token.line, $start, $stop);
                $token = $lexer.get_next_token();
            }
        } catch (LexError $e) {
            // What was read before the mistake is still outlined
        }
    }

    pub fn read(): Outline {
        $namespace = null;
        $declarations = [];
        $imports = [];
        // The kind whose body is open, and one declared whose body is still to open
        $kind = null;
        $declared_kind = null;
        $braces = 0;
        $parentheses = 0;
        $at_start = true;
        $t = 0;
        while ($t < len(#tokens)) {
            $type = #type($t);
            if ($type == "NAMESPACE" && $braces == 0) {
                $namespace = #text($t + 1);
            }
            if ($type == "IMPORT" && #type($t + 1) == "STRING") {
                $imports[] = #tokens[$t + 1].value;
            }
            if ($at_start && $parentheses == 0 && #declares($t, $braces, $kind)) {
                [$declaration, $end] = #declaration($t, $braces == 0 ? null : $kind);
                if ($declaration != null) {
                    $declarations[] = $declaration;
                    if ($declaration.what == Declaration::KIND) {
                        $declared_kind = $declaration.name;
                    }
                }
                $at_start = #type($end - 1) == "SEMICOLON";
                $t = $end;
                continue;
            }
            if ($type == "LEFT_BRACE" && $braces == 0) {
                $kind = $declared_kind;
                $declared_kind = null;
            }
            $braces += #depth_change($type, ["LEFT_BRACE"], ["RIGHT_BRACE"]);
            $parentheses += #depth_change($type, ["LEFT_PAREN", "LEFT_BRACKET"], ["RIGHT_PAREN", "RIGHT_BRACKET"]);
            if ($braces == 0) {
                $kind = null;
            }
            $at_start = in_array($type, STATEMENT_ENDS);
            $t++;
        }

        return Outline($namespace, #overview(), $declarations, $imports);
    }

    fn depth_change(string $type, list $openers, list $closers): int {
        return match {
            in_array($type, $openers) => 1,
            in_array($type, $closers) => -1,
            default => 0,
        };
    }

    /*
     * Whether the statement starting at token $t is a declaration: at the top level one that
     * starts with a declaring word, and in a kind's body every one, since a body holds only
     * members
     */
    fn declares(int $t, int $braces, ?string $kind): bool {
        $type = #type($t);
        if ($braces == 0) {
            return in_array($type, ["PUB", "ABSTRACT", "FN", "CONST"]) || #is_kind_word($t);
        }

        return $braces == 1 && $kind != null && $type != "RIGHT_BRACE" && $type != "SEMICOLON";
    }

    // The declaration starting at token $t as [Declaration or null if the source ends first, the token after it]
    fn declaration(int $t, ?string $owner): list {
        $u = $t;
        $modifiers = [];
        while (in_array(#type($u), DECLARATION_MODIFIERS)) {
            $modifiers[] = #type($u);
            $u++;
        }
        // Past a type (a field's), to the word that says what this is
        while (!#is_declaring_word($u)) {
            $u++;
        }
        if (#type($u) == "EOF" || #type($u) != "HASH_IDENTIFIER" && #type($u + 1) == "EOF") {
            return [null, $u];
        }

        $static = in_array("STATIC", $modifiers);
        $name = #type($u) == "HASH_IDENTIFIER" ? slice(#text($u), 1) : #text($u + 1);
        $what = match (#type($u)) {
            "FN" => #function_what($name, $owner, $static),
            "KIND" => Declaration::KIND,
            "CONST" => Declaration::CONSTANT,
            default => $static ? Declaration::STATIC_FIELD : Declaration::FIELD,
        };
        $end = #declaration_end($u, $what);
        $start = #tokens[$t].start;
        $signature = slice(#source, $start, #tokens[$end - 1].stop - $start);
        $pub = in_array("PUB", $modifiers);
        $declaration = Declaration($what, $name, $pub, $owner, $signature, #tokens[$t].line, #docblock_above($t));

        return [$declaration, $end];
    }

    // fn, const, a field's #name, or kind followed by its name (not a field's type, kind #k)
    fn is_declaring_word(int $u): bool {
        return in_array(#type($u), ["FN", "CONST", "HASH_IDENTIFIER", "EOF"]) || #is_kind_word($u);
    }

    fn is_kind_word(int $u): bool {
        return #type($u) == "KIND" && #type($u + 1) == "IDENTIFIER";
    }

    fn function_what(string $name, ?string $owner, bool $static): string {
        return match {
            $owner == null => Declaration::FUNCTION,
            $name == "_" => Declaration::CONSTRUCTOR,
            $static => Declaration::STATIC_METHOD,
            default => Declaration::METHOD,
        };
    }

    /*
     * The token after a declaration's signature: a function's or kind's ends before its body
     * (or the ; of one without), a constant's or field's at its ;, past any braces of its value
     */
    fn declaration_end(int $u, string $what): int {
        $depth = 0;
        $stops_at_brace = !in_array($what, [Declaration::CONSTANT, Declaration::FIELD, Declaration::STATIC_FIELD]);
        while (#type($u) != "EOF") {
            $type = #type($u);
            if ($depth == 0 && ($type == "SEMICOLON" || $type == "LEFT_BRACE" && $stops_at_brace)) {
                return $type == "SEMICOLON" ? $u + 1 : $u;
            }
            $depth += #depth_change($type, OPENERS, CLOSERS);
            $u++;
        }

        return $u;
    }

    fn type(int $t): string {
        return $t < len(#tokens) ? #tokens[$t].type : "EOF";
    }

    // A token's text as the source has it
    fn text(int $t): string {
        if ($t >= len(#tokens)) {
            return "";
        }
        $token = #tokens[$t];

        return slice(#source, $token.start, $token.stop - $token.start);
    }

    // The source the lexer skipped before token $t: whitespace and comments
    fn gap_before(int $t): string {
        $start = $t == 0 ? 0 : #tokens[$t - 1].stop;
        $stop = $t < len(#tokens) ? #tokens[$t].start : len(#source);

        return slice(#source, $start, $stop - $start);
    }

    /*
     * The text of the docblock right above token $t, or null: the last comment before it,
     * starting its own line, with no blank line after it
     */
    fn docblock_above(int $t): ?string {
        $gap = #gap_before($t);
        $comments = comments_in($gap);
        if (len($comments) == 0) {
            return null;
        }
        [$start, $stop] = last($comments);
        $comment = slice($gap, $start, $stop - $start);
        $after = slice($gap, $stop);
        if (!is_docblock($comment) || len(split($after, "\n")) > 2) {
            return null;
        }
        $line_start = slice($gap, 0, $start);
        $newline = last_index_of($line_start, "\n");
        $before = $newline == null ? $line_start : slice($line_start, $newline + 1);
        if (trim($before) != "" || $newline == null && $t > 0) {
            return null;
        }

        return docblock_text($comment);
    }

    // The first docblock of the file, when what follows it is the file's namespace line
    fn overview(): ?string {
        if (#type(0) != "NAMESPACE") {
            return null;
        }
        $gap = #gap_before(0);
        foreach (comments_in($gap) as [$start, $stop]) {
            $comment = slice($gap, $start, $stop - $start);
            if (is_docblock($comment)) {
                return docblock_text($comment);
            }
        }

        return null;
    }
}

/*
 * Where each comment lies in text the lexer skipped, as [start, stop] pairs: a line comment (or
 * a script's first line) to the end of its line, a block comment past the first closer after
 * its opener, since they don't nest
 */
fn comments_in(string $gap): list {
    $comments = [];
    $i = 0;
    while ($i < len($gap)) {
        $stop = match {
            starts_with($gap, "//", $i) || starts_with($gap, "#!", $i) => index_of($gap, "\n", $i) ?? len($gap),
            starts_with($gap, "/*", $i) => (index_of($gap, "*/", $i + 2) ?? len($gap) - 2) + 2,
            default => null,
        };
        if ($stop == null) {
            $i++;
            continue;
        }
        $comments[] = [$i, $stop];
        $i = $stop;
    }

    return $comments;
}

// Whether a comment is a docblock: two stars after its slash, and then not the closing slash
fn is_docblock(string $comment): bool {
    return starts_with($comment, "/**") && !starts_with($comment, "/", 3);
}

fn last_index_of(string $text, string $needle): ?int {
    $found = null;
    $at = index_of($text, $needle);
    while ($at != null) {
        $found = $at;
        $at = $at + 1 < len($text) ? index_of($text, $needle, $at + 1) : null;
    }

    return $found;
}

/*
 * A docblock's text without its marks: each line without the star down the side and the
 * space after it, trailing spaces (and a CRLF's carriage return) dropped, and the empty lines
 * the opener and closer usually stand on left out
 */
fn docblock_text(string $comment): string {
    $lines = [];
    foreach (split(slice($comment, 3, -2), "\n") as $line) {
        $lines[] = docblock_line(trim_end($line));
    }
    while (len($lines) > 0 && $lines[0] == "") {
        delete $lines[0];
    }
    while (len($lines) > 0 && last($lines) == "") {
        delete $lines[len($lines) - 1];
    }

    return join($lines, "\n");
}

fn docblock_line(string $line): string {
    $text = unindented($line);
    if (starts_with($text, "*")) {
        $text = slice($text, 1);
    }

    return starts_with($text, " ") ? slice($text, 1) : $text;
}
