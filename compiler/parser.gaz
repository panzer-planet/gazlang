// The GazLang parser in GazLang: tokens to a tree of the nodes in nodes.gaz, as --ast shows it.
// tests/SelfHostedParserTest.php checks its trees and errors against tests/parser_corpus.
// Methods are named after the grammar rule they read (function_call(), ternary()).
//
// This file has no top level code, so it can be included:
// $root = Parser(Lexer($text), $path).parse(). Errors are ParseErrors.
namespace gazlang;

include "lexer.gaz";
include "nodes.gaz";

// #line and #file are Error's own, and say where in this file the error was raised, so the
// place in the source being parsed has names of its own, as in LexError
kind ParseError extends Error {
    pub #reason;
    pub #source_file;
    pub #source_line;

    // Where the error is: a file is null for piped or inline source
    fn _($reason, $source_file, $source_line) {
        ##_($reason .. " " .. ($source_file == null ? "on line {$source_line}" : "at {$source_file}:{$source_line}"));
        #reason = $reason;
        #source_file = $source_file;
        #source_line = $source_line;
    }
}

// Collects the $ variables a node uses, in source order, and those it assigns with a plain =
//
// A nested lambda contributes the variables it captures, since those must be read when it is
// created, and nothing it assigns, which is local to its own calls. An object rather than
// two maps passed along: a map passed to a function is a copy.
kind VariableCollector {
    // The names, as the keys of a map, which keeps them in the order they were first met
    pub #found = {};
    pub #assigned = {};

    // A stack rather than recursion: a chain of operators is as deep on its left as it is
    // long, and two calls a level would run out of call depth at about 5000 of them
    pub fn collect($node) {
        $stack = [$node];
        while (len($stack) > 0) {
            $last = len($stack) - 1;
            $value = $stack[$last];
            delete $stack[$last];

            $children = is_a($value, AST) ? #visit($value) : $value;
            if (type_of($children) == "map") {
                $children = values($children);
            }
            // Children sit at any depth of lists and maps: a list literal's [key, value]
            // entries, a match's arms, whose values are a list inside each arm. The last goes
            // on first, so the first comes off next and names are found in source order.
            foreach (reverse($children) as $child) {
                if (is_a($child, AST) || type_of($child) == "list" || type_of($child) == "map") {
                    $stack[] = $child;
                }
            }
        }
    }

    // Note what one node uses and assigns, and give what is to be searched under it
    fn visit($node) {
        if (is_a($node, VariableAST)) {
            if (!$node.is_global()) {
                #found[$node.value] = true;
            }

            return [];
        }
        if (is_a($node, LambdaAST)) {
            foreach ($node.captures as $name) {
                #found[$name] = true;
            }

            return [];
        }
        $targets = match {
            is_a($node, AssignAST) && is_a($node.left, ListPatternAST) => $node.left.targets,
            is_a($node, AssignAST) && $node.token.type == "ASSIGN" => [$node.left],
            is_a($node, ForeachStatementAST) && is_a($node.value, ListPatternAST) => [$node.key, ...$node.value.targets],
            is_a($node, ForeachStatementAST) => [$node.key, $node.value],
            default => [],
        };
        if (is_a($node, TryStatementAST)) {
            foreach ($node.catches as $catch) {
                $targets[] = $catch[1];
            }
        }
        foreach ($targets as $target) {
            if (is_a($target, VariableAST) && !$target.is_global()) {
                #assigned[$target.value] = true;
            }
        }

        return fields($node);
    }
}

kind Parser {
    #lexer;
    #current_token;
    // The token before it, so a syntax error can point at a miscapitalised keyword that was
    // read as a name (see keyword_hint())
    #previous_token = null;
    // The token the statement being parsed starts with, so a syntax error in "} elseif (...) {"
    // can say to write "else if" (see keyword_hint())
    #statement_token = null;
    // The file being parsed, as shown in errors
    #file;
    // Directory that include paths in the file being parsed are relative to
    #base_dir;
    // The real path of every file parsed so far, so each is only included once, however it is spelt
    #included = {};

    // How many loops enclose the statement being parsed, so break and continue can be checked
    #loop_depth = 0;
    // Whether a function body is being parsed, so return can be checked
    #in_function = false;
    // Whether a finally block is being parsed, which return, break and continue can't leave
    #in_finally = false;
    // Whether a constructor's body is being parsed, where return can't give a value
    #in_constructor = false;
    // Whether a constant's value is being parsed, where a string can't interpolate a variable
    #in_constant = false;

    // The kind whose body is being parsed, where # can be used
    #kind = null;

    // Declared kinds by name, resolved once the whole program is read
    #kinds = {};
    // The fields a constructor's promoted parameters declared, as "Kind::name", so a second
    // declaration of one can say where the first came from (a promoted parameter is the field)
    #promoted = {};

    // Every #name, in source order, as [node, the kind it is written in, the argument count
    // if it is called or null, whether it is assigned to], checked once the kinds are
    // resolved. A node holds its index here (PropertyAST.use), so what is learnt about it
    // later finds the record again, since an object can't be a map key. An index
    // rather than the record itself, which would make every kind's tree a cycle: the node,
    // its record, the kind, its methods, the node.
    #member_uses = [];

    // Every constant, in the order declared, as [expression, the kind that declares it or
    // null, its name as errors show it]. A kind's constant X is keyed "Kind::X".
    #constants = {};
    // The constants worked out so far, by the same keys
    #constant_values = {};
    // The constants being worked out, outermost first, to find one that depends on itself
    #folding = [];
    // Every qualified name written under, with the operator that did it, which is only
    // allowed if the name turns out to be a static field
    #static_writes = [];
    // Every static field, "Owner::name" to its slot in declaration order, and the constant
    // each starts at, which the code generator writes before anything else runs
    #statics = {};
    #static_defaults = [];
    // Every static method's FunctionDeclarationAST, which the top level gets as a function
    #static_functions = [];
    // The kind whose static method is being parsed, so #name in it is the kind's
    #in_static = null;

    // Every Name.member, which is an error if Name turns out to be a kind: a kind is
    // reached by name, with ::, and the dot goes through a value
    #dot_on_names = [];

    // The namespace the file being parsed declares, "" when it declares none, so that its
    // names are global. Saved and restored around an include, as #file is.
    #namespace = "";
    // This file's aliases, each bare name an `include ... use` brought in to what it means
    #aliases = {};
    // The namespaces this file may write: its own, and every one it includes itself. There
    // is no standalone use, so naming one a file it includes happens to include is refused.
    #reachable = {};
    // Each file's [namespace, aliases, reachable] once it is parsed, since a name is only
    // resolved when the whole program is read. #scope is the current file's index here, and
    // 0 is the global scope the builtin kinds are parsed in.
    #scopes = [["", {}, {}]];
    #scope = 0;
    // Whether anything has been parsed in this file, since namespace must come first
    #file_started = false;
    // The real path of the file being parsed, which is how a namespace is recorded against
    // it as soon as it is declared, so a cycle back into it still finds it
    #real_file = null;
    // The namespace each file declares, by real path, so a `use` on a file already included
    // is still checked against it
    #file_namespaces = {};
    // Every namespace any file declares
    #namespaces = {};
    // The namespace each declared top level name is in, and which of them are pub
    #declared_in = {};
    #public = {};
    // Every kind's parent and every catch clause's kind, as [kind or node, scope], since
    // both name a kind that is resolved once the whole program is read
    #parent_names = [];
    // Every name an `include ... use` clause brought in, as [qualified name, file, line,
    // scope], checked once the whole program is read as any other use of it is
    #alias_uses = [];

    // Every catch clause that names a kind, as [try node, which catch, line, file, scope]:
    // the name is in a list on the node, so resolution writes the resolved one back there
    #catch_types = [];

    // Whether any catch clause was parsed, so the program needs the Error kind
    #catches = false;

    // The shared variables visible here, by name ($x): those a `shared` statement declared
    // earlier in this function, or in the function a lambda is written in and the lambdas
    // around it. A named function starts with none.
    #shared = {};
    // The plain variables named so far in this function or lambda, each with how many times, so
    // a `shared` statement for one already in use is refused rather than made a second
    // variable. A lambda's parameters are read as expressions before the -> shows they are
    // parameters, so lambda() takes them back out (forget_uses()).
    #plain = {};
    // The parameters of the function or lambda being parsed, which can't be shared
    #bound = {};
    // Whether any shared variable was declared, so the program needs the Shared kind
    #shares = false;

    // Every ##name as [node, the kind it is written in], checked once the kinds are resolved
    #parent_uses = [];

    // Source of the builtin kinds, parsed into every program: Error is what runtime errors
    // and error("message") throw, and Shared is the box a `shared` variable lives in (see
    // shared_declaration()). Single quoted, so nothing in it is interpolated.
    // Every program reaches an error's members ($e.message), and printing one calls its
    // to_string() from outside, so all of them are pub
    const BUILTIN_SOURCE = 'kind Error {
    pub #message;
    pub #file;
    pub #line;
    pub #trace;
    fn _($message) { #message = $message; }
    pub fn to_string() { return "{#message}"; }
}
kind Shared {
    fn _(pub #value);
}';

    // How errors name the builtin kinds' source
    const BUILTIN_FILE = "<builtin>";
    // The directory of the standard library's files, which are built in
    const STD_DIRECTORY = "<std>";

    // Every call by name and bare name used as a value, in source order, checked against the
    // declared functions once the whole program is read
    #uses = [];

    // The ( that starts the expression being parsed at the ternary's level, the only place a
    // parenthesised parameter list can start a lambda. One is enough, rather than a set of
    // them, since nothing is read between ternary() marking a ( and parenthesised() asking
    // about it.
    #lambda_head = null;

    // Assignment operator token types: = and the compound assignments
    const ASSIGNMENTS = [
        "ASSIGN", "PLUS_ASSIGN", "MINUS_ASSIGN", "MULTIPLY_ASSIGN", "DIVIDE_ASSIGN", "MODULO_ASSIGN",
        "CONCAT_ASSIGN", "COALESCE_ASSIGN",
        "BIT_AND_ASSIGN", "BIT_OR_ASSIGN", "BIT_XOR_ASSIGN", "SHIFT_LEFT_ASSIGN", "SHIFT_RIGHT_ASSIGN",
    ];

    // The binary operators' levels, loosest first, each left associative: the tower in
    // CLAUDE.md from logical_or down to multiplicative. A new level is a new number here.
    const BINARY_LEVELS = {
        "OR" => 1,
        "AND" => 2,
        "EQUALS" => 3, "NOT_EQUALS" => 3, "SPACESHIP" => 3,
        "LESS_THAN" => 4, "LESS_EQUALS" => 4, "GREATER_THAN" => 4, "GREATER_EQUALS" => 4,
        "CONCAT" => 5,
        "BIT_OR" => 6,
        "BIT_XOR" => 7,
        "BIT_AND" => 8,
        "SHIFT_LEFT" => 9, "SHIFT_RIGHT" => 9,
        "PLUS" => 10, "MINUS" => 10,
        "MULTIPLY" => 11, "DIVIDE" => 11, "MODULO" => 11,
    };

    // Keywords reserved for features that don't exist yet, so adding them never breaks a program
    const RESERVED = ["INTERFACE", "IMPLEMENTS", "FINAL"];

    // Reserved, and each says how this language spells what it means
    const INSTEAD = {
        "PUBLIC" => "write 'pub'",
        "PROTECTED" => "write 'kin'",
        "PRIVATE" => "a member says nothing to be its kind's own",
    };

    // Every builtin function mapped to its parameter count, [fewest, most] when some are
    // optional: the builtins of the runtime this parser runs on, which is the one that will run
    // what it parses until there is a compiler to write bytecode for another
    #builtins = builtins();
    // Those and the declared functions, which share their namespace
    #functions = #builtins;

    // How expected tokens are described in syntax errors; other types are keywords, shown quoted and lowercase
    const EXPECTED = {
        "LEFT_PAREN" => "'('", "RIGHT_PAREN" => "')'", "LEFT_BRACE" => "'{'", "RIGHT_BRACE" => "'}'",
        "LEFT_BRACKET" => "'['", "RIGHT_BRACKET" => "']'", "SEMICOLON" => "';'", "COMMA" => "','",
        "IDENTIFIER" => "a name", "VAR_IDENTIFIER" => "a \$variable", "GLOBAL_VAR_IDENTIFIER" => "an @variable",
        "STRING" => "a string", "COLON" => "':'", "ARROW" => "'->'", "DOUBLE_ARROW" => "'=>'", "ASSIGN" => "'='",
    };

    // $path is the file the source came from, if any; includes resolve relative to it. A path
    // with nothing there, like a name given to inline source, has no directory to be relative
    // to: as without a path, includes are then relative to the working directory.
    fn _($lexer, $path = null) {
        $real_path = $path != null && file_exists($path) ? real_path($path) : null;
        if ($real_path != null) {
            #included[$real_path] = true;
            #file_namespaces[$real_path] = "";
        }
        #real_file = $real_path;
        #base_dir = $real_path != null ? #dirname($real_path) : cwd();
        // The main file is shown as the user gave it; included files relative to the working directory
        #file = $path;
        #lexer = $lexer;
        #current_token = #next_token();
    }

    // Raise an error for an unexpected token
    fn unexpected() {
        #fail("Unexpected " .. #describe(#current_token));
    }

    // Raise an error at the current token's line
    fn fail($message) {
        error(ParseError($message .. #keyword_hint(), #file, #current_token.line));
    }

    // Raise an error somewhere else, without the hint
    fn fail_at($message, $file, $line) {
        error(ParseError($message, $file, $line));
    }

    // A hint when the error is at, or just after, a keyword written in the wrong case, or in a
    // statement that starts with PHP's elseif. A name that is already declared is left alone:
    // naming things If and Match is the point of the rule.
    fn keyword_hint() {
        foreach ([#current_token, #previous_token] as $token) {
            if ($token != null && $token.type == "IDENTIFIER" && has_key(Lexer::KEYWORDS, lower($token.value))
                && !has_key(#functions, $token.value) && !has_key(#kinds, $token.value) && !has_key(#constants, $token.value)) {
                return " (keywords are lowercase: write '" .. lower($token.value) .. "', not '{$token.value}')";
            }
        }
        // PHP's elseif is read as a call to a function of that name, which fails at the { after it
        $token = #statement_token;
        if ($token != null && $token.type == "IDENTIFIER" && lower($token.value) == "elseif" && !has_key(#functions, $token.value)) {
            return " (write 'else if', not '{$token.value}')";
        }

        return "";
    }

    // Describe a token the way it appears in the source, for error messages
    fn describe($token) {
        return match {
            $token.type == "EOF" => "end of file",
            // A list prints its strings as literals
            in_array($token.type, ["STRING", "STRING_START", "STRING_MIDDLE", "STRING_END"]) => "string " .. slice(to_string([$token.value]), 1, -1),
            // A float prints as the shortest literal that reads back
            default => "'{$token.value}'",
        };
    }

    // Get the next token, adding this file's name to lexer errors
    fn next_token() {
        try {
            return #lexer.get_next_token();
        } catch (LexError $e) {
            error(ParseError($e.reason, #file, $e.source_line));
        }
    }

    // A real path relative to the working directory when it is inside it
    fn display_path($real_path) {
        $cwd = cwd() .. "/";

        return starts_with($real_path, $cwd) ? slice($real_path, len($cwd)) : $real_path;
    }

    // A file's text, or null if it can't be read, which is how a directory or an unreadable
    // file is told apart from one to include. Only the read is in the try: a catch of Error
    // around more would also catch a bug in it, or running out of call depth.
    fn read($path) {
        try {
            return read_file($path);
        } catch (Error $e) {
            return null;
        }
    }

    // The directory a real path is in, as PHP's dirname(): a real path has no "." or ".." steps,
    // doubled slashes or trailing slash to get wrong
    fn dirname($path) {
        $steps = split($path, "/");
        if (len($steps) == 1) {
            return ".";
        }
        $directory = join(slice($steps, 0, -1), "/");

        return $directory == "" ? "/" : $directory;
    }

    // Record where a node came from, so errors about it can point at the source
    fn at($node, $token) {
        $node.line = $token.line;
        $node.file = #file;

        return $node;
    }

    // If the current token has this type, eat it and get the next one; if not, fail
    fn eat($token_type) {
        if (#current_token.type != $token_type) {
            $expected = #EXPECTED[$token_type] ?? "'" .. lower($token_type) .. "'";
            #fail("Expected {$expected} but found " .. #describe(#current_token));
        }

        #previous_token = #current_token;
        #current_token = #next_token();
    }

    // Parse a local ($name) or global (@name) variable
    //
    // A shared variable is read and written through the box it lives in: $name is
    // $#shared_name.value, an ordinary field of a hidden variable, so nothing below the parser
    // learns of it
    fn variable() {
        $token = #current_token;
        $node = #at(VariableAST($token), $token);
        #eat($token.type == "GLOBAL_VAR_IDENTIFIER" ? "GLOBAL_VAR_IDENTIFIER" : "VAR_IDENTIFIER");
        if ($token.type == "GLOBAL_VAR_IDENTIFIER") {
            return $node;
        }
        if (has_key(#shared, $token.value)) {
            return #shared_use($token);
        }
        #plain[$token.value] = (#plain[$token.value] ?? 0) + 1;

        return $node;
    }

    // What a use of the shared variable $token names is: the value in its box
    fn shared_use($token) {
        $box_token = Token("VAR_IDENTIFIER", "\$#shared_" .. slice($token.value, 1));
        $box_token.line = $token.line;
        $box = #at(VariableAST($box_token), $token);

        return #at(PropertyAST($box, "value"), $token);
    }

    // The name ($x) of the shared variable a node is a use of, or null if it isn't one
    fn shared_name($node) {
        if (is_a($node, PropertyAST) && $node.name == "value" && is_a($node.target, VariableAST)
            && starts_with($node.target.value, "\$#shared_")) {
            return "$" .. slice($node.target.value, 9);
        }

        return null;
    }

    // Begin a function or lambda body, where the variables named so far start again: with
    // $inherit (a lambda) the shared variables around it stay visible. Gives what leave_scope()
    // puts back, and $params are the names the body starts out using.
    fn enter_scope($params, $inherit) {
        $saved = [#shared, #plain, #bound];
        if (!$inherit) {
            #shared = {};
        }
        #plain = {};
        #bound = {};
        foreach ($params as $param) {
            #bound[$param] = true;
        }

        return $saved;
    }

    fn leave_scope($saved) {
        [#shared, #plain, #bound] = $saved;
    }

    // Take back one use of each of these names: a lambda's parameters, which variable() counted
    // in the scope around the lambda before its -> showed what they were
    fn forget_uses($names) {
        foreach ($names as $name) {
            $left = (#plain[$name] ?? 0) - 1;
            if ($left > 0) {
                #plain[$name] = $left;
            } else if (has_key(#plain, $name)) {
                delete #plain[$name];
            }
        }
    }

    // Parse a call by name (IDENTIFIER arguments), the name having been eaten. $at is its
    // first token, which is where it is located however many :: the name has.
    fn function_call($name, $at) {
        $node = #at(FunctionCallAST($name, #arguments()), $at);
        #uses[] = [$node, #scope];

        return $node;
    }

    // The rest of a name after its first part (( DOUBLE_COLON IDENTIFIER )*)
    //
    // :: resolves a name, so Token::EOF and json::Reader::EOF are each one name, read here and
    // looked up once the whole program is read, as a bare name is.
    fn qualified_name($name) {
        while (#current_token.type == "DOUBLE_COLON") {
            #eat("DOUBLE_COLON");
            $part = #current_token;
            if ($part.type != "IDENTIFIER") {
                #fail("Expected a name after :: but found " .. #describe($part));
            }
            #eat("IDENTIFIER");
            $name ..= "::" .. $part.value;
        }

        return $name;
    }

    // Parse a call's arguments (LPAREN [expr (COMMA expr)*] RPAREN)
    fn arguments() {
        #eat("LEFT_PAREN");

        $args = [];
        if (#current_token.type != "RIGHT_PAREN") {
            $args[] = #expr();
            while (#current_token.type == "COMMA") {
                #eat("COMMA");
                $args[] = #expr();
            }
        }
        #eat("RIGHT_PAREN");

        return $args;
    }

    // Parse a primary (INTEGER | FLOAT | STRING | interpolated_string | TRUE | FALSE | NULL | LPAREN expr RPAREN
    //                  | variable | function_call | IDENTIFIER | list_literal | map_literal | match)
    //
    // A bare IDENTIFIER not followed by ( is a function used as a value; that it names a
    // function is checked once the whole program is read, like calls.
    fn primary() {
        $token = #current_token;
        $type = $token.type;

        if ($type == "INTEGER" || $type == "FLOAT") {
            #eat($type);

            return #at(NumAST($token), $token);
        } else if ($type == "STRING") {
            #eat("STRING");

            return #at(StringAST($token), $token);
        } else if ($type == "STRING_START") {
            return #interpolated_string();
        } else if ($type == "TRUE" || $type == "FALSE") {
            #eat($type);

            return #at(BooleanAST($token), $token);
        } else if ($type == "NULL") {
            #eat("NULL");

            return #at(NullAST($token), $token);
        } else if ($type == "IDENTIFIER") {
            #eat("IDENTIFIER");
            $name = #qualified_name($token.value);
            if (#current_token.type == "LEFT_PAREN") {
                return #function_call($name, $token);
            }
            $node = #at(FunctionRefAST($name), $token);
            #uses[] = [$node, #scope];

            return $node;
        } else if ($type == "MATCH") {
            return #match_expression(false);
        } else if ($type == "LEFT_BRACKET") {
            return #list_literal();
        } else if ($type == "LEFT_BRACE") {
            return #map_literal();
        } else if ($type == "LEFT_PAREN") {
            return #parenthesised();
        } else if ($type == "VAR_IDENTIFIER" || $type == "GLOBAL_VAR_IDENTIFIER") {
            return #variable();
        } else if ($type == "HASH" || $type == "HASH_IDENTIFIER") {
            return #this_member();
        } else if ($type == "PARENT_IDENTIFIER") {
            return #parent_method();
        } else if ($type == "PARENT") {
            #fail("## alone is not allowed: write ##name for the parent's version of a method");
        } else if ($type == "SPREAD") {
            #fail("... only spreads into a list or map literal, as in [...\$a, 1] or \{...\$m, \"k\" => 1}");
        } else if (has_key(#INSTEAD, $type)) {
            #fail("{$token.value} is reserved: {#INSTEAD[$type]}");
        } else if (in_array($type, #RESERVED)) {
            #fail("{$token.value} is reserved");
        }

        #unexpected();
    }

    // Parse # (the object a method runs on) or #name (its member)
    //
    // Only inside a kind: in a method, a field default, or a lambda in either. Whether the
    // kind has the member is checked once the whole program is read.
    fn this_member() {
        $token = #current_token;
        if (#kind == null) {
            #fail("Cannot use {$token.value} outside a method");
        }
        if (#in_static != null && $token.type == "HASH") {
            #fail("Cannot use # in a static method: it has no object");
        }
        #eat($token.type);
        if ($token.type == "HASH" && #current_token.type == "PROPERTY") {
            #fail("Write #" .. slice(#current_token.value, 1) .. ", not #" .. #current_token.value);
        }

        $this_node = #at(ThisAST(), $token);
        if ($token.type == "HASH") {
            return $this_node;
        }

        $name = slice($token.value, 1);
        if ($name == "_") {
            #fail("Cannot use the constructor _ as a member: construct with {#kind.name}(...), or call ##_(...) in a child's constructor");
        }
        $node = #at(PropertyAST($this_node, $name), $token);
        $node.use = len(#member_uses);
        #member_uses[] = [$node, #kind, null, false, false, #in_static != null];

        return $node;
    }

    // Parse ##name (a bound method) or ##name(args) (a call), the parent kind's version of a method
    //
    // Only inside a kind, and ##_(...) only in a constructor. That the parent has the method
    // is checked once the whole program is read.
    fn parent_method() {
        $token = #current_token;
        if (#kind == null) {
            #fail("Cannot use {$token.value} outside a method");
        }
        $name = slice($token.value, 2);
        if ($name == "_" && !#in_constructor) {
            #fail("##_ can only be used in a constructor, to run the parent's");
        }
        #eat("PARENT_IDENTIFIER");

        $args = #current_token.type == "LEFT_PAREN" ? #arguments() : null;
        if ($name == "_" && $args == null) {
            #fail("Call the parent's constructor as ##_(...)");
        }
        $node = #at(ParentMethodAST($name, $args), $token);
        #parent_uses[] = [$node, #kind];

        return $node;
    }

    // Parse a parenthesised expression, or a lambda whose parameters are in parentheses
    //
    // (LPAREN [expr (COMMA expr)*] RPAREN [ARROW lambda_body]): a comma list is parsed
    // either way, so no lookahead is needed to tell ($a, $b = 1) -> ... from ($a + 1).
    // Only a ( that starts an expression at the ternary's level (see ternary()) can head a
    // lambda, so 1 + ($x) -> 2 is a syntax error like 1 + $x -> 2, and anywhere else a
    // comma is the usual error at once. When -> follows, each element must have been
    // written as $parameter or $parameter = default, not (($a)) or $a[0] = 1.
    fn parenthesised() {
        $paren = #current_token;
        $head = #lambda_head == $paren;
        #eat("LEFT_PAREN");

        // Each item with the token it starts at, for checking it as a parameter
        $items = [];
        $comma = null;
        if (#current_token.type != "RIGHT_PAREN") {
            $first = #current_token;
            $items[] = [$first, #expr()];
            while (#current_token.type == "COMMA") {
                if (!$head) {
                    #unexpected();
                }
                $comma ??= #current_token;
                #eat("COMMA");
                $first = #current_token;
                $items[] = [$first, #expr()];
            }
        }
        $close = #current_token;
        #eat("RIGHT_PAREN");

        if (!$head || #current_token.type != "ARROW") {
            if ($comma != null) {
                #fail_at("Expected ')' but found ','", #file, $comma.line);
            }
            if ($items == []) {
                #fail_at("Unexpected ')'", #file, $close.line);
            }

            return $items[0][1];
        }

        $params = [];
        $defaults = [];
        $lines = [];
        $patterns = [];
        foreach ($items as [$first, $item]) {
            $default = null;
            if (is_a($item, AssignAST) && $item.token.type == "ASSIGN") {
                $default = $item.right;
                $item = $item.left;
            }
            if ($first.type == "LEFT_BRACKET" && (is_a($item, ArrayLiteralAST) || is_a($item, ListPatternAST))) {
                // [$a, $b] or, with a default, [$a, $b] = [...], which parsed as taking a list apart
                $pattern = is_a($item, ListPatternAST)
                    ? ListPatternAST(map($item.targets, #parameter_target))
                    : #list_pattern($item, #parameter_target);
                $pattern.line = $item.line;
                [$param, $statement] = #pattern_parameter($pattern, len($params));
                $patterns[] = $statement;
            } else if ($first.type == "VAR_IDENTIFIER" && #shared_name($item) != null) {
                #fail_at("Lambda parameter " .. #shared_name($item) .. " has the name of a shared variable: choose another name", #file, $first.line);
            } else if ($first.type != "VAR_IDENTIFIER" || !is_a($item, VariableAST) || $item.value != $first.value) {
                #fail_at("Lambda parameters must be \$variables or [\$variable, ...] patterns", #file, $first.line);
            } else {
                $param = $item.value;
            }
            $params[] = $param;
            $defaults[] = $default;
            $lines[] = $first.line;
            #check_bound($params, $patterns, "lambda", $first.line);
        }

        return #lambda($paren, $params, $defaults, $lines, $patterns);
    }

    // Parse a lambda's body after its parameters (ARROW (block | expr)) and build the node
    //
    // An expression body's value is returned; a block body returns only through return.
    // A block body is a function body: return is allowed, and break and continue can't
    // reach a loop around the lambda.
    //
    // What was set aside is restored after the body, not in a finally: nothing catches a
    // ParseError and carries on parsing.
    fn lambda($start, $params, $defaults, $lines, $patterns = []) {
        $arity = #check_parameters($params, $defaults, $lines);
        #eat("ARROW");
        $bound_names = filter($params, $param -> !starts_with($param, "\$#"));
        foreach ($patterns as $statement) {
            $bound_names = [...$bound_names, ...map($statement.expr.left.targets, $target -> $target.value)];
        }
        #forget_uses($bound_names);

        // A lambda in a constructor isn't the constructor: it can return values, and can't run ##_;
        // one in a finally block can return too
        [$in_constructor, $in_finally] = [#in_constructor, #in_finally];
        [#in_constructor, #in_finally] = [false, false];
        $scope = #enter_scope($params, true);
        if (#current_token.type == "LEFT_BRACE") {
            [$in_function, $loop_depth] = [#in_function, #loop_depth];
            [#in_function, #loop_depth] = [true, 0];
            $body = #block();
            [#in_function, #loop_depth] = [$in_function, $loop_depth];
        } else {
            $body = #expr();
        }
        [#in_constructor, #in_finally] = [$in_constructor, $in_finally];
        // Pattern parameters are taken apart first, which makes an expression body a block
        // returning it
        if ($patterns != []) {
            if (is_a($body, CompoundAST)) {
                $body.statements = [...$patterns, ...$body.statements];
            } else {
                $block = #at(CompoundAST(), $start);
                $block.statements = [...$patterns, #at(ReturnStatementAST($body), $start)];
                $block.statements[len($block.statements) - 1].line = $body.line;
                $body = $block;
            }
        }

        // The outer variables it uses, except those a plain = (or foreach or catch) makes local to each call
        $variables = VariableCollector();
        foreach ($defaults as $default) {
            if ($default != null) {
                $variables.collect($default);
            }
        }
        $variables.collect($body);
        $captures = [];
        foreach ($variables.found as $name => $_) {
            if (!in_array($name, $params) && !has_key($variables.assigned, $name)) {
                $captures[] = $name;
            }
        }

        // What it captured, it used: naming one as shared later, where it was already used, is refused
        #leave_scope($scope);
        foreach ($captures as $name) {
            if (!starts_with($name, "\$#")) {
                #plain[$name] = (#plain[$name] ?? 0) + 1;
            }
        }

        $lambda = #at(LambdaAST($params, $defaults, $arity, $body, $captures), $start);
        $lambda.owner = #kind == null ? null : #kind.name;

        return $lambda;
    }

    // Check a lambda's parameter list, with the same rules as a function's, and work out its arity
    fn check_parameters($params, $defaults, $lines) {
        $seen = {};
        $required = 0;
        foreach ($params as $i => $param) {
            if (has_key($seen, $param)) {
                #fail_at("Duplicate parameter {$param} in lambda", #file, $lines[$i]);
            }
            $seen[$param] = true;
            if ($defaults[$i] == null) {
                if ($required < $i) {
                    #fail_at("Required parameter {$param} can't follow a parameter with a default", #file, $lines[$i]);
                }
                $required++;
            }
        }

        return #arity($params, $defaults);
    }

    // A parameter list's arity: a count, or [fewest, most] when there are defaults
    fn arity($params, $defaults) {
        $required = 0;
        foreach ($defaults as $default) {
            if ($default == null) {
                $required++;
            }
        }

        return $required == len($params) ? $required : [$required, len($params)];
    }

    // Parse an interpolated string (STRING_START expr (STRING_MIDDLE expr)* STRING_END)
    //
    // Desugared into concatenation: "Hi {$name}!" is "Hi " .. $name .. "!", which
    // converts values the way echo does; the backends need nothing new.
    fn interpolated_string() {
        $start = #current_token;
        #eat("STRING_START");
        $node = #at(StringAST($start), $start);

        while (true) {
            $value = #expr();
            if (#in_constant && is_a($value, VariableAST)) {
                // Said here, where it is known the string did it: check_constant_expression() only sees a variable
                $escape = $value.is_global() ? '\\{ for a brace' : '\\$ for a dollar sign';
                #fail_at("A constant can't interpolate {$value.value} into a string (write {$escape})", $value.file, $value.line);
            }

            $part = #current_token;
            if ($part.type != "STRING_MIDDLE" && $part.type != "STRING_END") {
                #fail("Expected '}' but found " .. #describe($part));
            }
            #eat($part.type);

            $concat = Token("CONCAT", "..");
            $concat.line = $part.line;
            $node = #at(BinOpAST($node, $concat, $value), $concat);
            if ($part.value != "") {
                $node = #at(BinOpAST($node, $concat, #at(StringAST($part), $part)), $concat);
            }

            if ($part.type == "STRING_END") {
                return $node;
            }
        }
    }

    // Parse a list literal (LBRACKET [expr (COMMA expr)* [COMMA]] RBRACKET)
    fn list_literal() {
        $start = #current_token;
        #eat("LEFT_BRACKET");

        $entries = [];
        while (#current_token.type != "RIGHT_BRACKET") {
            if (#current_token.type == "SPREAD") {
                // ...$a puts the elements of the list $a here
                $spread = #current_token;
                #eat("SPREAD");
                $entries[] = [null, #at(SpreadAST(#expr()), $spread)];
            } else {
                $entries[] = [null, #expr()];
            }
            if (#current_token.type == "DOUBLE_ARROW") {
                #fail("A list has no keys: write a map as \{key => value}");
            }

            // A trailing comma is allowed, so multi-line literals diff cleanly
            if (#current_token.type != "RIGHT_BRACKET") {
                #eat("COMMA");
            }
        }
        #eat("RIGHT_BRACKET");

        return #at(ArrayLiteralAST($entries), $start);
    }

    // Parse a map literal (LBRACE [entry (COMMA entry)* [COMMA]] RBRACE),
    // entry: expr DOUBLE_ARROW expr | SPREAD expr
    //
    // Only where an expression is expected: a { that starts a statement is a block, and one
    // right after -> is a lambda's block body, so a lambda returning a map writes ({...}).
    fn map_literal() {
        $start = #current_token;
        #eat("LEFT_BRACE");

        $entries = [];
        while (#current_token.type != "RIGHT_BRACE") {
            if (#current_token.type == "SPREAD") {
                // ...$m sets every key of the map $m here, later entries winning, as a
                // duplicate key does; it has no key of its own, as a list's entries don't
                $spread = #current_token;
                #eat("SPREAD");
                $entries[] = [null, #at(SpreadAST(#expr()), $spread)];
            } else {
                $key = #expr();
                #eat("DOUBLE_ARROW");
                $entries[] = [$key, #expr()];
            }

            if (#current_token.type != "RIGHT_BRACE") {
                #eat("COMMA");
            }
        }
        #eat("RIGHT_BRACE");

        return #at(ArrayLiteralAST($entries, true), $start);
    }

    // Parse a postfix expression (primary (LBRACKET [expr] RBRACKET | arguments | PROPERTY)* [INCREMENT | DECREMENT])
    //
    // Empty brackets ($a[] = ...) append, so they are only allowed directly before an assignment.
    fn postfix() {
        $node = #primary();

        while (in_array(#current_token.type, ["LEFT_BRACKET", "LEFT_PAREN", "PROPERTY", "DOUBLE_COLON"])) {
            if (#current_token.type == "PROPERTY") {
                // $user.name: which members the object has is only known when it runs
                $token = #current_token;
                #eat("PROPERTY");
                $named = is_a($node, FunctionRefAST);
                $node = #at(PropertyAST($node, slice($token.value, 1)), $token);
                if ($named) {
                    // Token.EOF: a dot on a name, which is an error if Token turns out to be
                    // a kind, since a kind is reached by name, with ::
                    #dot_on_names[] = $node;
                }

                continue;
            }
            if (#current_token.type == "DOUBLE_COLON") {
                // A name read in primary() took its whole :: chain, so what is left here has
                // a value on the left of an operator that resolves a name
                #fail(":: resolves a name, so only a name can be on its left");
            }
            if (#current_token.type == "LEFT_PAREN") {
                if (is_a($node, PropertyAST)) {
                    // #save($x): calling a member, located at its name like reading it
                    $call = MethodCallAST($node, #arguments());
                    [$call.line, $call.file] = [$node.line, $node.file];
                    if ($node.use != null) {
                        #member_uses[$node.use][2] = len($call.args);
                    }
                    $node = $call;

                    continue;
                }
                // A call on a value: $f(1), $h["save"]($doc), pick()(2), (add)(1), located at its (
                $paren = #current_token;
                $node = #at(CallValueAST($node, #arguments()), $paren);

                continue;
            }
            $bracket = #current_token;
            #eat("LEFT_BRACKET");
            if (#current_token.type == "RIGHT_BRACKET") {
                #eat("RIGHT_BRACKET");
                if (!in_array(#current_token.type, #ASSIGNMENTS)) {
                    #fail("[] can only be used to append in an assignment");
                }

                return #at(IndexAST($node, null), $bracket);
            }
            $node = #at(IndexAST($node, #expr()), $bracket);
            #eat("RIGHT_BRACKET");
        }

        $token = #current_token;
        if ($token.type == "INCREMENT" || $token.type == "DECREMENT") {
            #eat($token.type);

            return #at(IncrementAST(#assignable($node, $token), $token, false), $token);
        }

        return $node;
    }

    // Parse a unary expression ((MINUS | NOT | BIT_NOT) unary | (INCREMENT | DECREMENT) postfix | postfix)
    fn unary() {
        $token = #current_token;

        if (in_array($token.type, ["MINUS", "NOT", "BIT_NOT"])) {
            #eat($token.type);

            return #at(UnaryOpAST($token, #unary()), $token);
        }

        if ($token.type == "INCREMENT" || $token.type == "DECREMENT") {
            #eat($token.type);

            return #at(IncrementAST(#assignable(#postfix(), $token), $token, true), $token);
        }

        return #postfix();
    }

    // Parse a binary expression whose operators all bind at least as tightly as $level
    // (unary (OP binary)*), every level being left associative
    //
    // A method for each level, each calling the next tighter one through left_associative(),
    // would take 24 calls to reach a primary through 11 levels that mostly find no
    // operator. This climbs instead: read an operand, and while the next token is an operator
    // of this level or tighter, its right side is whatever binds tighter than it. The tree is
    // the same. On the old PHP VM, parsing alone (not lexing) was 28% faster: football.gaz
    // 0.196s to 0.140s. #BINARY_LEVELS is the tower.
    fn binary($level) {
        $node = #unary();

        while (true) {
            $token = #current_token;
            $found = #BINARY_LEVELS[$token.type] ?? 0;
            if ($found < $level) {
                return $node;
            }
            #eat($token.type);
            $node = #at(BinOpAST($node, $token, #binary($found + 1)), $token);
        }
    }

    // Parse a logical or expression, the loosest binary level
    fn logical_or() {
        return #binary(1);
    }

    // Parse a null coalescing expression (logical_or [?? coalesce]), right associative
    fn coalesce() {
        $node = #logical_or();

        $token = #current_token;
        if ($token.type == "COALESCE") {
            #eat("COALESCE");

            return #at(BinOpAST($node, $token, #coalesce()), $token);
        }

        return $node;
    }

    // Parse a ternary (coalesce [? expr : ternary]), or a lambda with one bare parameter (VAR_IDENTIFIER ARROW lambda_body)
    //
    // Right associative, as in C and JS: $a ? 1 : $b ? 2 : 3 is $a ? 1 : ($b ? 2 : 3). The
    // middle is a full expression, so it can hold an assignment or another ternary.
    //
    // A lambda's body is an expression, so it extends as far right as it can: $x -> $x * 2
    // == 4 is $x -> ($x * 2 == 4), and $x -> $y -> $x + $y nests. Recognising $x -> here
    // (and the parenthesised form in parenthesised()) puts lambdas at the same level as the
    // ternary, so 1 + $x -> 2 is a syntax error.
    fn ternary() {
        $start = #current_token;
        if ($start.type == "LEFT_PAREN") {
            #lambda_head = $start;
        }
        $node = #coalesce();

        $token = #current_token;
        if ($token.type == "ARROW" && $start.type == "VAR_IDENTIFIER" && #shared_name($node) != null) {
            #fail_at("Lambda parameter " .. #shared_name($node) .. " has the name of a shared variable: choose another name", #file, $start.line);
        }
        if ($token.type == "ARROW" && is_a($node, VariableAST) && !$node.is_global() && $start.type == "VAR_IDENTIFIER") {
            return #lambda($start, [$node.value], [null], [$start.line]);
        }
        if ($token.type == "QUESTION") {
            #eat("QUESTION");
            $then = #expr();
            #eat("COLON");

            return #at(TernaryAST($node, $then, #ternary()), $token);
        }

        return $node;
    }

    // Parse an expression, the lowest precedence level ((variable | index) (= | += | -= | *= | /= | %= | ..= | ??=) expr | ternary)
    //
    // Assignment is right associative, so $a = $b = 1 assigns 1 to both.
    fn expr() {
        $node = #ternary();

        $token = #current_token;
        if (!in_array($token.type, #ASSIGNMENTS)) {
            return $node;
        }
        if (is_a($node, ArrayLiteralAST) && !$node.map) {
            if ($token.type != "ASSIGN") {
                #fail("Cannot use {$token.value} to take a list apart: only = can");
            }
            $pattern = #list_pattern($node, $target -> #assignable($target, $token));
            #eat("ASSIGN");

            return #at(AssignAST($pattern, $token, #expr()), $token);
        }

        $node = #assignable($node, $token);
        // Appending ($a[] = ...) is a plain assignment: there is no current element to combine with
        if ($token.type != "ASSIGN" && is_a($node, IndexAST) && $node.index == null) {
            #fail("Cannot use {$token.value} to append");
        }
        #eat($token.type);
        $right = #expr();
        // $f = <lambda>: inside the lambda, $f is the lambda itself, so it can call itself
        if ($token.type == "ASSIGN" && is_a($node, VariableAST) && !$node.is_global()
            && is_a($right, LambdaAST) && in_array($node.value, $right.captures)) {
            $right.self = $node.value;
        }

        return #at(AssignAST($node, $token, $right), $token);
    }

    // Turn a list literal written where a pattern goes ([$a, $b] = ..., foreach (... as [$a, $b])) into a pattern
    //
    // $target checks each element can be a target, failing if not
    fn list_pattern($literal, $target) {
        if ($literal.entries == []) {
            #fail_at("Nothing to take apart: write at least one target in [...]", #file, $literal.line);
        }
        foreach ($literal.entries as $entry) {
            if (is_a($entry[1], SpreadAST)) {
                #fail_at("A pattern can't take the rest with ...: take the list apart with slice()", $entry[1].file, $entry[1].line);
            }
        }
        $targets = [];
        foreach ($literal.entries as $entry) {
            $targets[] = $target($entry[1]);
        }
        $pattern = ListPatternAST($targets);
        [$pattern.line, $pattern.file] = [$literal.line, $literal.file];

        return $pattern;
    }

    // Check a node can be assigned to: a variable, or a path of elements and fields starting at a variable or #
    //
    // $a, $a[0], $rows[0].total, #count, #items[] and $user.tags[0] can be, and so can a path
    // from a call through a field ($team.keeper().saves); # itself, a path starting anywhere
    // else, and a call's elements (make()[0]) can't. $operator is the assignment or ++/-- token.
    fn assignable($node, $operator) {
        $root = path_root($node);
        if (is_a($root, FunctionRefAST)) {
            #static_writes[] = [$root, $operator];
        }
        if (is_a($node, VariableAST) || is_a($node, FunctionRefAST) && contains($node.name, "::")
            || ((is_a($node, IndexAST) || is_a($node, PropertyAST)) && $root != null)
            || writes_through_call($node)) {
            if (is_a($node, PropertyAST) && $node.use != null) {
                #member_uses[$node.use][3] = true;
            }
            #written($node);

            return $node;
        }

        #fail("Can only use {$operator.value} on a variable, or an element or field of one");
    }

    // Note that a path is written to, on the #name it starts at, if it starts at one: #TABLE[0] = 1 writes under #TABLE
    //
    // A constant can't be written under, which is checked once the kinds are resolved. A
    // field can, and so can a method as far as the parser knows: what it holds when it runs
    // decides that.
    fn written($target) {
        while ((is_a($target, IndexAST) || is_a($target, PropertyAST)) && !is_a($target.target, ThisAST)) {
            $target = $target.target;
        }
        if (is_a($target, PropertyAST) && $target.use != null) {
            #member_uses[$target.use][4] = true;
        }
    }

    // Parse an if statement (IF LPAREN expr RPAREN block [ELSE IF ...]* [ELSE block])
    fn if_statement() {
        $start = #current_token;
        #eat("IF");
        #eat("LEFT_PAREN");
        $condition = #expr();
        #eat("RIGHT_PAREN");
        $if_body = #block();

        $else_if = null;
        $else_body = null;
        if (#current_token.type == "ELSE") {
            #eat("ELSE");
            if (#current_token.type == "IF") {
                // An else if is a nested if statement
                $else_if = #if_statement();
            } else {
                $else_body = #block();
            }
        }

        return #at(IfStatementAST($condition, $if_body, $else_if, $else_body), $start);
    }

    // Parse a match (MATCH [LPAREN expr RPAREN] LBRACE arm (COMMA arm)* [COMMA] RBRACE)
    //
    // An arm is one or more comma separated expressions, or DEFAULT, then => then its body.
    // A comma separates arms; it is optional after the last one and after a block arm, which
    // ends in a } of its own, as in Rust.
    //
    // The subject is optional: with one, an arm's values are compared to it with ==; without,
    // they are conditions, tested for truth as if does, so several to an arm read as "or".
    //
    // Only a match written as a statement may have block arms, so in one a { after => is a
    // block and a map is written ({...}), the same rule as a lambda body; in an expression a
    // { after => is a map literal. The default arm must be last, since anything after it is
    // dead, the way an untyped catch must be last.
    fn match_expression($statement) {
        $start = #current_token;
        #eat("MATCH");
        $subject = null;
        if (#current_token.type == "LEFT_PAREN") {
            #eat("LEFT_PAREN");
            $subject = #expr();
            #eat("RIGHT_PAREN");
        }
        #eat("LEFT_BRACE");

        $arms = [];
        $default = false;
        while (#current_token.type != "RIGHT_BRACE") {
            if ($default) {
                #fail("default must be the last arm of a match");
            }

            $values = null;
            if (#current_token.type == "DEFAULT") {
                #eat("DEFAULT");
                $default = true;
            } else {
                $values = [#expr()];
                while (#current_token.type == "COMMA") {
                    #eat("COMMA");
                    $values[] = #expr();
                }
            }
            #eat("DOUBLE_ARROW");

            $block = $statement && #current_token.type == "LEFT_BRACE";
            $arms[] = [$values, $block ? #block() : #expr(), $block];

            if (#current_token.type == "COMMA") {
                #eat("COMMA");
            } else if (!$block && #current_token.type != "RIGHT_BRACE") {
                // Not the last arm and not brace terminated, so a comma is missing
                #eat("COMMA");
            }
        }
        #eat("RIGHT_BRACE");

        if ($arms == []) {
            #fail_at("A match needs at least one arm", #file, $start.line);
        }

        return #at(MatchAST($subject, $arms), $start);
    }

    // Parse a block (LBRACE statement* RBRACE)
    fn block() {
        #eat("LEFT_BRACE");

        $block = CompoundAST();
        while (#current_token.type != "RIGHT_BRACE") {
            $block.statements[] = #statement();
        }
        #eat("RIGHT_BRACE");

        return $block;
    }

    // Parse a while statement (WHILE LPAREN expr RPAREN block)
    fn while_statement() {
        $start = #current_token;
        #eat("WHILE");
        #eat("LEFT_PAREN");
        $condition = #expr();
        #eat("RIGHT_PAREN");

        return #at(WhileStatementAST($condition, #loop_body()), $start);
    }

    // Parse a for statement (FOR LPAREN expr SEMICOLON expr SEMICOLON expr RPAREN block)
    //
    // Desugared into { init; while (condition) { body } } with step set on the
    // while node, so the backends only need to know about while loops.
    fn for_statement() {
        $start = #current_token;
        #eat("FOR");
        #eat("LEFT_PAREN");
        $init = #expr();
        #eat("SEMICOLON");
        $condition = #expr();
        #eat("SEMICOLON");
        $step = #expr();
        #eat("RIGHT_PAREN");

        $loop = #at(CompoundAST(), $start);
        $loop.statements = [
            #at(StatementAST($init), $start),
            #at(WhileStatementAST($condition, #loop_body(), #at(StatementAST($step), $start)), $start),
        ];

        return $loop;
    }

    // Parse a foreach statement (FOREACH LPAREN expr AS variable [DOUBLE_ARROW variable] RPAREN block)
    fn foreach_statement() {
        $start = #current_token;
        #eat("FOREACH");
        #eat("LEFT_PAREN");
        $iterable = #expr();
        #eat("AS");

        $key = null;
        $value = #foreach_target();
        if (#current_token.type == "DOUBLE_ARROW") {
            if (!is_a($value, VariableAST)) {
                #fail("A foreach key is a variable, not a pattern");
            }
            #eat("DOUBLE_ARROW");
            $key = $value;
            $value = #foreach_target();
        }
        #eat("RIGHT_PAREN");

        return #at(ForeachStatementAST($iterable, $key, $value, #loop_body()), $start);
    }

    // Parse what foreach assigns each value to (variable | LBRACKET variable (COMMA variable)* [COMMA] RBRACKET)
    //
    // A pattern's targets are variables only, like foreach's own.
    fn foreach_target() {
        if (#current_token.type != "LEFT_BRACKET") {
            if (#current_token.type == "VAR_IDENTIFIER" && has_key(#shared, #current_token.value)) {
                #fail("{#current_token.value} is shared, so it can't be a foreach variable: assign it in the loop's body");
            }

            return #variable();
        }

        return #list_pattern(#list_literal(), $target -> {
            if (#shared_name($target) != null) {
                #fail_at(#shared_name($target) .. " is shared, so it can't be a foreach variable: assign it in the loop's body", $target.file, $target.line);
            }
            if (!is_a($target, VariableAST)) {
                #fail_at("A foreach pattern takes variables only", $target.file, $target.line);
            }

            return $target;
        });
    }

    // Parse a try statement (TRY block (CATCH LPAREN [IDENTIFIER] variable RPAREN block)* [FINALLY block]), with a catch or a finally or both
    //
    // A catch naming a kind catches objects of that kind or its children; one without a
    // kind catches anything, so it must be the last. That the names are kinds is checked
    // once the whole program is read.
    //
    // return, break and continue can't leave a finally block, so it never replaces a return
    // or swallows an error; a loop or lambda inside it can use them for itself.
    fn try_statement() {
        $start = #current_token;
        #eat("TRY");
        $body = #block();

        $catches = [];
        // Which of them name a kind, so the name can be resolved once the program is read
        $named = [];
        while (#current_token.type == "CATCH") {
            if ($catches != [] && last($catches)[0] == null) {
                #fail("A catch without a kind catches every error, so it must be the last");
            }
            #catches = true;
            #eat("CATCH");
            #eat("LEFT_PAREN");
            $kind = null;
            $kind_token = #current_token;
            if (#current_token.type == "IDENTIFIER") {
                $kind = #current_token.value;
                #eat("IDENTIFIER");
                $kind = #qualified_name($kind);
            }
            if (#current_token.type == "VAR_IDENTIFIER" && has_key(#shared, #current_token.value)) {
                #fail("{#current_token.value} is shared, so it can't be a catch variable: assign it in the block");
            }
            $variable = #variable();
            #eat("RIGHT_PAREN");
            $catches[] = [$kind, $variable, #block()];
            if ($kind != null) {
                $named[] = [len($catches) - 1, $kind_token.line];
            }
        }

        $finally = null;
        if ($catches == [] && #current_token.type != "FINALLY") {
            #fail("Expected 'catch' or 'finally' but found " .. #describe(#current_token));
        }
        if (#current_token.type == "FINALLY") {
            #eat("FINALLY");
            [$in_finally, $loop_depth] = [#in_finally, #loop_depth];
            [#in_finally, #loop_depth] = [true, 0];
            $finally = #block();
            [#in_finally, #loop_depth] = [$in_finally, $loop_depth];
        }

        $node = #at(TryStatementAST($body, $catches, $finally), $start);
        foreach ($named as [$index, $line]) {
            #catch_types[] = [$node, $index, $line, #file, #scope];
        }

        return $node;
    }

    // Parse a loop body, a block in which break and continue are allowed
    fn loop_body() {
        #loop_depth++;
        $body = #block();
        #loop_depth--;

        return $body;
    }

    // Parse a break or continue statement ((BREAK | CONTINUE) SEMICOLON)
    fn loop_control() {
        $token = #current_token;
        if (#loop_depth == 0) {
            #fail(#in_finally ? "Cannot use {$token.value} in finally" : "Cannot use {$token.value} outside of a loop");
        }

        #eat($token.type);
        #eat("SEMICOLON");

        return #at(LoopControlAST($token), $token);
    }

    // Parse a return statement (RETURN [expr] SEMICOLON)
    fn return_statement() {
        if (#in_finally) {
            #fail("Cannot use return in finally");
        }
        if (!#in_function) {
            #fail("Cannot use return outside of a function");
        }

        $start = #current_token;
        #eat("RETURN");
        if (#in_constructor && #current_token.type != "SEMICOLON") {
            #fail("A constructor can't return a value: constructing gives the object");
        }
        $expr = #current_token.type == "SEMICOLON" ? null : #expr();
        #eat("SEMICOLON");

        return #at(ReturnStatementAST($expr), $start);
    }

    // Parse a delete statement (DELETE postfix SEMICOLON), which removes an element of a list or map
    //
    // The target is written like an assignment's, a variable or # followed by steps, and
    // must end in an index: a list's element, which the later ones move down to fill, or a
    // map's key. Fields are declared, so a field is a parse error, and so is an append.
    fn delete_statement() {
        $start = #current_token;
        #eat("DELETE");
        $target = #postfix();
        #eat("SEMICOLON");

        if (is_a($target, PropertyAST)) {
            #fail("Cannot delete a field: every object of a kind has the fields it declares");
        }
        if (!is_a($target, IndexAST) || $target.index == null
            || path_root($target) == null && !writes_through_call($target)) {
            #fail("delete needs an element of a list or map, like delete \$a[0]");
        }

        #written($target);

        return #at(DeleteStatementAST($target), $start);
    }

    // Parse a function declaration (FN IDENTIFIER LPAREN [param (COMMA param)*] RPAREN block),
    // param: VAR_IDENTIFIER [ASSIGN expr]
    //
    // Only allowed at the top level, which is also why break and continue can
    // never reach a caller's loop: a declaration is never inside a loop.
    fn function_declaration($pub) {
        $start = #current_token;
        #eat("FN");
        #check_new_name();
        $name = #qualify(#current_token.value);
        #eat("IDENTIFIER");

        [$params, $defaults, $promoted, $patterns] = #parameters("function {$name}");
        // Declared before the body is parsed, so the function can call itself
        $arity = #arity($params, $defaults);
        #functions[$name] = $arity;
        #declare($name, $pub);

        #in_function = true;
        $scope = #enter_scope($params, false);
        $body = #block();
        #leave_scope($scope);
        #in_function = false;
        $body.statements = [...$patterns, ...$body.statements];

        return #at(FunctionDeclarationAST($name, $params, $defaults, $body, $arity), $start);
    }

    // Check the name being declared isn't taken: functions, kinds and builtins share one namespace
    //
    // Asked before the name is eaten, so the error is at the name. Anything that isn't a
    // name is left for eat() to refuse.
    fn check_new_name() {
        if (#current_token.type != "IDENTIFIER") {
            return;
        }
        $name = #qualify(#current_token.value);
        if (has_key(#builtins, $name)) {
            #fail("{$name} is a builtin function");
        } else if (has_key(#kinds, $name) && #kinds[$name].file == #BUILTIN_FILE) {
            #fail("{$name} is a builtin kind");
        } else if (has_key(#functions, $name)) {
            #fail("Function {$name} is already declared");
        } else if (has_key(#kinds, $name)) {
            #fail("Kind {$name} is already declared");
        } else if (has_key(#constants, $name)) {
            #fail("Constant {$name} is already declared");
        }
    }

    // Parse a function or method's parameter list (LPAREN [param (COMMA param)*] RPAREN),
    // param: VAR_IDENTIFIER [ASSIGN expr] | [PUB | KIN] HASH_IDENTIFIER [ASSIGN expr]
    //
    // $owner is what the parameters belong to, for errors: "function f", "method Point.move".
    // The HASH_IDENTIFIER form (constructor property promotion) is only recognised when $kind
    // is given, which method_declaration() does only for _: it declares the field on $kind (as
    // field_declaration() would) and returns it in $promoted for the caller to assign from,
    // since the assignment needs the constructor's body, not just its parameters.
    // Gives the names (with sigil, "$x"), each one's default or null, and $promoted.
    fn parameters($owner, $kind = null) {
        #eat("LEFT_PAREN");
        $params = [];
        $defaults = [];
        $promoted = [];
        // The statement taking each pattern parameter apart, for the start of the body
        $patterns = [];
        $has_default = false;
        while (#current_token.type != "RIGHT_PAREN") {
            if ($params != []) {
                #eat("COMMA");
            }
            $vis = "";
            if ($kind != null && (#current_token.type == "PUB" || #current_token.type == "KIN")) {
                $vis = #current_token.type == "PUB" ? "pub" : "kin";
                #eat(#current_token.type);
            }
            if ($kind != null && #current_token.type == "HASH_IDENTIFIER") {
                $token = #current_token;
                $name = slice($token.value, 1);
                if ($name == "_") {
                    #fail("A field can't be named _: that's the constructor");
                }
                #check_new_member($kind, $name, true);
                #eat("HASH_IDENTIFIER");
                $param = "$" .. $name;
                if (in_array($param, $params)) {
                    #fail("Duplicate parameter {$param} in {$owner}");
                }

                $default = null;
                if (#current_token.type == "ASSIGN") {
                    #eat("ASSIGN");
                    $default = #expr();
                    $has_default = true;
                } else if ($has_default) {
                    #fail("Required parameter {$param} can't follow a parameter with a default");
                }
                // No default of its own: its value always comes from the parameter, assigned
                // in the constructor's body, whether given or defaulted there
                #declare_field($kind, $name, null, $vis, $token.line);
                #promoted["{$kind.name}::{$name}"] = true;
                $promoted[] = [$name, $token];
                $params[] = $param;
                $defaults[] = $default;
                continue;
            }
            if ($vis != "") {
                #fail("pub and kin mark a promoted field parameter (#name): plain parameters need neither");
            }

            $param = #current_token.value;
            if (#current_token.type == "LEFT_BRACKET") {
                $pattern_token = #current_token;
                [$param, $statement] = #pattern_parameter(#list_pattern(#list_literal(), #parameter_target), len($params));
                $patterns[] = $statement;
                #check_bound([...$params, $param], $patterns, $owner, $pattern_token.line);
            } else {
            // Only a $variable can be a duplicate: '$a' is a string, which eat() refuses
            if (#current_token.type == "VAR_IDENTIFIER") {
                #check_bound([...$params, $param], $patterns, $owner, #current_token.line);
            }
            #eat("VAR_IDENTIFIER");
            }

            $default = null;
            if (#current_token.type == "ASSIGN") {
                #eat("ASSIGN");
                $default = #expr();
                $has_default = true;
            } else if ($has_default) {
                #fail("Required parameter {$param} can't follow a parameter with a default");
            }
            $params[] = $param;
            $defaults[] = $default;
        }
        #eat("RIGHT_PAREN");

        return [$params, $defaults, $promoted, $patterns];
    }

    // A list pattern as parameter $index: a hidden parameter in its place, and the statement
    // taking it apart that starts the body, as if written there. Gives [hidden name, statement].
    // The pattern's variables are then assigned in the body, so a lambda never captures them.
    fn pattern_parameter($pattern, $index) {
        $name = "\$#pattern_{$index}";
        $token = Token("VAR_IDENTIFIER", $name);
        $token.line = $pattern.line;
        $assign_token = Token("ASSIGN", "=");
        $assign_token.line = $pattern.line;
        $assign = #at(AssignAST($pattern, $assign_token, #at(VariableAST($token), $token)), $token);

        return [$name, #at(StatementAST($assign), $token)];
    }

    // A target in a parameter's pattern, which is a $variable, as a parameter is
    fn parameter_target($target) {
        if (!is_a($target, VariableAST) || $target.is_global()) {
            #fail_at("A parameter pattern takes \$variables only", $target.file, $target.line);
        }

        return $target;
    }

    // The names a list of parameters binds, failing at the first one bound twice: a pattern's
    // variables count, its hidden parameter doesn't
    fn check_bound($params, $patterns, $owner, $line) {
        $bound = filter($params, $param -> !starts_with($param, "\$#"));
        foreach ($patterns as $statement) {
            $bound = [...$bound, ...map($statement.expr.left.targets, $target -> $target.value)];
        }
        $seen = {};
        foreach ($bound as $name) {
            if (has_key($seen, $name)) {
                #fail_at("Duplicate parameter {$name} in {$owner}", #file, $line);
            }
            $seen[$name] = true;
        }
    }

    // A synthetic #name = $name; for a promoted constructor parameter, exactly as if it had
    // been written in the body: registered as a member use so the whole-program pass sees it,
    // and as a write so #check_member_use knows the field is assigned
    fn promoted_assignment($kind, $name, $token) {
        $property = #at(PropertyAST(#at(ThisAST(), $token), $name), $token);
        $property.use = len(#member_uses);
        #member_uses[] = [$property, $kind, null, false, false, false];

        $assign_token = Token("ASSIGN", "=");
        $assign_token.line = $token.line;
        #assignable($property, $assign_token);

        $var_token = Token("VAR_IDENTIFIER", "$" .. $name);
        $var_token.line = $token.line;
        $variable = #at(VariableAST($var_token), $token);

        return #at(StatementAST(#at(AssignAST($property, $assign_token, $variable), $token)), $token);
    }

    // Parse a kind declaration ([ABSTRACT] KIND IDENTIFIER [EXTENDS name] LBRACE (field | method)* RBRACE),
    // field: HASH_IDENTIFIER [ASSIGN expr] SEMICOLON, method: [ABSTRACT] FN name parameters (block | SEMICOLON)
    //
    // Only at the top level. The parent can be declared later; it is checked once the whole
    // program is read. A field's default is evaluated for each new object, with #
    // being that object and no local variables. Methods may be named with any word,
    // keywords included, since they are always reached through # or a dot.
    fn kind_declaration($pub = false) {
        $start = #current_token;
        $abstract = $start.type == "ABSTRACT";
        if ($abstract) {
            #eat("ABSTRACT");
        }
        if (#current_token.type == "CLASS") {
            #fail("Declare kinds with kind, not class");
        }
        #eat("KIND");
        #check_new_name();
        $name = #qualify(#current_token.value);
        #eat("IDENTIFIER");
        $parent = null;
        if (#current_token.type == "EXTENDS") {
            #eat("EXTENDS");
            $parent = #current_token.value;
            #eat("IDENTIFIER");
            $parent = #qualified_name($parent);
        }

        $kind = #at(KindDeclarationAST($name, $parent, $abstract), $start);
        #kinds[$name] = $kind;
        #declare($name, $pub);
        if ($parent != null) {
            #parent_names[] = [$kind, #scope];
        }
        #eat("LEFT_BRACE");
        #kind = $kind;
        while (#current_token.type != "RIGHT_BRACE") {
            // The ladder: unmarked is the kind's own, kin reaches what extends it, pub anyone.
            // pub says the member escapes the kind, as it says a name escapes a namespace.
            $vis = "";
            if (#current_token.type == "PUB" || #current_token.type == "KIN") {
                $vis = #current_token.type == "PUB" ? "pub" : "kin";
                #eat(#current_token.type);
            }
            if (#current_token.type == "HASH_IDENTIFIER") {
                #field_declaration($kind, $vis);
            } else if (#current_token.type == "CONST") {
                #constant_declaration($kind, false, $vis);
            } else if (#current_token.type == "FN" || #current_token.type == "ABSTRACT") {
                #method_declaration($kind, $vis);
            } else if (#current_token.type == "STATIC") {
                #static_declaration($kind, $vis);
            } else {
                #fail("Expected a field (#name), a method (fn), a constant (const) or a static but found " .. #describe(#current_token));
            }
        }
        #kind = null;
        #eat("RIGHT_BRACE");

        return $kind;
    }

    // Parse a field declaration (HASH_IDENTIFIER [ASSIGN expr] SEMICOLON) into its kind
    fn field_declaration($kind, $vis = "") {
        $token = #current_token;
        $name = slice($token.value, 1);
        #check_new_member($kind, $name);
        #eat("HASH_IDENTIFIER");

        $default = null;
        if (#current_token.type == "ASSIGN") {
            #eat("ASSIGN");
            $default = #expr();
            $variables = VariableCollector();
            $variables.collect($default);
            if ($variables.found != {}) {
                $used = keys($variables.found)[0];
                #fail_at("The default of #{$name} can't use {$used}: fields have no local variables", #file, $token.line);
            }
        }
        #eat("SEMICOLON");

        #declare_field($kind, $name, $default, $vis, $token.line);
    }

    // Register a field of $kind: the one place that writes fields/field_lines/vis, so a field
    // declared with #x; or #x = default; and one promoted from a constructor parameter stay
    // in sync as the same field to everything downstream (layout, visibility, codegen)
    fn declare_field($kind, $name, $default, $vis, $line) {
        $kind.fields[$name] = $default;
        $kind.field_lines[$name] = $line;
        $kind.vis[$name] = $vis;
    }

    // Parse a constant declaration (CONST IDENTIFIER ASSIGN expr SEMICOLON), at the top level or in a kind ($kind)
    //
    // The value is any expression the parser can work out itself: literals, operators, lists
    // and maps, and other constants, which may be declared later. It is worked out once the
    // whole program is read (see fold()), and a use of the constant is then that value, so
    // neither backend knows constants exist. A top level constant shares the namespace of
    // functions and kinds; a kind's shares the one its fields and methods are in.
    fn constant_declaration($kind, $pub = false, $vis = "") {
        #eat("CONST");
        $token = #current_token;
        $name = $token.value;
        if ($kind == null) {
            #check_new_name();
        } else if ($token.type == "IDENTIFIER" && (has_key($kind.constants, $name) || has_key($kind.fields, $name) || has_key($kind.methods, $name))) {
            $member = match {
                has_key($kind.constants, $name) => "constant {$name}",
                has_key($kind.methods, $name) => "method {$name}",
                default => "field #{$name}",
            };
            #fail("{$kind.name} already has a {$member}: constants, fields and methods share names");
        }
        #eat("IDENTIFIER");
        #eat("ASSIGN");
        #in_constant = true;
        $expr = #expr();
        #in_constant = false;
        #eat("SEMICOLON");

        if ($kind == null) {
            $name = #qualify($name);
            #constants[$name] = [$expr, null, $name];
            #declare($name, $pub);
        } else {
            $kind.constants[$name] = $expr;
            $kind.constant_lines[$name] = $token.line;
            $kind.vis[$name] = $vis;
            #constants["{$kind.name}::{$name}"] = [$expr, $kind, "{$kind.name}::{$name}"];
        }
    }

    // A name declared in the file being parsed, with its namespace on it
    fn qualify($name) {
        return #namespace == "" ? $name : "{#namespace}::{$name}";
    }

    // Record a top level declaration's namespace and whether it escapes it
    fn declare($name, $pub) {
        #declared_in[$name] = #namespace;
        if ($pub) {
            #public[$name] = true;
        }
    }

    // Whether a top level name is declared, as a function, a kind or a constant
    fn declared($name) {
        return has_key(#functions, $name) || has_key(#kinds, $name) || has_key(#constants, $name);
    }

    // Start a file's own namespace and aliases, giving what leave_file() puts back
    fn enter_file() {
        $saved = [#namespace, #aliases, #reachable, #scope, #file_started];
        [#namespace, #aliases, #reachable, #file_started] = ["", {}, {}, false];
        #scope = len(#scopes);
        #scopes[] = ["", {}, {}];

        return $saved;
    }

    // Keep what the file ended with, for the names in it to be resolved against later
    fn leave_file($saved) {
        #scopes[#scope] = [#namespace, #aliases, #reachable];
        [#namespace, #aliases, #reachable, #scope, #file_started] = $saved;
    }

    // The declared name a name written in $scope means: the current namespace first, then
    // the file's aliases, then the global namespace, which is where the builtins are
    //
    // Only the first part is resolved, since a namespace holds no namespace: Token::EOF in
    // namespace gazlang is gazlang::Token::EOF, and json::decode is already what it means.
    fn resolve($name, $scope, $file, $line) {
        [$namespace, $aliases, $reachable] = #scopes[$scope];
        [$head, $rest] = #split_head($name);

        if ($namespace != "" && #declared("{$namespace}::{$head}")) {
            return "{$namespace}::{$head}{$rest}";
        }
        if (has_key($aliases, $head)) {
            return $aliases[$head] .. $rest;
        }
        if ($rest != "" && has_key(#namespaces, $head) && !has_key($reachable, $head)) {
            #fail_at("Namespace {$head} is not included here: a file can only name what it includes itself", $file, $line);
        }

        return $name;
    }

    // A name's first part and everything after it, the rest keeping its leading ::
    fn split_head($name) {
        $parts = split($name, "::");
        $head = $parts[0];
        delete $parts[0];

        return [$head, len($parts) == 0 ? "" : "::" .. join($parts, "::")];
    }

    // The declared top level name a resolved name is part of, or null: json::Reader::EOF is
    // the kind json::Reader, and its visibility is the one that governs
    fn declared_entity($name) {
        while (true) {
            if (#declared($name)) {
                return $name;
            }
            if (!contains($name, "::")) {
                return null;
            }
            [$name, $last] = #split_name($name);
        }
    }

    // A name is private to its namespace unless pub, which is why a file is implementation
    // and only what it says is public escapes it
    fn check_visible($name, $scope, $file, $line) {
        $entity = #declared_entity($name);
        if ($entity == null) {
            return;
        }
        $in = #declared_in[$entity] ?? "";
        if ($in != "" && $in != #scopes[$scope][0] && !has_key(#public, $entity)) {
            #fail_at("{$entity} is not pub, so only namespace {$in} can use it", $file, $line);
        }
    }

    // Resolve every name a file wrote, before anything is checked, so the rest of the parser
    // only ever sees the name a declaration made
    fn resolve_names() {
        foreach (#alias_uses as [$name, $file, $line, $scope]) {
            if (!#declared($name) && #constant_key($name) == null) {
                #fail_at("Undefined function or constant: {$name}", $file, $line);
            }
            #check_visible($name, $scope, $file, $line);
        }
        foreach (#uses as [$node, $scope]) {
            $node.name = #resolve($node.name, $scope, $node.file, $node.line);
            #check_visible($node.name, $scope, $node.file, $node.line);
        }
        foreach (#parent_names as [$kind, $scope]) {
            $kind.parent = #resolve($kind.parent, $scope, $kind.file, $kind.line);
            #check_visible($kind.parent, $scope, $kind.file, $kind.line);
        }
        foreach (#catch_types as [$node, $index, $line, $file, $scope]) {
            $name = #resolve($node.catches[$index][0], $scope, $file, $line);
            $node.catches[$index][0] = $name;
            #check_visible($name, $scope, $file, $line);
        }
    }

    // What is wrong with a name written where a kind's goes
    fn not_a_kind($name) {
        return match {
            has_key(#functions, $name) => "{$name} is a function, not a kind",
            has_key(#constants, $name) => "{$name} is a constant, not a kind",
            default => "Undefined kind: {$name}",
        };
    }

    // Work out a constant's value, the first time it is asked for. $at is the node asking,
    // for the error if the constant depends on itself.
    fn constant_value($key, $at) {
        if (!has_key(#constant_values, $key)) {
            [$expr, $kind, $name] = #constants[$key];
            if (in_array($name, #folding)) {
                // From its first appearance among those being worked out, round to it again
                $from = 0;
                while (#folding[$from] != $name) {
                    $from++;
                }
                $cycle = slice(#folding, $from);
                $cycle[] = $name;
                #fail_at("Constant {$name} depends on itself: " .. join($cycle, " uses "), $at.file, $at.line);
            }
            #folding[] = $name;
            #check_constant_expression($expr, $kind);
            #constant_values[$key] = #fold($expr, $kind);
            delete #folding[len(#folding) - 1];
        }

        return #constant_values[$key];
    }

    // Record a static of a resolved kind, refusing a name the hierarchy already uses: every
    // member shares one namespace, and a child can't declare a parent's static again
    fn check_new_static($kind, $name, $line, $is_method) {
        $what = $is_method ? "Static method {$kind.name}::{$name}" : "Static field {$kind.name}::#{$name}";
        if (has_key($kind.static_owners, $name)) {
            #fail_at("{$what} is already declared in {$kind.static_owners[$name]}", $kind.file, $line);
        }
        $owner = $kind.constant_owners[$name] ?? $kind.layout[$name] ?? $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
        if ($owner != null) {
            $member = match {
                has_key($kind.constant_owners, $name) => "constant",
                has_key($kind.layout, $name) => "field",
                default => "method",
            };
            #fail_at("{$what} has the name of a {$member} of {$owner}: constants, fields, methods and statics share names", $kind.file, $line);
        }
        $kind.static_owners[$name] = $kind.name;
        $kind.owner_vis[$name] = $kind.vis[$name];
        $kind.static_is_method[$name] = $is_method;
    }

    // Refuse a member whose name a static of the hierarchy already uses
    fn check_not_static($kind, $name, $what, $line) {
        if (has_key($kind.static_owners, $name)) {
            $member = $kind.static_is_method[$name] ? "static method" : "static field";
            #fail_at("{$what} has the name of a {$member} of {$kind.static_owners[$name]}: constants, fields, methods and statics share names", $kind.file, $line);
        }
    }

    // The key in #statics of a resolved kind's static, its parent's included, or null if it
    // has none of that name
    // Why a kind can't name a member its parent has, or null when it has none of that name
    fn not_pub($kind, $name) {
        if (!has_key($kind.hidden, $name)) {
            return null;
        }
        $owner = $kind.hidden[$name];

        return "{$owner}::{$name} is not pub, so only {$owner} can use it";
    }

    fn kind_static($kind, $name) {
        return has_key($kind.static_owners, $name) ? "{$kind.static_owners[$name]}::{$name}" : null;
    }

    // The key in #constants of a resolved kind's constant, its parent's included, or null if it has none of that name
    fn kind_constant($kind, $name) {
        return has_key($kind.constant_owners, $name) ? "{$kind.constant_owners[$name]}::{$name}" : null;
    }

    // Check all of a constant's expression is something fold() can work out, the parts it won't get to included
    //
    // fold() leaves out the side of && || ?? and ?: that isn't needed, as a program does, so on
    // its own it would accept `true ? 1 : $x` and refuse it the day the condition changed.
    // What a constant may be made of is a rule about the source, so it is checked on the source.
    fn check_constant_expression($node, $kind) {
        if (is_a($node, FunctionRefAST)) {
            if (#constant_key($node.name) == null) {
                #fail_at(match {
                    has_key(#kinds, $node.name) => "{$node.name} is a kind, not a constant",
                    has_key(#functions, $node.name) => "{$node.name} is a function, not a constant",
                    default => #qualified_error($node.name) ?? "Undefined constant: {$node.name}",
                }, $node.file, $node.line);
            }

            return;
        }
        if (is_a($node, PropertyAST)) {
            // A constant folds before the whole-program checks run, so the dot on a name that
            // turns out to be a kind is caught here too, with the same words
            if (is_a($node.target, FunctionRefAST)) {
                #check_dot_on_name($node);
            }
            $owner = is_a($node.target, ThisAST) ? $kind : null;
            if ($owner != null && #kind_constant($owner, $node.name) != null) {
                return;
            }
            // A parent's private constant is the parent's own, which is worth saying outright
            if ($owner != null) {
                $hidden = #not_pub($owner, $node.name);
                if ($hidden != null) {
                    #fail_at($hidden, $node.file, $node.line);
                }
            }
            #fail_at("A constant's value can only use literals, operators and other constants", $node.file, $node.line);
        }
        $parts = match {
            is_a($node, NumAST) || is_a($node, StringAST) || is_a($node, BooleanAST) || is_a($node, NullAST) => [],
            is_a($node, UnaryOpAST) => [$node.expr],
            is_a($node, BinOpAST) => [$node.left, $node.right],
            is_a($node, TernaryAST) => [$node.condition, $node.then, $node.else],
            is_a($node, ArrayLiteralAST) => $node.entries,
            is_a($node, SpreadAST) => [$node.expr],
            default => #fail_at("A constant's value can only use literals, operators and other constants", $node.file, $node.line),
        };
        foreach ($parts as $part) {
            // A list or map literal's entries are [key, value], the key null in a list
            foreach (type_of($part) == "list" ? $part : [$part] as $expression) {
                if ($expression != null) {
                    #check_constant_expression($expression, $kind);
                }
            }
        }
    }

    // Work out the value of a constant's expression, as a program would: $kind is the kind
    // the constant is declared in, which #NAME is a constant of
    //
    // The operators are GazLang's own, run by the VM that runs the parser, which is the one
    // that will run the program, so 1 / 0 and an overflow are the errors they are when a
    // program runs, located at the operator. Only what needs
    // nothing but the source is allowed: no variables, no calls (a function can do anything,
    // and an object it made could be changed through the constant), no indexing.
    fn fold($node, $kind) {
        if (is_a($node, NumAST) || is_a($node, StringAST) || is_a($node, BooleanAST) || is_a($node, NullAST)) {
            return $node.value;
        } else if (is_a($node, UnaryOpAST)) {
            $value = #fold($node.expr, $kind);

            return #located($node, () -> match ($node.op.type) {
                "NOT" => !$value,
                "MINUS" => -$value,
                default => ~$value,
            });
        } else if (is_a($node, BinOpAST)) {
            $left = #fold($node.left, $kind);
            $type = $node.op.type;
            // As when a program runs, the right side of && || and ?? only counts when it is needed
            if ($type == "AND") {
                return $left && #fold($node.right, $kind);
            } else if ($type == "OR") {
                return $left || #fold($node.right, $kind);
            } else if ($type == "COALESCE") {
                return $left ?? #fold($node.right, $kind);
            }
            $right = #fold($node.right, $kind);

            return #located($node, () -> #apply($type, $left, $right));
        } else if (is_a($node, TernaryAST)) {
            return #fold(#fold($node.condition, $kind) ? $node.then : $node.else, $kind);
        } else if (is_a($node, ArrayLiteralAST) && !$node.map) {
            $list = [];
            foreach ($node.entries as $entry) {
                if (is_a($entry[1], SpreadAST)) {
                    // GazLang's own spread, located at the ...
                    $value = #fold($entry[1].expr, $kind);
                    $list = #located($entry[1], () -> [...$list, ...$value]);
                } else {
                    $list[] = #fold($entry[1], $kind);
                }
            }

            return $list;
        } else if (is_a($node, ArrayLiteralAST)) {
            $map = {};
            foreach ($node.entries as [$key_node, $value_node]) {
                if (is_a($value_node, SpreadAST)) {
                    // GazLang's own spread, located at the ...
                    $value = #fold($value_node.expr, $kind);
                    $map = #located($value_node, () -> ({...$map, ...$value}));
                    continue;
                }
                $key = #fold($key_node, $kind);
                // A key that can't be one is an error at the map, before its value is worked out
                #located($node, () -> ({$key => null}));
                // Duplicate keys: the last one wins
                $map[$key] = #fold($value_node, $kind);
            }

            return $map;
        } else if (is_a($node, FunctionRefAST) && #constant_key($node.name) != null) {
            return #constant_value(#constant_key($node.name), $node);
        } else if (is_a($node, PropertyAST) && (is_a($node.target, ThisAST) || is_a($node.target, FunctionRefAST))) {
            $owner = is_a($node.target, ThisAST) ? $kind : #kinds[$node.target.name] ?? null;
            $key = $owner == null ? null : #kind_constant($owner, $node.name);
            if ($key != null) {
                return #constant_value($key, $node);
            }
        }

        #fail_at("A constant's value can only use literals, operators and other constants", $node.file, $node.line);
    }

    // What $compute gives, with an error in it raised again as a ParseError at the node. Only the
    // operator itself is in the try, which is handed the values it works on: a catch of Error
    // around the working out of those would also catch a ParseError in them, and relocate it.
    fn located($node, $compute) {
        try {
            return $compute();
        } catch (Error $e) {
            #fail_at($e.message, $node.file, $node.line);
        }
    }

    // Apply a binary operator by its token type. An operator is not a value in GazLang, so
    // each is written out.
    fn apply($type, $left, $right) {
        return match ($type) {
            "PLUS" => $left + $right,
            "MINUS" => $left - $right,
            "MULTIPLY" => $left * $right,
            "DIVIDE" => $left / $right,
            "MODULO" => $left % $right,
            "CONCAT" => $left .. $right,
            "EQUALS" => $left == $right,
            "NOT_EQUALS" => $left != $right,
            "SPACESHIP" => $left <=> $right,
            "LESS_THAN" => $left < $right,
            "LESS_EQUALS" => $left <= $right,
            "GREATER_THAN" => $left > $right,
            "GREATER_EQUALS" => $left >= $right,
            "BIT_AND" => $left & $right,
            "BIT_OR" => $left | $right,
            "BIT_XOR" => $left ^ $right,
            "SHIFT_LEFT" => $left << $right,
            "SHIFT_RIGHT" => $left >> $right,
        };
    }

    // Check a Name.member where Name is a kind: the kind must have the constant, and a constant can't be called
    //
    // Anything else is left to run: Name may be a constant holding a map, or a function,
    // and what . does to those is an error for when it happens.
    // A kind is reached by name, with ::, never through a dot, which goes through a value
    fn check_dot_on_name($node) {
        $kind = #kinds[$node.target.name] ?? null;
        if ($kind != null) {
            #fail_at("Cannot use . on a kind: write '{$kind.name}::{$node.name}', not '{$kind.name}.{$node.name}'", $node.file, $node.line);
        }
    }

    // A qualified name's parts, as [everything before the last ::, the name after it]
    fn split_name($name) {
        $parts = split($name, "::");
        $last = len($parts) - 1;
        $name = $parts[$last];
        delete $parts[$last];

        return [join($parts, "::"), $name];
    }

    // The key in #constants of the constant a name means, or null if it names none. A top
    // level constant is its own key and a kind's is its owner's, since it is inherited, so
    // Special::EOF is the key Token::EOF when Token is what declared it.
    fn constant_key($name) {
        if (has_key(#constants, $name)) {
            return $name;
        }
        if (!contains($name, "::")) {
            return null;
        }
        [$prefix, $last] = #split_name($name);
        $kind = #kinds[$prefix] ?? null;

        return $kind == null ? null : #kind_constant($kind, $last);
    }

    // The key in #statics of the static field a name means, or null if it names none. As a
    // constant's, a kind's static is its owner's, since a child shares it.
    fn static_key($name) {
        if (!contains($name, "::")) {
            return null;
        }
        [$prefix, $last] = #split_name($name);
        $kind = #kinds[$prefix] ?? null;
        if ($kind == null || ($kind.static_is_method[$last] ?? true)) {
            return null;
        }

        return #kind_static($kind, $last);
    }

    // What is wrong with a qualified name nothing declares, or null when the name has no ::
    // or names a namespace, where being undefined is all there is to say
    fn qualified_error($name) {
        if (!contains($name, "::")) {
            return null;
        }
        [$prefix, $last] = #split_name($name);
        $kind = #kinds[$prefix] ?? null;
        if ($kind != null) {
            return #not_pub($kind, $last) ?? "Kind {$kind.name} has no constant {$last}";
        }

        return has_key(#namespaces, #split_head($name)[0]) ? null : #not_a_kind($prefix);
    }

    // Parse a static declaration (STATIC (HASH_IDENTIFIER ASSIGN expr SEMICOLON | FN method))
    //
    // A static belongs to the kind rather than to an object, so a field is a slot and a
    // method a function whose name carries its kind. A field's default is a constant
    // expression, folded as a kind constant is: running one would bring initialisation
    // order and bytecode before the top level, which is what constants refuse for.
    fn static_declaration($kind, $vis = "") {
        $start = #current_token;
        #eat("STATIC");
        if (#current_token.type == "FN") {
            #static_method($kind, $start, $vis);

            return;
        }
        $token = #current_token;
        if ($token.type != "HASH_IDENTIFIER") {
            #fail("Expected a static field (#name) or a static method (fn) but found " .. #describe($token));
        }
        $name = slice($token.value, 1);
        #check_new_member($kind, $name);
        #eat("HASH_IDENTIFIER");
        if (#current_token.type != "ASSIGN") {
            #fail("A static field needs a value: write 'static #{$name} = ...;'");
        }
        #eat("ASSIGN");
        #in_constant = true;
        $expr = #expr();
        #in_constant = false;
        #eat("SEMICOLON");

        $kind.statics[$name] = $expr;
        $kind.static_lines[$name] = $token.line;
        $kind.vis[$name] = $vis;
    }

    // Parse a static method (FN name parameters block), the static having been eaten
    //
    // It is a function named Kind::name, so calling one is an ordinary call and the VM needs
    // nothing: a static has no object, which is why a dot never reaches it.
    fn static_method($kind, $start, $vis = "") {
        #eat("FN");
        $token = #current_token;
        if ($token.type != "IDENTIFIER" && !in_array($token.type, values(Lexer::KEYWORDS))) {
            #fail("Expected a name but found " .. #describe($token));
        }
        $name = $token.value;
        if ($name == "_") {
            #fail("A constructor can't be static: it makes an object");
        }
        #check_new_member($kind, $name);
        #eat($token.type);

        $full = "{$kind.name}::{$name}";
        [$params, $defaults, $promoted, $patterns] = #parameters("static method {$full}");
        $arity = #arity($params, $defaults);
        #functions[$full] = $arity;
        #declare($full, has_key(#public, $kind.name) || #declared_in[$kind.name] == "");
        [$in_function, $in_static] = [#in_function, #in_static];
        [#in_function, #in_static] = [true, $kind];
        $scope = #enter_scope($params, false);
        $body = #block();
        #leave_scope($scope);
        [#in_function, #in_static] = [$in_function, $in_static];
        $body.statements = [...$patterns, ...$body.statements];

        $node = #at(FunctionDeclarationAST($full, $params, $defaults, $body, $arity), $start);
        $node.kind = $kind.name;
        $kind.static_methods[$name] = $node;
        $kind.vis[$name] = $vis;
        #static_functions[] = $node;
    }

    // Parse a method declaration ([ABSTRACT] FN name parameters (block | SEMICOLON)) into its kind
    //
    // An abstract method has no body, and only an abstract kind can declare one.
    fn method_declaration($kind, $vis = "") {
        $start = #current_token;
        $abstract = $start.type == "ABSTRACT";
        if ($abstract) {
            #eat("ABSTRACT");
        }
        #eat("FN");
        $token = #current_token;
        if ($token.type != "IDENTIFIER" && !in_array($token.type, values(Lexer::KEYWORDS))) {
            #fail("Expected a name but found " .. #describe($token));
        }
        $name = $token.value;
        // A constructor is reached by constructing rather than by naming, so it escapes its
        // kind whatever it says: a child's _ overrides its parent's, and a marker on one
        // would be saying what is already true
        if ($name == "_") {
            if ($vis != "") {
                #fail("A constructor is reached by constructing, so it needs no {$vis}");
            }
            $vis = "pub";
        }
        #check_new_member($kind, $name);
        #eat($token.type);

        [$params, $defaults, $promoted, $patterns] = #parameters("method {$kind.name}.{$name}", $name == "_" ? $kind : null);
        if ($abstract) {
            if (!$kind.abstract) {
                #fail_at("Kind {$kind.name} has abstract method {$name}, so it must be abstract too", #file, $start.line);
            }
            if ($name == "_") {
                #fail_at("A constructor can't be abstract", #file, $start.line);
            }
            if (#current_token.type == "LEFT_BRACE") {
                #fail("An abstract method has no body: end it with ;");
            }
            #eat("SEMICOLON");
            $body = CompoundAST();
        } else if ($name == "_" && #current_token.type == "SEMICOLON") {
            // Nothing left to write once every parameter has promoted its field
            #eat("SEMICOLON");
            $body = CompoundAST();
        } else {
            [#in_function, #in_constructor] = [true, $name == "_"];
            $scope = #enter_scope($params, false);
            $body = #block();
            #leave_scope($scope);
            [#in_function, #in_constructor] = [false, false];
        }
        $prelude = $patterns;
        foreach ($promoted as [$field, $field_token]) {
            $prelude[] = #promoted_assignment($kind, $field, $field_token);
        }
        $body.statements = [...$prelude, ...$body.statements];

        $method = #at(FunctionDeclarationAST($name, $params, $defaults, $body, #arity($params, $defaults)), $start);
        $method.kind = $kind.name;
        $method.abstract = $abstract;
        $kind.methods[$name] = $method;
        $kind.vis[$name] = $vis;
    }

    // Check a kind doesn't already declare a member: fields and methods share one namespace
    //
    // $promoting is whether the name being declared is a constructor's promoted parameter
    fn check_new_member($kind, $name, $promoting = false) {
        $field = #current_token.type == "HASH_IDENTIFIER";
        if (has_key($kind.statics, $name) || has_key($kind.static_methods, $name)) {
            $member = has_key($kind.statics, $name) ? "static field #{$name}" : "static method {$name}";
            #fail("{$kind.name} already has a {$member}: constants, fields, methods and statics share names");
        }
        if (has_key($kind.constants, $name)) {
            #fail("{$kind.name} already has a constant {$name}: constants, fields and methods share names");
        }
        if (has_key($kind.fields, $name)) {
            if ($field && $promoting) {
                if (has_key(#promoted, "{$kind.name}::{$name}")) {
                    #fail("Duplicate parameter \${$name} in method {$kind.name}._");
                }
                #fail("{$kind.name} already has a field #{$name}: a promoted parameter declares its field, so remove the field's own declaration (or write \${$name} as a plain parameter)");
            }
            if ($field && has_key(#promoted, "{$kind.name}::{$name}")) {
                #fail("{$kind.name} already has a field #{$name}, declared by a promoted constructor parameter: remove this declaration");
            }
            #fail($field
                ? "{$kind.name} already has a field #{$name}"
                : "{$kind.name} already has a field #{$name}, and a method can't have a field's name: call the method something else");
        }
        if (has_key($kind.methods, $name)) {
            #fail($field
                ? "{$kind.name} already has a method {$name}, and a field can't have a method's name: call the field something else, like #{$name}_value"
                : "{$kind.name} already has a method {$name}");
        }
    }

    // Parse a statement (expr SEMICOLON | echo_statement | if_statement | while_statement | for_statement | foreach_statement
    //                    | loop_control | return_statement | delete_statement | match)
    fn statement() {
        #statement_token = #current_token;
        $type = #current_token.type;
        if ($type == "ECHO") {
            return #echo_statement();
        } else if ($type == "IF") {
            return #if_statement();
        } else if ($type == "WHILE") {
            return #while_statement();
        } else if ($type == "FOR") {
            return #for_statement();
        } else if ($type == "FOREACH") {
            return #foreach_statement();
        } else if ($type == "TRY") {
            return #try_statement();
        } else if ($type == "BREAK" || $type == "CONTINUE") {
            return #loop_control();
        } else if ($type == "RETURN") {
            return #return_statement();
        } else if ($type == "DELETE") {
            return #delete_statement();
        } else if ($type == "SHARED") {
            return #shared_declaration();
        } else if ($type == "FN") {
            #fail("Functions can only be declared at the top level");
        } else if ($type == "KIND" || $type == "ABSTRACT") {
            #fail("Kinds can only be declared at the top level");
        } else if ($type == "CONST") {
            #fail("Constants can only be declared at the top level or in a kind");
        } else if ($type == "FUNCTION") {
            #fail("Declare functions with fn, not function");
        } else if ($type == "CLASS") {
            #fail("Declare kinds with kind, not class");
        } else if ($type == "INCLUDE") {
            #fail("include can only be used at the top level");
        } else if ($type == "MATCH") {
            // A match written as a statement ends at its }, like if and while, and its arms
            // may be blocks; its value is discarded
            $start = #current_token;

            return #at(StatementAST(#match_expression(true)), $start);
        }

        $start = #current_token;
        $expr = #expr();
        #eat("SEMICOLON");

        return #at(StatementAST($expr), $start);
    }

    // Parse a shared variable's declaration (SHARED VAR_IDENTIFIER ASSIGN expr SEMICOLON)
    //
    // A variable that closures share with the function they are written in, rather than each
    // taking a copy: `shared $count = 0;` and then $count is one variable to all of them. It is
    // a Shared box in a hidden variable, assigned here (a new box each time this runs, which is
    // what gives each iteration of a loop its own), and every use of $count after it that
    // variable() meets is the box's value; a lambda that uses one captures the box, which is a
    // handle, so the copy it takes is the same box. Nothing below the parser learns of it.
    //
    // It is refused where it would be a second variable of the same name: already shared, or
    // already used as a plain one. A parameter or a foreach or catch variable can't be shared.
    fn shared_declaration() {
        $start = #current_token;
        #eat("SHARED");
        $token = #current_token;
        if ($token.type != "VAR_IDENTIFIER") {
            #fail("Expected a \$variable after shared but found " .. #describe($token));
        }
        $name = $token.value;
        if (has_key(#shared, $name)) {
            #fail_at("{$name} is already shared", #file, $token.line);
        }
        if (has_key(#bound, $name)) {
            #fail_at("{$name} is a parameter, so it can't be shared: share another variable", #file, $token.line);
        }
        if (has_key(#plain, $name)) {
            #fail_at("{$name} is used before it is shared: write shared {$name} = ...; where it is first set", #file, $token.line);
        }
        #eat("VAR_IDENTIFIER");
        if (#current_token.type != "ASSIGN") {
            #fail("A shared variable needs a value: write shared {$name} = ...;");
        }
        $assign = #current_token;
        #eat("ASSIGN");
        $value = #expr();
        #eat("SEMICOLON");

        // Declared once its value is read, which can't be the variable itself
        #shared[$name] = true;
        #shares = true;
        $box_token = Token("VAR_IDENTIFIER", "\$#shared_" .. slice($name, 1));
        $box_token.line = $token.line;
        // Constructed as the global scope, 0, sees Shared, whatever namespace this is written in
        $construct = #at(FunctionCallAST("Shared", [$value]), $token);
        #uses[] = [$construct, 0];

        return #at(StatementAST(#at(AssignAST(#at(VariableAST($box_token), $token), $assign, $construct), $assign)), $start);
    }

    // Parse an echo statement (ECHO expr SEMICOLON)
    fn echo_statement() {
        $start = #current_token;
        #eat("ECHO");
        $expr = #expr();
        #eat("SEMICOLON");

        return #at(EchoStatementAST($expr), $start);
    }

    // Parse a program (top_level)
    //
    // Calls by name and bare names are checked once everything is parsed, so a function
    // can be used before it is declared and both backends can trust every call by name.
    // Calls on values ($f(1)) are checked when they run.
    fn program() {
        [$error_kind, $shared_kind] = #builtin_kinds();
        $root = CompoundAST();
        $saved = #enter_file();
        $root.statements = #top_level();
        #leave_file($saved);
        // Every name a file wrote becomes the name a declaration made, before anything below
        // is checked, so only this pass ever learns that namespaces exist
        #resolve_names();
        // Error is only compiled into programs that can catch, name or extend it
        $uses_error = #catches;
        foreach (#uses as [$use, $scope]) {
            $uses_error = $uses_error || $use.name == "Error";
        }
        foreach (#kinds as $kind) {
            $uses_error = $uses_error || $kind.parent == "Error";
        }
        if ($uses_error) {
            $root.statements = [$error_kind, ...$root.statements];
        }
        // Shared is only compiled into programs with a shared variable
        if (#shares) {
            $root.statements = [$shared_kind, ...$root.statements];
        }
        foreach (#catch_types as [$node, $index, $line, $file, $scope]) {
            $name = $node.catches[$index][0];
            if (!has_key(#kinds, $name)) {
                #fail_at(#not_a_kind($name), $file, $line);
            }
        }

        foreach (#kinds as $kind) {
            #resolve_kind($kind, []);
        }

        // In the order declared, so the first mistake in the program is the one reported
        foreach (#constants as $key => $constant) {
            #constant_value($key, $constant[0]);
        }

        // A static field is a slot, and its default a constant, so the two are worked out
        // here and the code generator writes them before the program's own first instruction
        $inits = [];
        foreach (#kinds as $kind) {
            foreach ($kind.statics as $name => $expr) {
                #check_constant_expression($expr, $kind);
                #statics["{$kind.name}::{$name}"] = len(#static_defaults);
                #static_defaults[] = #fold($expr, $kind);
                $inits[] = #at(StaticInitAST("{$kind.name}::{$name}", last(#static_defaults)), $expr);
            }
        }
        $root.statements = [...$inits, ...$root.statements];

        // In source order, so the first mistake in the program is the one reported
        foreach (#member_uses as [$node, $kind, $argc, $assigned, $written, $in_static]) {
            #check_member_use($node, $kind, $argc, $assigned, $written, $in_static);
        }
        foreach (#dot_on_names as $node) {
            #check_dot_on_name($node);
        }
        foreach (#parent_uses as [$node, $kind]) {
            #check_parent_use($node, $kind);
        }
        foreach (#uses as [$use, $scope]) {
            $static = #static_key($use.name);
            if ($static != null) {
                if (is_a($use, FunctionCallAST)) {
                    #fail_at("{$use.name} is a static field, not a function", $use.file, $use.line);
                }
                $use.static_name = $static;

                continue;
            }
            $constant = #constant_key($use.name);
            if ($constant != null) {
                if (is_a($use, FunctionCallAST)) {
                    #fail_at("{$use.name} is a constant, not a function", $use.file, $use.line);
                }
                $use.constant = true;
                $use.value = #constant_value($constant, $use);

                continue;
            }
            if (has_key(#kinds, $use.name)) {
                $kind = #kinds[$use.name];
                if (is_a($use, FunctionCallAST)) {
                    if ($kind.abstract) {
                        #fail_at("Cannot construct abstract kind {$use.name}", $use.file, $use.line);
                    }
                    $error = #arity_error("Kind {$use.name}", #constructor_arity($kind), len($use.args));
                    if ($error != null) {
                        #fail_at($error, $use.file, $use.line);
                    }
                }

                continue;
            }
            // Child::next is the function Parent::next when the parent declares it
            if (!has_key(#functions, $use.name) && contains($use.name, "::")) {
                [$prefix, $last] = #split_name($use.name);
                $kind = #kinds[$prefix] ?? null;
                if ($kind != null && ($kind.static_is_method[$last] ?? false)) {
                    $use.name = #kind_static($kind, $last);
                }
            }
            if (!has_key(#functions, $use.name)) {
                $error = #qualified_error($use.name);
                if ($error != null) {
                    #fail_at($error, $use.file, $use.line);
                }
                $hint = has_key(Lexer::KEYWORDS, lower($use.name))
                    ? " (keywords are lowercase: write '" .. lower($use.name) .. "', not '{$use.name}')"
                    : "";
                // A bare name that isn't called is as likely a mistyped constant
                $what = is_a($use, FunctionCallAST) ? "Undefined function" : "Undefined function or constant";
                #fail_at("{$what}: {$use.name}{$hint}", $use.file, $use.line);
            }
            if (is_a($use, FunctionCallAST)) {
                $error = #arity_error("Function {$use.name}", #functions[$use.name], len($use.args));
                if ($error != null) {
                    #fail_at($error, $use.file, $use.line);
                }
            }
        }

        // Only a static field of the ones reached by name is a slot, so only it can be written
        foreach (#static_writes as [$node, $operator]) {
            if ($node.static_name == null) {
                #fail_at($node.constant
                    ? "Cannot change constant {$node.name}"
                    : "Can only use {$operator.value} on a variable, or an element or field of one", $node.file, $node.line);
            }
        }

        return $root;
    }

    // Work out a kind's fields and methods from its own and its parent's, checking they fit together
    //
    // The entries of one of a kind's tables that escape it, so a child can name them. What is
    // left behind is recorded on $into, so an error about it can say why it isn't there.
    fn escaping($table, $kind, $into = null, $fields = false) {
        $out = {};
        foreach ($table as $name => $value) {
            if (($kind.owner_vis[$name] ?? "") != "") {
                $out[$name] = $value;
            } else if ($into != null) {
                $into.hidden[$name] = $kind.name;
                if ($fields) {
                    $into.hidden_fields[$name] = $value;
                }
            }
        }

        return $out;
    }

    // Where a name's escaping entry sits in a method table, or null: a private entry of that
    // name belongs to whichever kind declared it, and is not the one an override replaces
    fn entry_of($table, $name) {
        foreach ($table as $at => [$entry, $definer, $vis, $declarer]) {
            if ($entry == $name && $vis != "") {
                return $at;
            }
        }

        return null;
    }

    // Fields and methods share one namespace, a field can't be declared again, and a method
    // may replace a parent's method but must accept every argument count the parent's accepts
    // (except the constructor, which each kind defines for itself). $chain is the kinds
    // being resolved that extend this one, to find circular inheritance.
    fn resolve_kind($kind, $chain) {
        if ($kind.resolved) {
            return;
        }

        if ($kind.parent != null) {
            $parent = #kinds[$kind.parent] ?? null;
            if ($parent == null) {
                #fail_at(#not_a_kind($kind.parent), $kind.file, $kind.line);
            }
            $chain[] = $kind.name;
            if (in_array($parent.name, $chain)) {
                // From the parent's first appearance in the chain, round to it again
                $from = 0;
                while ($chain[$from] != $parent.name) {
                    $from++;
                }
                $cycle = slice($chain, $from);
                $cycle[] = $parent.name;
                #fail_at("Circular inheritance: " .. join($cycle, " extends "), $kind.file, $kind.line);
            }
            #resolve_kind($parent, $chain);
            // A parent's private member is the parent's own: a child can't name it, and may
            // declare one of its own by that name. Its slot and method entry are still
            // inherited, since the parent's own methods run on a child's objects and reach it.
            [$kind.slots, $kind.method_table] = [$parent.slots, $parent.method_table];
            [$kind.hidden, $kind.hidden_fields] = [$parent.hidden, $parent.hidden_fields];
            // Unfiltered: a private member can't be overridden, so this only ever carries
            // what a child could replace, and the entry it replaces keeps its declarer
            $kind.declared_at = $parent.declared_at;
            $kind.layout = #escaping($parent.layout, $parent, $kind, true);
            $kind.members = #escaping($parent.members, $parent, $kind);
            $kind.abstract_methods = #escaping($parent.abstract_methods, $parent, $kind);
            $kind.constant_owners = #escaping($parent.constant_owners, $parent, $kind);
            // A child shares its parent's statics, as it shares the rest of the namespace
            $kind.static_owners = #escaping($parent.static_owners, $parent, $kind);
            $kind.static_is_method = #escaping($parent.static_is_method, $parent);
            $kind.owner_vis = #escaping($parent.owner_vis, $parent);
        }

        foreach ($kind.constants as $name => $_) {
            $line = $kind.constant_lines[$name];
            #check_not_static($kind, $name, "Constant {$name} of {$kind.name}", $line);
            // A child can't declare it again: #NAME is worked out from the kind it is written in, so there is nothing to override
            if (has_key($kind.constant_owners, $name)) {
                #fail_at("Constant {$name} of {$kind.name} is already declared in {$kind.constant_owners[$name]}", $kind.file, $line);
            }
            $owner = $kind.layout[$name] ?? $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
            if ($owner != null) {
                $member = has_key($kind.layout, $name) ? "field" : "method";
                #fail_at("Constant {$name} of {$kind.name} has the name of a {$member} of {$owner}: constants, fields and methods share names", $kind.file, $line);
            }
            $kind.constant_owners[$name] = $kind.name;
            $kind.owner_vis[$name] = $kind.vis[$name];
        }

        foreach ($kind.statics as $name => $_) {
            #check_new_static($kind, $name, $kind.static_lines[$name], false);
        }
        foreach ($kind.static_methods as $name => $method) {
            #check_new_static($kind, $name, $method.line, true);
        }

        foreach ($kind.fields as $name => $_) {
            $line = $kind.field_lines[$name];
            #check_not_static($kind, $name, "Field #{$name}", $line);
            if (has_key($kind.constant_owners, $name) && $kind.constant_owners[$name] != $kind.name) {
                #fail_at("Field #{$name} of {$kind.name} has the name of a constant of {$kind.constant_owners[$name]}: constants, fields and methods share names", $kind.file, $line);
            }
            if (has_key($kind.layout, $name)) {
                #fail_at("Field #{$name} of {$kind.name} is already declared in {$kind.layout[$name]}", $kind.file, $line);
            }
            // A method, constant or static of a parent's that this kind can't name may have
            // its name reused; a field may not, since every field of an object is a slot of
            // its own and the initialiser sets each one by name
            if (has_key($kind.hidden_fields, $name)) {
                #fail_at("Field #{$name} of {$kind.name} has the name of a field of {$kind.hidden_fields[$name]} that isn't pub: a field is a slot, so the name is taken", $kind.file, $line);
            }
            $owner = $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
            if ($owner != null) {
                #fail_at("Field #{$name} of {$kind.name} has the name of a method of {$owner}: fields and methods share names, so call the field something else", $kind.file, $line);
            }
            $kind.layout[$name] = $kind.name;
            $kind.owner_vis[$name] = $kind.vis[$name];
            $kind.slots[] = [$name, $kind.name, $kind.vis[$name]];
        }
        foreach ($kind.methods as $name => $method) {
            #check_not_static($kind, $name, "Method {$kind.name}.{$name}", $method.line);
            if (has_key($kind.constant_owners, $name)) {
                #fail_at("Method {$kind.name}.{$name} has the name of a constant of {$kind.constant_owners[$name]}: constants, fields and methods share names", $method.file, $method.line);
            }
            if (has_key($kind.layout, $name)) {
                #fail_at("Method {$kind.name}.{$name} has the name of a field of {$kind.layout[$name]}: fields and methods share names, so call the method something else", $method.file, $method.line);
            }
            $owner = $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
            // What the parent let escape, before this one's own is recorded below
            $inherited_vis = $kind.owner_vis[$name] ?? null;
            if ($owner != null && $method.abstract && has_key($kind.members, $name)) {
                #fail_at("Abstract method {$kind.name}.{$name} can't replace {$owner}.{$name}", $method.file, $method.line);
            }
            // A child defines an abstract method, and callers call it, so one that escapes
            // nothing could never be defined or reached
            if ($method.abstract && $kind.vis[$name] == "") {
                #fail_at("Abstract method {$kind.name}.{$name} must be pub or kin: a child defines what it can see", $method.file, $method.line);
            }
            // An override answers for the one it replaces, so it escapes as far
            if ($owner != null && $name != "_" && $kind.vis[$name] != $inherited_vis) {
                $was = $inherited_vis == "" ? "escapes only {$owner}" : "is {$inherited_vis}";
                $now = $kind.vis[$name] == "" ? "escapes only {$kind.name}" : "is {$kind.vis[$name]}";
                #fail_at("Method {$kind.name}.{$name} {$now}, but {$owner}.{$name} {$was}: an override escapes as far as what it replaces", $method.file, $method.line);
            }
            // The constructor is each kind's own: a child's can take different arguments
            if ($owner != null && $name != "_") {
                [$fewest, $most] = #bounds($method.arity);
                [$parent_fewest, $parent_most] = #bounds(#kinds[$owner].methods[$name].arity);
                if ($fewest > $parent_fewest || $most < $parent_most) {
                    $expected = $parent_fewest == $parent_most ? $parent_fewest : "{$parent_fewest} to {$parent_most}";
                    #fail_at("Method {$kind.name}.{$name} must accept every argument count {$owner}.{$name} does ({$expected})", $method.file, $method.line);
                }
            }
            if ($name == "to_string" && #bounds($method.arity)[0] != 0) {
                #fail_at("Method {$kind.name}.to_string must accept 0 arguments: printing calls it with none", $method.file, $method.line);
            }
            // Printing calls to_string() from outside the kind, so a private one would be
            // skipped and the object print its fields instead: say so rather than do that
            if ($name == "to_string" && $kind.vis[$name] != "pub") {
                #fail_at("Method {$kind.name}.to_string must be pub: printing calls it from outside", $method.file, $method.line);
            }
            $kind.owner_vis[$name] = $kind.vis[$name];
            if (!has_key($kind.declared_at, $name)) {
                $kind.declared_at[$name] = $kind.name;
            }
            if ($method.abstract) {
                $kind.abstract_methods[$name] = $kind.name;
            } else {
                // An override replaces the entry it overrides; a method whose name only a
                // parent's private one had is a new one, and gets an entry beside it
                $at = $owner == null ? null : #entry_of($kind.method_table, $name);
                // An override keeps the declarer, whose marker it had to match: that kind set
                // what the member escapes and may still name it
                $declarer = $kind.declared_at[$name] ?? $kind.name;
                if ($at == null) {
                    $kind.method_table[] = [$name, $kind.name, $kind.vis[$name], $declarer];
                } else {
                    $kind.method_table[$at] = [$name, $kind.name, $kind.vis[$name], $declarer];
                }
                $kind.members[$name] = $kind.name;
                if (has_key($kind.abstract_methods, $name)) {
                    delete $kind.abstract_methods[$name];
                }
            }
        }

        if (!$kind.abstract && $kind.abstract_methods != {}) {
            $name = keys($kind.abstract_methods)[0];
            #fail_at("Kind {$kind.name} must define abstract method {$name} of {$kind.abstract_methods[$name]}, or be abstract", $kind.file, $kind.line);
        }
        $kind.resolved = true;
    }

    // Check a ##name against the parent of the kind it is written in, and record whose version runs
    fn check_parent_use($node, $kind) {
        if ($kind.parent == null) {
            #fail_at("Cannot use ##{$node.name}: {$kind.name} has no parent kind", $node.file, $node.line);
        }
        $parent = #kinds[$kind.parent];
        $name = $node.name;
        // ##name reaches the parent's version, so the parent must let it escape
        $hidden = #not_pub($kind, $name);
        if ($hidden != null) {
            #fail_at($hidden, $node.file, $node.line);
        }
        if (has_key($parent.layout, $name)) {
            #fail_at("##{$name} can only reach a method, and {$name} is a field of {$parent.layout[$name]}", $node.file, $node.line);
        }
        if (has_key($parent.abstract_methods, $name)) {
            #fail_at("Cannot use ##{$name}: {$name} is abstract in {$parent.abstract_methods[$name]}", $node.file, $node.line);
        }
        if (!has_key($parent.members, $name)) {
            #fail_at($name == "_" ? "{$parent.name} has no constructor to call with ##_" : "{$parent.name} has no method {$name}", $node.file, $node.line);
        }

        $node.definer = $parent.members[$name];
        if ($node.args != null) {
            $error = #arity_error("Method {$node.definer}.{$name}", #kinds[$node.definer].methods[$name].arity, len($node.args));
            if ($error != null) {
                #fail_at($error, $node.file, $node.line);
            }
        }
    }

    // Parse the builtin kinds (Error), before the program, so its kinds can use them
    fn builtin_kinds() {
        [$lexer, $current_token, $file] = [#lexer, #current_token, #file];
        #lexer = Lexer(#BUILTIN_SOURCE);
        #file = #BUILTIN_FILE;
        #current_token = #next_token();
        $kinds = [];
        while (#current_token.type != "EOF") {
            $kinds[] = #kind_declaration();
        }
        [#lexer, #current_token, #file] = [$lexer, $current_token, $file];

        return $kinds;
    }

    // The number of arguments constructing a resolved kind takes: its constructor's, or none
    fn constructor_arity($kind) {
        return has_key($kind.members, "_") ? #kinds[$kind.members["_"]].methods["_"].arity : 0;
    }

    // Check a #name against its kind: the member must exist, a method can't be assigned to, and a call must fit its arity
    //
    // Called methods are checked against the kind the method is written in: a child's
    // version accepts every argument count this one does.
    fn check_member_use($node, $kind, $argc, $assigned, $written, $in_static) {
        $static = #kind_static($kind, $node.name);
        if ($static != null) {
            if ($argc != null && !$kind.static_is_method[$node.name]) {
                #fail_at("#{$node.name} is a static field, not a method", $node.file, $node.line);
            }
            if ($argc == null && $kind.static_is_method[$node.name]) {
                #fail_at("#{$node.name} is a static method: call it, or reach it by name", $node.file, $node.line);
            }
            if ($argc != null) {
                $error = #arity_error("Static method {$static}", #functions[$static], $argc);
                if ($error != null) {
                    #fail_at($error, $node.file, $node.line);
                }
            }
            $node.static_name = $static;

            return;
        }
        if ($in_static) {
            #fail_at("#{$node.name} is not static, and a static method has no object", $node.file, $node.line);
        }
        $constant = #kind_constant($kind, $node.name);
        if ($constant != null) {
            if ($written) {
                #fail_at("Cannot change constant #{$node.name}", $node.file, $node.line);
            }
            if ($argc != null) {
                #fail_at("#{$node.name} is a constant, not a method", $node.file, $node.line);
            }
            $node.constant = true;
            $node.value = #constant_value($constant, $node);

            return;
        }
        if (has_key($kind.layout, $node.name)) {
            $node.field = true;

            return;
        }
        $definer = $kind.members[$node.name] ?? $kind.abstract_methods[$node.name] ?? null;
        if ($definer == null) {
            #fail_at(#not_pub($kind, $node.name) ?? "{$kind.name} has no member #{$node.name}", $node.file, $node.line);
        }
        if ($assigned) {
            #fail_at("Cannot assign to method #{$node.name}", $node.file, $node.line);
        }
        if ($argc != null) {
            $error = #arity_error("Method {$definer}.{$node.name}", #kinds[$definer].methods[$node.name].arity, $argc);
            if ($error != null) {
                #fail_at($error, $node.file, $node.line);
            }
        }
    }

    // The fewest and most arguments an arity allows
    fn bounds($arity) {
        return type_of($arity) == "int" ? [$arity, $arity] : $arity;
    }

    // What is wrong with a call's argument count, or null if it fits, worded as the VM words it
    fn arity_error($what, $arity, $argc) {
        [$fewest, $most] = #bounds($arity);
        if ($argc >= $fewest && $argc <= $most) {
            return null;
        }
        $expected = $fewest == $most ? $fewest : "{$fewest} to {$most}";

        return "{$what} expects {$expected} arguments, {$argc} given";
    }

    // Parse top level items until the end of the current file ((function_declaration | kind_declaration | include | statement)*)
    fn top_level() {
        $statements = [];
        while (#current_token.type != "EOF") {
            if (#current_token.type == "NAMESPACE") {
                #namespace_declaration();
            } else if (#current_token.type == "PUB" || #current_token.type == "FN"
                || #current_token.type == "KIND" || #current_token.type == "ABSTRACT"
                || #current_token.type == "CONST") {
                $pub = #current_token.type == "PUB";
                if ($pub) {
                    #eat("PUB");
                }
                if (#current_token.type == "FN") {
                    $statements[] = #function_declaration($pub);
                } else if (#current_token.type == "KIND" || #current_token.type == "ABSTRACT") {
                    // A static method is a function, so it is spliced in after its kind
                    $from = len(#static_functions);
                    $statements[] = #kind_declaration($pub);
                    while ($from < len(#static_functions)) {
                        $statements[] = #static_functions[$from];
                        $from++;
                    }
                } else if (#current_token.type == "CONST") {
                    #constant_declaration(null, $pub);
                } else {
                    #fail("Expected a function (fn), a kind or a constant (const) after pub but found " .. #describe(#current_token));
                }
            } else if (#current_token.type == "INCLUDE") {
                $statements = [...$statements, ...#include_statement()];
            } else {
                $statements[] = #statement();
            }
            #file_started = true;
        }

        return $statements;
    }

    // Parse a namespace declaration (NAMESPACE IDENTIFIER SEMICOLON)
    //
    // At most one, first in its file, and optional: a file without one declares its names
    // globally, as every file did before there were namespaces. Privacy is per namespace,
    // not per file, so several files can declare the same one and go on seeing everything
    // of each other's.
    fn namespace_declaration() {
        $token = #current_token;
        #eat("NAMESPACE");
        if (#namespace != "") {
            #fail_at("A file can declare at most one namespace", #file, $token.line);
        }
        if (#file_started) {
            #fail_at("namespace must come before everything else in its file", #file, $token.line);
        }
        $name = #current_token.value;
        #eat("IDENTIFIER");
        #eat("SEMICOLON");
        #namespace = $name;
        #namespaces[$name] = true;
        #reachable[$name] = true;
        if (#real_file != null) {
            #file_namespaces[#real_file] = $name;
        }
    }

    // Parse an include (INCLUDE STRING SEMICOLON) and the top level of the included file
    //
    // The path is relative to the including file. The included file shares this
    // parser's functions, so everything is checked and hoisted as one program, and
    // a file already parsed (including the main file) is skipped, which also stops
    // include cycles. It gives the included file's statements, or none if it was already included.
    fn include_statement() {
        #eat("INCLUDE");
        $path_token = #current_token;
        if ($path_token.type == "STRING_START") {
            // Includes are resolved while parsing, before any variable has a value
            #fail("include paths cannot use interpolation");
        }
        #eat("STRING");
        $use_token = #current_token;
        $names = #current_token.type == "USE" ? #use_clause() : [];
        #eat("SEMICOLON");

        $relative = $path_token.value;
        // "std/name.gaz" is the standard library, built into the VM; a file of it names its
        // neighbours as any file does, and its own "directory" is <std>, which is not a path
        // (starting with an angle bracket, it is never rewritten in bytecode)
        $std = starts_with($relative, "std/") ? slice($relative, 4) : (#base_dir == Parser::STD_DIRECTORY ? $relative : null);
        if ($std != null) {
            $path = Parser::STD_DIRECTORY .. "/" .. $std;
            $text = std_source($std);
        } else {
            $written = starts_with($relative, "/") ? $relative : #base_dir .. "/" .. $relative;
            $path = file_exists($written) ? real_path($written) : null;
            // Read before asking whether it was included already, so a file that can't be read
            // is an error even if it was included before
            $text = $path == null ? null : #read($path);
        }
        if ($text == null) {
            #fail_at("Cannot include file: {$relative}", #file, $path_token.line);
        }
        if (has_key(#included, $path)) {
            // Already spliced in, so it gives no statements again, but this file still gets
            // what it asked for: the namespace qualified, and the use clause's aliases
            $namespace = #file_namespaces[$path] ?? "";
            if ($namespace != "") {
                #reachable[$namespace] = true;
            }
            #add_aliases($names, $namespace, $relative, $use_token.line);

            return [];
        }
        #included[$path] = true;
        #file_namespaces[$path] = "";

        [$lexer, $current_token, $base_dir, $file, $real_file] = [#lexer, #current_token, #base_dir, #file, #real_file];
        $saved = #enter_file();
        #lexer = Lexer($text);
        #base_dir = #dirname($path);
        #file = #display_path($path);
        #real_file = $path;
        #current_token = #next_token();
        $statements = #top_level();
        $namespace = #namespace;
        #leave_file($saved);
        [#lexer, #current_token, #base_dir, #file, #real_file] = [$lexer, $current_token, $base_dir, $file, $real_file];
        if ($namespace != "") {
            #reachable[$namespace] = true;
        }
        #add_aliases($names, $namespace, $relative, $use_token.line);

        return $statements;
    }

    // Parse an include's use clause (USE name [AS name] (COMMA name [AS name])*)
    //
    // The names are bare, since the string already said which file they come from, and the
    // clause is the only way to bring a name in unqualified: there is no standalone use, so
    // a file can only name what it includes itself.
    fn use_clause() {
        #eat("USE");
        $names = [];
        while (true) {
            $token = #current_token;
            $name = $token.value;
            #eat("IDENTIFIER");
            if (#current_token.type == "DOUBLE_COLON") {
                #fail("A name in a use clause is bare: the file it comes from is the string before it, so write '{$name}', not '{$name}::...'");
            }
            $alias = $name;
            if (#current_token.type == "AS") {
                #eat("AS");
                $alias = #current_token.value;
                #eat("IDENTIFIER");
            }
            $names[] = [$name, $alias, $token.line];
            if (#current_token.type != "COMMA") {
                return $names;
            }
            #eat("COMMA");
        }
    }

    // Add an include's use clause to this file's aliases, now that its namespace is known
    fn add_aliases($names, $namespace, $relative, $line) {
        if (len($names) > 0 && $namespace == "") {
            #fail_at("{$relative} declares no namespace, so there is nothing to use from it", #file, $line);
        }
        foreach ($names as [$name, $alias, $at]) {
            if (has_key(#aliases, $alias)) {
                #fail_at("{$alias} is already used in this file", #file, $at);
            }
            #aliases[$alias] = "{$namespace}::{$name}";
            #alias_uses[] = ["{$namespace}::{$name}", #file, $at, #scope];
        }
    }

    // Parse the input and return the tree
    pub fn parse() {
        return #program();
    }
}
