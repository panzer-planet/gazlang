// The GazLang parser in GazLang: tokens to a tree of the nodes in nodes.gaz, as --ast shows it.
// tests/SelfHostedParserTest.php checks its trees and errors against tests/corpora/parser.
// Methods are named after the grammar rule they read (function_call(), ternary()).
//
// It only declares, as an imported file does. To use it:
// $root = Parser(Lexer($text), $path).parse(). Errors are ParseErrors.
namespace gazlang;

import "./lexer.gaz";
import "./nodes.gaz";
import "./template.gaz";
import "std/json.gaz";
import "std/text.gaz" use quote;

// #line and #file are Error's own, and say where in this file the error was raised, so the
// place in the source being parsed has names of its own, as in LexError
kind ParseError extends Error {
    pub #reason;
    pub #source_file;
    pub #source_line;

    // Where the error is: a file is null for piped or inline source
    fn _($reason, $source_file, $source_line) {
        ##_($reason .. " " .. ($source_file == null ? "on line {$source_line}" : "at {$source_file}:{$source_line}"));
        #reason = $reason;
        #source_file = $source_file;
        #source_line = $source_line;
    }
}

/*
 * The directory of the standard library's files, which are built in: never a real directory,
 * so a path starting with it is never rewritten in bytecode
 */
const STD_DIRECTORY = "<std>";

/*
 * A file the program is made of, while it is parsed and afterwards, when the names written in
 * it are resolved against what it sees: its own declarations and those of the modules it
 * imports, and no further.
 */
kind Module {
    // Its namespace, "" when it declares none
    pub #namespace = "";
    // Each bare name a use clause brought in, to the declared name it means
    pub #aliases = {};
    // The namespaces it may write: its own and its imports'
    pub #reachable = {};
    // The modules whose declarations it sees, by key: itself and those it imports
    pub #imports = {};
    // Whether anything has been read in it, after which no namespace may come
    pub #started = false;
    // Whether a declaration or statement has been read in it, after which no import may come
    pub #declaring = false;

    /*
     * $key is how the file is known however its path is spelt: its real path, <std>/name.gaz
     * for the standard library's, <main> for source with no file. $file is how errors show
     * it, $directory what a ./ import is from and $root what a plain one is from, and $entry
     * whether it is the main file, the one file that may run statements.
     */
    fn _(pub #key, pub #file, pub #directory, pub #root, pub #entry) {
        #imports[#key] = true;
    }
}

/*
 * Where an import's path leads, from the path alone: a file of the standard library, a path to
 * look for, or why the path is refused. The language server follows imports with it too.
 */
kind ImportTarget {
    pub #std = null;
    pub #path = null;
    pub #refusal = null;
}

// The ImportTarget for an import written in a file whose directory and project root are these
fn import_target($written, $directory, $root) {
    $target = ImportTarget();
    if (starts_with($written, "std/")) {
        $target.std = slice($written, 4);

        return $target;
    }
    $target.refusal = path_refusal($written);
    if ($target.refusal != null) {
        return $target;
    }
    $local = starts_with($written, "./");
    $relative = $local ? slice($written, 2) : $written;
    $from = $local ? $directory : $root;
    if ($from == STD_DIRECTORY) {
        $target.std = $relative;
    } else {
        $target.path = join_path($from, $relative);
    }

    return $target;
}

// Why an import's path, other than a std/ one, can't be imported whatever is on disk, or null
fn path_refusal($written) {
    if (starts_with($written, "pkg/")) {
        return "packages aren't built yet";
    }
    if (starts_with($written, "/")) {
        return "a path is from the project root, or ./ for this file's directory, never absolute";
    }
    if (!ends_with($written, ".gaz") && !ends_with($written, ".gazml")) {
        return "only a .gaz or .gazml file can be imported";
    }
    $relative = starts_with($written, "./") ? slice($written, 2) : $written;
    foreach (split($relative, "/") as $step) {
        if ($step == "..") {
            return "a path can't climb: write it from the project root, or ./ below this file";
        }
        if ($step == "" || $step == ".") {
            return "a path's steps are names, with no empty or . step";
        }
    }

    return null;
}

// The nearest directory at or above $directory, a real path, that holds a gaz.json, or null
fn project_root($directory) {
    $at = $directory;
    while (!file_exists(join_path($at, "gaz.json"))) {
        $parent = directory_of($at);
        // The top, or a directory that isn't a real path and has no parent to climb to
        if ($at == "/" || $parent == $at) {
            return null;
        }
        $at = $parent;
    }

    return $at;
}

/*
 * The directory a real path is in, as PHP's dirname(): a real path has no "." or ".." steps,
 * doubled slashes or trailing slash to get wrong
 */
fn directory_of($path) {
    $steps = split($path, "/");
    if (len($steps) == 1) {
        return ".";
    }
    $directory = join(slice($steps, 0, -1), "/");

    return $directory == "" ? "/" : $directory;
}

// A name in a directory, the root's included
fn join_path($directory, $name) {
    return $directory == "/" ? "/{$name}" : "{$directory}/{$name}";
}

// Collects the $ variables a node uses, in source order, and those it assigns with a plain =
//
// A nested lambda contributes the variables it captures, since those must be read when it is
// created, and nothing it assigns, which is local to its own calls. An object rather than
// two maps passed along: a map passed to a function is a copy.
kind VariableCollector {
    // The names, as the keys of a map, which keeps them in the order they were first met
    pub #found = {};
    pub #assigned = {};

    // A stack rather than recursion: a chain of operators is as deep on its left as it is
    // long, and two calls a level would run out of call depth at about 5000 of them
    pub fn collect($node) {
        $stack = [$node];
        while (len($stack) > 0) {
            $last = len($stack) - 1;
            $value = $stack[$last];
            delete $stack[$last];

            $children = is_a($value, AST) ? #visit($value) : $value;
            if (type_of($children) == "map") {
                $children = values($children);
            }
            // Children sit at any depth of lists and maps: a list literal's [key, value]
            // entries, a match's arms, whose values are a list inside each arm. The last goes
            // on first, so the first comes off next and names are found in source order.
            foreach (reverse($children) as $child) {
                if (is_a($child, AST) || type_of($child) == "list" || type_of($child) == "map") {
                    $stack[] = $child;
                }
            }
        }
    }

    // Note what one node uses and assigns, and give what is to be searched under it
    fn visit($node) {
        if (is_a($node, VariableAST)) {
            if (!$node.is_global()) {
                #found[$node.value] = true;
            }

            return [];
        }
        if (is_a($node, LambdaAST)) {
            foreach ($node.captures as $name) {
                #found[$name] = true;
            }

            return [];
        }
        $targets = match {
            is_a($node, AssignAST) && is_a($node.left, ListPatternAST) => $node.left.targets,
            is_a($node, AssignAST) && $node.token.type == "ASSIGN" => [$node.left],
            is_a($node, ForeachStatementAST) && is_a($node.value, ListPatternAST) => [$node.key, ...$node.value.targets],
            is_a($node, ForeachStatementAST) => [$node.key, $node.value],
            default => [],
        };
        if (is_a($node, TryStatementAST)) {
            foreach ($node.catches as $catch) {
                $targets[] = $catch[1];
            }
        }
        foreach ($targets as $target) {
            if (is_a($target, VariableAST) && !$target.is_global()) {
                #assigned[$target.value] = true;
            }
        }

        return fields($node);
    }
}

kind Parser {
    #lexer;
    #current_token;
    // The token before it, so a syntax error can point at a miscapitalised keyword that was
    // read as a name (see keyword_hint())
    #previous_token = null;
    // The token the statement being parsed starts with, so a syntax error in "} elseif (...) {"
    // can say to write "else if" (see keyword_hint())
    #statement_token = null;
    // The file being parsed, as shown in errors
    #file;
    // The main file's path as given, or null for source with no file
    #path;
    /*
     * The file being parsed as a module (see Module), and every module read so far by key, so
     * each is read once however its path is spelt, which is also what ends a cycle of imports
     */
    #module = null;
    #modules = {};
    // The main file's project root, which a file with no gaz.json above it shares
    #main_root = null;
    // Each gaz.json read, by the directory it marks, so each is checked once
    #projects = {};
    /*
     * The real path of GAZLIB, the directory std/ is read from instead of the built-in copy, or
     * null: a file in it is the standard library's, so std/x.gaz and that file are one module
     */
    #library = null;
    /*
     * The line of the main file's first statement, and the place a module imports the main
     * file, which together are a statement in an imported file
     */
    #main_statement = null;
    #main_imported = null;

    // How many loops enclose the statement being parsed, so break and continue can be checked
    #loop_depth = 0;
    // Whether a function body is being parsed, so return can be checked
    #in_function = false;
    // Whether a finally block is being parsed, which return, break and continue can't leave
    #in_finally = false;
    // Whether a constructor's body is being parsed, where return can't give a value
    #in_constructor = false;
    // Whether a constant's value is being parsed, where a string can't interpolate a variable
    #in_constant = false;

    // The kind whose body is being parsed, where # can be used
    #kind = null;

    // Declared kinds by name, resolved once the whole program is read
    #kinds = {};
    // Declared interfaces by name, which kinds are checked against once the whole program is read
    #interfaces = {};
    // The fields a constructor's promoted parameters declared, as "Kind::name", so a second
    // declaration of one can say where the first came from (a promoted parameter is the field)
    #promoted = {};

    // Every #name, in source order, as [node, the kind it is written in, the argument count
    // if it is called or null, whether it is assigned to], checked once the kinds are
    // resolved. A node holds its index here (PropertyAST.use), so what is learnt about it
    // later finds the record again, since an object can't be a map key. An index
    // rather than the record itself, which would make every kind's tree a cycle: the node,
    // its record, the kind, its methods, the node.
    #member_uses = [];

    // Every constant, in the order declared, as [expression, the kind that declares it or
    // null, its name as errors show it]. A kind's constant X is keyed "Kind::X".
    #constants = {};
    // The constants worked out so far, by the same keys
    #constant_values = {};
    // The constants being worked out, outermost first, to find one that depends on itself
    #folding = [];
    // Every qualified name written under, with the operator that did it, which is only
    // allowed if the name turns out to be a static field
    #static_writes = [];
    // Every static field, "Owner::name" to its slot in declaration order, and the constant
    // each starts at, which the code generator writes before anything else runs
    #statics = {};
    #static_defaults = [];
    // Every static method's FunctionDeclarationAST, which the top level gets as a function
    #static_functions = [];
    // The kind whose static method is being parsed, so #name in it is the kind's
    #in_static = null;

    // Every Name.member, which is an error if Name turns out to be a kind: a kind is
    // reached by name, with ::, and the dot goes through a value
    #dot_on_names = [];
    // List literals written with an empty slot ([$a, , $b]), which only a pattern may have: each is taken
    // off when it becomes one, and any left when the program is read is an error
    #gaps = [];

    /*
     * Every module in the order it was entered, since a name is only resolved when the whole
     * program is read, against what the file it is written in sees. #scope is the current
     * file's index here, and 0 is the builtin kinds' (see program()).
     */
    #scopes = [];
    #scope = 0;
    /*
     * Every namespace any file declares, with the project root its first module is in and how
     * that module is shown, since a namespace belongs to one project
     */
    #namespaces = {};
    /*
     * The namespace each declared top level name is in, the module that declares it, and which
     * of them are pub
     */
    #declared_in = {};
    #declared_module = {};
    #public = {};
    // Every kind's parent and every catch clause's kind, as [kind or node, scope], since
    // both name a kind that is resolved once the whole program is read
    #parent_names = [];
    // Every kind that claims interfaces, as [kind, scope], each name resolved the same way
    #interface_claims = [];
    /*
     * Every name an `import ... use` clause brought in, as [qualified name, file, line, scope,
     * the imported module, the path as written], checked once the whole program is read as
     * any other use of it is
     */
    #alias_uses = [];

    // Every catch clause that names a kind, as [try node, which catch, line, file, scope]:
    // the name is in a list on the node, so resolution writes the resolved one back there
    #catch_types = [];

    // Every declared type, as [TypeAST, scope]: a name in one that isn't a builtin type's is
    // a kind's, resolved and checked once the whole program is read
    #type_uses = [];
    // The type the function being parsed returns, or null: what a bare return is checked against
    #return_type = null;
    // What a type error names the function being parsed as, as the VM names it: f(), Kind.m()
    #return_label = null;
    // Every value a typed function returns, as [expression, TypeAST, the function as #return_label names it]
    #typed_returns = [];
    // Each function and static method's declaration by name, for the types its calls are checked against
    #signatures = {};
    // Every lambda with a typed parameter, whose defaults are checked against their types
    #typed_lambdas = [];
    // Every #name(...) call, whose arguments are checked once the member it calls is known
    #member_calls = [];

    // The type_of() names, which a type is made of besides kinds; no kind can be called one
    const TYPE_NAMES = ["int", "float", "string", "bool", "null", "list", "map", "function", "kind", "object", "socket", "db", "file"];
    // Three of them are keywords, so they arrive as their own tokens rather than as names
    const TYPE_KEYWORDS = ["NULL", "KIND"];

    // Whether any catch clause was parsed, so the program needs the Error kind
    #catches = false;

    // The shared variables visible here, by name ($x): those a `shared` statement declared
    // earlier in this function, or in the function a lambda is written in and the lambdas
    // around it. A named function starts with none.
    #shared = {};
    // The plain variables named so far in this function or lambda, each with how many times, so
    // a `shared` statement for one already in use is refused rather than made a second
    // variable. A lambda's parameters are read as expressions before the -> shows they are
    // parameters, so lambda() takes them back out (forget_uses()).
    #plain = {};
    // The parameters of the function or lambda being parsed, which can't be shared
    #bound = {};
    // The parameters of the function or lambda being parsed that are written through an index
    // ($list[] = 1), each with how many times and where first, so leave_scope() can refuse a
    // write that is lost
    #index_writes = {};
    // Whether any shared variable was declared, so the program needs the Shared kind
    #shares = false;
    // Whether a template has been imported, whose code uses the builtin kind Html
    #templates = false;

    // Every ##name as [node, the kind it is written in], checked once the kinds are resolved
    #parent_uses = [];

    // Source of the builtin kinds, parsed into every program: Error is what runtime errors
    // and throw "message" raise, and Shared is the box a `shared` variable lives in (see
    // shared_declaration()). Single quoted, so nothing in it is interpolated.
    // Every program reaches an error's members ($e.message), and printing one calls its
    // to_string() from outside, so all of them are pub
    const BUILTIN_SOURCE = 'kind Error {
    pub #message;
    pub #file;
    pub #line;
    pub #trace;
    pub #cause = null;
    fn _($message, $cause = null) {
        #message = $message;
        #cause = $cause;
    }
    pub fn to_string() { return "{#message}"; }
}
kind Shared {
    fn _(pub #value);
}
final kind Html {
    fn _(pub #text) {}

    pub fn to_string() {
        return #text;
    }

    // A value as HTML: an Html as it is, anything else as echo prints it, escaped
    pub static fn escape($value) {
        if (type_of($value) == "object" && is_a($value, Html)) {
            return $value.text;
        }
        $text = to_string($value);
        foreach ([["&", "&amp;"], ["<", "&lt;"], [">", "&gt;"], ["\"", "&quot;"], ["\'", "&#39;"]] as [$from, $to]) {
            $text = replace($text, $from, $to);
        }

        return $text;
    }
}';

    // Why an enum's body can't hold a field
    const ENUM_HAS_NO_FIELDS = "An enum has no fields: its cases are its only objects, and they never change";

    // Why abstract and final can't mark one kind or method
    const ABSTRACT_AND_FINAL = {
        "kind" => "A kind can't be both abstract and final: an abstract kind is there to be extended",
        "fn" => "A method can't be both abstract and final: an abstract method is there to be defined by a child",
    };

    // How errors name the builtin kinds' source
    const BUILTIN_FILE = "<builtin>";
    // How source with no file is known as a module
    const MAIN = "<main>";
    // Why a statement can't be in a file that is imported
    const STATEMENT_IN_MODULE = "An imported file only declares (fn, kind, interface, enum, const): move this statement into a function, or into the program's main file";

    // Every call by name and bare name used as a value, in source order, as [the node, its
    // file's scope, the kind it is written in or null], checked against the declared
    // functions once the whole program is read
    #uses = [];

    // The ( that starts the expression being parsed at the ternary's level, the only place a
    // parenthesised parameter list can start a lambda. One is enough, rather than a set of
    // them, since nothing is read between ternary() marking a ( and parenthesised() asking
    // about it.
    #lambda_head = null;
    // The expression parenthesised() gave last for a ( expr ), so that pipe() can tell the
    // parenthesised expression that is called with the value from anything else starting with (
    #grouped = null;

    // Assignment operator token types: = and the compound assignments
    const ASSIGNMENTS = [
        "ASSIGN", "PLUS_ASSIGN", "MINUS_ASSIGN", "MULTIPLY_ASSIGN", "DIVIDE_ASSIGN", "MODULO_ASSIGN",
        "CONCAT_ASSIGN", "COALESCE_ASSIGN",
        "BIT_AND_ASSIGN", "BIT_OR_ASSIGN", "BIT_XOR_ASSIGN", "SHIFT_LEFT_ASSIGN", "SHIFT_RIGHT_ASSIGN",
        "POWER_ASSIGN",
    ];

    // The binary operators' levels, loosest first, each left associative: the tower in
    // CLAUDE.md from logical_or down to multiplicative. A new level is a new number here.
    const BINARY_LEVELS = {
        "OR" => 1,
        "AND" => 2,
        "EQUALS" => 3, "NOT_EQUALS" => 3, "SPACESHIP" => 3,
        "LESS_THAN" => 4, "LESS_EQUALS" => 4, "GREATER_THAN" => 4, "GREATER_EQUALS" => 4,
        "PIPE" => 5,
        "CONCAT" => 6,
        "BIT_OR" => 7,
        "BIT_XOR" => 8,
        "BIT_AND" => 9,
        "SHIFT_LEFT" => 10, "SHIFT_RIGHT" => 10,
        "PLUS" => 11, "MINUS" => 11,
        "MULTIPLY" => 12, "DIVIDE" => 12, "MODULO" => 12,
    };

    // Keywords reserved for features that don't exist yet, so adding them never breaks a program:
    // none now, and kept for the next one
    pub const RESERVED = [];
    // Keywords of features that are gone, kept so that using one says what replaced it
    pub const REMOVED = ["INCLUDE"];

    // Every builtin function mapped to its parameter count, [fewest, most] when some are
    // optional: the builtins of the runtime this parser runs on, which is the one that will run
    // what it parses until there is a compiler to write bytecode for another
    #builtins = builtins();
    // Those and the declared functions, which share their namespace
    #functions = #builtins;

    // How expected tokens are described in syntax errors; other types are keywords, shown quoted and lowercase
    const EXPECTED = {
        "LEFT_PAREN" => "'('", "RIGHT_PAREN" => "')'", "LEFT_BRACE" => "'{'", "RIGHT_BRACE" => "'}'",
        "LEFT_BRACKET" => "'['", "RIGHT_BRACKET" => "']'", "SEMICOLON" => "';'", "COMMA" => "','",
        "IDENTIFIER" => "a name", "VAR_IDENTIFIER" => "a \$variable", "GLOBAL_VAR_IDENTIFIER" => "an @variable",
        "STRING" => "a string", "COLON" => "':'", "ARROW" => "'->'", "DOUBLE_ARROW" => "'=>'", "ASSIGN" => "'='",
    };

    /*
     * $path is the file the source came from, if any; its imports resolve from it (see
     * main_module()). A path with nothing there, like a name given to inline source, is no
     * file: its imports resolve from the working directory, as without a path.
     */
    fn _($lexer, $path = null) {
        // The main file is shown as the user gave it; imported files relative to the working directory
        #file = $path;
        #path = $path;
        #lexer = $lexer;
        #current_token = #next_token();
    }

    // Raise an error for an unexpected token
    fn unexpected() {
        #fail("Unexpected " .. #describe(#current_token));
    }

    // Raise an error at the current token's line
    fn fail($message) {
        throw ParseError($message .. #keyword_hint(), #file, #current_token.line);
    }

    // Raise an error somewhere else, without the hint
    fn fail_at($message, $file, $line) {
        throw ParseError($message, $file, $line);
    }

    /*
     * A hint when the error is at, or just after, a keyword written in the wrong case, or in a
     * statement that starts with one (IF (1) { is read as a call, which fails at the {) or with
     * PHP's elseif. A name that is already declared is left alone: naming things If and Match is
     * the point of the rule.
     */
    fn keyword_hint() {
        foreach ([#current_token, #previous_token, #statement_token] as $token) {
            if ($token != null && $token.type == "IDENTIFIER" && has_key(Lexer::KEYWORDS, lower($token.value))
                && !#declared($token.value) && !#declared(#qualify($token.value))) {
                return " (keywords are lowercase: write '" .. lower($token.value) .. "', not '{$token.value}')";
            }
        }
        // PHP's elseif is read as a call to a function of that name, which fails at the { after it
        $token = #statement_token;
        if ($token != null && ($token.type == "IDENTIFIER" || $token.type == "TAG") && lower($token.value) == "elseif" && !has_key(#functions, #qualify($token.value))) {
            return " (write 'else if', not '{$token.value}')";
        }

        return "";
    }

    // A hint for a name that is neither declared nor a builtin: a miscapitalised keyword, or
    // a call to error(), since what raises is throw
    fn undefined_hint($name) {
        if (has_key(Lexer::KEYWORDS, lower($name))) {
            return " (keywords are lowercase: write '" .. lower($name) .. "', not '{$name}')";
        }
        if ($name == "error") {
            return " (to raise an error, write 'throw \$value', not 'error(\$value)')";
        }

        return "";
    }

    // Describe a token the way it appears in the source, for error messages
    fn describe($token) {
        return match {
            $token.type == "EOF" => "end of file",
            // A list prints its strings as literals
            in_array($token.type, ["STRING", "STRING_START", "STRING_MIDDLE", "STRING_END"]) => "string " .. quote($token.value),
            $token.type == "TAG" => "tag {$token.value}\"...\"",
            // A float prints as the shortest literal that reads back
            default => "'{$token.value}'",
        };
    }

    // Get the next token, adding this file's name to lexer errors
    fn next_token() {
        try {
            return #lexer.get_next_token();
        } catch (LexError $e) {
            throw ParseError($e.reason, #file, $e.source_line);
        }
    }

    // A real path relative to the working directory when it is inside it
    fn display_path($real_path) {
        $cwd = cwd() .. "/";

        return starts_with($real_path, $cwd) ? slice($real_path, len($cwd)) : $real_path;
    }

    // A file's text, or null if it can't be read, which is how a directory or an unreadable
    // file is told apart from one to import. Only the read is in the try: a catch of Error
    // around more would also catch a bug in it, or running out of call depth.
    fn read($path) {
        try {
            return read_file($path);
        } catch (Error $e) {
            return null;
        }
    }

    // Record where a node came from, so errors about it can point at the source
    fn at($node, $token) {
        $node.line = $token.line;
        $node.file = #file;

        return $node;
    }

    // If the current token has this type, eat it and get the next one; if not, fail
    fn eat($token_type) {
        if (#current_token.type != $token_type) {
            $expected = #EXPECTED[$token_type] ?? "'" .. lower($token_type) .. "'";
            #fail("Expected {$expected} but found " .. #describe(#current_token));
        }

        #previous_token = #current_token;
        #current_token = #next_token();
    }

    // Parse a local ($name) or global (@name) variable
    //
    // A shared variable is read and written through the box it lives in: $name is
    // $#shared_name.value, an ordinary field of a hidden variable, so nothing below the parser
    // learns of it
    fn variable() {
        $token = #current_token;
        $node = #at(VariableAST($token), $token);
        #eat($token.type == "GLOBAL_VAR_IDENTIFIER" ? "GLOBAL_VAR_IDENTIFIER" : "VAR_IDENTIFIER");
        if ($token.type == "GLOBAL_VAR_IDENTIFIER") {
            return $node;
        }
        if (has_key(#shared, $token.value)) {
            return #shared_use($token);
        }
        #plain[$token.value] = (#plain[$token.value] ?? 0) + 1;

        return $node;
    }

    // What a use of the shared variable $token names is: the value in its box
    fn shared_use($token) {
        $box_token = Token("VAR_IDENTIFIER", "\$#shared_" .. slice($token.value, 1));
        $box_token.line = $token.line;
        $box = #at(VariableAST($box_token), $token);

        return #at(PropertyAST($box, "value"), $token);
    }

    // The name ($x) of the shared variable a node is a use of, or null if it isn't one
    fn shared_name($node) {
        if (is_a($node, PropertyAST) && $node.name == "value" && is_a($node.target, VariableAST)
            && starts_with($node.target.value, "\$#shared_")) {
            return "$" .. slice($node.target.value, 9);
        }

        return null;
    }

    // Begin a function or lambda body, where the variables named so far start again: with
    // $inherit (a lambda) the shared variables around it stay visible. Gives what leave_scope()
    // puts back, and $params are the names the body starts out using.
    fn enter_scope($params, $inherit) {
        $saved = [#shared, #plain, #bound, #index_writes];
        if (!$inherit) {
            #shared = {};
        }
        #plain = {};
        #bound = {};
        #index_writes = {};
        foreach ($params as $param) {
            #bound[$param] = true;
        }

        return $saved;
    }

    fn leave_scope($saved) {
        #check_lost_writes();
        [#shared, #plain, #bound, #index_writes] = $saved;
    }

    // Note that a path is written through an index on a parameter: $list[] = 1 changes the
    // call's own copy, since a parameter is a value
    //
    // A path with a field in it could be an object's, which a write does reach, so it is not noted.
    fn note_index_write($target) {
        $root = $target;
        while (is_a($root, IndexAST)) {
            $root = $root.target;
        }
        if ($root == $target || !is_a($root, VariableAST) || !has_key(#bound, $root.value)) {
            return;
        }
        if (!has_key(#index_writes, $root.value)) {
            #index_writes[$root.value] = [0, $target.file, $target.line];
        }
        #index_writes[$root.value][0]++;
    }

    // Refuse a parameter whose every use in the body is a write through an index: the write
    // lands in a copy no one reads, so the function does nothing
    fn check_lost_writes() {
        foreach (#index_writes as $name => [$count, $file, $line]) {
            if ((#plain[$name] ?? 0) == $count) {
                #fail_at("{$name} is a copy, so writing to its elements changes nothing the caller sees: return it, or keep the list in an object", $file, $line);
            }
        }
    }

    // Take back one use of each of these names: a lambda's parameters, which variable() counted
    // in the scope around the lambda before its -> showed what they were
    fn forget_uses($names) {
        foreach ($names as $name) {
            $left = (#plain[$name] ?? 0) - 1;
            if ($left > 0) {
                #plain[$name] = $left;
            } else if (has_key(#plain, $name)) {
                delete #plain[$name];
            }
        }
    }

    // Parse a call by name (IDENTIFIER arguments), the name having been eaten. $at is its
    // first token, which is where it is located however many :: the name has.
    fn function_call($name, $at) {
        return #function_call_node($name, #arguments(), $at);
    }

    // A call by name, recorded to be checked once the whole program is read
    fn function_call_node($name, $args, $at) {
        $node = #at(FunctionCallAST($name, $args), $at);
        #uses[] = [$node, #scope, #kind];

        return $node;
    }

    // The rest of a name after its first part (( DOUBLE_COLON IDENTIFIER )* [DOUBLE_COLON TAG])
    //
    // :: resolves a name, so Token::EOF and json::Reader::EOF are each one name, read here and
    // looked up once the whole program is read, as a bare name is. A tag (db::sql"...") ends
    // the name, since its string follows.
    fn qualified_name($name) {
        while (#current_token.type == "DOUBLE_COLON") {
            #eat("DOUBLE_COLON");
            $part = #current_token;
            if ($part.type != "IDENTIFIER" && $part.type != "TAG") {
                #fail("Expected a name after :: but found " .. #describe($part));
            }
            #eat($part.type);
            $name ..= "::" .. $part.value;
        }

        return $name;
    }

    // Parse a type ([QUESTION] type_name (BIT_OR type_name)*), type_name: IDENTIFIER (DOUBLE_COLON IDENTIFIER)* | NULL
    //
    // ?T is T|null, and only a single name may follow the ?: a union that allows null writes
    // null as one of its names. A name is a builtin type's (TYPE_NAMES) or a kind's, resolved
    // like any other name once the whole program is read.
    fn type() {
        $start = #current_token;
        $nullable = $start.type == "QUESTION";
        if ($nullable) {
            #eat("QUESTION");
        }
        $names = [#type_name()];
        if ($nullable && #current_token.type == "BIT_OR") {
            #fail("?T means T|null, so write {$names[0]}|...|null rather than ?{$names[0]}|...");
        }
        while (#current_token.type == "BIT_OR") {
            #eat("BIT_OR");
            $names[] = #type_name();
        }
        if ($nullable) {
            $names[] = "null";
        }

        return #make_type($names, $start);
    }

    // One name of a type: null or kind (keywords, but type names too), or a possibly
    // qualified name; list<int> is refused for now
    fn type_name() {
        $token = #current_token;
        if (in_array($token.type, #TYPE_KEYWORDS)) {
            #eat($token.type);

            return lower($token.type);
        }
        if ($token.type != "IDENTIFIER") {
            #fail("Expected a type but found " .. #describe($token));
        }
        #eat("IDENTIFIER");
        $name = #qualified_name($token.value);
        if (#current_token.type == "LESS_THAN") {
            #fail("Generic types aren't supported yet: write {$name}, not {$name}<...>");
        }

        return $name;
    }

    // The TypeAST for some names, refusing a name given twice, and recorded for resolution
    fn make_type($names, $start) {
        $seen = {};
        foreach ($names as $name) {
            if (has_key($seen, $name)) {
                #fail_at("{$name} appears twice in the type " .. join($names, "|"), #file, $start.line);
            }
            $seen[$name] = true;
        }
        $node = #at(TypeAST($names), $start);
        #type_uses[] = [$node, #scope];

        return $node;
    }

    // Whether the current token can start a type: a name, one of the keywords that are types, or ?
    fn at_type() {
        return #current_token.type == "IDENTIFIER" || #current_token.type == "QUESTION" || in_array(#current_token.type, #TYPE_KEYWORDS);
    }

    // Parse a declaration's return type, if it has one ([COLON type]); a constructor has none
    fn declared_return($constructor) {
        if (#current_token.type != "COLON") {
            return null;
        }
        if ($constructor) {
            #fail("A constructor has no return type: constructing gives the object");
        }
        #eat("COLON");

        return #type();
    }

    // Record a declaration's types on its node, only when it has any, so an untyped
    // declaration dumps as it always did
    fn with_types($node, $types, $return_type) {
        if (len(filter($types, $type -> $type != null)) > 0) {
            $node.param_types = $types;
        }
        if ($return_type != null) {
            $node.return_type = $return_type;
        }

        return $node;
    }

    // Parse a call's arguments (LPAREN [expr (COMMA expr)*] RPAREN)
    fn arguments() {
        #eat("LEFT_PAREN");

        $args = [];
        if (#current_token.type != "RIGHT_PAREN") {
            $args[] = #expr();
            while (#current_token.type == "COMMA") {
                #eat("COMMA");
                $args[] = #expr();
            }
        }
        #eat("RIGHT_PAREN");

        return $args;
    }

    // Parse a primary (INTEGER | FLOAT | STRING | interpolated_string | TRUE | FALSE | NULL | LPAREN expr RPAREN
    //                  | variable | function_call | IDENTIFIER | list_literal | map_literal | match)
    //
    // A bare IDENTIFIER not followed by ( is a function used as a value; that it names a
    // function is checked once the whole program is read, like calls.
    fn primary() {
        $token = #current_token;
        $type = $token.type;

        if ($type == "INTEGER" || $type == "FLOAT") {
            #eat($type);

            return #at(NumAST($token), $token);
        } else if ($type == "STRING") {
            #eat("STRING");

            return #at(StringAST($token), $token);
        } else if ($type == "STRING_START") {
            return #interpolated_string();
        } else if ($type == "TRUE" || $type == "FALSE") {
            #eat($type);

            return #at(BooleanAST($token), $token);
        } else if ($type == "NULL") {
            #eat("NULL");

            return #at(NullAST($token), $token);
        } else if ($type == "IDENTIFIER" || $type == "TAG") {
            #eat($type);
            $name = $type == "TAG" ? $token.value : #qualified_name($token.value);
            if (#previous_token.type == "TAG") {
                return #tagged_literal($name, $token);
            }
            if (#current_token.type == "LEFT_PAREN") {
                return #function_call($name, $token);
            }
            #refuse_spaced_tag($name, $token);
            $node = #at(FunctionRefAST($name), $token);
            #uses[] = [$node, #scope, #kind];

            return $node;
        } else if ($type == "MATCH") {
            return #match_expression(false);
        } else if ($type == "LEFT_BRACKET") {
            return #list_literal();
        } else if ($type == "LEFT_BRACE") {
            return #map_literal();
        } else if ($type == "LEFT_PAREN") {
            return #parenthesised();
        } else if ($type == "VAR_IDENTIFIER" || $type == "GLOBAL_VAR_IDENTIFIER") {
            return #variable();
        } else if ($type == "HASH" || $type == "HASH_IDENTIFIER") {
            return #this_member();
        } else if ($type == "PARENT_IDENTIFIER") {
            return #parent_method();
        } else if ($type == "PARENT") {
            #fail("## alone is not allowed: write ##name for the parent's version of a method");
        } else if ($type == "THROW") {
            // It reaches here only as an operand, since coalesce() takes it anywhere looser
            #fail("throw can't be an operand: write (throw ...)");
        } else if ($type == "SPREAD") {
            #fail("... only spreads into a list or map literal, as in [...\$a, 1] or \{...\$m, \"k\" => 1}");
        } else if (in_array($type, #RESERVED)) {
            #fail("{$token.value} is reserved");
        }

        #unexpected();
    }

    // Parse # (the object a method runs on) or #name (its member)
    //
    // Only inside a kind: in a method, a field default, or a lambda in either. Whether the
    // kind has the member is checked once the whole program is read.
    fn this_member() {
        $token = #current_token;
        if (#kind == null) {
            #fail("Cannot use {$token.value} outside a method");
        }
        if (#in_static != null && $token.type == "HASH") {
            #fail("Cannot use # in a static method: it has no object");
        }
        #eat($token.type);
        if ($token.type == "HASH" && #current_token.type == "PROPERTY") {
            #fail("Write #" .. slice(#current_token.value, 1) .. ", not #" .. #current_token.value);
        }

        $this_node = #at(ThisAST(), $token);
        if ($token.type == "HASH") {
            return $this_node;
        }

        $name = slice($token.value, 1);
        if ($name == "_") {
            #fail("Cannot use the constructor _ as a member: construct with {#kind.name}(...), or call ##_(...) in a child's constructor");
        }
        $node = #at(PropertyAST($this_node, $name), $token);
        $node.use = len(#member_uses);
        #member_uses[] = [$node, #kind, null, false, false, #in_static != null];

        return $node;
    }

    // Parse ##name (a bound method) or ##name(args) (a call), the parent kind's version of a method
    //
    // Only inside a kind, and ##_(...) only in a constructor. That the parent has the method
    // is checked once the whole program is read.
    fn parent_method() {
        $token = #current_token;
        if (#kind == null) {
            #fail("Cannot use {$token.value} outside a method");
        }
        $name = slice($token.value, 2);
        if ($name == "_" && !#in_constructor) {
            #fail("##_ can only be used in a constructor, to run the parent's");
        }
        #eat("PARENT_IDENTIFIER");

        $args = #current_token.type == "LEFT_PAREN" ? #arguments() : null;
        if ($name == "_" && $args == null) {
            #fail("Call the parent's constructor as ##_(...)");
        }
        $node = #at(ParentMethodAST($name, $args), $token);
        #parent_uses[] = [$node, #kind];

        return $node;
    }

    // Parse a parenthesised expression, or a lambda whose parameters are in parentheses
    //
    // (LPAREN [expr (COMMA expr)*] RPAREN [ARROW lambda_body]): a comma list is parsed
    // either way, so no lookahead is needed to tell ($a, $b = 1) -> ... from ($a + 1).
    // Only a ( that starts an expression at the ternary's level (see ternary()) can head a
    // lambda, so 1 + ($x) -> 2 is a syntax error like 1 + $x -> 2, and anywhere else a
    // comma is the usual error at once. When -> follows, each element must have been
    // written as $parameter or $parameter = default, not (($a)) or $a[0] = 1, with a type
    // before it if it has one.
    fn parenthesised() {
        $paren = #current_token;
        $head = #lambda_head == $paren;
        #eat("LEFT_PAREN");

        // Each item with the token it starts at, for checking it as a parameter, and its type
        $items = [];
        $comma = null;
        if (#current_token.type != "RIGHT_PAREN") {
            $items[] = #lambda_item($head);
            while (#current_token.type == "COMMA") {
                if (!$head) {
                    #unexpected();
                }
                $comma ??= #current_token;
                #eat("COMMA");
                $items[] = #lambda_item($head);
            }
        }
        $close = #current_token;
        #eat("RIGHT_PAREN");

        if (!$head || #current_token.type != "ARROW") {
            if ($comma != null) {
                #fail_at("Expected ')' but found ','", #file, $comma.line);
            }
            if ($items == []) {
                #fail_at("Unexpected ')'", #file, $close.line);
            }
            if ($items[0][2] != null) {
                // Typed parameters and then a colon: a lambda's return type, which there is
                // no room for, since ) : is a ternary's else in $c ? ($a) : $b
                if (#current_token.type == "COLON") {
                    #fail("A lambda can't declare a return type: after ) a : is a ternary's, as in \$c ? (\$a) : \$b");
                }
                #fail_at("Expected ')' but found " .. #describe($items[0][0]), #file, $items[0][0].line);
            }
            #grouped = $items[0][1];

            return $items[0][1];
        }

        $params = [];
        $defaults = [];
        $lines = [];
        $patterns = [];
        $types = [];
        foreach ($items as [$first, $item, $type]) {
            $default = null;
            if (is_a($item, AssignAST) && $item.token.type == "ASSIGN") {
                $default = $item.right;
                $item = $item.left;
            }
            if ($first.type == "LEFT_BRACKET" && (is_a($item, ArrayLiteralAST) || is_a($item, ListPatternAST))) {
                if ($type != null) {
                    #fail_at("A pattern parameter takes no type: it is already a list, and its variables are assigned by taking it apart", #file, $first.line);
                }
                // [$a, $b] or, with a default, [$a, $b] = [...], which parsed as taking a list apart
                $pattern = $item;
                if (is_a($item, ListPatternAST)) {
                    // An empty slot has no target to check
                    $pattern.targets = map($item.targets, $target -> $target == null ? null : #parameter_target($target));
                } else {
                    $pattern = #list_pattern($item, #parameter_target);
                }
                $pattern.line = $item.line;
                [$param, $statement] = #pattern_parameter($pattern, len($params));
                $patterns[] = $statement;
            } else if ($first.type == "VAR_IDENTIFIER" && #shared_name($item) != null) {
                #fail_at("Lambda parameter " .. #shared_name($item) .. " has the name of a shared variable: choose another name", #file, $first.line);
            } else if ($first.type != "VAR_IDENTIFIER" || !is_a($item, VariableAST) || $item.value != $first.value) {
                #fail_at("Lambda parameters must be \$variables or [\$variable, ...] patterns", #file, $first.line);
            } else {
                $param = $item.value;
            }
            $params[] = $param;
            $defaults[] = $default;
            $types[] = $type;
            $lines[] = $first.line;
            #check_bound($params, $patterns, "lambda", $first.line);
        }

        return #lambda($paren, $params, $defaults, $lines, $patterns, $types);
    }

    // One item of a parenthesised list, as [the token it starts at, the expression, its type or null]
    //
    // In a lambda head an item may be a typed parameter, int $x. A type reads as an expression
    // too (int|null is two bare names and a |), so it is parsed as one and taken for a type
    // when a parameter follows it, which no expression can be followed by; the names it used
    // are then taken back out of #uses, since they are not functions. A ? starts no expression,
    // so ?int is read as a type outright.
    fn lambda_item($head) {
        $type = null;
        if ($head && (#current_token.type == "QUESTION" || #current_token.type == "KIND")) {
            $type = #type();
        } else if ($head && (#current_token.type == "IDENTIFIER" || #current_token.type == "NULL")) {
            $uses = len(#uses);
            $start = #current_token;
            $expr = #expr();
            if (#current_token.type != "VAR_IDENTIFIER" && #current_token.type != "LEFT_BRACKET") {
                return [$start, $expr, null];
            }
            #uses = slice(#uses, 0, $uses);
            $type = #make_type(#type_names_of($expr, $start), $start);
        }
        $first = #current_token;

        return [$first, #expr(), $type];
    }

    // The names a type spelt as an expression is made of: bare names and null, joined by |
    fn type_names_of($expr, $start) {
        if (is_a($expr, BinOpAST) && $expr.op.type == "BIT_OR") {
            return [...#type_names_of($expr.left, $start), ...#type_names_of($expr.right, $start)];
        }
        if (is_a($expr, FunctionRefAST)) {
            return [$expr.name];
        }
        if (is_a($expr, NullAST)) {
            return ["null"];
        }

        #fail_at("Expected a type before the parameter", #file, $start.line);
    }

    // Parse a lambda's body after its parameters (ARROW (block | expr)) and build the node
    //
    // An expression body's value is returned; a block body returns only through return.
    // A block body is a function body: return is allowed, and break and continue can't
    // reach a loop around the lambda.
    //
    // What was set aside is restored after the body, not in a finally: nothing catches a
    // ParseError and carries on parsing.
    fn lambda($start, $params, $defaults, $lines, $patterns = [], $types = []) {
        $arity = #check_parameters($params, $defaults, $lines);
        #eat("ARROW");
        $bound_names = filter($params, $param -> !starts_with($param, "\$#"));
        foreach ($patterns as $statement) {
            $bound_names = [...$bound_names, ...map(filter($statement.expr.left.targets, $target -> $target != null), $target -> $target.value)];
        }
        #forget_uses($bound_names);

        // A lambda in a constructor isn't the constructor: it can return values, and can't run ##_;
        // one in a finally block can return too, and one in a typed function returns what it likes
        [$in_constructor, $in_finally, $return_type] = [#in_constructor, #in_finally, #return_type];
        [#in_constructor, #in_finally, #return_type] = [false, false, null];
        $scope = #enter_scope($params, true);
        if (#current_token.type == "LEFT_BRACE") {
            [$in_function, $loop_depth] = [#in_function, #loop_depth];
            [#in_function, #loop_depth] = [true, 0];
            $body = #block();
            [#in_function, #loop_depth] = [$in_function, $loop_depth];
        } else {
            $body = #expr();
        }
        [#in_constructor, #in_finally, #return_type] = [$in_constructor, $in_finally, $return_type];
        // Pattern parameters are taken apart first, which makes an expression body a block
        // returning it
        if ($patterns != []) {
            if (is_a($body, CompoundAST)) {
                $body.statements = [...$patterns, ...$body.statements];
            } else {
                $block = #at(CompoundAST(), $start);
                $block.statements = [...$patterns, #at(ReturnStatementAST($body), $start)];
                $block.statements[len($block.statements) - 1].line = $body.line;
                $body = $block;
            }
        }

        // The outer variables it uses, except those a plain = (or foreach or catch) makes local to each call
        $variables = VariableCollector();
        foreach ($defaults as $default) {
            if ($default != null) {
                $variables.collect($default);
            }
        }
        $variables.collect($body);
        $captures = [];
        foreach ($variables.found as $name => $_) {
            if (!in_array($name, $params) && !has_key($variables.assigned, $name)) {
                $captures[] = $name;
            }
        }

        // What it captured, it used: naming one as shared later, where it was already used, is refused
        #leave_scope($scope);
        foreach ($captures as $name) {
            if (!starts_with($name, "\$#")) {
                #plain[$name] = (#plain[$name] ?? 0) + 1;
            }
        }

        $lambda = #at(LambdaAST($params, $defaults, $arity, $body, $captures), $start);
        $lambda.owner = #kind?.name;
        #with_types($lambda, $types, null);
        if (($lambda.param_types ?? null) != null) {
            #typed_lambdas[] = $lambda;
        }

        return $lambda;
    }

    // Check a lambda's parameter list, with the same rules as a function's, and work out its arity
    fn check_parameters($params, $defaults, $lines) {
        $seen = {};
        $required = 0;
        foreach ($params as $i => $param) {
            if (has_key($seen, $param)) {
                #fail_at("Duplicate parameter {$param} in lambda", #file, $lines[$i]);
            }
            $seen[$param] = true;
            if ($defaults[$i] == null) {
                if ($required < $i) {
                    #fail_at("Required parameter {$param} can't follow a parameter with a default", #file, $lines[$i]);
                }
                $required++;
            }
        }

        return #arity($params, $defaults);
    }

    // A parameter list's arity: a count, or [fewest, most] when there are defaults
    fn arity($params, $defaults) {
        $required = 0;
        foreach ($defaults as $default) {
            if ($default == null) {
                $required++;
            }
        }

        return $required == len($params) ? $required : [$required, len($params)];
    }

    // Parse an interpolated string (STRING_START expr (STRING_MIDDLE expr)* STRING_END)
    //
    // Desugared into concatenation: "Hi {$name}!" is "Hi " .. $name .. "!", which
    // converts values the way echo does; the backends need nothing new.
    fn interpolated_string() {
        $start = #current_token;
        #eat("STRING_START");
        $node = #at(StringAST($start), $start);

        while (true) {
            $value = #interpolated_value();
            if (#in_constant && is_a($value, VariableAST)) {
                // Said here, where it is known the string did it: check_constant_expression() only sees a variable
                $escape = $value.is_global() ? '\\{ for a brace' : '\\$ for a dollar sign';
                #fail_at("A constant can't interpolate {$value.value} into a string (write {$escape})", $value.file, $value.line);
            }

            $part = #current_token;
            if ($part.type != "STRING_MIDDLE" && $part.type != "STRING_END") {
                #fail("Expected '}' but found " .. #describe($part));
            }
            #eat($part.type);

            $concat = Token("CONCAT", "..");
            $concat.line = $part.line;
            $node = #at(BinOpAST($node, $concat, $value), $concat);
            if ($part.value != "") {
                $node = #at(BinOpAST($node, $concat, #at(StringAST($part), $part)), $concat);
            }

            if ($part.type == "STRING_END") {
                return $node;
            }
        }
    }

    /*
     * One interpolated expression. An IDENTIFIER can only start one as the name of "{NAME}",
     * since everything else in braces starts with a sigil: that name must turn out to be a
     * constant's, which is checked with every other name once the whole program is read.
     */
    fn interpolated_value() {
        $braced = #current_token.type == "IDENTIFIER";
        $value = #expr();
        if ($braced) {
            $value.braced = true;
        }

        return $value;
    }

    /*
     * Parse a tagged string (TAG (STRING | STRING_START expr (STRING_MIDDLE expr)* STRING_END)),
     * the tag's name having been read, $at being its first token
     *
     * Sugar for a call: name"a {$x} b" is name(["a ", " b"], [$x]), the text parts with their
     * escapes read, one more of them than there are values, empty ones kept, and the values as
     * they are, never made text. It is an ordinary FunctionCallAST, so the name is resolved and
     * checked as any call's; #tagged only lets an error about it say so.
     */
    fn tagged_literal($name, $at) {
        $start = #current_token;
        $parts = [#string_part_entry($start)];
        $values = [];
        #eat($start.type);
        $part = $start;
        while ($part.type == "STRING_START" || $part.type == "STRING_MIDDLE") {
            $values[] = [null, #interpolated_value()];
            $part = #current_token;
            if ($part.type != "STRING_MIDDLE" && $part.type != "STRING_END") {
                #fail("Expected '}' but found " .. #describe($part));
            }
            #eat($part.type);
            $parts[] = #string_part_entry($part);
        }

        $args = [#at(ArrayLiteralAST($parts), $start), #at(ArrayLiteralAST($values), $start)];
        $node = #function_call_node($name, $args, $at);
        $node.tagged = true;

        return $node;
    }

    // One text part of a tagged string, as an entry of the list literal holding them
    fn string_part_entry($token) {
        return [null, #at(StringAST($token), $token)];
    }

    /*
     * A name followed by a string, which only a tag can be: refused saying so. What a tag can't
     * be keeps the usual error, which explains it better: see cannot_be_a_tag().
     */
    fn refuse_spaced_tag($name, $token) {
        $next = #current_token.type;
        $string_follows = $next == "STRING" || $next == "STRING_START";
        if (!$string_follows || #cannot_be_a_tag($name)) {
            return;
        }
        #fail_at("A tag touches its string: write {$name}\"...\", with no space", #file, $token.line);
    }

    /*
     * Whether a name followed by a string is a different mistake: a miscapitalised keyword
     * (ECHO "x", which has its own hint), PHP's elseif, a builtin that can't take a tag's two
     * arguments (print "hello" is a missing parenthesis, and tagging it would fail on arity), or
     * a constant already declared (a missing comma in a list).
     */
    fn cannot_be_a_tag($name) {
        if (has_key(Lexer::KEYWORDS, lower($name)) || lower($name) == "elseif") {
            return true;
        }
        if (has_key(#constants, $name)) {
            return true;
        }

        return has_key(#builtins, $name) && !#takes_two_arguments(#builtins[$name]);
    }

    // Whether a builtin's arity, a count or [fewest, most], admits the two arguments of a tag
    fn takes_two_arguments($arity) {
        [$fewest, $most] = type_of($arity) == "list" ? $arity : [$arity, $arity];

        return $fewest <= 2 && 2 <= $most;
    }

    // Parse a list literal (LBRACKET [expr (COMMA expr)* [COMMA]] RBRACKET)
    fn list_literal() {
        $start = #current_token;
        #eat("LEFT_BRACKET");

        $entries = [];
        $gap = false;
        while (#current_token.type != "RIGHT_BRACKET") {
            if (#current_token.type == "COMMA") {
                // An empty slot: [$a, , $b] takes an element it has no target for
                $entries[] = [null, null];
                $gap = true;
                #eat("COMMA");
                continue;
            }
            if (#current_token.type == "SPREAD") {
                // ...$a puts the elements of the list $a here
                $spread = #current_token;
                #eat("SPREAD");
                if (#current_token.type == "COMMA" || #current_token.type == "RIGHT_BRACKET") {
                    #fail("Nothing after ...: write the list to spread, or in a pattern the target that takes the rest");
                }
                $entries[] = [null, #at(SpreadAST(#expr()), $spread)];
            } else {
                $entries[] = [null, #expr()];
            }
            if (#current_token.type == "DOUBLE_ARROW") {
                #fail("A list has no keys: write a map as \{key => value}");
            }

            // A trailing comma is allowed, so multi-line literals diff cleanly
            if (#current_token.type != "RIGHT_BRACKET") {
                #eat("COMMA");
            }
        }
        #eat("RIGHT_BRACKET");
        $node = #at(ArrayLiteralAST($entries), $start);
        if ($gap) {
            #gaps[] = $node;
        }

        return $node;
    }

    // Parse a map literal (LBRACE [entry (COMMA entry)* [COMMA]] RBRACE),
    // entry: expr DOUBLE_ARROW expr | SPREAD expr
    //
    // Only where an expression is expected: a { that starts a statement is a block, and one
    // right after -> is a lambda's block body, so a lambda returning a map writes ({...}).
    fn map_literal() {
        $start = #current_token;
        #eat("LEFT_BRACE");

        $entries = [];
        while (#current_token.type != "RIGHT_BRACE") {
            if (#current_token.type == "SPREAD") {
                // ...$m sets every key of the map $m here, later entries winning, as a
                // duplicate key does; it has no key of its own, as a list's entries don't
                $spread = #current_token;
                #eat("SPREAD");
                $entries[] = [null, #at(SpreadAST(#expr()), $spread)];
            } else {
                $key = #expr();
                #eat("DOUBLE_ARROW");
                $entries[] = [$key, #expr()];
            }

            if (#current_token.type != "RIGHT_BRACE") {
                #eat("COMMA");
            }
        }
        #eat("RIGHT_BRACE");

        return #at(ArrayLiteralAST($entries, true), $start);
    }

    /*
     * Parse a postfix expression
     * (primary (LBRACKET [expr] RBRACKET | arguments | PROPERTY | NULLSAFE_PROPERTY)* [INCREMENT | DECREMENT])
     *
     * Empty brackets ($a[] = ...) append, so they are only allowed directly before an assignment.
     * A chain with a ?. in it is wrapped whole in a NullsafeChainAST, which nothing can write to.
     */
    fn postfix() {
        $node = #primary();
        $nullsafe = false;

        while (in_array(#current_token.type, ["LEFT_BRACKET", "LEFT_PAREN", "PROPERTY", "NULLSAFE_PROPERTY", "DOUBLE_COLON"])) {
            if (#current_token.type == "PROPERTY" || #current_token.type == "NULLSAFE_PROPERTY") {
                // $user.name: which members the object has is only known when it runs
                $token = #current_token;
                #eat($token.type);
                $named = is_a($node, FunctionRefAST);
                if ($token.type == "NULLSAFE_PROPERTY") {
                    $nullsafe = true;
                    $node = #at(NullsafePropertyAST($node, slice($token.value, 2)), $token);
                } else {
                    $node = #at(PropertyAST($node, slice($token.value, 1)), $token);
                }
                if ($named) {
                    // Token.EOF: a dot on a name, which is an error if Token turns out to be
                    // a kind, since a kind is reached by name, with ::
                    #dot_on_names[] = $node;
                }

                continue;
            }
            if (#current_token.type == "DOUBLE_COLON") {
                // A name read in primary() took its whole :: chain, so what is left here has
                // a value on the left of an operator that resolves a name
                #fail(":: resolves a name, so only a name can be on its left");
            }
            if (#current_token.type == "LEFT_PAREN") {
                if (is_a($node, PropertyAST)) {
                    // #save($x): calling a member, located at its name like reading it
                    $call = MethodCallAST($node, #arguments());
                    [$call.line, $call.file] = [$node.line, $node.file];
                    if ($node.use != null) {
                        #member_uses[$node.use][2] = len($call.args);
                        #member_calls[] = $call;
                    }
                    $node = $call;

                    continue;
                }
                // A call on a value: $f(1), $h["save"]($doc), pick()(2), (add)(1), located at its (
                $paren = #current_token;
                $node = #at(CallValueAST($node, #arguments()), $paren);

                continue;
            }
            $bracket = #current_token;
            #eat("LEFT_BRACKET");
            if (#current_token.type == "RIGHT_BRACKET") {
                #eat("RIGHT_BRACKET");
                if (!in_array(#current_token.type, #ASSIGNMENTS)) {
                    #fail("[] can only be used to append in an assignment");
                }

                return #nullsafe_chain(#at(IndexAST($node, null), $bracket), $nullsafe);
            }
            $node = #at(IndexAST($node, #expr()), $bracket);
            #eat("RIGHT_BRACKET");
        }

        $node = #nullsafe_chain($node, $nullsafe);
        $token = #current_token;
        if ($token.type == "INCREMENT" || $token.type == "DECREMENT") {
            #eat($token.type);

            return #at(IncrementAST(#assignable($node, $token), $token, false), $token);
        }

        return $node;
    }

    // A chain with a ?. in it as one node, located where it starts to be read
    fn nullsafe_chain($node, $nullsafe) {
        if (!$nullsafe) {
            return $node;
        }
        $chain = NullsafeChainAST($node);
        [$chain.line, $chain.file] = [$node.line, $node.file];

        return $chain;
    }

    // Parse a unary expression ((MINUS | NOT | BIT_NOT) unary | power)
    fn unary() {
        $token = #current_token;

        if (in_array($token.type, ["MINUS", "NOT", "BIT_NOT"])) {
            #eat($token.type);

            return #at(UnaryOpAST($token, #unary()), $token);
        }

        return #power();
    }

    /*
     * Parse a power (((INCREMENT | DECREMENT) postfix | postfix) [POWER unary])
     *
     * Tighter than a unary operator on its left and looser than one on its right, as in Python:
     * -2 ** 2 is -(2 ** 2), and 2 ** -1 needs no parentheses. The right side being a unary,
     * which reaches back here, makes it right associative: 2 ** 3 ** 2 is 2 ** 9.
     */
    fn power() {
        $token = #current_token;
        if ($token.type == "INCREMENT" || $token.type == "DECREMENT") {
            #eat($token.type);
            $node = #at(IncrementAST(#assignable(#postfix(), $token), $token, true), $token);
        } else {
            $node = #postfix();
        }

        $token = #current_token;
        if ($token.type == "POWER") {
            #eat("POWER");

            return #at(BinOpAST($node, $token, #unary()), $token);
        }

        return $node;
    }

    // Parse a binary expression whose operators all bind at least as tightly as $level
    // (unary (OP binary)*), every level being left associative
    //
    // A method for each level, each calling the next tighter one through left_associative(),
    // would take 24 calls to reach a primary through 11 levels that mostly find no
    // operator. This climbs instead: read an operand, and while the next token is an operator
    // of this level or tighter, its right side is whatever binds tighter than it. The tree is
    // the same. On the old PHP VM, parsing alone (not lexing) was 28% faster: football.gaz
    // 0.196s to 0.140s. #BINARY_LEVELS is the tower.
    fn binary($level) {
        $node = #unary();

        while (true) {
            $token = #current_token;
            $found = #BINARY_LEVELS[$token.type] ?? 0;
            if ($found < $level) {
                return $node;
            }
            #eat($token.type);
            if ($token.type == "PIPE") {
                $node = #pipe($node, $token, $found + 1);
            } else {
                $node = #at(BinOpAST($node, $token, #binary($found + 1)), $token);
            }
        }
    }

    /*
     * Parse what follows |> and give the call it stands for, the value on its left being the
     * first argument: $x |> f(a) is f($x, a), $x |> f is f($x), $x |> $g(a) is $g($x, a), and a
     * parenthesised expression is called with the value, $x |> ($v -> $v * 2). Sugar only: the
     * result is an ordinary FunctionCallAST or CallValueAST, checked and compiled as one.
     *
     * The right side is read at the next tighter level, as any operand is, and must then be one
     * of those shapes. A lambda must be parenthesised, since its body would run on over the rest
     * of the chain, and a method can't follow |> yet (the restrictive choice).
     */
    fn pipe($value, $token, $level) {
        $uses = len(#uses);
        $target = #binary($level);
        if (#current_token.type == "ARROW") {
            #fail("A lambda after |> must be in parentheses: |> (\$v -> ...)");
        }
        if ($target == #grouped) {
            return #relocated(CallValueAST($target, [$value]), $target);
        }
        if (is_a($target, FunctionRefAST)) {
            // A name read as a value is a call by name: its use is checked as a call instead
            #uses = slice(#uses, 0, $uses);
            $call = #relocated(FunctionCallAST($target.name, [$value]), $target);
            #uses[] = [$call, #scope, #kind];

            return $call;
        }
        if (is_a($target, FunctionCallAST) && ($target.tagged ?? false)) {
            #fail_at("A tagged string can't follow |>: it is already a call", #file, $token.line);
        }
        if (is_a($target, FunctionCallAST) || is_a($target, CallValueAST)) {
            $target.args = [$value, ...$target.args];

            return $target;
        }
        if (is_a($target, VariableAST)) {
            return #relocated(CallValueAST($target, [$value]), $target);
        }
        if (is_a($target, MethodCallAST) || is_a($target, PropertyAST) || is_a($target, ParentMethodAST)) {
            #fail_at("A method can't follow |> yet: pass the value to it as an argument", #file, $token.line);
        }
        if (is_a($target, BinOpAST)) {
            $op = $target.op.value;
            #fail_at("|> binds looser than {$op}: write (\$x |> f) {$op} \$y, or parenthesise what follows |>", #file, $token.line);
        }
        #fail_at("|> is followed by a function, a call or a parenthesised expression", #file, $token.line);
    }

    // A node the parser made in place of another, located where that one is
    fn relocated($node, $from) {
        [$node.line, $node.file] = [$from.line, $from.file];

        return $node;
    }

    // Parse a logical or expression, the loosest binary level
    fn logical_or() {
        return #binary(1);
    }

    // Parse a null coalescing expression (throw_expression | logical_or [?? coalesce]), right associative
    //
    // A throw starts here, so it can begin any expression down to this level: a statement,
    // either branch of a ternary, a match arm, a lambda body, and the right side of ??, which
    // is what $x ?? throw NotFound($key) needs. Below this level it would be an operand
    // (1 + throw ...), which is refused unless parenthesised.
    fn coalesce() {
        if (#current_token.type == "THROW") {
            return #throw_expression();
        }
        $node = #logical_or();

        $token = #current_token;
        if ($token.type == "COALESCE") {
            #eat("COALESCE");

            return #at(BinOpAST($node, $token, #coalesce()), $token);
        }

        return $node;
    }

    // Parse a throw (THROW expr), which raises the value and so never gives one
    //
    // Its operand is a whole expression and extends as far right as it can, as a lambda's body
    // does: throw $a ?? $b throws whichever is there. Nothing after throw is an error: a
    // rethrow names what it throws (throw $e).
    fn throw_expression() {
        $token = #current_token;
        #eat("THROW");
        if (#current_token.type == "SEMICOLON") {
            #fail("throw needs a value: a catch rethrows with throw \$e");
        }

        return #at(ThrowAST(#expr()), $token);
    }

    // Parse a ternary (coalesce [? expr : ternary]), or a lambda with one bare parameter (VAR_IDENTIFIER ARROW lambda_body)
    //
    // Right associative, as in C and JS: $a ? 1 : $b ? 2 : 3 is $a ? 1 : ($b ? 2 : 3). The
    // middle is a full expression, so it can hold an assignment or another ternary.
    //
    // A lambda's body is an expression, so it extends as far right as it can: $x -> $x * 2
    // == 4 is $x -> ($x * 2 == 4), and $x -> $y -> $x + $y nests. Recognising $x -> here
    // (and the parenthesised form in parenthesised()) puts lambdas at the same level as the
    // ternary, so 1 + $x -> 2 is a syntax error.
    fn ternary() {
        $start = #current_token;
        if ($start.type == "LEFT_PAREN") {
            #lambda_head = $start;
        }
        $node = #coalesce();

        $token = #current_token;
        if ($token.type == "ARROW" && $start.type == "VAR_IDENTIFIER" && #shared_name($node) != null) {
            #fail_at("Lambda parameter " .. #shared_name($node) .. " has the name of a shared variable: choose another name", #file, $start.line);
        }
        if ($token.type == "ARROW" && is_a($node, VariableAST) && !$node.is_global() && $start.type == "VAR_IDENTIFIER") {
            return #lambda($start, [$node.value], [null], [$start.line]);
        }
        if ($token.type == "ARROW" && $start.type == "LEFT_BRACKET" && is_a($node, ArrayLiteralAST) && !$node.map) {
            // [$a, $b] -> ...: the parentheses would say nothing more, so they aren't needed
            $pattern = #list_pattern($node, #parameter_target);
            [$param, $statement] = #pattern_parameter($pattern, 0);
            #check_bound([$param], [$statement], "lambda", $start.line);

            return #lambda($start, [$param], [null], [$start.line], [$statement]);
        }
        if ($token.type == "QUESTION") {
            #eat("QUESTION");
            $then = #expr();
            #eat("COLON");

            return #at(TernaryAST($node, $then, #ternary()), $token);
        }

        return $node;
    }

    // Parse an expression, the lowest precedence level ((variable | index) (= | += | -= | *= | /= | %= | ..= | ??=) expr | ternary)
    //
    // Assignment is right associative, so $a = $b = 1 assigns 1 to both.
    fn expr() {
        $node = #ternary();

        $token = #current_token;
        if (!in_array($token.type, #ASSIGNMENTS)) {
            return $node;
        }
        if (is_a($node, ArrayLiteralAST) && !$node.map) {
            if ($token.type != "ASSIGN") {
                #fail("Cannot use {$token.value} to take a list apart: only = can");
            }
            $pattern = #list_pattern($node, $target -> #assignable($target, $token));
            #eat("ASSIGN");

            return #at(AssignAST($pattern, $token, #expr()), $token);
        }

        $node = #assignable($node, $token);
        // Appending ($a[] = ...) is a plain assignment: there is no current element to combine with
        if ($token.type != "ASSIGN" && is_a($node, IndexAST) && $node.index == null) {
            #fail("Cannot use {$token.value} to append");
        }
        #eat($token.type);
        $right = #expr();
        // $f = <lambda>: inside the lambda, $f is the lambda itself, so it can call itself
        if ($token.type == "ASSIGN" && is_a($node, VariableAST) && !$node.is_global()
            && is_a($right, LambdaAST) && in_array($node.value, $right.captures)) {
            $right.self = $node.value;
        }

        return #at(AssignAST($node, $token, $right), $token);
    }

    // Turn a list literal written where a pattern goes ([$a, $b] = ..., foreach (... as [$a, $b])) into a pattern
    //
    // $target checks each element can be a target, failing if not
    fn list_pattern($literal, $target) {
        if ($literal.entries == [] || len(filter($literal.entries, $entry -> $entry[1] != null)) == 0) {
            #fail_at("Nothing to take apart: write at least one target in [...]", #file, $literal.line);
        }
        #gaps = filter(#gaps, $gapped -> $gapped != $literal);
        $targets = [];
        $rest = null;
        foreach ($literal.entries as $i => [, $entry]) {
            if (is_a($entry, SpreadAST)) {
                if ($rest != null) {
                    #fail_at("A pattern takes one rest: with two ..., nothing says where the first ends", $entry.file, $entry.line);
                }
                $rest = $i;
                $entry = $entry.expr;
            }
            // An empty slot has no target: the element is there, and nothing is done with it
            $targets[] = $entry == null ? null : $target($entry);
        }
        $pattern = ListPatternAST($targets);
        [$pattern.line, $pattern.file] = [$literal.line, $literal.file];
        if ($rest != null) {
            $pattern.rest = $rest;
        }

        return $pattern;
    }

    // Check a node can be assigned to: a variable, or a path of elements and fields starting at a variable or #
    //
    // $a, $a[0], $rows[0].total, #count, #items[] and $user.tags[0] can be, and so can a path
    // from a call through a field ($team.keeper().saves); # itself, a path starting anywhere
    // else, and a call's elements (make()[0]) can't. $operator is the assignment or ++/-- token.
    fn assignable($node, $operator) {
        if (is_a($node, NullsafeChainAST)) {
            #fail("Cannot use {$operator.value} on a ?. chain: when it finds null there is nothing to write to");
        }
        $root = path_root($node);
        if (is_a($root, FunctionRefAST)) {
            #static_writes[] = [$root, $operator];
        }
        if (is_a($node, VariableAST) || is_a($node, FunctionRefAST) && contains($node.name, "::")
            || ((is_a($node, IndexAST) || is_a($node, PropertyAST)) && $root != null)
            || writes_through_call($node)) {
            if (is_a($node, PropertyAST) && $node.use != null) {
                #member_uses[$node.use][3] = true;
            }
            #written($node);
            #note_index_write($node);

            return $node;
        }

        #fail("Can only use {$operator.value} on a variable, or an element or field of one");
    }

    // Note that a path is written to, on the #name it starts at, if it starts at one: #TABLE[0] = 1 writes under #TABLE
    //
    // A constant can't be written under, which is checked once the kinds are resolved. A
    // field can, and so can a method as far as the parser knows: what it holds when it runs
    // decides that.
    fn written($target) {
        while ((is_a($target, IndexAST) || is_a($target, PropertyAST)) && !is_a($target.target, ThisAST)) {
            $target = $target.target;
        }
        if (is_a($target, PropertyAST) && $target.use != null) {
            #member_uses[$target.use][4] = true;
        }
    }

    // Parse an if statement (IF LPAREN expr RPAREN block [ELSE IF ...]* [ELSE block])
    fn if_statement() {
        $start = #current_token;
        #eat("IF");
        #eat("LEFT_PAREN");
        $condition = #expr();
        #eat("RIGHT_PAREN");
        $if_body = #block();

        $else_if = null;
        $else_body = null;
        if (#current_token.type == "ELSE") {
            #eat("ELSE");
            if (#current_token.type == "IF") {
                // An else if is a nested if statement
                $else_if = #if_statement();
            } else {
                $else_body = #block();
            }
        }

        return #at(IfStatementAST($condition, $if_body, $else_if, $else_body), $start);
    }

    // Parse a match (MATCH [LPAREN expr RPAREN] LBRACE arm (COMMA arm)* [COMMA] RBRACE)
    //
    // An arm is one or more comma separated expressions, or DEFAULT, then => then its body.
    // A comma separates arms; it is optional after the last one and after a block arm, which
    // ends in a } of its own, as in Rust.
    //
    // The subject is optional: with one, an arm's values are compared to it with ==; without,
    // they are conditions, tested for truth as if does, so several to an arm read as "or".
    //
    // Only a match written as a statement may have block arms, so in one a { after => is a
    // block and a map is written ({...}), the same rule as a lambda body; in an expression a
    // { after => is a map literal. The default arm must be last, since anything after it is
    // dead, the way an untyped catch must be last.
    fn match_expression($statement) {
        $start = #current_token;
        #eat("MATCH");
        $subject = null;
        if (#current_token.type == "LEFT_PAREN") {
            #eat("LEFT_PAREN");
            $subject = #expr();
            #eat("RIGHT_PAREN");
        }
        #eat("LEFT_BRACE");

        $arms = [];
        $default = false;
        while (#current_token.type != "RIGHT_BRACE") {
            if ($default) {
                #fail("default must be the last arm of a match");
            }

            $values = null;
            if (#current_token.type == "DEFAULT") {
                #eat("DEFAULT");
                $default = true;
            } else {
                $values = [#expr()];
                while (#current_token.type == "COMMA") {
                    #eat("COMMA");
                    $values[] = #expr();
                }
            }
            #eat("DOUBLE_ARROW");

            $block = $statement && #current_token.type == "LEFT_BRACE";
            $arms[] = [$values, $block ? #block() : #expr(), $block];

            if (#current_token.type == "COMMA") {
                #eat("COMMA");
            } else if (!$block && #current_token.type != "RIGHT_BRACE") {
                // Not the last arm and not brace terminated, so a comma is missing
                #eat("COMMA");
            }
        }
        #eat("RIGHT_BRACE");

        if ($arms == []) {
            #fail_at("A match needs at least one arm", #file, $start.line);
        }

        return #at(MatchAST($subject, $arms), $start);
    }

    // Parse a block (LBRACE statement* RBRACE)
    fn block() {
        #eat("LEFT_BRACE");

        $block = CompoundAST();
        while (#current_token.type != "RIGHT_BRACE") {
            $block.statements[] = #statement();
        }
        #eat("RIGHT_BRACE");

        return $block;
    }

    // Parse a while statement (WHILE LPAREN expr RPAREN block)
    fn while_statement() {
        $start = #current_token;
        #eat("WHILE");
        #eat("LEFT_PAREN");
        $condition = #expr();
        #eat("RIGHT_PAREN");

        return #at(WhileStatementAST($condition, #loop_body()), $start);
    }

    // Parse a for statement (FOR LPAREN expr SEMICOLON expr SEMICOLON expr RPAREN block)
    //
    // Desugared into { init; while (condition) { body } } with step set on the
    // while node, so the backends only need to know about while loops.
    fn for_statement() {
        $start = #current_token;
        #eat("FOR");
        #eat("LEFT_PAREN");
        $init = #expr();
        #eat("SEMICOLON");
        $condition = #expr();
        #eat("SEMICOLON");
        $step = #expr();
        #eat("RIGHT_PAREN");

        $loop = #at(CompoundAST(), $start);
        $loop.statements = [
            #at(StatementAST($init), $start),
            #at(WhileStatementAST($condition, #loop_body(), #at(StatementAST($step), $start)), $start),
        ];

        return $loop;
    }

    // Parse a foreach statement (FOREACH LPAREN expr AS variable [DOUBLE_ARROW variable] RPAREN block)
    fn foreach_statement() {
        $start = #current_token;
        #eat("FOREACH");
        #eat("LEFT_PAREN");
        $iterable = #expr();
        #eat("AS");

        $key = null;
        $value = #foreach_target();
        if (#current_token.type == "DOUBLE_ARROW") {
            if (!is_a($value, VariableAST)) {
                #fail("A foreach key is a variable, not a pattern");
            }
            #eat("DOUBLE_ARROW");
            $key = $value;
            $value = #foreach_target();
        }
        #eat("RIGHT_PAREN");

        return #at(ForeachStatementAST($iterable, $key, $value, #loop_body()), $start);
    }

    // Parse what foreach assigns each value to (variable | LBRACKET variable (COMMA variable)* [COMMA] RBRACKET)
    //
    // A pattern's targets are variables only, like foreach's own.
    fn foreach_target() {
        if (#current_token.type != "LEFT_BRACKET") {
            if (#current_token.type == "VAR_IDENTIFIER" && has_key(#shared, #current_token.value)) {
                #fail("{#current_token.value} is shared, so it can't be a foreach variable: assign it in the loop's body");
            }

            return #variable();
        }

        return #list_pattern(#list_literal(), $target -> {
            if (#shared_name($target) != null) {
                #fail_at(#shared_name($target) .. " is shared, so it can't be a foreach variable: assign it in the loop's body", $target.file, $target.line);
            }
            if (!is_a($target, VariableAST)) {
                #fail_at("A foreach pattern takes variables only", $target.file, $target.line);
            }

            return $target;
        });
    }

    // Parse a try statement (TRY block (CATCH LPAREN [IDENTIFIER] variable RPAREN block)* [FINALLY block]), with a catch or a finally or both
    //
    // A catch naming a kind catches objects of that kind or its children; one without a
    // kind catches anything, so it must be the last. That the names are kinds is checked
    // once the whole program is read.
    //
    // return, break and continue can't leave a finally block, so it never replaces a return
    // or swallows an error; a loop or lambda inside it can use them for itself.
    fn try_statement() {
        $start = #current_token;
        #eat("TRY");
        $body = #block();

        $catches = [];
        // Which of them name a kind, so the name can be resolved once the program is read
        $named = [];
        while (#current_token.type == "CATCH") {
            if ($catches != [] && last($catches)[0] == null) {
                #fail("A catch without a kind catches every error, so it must be the last");
            }
            #catches = true;
            #eat("CATCH");
            #eat("LEFT_PAREN");
            $kind = null;
            $kind_token = #current_token;
            if (#current_token.type == "IDENTIFIER") {
                $kind = #current_token.value;
                #eat("IDENTIFIER");
                $kind = #qualified_name($kind);
            }
            if (#current_token.type == "VAR_IDENTIFIER" && has_key(#shared, #current_token.value)) {
                #fail("{#current_token.value} is shared, so it can't be a catch variable: assign it in the block");
            }
            $variable = #variable();
            #eat("RIGHT_PAREN");
            $catches[] = [$kind, $variable, #block()];
            if ($kind != null) {
                $named[] = [len($catches) - 1, $kind_token.line];
            }
        }

        $finally = null;
        if ($catches == [] && #current_token.type != "FINALLY") {
            #fail("Expected 'catch' or 'finally' but found " .. #describe(#current_token));
        }
        if (#current_token.type == "FINALLY") {
            #eat("FINALLY");
            [$in_finally, $loop_depth] = [#in_finally, #loop_depth];
            [#in_finally, #loop_depth] = [true, 0];
            $finally = #block();
            [#in_finally, #loop_depth] = [$in_finally, $loop_depth];
        }

        $node = #at(TryStatementAST($body, $catches, $finally), $start);
        foreach ($named as [$index, $line]) {
            #catch_types[] = [$node, $index, $line, #file, #scope];
        }

        return $node;
    }

    // Parse a loop body, a block in which break and continue are allowed
    fn loop_body() {
        #loop_depth++;
        $body = #block();
        #loop_depth--;

        return $body;
    }

    // Parse a break or continue statement ((BREAK | CONTINUE) SEMICOLON)
    fn loop_control() {
        $token = #current_token;
        if (#loop_depth == 0) {
            #fail(#in_finally ? "Cannot use {$token.value} in finally" : "Cannot use {$token.value} outside of a loop");
        }

        #eat($token.type);
        #eat("SEMICOLON");

        return #at(LoopControlAST($token), $token);
    }

    // Parse a return statement (RETURN [expr] SEMICOLON)
    fn return_statement() {
        if (#in_finally) {
            #fail("Cannot use return in finally");
        }
        if (!#in_function) {
            #fail("Cannot use return outside of a function");
        }

        $start = #current_token;
        #eat("RETURN");
        if (#in_constructor && #current_token.type != "SEMICOLON") {
            #fail("A constructor can't return a value: constructing gives the object");
        }
        // A bare return gives null, which a return type that excludes null would refuse every time
        if (#current_token.type == "SEMICOLON" && #return_type != null && !#return_type.allows_null()) {
            #fail("return needs a value in a function that returns " .. #return_type.text());
        }
        $expr = #current_token.type == "SEMICOLON" ? null : #expr();
        #eat("SEMICOLON");
        if ($expr != null && #return_type != null) {
            #typed_returns[] = [$expr, #return_type, #return_label];
        }

        return #at(ReturnStatementAST($expr), $start);
    }

    // Parse a delete statement (DELETE postfix SEMICOLON), which removes an element of a list or map
    //
    // The target is written like an assignment's, a variable or # followed by steps, and
    // must end in an index: a list's element, which the later ones move down to fill, or a
    // map's key. Fields are declared, so a field is a parse error, and so is an append.
    fn delete_statement() {
        $start = #current_token;
        #eat("DELETE");
        $target = #postfix();
        #eat("SEMICOLON");

        if (is_a($target, NullsafeChainAST)) {
            #fail_at("Cannot delete through ?.: when it finds null there is nothing to delete", #file, $start.line);
        }
        if (is_a($target, PropertyAST)) {
            #fail_at("Cannot delete a field: every object of a kind has the fields it declares", #file, $start.line);
        }
        if (!is_a($target, IndexAST) || $target.index == null
            || path_root($target) == null && !writes_through_call($target)) {
            #fail_at("delete needs an element of a list or map, like delete \$a[0]", #file, $start.line);
        }

        #written($target);

        return #at(DeleteStatementAST($target), $start);
    }

    // Parse a function declaration (FN IDENTIFIER LPAREN [param (COMMA param)*] RPAREN block),
    // param: VAR_IDENTIFIER [ASSIGN expr]
    //
    // Only allowed at the top level, which is also why break and continue can
    // never reach a caller's loop: a declaration is never inside a loop.
    fn function_declaration($pub) {
        $start = #current_token;
        #eat("FN");
        #check_new_name();
        $name = #qualify(#current_token.value);
        #eat("IDENTIFIER");

        [$params, $defaults, $promoted, $patterns, $types] = #parameters("function {$name}");
        $returns = #declared_return(false);
        // Declared before the body is parsed, so the function can call itself
        $arity = #arity($params, $defaults);
        #functions[$name] = $arity;
        #declare($name, $pub);

        [#in_function, #return_type, #return_label] = [true, $returns, "{$name}()"];
        $scope = #enter_scope($params, false);
        $body = #block();
        #leave_scope($scope);
        [#in_function, #return_type] = [false, null];
        $body.statements = [...$patterns, ...$body.statements];
        #signatures[$name] = #with_types(#at(FunctionDeclarationAST($name, $params, $defaults, $body, $arity), $start), $types, $returns);

        return #signatures[$name];
    }

    // Check the name being declared isn't taken: functions, kinds, interfaces, constants and
    // builtins share one namespace
    //
    // Asked before the name is eaten, so the error is at the name. Anything that isn't a
    // name is left for eat() to refuse.
    fn check_new_name() {
        if (#current_token.type != "IDENTIFIER") {
            return;
        }
        $name = #qualify(#current_token.value);
        if (has_key(#builtins, $name)) {
            #fail("{$name} is a builtin function");
        } else if (has_key(#kinds, $name) && #kinds[$name].file == #BUILTIN_FILE) {
            #fail("{$name} is a builtin kind");
        } else if (has_key(#functions, $name)) {
            #fail("Function {$name} is already declared");
        } else if (has_key(#kinds, $name)) {
            #fail("Kind {$name} is already declared");
        } else if (has_key(#interfaces, $name)) {
            #fail("Interface {$name} is already declared");
        } else if (has_key(#constants, $name)) {
            #fail("Constant {$name} is already declared");
        }
    }

    // Parse a function or method's parameter list (LPAREN [param (COMMA param)*] RPAREN),
    // param: [type] VAR_IDENTIFIER [ASSIGN expr] | [PUB | KIN] [type] HASH_IDENTIFIER [ASSIGN expr] | list_pattern [ASSIGN expr]
    //
    // $owner is what the parameters belong to, for errors: "function f", "method Point.move".
    // The HASH_IDENTIFIER form (constructor property promotion) is only recognised when $kind
    // is given, which method_declaration() does only for _: it declares the field on $kind (as
    // field_declaration() would) and returns it in $promoted for the caller to assign from,
    // since the assignment needs the constructor's body, not just its parameters. A promoted
    // parameter's type is the field's too.
    // Gives the names (with sigil, "$x"), each one's default or null, $promoted, the pattern
    // statements, and each one's TypeAST or null.
    fn parameters($owner, $kind = null) {
        #eat("LEFT_PAREN");
        $params = [];
        $defaults = [];
        $promoted = [];
        // The statement taking each pattern parameter apart, for the start of the body
        $patterns = [];
        $types = [];
        $has_default = false;
        while (#current_token.type != "RIGHT_PAREN") {
            if ($params != []) {
                #eat("COMMA");
            }
            $vis = "";
            if ($kind != null && (#current_token.type == "PUB" || #current_token.type == "KIN")) {
                $vis = #current_token.type == "PUB" ? "pub" : "kin";
                #eat(#current_token.type);
            }
            $type = null;
            if (#at_type()) {
                $type_token = #current_token;
                $type = #type();
                // A bare name where a parameter goes was more likely meant as the parameter
                if (!in_array(#current_token.type, ["VAR_IDENTIFIER", "HASH_IDENTIFIER", "LEFT_BRACKET"])) {
                    $found = len($type.names) == 1 ? "'{$type_token.value}'" : #describe(#current_token);
                    #fail_at("Expected a \$variable but found {$found}", #file, $type_token.line);
                }
            }
            if ($kind != null && #current_token.type == "HASH_IDENTIFIER") {
                $token = #current_token;
                $name = slice($token.value, 1);
                if ($name == "_") {
                    #fail("A field can't be named _: that's the constructor");
                }
                #check_new_member($kind, $name, true);
                #eat("HASH_IDENTIFIER");
                $param = "$" .. $name;
                if (in_array($param, $params)) {
                    #fail("Duplicate parameter {$param} in {$owner}");
                }

                $default = null;
                if (#current_token.type == "ASSIGN") {
                    #eat("ASSIGN");
                    $default = #expr();
                    $has_default = true;
                } else if ($has_default) {
                    #fail("Required parameter {$param} can't follow a parameter with a default");
                }
                // No default of its own: its value always comes from the parameter, assigned
                // in the constructor's body, whether given or defaulted there
                #declare_field($kind, $name, null, $vis, $token.line, $type);
                #promoted["{$kind.name}::{$name}"] = true;
                $promoted[] = [$name, $token];
                $params[] = $param;
                $defaults[] = $default;
                $types[] = $type;
                continue;
            }
            if ($vis != "") {
                #fail("pub and kin mark a promoted field parameter (#name): plain parameters need neither");
            }

            $param = #current_token.value;
            if (#current_token.type == "LEFT_BRACKET") {
                if ($type != null) {
                    #fail("A pattern parameter takes no type: it is already a list, and its variables are assigned by taking it apart");
                }
                $pattern_token = #current_token;
                [$param, $statement] = #pattern_parameter(#list_pattern(#list_literal(), #parameter_target), len($params));
                $patterns[] = $statement;
                #check_bound([...$params, $param], $patterns, $owner, $pattern_token.line);
            } else {
            // Only a $variable can be a duplicate: '$a' is a string, which eat() refuses
            if (#current_token.type == "VAR_IDENTIFIER") {
                #check_bound([...$params, $param], $patterns, $owner, #current_token.line);
            }
            #eat("VAR_IDENTIFIER");
            }

            $default = null;
            if (#current_token.type == "ASSIGN") {
                #eat("ASSIGN");
                $default = #expr();
                $has_default = true;
            } else if ($has_default) {
                #fail("Required parameter {$param} can't follow a parameter with a default");
            }
            $params[] = $param;
            $defaults[] = $default;
            $types[] = $type;
        }
        #eat("RIGHT_PAREN");

        return [$params, $defaults, $promoted, $patterns, $types];
    }

    // A list pattern as parameter $index: a hidden parameter in its place, and the statement
    // taking it apart that starts the body, as if written there. Gives [hidden name, statement].
    // The pattern's variables are then assigned in the body, so a lambda never captures them.
    fn pattern_parameter($pattern, $index) {
        $name = "\$#pattern_{$index}";
        $token = Token("VAR_IDENTIFIER", $name);
        $token.line = $pattern.line;
        $assign_token = Token("ASSIGN", "=");
        $assign_token.line = $pattern.line;
        $assign = #at(AssignAST($pattern, $assign_token, #at(VariableAST($token), $token)), $token);

        return [$name, #at(StatementAST($assign), $token)];
    }

    // A target in a parameter's pattern, which is a $variable, as a parameter is
    fn parameter_target($target) {
        if (!is_a($target, VariableAST) || $target.is_global()) {
            #fail_at("A parameter pattern takes \$variables only", $target.file, $target.line);
        }

        return $target;
    }

    // The names a list of parameters binds, failing at the first one bound twice: a pattern's
    // variables count, its hidden parameter doesn't
    fn check_bound($params, $patterns, $owner, $line) {
        $bound = filter($params, $param -> !starts_with($param, "\$#"));
        foreach ($patterns as $statement) {
            $bound = [...$bound, ...map(filter($statement.expr.left.targets, $target -> $target != null), $target -> $target.value)];
        }
        $seen = {};
        foreach ($bound as $name) {
            if (has_key($seen, $name)) {
                #fail_at("Duplicate parameter {$name} in {$owner}", #file, $line);
            }
            $seen[$name] = true;
        }
    }

    // A synthetic #name = $name; for a promoted constructor parameter, exactly as if it had
    // been written in the body: registered as a member use so the whole-program pass sees it,
    // and as a write so #check_member_use knows the field is assigned
    fn promoted_assignment($kind, $name, $token) {
        $property = #at(PropertyAST(#at(ThisAST(), $token), $name), $token);
        $property.use = len(#member_uses);
        #member_uses[] = [$property, $kind, null, false, false, false];

        $assign_token = Token("ASSIGN", "=");
        $assign_token.line = $token.line;
        #assignable($property, $assign_token);

        $var_token = Token("VAR_IDENTIFIER", "$" .. $name);
        $var_token.line = $token.line;
        $variable = #at(VariableAST($var_token), $token);

        return #at(StatementAST(#at(AssignAST($property, $assign_token, $variable), $token)), $token);
    }

    /*
     * What can't follow final, refused saying why: a marker goes first (pub final kind, pub
     * final fn), abstract contradicts it, and nothing but a kind or a method is ever extended or
     * overridden. $what is what final may mark here, "kind" at the top level or "fn" in a kind.
     */
    fn refuse_after_final($what) {
        $token = #current_token;
        if ($token.type == "PUB" || $token.type == "KIN") {
            #fail("{$token.value} comes before final: write '{$token.value} final {$what} ...'");
        } else if ($token.type == "ABSTRACT") {
            #fail(#ABSTRACT_AND_FINAL[$what]);
        } else if ($token.type == "INTERFACE") {
            #fail("An interface can't be final: it is there to be implemented");
        } else if ($token.type == "ENUM") {
            #fail("An enum needs no final: nothing extends one");
        } else if ($token.type != upper($what)) {
            #fail("Only a kind or a method can be final: nothing else is extended or overridden");
        }
    }

    // A reserved word where a member goes says so, as it does where a statement goes
    fn refuse_reserved_member() {
        $token = #current_token;
        if (in_array($token.type, #RESERVED)) {
            #fail("{$token.value} is reserved");
        }
    }

    // Parse a kind declaration ([ABSTRACT | FINAL] KIND IDENTIFIER [EXTENDS name] [IMPLEMENTS name (COMMA name)*]
    // LBRACE (field | method)* RBRACE), field: HASH_IDENTIFIER [ASSIGN expr] SEMICOLON,
    // method: [ABSTRACT | FINAL] FN name parameters (block | SEMICOLON)
    //
    // Only at the top level. The parent and the interfaces can be declared later; they are
    // checked once the whole program is read. A field's default is evaluated for each new object, with #
    // being that object and no local variables. Methods may be named with any word,
    // keywords included, since they are always reached through # or a dot.
    fn kind_declaration($pub = false) {
        $start = #current_token;
        $abstract = $start.type == "ABSTRACT";
        if ($abstract) {
            #eat("ABSTRACT");
            if (#current_token.type == "FINAL") {
                #fail(#ABSTRACT_AND_FINAL["kind"]);
            }
            if (#current_token.type == "ENUM") {
                #fail("An enum can't be abstract: its cases are its objects");
            }
        }
        $final = $start.type == "FINAL";
        if ($final) {
            #eat("FINAL");
            #refuse_after_final("kind");
        }
        #eat("KIND");
        #check_new_name();
        // In a type, one of these words always means the builtin type, so no kind can take it
        if (in_array(#current_token.value, #TYPE_NAMES)) {
            #fail("{#current_token.value} is a type name, so a kind can't be called that");
        }
        $name = #qualify(#current_token.value);
        #eat("IDENTIFIER");
        $parent = null;
        if (#current_token.type == "EXTENDS") {
            #eat("EXTENDS");
            $parent = #current_token.value;
            #eat("IDENTIFIER");
            $parent = #qualified_name($parent);
        }
        $claims = #implements_clause($name);

        $kind = #at(KindDeclarationAST($name, $parent, $abstract), $start);
        if ($final) {
            $kind.final = true;
        }
        #kinds[$name] = $kind;
        #declare($name, $pub);
        if ($parent != null) {
            #parent_names[] = [$kind, #scope];
        }
        if ($claims != []) {
            $kind.interfaces = $claims;
            #interface_claims[] = [$kind, #scope];
        }
        #eat("LEFT_BRACE");
        #kind = $kind;
        while (#current_token.type != "RIGHT_BRACE") {
            // The ladder: unmarked is the kind's own, kin reaches what extends it, pub anyone.
            // pub says the member escapes the kind, as it says a name escapes a namespace.
            $vis = "";
            if (#current_token.type == "PUB" || #current_token.type == "KIN") {
                $vis = #current_token.type == "PUB" ? "pub" : "kin";
                #eat(#current_token.type);
            }
            // A type goes before the name it types, so here it can only be a field's
            $type = null;
            if (#at_type()) {
                $type_token = #current_token;
                $type = #type();
                if (#current_token.type != "HASH_IDENTIFIER") {
                    // A kind inside a kind was not a field of type kind
                    if ($type_token.type == "KIND") {
                        #fail_at("Expected a field (#name), a method (fn), a constant (const) or a static but found " .. #describe($type_token), #file, $type_token.line);
                    }
                    #fail("Expected a field (#name) after the type but found " .. #describe(#current_token));
                }
            }
            if (#current_token.type == "HASH_IDENTIFIER") {
                #field_declaration($kind, $vis, $type);
            } else if (#current_token.type == "CONST") {
                #constant_declaration($kind, false, $vis);
            } else if (#current_token.type == "FN" || #current_token.type == "ABSTRACT") {
                #method_declaration($kind, $vis);
            } else if (#current_token.type == "STATIC") {
                #static_declaration($kind, $vis);
            } else if (#current_token.type == "FINAL") {
                $final_token = #current_token;
                #eat("FINAL");
                #refuse_after_final("fn");
                #method_declaration($kind, $vis, $final_token);
            } else {
                #refuse_reserved_member();
                #fail("Expected a field (#name), a method (fn), a constant (const) or a static but found " .. #describe(#current_token));
            }
        }
        #kind = null;
        #eat("RIGHT_BRACE");

        return $kind;
    }

    // The interfaces a kind claims ([IMPLEMENTS name (COMMA name)*]), as written: after its
    // parent, if it has one
    fn implements_clause($kind, $enum = false) {
        $claims = [];
        if (#current_token.type == "IMPLEMENTS") {
            #eat("IMPLEMENTS");
            $claims[] = #claimed_name();
            while (#current_token.type == "COMMA") {
                #eat("COMMA");
                $claims[] = #claimed_name();
            }
        }
        if ($claims != [] && #current_token.type == "EXTENDS" && !$enum) {
            #fail("extends comes before implements: write 'kind " .. #split_name($kind)[1] .. " extends Parent implements ...'");
        }

        return $claims;
    }

    // One name after implements, possibly qualified
    fn claimed_name() {
        $name = #current_token.value;
        #eat("IDENTIFIER");

        return #qualified_name($name);
    }

    /*
     * Parse an interface declaration (INTERFACE IDENTIFIER LBRACE signature* RBRACE), signature:
     * FN name parameters [COLON type] SEMICOLON
     *
     * Only at the top level. It names the methods a kind that implements it must have, and
     * nothing else: no bodies, fields, constants, statics or markers (every method of one is
     * pub), and no extends. Each is the restrictive choice, which can be loosened later without
     * breaking a program.
     */
    fn interface_declaration($pub) {
        $start = #current_token;
        #eat("INTERFACE");
        #check_new_name();
        // In a type, one of these words always means the builtin type
        if (in_array(#current_token.value, #TYPE_NAMES)) {
            #fail("{#current_token.value} is a type name, so an interface can't be called that");
        }
        $name = #qualify(#current_token.value);
        #eat("IDENTIFIER");
        if (#current_token.type == "EXTENDS" || #current_token.type == "IMPLEMENTS") {
            #fail("An interface {#current_token.value} nothing: a kind implements each interface it needs");
        }

        $interface = #at(InterfaceDeclarationAST($name), $start);
        #interfaces[$name] = $interface;
        #declare($name, $pub);
        #eat("LEFT_BRACE");
        while (#current_token.type != "RIGHT_BRACE") {
            #signature($interface);
        }
        #eat("RIGHT_BRACE");

        return $interface;
    }

    /*
     * Parse an enum declaration (ENUM IDENTIFIER [COLON (string | int)] [IMPLEMENTS name (COMMA
     * name)*] LBRACE (case | method | constant | static method)* RBRACE), case: IDENTIFIER
     * [ASSIGN literal] SEMICOLON
     *
     * Only at the top level. An enum is a kind whose cases are its only objects, each a static
     * slot the VM fills before the program runs, so Filter::Open is read as a static field is.
     * It has no fields (a backed one has #value, the compiler's), no constructor, no extends and
     * no children, so nothing can make a case or change one. Every enum has cases(), and one with
     * values has from() and to_json() too (unless it writes its own to_json()): their code is the
     * compiler's (see #generated), never source a program could spell differently.
     */
    fn enum_declaration($pub) {
        $start = #current_token;
        #eat("ENUM");
        #check_new_name();
        if (in_array(#current_token.value, #TYPE_NAMES)) {
            #fail("{#current_token.value} is a type name, so an enum can't be called that");
        }
        $name = #qualify(#current_token.value);
        #eat("IDENTIFIER");
        #refuse_enum_extends();
        $backing = #enum_backing($name);
        #refuse_enum_extends();
        $claims = #implements_clause($name, true);
        #refuse_enum_extends();

        $kind = #at(KindDeclarationAST($name, null, false), $start);
        [$kind.cases, $kind.case_lines] = [{}, {}];
        #kinds[$name] = $kind;
        #declare($name, $pub);
        if ($claims != []) {
            $kind.interfaces = $claims;
            #interface_claims[] = [$kind, #scope];
        }
        #enum_helper($kind, $start, "cases", [], 0);
        if ($backing != null) {
            $kind.backing = $backing;
            #declare_field($kind, "value", null, "pub", $start.line, #make_type([$backing], $start));
            #enum_helper($kind, $start, "from", ["\$value", "\$default"], [1, 2]);
        }
        #eat("LEFT_BRACE");
        #kind = $kind;
        while (#current_token.type != "RIGHT_BRACE") {
            #enum_member($kind);
        }
        #kind = null;
        #eat("RIGHT_BRACE");
        if ($kind.cases == {}) {
            #fail_at("Enum {$name} has no cases: an enum is the cases it names, as Name;", #file, $start.line);
        }
        // A case of an enum with values is written to JSON as its value, unless the enum says
        // otherwise, or has another member of that name
        $taken = has_key($kind.methods, "to_json") || has_key($kind.static_methods, "to_json")
            || has_key($kind.constants, "to_json") || has_key($kind.cases, "to_json");
        if ($backing != null && !$taken) {
            $method = #at(FunctionDeclarationAST("to_json", [], [], CompoundAST(), 0), $start);
            $method.kind = $name;
            $method.generated = "to_json";
            $kind.methods["to_json"] = $method;
            $kind.vis["to_json"] = "pub";
        }

        return $kind;
    }

    fn refuse_enum_extends() {
        if (#current_token.type == "EXTENDS") {
            #fail("An enum extends nothing, and nothing extends it: its cases are its only objects");
        }
    }

    // The type an enum's values have ([COLON (string | int)]), or null for an enum without values
    fn enum_backing($name) {
        if (#current_token.type != "COLON") {
            return null;
        }
        #eat("COLON");
        $token = #current_token;
        if ($token.type != "IDENTIFIER" || !in_array($token.value, ["string", "int"])) {
            $short = #split_name($name)[1];
            #fail("An enum's values are strings or ints: write 'enum {$short}: string' or 'enum {$short}: int', not " .. #describe($token));
        }
        #eat("IDENTIFIER");

        return $token.value;
    }

    /*
     * A static method every enum is given, as a function named Enum::name whose code the code
     * generator writes (#generated): cases(), and from() for an enum with values
     */
    fn enum_helper($kind, $start, $name, $params, $arity) {
        $full = "{$kind.name}::{$name}";
        #functions[$full] = $arity;
        #declare($full, has_key(#public, $kind.name) || #declared_in[$kind.name] == "");
        $node = #at(FunctionDeclarationAST($full, $params, map($params, $_ -> null), CompoundAST(), $arity), $start);
        $node.kind = $kind.name;
        $node.generated = $name;
        $kind.static_methods[$name] = $node;
        $kind.vis[$name] = "pub";
        #static_functions[] = $node;
    }

    // One member of an enum's body: a case, a method, a constant or a static method
    fn enum_member($kind) {
        $vis = "";
        if (#current_token.type == "PUB" || #current_token.type == "KIN") {
            $vis = #current_token.type == "PUB" ? "pub" : "kin";
            #eat(#current_token.type);
        }
        $type = #current_token.type;
        if ($type == "IDENTIFIER") {
            #enum_case($kind, $vis);
        } else if ($type == "HASH_IDENTIFIER" || $type == "QUESTION" || in_array($type, #TYPE_KEYWORDS)) {
            #fail(#ENUM_HAS_NO_FIELDS);
        } else if ($type == "CONST") {
            #constant_declaration($kind, false, $vis);
        } else if ($type == "FN") {
            #method_declaration($kind, $vis);
        } else if ($type == "STATIC") {
            #static_declaration($kind, $vis);
        } else if ($type == "ABSTRACT") {
            #fail("An enum's methods can't be abstract: nothing extends an enum to define them");
        } else if ($type == "FINAL") {
            #fail("Nothing extends an enum, so its methods need no final");
        } else {
            #refuse_reserved_member();
            #fail("Expected a case (Name;), a method (fn), a constant (const) or a static method but found " .. #describe(#current_token));
        }
    }

    // Parse a case (IDENTIFIER [ASSIGN literal] SEMICOLON): a value when the enum has values, of
    // their type, and no two cases with one value, since a value finds its case
    fn enum_case($kind, $vis) {
        $token = #current_token;
        $name = $token.value;
        #eat("IDENTIFIER");
        // A name before a #field would have been the field's type
        if (#current_token.type == "HASH_IDENTIFIER") {
            #fail(#ENUM_HAS_NO_FIELDS);
        }
        if ($vis != "") {
            #fail_at("A case is pub already, so it needs no {$vis}", #file, $token.line);
        }
        #check_new_case($kind, $name);
        $value = null;
        if (#current_token.type == "ASSIGN") {
            if (($kind.backing ?? null) == null) {
                $short = #split_name($kind.name)[1];
                #fail("Enum {$kind.name} has no values, so case {$name} takes none: write 'enum {$short}: string' (or int) to give its cases values");
            }
            #eat("ASSIGN");
            $value = #case_value($kind, $name);
        } else if (($kind.backing ?? null) != null) {
            #fail("Every case of enum {$kind.name} has a {$kind.backing} value: write {$name} = ...;");
        }
        #eat("SEMICOLON");
        foreach ($kind.cases as $other => $other_value) {
            if ($value != null && $other_value == $value) {
                #fail_at("Cases {$kind.name}::{$other} and {$kind.name}::{$name} have the same value " .. quote($value) .. ": a value finds one case", #file, $token.line);
            }
        }
        $kind.cases[$name] = $value;
        $kind.case_lines[$name] = $token.line;
        $kind.vis[$name] = "pub";
    }

    // A case's value: a string or int literal (a negative int too) of the enum's type
    fn case_value($kind, $name) {
        $start = #current_token;
        #in_constant = true;
        $expr = #expr();
        #in_constant = false;
        $literal = is_a($expr, StringAST) || is_a($expr, NumAST)
            || is_a($expr, UnaryOpAST) && $expr.op.type == "MINUS" && is_a($expr.expr, NumAST);
        if (!$literal) {
            #fail_at("A case's value is a literal: write {$name} = \"...\"; or {$name} = 1;", #file, $start.line);
        }
        $value = #fold($expr, $kind);
        if (type_of($value) != $kind.backing) {
            #fail_at("Case {$kind.name}::{$name} must have a {$kind.backing} value, as its enum says, not " .. type_of($value), #file, $start.line);
        }

        return $value;
    }

    // A case's name must be the enum's only member of that name
    fn check_new_case($kind, $name) {
        if (has_key($kind.cases, $name)) {
            #fail("Enum {$kind.name} already has a case {$name}");
        }
        if (($kind.backing ?? null) != null && $name == "value") {
            #fail(#value_is_taken($kind));
        }
        if (($kind.static_methods[$name].generated ?? null) != null) {
            #fail(#already_generated($kind, $name));
        }
        $member = match {
            has_key($kind.constants, $name) => "constant {$name}",
            has_key($kind.methods, $name) => "method {$name}",
            has_key($kind.static_methods, $name) => "static method {$name}",
            default => null,
        };
        if ($member != null) {
            #fail("{$kind.name} already has a {$member}: cases, constants, methods and statics share names");
        }
    }

    // Why nothing in an enum can be called cases, nor from in one with values: the static
    // methods every enum is given
    fn already_generated($kind, $name) {
        return "Enum {$kind.name} has {$name}() already: every enum has cases(), and one with values from() too";
    }

    // Why nothing in an enum with values can be called value
    fn value_is_taken($kind) {
        return "Every case of enum {$kind.name} has its value in #value, so nothing else in it can be called value";
    }

    // Parse one method an interface names (FN name parameters [COLON type] SEMICOLON), refusing
    // anything else a kind's body could hold
    fn signature($interface) {
        $start = #current_token;
        $type = $start.type;
        if ($type == "PUB" || $type == "KIN") {
            #fail("An interface's methods are all pub, so they need no {$start.value}");
        } else if ($type == "HASH_IDENTIFIER") {
            #fail("An interface has no fields: it names methods only, as fn name(...);");
        } else if ($type == "CONST") {
            #fail("An interface has no constants: it names methods only, as fn name(...);");
        } else if ($type == "STATIC") {
            #fail("An interface has no static members: it names methods an object has, as fn name(...);");
        } else if ($type == "ABSTRACT") {
            #fail("An interface's methods are abstract already, so they need no abstract");
        } else if ($type == "FINAL") {
            #fail("An interface's methods are there to be defined, so none can be final");
        } else if ($type != "FN") {
            #refuse_reserved_member();
            #fail("Expected a method (fn) but found " .. #describe($start));
        }
        #eat("FN");
        $token = #current_token;
        if ($token.type != "IDENTIFIER" && !in_array($token.type, values(Lexer::KEYWORDS))) {
            #fail("Expected a name but found " .. #describe($token));
        }
        $name = $token.value;
        if ($name == "_") {
            #fail("An interface can't name a constructor: each kind's _ is its own");
        }
        if (has_key($interface.methods, $name)) {
            #fail("Interface {$interface.name} already has a method {$name}");
        }
        #eat($token.type);

        [$params, $defaults, $promoted, $patterns, $types] = #parameters("method {$interface.name}.{$name}");
        $returns = #declared_return(false);
        if (#current_token.type == "LEFT_BRACE") {
            #fail("An interface's method has no body: end it with ;");
        }
        #eat("SEMICOLON");

        $arity = #arity($params, $defaults);
        $method = #with_types(#at(FunctionDeclarationAST($name, $params, $defaults, null, $arity), $start), $types, $returns);
        $method.kind = $interface.name;
        $interface.methods[$name] = $method;
    }

    // Parse a field declaration (HASH_IDENTIFIER [ASSIGN expr] SEMICOLON) into its kind, its type already read
    fn field_declaration($kind, $vis = "", $type = null) {
        $token = #current_token;
        $name = slice($token.value, 1);
        #check_new_member($kind, $name);
        #eat("HASH_IDENTIFIER");

        $default = null;
        if (#current_token.type == "ASSIGN") {
            #eat("ASSIGN");
            $default = #expr();
            $variables = VariableCollector();
            $variables.collect($default);
            if ($variables.found != {}) {
                $used = keys($variables.found)[0];
                #fail_at("The default of #{$name} can't use {$used}: fields have no local variables", #file, $token.line);
            }
        }
        #eat("SEMICOLON");

        #declare_field($kind, $name, $default, $vis, $token.line, $type);
    }

    // Register a field of $kind: the one place that writes fields/field_lines/vis, so a field
    // declared with #x; or #x = default; and one promoted from a constructor parameter stay
    // in sync as the same field to everything downstream (layout, visibility, codegen)
    fn declare_field($kind, $name, $default, $vis, $line, $type = null) {
        $kind.fields[$name] = $default;
        $kind.field_lines[$name] = $line;
        $kind.vis[$name] = $vis;
        if ($type != null) {
            $kind.field_types ??= {};
            $kind.field_types[$name] = $type;
        }
    }

    // Parse a constant declaration (CONST IDENTIFIER ASSIGN expr SEMICOLON), at the top level or in a kind ($kind)
    //
    // The value is any expression the parser can work out itself: literals, operators, lists
    // and maps, and other constants, which may be declared later. It is worked out once the
    // whole program is read (see fold()), and a use of the constant is then that value, so
    // neither backend knows constants exist. A top level constant shares the namespace of
    // functions and kinds; a kind's shares the one its fields and methods are in.
    fn constant_declaration($kind, $pub = false, $vis = "") {
        #eat("CONST");
        $token = #current_token;
        $name = $token.value;
        if ($kind == null) {
            #check_new_name();
        } else if ($token.type == "IDENTIFIER" && (has_key($kind.constants, $name) || has_key($kind.fields, $name) || has_key($kind.methods, $name) || has_key($kind.cases ?? {}, $name))) {
            if (($kind.backing ?? null) != null && $name == "value") {
                #fail(#value_is_taken($kind));
            }
            $member = match {
                has_key($kind.cases ?? {}, $name) => "case {$name}",
                has_key($kind.constants, $name) => "constant {$name}",
                has_key($kind.methods, $name) => "method {$name}",
                default => "field #{$name}",
            };
            $shared = #is_enum($kind) ? "cases, constants, methods and statics" : "constants, fields and methods";
            #fail("{$kind.name} already has a {$member}: {$shared} share names");
        }
        #eat("IDENTIFIER");
        #eat("ASSIGN");
        #in_constant = true;
        $expr = #expr();
        #in_constant = false;
        #eat("SEMICOLON");

        if ($kind == null) {
            $name = #qualify($name);
            #constants[$name] = [$expr, null, $name];
            #declare($name, $pub);
        } else {
            $kind.constants[$name] = $expr;
            $kind.constant_lines[$name] = $token.line;
            $kind.vis[$name] = $vis;
            #constants["{$kind.name}::{$name}"] = [$expr, $kind, "{$kind.name}::{$name}"];
        }
    }

    // A name declared in the file being parsed, with its namespace on it
    fn qualify($name) {
        return #module.namespace == "" ? $name : "{#module.namespace}::{$name}";
    }

    /*
     * Record a top level declaration's namespace, the module it is in, and whether it escapes
     * its namespace
     */
    fn declare($name, $pub) {
        #declared_in[$name] = #module.namespace;
        #declared_module[$name] = #module.key;
        if ($pub) {
            #public[$name] = true;
        }
    }

    // Whether a top level name is declared, as a function, a kind, an interface or a constant
    fn declared($name) {
        return has_key(#functions, $name) || has_key(#kinds, $name) || has_key(#interfaces, $name) || has_key(#constants, $name);
    }

    // Read a module's top level as the file being parsed, giving its statements
    fn read_module($module, $text, $template) {
        [$lexer, $current_token, $file, $outer, $scope] = [#lexer, #current_token, #file, #module, #scope];
        #modules[$module.key] = $module;
        #scope = len(#scopes);
        #scopes[] = $module;
        #module = $module;
        #lexer = Lexer($text, $template);
        #file = $module.file;
        #current_token = #next_token();
        $statements = #top_level();
        [#lexer, #current_token, #file, #module, #scope] = [$lexer, $current_token, $file, $outer, $scope];

        return $statements;
    }

    /*
     * The main file as a module: its imports are from its own directory and project, or, for
     * source with no file, from the working directory's
     */
    fn main_module() {
        $real = #path != null && file_exists(#path) ? real_path(#path) : null;
        if ($real == null) {
            $directory = cwd();
            #main_root = #find_root($directory) ?? $directory;

            return Module(Parser::MAIN, #path, $directory, #main_root, true);
        }
        $key = #module_key($real);
        if (#is_std($key)) {
            #main_root = STD_DIRECTORY;

            return Module($key, #path, STD_DIRECTORY, STD_DIRECTORY, true);
        }
        $directory = directory_of($real);
        #main_root = #find_root($directory) ?? $directory;

        return Module($key, #path, $directory, #main_root, true);
    }

    // Whether a module's key is the standard library's
    fn is_std($key) {
        return starts_with($key, STD_DIRECTORY .. "/");
    }

    /*
     * How a file is known as a module: its real path, except that a file of GAZLIB is the
     * standard library's, so std/x.gaz and GAZLIB's x.gaz are one module, not two
     */
    fn module_key($real) {
        if (#library != null && starts_with($real, #library .. "/")) {
            return STD_DIRECTORY .. "/" .. slice($real, len(#library) + 1);
        }

        return $real;
    }

    // The directory GAZLIB names, as a real path, or null
    fn library_directory() {
        $directory = getenv("GAZLIB");
        if ($directory == null || $directory == "" || !is_dir($directory)) {
            return null;
        }

        return real_path($directory);
    }

    // The nearest directory at or above $directory with a gaz.json, or null
    fn find_root($directory) {
        return project_root($directory);
    }

    /*
     * Check a project's gaz.json, once, when a program first imports a file of its own: a program
     * that imports only the standard library, or nothing, is not made to fail by a gaz.json it
     * never reads, one in a directory above a script, say.
     */
    fn trust_project($root) {
        if (!has_key(#projects, $root) && file_exists(join_path($root, "gaz.json"))) {
            #check_project($root);
        }
        #projects[$root] = true;
    }

    /*
     * A gaz.json says where a project starts. For now it is a JSON object whose only key is
     * "name", a string: anything else is refused, so nothing written today can mean something
     * else once packages read more of it.
     */
    fn check_project($root) {
        $shown = #display_path(join_path($root, "gaz.json"));
        $text = #read(join_path($root, "gaz.json"));
        if ($text == null) {
            #fail_at("{$shown} can't be read", $shown, 1);
        }
        $project = null;
        // Only the decoding is in the try: a catch of Error around more would also catch a bug
        try {
            $project = json::decode($text);
        } catch (Error $e) {
            #fail_at("{$shown} isn't JSON: {$e.message}", $shown, 1);
        }
        if (type_of($project) != "map") {
            #fail_at("{$shown} must be a JSON object, like {\"name\": \"app\"}", $shown, 1);
        }
        foreach ($project as $key => $value) {
            if ($key != "name") {
                #fail_at("{$shown}: " .. quote($key) .. " isn't read yet: packages aren't built, and a gaz.json holds only its \"name\"", $shown, 1);
            }
        }
        if (type_of($project["name"] ?? null) != "string") {
            #fail_at("{$shown} needs a \"name\", a string, like {\"name\": \"app\"}", $shown, 1);
        }
    }

    /*
     * The declared name a name written in $scope means: its module's own namespace, declared
     * in that module or one it imports; then its aliases; then a qualified name of a namespace
     * it imports; then a name an imported module declares with no namespace; then the
     * builtins. $what describes an undefined name, for the error that names a missing import.
     *
     * Only the first part is resolved, since a namespace holds no namespace: Token::EOF in
     * namespace gazlang is gazlang::Token::EOF, and json::decode is already what it means.
     */
    fn resolve($name, $scope, $file, $line, $what) {
        $module = #scopes[$scope];
        [$head, $rest] = #split_head($name);
        $own = "{$module.namespace}::{$head}";
        $own_declared = $module.namespace != "" && #declared($own);

        if ($own_declared && #sees($module, $own)) {
            return $own .. $rest;
        }
        if (has_key($module.aliases, $head)) {
            return $module.aliases[$head] .. $rest;
        }
        if ($rest != "" && has_key(#namespaces, $head)) {
            if (!has_key($module.reachable, $head)) {
                #fail_at("Namespace {$head} is not imported here: a file only sees what it imports" .. #import_hint($name, $module), $file, $line);
            }
            #check_imported($name, $name, $module, $what, $file, $line);

            return $name;
        }
        if (has_key(#declared_module, $head)) {
            #check_imported($name, $head, $module, $what, $file, $line);

            return $name;
        }
        /*
         * The namespace's own name wins over a builtin of it, so a declaration that isn't imported
         * is a missing import, never quietly the builtin
         */
        if ($own_declared) {
            #check_imported($name, $own, $module, $what, $file, $line);
        }

        return $name;
    }

    /*
     * Whether a module sees the declaration a name is part of: one in itself or a module it
     * imports, or a builtin kind
     */
    fn sees($module, $name) {
        $declarer = #declaring_module($name);

        return $declarer == null || $declarer == Parser::BUILTIN_FILE || has_key($module.imports, $declarer);
    }

    /*
     * The module that declares the top level name a name is part of (json::Reader::EOF is
     * json::Reader's), or null
     */
    fn declaring_module($name) {
        $entity = #declared_name($name);

        return $entity == null ? null : #declared_module[$entity];
    }

    // The top level declaration a name is part of, or null
    fn declared_name($name) {
        while (!has_key(#declared_module, $name)) {
            if (!contains($name, "::")) {
                return null;
            }
            [$name, $last] = #split_name($name);
        }

        return $name;
    }

    /*
     * Refuse a name whose declaration is in a module this one doesn't import, saying which
     * import is missing. $declared is the declared name it would mean.
     */
    fn check_imported($written, $declared, $module, $what, $file, $line) {
        if (!#sees($module, $declared)) {
            #fail_at("{$what}: {$written}" .. #import_hint($declared, $module), $file, $line);
        }
    }

    /*
     * " (x is declared in forms.gaz, which this file doesn't import: add import "forms.gaz";)"
     * for a name declared in a module $module doesn't import, or ""
     */
    fn import_hint($name, $module) {
        $entity = #declared_name($name);
        if ($entity == null || #sees($module, $entity)) {
            return "";
        }
        $other = #modules[#declared_module[$entity]];

        return " ({$entity} is declared in {$other.file}, which this file doesn't import: add import \"" .. #import_spelling($other, $module) .. "\";)";
    }

    /*
     * How $from would write an import of $module: std/ for the standard library, ./ for a file
     * in its own directory or below when that isn't the project root, else from the root
     */
    fn import_spelling($module, $from) {
        $key = $module.key;
        if (#is_std($key)) {
            return "std/" .. slice($key, len(STD_DIRECTORY) + 1);
        }
        if ($from.directory != $from.root && starts_with($key, $from.directory .. "/")) {
            return "./" .. slice($key, len($from.directory) + 1);
        }
        if (starts_with($key, $from.root .. "/")) {
            return slice($key, len($from.root) + 1);
        }

        return $module.file;
    }

    // A name's first part and everything after it, the rest keeping its leading ::
    fn split_head($name) {
        $parts = split($name, "::");
        $head = $parts[0];
        delete $parts[0];

        return [$head, len($parts) == 0 ? "" : "::" .. join($parts, "::")];
    }

    // The declared top level name a resolved name is part of, or null: json::Reader::EOF is
    // the kind json::Reader, and its visibility is the one that governs
    fn declared_entity($name) {
        while (true) {
            if (#declared($name)) {
                return $name;
            }
            if (!contains($name, "::")) {
                return null;
            }
            [$name, $last] = #split_name($name);
        }
    }

    // A name is private to its namespace unless pub, which is why a file is implementation
    // and only what it says is public escapes it
    fn check_visible($name, $scope, $file, $line) {
        $entity = #declared_entity($name);
        if ($entity == null) {
            return;
        }
        $in = #declared_in[$entity] ?? "";
        if ($in != "" && $in != #scopes[$scope].namespace && !has_key(#public, $entity)) {
            #fail_at("{$entity} is not pub, so only namespace {$in} can use it", $file, $line);
        }
    }

    // Resolve every name a file wrote, before anything is checked, so the rest of the parser
    // only ever sees the name a declaration made
    fn resolve_names() {
        foreach (#alias_uses as [$name, $file, $line, $scope, $imported, $path]) {
            if (!#declared($name) && #constant_key($name) == null) {
                #fail_at("Undefined function or constant: {$name}", $file, $line);
            }
            #check_use_from($name, $imported, $path, $file, $line);
            #check_visible($name, $scope, $file, $line);
        }
        foreach (#uses as [$node, $scope, $_]) {
            $what = is_a($node, FunctionCallAST) ? "Undefined function" : "Undefined function or constant";
            $node.name = #resolve($node.name, $scope, $node.file, $node.line, $what);
            #check_visible($node.name, $scope, $node.file, $node.line);
        }
        foreach (#parent_names as [$kind, $scope]) {
            $kind.parent = #resolve($kind.parent, $scope, $kind.file, $kind.line, "Undefined kind");
            #check_visible($kind.parent, $scope, $kind.file, $kind.line);
        }
        foreach (#interface_claims as [$kind, $scope]) {
            foreach ($kind.interfaces as $i => $name) {
                $kind.interfaces[$i] = #resolve($name, $scope, $kind.file, $kind.line, "Undefined interface");
                #check_visible($kind.interfaces[$i], $scope, $kind.file, $kind.line);
            }
        }
        foreach (#catch_types as [$node, $index, $line, $file, $scope]) {
            $name = #resolve($node.catches[$index][0], $scope, $file, $line, "Undefined kind");
            $node.catches[$index][0] = $name;
            #check_visible($name, $scope, $file, $line);
        }
        foreach (#type_uses as [$node, $scope]) {
            $node.names = map($node.names, $name -> #resolve_type_name($name, $scope, $node));
        }
    }

    // A type's name as a declaration made it: a builtin type's name is its own, a kind's is
    // resolved like any other name
    fn resolve_type_name($name, $scope, $node) {
        if (in_array($name, #TYPE_NAMES)) {
            return $name;
        }
        $resolved = #resolve($name, $scope, $node.file, $node.line, "Undefined type");
        #check_visible($resolved, $scope, $node.file, $node.line);

        return $resolved;
    }

    /*
     * A use clause's name must be declared in the module its path names, not merely in that
     * module's namespace
     */
    fn check_use_from($name, $imported, $path, $file, $line) {
        $declarer = #declaring_module($name);
        if ($declarer != null && $declarer != $imported) {
            $bare = #split_name($name)[1];
            #fail_at("{$path} doesn't declare {$bare}: {$name} is declared in " .. #modules[$declarer].file, $file, $line);
        }
    }

    // Every name in a declared type that isn't a builtin type's must be a kind's or an interface's
    fn check_types() {
        foreach (#type_uses as [$node, $scope]) {
            foreach ($node.names as $name) {
                if (!in_array($name, #TYPE_NAMES) && !has_key(#kinds, $name) && !has_key(#interfaces, $name)) {
                    #fail_at(#not_a_type($name), $node.file, $node.line);
                }
            }
        }
    }

    // What is wrong with a name written where a kind's goes
    fn not_a_kind($name) {
        return match {
            has_key(#interfaces, $name) => "{$name} is an interface, not a kind",
            has_key(#functions, $name) => "{$name} is a function, not a kind",
            has_key(#constants, $name) => "{$name} is a constant, not a kind",
            default => "Undefined kind: {$name}" .. #library_hint($name),
        };
    }

    // What is wrong with a name written after implements
    fn not_an_interface($name) {
        return match {
            has_key(#kinds, $name) => "{$name} is a kind, not an interface: a kind extends a kind, and implements interfaces",
            has_key(#functions, $name) => "{$name} is a function, not an interface",
            has_key(#constants, $name) => "{$name} is a constant, not an interface",
            default => "Undefined interface: {$name}" .. #library_hint($name),
        };
    }

    /*
     * A name that is one of the standard library's files says to import it: `lists::first()`
     * without the import reads as a kind that isn't there
     */
    fn library_hint($name) {
        if (contains($name, "::") || std_source($name .. ".gaz") == null) {
            return "";
        }

        return " (the standard library has {$name}.gaz: write import \"std/{$name}.gaz\";)";
    }

    // What is wrong with a name written in a type: a builtin type's name or a kind's is what goes there
    fn not_a_type($name) {
        return match {
            has_key(#functions, $name) => "{$name} is a function, not a type",
            has_key(#constants, $name) => "{$name} is a constant, not a type",
            default => "Undefined type: {$name}",
        };
    }

    // Work out a constant's value, the first time it is asked for. $at is the node asking,
    // for the error if the constant depends on itself.
    fn constant_value($key, $at) {
        if (!has_key(#constant_values, $key)) {
            [$expr, $kind, $name] = #constants[$key];
            if (in_array($name, #folding)) {
                // From its first appearance among those being worked out, round to it again
                $from = 0;
                while (#folding[$from] != $name) {
                    $from++;
                }
                $cycle = slice(#folding, $from);
                $cycle[] = $name;
                #fail_at("Constant {$name} depends on itself: " .. join($cycle, " uses "), $at.file, $at.line);
            }
            #folding[] = $name;
            #check_constant_expression($expr, $kind);
            #constant_values[$key] = #fold($expr, $kind);
            delete #folding[len(#folding) - 1];
        }

        return #constant_values[$key];
    }

    // Record a static of a resolved kind, refusing a name the hierarchy already uses: every
    // member shares one namespace, and a child can't declare a parent's static again
    fn check_new_static($kind, $name, $line, $is_method) {
        $what = $is_method ? "Static method {$kind.name}::{$name}" : "Static field {$kind.name}::#{$name}";
        if (has_key($kind.static_owners, $name)) {
            #fail_at("{$what} is already declared in {$kind.static_owners[$name]}", $kind.file, $line);
        }
        $owner = $kind.constant_owners[$name] ?? $kind.layout[$name] ?? $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
        if ($owner != null) {
            $member = match {
                has_key($kind.constant_owners, $name) => "constant",
                has_key($kind.layout, $name) => "field",
                default => "method",
            };
            #fail_at("{$what} has the name of a {$member} of {$owner}: constants, fields, methods and statics share names", $kind.file, $line);
        }
        $kind.static_owners[$name] = $kind.name;
        $kind.owner_vis[$name] = $kind.vis[$name];
        $kind.static_is_method[$name] = $is_method;
        #claim($kind, $name);
    }

    // A name a kind declares is its own from there down: a parent's private member of that
    // name no longer answers for it, in this kind or its children
    fn claim($kind, $name) {
        if (has_key($kind.hidden, $name)) {
            delete $kind.hidden[$name];
        }
    }

    // Refuse a member whose name a static of the hierarchy already uses
    fn check_not_static($kind, $name, $what, $line) {
        if (has_key($kind.static_owners, $name)) {
            $member = $kind.static_is_method[$name] ? "static method" : "static field";
            #fail_at("{$what} has the name of a {$member} of {$kind.static_owners[$name]}: constants, fields, methods and statics share names", $kind.file, $line);
        }
    }

    // The key in #statics of a resolved kind's static, its parent's included, or null if it
    // has none of that name
    // Why a kind can't name a member its parent has, or null when it has none of that name
    fn not_pub($kind, $name) {
        if (!has_key($kind.hidden, $name)) {
            return null;
        }
        $owner = $kind.hidden[$name];

        return "{$owner}::{$name} is not pub, so only {$owner} can use it";
    }

    fn kind_static($kind, $name) {
        return has_key($kind.static_owners, $name) ? "{$kind.static_owners[$name]}::{$name}" : null;
    }

    // The key in #constants of a resolved kind's constant, its parent's included, or null if it has none of that name
    fn kind_constant($kind, $name) {
        return has_key($kind.constant_owners, $name) ? "{$kind.constant_owners[$name]}::{$name}" : null;
    }

    // Check all of a constant's expression is something fold() can work out, the parts it won't get to included
    //
    // fold() leaves out the side of && || ?? and ?: that isn't needed, as a program does, so on
    // its own it would accept `true ? 1 : $x` and refuse it the day the condition changed.
    // What a constant may be made of is a rule about the source, so it is checked on the source.
    fn check_constant_expression($node, $kind) {
        if (is_a($node, FunctionRefAST)) {
            if (#constant_key(#as_asked($node.name, $kind)) == null) {
                #fail_at(match {
                    has_key(#kinds, $node.name) => "{$node.name} is a kind, not a constant",
                    has_key(#functions, $node.name) => "{$node.name} is a function, not a constant",
                    default => #qualified_error($node.name) ?? "Undefined constant: {$node.name}",
                }, $node.file, $node.line);
            }

            return;
        }
        if (is_a($node, PropertyAST)) {
            // A constant folds before the whole-program checks run, so the dot on a name that
            // turns out to be a kind is caught here too, with the same words
            if (is_a($node.target, FunctionRefAST)) {
                #check_dot_on_name($node);
            }
            $owner = is_a($node.target, ThisAST) ? $kind : null;
            if ($owner != null && #kind_constant($owner, $node.name) != null) {
                return;
            }
            // A parent's private constant is the parent's own, which is worth saying outright
            if ($owner != null) {
                $hidden = #not_pub($owner, $node.name);
                if ($hidden != null) {
                    #fail_at($hidden, $node.file, $node.line);
                }
            }
            #fail_at("A constant's value can only use literals, operators and other constants", $node.file, $node.line);
        }
        // Constants fold before the empty slots left in #gaps are refused, so one here is refused
        // now, in the same words, rather than reaching fold() as a null entry
        if (in_array($node, #gaps)) {
            #fail_gap($node);
        }
        $parts = match {
            is_a($node, NumAST) || is_a($node, StringAST) || is_a($node, BooleanAST) || is_a($node, NullAST) => [],
            is_a($node, UnaryOpAST) => [$node.expr],
            is_a($node, BinOpAST) => [$node.left, $node.right],
            is_a($node, TernaryAST) => [$node.condition, $node.then, $node.else],
            is_a($node, ArrayLiteralAST) => $node.entries,
            is_a($node, SpreadAST) => [$node.expr],
            default => #fail_at("A constant's value can only use literals, operators and other constants", $node.file, $node.line),
        };
        foreach ($parts as $part) {
            // A list or map literal's entries are [key, value], the key null in a list
            foreach (type_of($part) == "list" ? $part : [$part] as $expression) {
                if ($expression != null) {
                    #check_constant_expression($expression, $kind);
                }
            }
        }
    }

    // Refuse a list literal left with an empty slot, which only a pattern may have
    fn fail_gap($literal) {
        #fail_at("An empty slot in a list is for taking one apart: write [\$a, , \$b] = \$list, or give the slot a value", $literal.file, $literal.line);
    }

    // Work out the value of a constant's expression, as a program would: $kind is the kind
    // the constant is declared in, which #NAME is a constant of
    //
    // The operators are GazLang's own, run by the VM that runs the parser, which is the one
    // that will run the program, so 1 / 0 and an overflow are the errors they are when a
    // program runs, located at the operator. Only what needs
    // nothing but the source is allowed: no variables, no calls (a function can do anything,
    // and an object it made could be changed through the constant), no indexing.
    fn fold($node, $kind) {
        if (is_a($node, NumAST) || is_a($node, StringAST) || is_a($node, BooleanAST) || is_a($node, NullAST)) {
            return $node.value;
        } else if (is_a($node, UnaryOpAST)) {
            $value = #fold($node.expr, $kind);

            return #located($node, () -> match ($node.op.type) {
                "NOT" => !$value,
                "MINUS" => -$value,
                default => ~$value,
            });
        } else if (is_a($node, BinOpAST)) {
            $left = #fold($node.left, $kind);
            $type = $node.op.type;
            // As when a program runs, the right side of && || and ?? only counts when it is needed
            if ($type == "AND") {
                return $left && #fold($node.right, $kind);
            } else if ($type == "OR") {
                return $left || #fold($node.right, $kind);
            } else if ($type == "COALESCE") {
                return $left ?? #fold($node.right, $kind);
            }
            $right = #fold($node.right, $kind);

            return #located($node, () -> #apply($type, $left, $right));
        } else if (is_a($node, TernaryAST)) {
            return #fold(#fold($node.condition, $kind) ? $node.then : $node.else, $kind);
        } else if (is_a($node, ArrayLiteralAST) && !$node.map) {
            $list = [];
            foreach ($node.entries as $entry) {
                if (is_a($entry[1], SpreadAST)) {
                    // GazLang's own spread, located at the ...
                    $value = #fold($entry[1].expr, $kind);
                    $list = #located($entry[1], () -> [...$list, ...$value]);
                } else {
                    $list[] = #fold($entry[1], $kind);
                }
            }

            return $list;
        } else if (is_a($node, ArrayLiteralAST)) {
            $map = {};
            foreach ($node.entries as [$key_node, $value_node]) {
                if (is_a($value_node, SpreadAST)) {
                    // GazLang's own spread, located at the ...
                    $value = #fold($value_node.expr, $kind);
                    $map = #located($value_node, () -> ({...$map, ...$value}));
                    continue;
                }
                $key = #fold($key_node, $kind);
                // A key that can't be one is an error at the map, before its value is worked out
                #located($node, () -> ({$key => null}));
                // Duplicate keys: the last one wins
                $map[$key] = #fold($value_node, $kind);
            }

            return $map;
        } else if (is_a($node, FunctionRefAST) && #constant_key(#as_asked($node.name, $kind)) != null) {
            return #constant_value(#constant_key(#as_asked($node.name, $kind)), $node);
        } else if (is_a($node, PropertyAST) && (is_a($node.target, ThisAST) || is_a($node.target, FunctionRefAST))) {
            $owner = is_a($node.target, ThisAST) ? $kind : #kinds[$node.target.name] ?? null;
            $key = $owner == null ? null : #kind_constant($owner, $node.name);
            if ($key != null) {
                return #constant_value($key, $node);
            }
        }

        #fail_at("A constant's value can only use literals, operators and other constants", $node.file, $node.line);
    }

    // What $compute gives, with an error in it raised again as a ParseError at the node. Only the
    // operator itself is in the try, which is handed the values it works on: a catch of Error
    // around the working out of those would also catch a ParseError in them, and relocate it.
    fn located($node, $compute) {
        try {
            return $compute();
        } catch (Error $e) {
            #fail_at($e.message, $node.file, $node.line);
        }
    }

    // Apply a binary operator by its token type. An operator is not a value in GazLang, so
    // each is written out.
    fn apply($type, $left, $right) {
        return match ($type) {
            "PLUS" => $left + $right,
            "MINUS" => $left - $right,
            "MULTIPLY" => $left * $right,
            "DIVIDE" => $left / $right,
            "MODULO" => $left % $right,
            "POWER" => $left ** $right,
            "CONCAT" => $left .. $right,
            "EQUALS" => $left == $right,
            "NOT_EQUALS" => $left != $right,
            "SPACESHIP" => $left <=> $right,
            "LESS_THAN" => $left < $right,
            "LESS_EQUALS" => $left <= $right,
            "GREATER_THAN" => $left > $right,
            "GREATER_EQUALS" => $left >= $right,
            "BIT_AND" => $left & $right,
            "BIT_OR" => $left | $right,
            "BIT_XOR" => $left ^ $right,
            "SHIFT_LEFT" => $left << $right,
            "SHIFT_RIGHT" => $left >> $right,
        };
    }

    // Check a Name.member where Name is a kind: the kind must have the constant, and a constant can't be called
    //
    // Anything else is left to run: Name may be a constant holding a map, or a function,
    // and what . does to those is an error for when it happens.
    // A kind is reached by name, with ::, never through a dot, which goes through a value
    fn check_dot_on_name($node) {
        $kind = #kinds[$node.target.name] ?? null;
        if ($kind != null) {
            #fail_at("Cannot use . on a kind: write '{$kind.name}::{$node.name}', not '{$kind.name}.{$node.name}'", $node.file, $node.line);
        }
        if (has_key(#interfaces, $node.target.name)) {
            #fail_at("Cannot use . on an interface: call {$node.name} on an object of a kind that implements {$node.target.name}", $node.file, $node.line);
        }
    }

    // A qualified name's parts, as [everything before the last ::, the name after it]
    fn split_name($name) {
        $parts = split($name, "::");
        $last = len($parts) - 1;
        $name = $parts[$last];
        delete $parts[$last];

        return [join($parts, "::"), $name];
    }

    // The key in #constants of the constant a name means, or null if it names none. A top
    // level constant is its own key and a kind's is its owner's, since it is inherited, so
    // Special::EOF is the key Token::EOF when Token is what declared it.
    fn constant_key($name) {
        if (has_key(#constants, $name)) {
            return $name;
        }
        if (!contains($name, "::")) {
            return null;
        }
        [$prefix, $last] = #split_name($name);
        $kind = #kinds[$prefix] ?? null;

        return $kind == null ? null : #kind_constant($kind, $last);
    }

    // The key in #statics of the static field a name means, or null if it names none. As a
    // constant's, a kind's static is its owner's, since a child shares it.
    fn static_key($name) {
        if (!contains($name, "::")) {
            return null;
        }
        [$prefix, $last] = #split_name($name);
        $kind = #kinds[$prefix] ?? null;
        if ($kind == null || ($kind.static_is_method[$last] ?? true)) {
            return null;
        }

        return #kind_static($kind, $last);
    }

    // Whether a static's key ("Filter::Open") is a case of an enum
    fn is_case($key) {
        if ($key == null) {
            return false;
        }
        [$prefix, $last] = #split_name($key);
        $kind = #kinds[$prefix] ?? null;

        return $kind != null && has_key($kind.cases ?? {}, $last);
    }

    // Whether a kind is an enum
    fn is_enum($kind) {
        return ($kind.cases ?? null) != null;
    }

    fn case_never_changes($key) {
        return "Cannot change {$key}: an enum's cases never change";
    }

    // What is wrong with a qualified name nothing declares, or null when the name has no ::
    // or names a namespace, where being undefined is all there is to say
    fn qualified_error($name) {
        if (!contains($name, "::")) {
            return null;
        }
        [$prefix, $last] = #split_name($name);
        $kind = #kinds[$prefix] ?? null;
        if ($kind != null) {
            // An object's method or field, private to a parent or not, is wrong before it is hidden
            $owner = $kind.members[$last] ?? $kind.abstract_methods[$last] ?? $kind.hidden[$last] ?? null;
            if ($last == "_" && $owner != null) {
                return "{$name} is the constructor, which runs when one is made: write {$prefix}(...)";
            }
            if ($owner != null && has_key(#kinds[$owner].methods, $last)) {
                return "{$name} is not static: {$last} is a method of an object, so call it on one, as \$obj.{$last}()";
            }
            $hidden_field = $owner != null && has_key(#kinds[$owner].fields, $last);
            if (has_key($kind.layout, $last) || $hidden_field) {
                return "{$name} is not static: #{$last} is a field of an object, so read it from one, as \$obj.{$last}";
            }

            return #not_pub($kind, $last) ?? "Kind {$kind.name} has no constant {$last}";
        }

        return has_key(#namespaces, #split_head($name)[0]) ? null : #not_a_kind($prefix);
    }

    // Parse a static declaration (STATIC (HASH_IDENTIFIER ASSIGN expr SEMICOLON | FN method))
    //
    // A static belongs to the kind rather than to an object, so a field is a slot and a
    // method a function whose name carries its kind. A field's default is a constant
    // expression, folded as a kind constant is: running one would bring initialisation
    // order and bytecode before the top level, which is what constants refuse for.
    fn static_declaration($kind, $vis = "") {
        $start = #current_token;
        #eat("STATIC");
        if (#current_token.type == "FINAL") {
            #fail("Only a kind or a method can be final: nothing else is extended or overridden");
        }
        if (#current_token.type == "FN") {
            #static_method($kind, $start, $vis);

            return;
        }
        $type = #at_type() ? #type() : null;
        $token = #current_token;
        if ($token.type != "HASH_IDENTIFIER") {
            #fail("Expected a static field (#name) or a static method (fn) but found " .. #describe($token));
        }
        if (#is_enum($kind)) {
            #fail("An enum has no static fields: its cases are what it keeps, and they never change");
        }
        $name = slice($token.value, 1);
        #check_new_member($kind, $name);
        #eat("HASH_IDENTIFIER");
        if (#current_token.type != "ASSIGN") {
            #fail("A static field needs a value: write 'static #{$name} = ...;'");
        }
        #eat("ASSIGN");
        #in_constant = true;
        $expr = #expr();
        #in_constant = false;
        #eat("SEMICOLON");

        $kind.statics[$name] = $expr;
        $kind.static_lines[$name] = $token.line;
        $kind.vis[$name] = $vis;
        if ($type != null) {
            $kind.static_types ??= {};
            $kind.static_types[$name] = $type;
        }
    }

    // Parse a static method (FN name parameters block), the static having been eaten
    //
    // It is a function named Kind::name, so calling one is an ordinary call and the VM needs
    // nothing: a static has no object, which is why a dot never reaches it.
    fn static_method($kind, $start, $vis = "") {
        #eat("FN");
        $token = #current_token;
        if ($token.type != "IDENTIFIER" && !in_array($token.type, values(Lexer::KEYWORDS))) {
            #fail("Expected a name but found " .. #describe($token));
        }
        $name = $token.value;
        if ($name == "_") {
            #fail("A constructor can't be static: it makes an object");
        }
        #check_new_member($kind, $name);
        #eat($token.type);

        $full = "{$kind.name}::{$name}";
        [$params, $defaults, $promoted, $patterns, $types] = #parameters("static method {$full}");
        $returns = #declared_return(false);
        $arity = #arity($params, $defaults);
        #functions[$full] = $arity;
        #declare($full, has_key(#public, $kind.name) || #declared_in[$kind.name] == "");
        [$in_function, $in_static] = [#in_function, #in_static];
        [#in_function, #in_static, #return_type, #return_label] = [true, $kind, $returns, "{$full}()"];
        $scope = #enter_scope($params, false);
        $body = #block();
        #leave_scope($scope);
        [#in_function, #in_static, #return_type] = [$in_function, $in_static, null];
        $body.statements = [...$patterns, ...$body.statements];

        $node = #with_types(#at(FunctionDeclarationAST($full, $params, $defaults, $body, $arity), $start), $types, $returns);
        $node.kind = $kind.name;
        #signatures[$full] = $node;
        $kind.static_methods[$name] = $node;
        $kind.vis[$name] = $vis;
        #static_functions[] = $node;
    }

    /*
     * Parse a method declaration ([ABSTRACT] FN name parameters (block | SEMICOLON)) into its
     * kind, $final_token being the final before it, already eaten, if there was one
     *
     * An abstract method has no body, and only an abstract kind can declare one. A final one
     * can't be overridden, so it must escape to the children that could (a private method is
     * never overridden), and a final kind's methods need no final.
     */
    fn method_declaration($kind, $vis = "", $final_token = null) {
        $start = $final_token ?? #current_token;
        $abstract = #current_token.type == "ABSTRACT";
        if ($abstract) {
            #eat("ABSTRACT");
            if (#current_token.type == "FINAL") {
                #fail(#ABSTRACT_AND_FINAL["fn"]);
            }
        }
        #eat("FN");
        $token = #current_token;
        if ($token.type != "IDENTIFIER" && !in_array($token.type, values(Lexer::KEYWORDS))) {
            #fail("Expected a name but found " .. #describe($token));
        }
        $name = $token.value;
        // A constructor is reached by constructing rather than by naming, so it escapes its
        // kind whatever it says: a child's _ overrides its parent's, and a marker on one
        // would be saying what is already true
        if ($name == "_" && #is_enum($kind)) {
            #fail("An enum has no constructor: its cases are made once, before the program runs");
        }
        if ($name == "_") {
            if ($vis != "") {
                #fail("A constructor is reached by constructing, so it needs no {$vis}");
            }
            $vis = "pub";
        }
        if ($final_token != null) {
            #check_final_method($kind, $name, $vis);
        }
        #check_new_member($kind, $name);
        #eat($token.type);

        [$params, $defaults, $promoted, $patterns, $types] = #parameters("method {$kind.name}.{$name}", $name == "_" ? $kind : null);
        $returns = #declared_return($name == "_");
        if ($abstract) {
            if (!$kind.abstract) {
                #fail_at("Kind {$kind.name} has abstract method {$name}, so it must be abstract too", #file, $start.line);
            }
            if ($name == "_") {
                #fail_at("A constructor can't be abstract", #file, $start.line);
            }
            if (#current_token.type == "LEFT_BRACE") {
                #fail("An abstract method has no body: end it with ;");
            }
            #eat("SEMICOLON");
            $body = CompoundAST();
        } else if ($name == "_" && #current_token.type == "SEMICOLON") {
            // Nothing left to write once every parameter has promoted its field
            #eat("SEMICOLON");
            $body = CompoundAST();
        } else {
            [#in_function, #in_constructor, #return_type, #return_label] = [true, $name == "_", $returns, "{$kind.name}.{$name}()"];
            $scope = #enter_scope($params, false);
            $body = #block();
            #leave_scope($scope);
            [#in_function, #in_constructor, #return_type] = [false, false, null];
        }
        $prelude = $patterns;
        foreach ($promoted as [$field, $field_token]) {
            $prelude[] = #promoted_assignment($kind, $field, $field_token);
        }
        $body.statements = [...$prelude, ...$body.statements];

        $method = #with_types(#at(FunctionDeclarationAST($name, $params, $defaults, $body, #arity($params, $defaults)), $start), $types, $returns);
        $method.kind = $kind.name;
        $method.abstract = $abstract;
        if ($final_token != null) {
            $method.final = true;
        }
        $kind.methods[$name] = $method;
        $kind.vis[$name] = $vis;
    }

    // Whether final means anything on this method: an override is what it forbids
    fn check_final_method($kind, $name, $vis) {
        if ($name == "_") {
            #fail("A constructor can't be final: each kind's _ is its own");
        }
        if ($vis == "") {
            #fail("Method {$kind.name}.{$name} escapes only {$kind.name}, so no child can override it: make it kin or pub, or drop final");
        }
        if ($kind.final ?? false) {
            #fail("Kind {$kind.name} is final, so its methods need no final");
        }
    }

    // Check a kind doesn't already declare a member: fields and methods share one namespace
    //
    // $promoting is whether the name being declared is a constructor's promoted parameter
    fn check_new_member($kind, $name, $promoting = false) {
        $field = #current_token.type == "HASH_IDENTIFIER";
        if (has_key($kind.cases ?? {}, $name)) {
            #fail("{$kind.name} already has a case {$name}: cases, constants, methods and statics share names");
        }
        if (($kind.backing ?? null) != null && $name == "value") {
            #fail(#value_is_taken($kind));
        }
        if (($kind.static_methods[$name].generated ?? null) != null) {
            #fail(#already_generated($kind, $name));
        }
        if (has_key($kind.statics, $name) || has_key($kind.static_methods, $name)) {
            $member = has_key($kind.statics, $name) ? "static field #{$name}" : "static method {$name}";
            #fail("{$kind.name} already has a {$member}: constants, fields, methods and statics share names");
        }
        if (has_key($kind.constants, $name)) {
            #fail("{$kind.name} already has a constant {$name}: constants, fields and methods share names");
        }
        if (has_key($kind.fields, $name)) {
            if ($field && $promoting) {
                if (has_key(#promoted, "{$kind.name}::{$name}")) {
                    #fail("Duplicate parameter \${$name} in method {$kind.name}._");
                }
                #fail("{$kind.name} already has a field #{$name}: a promoted parameter declares its field, so remove the field's own declaration (or write \${$name} as a plain parameter)");
            }
            if ($field && has_key(#promoted, "{$kind.name}::{$name}")) {
                #fail("{$kind.name} already has a field #{$name}, declared by a promoted constructor parameter: remove this declaration");
            }
            #fail($field
                ? "{$kind.name} already has a field #{$name}"
                : "{$kind.name} already has a field #{$name}, and a method can't have a field's name: call the method something else");
        }
        if (has_key($kind.methods, $name)) {
            #fail($field
                ? "{$kind.name} already has a method {$name}, and a field can't have a method's name: call the field something else, like #{$name}_value"
                : "{$kind.name} already has a method {$name}");
        }
    }

    // Parse a statement (expr SEMICOLON | echo_statement | if_statement | while_statement | for_statement | foreach_statement
    //                    | loop_control | return_statement | delete_statement | match)
    fn statement() {
        // Only the statement being read gives a hint, so one that ended can't reach a later error
        $outer = #statement_token;
        #statement_token = #current_token;
        $node = #statement_body();
        #statement_token = $outer;

        return $node;
    }

    fn statement_body() {
        $type = #current_token.type;
        if ($type == "ECHO") {
            return #echo_statement();
        } else if ($type == "IF") {
            return #if_statement();
        } else if ($type == "WHILE") {
            return #while_statement();
        } else if ($type == "FOR") {
            return #for_statement();
        } else if ($type == "FOREACH") {
            return #foreach_statement();
        } else if ($type == "TRY") {
            return #try_statement();
        } else if ($type == "BREAK" || $type == "CONTINUE") {
            return #loop_control();
        } else if ($type == "RETURN") {
            return #return_statement();
        } else if ($type == "DELETE") {
            return #delete_statement();
        } else if ($type == "SHARED") {
            return #shared_declaration();
        } else if ($type == "FN") {
            #fail("Functions can only be declared at the top level");
        } else if ($type == "KIND" || $type == "ABSTRACT" || $type == "FINAL") {
            #fail("Kinds can only be declared at the top level");
        } else if ($type == "INTERFACE") {
            #fail("Interfaces can only be declared at the top level");
        } else if ($type == "ENUM") {
            #fail("Enums can only be declared at the top level");
        } else if ($type == "CONST") {
            #fail("Constants can only be declared at the top level or in a kind");
        } else if ($type == "INCLUDE") {
            #include_is_gone();
        } else if ($type == "IMPORT") {
            #fail("import can only be used at the top of a file");
        } else if ($type == "MATCH") {
            // A match written as a statement ends at its }, like if and while, and its arms
            // may be blocks; its value is discarded
            $start = #current_token;

            return #at(StatementAST(#match_expression(true)), $start);
        }

        $start = #current_token;
        $expr = #expr();
        #eat("SEMICOLON");

        return #at(StatementAST($expr), $start);
    }

    // Parse a shared variable's declaration (SHARED VAR_IDENTIFIER ASSIGN expr SEMICOLON)
    //
    // A variable that closures share with the function they are written in, rather than each
    // taking a copy: `shared $count = 0;` and then $count is one variable to all of them. It is
    // a Shared box in a hidden variable, assigned here (a new box each time this runs, which is
    // what gives each iteration of a loop its own), and every use of $count after it that
    // variable() meets is the box's value; a lambda that uses one captures the box, which is a
    // handle, so the copy it takes is the same box. Nothing below the parser learns of it.
    //
    // It is refused where it would be a second variable of the same name: already shared, or
    // already used as a plain one. A parameter or a foreach or catch variable can't be shared.
    fn shared_declaration() {
        $start = #current_token;
        #eat("SHARED");
        $token = #current_token;
        if ($token.type != "VAR_IDENTIFIER") {
            #fail("Expected a \$variable after shared but found " .. #describe($token));
        }
        $name = $token.value;
        if (has_key(#shared, $name)) {
            #fail_at("{$name} is already shared", #file, $token.line);
        }
        if (has_key(#bound, $name)) {
            #fail_at("{$name} is a parameter, so it can't be shared: share another variable", #file, $token.line);
        }
        if (has_key(#plain, $name)) {
            #fail_at("{$name} is used before it is shared: write shared {$name} = ...; where it is first set", #file, $token.line);
        }
        #eat("VAR_IDENTIFIER");
        if (#current_token.type != "ASSIGN") {
            #fail("A shared variable needs a value: write shared {$name} = ...;");
        }
        $assign = #current_token;
        #eat("ASSIGN");
        $value = #expr();
        #eat("SEMICOLON");

        // Declared once its value is read, which can't be the variable itself
        #shared[$name] = true;
        #shares = true;
        $box_token = Token("VAR_IDENTIFIER", "\$#shared_" .. slice($name, 1));
        $box_token.line = $token.line;
        // Constructed as the global scope, 0, sees Shared, whatever namespace this is written in
        $construct = #at(FunctionCallAST("Shared", [$value]), $token);
        #uses[] = [$construct, 0, #kind];

        return #at(StatementAST(#at(AssignAST(#at(VariableAST($box_token), $token), $assign, $construct), $assign)), $start);
    }

    // Parse an echo statement (ECHO expr SEMICOLON)
    fn echo_statement() {
        $start = #current_token;
        #eat("ECHO");
        $expr = #expr();
        #eat("SEMICOLON");

        return #at(EchoStatementAST($expr), $start);
    }

    // Parse a program (top_level)
    //
    // Calls by name and bare names are checked once everything is parsed, so a function
    // can be used before it is declared and both backends can trust every call by name.
    // Calls on values ($f(1)) are checked when they run.
    fn program() {
        // The builtin kinds are a module of their own, which every file sees
        #module = Module(Parser::BUILTIN_FILE, Parser::BUILTIN_FILE, Parser::BUILTIN_FILE, Parser::BUILTIN_FILE, false);
        #scopes[] = #module;
        [$error_kind, $shared_kind, $html_kind] = #builtin_kinds();
        #library = #library_directory();
        $main = #main_module();
        #modules[$main.key] = $main;
        #scope = len(#scopes);
        #scopes[] = $main;
        #module = $main;
        $root = CompoundAST();
        $root.statements = #top_level();
        if (#main_imported != null && #main_statement != null) {
            [$importer, $imported_line, $written] = #main_imported;
            #fail_at("Cannot import \"{$written}\": it is the program's main file, which has a statement on line " .. #main_statement .. ", and an imported file only declares (fn, kind, interface, enum, const)", $importer, $imported_line);
        }
        // Every name a file wrote becomes the name a declaration made, before anything below
        // is checked, so only this pass ever learns that namespaces exist
        #resolve_names();
        // Error is only compiled into programs that can catch, name or extend it
        $uses_error = #catches || #names_in_a_type("Error");
        foreach (#uses as [$use, $scope, $_]) {
            $uses_error = $uses_error || $use.name == "Error";
        }
        foreach (#kinds as $kind) {
            $uses_error = $uses_error || $kind.parent == "Error";
        }
        if ($uses_error) {
            $root.statements = [$error_kind, ...$root.statements];
        }
        // Shared is only compiled into programs with a shared variable
        if (#shares || #names_in_a_type("Shared")) {
            $root.statements = [$shared_kind, ...$root.statements];
        }
        // Html into programs with a template, or that name it themselves
        if (#templates || #names_html()) {
            // with its static method, which a builtin kind's parse doesn't place, unlike top_level()
            $root.statements = [$html_kind, ...values($html_kind.static_methods), ...$root.statements];
        }
        foreach (#catch_types as [$node, $index, $line, $file, $scope]) {
            $name = $node.catches[$index][0];
            if (!has_key(#kinds, $name)) {
                #fail_at(#not_a_kind($name), $file, $line);
            }
        }
        #check_types();
        #check_claims();

        foreach (#kinds as $kind) {
            #resolve_kind($kind, []);
        }

        // In the order declared, so the first mistake in the program is the one reported
        foreach (#constants as $key => $constant) {
            #constant_value($key, $constant[0]);
        }

        // A static field is a slot, and its default a constant, so the two are worked out
        // here and the code generator writes them before the program's own first instruction
        $inits = [];
        foreach (#kinds as $kind) {
            foreach ($kind.statics as $name => $expr) {
                #check_constant_expression($expr, $kind);
                #statics["{$kind.name}::{$name}"] = len(#static_defaults);
                #static_defaults[] = #fold($expr, $kind);
                $type = ($kind.static_types ?? {})[$name] ?? null;
                if ($type != null && !#type_takes($type, type_of(last(#static_defaults)))) {
                    #fail_at("{$kind.name}::{$name} must be {$type.text()}, got " .. type_of(last(#static_defaults)), $expr.file, $expr.line);
                }
                $init = StaticInitAST("{$kind.name}::{$name}", last(#static_defaults));
                // At the default's own file and line: #at() would take the file being read now
                $init.line = $expr.line;
                $init.file = $expr.file;
                $inits[] = $init;
            }
        }
        $root.statements = [...$inits, ...$root.statements];

        // In source order, so the first mistake in the program is the one reported
        foreach (#member_uses as [$node, $kind, $argc, $assigned, $written, $in_static]) {
            #check_member_use($node, $kind, $argc, $assigned, $written, $in_static);
        }
        foreach (#gaps as $gapped) {
            #fail_gap($gapped);
        }
        foreach (#dot_on_names as $node) {
            #check_dot_on_name($node);
        }
        foreach (#parent_uses as [$node, $kind]) {
            #check_parent_use($node, $kind);
        }
        foreach (#uses as [$use, $scope, $asker]) {
            $name = #as_asked($use.name, $asker);
            $static = #static_key($name);
            if ($static != null) {
                $what = #is_case($static) ? "a case" : "a static field";
                if (is_a($use, FunctionRefAST) && ($use.braced ?? false)) {
                    #fail_braced_name($use, $what);
                }
                if (is_a($use, FunctionCallAST)) {
                    #fail_at("{$use.name} is {$what}, not a function", $use.file, $use.line);
                }
                #check_member_escapes($use, $asker, $name);
                $use.static_name = $static;

                continue;
            }
            $constant = #constant_key($name);
            if ($constant != null) {
                if (is_a($use, FunctionCallAST)) {
                    #fail_at("{$use.name} is a constant, not a function", $use.file, $use.line);
                }
                #check_member_escapes($use, $asker, $name);
                $use.constant = true;
                $use.value = #constant_value($constant, $use);

                continue;
            }
            if (is_a($use, FunctionRefAST) && ($use.braced ?? false)) {
                #fail_braced_name($use);
            }
            if (has_key(#kinds, $use.name)) {
                $kind = #kinds[$use.name];
                if (is_a($use, FunctionCallAST)) {
                    if (#is_enum($kind)) {
                        $first = keys($kind.cases)[0];
                        #fail_at("Cannot construct enum {$use.name}: its cases are its only objects, so name one, as {$use.name}::{$first}", $use.file, $use.line);
                    }
                    if ($kind.abstract) {
                        #fail_at("Cannot construct abstract kind {$use.name}", $use.file, $use.line);
                    }
                    $error = #arity_error("Kind {$use.name}", #constructor_arity($kind), len($use.args));
                    if ($error != null) {
                        #fail_at($error .. #tagged_hint($use), $use.file, $use.line);
                    }
                }

                continue;
            }
            // An interface is a value (is_a's second argument), never constructed
            if (has_key(#interfaces, $use.name)) {
                if (is_a($use, FunctionCallAST)) {
                    #fail_at("Cannot construct interface {$use.name}: construct a kind that implements it", $use.file, $use.line);
                }

                continue;
            }
            // Child::next is the function Parent::next when the parent declares it
            if (!has_key(#functions, $use.name) && contains($name, "::")) {
                [$prefix, $last] = #split_name($name);
                $kind = #kinds[$prefix] ?? null;
                if ($kind != null && ($kind.static_is_method[$last] ?? false)) {
                    $use.name = #kind_static($kind, $last);
                }
            }
            if (!has_key(#functions, $use.name)) {
                $error = #qualified_error($use.name);
                if ($error != null) {
                    #fail_at($error, $use.file, $use.line);
                }
                $hint = #undefined_hint($use.name);
                // A bare name that isn't called is as likely a mistyped constant
                $what = is_a($use, FunctionCallAST) ? "Undefined function" : "Undefined function or constant";
                #fail_at("{$what}: {$use.name}{$hint}", $use.file, $use.line);
            }
            #check_member_escapes($use, $asker);
            if (is_a($use, FunctionCallAST)) {
                $error = #arity_error("Function {$use.name}", #functions[$use.name], len($use.args));
                if ($error != null) {
                    #fail_at($error .. #tagged_hint($use), $use.file, $use.line);
                }
            }
        }

        // Only a static field of the ones reached by name is a slot, so only it can be written
        foreach (#static_writes as [$node, $operator]) {
            if (#is_case($node.static_name)) {
                #fail_at(#case_never_changes($node.static_name), $node.file, $node.line);
            }
            if ($node.static_name == null) {
                #fail_at($node.constant
                    ? "Cannot change constant {$node.name}"
                    : "Can only use {$operator.value} on a variable, or an element or field of one", $node.file, $node.line);
            }
        }
        #check_known_types();

        return $root;
    }

    /*
     * Values whose type is certain when the program is read, held to the types they meet as
     * the VM would hold them, so a mistake in code that hasn't run yet is still found: the
     * arguments of a call by name, of a #method() and of a ##method(), what a typed function
     * returns, and parameter and field defaults. Only a value known_type() can name is checked;
     * anything else is left to the VM. Each error is the one the VM would give.
     */
    fn check_known_types() {
        foreach (#signatures as $name => $function) {
            #check_defaults($function, "{$name}()");
        }
        foreach (#kinds as $kind) {
            foreach ($kind.methods as $name => $method) {
                #check_defaults($method, #method_label($kind.name, $name));
            }
            foreach ($kind.field_types ?? {} as $name => $type) {
                $default = $kind.fields[$name];
                if ($default != null) {
                    #check_known($default, $type, "{$kind.name} #{$name} must be");
                }
            }
        }
        foreach (#interfaces as $interface) {
            foreach ($interface.methods as $name => $method) {
                #check_defaults($method, "{$interface.name}.{$name}()");
            }
        }
        foreach (#typed_lambdas as $lambda) {
            $where = $lambda.file == null ? "on line {$lambda.line}" : "at {$lambda.file}:{$lambda.line}";
            #check_defaults($lambda, "-> {$where}");
        }
        foreach (#uses as [$use, $scope, $_]) {
            if (is_a($use, FunctionCallAST)) {
                #check_call($use);
            }
        }
        foreach (#member_calls as $call) {
            #check_member_call($call);
        }
        foreach (#parent_uses as [$node, $kind]) {
            if ($node.args != null) {
                #check_arguments($node.args, #kinds[$node.definer].methods[$node.name], #method_label($node.definer, $node.name));
            }
        }
        foreach (#typed_returns as [$expr, $type, $label]) {
            #check_known($expr, $type, "{$label} should return");
        }
    }

    // A method as the VM names it in an error: Kind.name(), and a constructor Kind()
    fn method_label($kind, $name) {
        return $name == "_" ? "{$kind}()" : "{$kind}.{$name}()";
    }

    // A call by name: to a function or static method, or constructing a kind
    fn check_call($call) {
        if (has_key(#signatures, $call.name)) {
            #check_arguments($call.args, #signatures[$call.name], "{$call.name}()");

            return;
        }
        $kind = #kinds[$call.name] ?? null;
        if ($kind != null && has_key($kind.members, "_")) {
            $definer = $kind.members["_"];
            #check_arguments($call.args, #kinds[$definer].methods["_"], #method_label($definer, "_"));
        }
    }

    /*
     * A #name(...) call, against the version the kind it is written in names: a child's
     * override keeps its types, so what this one refuses, every one refuses
     */
    fn check_member_call($call) {
        $property = $call.property;
        if ($property.static_name != null) {
            // An enum's cases() and from() are the code generator's, with no declaration to check against
            if (has_key(#signatures, $property.static_name)) {
                #check_arguments($call.args, #signatures[$property.static_name], "{$property.static_name}()");
            }

            return;
        }
        if ($property.field || $property.constant) {
            return;
        }
        $kind = #member_uses[$property.use][1];
        $definer = $kind.members[$property.name] ?? $kind.abstract_methods[$property.name];
        #check_arguments($call.args, #kinds[$definer].methods[$property.name], #method_label($definer, $property.name));
    }

    // A call's arguments, each held to its parameter's type, the call named as $label
    fn check_arguments($args, $function, $label) {
        $types = $function.param_types ?? [];
        foreach ($args as $i => $arg) {
            if ($i < len($types) && $types[$i] != null) {
                #check_known($arg, $types[$i], "{$label} expects {$function.params[$i]} to be");
            }
        }
    }

    // A function's or lambda's defaults, each held to its parameter's type as an argument is
    fn check_defaults($function, $label) {
        foreach ($function.param_types ?? [] as $i => $type) {
            $default = $function.defaults[$i];
            if ($type != null && $default != null) {
                #check_known($default, $type, "{$label} expects {$function.params[$i]} to be");
            }
        }
    }

    // Fail when $expr's type is known and $type refuses it, the message starting with $saying
    fn check_known($expr, $type, $saying) {
        $known = #known_type($expr);
        if ($known != null && !#type_takes($type, $known)) {
            #fail_at("{$saying} {$type.text()}, got {$known}", $expr.file, $expr.line);
        }
    }

    /*
     * The type an expression's value is certain to have, named as a type error names it, or
     * null when only running it would tell: a literal, a constant, a case of an enum, or a kind
     * being constructed. A .. always gives a string, which is what makes an interpolated one.
     */
    fn known_type($expr) {
        $nameable = is_a($expr, FunctionRefAST) || is_a($expr, PropertyAST);

        return match {
            is_a($expr, NumAST) => type_of($expr.value),
            is_a($expr, StringAST) => "string",
            is_a($expr, BooleanAST) => "bool",
            is_a($expr, NullAST) => "null",
            is_a($expr, ArrayLiteralAST) => $expr.map ? "map" : "list",
            is_a($expr, LambdaAST) => "function",
            is_a($expr, BinOpAST) => $expr.op.type == "CONCAT" ? "string" : null,
            is_a($expr, UnaryOpAST) => $expr.op.type == "MINUS" && is_a($expr.expr, NumAST) ? type_of($expr.expr.value) : null,
            $nameable && $expr.constant => type_of($expr.value),
            $nameable && $expr.static_name != null && #is_case($expr.static_name) => #split_name($expr.static_name)[0],
            is_a($expr, FunctionCallAST) && has_key(#kinds, $expr.name) => $expr.name,
            default => null,
        };
    }

    /*
     * Whether a declared type takes a value of a known type, as the VM's type_admits() does:
     * an int where a float goes, a kind's object where the kind, a parent or an interface goes
     */
    fn type_takes($type, $known) {
        if (in_array($known, $type.names) || $known == "int" && in_array("float", $type.names)) {
            return true;
        }
        if (!has_key(#kinds, $known)) {
            return false;
        }
        if (in_array("object", $type.names)) {
            return true;
        }
        foreach ($type.names as $name) {
            if (#kind_is_a($known, $name)) {
                return true;
            }
        }

        return false;
    }

    // Whether the kind named $name is $ancestor, extends it or implements it
    fn kind_is_a($name, $ancestor) {
        while ($name != null && has_key(#kinds, $name)) {
            $kind = #kinds[$name];
            if ($name == $ancestor || in_array($ancestor, $kind.interfaces ?? [])) {
                return true;
            }
            $name = $kind.parent;
        }

        return false;
    }

    /*
     * A name in a string's bare braces that isn't a constant's: "{NAME}" interpolates only a
     * constant, so a misspelt one is an error rather than text. What the name is, when it is
     * something, says how to interpolate it instead; when it is nothing, the text may have
     * been meant, so the error names \{ too, rather than the error a bare name would get.
     */
    fn fail_braced_name($use, $what = null) {
        $what ??= match {
            has_key(#kinds, $use.name) => "a kind",
            has_key(#interfaces, $use.name) => "an interface",
            has_key(#builtins, $use.name) => "a builtin",
            has_key(#functions, $use.name) => "a function",
            default => null,
        };
        if ($what != null) {
            #fail_at("Only a constant interpolates in bare braces, and {$use.name} is {$what}: assign it to a \$variable first, or join it with ..", $use.file, $use.line);
        }
        $braced = '{' .. $use.name .. '}';
        #fail_at("Undefined constant {$use.name} in \"{$braced}\": declare it, or write \\{$braced} for the text", $use.file, $use.line);
    }

    /*
     * A Kind::name reaching a constant or static must be let out to where it is written, as
     * .name and #name are: a pub member to anywhere, a kin one to the kind that declared it
     * and what extends it, any other only to the kind that declared it. The asking kind is
     * the one the code is written in (a method, a default, a lambda in it), and code outside
     * every kind has none. A parent's private member isn't among a child's, so naming it
     * through the child is qualified_error()'s, before this is reached, unless as_asked()
     * found the asking kind is the one that declared it. $asked is the name as_asked() gave.
     */
    fn check_member_escapes($use, $asker, $asked = $use.name) {
        if (!contains($asked, "::")) {
            return;
        }
        [$prefix, $name] = #split_name($asked);
        $kind = #kinds[$prefix] ?? null;
        if ($kind == null) {
            return;
        }
        $owner = $kind.constant_owners[$name] ?? $kind.static_owners[$name] ?? null;
        if ($owner == null) {
            return;
        }
        $vis = #kinds[$owner].owner_vis[$name];
        if ($vis == "pub" || ($asker != null && $asker.name == $owner)) {
            return;
        }
        if ($vis == "kin") {
            if (!#extends_kind($asker, $owner)) {
                #fail_at("{$owner}::{$name} is kin, so only {$owner} and what extends it can use it", $use.file, $use.line);
            }

            return;
        }
        #fail_at("{$owner}::{$name} is not pub, so only {$owner} can use it", $use.file, $use.line);
    }

    /*
     * The name a Kind::name written in $asker means there: a constant or static $asker
     * declared without pub, named through a kind that extends it, is $asker's own. The child
     * doesn't carry it, since it doesn't escape to the child, but the asking kind is the
     * declaring one, which is all a private member asks. Any other name is itself.
     */
    fn as_asked($name, $asker) {
        if ($asker == null || !contains($name, "::")) {
            return $name;
        }
        [$prefix, $last] = #split_name($name);
        $kind = #kinds[$prefix] ?? null;
        if ($kind == null || ($kind.hidden[$last] ?? null) != $asker.name) {
            return $name;
        }
        $own = ($asker.constant_owners[$last] ?? $asker.static_owners[$last] ?? null) == $asker.name;

        return $own ? "{$asker.name}::{$last}" : $name;
    }

    // Whether a kind, or null for code outside every kind, is $ancestor or extends it
    fn extends_kind($kind, $ancestor) {
        while ($kind != null) {
            if ($kind.name == $ancestor) {
                return true;
            }
            $kind = $kind.parent == null ? null : #kinds[$kind.parent];
        }

        return false;
    }

    // Work out a kind's fields and methods from its own and its parent's, checking they fit together
    //
    // The entries of one of a kind's tables that escape it, so a child can name them. What is
    // left behind is recorded on $into, so an error about it can say why it isn't there.
    fn escaping($table, $kind, $into = null, $fields = false) {
        $out = {};
        foreach ($table as $name => $value) {
            if (($kind.owner_vis[$name] ?? "") != "") {
                $out[$name] = $value;
            } else if ($into != null) {
                $into.hidden[$name] = $kind.name;
                if ($fields) {
                    $into.hidden_fields[$name] = $value;
                }
            }
        }

        return $out;
    }

    // Where a name's escaping entry sits in a method table, or null: a private entry of that
    // name belongs to whichever kind declared it, and is not the one an override replaces
    fn entry_of($table, $name) {
        foreach ($table as $at => [$entry, $definer, $vis, $declarer]) {
            if ($entry == $name && $vis != "") {
                return $at;
            }
        }

        return null;
    }

    // Fields and methods share one namespace, a field can't be declared again, and a method
    // may replace a parent's method but must accept every argument count the parent's accepts
    // (except the constructor, which each kind defines for itself). $chain is the kinds
    // being resolved that extend this one, to find circular inheritance.
    fn resolve_kind($kind, $chain) {
        if ($kind.resolved) {
            return;
        }

        if ($kind.parent != null) {
            $parent = #kinds[$kind.parent] ?? null;
            if (has_key(#interfaces, $kind.parent)) {
                #fail_at("Kind {$kind.name} can't extend {$kind.parent}: it is an interface, so write 'implements {$kind.parent}'", $kind.file, $kind.line);
            }
            if ($parent == null) {
                #fail_at(#not_a_kind($kind.parent), $kind.file, $kind.line);
            }
            if ($parent.final ?? false) {
                #fail_at("Kind {$kind.name} can't extend {$parent.name}: it is final", $kind.file, $kind.line);
            }
            if (#is_enum($parent)) {
                #fail_at("Kind {$kind.name} can't extend {$parent.name}: it is an enum, whose cases are its only objects", $kind.file, $kind.line);
            }
            $chain[] = $kind.name;
            if (in_array($parent.name, $chain)) {
                // From the parent's first appearance in the chain, round to it again
                $from = 0;
                while ($chain[$from] != $parent.name) {
                    $from++;
                }
                $cycle = slice($chain, $from);
                $cycle[] = $parent.name;
                #fail_at("Circular inheritance: " .. join($cycle, " extends "), $kind.file, $kind.line);
            }
            #resolve_kind($parent, $chain);
            // A parent's private member is the parent's own: a child can't name it, and may
            // declare one of its own by that name. Its slot and method entry are still
            // inherited, since the parent's own methods run on a child's objects and reach it.
            [$kind.slots, $kind.method_table] = [$parent.slots, $parent.method_table];
            [$kind.hidden, $kind.hidden_fields] = [$parent.hidden, $parent.hidden_fields];
            // Unfiltered: a parent's private name is declared again by a child that reuses it
            // (below), and an override keeps the declarer of the entry it replaces
            $kind.declared_at = $parent.declared_at;
            $kind.layout = #escaping($parent.layout, $parent, $kind, true);
            $kind.members = #escaping($parent.members, $parent, $kind);
            $kind.abstract_methods = #escaping($parent.abstract_methods, $parent, $kind);
            $kind.constant_owners = #escaping($parent.constant_owners, $parent, $kind);
            // A child shares its parent's statics, as it shares the rest of the namespace
            $kind.static_owners = #escaping($parent.static_owners, $parent, $kind);
            $kind.static_is_method = #escaping($parent.static_is_method, $parent);
            $kind.owner_vis = #escaping($parent.owner_vis, $parent);
        }

        foreach ($kind.constants as $name => $_) {
            $line = $kind.constant_lines[$name];
            #check_not_static($kind, $name, "Constant {$name} of {$kind.name}", $line);
            // A child can't declare it again: #NAME is worked out from the kind it is written in, so there is nothing to override
            if (has_key($kind.constant_owners, $name)) {
                #fail_at("Constant {$name} of {$kind.name} is already declared in {$kind.constant_owners[$name]}", $kind.file, $line);
            }
            $owner = $kind.layout[$name] ?? $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
            if ($owner != null) {
                $member = has_key($kind.layout, $name) ? "field" : "method";
                #fail_at("Constant {$name} of {$kind.name} has the name of a {$member} of {$owner}: constants, fields and methods share names", $kind.file, $line);
            }
            $kind.constant_owners[$name] = $kind.name;
            $kind.owner_vis[$name] = $kind.vis[$name];
            #claim($kind, $name);
        }

        foreach ($kind.statics as $name => $_) {
            #check_new_static($kind, $name, $kind.static_lines[$name], false);
        }
        // A case is a static slot, which the VM fills before the program runs
        foreach ($kind.cases ?? {} as $name => $_) {
            #check_new_static($kind, $name, $kind.case_lines[$name], false);
        }
        foreach ($kind.static_methods as $name => $method) {
            #check_new_static($kind, $name, $method.line, true);
        }

        foreach ($kind.fields as $name => $_) {
            $line = $kind.field_lines[$name];
            #check_not_static($kind, $name, "Field #{$name}", $line);
            if (has_key($kind.constant_owners, $name) && $kind.constant_owners[$name] != $kind.name) {
                #fail_at("Field #{$name} of {$kind.name} has the name of a constant of {$kind.constant_owners[$name]}: constants, fields and methods share names", $kind.file, $line);
            }
            if (has_key($kind.layout, $name)) {
                #fail_at("Field #{$name} of {$kind.name} is already declared in {$kind.layout[$name]}", $kind.file, $line);
            }
            // A method, constant or static of a parent's that this kind can't name may have
            // its name reused; a field may not, since every field of an object is a slot of
            // its own and the initialiser sets each one by name
            if (has_key($kind.hidden_fields, $name)) {
                #fail_at("Field #{$name} of {$kind.name} has the name of a field of {$kind.hidden_fields[$name]} that isn't pub: a field is a slot, so the name is taken", $kind.file, $line);
            }
            $owner = $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
            if ($owner != null) {
                #fail_at("Field #{$name} of {$kind.name} has the name of a method of {$owner}: fields and methods share names, so call the field something else", $kind.file, $line);
            }
            $kind.layout[$name] = $kind.name;
            $kind.owner_vis[$name] = $kind.vis[$name];
            $kind.slots[] = [$name, $kind.name, $kind.vis[$name]];
        }
        foreach ($kind.methods as $name => $method) {
            #check_not_static($kind, $name, "Method {$kind.name}.{$name}", $method.line);
            if (has_key($kind.constant_owners, $name)) {
                #fail_at("Method {$kind.name}.{$name} has the name of a constant of {$kind.constant_owners[$name]}: constants, fields and methods share names", $method.file, $method.line);
            }
            if (has_key($kind.layout, $name)) {
                #fail_at("Method {$kind.name}.{$name} has the name of a field of {$kind.layout[$name]}: fields and methods share names, so call the method something else", $method.file, $method.line);
            }
            $owner = $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
            // What the parent let escape, before this one's own is recorded below
            $inherited_vis = $kind.owner_vis[$name] ?? null;
            if ($owner != null && (#kinds[$owner].methods[$name].final ?? false)) {
                #fail_at("Method {$kind.name}.{$name} can't override {$owner}.{$name}: it is final", $method.file, $method.line);
            }
            if ($owner != null && $method.abstract && has_key($kind.members, $name)) {
                #fail_at("Abstract method {$kind.name}.{$name} can't replace {$owner}.{$name}", $method.file, $method.line);
            }
            // A child defines an abstract method, and callers call it, so one that escapes
            // nothing could never be defined or reached
            if ($method.abstract && $kind.vis[$name] == "") {
                #fail_at("Abstract method {$kind.name}.{$name} must be pub or kin: a child defines what it can see", $method.file, $method.line);
            }
            // An override answers for the one it replaces, so it escapes as far
            if ($owner != null && $name != "_" && $kind.vis[$name] != $inherited_vis) {
                $was = $inherited_vis == "" ? "escapes only {$owner}" : "is {$inherited_vis}";
                $now = $kind.vis[$name] == "" ? "escapes only {$kind.name}" : "is {$kind.vis[$name]}";
                #fail_at("Method {$kind.name}.{$name} {$now}, but {$owner}.{$name} {$was}: an override escapes as far as what it replaces", $method.file, $method.line);
            }
            // The constructor is each kind's own: a child's can take different arguments
            if ($owner != null && $name != "_") {
                [$fewest, $most] = #bounds($method.arity);
                [$parent_fewest, $parent_most] = #bounds(#kinds[$owner].methods[$name].arity);
                if ($fewest > $parent_fewest || $most < $parent_most) {
                    $expected = $parent_fewest == $parent_most ? $parent_fewest : "{$parent_fewest} to {$parent_most}";
                    #fail_at("Method {$kind.name}.{$name} must accept every argument count {$owner}.{$name} does ({$expected})", $method.file, $method.line);
                }
                #check_override_types($kind, $method, $owner, #kinds[$owner].methods[$name]);
            }
            if ($name == "to_string" && #bounds($method.arity)[0] != 0) {
                #fail_at("Method {$kind.name}.to_string must accept 0 arguments: printing calls it with none", $method.file, $method.line);
            }
            // Printing calls to_string() from outside the kind, so a private one would be
            // skipped and the object print its fields instead: say so rather than do that
            if ($name == "to_string" && $kind.vis[$name] != "pub") {
                #fail_at("Method {$kind.name}.to_string must be pub: printing calls it from outside", $method.file, $method.line);
            }
            $kind.owner_vis[$name] = $kind.vis[$name];
            // A method that replaces nothing this kind can see is declared here, even when a
            // parent's private one had the name: that one is the parent's own, not overridden
            if ($owner == null) {
                $kind.declared_at[$name] = $kind.name;
                #claim($kind, $name);
            }
            if ($method.abstract) {
                $kind.abstract_methods[$name] = $kind.name;
            } else {
                // An override replaces the entry it overrides; a method whose name only a
                // parent's private one had is a new one, and gets an entry beside it
                $at = $owner == null ? null : #entry_of($kind.method_table, $name);
                // An override keeps the declarer, whose marker it had to match: that kind set
                // what the member escapes and may still name it
                $declarer = $kind.declared_at[$name] ?? $kind.name;
                if ($at == null) {
                    $kind.method_table[] = [$name, $kind.name, $kind.vis[$name], $declarer];
                } else {
                    $kind.method_table[$at] = [$name, $kind.name, $kind.vis[$name], $declarer];
                }
                $kind.members[$name] = $kind.name;
                if (has_key($kind.abstract_methods, $name)) {
                    delete $kind.abstract_methods[$name];
                }
            }
        }

        if (!$kind.abstract && $kind.abstract_methods != {}) {
            $name = keys($kind.abstract_methods)[0];
            #fail_at("Kind {$kind.name} must define abstract method {$name} of {$kind.abstract_methods[$name]}, or be abstract", $kind.file, $kind.line);
        }
        #check_interfaces($kind);
        $kind.resolved = true;
    }

    // Every name after implements must be an interface's, and each only once
    fn check_claims() {
        foreach (#interface_claims as [$kind, $scope]) {
            $seen = {};
            foreach ($kind.interfaces as $name) {
                if (!has_key(#interfaces, $name)) {
                    #fail_at(#not_an_interface($name), $kind.file, $kind.line);
                }
                if (has_key($seen, $name)) {
                    #fail_at("Kind {$kind.name} implements {$name} twice", $kind.file, $kind.line);
                }
                $seen[$name] = true;
            }
        }
    }

    // Every interface a resolved kind implements, its parent's first, each once: a child of
    // an implementer is one too
    fn interfaces_of($kind) {
        $all = $kind.parent == null ? [] : #interfaces_of(#kinds[$kind.parent]);
        foreach ($kind.interfaces ?? [] as $name) {
            if (!in_array($name, $all)) {
                $all[] = $name;
            }
        }

        return $all;
    }

    /*
     * A kind has, declared or inherited, every method its interfaces name, each as an override
     * of it would be. An abstract kind may leave one to its children, which are checked in turn,
     * but one it has is checked here. Two of its interfaces may name the same method only with
     * the same signature, since one method must answer for both.
     */
    fn check_interfaces($kind) {
        // Each method named so far, with the interface that named it
        $named = {};
        foreach (#interfaces_of($kind) as $interface) {
            foreach (#interfaces[$interface].methods as $name => $signature) {
                if (has_key($named, $name) && !#same_signature(#interfaces[$named[$name]].methods[$name], $signature)) {
                    #fail_at("Kind {$kind.name} can't implement both {$named[$name]} and {$interface}: they name method {$name} differently", $kind.file, $kind.line);
                }
                $named[$name] ??= $interface;
                #check_implementation($kind, $interface, $signature);
            }
        }
    }

    /*
     * The method of a kind that answers for one an interface names must be pub, since the
     * interface is a promise to any caller, and must fit it as an override fits what it
     * replaces: every argument count, and the same types. An error is at the method, saying
     * which kind's claim it fails when the method is inherited.
     */
    fn check_implementation($kind, $interface, $signature) {
        $name = $signature.name;
        $definer = $kind.members[$name] ?? $kind.abstract_methods[$name] ?? null;
        if ($definer == null) {
            if (#is_enum($kind)) {
                #fail_at("Enum {$kind.name} must define method {$name} of interface {$interface}", $kind.file, $kind.line);
            }
            if (!$kind.abstract) {
                $hidden = has_key($kind.hidden, $name) ? " ({$kind.hidden[$name]}.{$name} is not pub, so it can't)" : "";
                #fail_at("Kind {$kind.name} must define method {$name} of interface {$interface}, or be abstract{$hidden}", $kind.file, $kind.line);
            }

            return;
        }
        $method = #kinds[$definer].methods[$name];
        $claim = $definer == $kind.name ? "" : ", since {$kind.name} implements {$interface}";
        if ($kind.owner_vis[$name] != "pub") {
            #fail_at("Method {$definer}.{$name} must be pub: {$interface}.{$name} is for any caller{$claim}", $method.file, $method.line);
        }
        [$fewest, $most] = #bounds($method.arity);
        [$asked_fewest, $asked_most] = #bounds($signature.arity);
        if ($fewest > $asked_fewest || $most < $asked_most) {
            $expected = $asked_fewest == $asked_most ? $asked_fewest : "{$asked_fewest} to {$asked_most}";
            #fail_at("Method {$definer}.{$name} must accept every argument count {$interface}.{$name} does ({$expected}){$claim}", $method.file, $method.line);
        }
        #check_override_types(#kinds[$definer], $method, $interface, $signature, "an implementation keeps the interface's types{$claim}");
    }

    // Whether two interfaces name a method alike: the same argument counts and the same types
    fn same_signature($mine, $theirs) {
        if (#bounds($mine.arity) != #bounds($theirs.arity)) {
            return false;
        }
        if (!#same_or_none($mine.return_type ?? null, $theirs.return_type ?? null)) {
            return false;
        }
        [$types, $their_types] = [$mine.param_types ?? [], $theirs.param_types ?? []];
        foreach ($mine.params as $i => $_) {
            if (!#same_or_none($types[$i] ?? null, $their_types[$i] ?? null)) {
                return false;
            }
        }

        return true;
    }

    // Whether two types, either of which may be missing, say the same
    fn same_or_none($mine, $theirs) {
        if ($mine == null || $theirs == null) {
            return $mine == $theirs;
        }

        return #same_type($mine, $theirs);
    }

    // An override keeps the parent's types where the parent declares them: the same type on
    // each such parameter and on the return, so code holding the parent's word about a value
    // is never let down by a child's. Where the parent says nothing, the child may say what it
    // likes. The same type rather than a wider or narrower one: the restrictive choice, which
    // can be loosened later without breaking a program.
    fn check_override_types($kind, $method, $owner, $parent, $why = "an override keeps the parent's types") {
        $name = $method.name;
        $types = $method.param_types ?? [];
        foreach ($parent.param_types ?? [] as $i => $type) {
            if ($type == null) {
                continue;
            }
            $mine = $types[$i] ?? null;
            if (!#same_type($mine, $type)) {
                #fail_at("Method {$kind.name}.{$name} must take {$method.params[$i]} as {$type.text()}, as {$owner}.{$name} does: {$why}", $method.file, $method.line);
            }
        }
        $returns = $parent.return_type ?? null;
        $mine = $method.return_type ?? null;
        if ($returns != null && !#same_type($mine, $returns)) {
            #fail_at("Method {$kind.name}.{$name} must return {$returns.text()}, as {$owner}.{$name} does: {$why}", $method.file, $method.line);
        }
    }

    // Whether two declared types admit the same names, in whatever order they were written
    fn same_type($mine, $theirs) {
        if ($mine == null) {
            return false;
        }

        return sort($mine.names) == sort($theirs.names);
    }

    // Check a ##name against the parent of the kind it is written in, and record whose version runs
    fn check_parent_use($node, $kind) {
        if ($kind.parent == null) {
            #fail_at("Cannot use ##{$node.name}: {$kind.name} has no parent kind", $node.file, $node.line);
        }
        $parent = #kinds[$kind.parent];
        $name = $node.name;
        // ##name reaches the parent's version, so the parent must let it escape: neither its
        // own private member nor one of its parents' that it didn't declare again. Asked of the
        // parent, since a child that declares the name itself no longer counts it as hidden.
        if (($parent.owner_vis[$name] ?? null) == "") {
            #fail_at("{$parent.name}::{$name} is not pub, so only {$parent.name} can use it", $node.file, $node.line);
        }
        $hidden = #not_pub($parent, $name);
        if ($hidden != null) {
            #fail_at($hidden, $node.file, $node.line);
        }
        if (has_key($parent.layout, $name)) {
            #fail_at("##{$name} can only reach a method, and {$name} is a field of {$parent.layout[$name]}", $node.file, $node.line);
        }
        if (has_key($parent.abstract_methods, $name)) {
            #fail_at("Cannot use ##{$name}: {$name} is abstract in {$parent.abstract_methods[$name]}", $node.file, $node.line);
        }
        if (!has_key($parent.members, $name)) {
            #fail_at($name == "_" ? "{$parent.name} has no constructor to call with ##_" : "{$parent.name} has no method {$name}", $node.file, $node.line);
        }

        $node.definer = $parent.members[$name];
        if ($node.args != null) {
            $error = #arity_error("Method {$node.definer}.{$name}", #kinds[$node.definer].methods[$name].arity, len($node.args));
            if ($error != null) {
                #fail_at($error, $node.file, $node.line);
            }
        }
    }

    fn names_html() {
        foreach (#uses as [$use, $scope, $_]) {
            // Html's own code names it, which is no reason to compile it in
            $named = $use.name == "Html" || starts_with($use.name, "Html::");
            if ($named && $use.file != #BUILTIN_FILE) {
                return true;
            }
        }
        foreach (#kinds as $kind) {
            if ($kind.parent == "Html") {
                return true;
            }
        }

        return #names_in_a_type("Html");
    }

    // Whether a declared type names $kind, which a builtin kind must then be compiled in for
    fn names_in_a_type($kind) {
        foreach (#type_uses as [$node, $scope]) {
            if (in_array($kind, $node.names)) {
                return true;
            }
        }

        return false;
    }

    // Parse the builtin kinds (Error), before the program, so its kinds can use them
    fn builtin_kinds() {
        [$lexer, $current_token, $file] = [#lexer, #current_token, #file];
        #lexer = Lexer(#BUILTIN_SOURCE);
        #file = #BUILTIN_FILE;
        #current_token = #next_token();
        $kinds = [];
        while (#current_token.type != "EOF") {
            $kinds[] = #kind_declaration();
        }
        [#lexer, #current_token, #file] = [$lexer, $current_token, $file];

        return $kinds;
    }

    // The number of arguments constructing a resolved kind takes: its constructor's, or none
    fn constructor_arity($kind) {
        return has_key($kind.members, "_") ? #kinds[$kind.members["_"]].methods["_"].arity : 0;
    }

    // Check a #name against its kind: the member must exist, a method can't be assigned to, and a call must fit its arity
    //
    // Called methods are checked against the kind the method is written in: a child's
    // version accepts every argument count this one does.
    fn check_member_use($node, $kind, $argc, $assigned, $written, $in_static) {
        $static = #kind_static($kind, $node.name);
        if ($static != null) {
            if ($argc != null && !$kind.static_is_method[$node.name]) {
                #fail_at("#{$node.name} is a static field, not a method", $node.file, $node.line);
            }
            if ($argc == null && $kind.static_is_method[$node.name]) {
                #fail_at("#{$node.name} is a static method: call it, or reach it by name", $node.file, $node.line);
            }
            if ($argc != null) {
                $error = #arity_error("Static method {$static}", #functions[$static], $argc);
                if ($error != null) {
                    #fail_at($error, $node.file, $node.line);
                }
            }
            if (($written || $assigned) && #is_case($static)) {
                #fail_at(#case_never_changes($static), $node.file, $node.line);
            }
            $node.static_name = $static;

            return;
        }
        if ($in_static) {
            #fail_at("#{$node.name} is not static, and a static method has no object", $node.file, $node.line);
        }
        $constant = #kind_constant($kind, $node.name);
        if ($constant != null) {
            if ($written) {
                #fail_at("Cannot change constant #{$node.name}", $node.file, $node.line);
            }
            if ($argc != null) {
                #fail_at("#{$node.name} is a constant, not a method", $node.file, $node.line);
            }
            $node.constant = true;
            $node.value = #constant_value($constant, $node);

            return;
        }
        if (has_key($kind.layout, $node.name)) {
            if (($written || $assigned) && #is_enum($kind)) {
                #fail_at("Cannot change #{$node.name}: an enum's cases never change", $node.file, $node.line);
            }
            $node.field = true;

            return;
        }
        $definer = $kind.members[$node.name] ?? $kind.abstract_methods[$node.name] ?? null;
        if ($definer == null) {
            #fail_at(#not_pub($kind, $node.name) ?? "{$kind.name} has no member #{$node.name}", $node.file, $node.line);
        }
        if ($assigned) {
            #fail_at("Cannot assign to method #{$node.name}", $node.file, $node.line);
        }
        if ($argc != null) {
            $error = #arity_error("Method {$definer}.{$node.name}", #kinds[$definer].methods[$node.name].arity, $argc);
            if ($error != null) {
                #fail_at($error, $node.file, $node.line);
            }
        }
    }

    // What to add to a call's arity error when the call is a tagged string, whose arguments aren't written out
    fn tagged_hint($call) {
        return ($call.tagged ?? false) ? " (a tagged string passes 2: its text parts and its values)" : "";
    }

    // The fewest and most arguments an arity allows
    fn bounds($arity) {
        return type_of($arity) == "int" ? [$arity, $arity] : $arity;
    }

    // What is wrong with a call's argument count, or null if it fits, worded as the VM words it
    fn arity_error($what, $arity, $argc) {
        [$fewest, $most] = #bounds($arity);
        if ($argc >= $fewest && $argc <= $most) {
            return null;
        }
        $expected = match {
            $fewest != $most => "{$fewest} to {$most} arguments",
            $fewest == 1 => "1 argument",
            default => "{$fewest} arguments",
        };

        return "{$what} expects {$expected}, {$argc} given";
    }

    /*
     * Parse top level items until the end of the current file
     * ([namespace_declaration] import_statement* (function_declaration | kind_declaration | constant_declaration | statement)*)
     */
    fn top_level() {
        $statements = [];
        while (#current_token.type != "EOF") {
            $type = #current_token.type;
            if ($type == "NAMESPACE") {
                #namespace_declaration();
            } else if ($type == "IMPORT") {
                foreach (#import_statement() as $imported) {
                    $statements[] = $imported;
                }
            } else if ($type == "INCLUDE") {
                #include_is_gone();
            } else if (in_array($type, ["PUB", "FN", "KIND", "ABSTRACT", "FINAL", "INTERFACE", "ENUM", "CONST"])) {
                #module.declaring = true;
                foreach (#declaration() as $declared) {
                    $statements[] = $declared;
                }
            } else {
                #module.declaring = true;
                #check_statement_allowed();
                $statements[] = #statement();
            }
            #module.started = true;
        }

        return $statements;
    }

    /*
     * Parse a top level declaration ([PUB] (function_declaration | kind_declaration | interface_declaration | enum_declaration | constant_declaration)),
     * giving what it adds to the program's statements
     */
    fn declaration() {
        $pub = #current_token.type == "PUB";
        if ($pub) {
            #eat("PUB");
        }
        $type = #current_token.type;
        if ($type == "FN") {
            return [#function_declaration($pub)];
        }
        if ($type == "KIND" || $type == "ABSTRACT" || $type == "FINAL" || $type == "ENUM") {
            // A static method is a function, so it is spliced in after its kind
            $from = len(#static_functions);
            $statements = [$type == "ENUM" ? #enum_declaration($pub) : #kind_declaration($pub)];
            while ($from < len(#static_functions)) {
                $statements[] = #static_functions[$from];
                $from++;
            }

            return $statements;
        }
        if ($type == "INTERFACE") {
            return [#interface_declaration($pub)];
        }
        if ($type == "CONST") {
            #constant_declaration(null, $pub);

            return [];
        }
        #fail("Expected a function (fn), a kind, an interface, an enum or a constant (const) after pub but found " .. #describe(#current_token));
    }

    /*
     * Only the main file runs code: an imported file only declares, so importing one can't do
     * anything. The main file may be imported too (a cycle back to it), and is then refused
     * once the whole program is read, since its statements can come after the import.
     */
    fn check_statement_allowed() {
        if (!#module.entry) {
            #fail(#STATEMENT_IN_MODULE);
        }
        #main_statement ??= #current_token.line;
    }

    // Parse a namespace declaration (NAMESPACE IDENTIFIER SEMICOLON)
    //
    // At most one, first in its file, and optional: a file without one declares its names
    /*
     * with no namespace. Privacy is per namespace, not per file, so several files of a project
     * can declare the same one and see everything of each other's they import. A namespace
     * belongs to one project, so no other can join it and reach what it keeps private.
     */
    fn namespace_declaration() {
        $token = #current_token;
        #eat("NAMESPACE");
        if (#module.namespace != "") {
            #fail_at("A file can declare at most one namespace", #file, $token.line);
        }
        if (#module.started) {
            #fail_at("namespace must come before everything else in its file", #file, $token.line);
        }
        $name = #current_token.value;
        #eat("IDENTIFIER");
        #eat("SEMICOLON");
        $owner = #namespaces[$name] ?? null;
        if ($owner != null && $owner.root != #module.root) {
            #fail_at("Namespace {$name} is " .. #module_name($owner) .. "'s: " .. #module_name(#module) .. " can't declare it too (a namespace belongs to one project)", #file, $token.line);
        }
        #namespaces[$name] ??= #module;
        #module.namespace = $name;
        #module.reachable[$name] = true;
    }

    // A module as a message names it: a file of the standard library by the path that imports it
    fn module_name($module) {
        return #is_std($module.key) ? "std/" .. slice($module.key, len(STD_DIRECTORY) + 1) : $module.file;
    }

    // include is gone, and says what replaced it, for good: the word stays reserved
    fn include_is_gone() {
        $next = #path_after_include();
        #fail("include is gone: write import \"{$next}\"; (a path is from the project root, or ./ for this file's directory)");
    }

    // The path after the include being refused, or a made up one, for its message
    fn path_after_include() {
        #eat("INCLUDE");

        return #current_token.type == "STRING" ? #current_token.value : "file.gaz";
    }

    /*
     * Parse an import (IMPORT STRING [use_clause] SEMICOLON) and, the first time a module is
     * imported, its top level
     *
     * Only at the top of a file, after its namespace, so a file's first lines say what it
     * depends on. The path is std/NAME.gaz for the standard library, ./ and a path for this
     * file's directory and below, or a path from the project root. The imported file is
     * parsed by this parser, so everything is checked and hoisted as one program; what it
     * declares is seen by the files that import it, and no further. A module already read,
     * or being read (a cycle, which is allowed, since a module only declares), gives nothing
     * again, but this file still sees it.
     */
    fn import_statement() {
        $start = #current_token;
        #eat("IMPORT");
        if (#module.declaring) {
            #fail_at("import must come before the file's declarations and statements", #file, $start.line);
        }
        $path_token = #current_token;
        if ($path_token.type == "STRING_START") {
            // Imports are resolved while parsing, before any variable has a value
            #fail("import paths cannot use interpolation");
        }
        #eat("STRING");
        $use_token = #current_token;
        $names = #current_token.type == "USE" ? #use_clause() : [];
        #eat("SEMICOLON");

        $written = $path_token.value;
        [$key, $text] = #find_module($written, $path_token.line);
        $known = #modules[$key] ?? null;
        $statements = [];
        if ($known == null) {
            $template = ends_with($written, ".gazml");
            $known = #new_module($key);
            if ($template) {
                $text = TemplateTranslator($text, $known.file).translate();
                #templates = true;
            }
            $statements = #read_module($known, $text, $template);
        } else if ($known.entry) {
            #main_imported ??= [#file, $path_token.line, $written];
        }
        #module.imports[$key] = true;
        if ($known.namespace != "") {
            #module.reachable[$known.namespace] = true;
        }
        #add_aliases($names, $known, $written, $use_token.line);

        return $statements;
    }

    // An imported file as a module, its imports from its own directory and project
    fn new_module($key) {
        if (#is_std($key)) {
            return Module($key, $key, STD_DIRECTORY, STD_DIRECTORY, false);
        }
        $directory = directory_of($key);

        return Module($key, #display_path($key), $directory, #find_root($directory) ?? #main_root, false);
    }

    /*
     * The module an import names, as [key, text], or an error at the import's line saying why
     * it can't be imported. The text is read before asking whether the module was read
     * already, so a file that can't be read is an error however often it is imported.
     */
    fn find_module($written, $line) {
        $target = import_target($written, #module.directory, #module.root);
        if ($target.refusal != null) {
            #fail_at("Cannot import \"{$written}\": {$target.refusal}", #file, $line);
        }
        if ($target.std != null) {
            $text = std_source($target.std);
            if ($text == null) {
                #fail_at("Cannot import \"{$written}\": the standard library has no {$target.std}", #file, $line);
            }

            return [STD_DIRECTORY .. "/" .. $target.std, $text];
        }
        if (!file_exists($target.path)) {
            #fail_at("Cannot import \"{$written}\": there is no such file", #file, $line);
        }
        if (is_dir($target.path)) {
            #fail_at("Cannot import \"{$written}\": it is a directory", #file, $line);
        }
        $real = real_path($target.path);
        $key = #module_key($real);
        $text = #read($real);
        if ($text == null) {
            #fail_at("Cannot import \"{$written}\": it can't be read", #file, $line);
        }
        if (!#is_std($key)) {
            #trust_project(#module.root);
            #check_same_project($written, $real, $line);
        }

        return [$key, $text];
    }

    /*
     * A path can't reach into another project, one with its own gaz.json (that is a package), or
     * out of its own by a link: the real path must lie inside the root the importing file's
     * imports are from
     */
    fn check_same_project($written, $real, $line) {
        $root = #find_root(directory_of($real));
        if ($root != null && $root != #module.root) {
            #fail_at("Cannot import \"{$written}\": " .. #display_path($real) .. " belongs to the project at " .. #display_path($root)
                .. " (it has its own gaz.json): a project can't import another's files", #file, $line);
        }
        if (#module.root != "/" && !starts_with($real, #module.root .. "/")) {
            #fail_at("Cannot import \"{$written}\": " .. #display_path($real) .. " is outside the project at " .. #display_path(#module.root)
                .. " (a link leads out of it)", #file, $line);
        }
    }

    // Parse an import's use clause (USE name [AS name] (COMMA name [AS name])*)
    //
    // The names are bare, since the string already said which file they come from, and the
    // clause is the only way to bring a name in unqualified: there is no standalone use, so
    // a file can only name what it imports itself.
    fn use_clause() {
        #eat("USE");
        $names = [];
        while (true) {
            $token = #current_token;
            $name = $token.value;
            #eat("IDENTIFIER");
            if (#current_token.type == "DOUBLE_COLON") {
                #fail("A name in a use clause is bare: the file it comes from is the string before it, so write '{$name}', not '{$name}::...'");
            }
            $alias = $name;
            if (#current_token.type == "AS") {
                #eat("AS");
                $alias = #current_token.value;
                #eat("IDENTIFIER");
            }
            $names[] = [$name, $alias, $token.line];
            if (#current_token.type != "COMMA") {
                return $names;
            }
            #eat("COMMA");
        }
    }

    // Add an import's use clause to this file's aliases, now that the module's namespace is known
    fn add_aliases($names, $imported, $written, $line) {
        $namespace = $imported.namespace;
        if (len($names) > 0 && $namespace == "") {
            #fail_at("{$written} declares no namespace, so there is nothing to use from it", #file, $line);
        }
        foreach ($names as [$name, $alias, $at]) {
            if (has_key(#module.aliases, $alias)) {
                #fail_at("{$alias} is already used in this file", #file, $at);
            }
            #module.aliases[$alias] = "{$namespace}::{$name}";
            #alias_uses[] = ["{$namespace}::{$name}", #file, $at, #scope, $imported.key, $written];
        }
    }

    // Parse the input and return the tree
    pub fn parse() {
        return #program();
    }
}
