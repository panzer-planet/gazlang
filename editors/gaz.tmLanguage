<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>name</key>
	<string>GazLang</string>
	<key>scopeName</key>
	<string>source.gaz</string>
	<key>uuid</key>
	<string>6f1b2b2a-6b0e-4a3a-9f7a-2b7f6a9b0a01</string>
	<key>fileTypes</key>
	<array>
		<string>gaz</string>
	</array>
	<key>patterns</key>
	<array>
		<dict>
			<key>include</key>
			<string>#comments</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#declarations</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#keywords</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#constants</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#numbers</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#members</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#variables</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#builtins</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#classes</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#strings</string>
		</dict>
		<dict>
			<key>include</key>
			<string>#operators</string>
		</dict>
	</array>
	<key>repository</key>
	<dict>
		<key>comments</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>comment.line.double-slash.gaz</string>
					<key>match</key>
					<string>//.*$</string>
				</dict>
				<dict>
					<key>include</key>
					<string>#block-comment</string>
				</dict>
			</array>
		</dict>
		<!-- Block comments nest. The rule includes itself, so an inner /* starts another
		     begin/end pair and the first */ closes only that one, matching the lexer. -->
		<key>block-comment</key>
		<dict>
			<key>name</key>
			<string>comment.block.gaz</string>
			<key>begin</key>
			<string>/\*</string>
			<key>end</key>
			<string>\*/</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#block-comment</string>
				</dict>
			</array>
		</dict>
		<key>declarations</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>match</key>
					<string>\b(fn)\s+([a-zA-Z_][a-zA-Z0-9_]*)</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>storage.type.function.gaz</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.function.gaz</string>
						</dict>
					</dict>
				</dict>
				<dict>
					<key>match</key>
					<string>\b(class)\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\s+(extends)\s+([a-zA-Z_][a-zA-Z0-9_]*))?</string>
					<key>captures</key>
					<dict>
						<key>1</key>
						<dict>
							<key>name</key>
							<string>storage.type.class.gaz</string>
						</dict>
						<key>2</key>
						<dict>
							<key>name</key>
							<string>entity.name.type.class.gaz</string>
						</dict>
						<key>3</key>
						<dict>
							<key>name</key>
							<string>storage.modifier.gaz</string>
						</dict>
						<key>4</key>
						<dict>
							<key>name</key>
							<string>entity.other.inherited-class.gaz</string>
						</dict>
					</dict>
				</dict>
			</array>
		</dict>
		<key>keywords</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>keyword.control.gaz</string>
					<key>match</key>
					<string>\b(echo|if|else|while|for|foreach|as|break|continue|return|match|default|delete|try|catch|finally|include|use)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.type.gaz</string>
					<key>match</key>
					<string>\b(fn|class|interface|const|namespace)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>storage.modifier.gaz</string>
					<key>match</key>
					<string>\b(abstract|extends|implements|final|public|private|protected|pub|static)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>invalid.deprecated.reserved.gaz</string>
					<key>match</key>
					<string>\b(function)\b</string>
				</dict>
			</array>
		</dict>
		<key>constants</key>
		<dict>
			<key>name</key>
			<string>constant.language.gaz</string>
			<key>match</key>
			<string>\b(true|false|null)\b</string>
		</dict>
		<key>numbers</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>constant.numeric.hex.gaz</string>
					<key>match</key>
					<string>\b0[xX][0-9a-fA-F]+\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.float.gaz</string>
					<key>match</key>
					<string>\b\d+(\.\d+([eE][+-]?\d+)?|[eE][+-]?\d+)\b</string>
				</dict>
				<dict>
					<key>name</key>
					<string>constant.numeric.integer.gaz</string>
					<key>match</key>
					<string>\b\d+\b</string>
				</dict>
			</array>
		</dict>
		<key>members</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>variable.other.parent-member.gaz</string>
					<key>match</key>
					<string>##[a-zA-Z_][a-zA-Z0-9_]*</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.other.member.gaz</string>
					<key>match</key>
					<string>#[a-zA-Z_][a-zA-Z0-9_]*</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.other.property.gaz</string>
					<key>match</key>
					<string>(?&lt;!\.)\.[a-zA-Z_][a-zA-Z0-9_]*</string>
				</dict>
			</array>
		</dict>
		<key>variables</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>variable.language.this.gaz</string>
					<key>match</key>
					<string>##?</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.other.global.gaz</string>
					<key>match</key>
					<string>@[a-zA-Z_][a-zA-Z0-9_]*</string>
				</dict>
				<dict>
					<key>name</key>
					<string>variable.other.local.gaz</string>
					<key>match</key>
					<string>\$[a-zA-Z_][a-zA-Z0-9_]*</string>
				</dict>
			</array>
		</dict>
		<key>builtins</key>
		<dict>
			<key>name</key>
			<string>support.function.gaz</string>
			<key>match</key>
			<string>(?&lt;![\w.$@#])\b(len|slice|lower|upper|trim|split|join|replace|contains|starts_with|ends_with|index_of|repeat|chr|ord|to_int|to_float|to_string|floor|ceil|round|abs|intdiv|min|max|in_array|has_key|keys|values|last|reverse|map|filter|reduce|sort|type_of|is_a|class_of|fields|error|exit|read_file|write_file|file_exists|real_path|cwd|print_error|print|read_stdin|args|builtins|rand_int|rand_float|rand_seed|run|socket_open|socket_read|socket_write|socket_close)\b</string>
		</dict>
		<key>classes</key>
		<dict>
			<key>name</key>
			<string>entity.name.type.class.gaz</string>
			<key>match</key>
			<string>(?&lt;![\w.$@#])\b[A-Z][a-zA-Z0-9_]*\b</string>
		</dict>
		<key>strings</key>
		<dict>
			<key>patterns</key>
			<array>
				<dict>
					<key>name</key>
					<string>string.quoted.single.gaz</string>
					<key>begin</key>
					<string>'</string>
					<key>end</key>
					<string>'</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>name</key>
							<string>constant.character.escape.gaz</string>
							<key>match</key>
							<string>\\['\\]</string>
						</dict>
					</array>
				</dict>
				<dict>
					<key>name</key>
					<string>string.quoted.double.gaz</string>
					<key>begin</key>
					<string>"</string>
					<key>end</key>
					<string>"</string>
					<key>patterns</key>
					<array>
						<dict>
							<key>name</key>
							<string>constant.character.escape.gaz</string>
							<key>match</key>
							<string>\\(n|t|r|v|f|e|0|\\|"|\$|\{|x[0-9a-fA-F]{2}|u\{[0-9a-fA-F]{1,6}\})</string>
						</dict>
						<dict>
							<key>name</key>
							<string>meta.embedded.line.gaz</string>
							<key>begin</key>
							<string>\{(?=[$@#])</string>
							<key>end</key>
							<string>\}</string>
							<key>patterns</key>
							<array>
								<dict>
									<key>include</key>
									<string>#braces</string>
								</dict>
								<dict>
									<key>include</key>
									<string>$self</string>
								</dict>
							</array>
						</dict>
						<dict>
							<key>name</key>
							<string>variable.other.local.gaz</string>
							<key>match</key>
							<string>\$[a-zA-Z_][a-zA-Z0-9_]*(\[[^\]]*\])?</string>
						</dict>
					</array>
				</dict>
			</array>
		</dict>
		<!-- A map literal inside "{$...}" has braces of its own; the interpolation ends at the }
		     that matches its {, as in the lexer, so they nest the way block comments do -->
		<key>braces</key>
		<dict>
			<key>begin</key>
			<string>\{</string>
			<key>end</key>
			<string>\}</string>
			<key>patterns</key>
			<array>
				<dict>
					<key>include</key>
					<string>#braces</string>
				</dict>
				<dict>
					<key>include</key>
					<string>$self</string>
				</dict>
			</array>
		</dict>
		<key>operators</key>
		<dict>
			<key>name</key>
			<string>keyword.operator.gaz</string>
			<key>match</key>
			<string>\?\?=?|&lt;=&gt;|&lt;&lt;=?|&gt;&gt;=?|\.\.\.|\.\.=?|-&gt;|=&gt;|\+\+|--|&amp;&amp;|\|\||[+\-*/%&amp;|^]=?|[&lt;&gt;]=?|[!=]=|=|[!?:~]</string>
		</dict>
	</dict>
</dict>
</plist>
