{
  "name": "GazLang",
  "scopeName": "source.gaz",
  "fileTypes": ["gaz"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#variables" },
    { "include": "#strings" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.gaz", "match": "//.*$" },
        { "name": "comment.block.gaz", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.gaz",
          "match": "\\b(if|else|while|for|foreach|as|break|continue|return|try|catch|include)\\b"
        },
        {
          "name": "storage.type.function.gaz",
          "match": "\\b(function|class)\\b"
        }
      ]
    },
    "constants": {
      "name": "constant.language.gaz",
      "match": "\\b(true|false|null)\\b"
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.gaz", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        {
          "name": "constant.numeric.float.gaz",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.language.this.gaz", "match": "##?" },
        { "name": "variable.other.global.gaz", "match": "@[a-zA-Z_][a-zA-Z0-9_]*" },
        { "name": "variable.other.local.gaz", "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.single.gaz",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.gaz", "match": "\\\\['\\\\]" }]
        },
        {
          "name": "string.quoted.double.gaz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.gaz",
              "match": "\\\\(n|t|r|v|f|e|0|\\\\|\"|\\$|\\{|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]{1,6}\\})"
            },
            {
              "name": "meta.embedded.line.gaz",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [{ "include": "$self" }]
            },
            { "name": "variable.other.local.gaz", "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*(\\[[^\\]]*\\])?" },
            { "name": "variable.other.global.gaz", "match": "@[a-zA-Z_][a-zA-Z0-9_]*(\\[[^\\]]*\\])?" }
          ]
        }
      ]
    },
    "operators": {
      "name": "keyword.operator.gaz",
      "match": "\\?\\?=?|<=>|\\.\\.=?|->|<<|>>|[+\\-*/%]=?|&&|\\|\\||[<>]=?|[!=]=|=|!|\\?|:"
    }
  }
}
