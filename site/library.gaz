/**
 * What a file of the standard library offers, read from its source: the names it marks pub
 * (and the constructors and pub members of its pub kinds), each with its declaration and its
 * docblock, and the file's overview. The declarations and docblocks are the compiler's
 * outline of the source (compiler/docblocks.gaz), which the language server reads too, so
 * nothing is listed by hand and a new pub name appears on its page by itself. A plain comment
 * is the source's, not the page's: only a docblock is shown.
 *
 *   $library = library::read("csv", read_file("lib/csv.gaz"));
 *   echo $library.entries[0].name;                // "parse"
 */
namespace library;

import "compiler/docblocks.gaz" use outline, Declaration;
import "./highlight.gaz";
import "std/text.gaz";

/**
 * A name a library page lists: a pub function, kind or constant, or a pub kind's constructor or
 * pub member, with its members if it is a kind
 */
pub kind Entry {
    // A kind's constructor and pub members, in source order
    pub list #members = [];

    /*
     * $what says what it is ("function", "static method"...), $signature is the declaration's
     * highlighted pieces, from its first word up to its body or the end of the statement, $doc
     * its docblock's text ("" without one) and $line where it is in the source
     */
    fn _(pub string #what, pub string #name, pub list #signature, pub string #doc, pub int #line = 0) {}
}

/**
 * A file of the library: its name, its namespace, its overview, and its entries
 */
pub kind Library {
    fn _(pub string #name, pub string #namespace, pub string #comment, pub list #entries) {}
}

/**
 * A file of the library by its name ("csv") and source
 */
pub fn read(string $name, string $source): Library {
    $outline = outline($source);
    $entries = [];
    // The entry of the pub kind whose members are being read, if any
    $kind = null;
    foreach ($outline.declarations as $declaration) {
        if ($declaration.owner == null) {
            $kind = null;
            if ($declaration.pub) {
                $entry = entry($declaration);
                $entries[] = $entry;
                $kind = $declaration.what == Declaration::KIND ? $entry : null;
            }
        } else if ($kind != null && is_listed_member($declaration)) {
            $kind.members[] = entry($declaration);
        }
    }

    return Library($name, $outline.namespace ?? "", $outline.overview ?? "", $entries);
}

// A pub member, or the constructor, which escapes whatever it says
fn is_listed_member(Declaration $declaration): bool {
    return $declaration.pub || $declaration.what == Declaration::CONSTRUCTOR;
}

fn entry(Declaration $declaration): Entry {
    $signature = highlight::gaz($declaration.signature);

    return Entry($declaration.what, $declaration.name, $signature, $declaration.doc ?? "", $declaration.line);
}

/**
 * A docblock's text as Markdown. Docblocks are Markdown (`code`, *emphasis*, lists, links), read
 * without backslash escapes, since a backslash in one means itself (the site renders them
 * with markdown::Renderer's $escapes off). What Markdown would take for an indented code block
 * is an example indented under a blank line, which becomes a fenced GazLang block here.
 */
pub fn comment_markdown(string $text): string {
    $out = [];
    $code = [];
    $after_blank = true;
    $in_list = false;
    foreach (split($text, "\n") as $line) {
        $indent = text::indentation($line);
        $blank = trim($line) == "";
        if (len($code) > 0 && ($blank || $indent >= 2)) {
            $code[] = $line;
            continue;
        }
        if (len($code) > 0) {
            $out = [...$out, ...code_block($code)];
            $code = [];
        }
        if (!$blank && $indent >= 2 && $after_blank && !$in_list) {
            $code[] = $line;
            continue;
        }
        $out[] = $line;
        $in_list = !$blank && (starts_with($line, "- ") || $in_list && $indent >= 2);
        $after_blank = $blank;
    }
    if (len($code) > 0) {
        $out = [...$out, ...code_block($code)];
    }

    return join($out, "\n");
}

// Indented lines as a fenced GazLang block, less their common indentation
fn code_block(list $lines): list {
    while (trim(last($lines)) == "") {
        delete $lines[len($lines) - 1];
    }
    $written = filter($lines, $line -> trim($line) != "");
    $indent = min(map($written, $line -> text::indentation($line)));

    return ["```gaz", ...map($lines, $line -> slice($line, min($indent, len($line)))), "```", ""];
}

/**
 * The first paragraph of a docblock's text, joined into one line
 */
pub fn summary(string $text): string {
    $first = split($text .. "\n\n", "\n\n")[0];

    return join(map(split($first, "\n"), $line -> trim($line)), " ");
}
