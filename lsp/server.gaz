/*
 * A Language Server Protocol server for GazLang, over stdio, as every editor spawns one:
 * diagnostics (parse and lex errors), hover (a builtin's arity, or a declaration's signature and
 * docblock), go-to-definition, completion, import links and quick fixes. bin/gaz lsp/server.gaz
 *
 * namespace gazlang, not its own: this reuses the compiler's own Parser, which is private to
 * that namespace (as a test of the internals does; see CLAUDE.md). The lexer is std/syntax.gaz.
 */
namespace gazlang;

import "compiler/parser.gaz";
import "compiler/docblocks.gaz";
import "std/json.gaz" use decode, encode;
import "std/chars.gaz" use char_at, is_alnum, span;
import "std/regex.gaz";
import "std/http.gaz";
import "std/syntax.gaz" use Lexer;

/*
 * The lexer's own keywords (Lexer::KEYWORDS), in its order, minus the ones the parser only
 * refuses (Parser::RESERVED, and Parser::REMOVED, which are gone): completing one of those
 * would just teach an error
 */
fn keywords() {
    $refused = [...Parser::RESERVED, ...Parser::REMOVED];
    return filter(keys(Lexer::KEYWORDS), $word -> !in_array(Lexer::KEYWORDS[$word], $refused));
}

/* A message framed with a Content-Length header, as every LSP transport uses, read and
 * written over standard input and output */
kind Connection {
    // The next message, or null at the end of the stream
    pub fn read() {
        $length = null;
        while (true) {
            $line = read_line();
            if ($line == null) {
                return null;
            }
            if ($line == "") {
                break;
            }
            if (starts_with($line, "Content-Length: ")) {
                $length = to_int(slice($line, len("Content-Length: ")), null);
            }
            // Any other header (Content-Type, say) is skipped: nothing else is used
        }
        if ($length == null) {
            throw "LSP error: a message with no Content-Length header";
        }
        return decode(read_stdin_bytes($length));
    }

    // A notification or response
    pub fn write($message) {
        $body = encode($message);
        print("Content-Length: " .. len($body) .. "\r\n\r\n" .. $body);
    }
}

/*
 * A file:// URI to the real path it names, for the parser to resolve its imports from, or null
 * (piped-source rules: imports from the server's own working directory and its project) for
 * anything else, an unsaved document included
 */
fn path_from_uri($uri) {
    if (!starts_with($uri, "file://")) {
        return null;
    }
    return http::url_decode(slice($uri, len("file://")));
}

// The whole extent of one line, as a range, for a diagnostic or a definition to point at
fn whole_line($lines, $at) {
    return {"start" => {"line" => $at, "character" => 0}, "end" => {"line" => $at, "character" => len($lines[$at])}};
}

/*
 * The diagnostics for one document's text: a syntax error, if any, else none. ponytail: only
 * ever one diagnostic, the first the parser hits; a parser that recovered past the first
 * error would give more.
 */
fn diagnostics($text, $uri) {
    $path = path_from_uri($uri);
    try {
        Parser(Lexer($text), $path).parse();
        return [];
    } catch (ParseError $e) {
        $lines = split($text, "\n");
        if ($e.source_file == $path) {
            $at = max(0, min($e.source_line - 1, len($lines) - 1));
            $message = $e.reason;
        } else {
            $at = import_line($lines, $path, $e.source_file);
            $message = "in {$e.source_file}:{$e.source_line}: {$e.reason}";
        }
        return [{
            "range" => whole_line($lines, $at),
            "severity" => 1, // Error
            "source" => "gazlang",
            "message" => $message,
        }];
    } catch (Error $e) {
        /* Running out of call depth on deeply nested source, say: not a syntax error with a
         * line of its own, but still worth a diagnostic rather than killing the server */
        return [{
            "range" => {"start" => {"line" => 0, "character" => 0}, "end" => {"line" => 0, "character" => 0}},
            "severity" => 1,
            "source" => "gazlang",
            "message" => $e.message,
        }];
    }
}

fn publish($connection, $uri, $text) {
    $connection.write({
        "jsonrpc" => "2.0",
        "method" => "textDocument/publishDiagnostics",
        "params" => {"uri" => $uri, "diagnostics" => diagnostics($text, $uri)},
    });
}

fn respond($connection, $id, $result) {
    $connection.write({"jsonrpc" => "2.0", "id" => $id, "result" => $result});
}

// Opened or changed: keep the text, for hover to look at later, and diagnose it
fn open_or_change($connection, $uri, $text) {
    @documents[$uri] = $text;
    publish($connection, $uri, $text);
}

// The identifier touching $character of $line, or null: scans left and right through word
// characters, so a cursor anywhere in or right after a name finds all of it
fn word_at($line, $character) {
    $is_word = $c -> is_alnum($c) || $c == "_";
    $at = $is_word(char_at($line, $character)) ? $character : $character - 1;
    while ($is_word(char_at($line, $at - 1))) {
        $at--;
    }
    $length = span($line, $at, $is_word);
    return $length == 0 ? null : slice($line, $at, $length);
}

fn plural($n, $word) {
    return $n == 1 ? "1 {$word}" : "{$n} {$word}s";
}

// builtins() maps a name to its argument count, or [fewest, most] when some are optional
fn describe_arity($arity) {
    if (type_of($arity) == "list") {
        return $arity[0] == $arity[1] ? plural($arity[0], "argument") : "{$arity[0]} to {$arity[1]} arguments";
    }
    return plural($arity, "argument");
}

/*
 * A hover result for the word under the cursor: a builtin's arity from builtins(), or the
 * signature and docblock of what the document declares by that name, or a file it imports
 * (found as definition() finds it). Read with the compiler's lexer, not from the parsed tree:
 * the tree doesn't exist while the document has a syntax error elsewhere, which is the common
 * case while it is being edited, and the lexer reads what is above a mistake.
 */
fn hover($uri, $position) {
    $text = @documents[$uri] ?? null;
    if ($text == null) {
        return null;
    }
    $word = word_at(text_line($text, $position["line"]), $position["character"]);
    if ($word == null) {
        return null;
    }
    $builtins = builtins();
    if (has_key($builtins, $word)) {
        return {"contents" => {"kind" => "markdown", "value" => "**{$word}** \u{2014} builtin, " .. describe_arity($builtins[$word])}};
    }
    $found = find_declaration(reachable_files(path_from_uri($uri), $text), $word);
    if ($found == null) {
        return null;
    }
    $declaration = $found[1];
    $value = "```gaz\n{$declaration.signature}\n```";
    if ($declaration.doc != null) {
        $value ..= "\n\n" .. $declaration.doc;
    }
    return {"contents" => {"kind" => "markdown", "value" => $value}};
}

/*
 * The outline of a file's text (compiler/docblocks.gaz), kept until the text changes, so a
 * hover or completion lexes only what changed since the last one
 */
fn outline_of($key, $text) {
    $cached = @outlines[$key] ?? null;
    if ($cached != null && $cached[0] == $text) {
        return $cached[1];
    }
    $outline = ends_with($key, ".gazml") ? Outline(null, null, []) : outline($text);
    @outlines[$key] = [$text, $outline];
    return $outline;
}

// A file a document reaches, with its text and outline
kind ReachableFile {
    fn _(pub #path, pub #text, pub #outline) {}
}

/*
 * The files a document can reach by name, as ReachableFiles: itself first (its own,
 * possibly unsaved, text), then what it imports, directly or not, each once (a cycle of
 * imports ends where it comes back). An unsaved document reaches only itself.
 */
fn reachable_files($path, $text) {
    $files = [ReachableFile($path, $text, outline_of($path ?? "", $text))];
    if ($path == null) {
        return $files;
    }
    $root = root_of($path);
    $visited = [$path];
    $i = 0;
    while ($i < len($files)) {
        $file = $files[$i];
        foreach (imported_paths($file.path, $file.outline.imports, $root) as $imported) {
            if (!in_array($imported, $visited)) {
                $visited[] = $imported;
                $imported_text = read_file($imported);
                $files[] = ReachableFile($imported, $imported_text, outline_of($imported, $imported_text));
            }
        }
        $i++;
    }
    return $files;
}

/*
 * The first declaration named $name in $files, as [ReachableFile, Declaration]: a function,
 * kind or constant first, and failing those a member of a kind (a method, a field)
 */
fn find_declaration($files, $name) {
    foreach ([true, false] as $top_level) {
        foreach ($files as $file) {
            foreach ($file.outline.declarations as $declaration) {
                if ($declaration.name == $name && ($declaration.owner == null) == $top_level) {
                    return [$file, $declaration];
                }
            }
        }
    }
    return null;
}

// A real path to the file:// URI that names it, percent-encoding each segment on its own so a
// literal / in the path stays a separator (http::url_encode would escape it as anyone else's)
fn uri_from_path($path) {
    return "file://" .. join(map(split($path, "/"), http::url_encode), "/");
}

/*
 * The real paths a file's imports name ($imports, as an Outline has them), resolved as the
 * compiler resolves them from $path (import_target() in compiler/parser.gaz: ./ from its directory, anything else from
 * its project root, $root when no gaz.json is above it), for those that exist on disk. A std/
 * import isn't a file, and is skipped: only a program's own files can be followed this way.
 */
fn imported_paths($path, $imports, $root) {
    $directory = directory_of($path);
    $paths = [];
    foreach ($imports as $import) {
        $target = import_target($import, $directory, project_root($directory) ?? $root);
        if ($target.path != null && file_exists($target.path) && !is_dir($target.path)) {
            $paths[] = real_path($target.path);
        }
    }
    return $paths;
}

// The project root the document's imports are from: its own, or its directory without one
fn root_of($path) {
    $directory = directory_of($path);
    return project_root($directory) ?? $directory;
}

/*
 * The zero-based line of the document's import of $file, where an error in that file is shown;
 * the first line when the document reaches it only through another file (or is unsaved)
 */
fn import_line($lines, $path, $file) {
    if ($path == null || $file == null) {
        return 0;
    }
    $target = real_path($file);
    $root = root_of($path);
    foreach ($lines as $i => $line) {
        // Only a line that is an import, as the lexer reads it: not a comment or a string that says one
        if (starts_with(trim($line), "import ") && in_array($target, imported_paths($path, outline($line).imports, $root))) {
            return $i;
        }
    }
    return 0;
}

// The completion item kind for what a declaration is: a Function, Class, Interface or Constant
const COMPLETION_KINDS = {"function" => 3, "kind" => 7, "interface" => 8, "enum" => 13, "constant" => 21};

/*
 * A completion for each function, kind and constant declared in $files (the same reach
 * definition() searches), each name once even if declared more than once reachably, with the
 * first line of its docblock as its detail and the whole of it as its documentation. Further
 * than the compiler lets a file see, which only its own imports: a completion of a name the file
 * must still import is a nudge, not a mistake.
 */
fn declared_names($files) {
    $items = [];
    $seen = {};
    foreach ($files as $file) {
        foreach ($file.outline.declarations as $declaration) {
            if ($declaration.owner != null || has_key($seen, $declaration.name)) {
                continue;
            }
            $seen[$declaration.name] = true;
            $items[] = completion_item($declaration);
        }
    }
    return $items;
}

fn completion_item($declaration) {
    $item = {"label" => $declaration.name, "kind" => COMPLETION_KINDS[$declaration.what]};
    if ($declaration.doc != null) {
        $item["detail"] = split($declaration.doc, "\n")[0];
        $item["documentation"] = {"kind" => "markdown", "value" => $declaration.doc};
    }
    return $item;
}

/*
 * The document's imports as links an editor can follow: for each import "path"; line, the range
 * of the path inside its quotes and the file it names. A path with no file to open (std/, which is
 * built in) or none on disk is left out.
 */
fn document_links($uri) {
    $text = @documents[$uri] ?? null;
    $path = path_from_uri($uri);
    if ($text == null || $path == null) {
        return [];
    }
    $directory = directory_of($path);
    $root = root_of($path);
    $links = [];
    foreach (split($text, "\n") as $number => $line) {
        $found = regex::groups($line, '^[ \t]*import[ \t]+"([^"]*)"');
        if ($found == null) {
            continue;
        }
        $target = import_target($found[1], $directory, $root);
        if ($target.path == null || !file_exists($target.path) || is_dir($target.path)) {
            continue;
        }
        $start = index_of($line, '"') + 1;
        $links[] = {
            "range" => {
                "start" => {"line" => $number, "character" => $start},
                "end" => {"line" => $number, "character" => $start + len($found[1])},
            },
            "target" => uri_from_path(real_path($target.path)),
        };
    }
    return $links;
}

// The path typed so far inside an import's string, up to the cursor, or null anywhere else
fn import_prefix($text, $position) {
    $before = slice(text_line($text, $position["line"]), 0, $position["character"]);
    $found = regex::groups($before, '^[ \t]*import[ \t]+"([^"]*)$');
    return $found == null ? null : $found[1];
}

/*
 * What can follow an import path typed so far: the .gaz and .gazml files and the folders of the
 * directory it names, from the file's own directory after ./ and from its project root
 * otherwise, and ./ and std/ to begin with. std/ has no directory to list, since it is built in.
 */
fn import_completions($path, $prefix) {
    $steps = split($prefix, "/");
    $folders = slice($steps, 0, -1);
    $here = root_of($path);
    if ($folders != [] && $folders[0] == ".") {
        $here = directory_of($path);
        $folders = slice($folders, 1);
    }
    if ($folders == [] && !contains($prefix, "/")) {
        $items = [{"label" => "./", "kind" => 19}, {"label" => "std/", "kind" => 19}]; // Folder
    } else {
        $items = [];
    }
    if ($folders != [] && $folders[0] == "std") {
        return $items;
    }
    foreach ($folders as $folder) {
        $here = join_path($here, $folder);
    }
    if (!is_dir($here)) {
        return $items;
    }
    foreach (list_dir($here) as $name) {
        if (starts_with($name, ".")) {
            continue;
        }
        if (is_dir(join_path($here, $name))) {
            $items[] = {"label" => $name .. "/", "kind" => 19};
        } else if (ends_with($name, ".gaz") || ends_with($name, ".gazml")) {
            $items[] = {"label" => $name, "kind" => 17}; // File
        }
    }
    return $items;
}

/*
 * Completions: the language's keywords, every builtin with its arity, and every function this
 * document can reach by name (itself and what it imports, directly or not). No filtering by
 * what is typed so far: editors filter a completion list against the prefix themselves. Inside
 * the string of an import, the files it could name instead.
 */
fn completions($uri, $position = null) {
    $document = @documents[$uri] ?? null;
    $path = path_from_uri($uri);
    if ($document != null && $position != null) {
        $prefix = import_prefix($document, $position);
        if ($prefix != null) {
            return $path == null ? [] : import_completions($path, $prefix);
        }
    }
    $items = map(keywords(), $word -> ({"label" => $word, "kind" => 14})); // Keyword
    foreach (builtins() as $name => $arity) {
        $items[] = {"label" => $name, "kind" => 3, "detail" => describe_arity($arity)}; // Function
    }
    if ($document != null) {
        $items = [...$items, ...declared_names(reachable_files($path, $document))];
    }
    return $items;
}

/*
 * Where the word under the cursor is declared, in this document or a file it imports (directly
 * or not), as find_declaration() finds it: the whole of the declaration's first line. A builtin
 * has no source to jump to and gives no result.
 */
fn definition($uri, $position) {
    $path = path_from_uri($uri);
    $text = @documents[$uri] ?? null;
    if ($path == null || $text == null) {
        return null;
    }
    $word = word_at(text_line($text, $position["line"]), $position["character"]);
    if ($word == null) {
        return null;
    }
    $found = find_declaration(reachable_files($path, $text), $word);
    if ($found == null) {
        return null;
    }
    [$file, $declaration] = $found;
    return {"uri" => uri_from_path($file.path), "range" => whole_line(split($file.text, "\n"), $declaration.line - 1)};
}

// The line at $at of $text, or "" past its end
fn text_line($text, $at) {
    $lines = split($text, "\n");
    return $lines[$at] ?? "";
}

// How many UTF-16 code units $text is, which is what an LSP position's character counts
fn utf16_length($text) {
    if (!utf8_valid($text)) {
        return len($text);
    }
    $units = utf8_length($text);
    if ($units == len($text)) {
        return $units;
    }
    foreach (utf8_chars($text) as $char) {
        // A character of four bytes is outside the Basic Multilingual Plane: two code units
        if (len($char) == 4) {
            $units++;
        }
    }
    return $units;
}

// The byte offset in $line that $units UTF-16 code units from its start reach
fn byte_offset($line, $units) {
    if (!utf8_valid($line)) {
        return min($units, len($line));
    }
    $offset = 0;
    foreach (utf8_chars($line) as $char) {
        $units -= len($char) == 4 ? 2 : 1;
        if ($units < 0) {
            break;
        }
        $offset += len($char);
    }
    return $offset;
}

/*
 * Where each line of a document starts, to turn the byte offsets the lexer gives (span()) into
 * LSP positions, whose character counts UTF-16 code units, and back
 */
kind Positions {
    #starts = [0];

    fn _(#text) {
        $at = index_of(#text, "\n");
        while ($at != null) {
            #starts[] = $at + 1;
            $at = $at + 1 < len(#text) ? index_of(#text, "\n", $at + 1) : null;
        }
    }

    // The position of byte $offset, as {"line", "character"}
    pub fn at($offset) {
        $line = #line_of($offset);
        $start = #starts[$line];
        return {"line" => $line, "character" => utf16_length(slice(#text, $start, $offset - $start))};
    }

    // The byte offset of an LSP position; one past the text's end is its end
    pub fn offset($position) {
        $line = $position["line"];
        if ($line >= len(#starts)) {
            return len(#text);
        }
        $start = #starts[$line];
        $stop = $line + 1 < len(#starts) ? #starts[$line + 1] - 1 : len(#text);
        return $start + byte_offset(slice(#text, $start, $stop - $start), $position["character"]);
    }

    // The range between two byte offsets
    pub fn range($start, $stop) {
        return {"start" => #at($start), "end" => #at($stop)};
    }

    // The zero-based line byte $offset is on, by bisection
    fn line_of($offset) {
        $low = 0;
        $high = len(#starts) - 1;
        while ($low < $high) {
            $middle = ($low + $high + 1) >> 1;
            if (#starts[$middle] <= $offset) {
                $low = $middle;
            } else {
                $high = $middle - 1;
            }
        }
        return $low;
    }
}

/*
 * The hints in the compiler's own messages that name their fix exactly: an import to add
 * (import_hint() in compiler/parser.gaz) and a keyword to write instead (keyword_hint() and
 * undefined_hint()). Read from the message rather than worked out again here, so a quick fix
 * can't disagree with the error it answers: the compiler already chose the import's spelling (std/, ./ or
 * from the project root), and the tests/corpora recordings hold the wording byte for byte.
 */
const IMPORT_HINT = 'add import "([^"]+)";\)$';
const KEYWORD_HINT = '\(keywords are lowercase: write \'([a-z]+)\', not \'([A-Za-z_][A-Za-z0-9_]*)\'\)$';
const ELSE_IF_HINT = '\(write \'(else if)\', not \'([A-Za-z_][A-Za-z0-9_]*)\'\)$';
// A diagnostic for a mistake in a file the document imports (see diagnostics()), whose fix is that file's
const ELSEWHERE = '^in .*:[0-9]+: ';

/*
 * The quick fixes for the diagnostics a client sends back with a codeAction request: one for
 * each diagnostic of ours whose message names its fix, as a CodeAction with its edit
 */
fn code_actions($uri, $diagnostics) {
    $text = @documents[$uri] ?? null;
    if ($text == null) {
        return [];
    }
    $actions = [];
    foreach ($diagnostics as $diagnostic) {
        $message = $diagnostic["message"];
        if (($diagnostic["source"] ?? null) != "gazlang" || regex::search($message, ELSEWHERE)) {
            continue;
        }
        $fix = import_fix($text, $message) ?? keyword_fix($text, $message, $diagnostic["range"]["start"]["line"]);
        if ($fix != null) {
            [$title, $edit] = $fix;
            $actions[] = {
                "title" => $title,
                "kind" => "quickfix",
                "diagnostics" => [$diagnostic],
                "isPreferred" => true,
                "edit" => {"changes" => {$uri => [$edit]}},
            };
        }
    }
    return $actions;
}

// [title, edit] adding the import a message names, or null
fn import_fix($text, $message) {
    $found = regex::groups($message, IMPORT_HINT);
    if ($found == null) {
        return null;
    }
    $at = {"line" => import_insertion_line($text), "character" => 0};
    return ["Add import \"{$found[1]}\"", {"range" => {"start" => $at, "end" => $at}, "newText" => "import \"{$found[1]}\";\n"}];
}

/*
 * The zero-based line a new import goes on: below the last import, else below the namespace
 * line, else at the top (below a script's #! line)
 */
fn import_insertion_line($text) {
    $line = starts_with($text, "#!") ? 1 : 0;
    $tokens = source_tokens($text);
    foreach ($tokens as $i => $token) {
        if ($token.type == "IMPORT" || $token.type == "NAMESPACE") {
            $end = $i;
            while ($end < len($tokens) && $tokens[$end].type != "SEMICOLON") {
                $end++;
            }
            if ($end < len($tokens)) {
                // A token's line counts from 1, so the line after the ; is its line counted from 0
                $line = $tokens[$end].line;
            }
        }
    }
    return $line;
}

/*
 * [title, edit] writing the keyword a message names in place of the name written, or null: the
 * last name so written at or before the diagnostic's line, since the compiler's hint can be about
 * the token before the one it stopped at, or the start of the statement
 */
fn keyword_fix($text, $message, $line) {
    $found = regex::groups($message, KEYWORD_HINT) ?? regex::groups($message, ELSE_IF_HINT);
    if ($found == null) {
        return null;
    }
    [$whole, $right, $wrong] = $found;
    $written = null;
    foreach (source_tokens($text) as $token) {
        if ($token.line > $line + 1) {
            break;
        }
        if (in_array($token.type, ["IDENTIFIER", "TAG"]) && $token.value == $wrong) {
            $written = $token;
        }
    }
    if ($written == null) {
        return null;
    }
    $range = Positions($text).range($written.start, $written.stop);
    return ["Write '{$right}'", {"range" => $range, "newText" => $right}];
}

@documents = {}; // uri -> text, for hover and definition; didOpen and didChange fill it
@outlines = {};  // path -> [text, Outline], see outline_of()

$connection = Connection();
while (true) {
    $message = $connection.read();
    if ($message == null) {
        break;
    }
    $method = $message["method"] ?? null;
    $params = $message["params"] ?? {};

    /*
     * A message shaped other than a handler expects (params missing a key a real client
     * always sends, say) is an error response for a request, and just dropped for a
     * notification, either way not the end of the server: one bad message shouldn't cost
     * every document open in the session.
     */
    try {
        match ($method) {
            "initialize" => respond($connection, $message["id"], {
                "capabilities" => {
                    // Full sync only: a change replaces the whole text, the simplest that works
                    "textDocumentSync" => 1,
                    "hoverProvider" => true,
                    "definitionProvider" => true,
                    "completionProvider" => {},
                    "documentLinkProvider" => {},
                    "codeActionProvider" => {"codeActionKinds" => ["quickfix"]},
                },
            }),
            "shutdown" => respond($connection, $message["id"], null),
            "exit" => exit(0),
            "textDocument/didOpen" => open_or_change($connection, $params["textDocument"]["uri"], $params["textDocument"]["text"]),
            "textDocument/didChange" => open_or_change(
                $connection,
                $params["textDocument"]["uri"],
                last($params["contentChanges"])["text"]
            ),
            "textDocument/hover" => respond($connection, $message["id"], hover($params["textDocument"]["uri"], $params["position"])),
            "textDocument/definition" => respond($connection, $message["id"], definition($params["textDocument"]["uri"], $params["position"])),
            "textDocument/completion" => respond($connection, $message["id"], completions($params["textDocument"]["uri"], $params["position"] ?? null)),
            "textDocument/documentLink" => respond($connection, $message["id"], document_links($params["textDocument"]["uri"])),
            "textDocument/codeAction" => respond($connection, $message["id"], code_actions($params["textDocument"]["uri"], $params["context"]["diagnostics"])),
            default => has_key($message, "id")
                ? $connection.write({
                    "jsonrpc" => "2.0",
                    "id" => $message["id"],
                    "error" => {"code" => -32601, "message" => "Method not found: {$method}"},
                })
                /* An unhandled notification (initialized, textDocument/didClose, ...) is
                 * ignored, as the protocol allows */
                : null,
        }
    } catch (Error $e) {
        if (has_key($message, "id")) {
            $connection.write({"jsonrpc" => "2.0", "id" => $message["id"], "error" => {"code" => -32603, "message" => $e.message}});
        }
    }
}
