/*
 * A Language Server Protocol server for GazLang, over stdio, as every editor spawns one:
 * diagnostics (parse and lex errors), hover (a builtin's arity, or a declaration's signature and
 * docblock), go-to-definition, completion, import links, quick fixes, the outline, signature
 * help and semantic tokens. bin/gaz lsp/server.gaz
 *
 * namespace gazlang, not its own: this reuses the compiler's own Parser, which is private to
 * that namespace (as a test of the internals does; see CLAUDE.md). The lexer is std/syntax.gaz.
 */
namespace gazlang;

import "compiler/parser.gaz";
import "compiler/docblocks.gaz";
import "std/json.gaz" use decode, encode;
import "std/chars.gaz" use char_at, is_alnum, span;
import "std/regex.gaz";
import "std/http.gaz";
import "std/syntax.gaz" use Lexer;

/*
 * The lexer's own keywords (Lexer::KEYWORDS), in its order, minus the ones the parser only
 * refuses (Parser::RESERVED, and Parser::REMOVED, which are gone): completing one of those
 * would just teach an error
 */
fn keywords() {
    $refused = [...Parser::RESERVED, ...Parser::REMOVED];
    return filter(keys(Lexer::KEYWORDS), $word -> !in_array(Lexer::KEYWORDS[$word], $refused));
}

/* A message framed with a Content-Length header, as every LSP transport uses, read and
 * written over standard input and output */
kind Connection {
    // The next message, or null at the end of the stream
    pub fn read() {
        $length = null;
        while (true) {
            $line = read_line();
            if ($line == null) {
                return null;
            }
            if ($line == "") {
                break;
            }
            if (starts_with($line, "Content-Length: ")) {
                $length = to_int(slice($line, len("Content-Length: ")), null);
            }
            // Any other header (Content-Type, say) is skipped: nothing else is used
        }
        if ($length == null) {
            throw "LSP error: a message with no Content-Length header";
        }
        return decode(read_stdin_bytes($length));
    }

    // A notification or response
    pub fn write($message) {
        $body = encode($message);
        print("Content-Length: " .. len($body) .. "\r\n\r\n" .. $body);
    }
}

/*
 * A file:// URI to the real path it names, for the parser to resolve its imports from, or null
 * (piped-source rules: imports from the server's own working directory and its project) for
 * anything else, an unsaved document included
 */
fn path_from_uri($uri) {
    if (!starts_with($uri, "file://")) {
        return null;
    }
    return http::url_decode(slice($uri, len("file://")));
}

// The whole extent of one line, as a range, for a diagnostic or a definition to point at
fn whole_line($lines, $at) {
    return {"start" => {"line" => $at, "character" => 0}, "end" => {"line" => $at, "character" => len($lines[$at])}};
}

/*
 * The diagnostics for one document's text: a syntax error, if any, else none. ponytail: only
 * ever one diagnostic, the first the parser hits; a parser that recovered past the first
 * error would give more.
 */
fn diagnostics($text, $uri) {
    $path = path_from_uri($uri);
    try {
        Parser(Lexer($text), $path).parse();
        return [];
    } catch (ParseError $e) {
        $lines = split($text, "\n");
        if ($e.source_file == $path) {
            $at = max(0, min($e.source_line - 1, len($lines) - 1));
            $message = $e.reason;
        } else {
            $at = import_line($lines, $path, $e.source_file);
            $message = "in {$e.source_file}:{$e.source_line}: {$e.reason}";
        }
        return [{
            "range" => whole_line($lines, $at),
            "severity" => 1, // Error
            "source" => "gazlang",
            "message" => $message,
        }];
    } catch (Error $e) {
        /* Running out of call depth on deeply nested source, say: not a syntax error with a
         * line of its own, but still worth a diagnostic rather than killing the server */
        return [{
            "range" => {"start" => {"line" => 0, "character" => 0}, "end" => {"line" => 0, "character" => 0}},
            "severity" => 1,
            "source" => "gazlang",
            "message" => $e.message,
        }];
    }
}

fn publish($connection, $uri, $text) {
    $connection.write({
        "jsonrpc" => "2.0",
        "method" => "textDocument/publishDiagnostics",
        "params" => {"uri" => $uri, "diagnostics" => diagnostics($text, $uri)},
    });
}

fn respond($connection, $id, $result) {
    $connection.write({"jsonrpc" => "2.0", "id" => $id, "result" => $result});
}

// Opened or changed: keep the text, for hover to look at later, and diagnose it
fn open_or_change($connection, $uri, $text) {
    @documents[$uri] = $text;
    publish($connection, $uri, $text);
}

// The identifier touching $character of $line, or null: scans left and right through word
// characters, so a cursor anywhere in or right after a name finds all of it
fn word_at($line, $character) {
    $is_word = $c -> is_alnum($c) || $c == "_";
    $at = $is_word(char_at($line, $character)) ? $character : $character - 1;
    while ($is_word(char_at($line, $at - 1))) {
        $at--;
    }
    $length = span($line, $at, $is_word);
    return $length == 0 ? null : slice($line, $at, $length);
}

fn plural($n, $word) {
    return $n == 1 ? "1 {$word}" : "{$n} {$word}s";
}

// builtins() maps a name to its argument count, or [fewest, most] when some are optional
fn describe_arity($arity) {
    if (type_of($arity) == "list") {
        return $arity[0] == $arity[1] ? plural($arity[0], "argument") : "{$arity[0]} to {$arity[1]} arguments";
    }
    return plural($arity, "argument");
}

/*
 * A hover result for the word under the cursor: a builtin's arity from builtins(), or the
 * signature and docblock of what the document declares by that name, or a file it imports
 * (found as definition() finds it). Read with the compiler's lexer, not from the parsed tree:
 * the tree doesn't exist while the document has a syntax error elsewhere, which is the common
 * case while it is being edited, and the lexer reads what is above a mistake.
 */
fn hover($uri, $position) {
    $text = @documents[$uri] ?? null;
    if ($text == null) {
        return null;
    }
    $word = word_at(text_line($text, $position["line"]), $position["character"]);
    if ($word == null) {
        return null;
    }
    $builtins = builtins();
    if (has_key($builtins, $word)) {
        return {"contents" => {"kind" => "markdown", "value" => "**{$word}** \u{2014} builtin, " .. describe_arity($builtins[$word])}};
    }
    $found = find_declaration(reachable_files(path_from_uri($uri), $text), $word);
    if ($found == null) {
        return null;
    }
    $declaration = $found[1];
    $value = "```gaz\n{$declaration.signature}\n```";
    if ($declaration.doc != null) {
        $value ..= "\n\n" .. $declaration.doc;
    }
    return {"contents" => {"kind" => "markdown", "value" => $value}};
}

/*
 * The outline of a file's text (compiler/docblocks.gaz), kept until the text changes, so a
 * hover or completion lexes only what changed since the last one
 */
fn outline_of($key, $text) {
    $cached = @outlines[$key] ?? null;
    if ($cached != null && $cached[0] == $text) {
        return $cached[1];
    }
    $outline = ends_with($key, ".gazml") ? Outline(null, null, []) : outline($text);
    @outlines[$key] = [$text, $outline];
    return $outline;
}

// A file a document reaches, with its text and outline
kind ReachableFile {
    fn _(pub #path, pub #text, pub #outline) {}
}

/*
 * The files a document can reach by name, as ReachableFiles: itself first (its own,
 * possibly unsaved, text), then what it imports, directly or not, each once (a cycle of
 * imports ends where it comes back). An unsaved document reaches only itself.
 */
fn reachable_files($path, $text) {
    $files = [ReachableFile($path, $text, outline_of($path ?? "", $text))];
    if ($path == null) {
        return $files;
    }
    $root = root_of($path);
    $visited = [$path];
    $i = 0;
    while ($i < len($files)) {
        $file = $files[$i];
        foreach (imported_paths($file.path, $file.outline.imports, $root) as $imported) {
            if (!in_array($imported, $visited)) {
                $visited[] = $imported;
                $imported_text = read_file($imported);
                $files[] = ReachableFile($imported, $imported_text, outline_of($imported, $imported_text));
            }
        }
        $i++;
    }
    return $files;
}

/*
 * The first declaration named $name in $files, as [ReachableFile, Declaration]: a function,
 * kind or constant first, and failing those a member of a kind (a method, a field)
 */
fn find_declaration($files, $name) {
    foreach ([true, false] as $top_level) {
        foreach ($files as $file) {
            foreach ($file.outline.declarations as $declaration) {
                if ($declaration.name == $name && ($declaration.owner == null) == $top_level) {
                    return [$file, $declaration];
                }
            }
        }
    }
    return null;
}

// A real path to the file:// URI that names it, percent-encoding each segment on its own so a
// literal / in the path stays a separator (http::url_encode would escape it as anyone else's)
fn uri_from_path($path) {
    return "file://" .. join(map(split($path, "/"), http::url_encode), "/");
}

/*
 * The real paths a file's imports name ($imports, as an Outline has them), resolved as the
 * compiler resolves them from $path (import_target() in compiler/parser.gaz: ./ from its directory, anything else from
 * its project root, $root when no gaz.json is above it), for those that exist on disk. A std/
 * import isn't a file, and is skipped: only a program's own files can be followed this way.
 */
fn imported_paths($path, $imports, $root) {
    $directory = directory_of($path);
    $paths = [];
    foreach ($imports as $import) {
        $target = import_target($import, $directory, project_root($directory) ?? $root);
        if ($target.path != null && file_exists($target.path) && !is_dir($target.path)) {
            $paths[] = real_path($target.path);
        }
    }
    return $paths;
}

// The project root the document's imports are from: its own, or its directory without one
fn root_of($path) {
    $directory = directory_of($path);
    return project_root($directory) ?? $directory;
}

/*
 * The zero-based line of the document's import of $file, where an error in that file is shown;
 * the first line when the document reaches it only through another file (or is unsaved)
 */
fn import_line($lines, $path, $file) {
    if ($path == null || $file == null) {
        return 0;
    }
    $target = real_path($file);
    $root = root_of($path);
    foreach ($lines as $i => $line) {
        // Only a line that is an import, as the lexer reads it: not a comment or a string that says one
        if (starts_with(trim($line), "import ") && in_array($target, imported_paths($path, outline($line).imports, $root))) {
            return $i;
        }
    }
    return 0;
}

// The completion item kind for what a declaration is: a Function, Class, Interface or Constant
const COMPLETION_KINDS = {"function" => 3, "kind" => 7, "interface" => 8, "enum" => 13, "constant" => 21};

/*
 * A completion for each function, kind and constant declared in $files (the same reach
 * definition() searches), each name once even if declared more than once reachably, with the
 * first line of its docblock as its detail and the whole of it as its documentation. Further
 * than the compiler lets a file see, which only its own imports: a completion of a name the file
 * must still import is a nudge, not a mistake.
 */
fn declared_names($files) {
    $items = [];
    $seen = {};
    foreach ($files as $file) {
        foreach ($file.outline.declarations as $declaration) {
            if ($declaration.owner != null || has_key($seen, $declaration.name)) {
                continue;
            }
            $seen[$declaration.name] = true;
            $items[] = completion_item($declaration);
        }
    }
    return $items;
}

fn completion_item($declaration) {
    $item = {"label" => $declaration.name, "kind" => COMPLETION_KINDS[$declaration.what]};
    if ($declaration.doc != null) {
        $item["detail"] = split($declaration.doc, "\n")[0];
        $item["documentation"] = {"kind" => "markdown", "value" => $declaration.doc};
    }
    return $item;
}

/*
 * The document's imports as links an editor can follow: for each import "path"; line, the range
 * of the path inside its quotes and the file it names. A path with no file to open (std/, which is
 * built in) or none on disk is left out.
 */
fn document_links($uri) {
    $text = @documents[$uri] ?? null;
    $path = path_from_uri($uri);
    if ($text == null || $path == null) {
        return [];
    }
    $directory = directory_of($path);
    $root = root_of($path);
    $links = [];
    foreach (split($text, "\n") as $number => $line) {
        $found = regex::groups($line, '^[ \t]*import[ \t]+"([^"]*)"');
        if ($found == null) {
            continue;
        }
        $target = import_target($found[1], $directory, $root);
        if ($target.path == null || !file_exists($target.path) || is_dir($target.path)) {
            continue;
        }
        $start = index_of($line, '"') + 1;
        $links[] = {
            "range" => {
                "start" => {"line" => $number, "character" => $start},
                "end" => {"line" => $number, "character" => $start + len($found[1])},
            },
            "target" => uri_from_path(real_path($target.path)),
        };
    }
    return $links;
}

// The path typed so far inside an import's string, up to the cursor, or null anywhere else
fn import_prefix($text, $position) {
    $before = slice(text_line($text, $position["line"]), 0, $position["character"]);
    $found = regex::groups($before, '^[ \t]*import[ \t]+"([^"]*)$');
    return $found == null ? null : $found[1];
}

/*
 * What can follow an import path typed so far: the .gaz and .gazml files and the folders of the
 * directory it names, from the file's own directory after ./ and from its project root
 * otherwise, and ./ and std/ to begin with. std/ has no directory to list, since it is built in.
 */
fn import_completions($path, $prefix) {
    $steps = split($prefix, "/");
    $folders = slice($steps, 0, -1);
    $here = root_of($path);
    if ($folders != [] && $folders[0] == ".") {
        $here = directory_of($path);
        $folders = slice($folders, 1);
    }
    if ($folders == [] && !contains($prefix, "/")) {
        $items = [{"label" => "./", "kind" => 19}, {"label" => "std/", "kind" => 19}]; // Folder
    } else {
        $items = [];
    }
    if ($folders != [] && $folders[0] == "std") {
        return $items;
    }
    foreach ($folders as $folder) {
        $here = join_path($here, $folder);
    }
    if (!is_dir($here)) {
        return $items;
    }
    foreach (list_dir($here) as $name) {
        if (starts_with($name, ".")) {
            continue;
        }
        if (is_dir(join_path($here, $name))) {
            $items[] = {"label" => $name .. "/", "kind" => 19};
        } else if (ends_with($name, ".gaz") || ends_with($name, ".gazml")) {
            $items[] = {"label" => $name, "kind" => 17}; // File
        }
    }
    return $items;
}

/*
 * Completions: the language's keywords, every builtin with its arity, and every function this
 * document can reach by name (itself and what it imports, directly or not). No filtering by
 * what is typed so far: editors filter a completion list against the prefix themselves. Inside
 * the string of an import, the files it could name instead.
 */
fn completions($uri, $position = null) {
    $document = @documents[$uri] ?? null;
    $path = path_from_uri($uri);
    if ($document != null && $position != null) {
        $prefix = import_prefix($document, $position);
        if ($prefix != null) {
            return $path == null ? [] : import_completions($path, $prefix);
        }
    }
    $items = map(keywords(), $word -> ({"label" => $word, "kind" => 14})); // Keyword
    foreach (builtins() as $name => $arity) {
        $items[] = {"label" => $name, "kind" => 3, "detail" => describe_arity($arity)}; // Function
    }
    if ($document != null) {
        $items = [...$items, ...declared_names(reachable_files($path, $document))];
    }
    return $items;
}

/*
 * Where the word under the cursor is declared, in this document or a file it imports (directly
 * or not), as find_declaration() finds it: the whole of the declaration's first line. A builtin
 * has no source to jump to and gives no result.
 */
fn definition($uri, $position) {
    $path = path_from_uri($uri);
    $text = @documents[$uri] ?? null;
    if ($path == null || $text == null) {
        return null;
    }
    $word = word_at(text_line($text, $position["line"]), $position["character"]);
    if ($word == null) {
        return null;
    }
    $found = find_declaration(reachable_files($path, $text), $word);
    if ($found == null) {
        return null;
    }
    [$file, $declaration] = $found;
    return {"uri" => uri_from_path($file.path), "range" => whole_line(split($file.text, "\n"), $declaration.line - 1)};
}

// The line at $at of $text, or "" past its end
fn text_line($text, $at) {
    $lines = split($text, "\n");
    return $lines[$at] ?? "";
}

// How many UTF-16 code units $text is, which is what an LSP position's character counts
fn utf16_length($text) {
    if (!utf8_valid($text)) {
        return len($text);
    }
    $units = utf8_length($text);
    if ($units == len($text)) {
        return $units;
    }
    foreach (utf8_chars($text) as $char) {
        // A character of four bytes is outside the Basic Multilingual Plane: two code units
        if (len($char) == 4) {
            $units++;
        }
    }
    return $units;
}

// The byte offset in $line that $units UTF-16 code units from its start reach
fn byte_offset($line, $units) {
    if (!utf8_valid($line)) {
        return min($units, len($line));
    }
    $offset = 0;
    foreach (utf8_chars($line) as $char) {
        $units -= len($char) == 4 ? 2 : 1;
        if ($units < 0) {
            break;
        }
        $offset += len($char);
    }
    return $offset;
}

/*
 * Where each line of a document starts, to turn the byte offsets the lexer gives (span()) into
 * LSP positions, whose character counts UTF-16 code units, and back
 */
kind Positions {
    #starts = [0];

    fn _(#text) {
        $at = index_of(#text, "\n");
        while ($at != null) {
            #starts[] = $at + 1;
            $at = $at + 1 < len(#text) ? index_of(#text, "\n", $at + 1) : null;
        }
    }

    // The position of byte $offset, as {"line", "character"}
    pub fn at($offset) {
        $line = #line_of($offset);
        $start = #starts[$line];
        return {"line" => $line, "character" => utf16_length(slice(#text, $start, $offset - $start))};
    }

    // The byte offset of an LSP position; one past the text's end is its end
    pub fn offset($position) {
        $line = $position["line"];
        if ($line >= len(#starts)) {
            return len(#text);
        }
        $start = #starts[$line];
        $stop = $line + 1 < len(#starts) ? #starts[$line + 1] - 1 : len(#text);
        return $start + byte_offset(slice(#text, $start, $stop - $start), $position["character"]);
    }

    // The range between two byte offsets
    pub fn range($start, $stop) {
        return {"start" => #at($start), "end" => #at($stop)};
    }

    // The zero-based line byte $offset is on, by bisection
    fn line_of($offset) {
        $low = 0;
        $high = len(#starts) - 1;
        while ($low < $high) {
            $middle = ($low + $high + 1) >> 1;
            if (#starts[$middle] <= $offset) {
                $low = $middle;
            } else {
                $high = $middle - 1;
            }
        }
        return $low;
    }
}

/*
 * The hints in the compiler's own messages that name their fix exactly: an import to add
 * (import_hint() in compiler/parser.gaz) and a keyword to write instead (keyword_hint() and
 * undefined_hint()). Read from the message rather than worked out again here, so a quick fix
 * can't disagree with the error it answers: the compiler already chose the import's spelling (std/, ./ or
 * from the project root), and the tests/corpora recordings hold the wording byte for byte.
 */
const IMPORT_HINT = 'add import "([^"]+)";\)$';
const KEYWORD_HINT = '\(keywords are lowercase: write \'([a-z]+)\', not \'([A-Za-z_][A-Za-z0-9_]*)\'\)$';
const ELSE_IF_HINT = '\(write \'(else if)\', not \'([A-Za-z_][A-Za-z0-9_]*)\'\)$';
// A diagnostic for a mistake in a file the document imports (see diagnostics()), whose fix is that file's
const ELSEWHERE = '^in .*:[0-9]+: ';

/*
 * The quick fixes for the diagnostics a client sends back with a codeAction request: one for
 * each diagnostic of ours whose message names its fix, as a CodeAction with its edit
 */
fn code_actions($uri, $diagnostics) {
    $text = @documents[$uri] ?? null;
    if ($text == null) {
        return [];
    }
    $actions = [];
    foreach ($diagnostics as $diagnostic) {
        $message = $diagnostic["message"];
        if (($diagnostic["source"] ?? null) != "gazlang" || regex::search($message, ELSEWHERE)) {
            continue;
        }
        $fix = import_fix($text, $message) ?? keyword_fix($text, $message, $diagnostic["range"]["start"]["line"]);
        if ($fix != null) {
            [$title, $edit] = $fix;
            $actions[] = {
                "title" => $title,
                "kind" => "quickfix",
                "diagnostics" => [$diagnostic],
                "isPreferred" => true,
                "edit" => {"changes" => {$uri => [$edit]}},
            };
        }
    }
    return $actions;
}

// [title, edit] adding the import a message names, or null
fn import_fix($text, $message) {
    $found = regex::groups($message, IMPORT_HINT);
    if ($found == null) {
        return null;
    }
    $at = {"line" => import_insertion_line($text), "character" => 0};
    return ["Add import \"{$found[1]}\"", {"range" => {"start" => $at, "end" => $at}, "newText" => "import \"{$found[1]}\";\n"}];
}

/*
 * The zero-based line a new import goes on: below the last import, else below the namespace
 * line, else at the top (below a script's #! line)
 */
fn import_insertion_line($text) {
    $line = starts_with($text, "#!") ? 1 : 0;
    $tokens = source_tokens($text);
    foreach ($tokens as $i => $token) {
        if ($token.type == "IMPORT" || $token.type == "NAMESPACE") {
            $end = $i;
            while ($end < len($tokens) && $tokens[$end].type != "SEMICOLON") {
                $end++;
            }
            if ($end < len($tokens)) {
                // A token's line counts from 1, so the line after the ; is its line counted from 0
                $line = $tokens[$end].line;
            }
        }
    }
    return $line;
}

/*
 * [title, edit] writing the keyword a message names in place of the name written, or null: the
 * last name so written at or before the diagnostic's line, since the compiler's hint can be about
 * the token before the one it stopped at, or the start of the statement
 */
fn keyword_fix($text, $message, $line) {
    $found = regex::groups($message, KEYWORD_HINT) ?? regex::groups($message, ELSE_IF_HINT);
    if ($found == null) {
        return null;
    }
    [$whole, $right, $wrong] = $found;
    $written = null;
    foreach (source_tokens($text) as $token) {
        if ($token.line > $line + 1) {
            break;
        }
        if (in_array($token.type, ["IDENTIFIER", "TAG"]) && $token.value == $wrong) {
            $written = $token;
        }
    }
    if ($written == null) {
        return null;
    }
    $range = Positions($text).range($written.start, $written.stop);
    return ["Write '{$right}'", {"range" => $range, "newText" => $right}];
}

// The SymbolKind for what a declaration is
const SYMBOL_KINDS = {
    "function" => 12, "kind" => 5, "interface" => 11, "enum" => 10, "constant" => 14, "case" => 22,
    "field" => 8, "static field" => 8, "method" => 6, "static method" => 6, "constructor" => 9,
};

/*
 * The document's outline as DocumentSymbols: its functions, kinds, interfaces, enums and
 * constants, each kind's members its children, from the same outline hover reads
 */
fn document_symbols($uri) {
    $text = @documents[$uri] ?? null;
    if ($text == null) {
        return [];
    }
    $positions = Positions($text);
    $symbols = [];
    foreach (outline_of(path_from_uri($uri) ?? "", $text).declarations as $declaration) {
        $symbol = document_symbol($declaration, $positions);
        if ($declaration.owner == null) {
            $symbols[] = $symbol;
        } else if ($symbols != [] && last($symbols)["name"] == $declaration.owner) {
            $symbols[len($symbols) - 1]["children"][] = $symbol;
        }
    }
    return $symbols;
}

fn document_symbol($declaration, $positions) {
    $symbol = {
        "name" => $declaration.name,
        // The signature on one line, as an outline view has room for
        "detail" => join(map(split($declaration.signature, "\n"), trim), " "),
        "kind" => SYMBOL_KINDS[$declaration.what],
        "range" => $positions.range($declaration.start, $declaration.stop),
        "selectionRange" => $positions.range($declaration.name_start, $declaration.name_stop),
    };
    if (in_array($declaration.what, ["kind", "interface", "enum"])) {
        $symbol["children"] = [];
    }
    return $symbol;
}

// A bracket open at the cursor: the index of its token, and how many commas it holds so far
kind OpenBracket {
    pub #commas = 0;

    fn _(pub #type, pub #at) {}
}

// How a token changes the depth of brackets: 1 for an opener, -1 for a closer
fn depth_change($token) {
    return match {
        in_array($token.type, OPENERS) => 1,
        in_array($token.type, CLOSERS) => -1,
        default => 0,
    };
}

/*
 * The innermost ( still open at byte $offset of the document's tokens, as an OpenBracket, or
 * null: what a call's argument list is, before which its callee stands
 */
fn open_call($tokens, $offset) {
    $open = [];
    foreach ($tokens as $i => $token) {
        if ($token.start >= $offset) {
            break;
        }
        if (in_array($token.type, OPENERS)) {
            $open[] = OpenBracket($token.type, $i);
        } else if (in_array($token.type, CLOSERS) && $open != []) {
            delete $open[len($open) - 1];
        } else if ($token.type == "COMMA" && $open != []) {
            last($open).commas++;
        }
    }
    foreach (reverse($open) as $bracket) {
        if ($bracket.type == "LEFT_PAREN") {
            return $bracket;
        }
    }
    return null;
}

// What a call's signature help shows: its label and docblock, and where each parameter lies in the label
kind CallSignature {
    fn _(pub #label, pub #doc) {}
}

/*
 * The signature of what is called just before token $at: a builtin, a function or kind by name
 * (Kind::name for a static method, ns::name for a namespace's function), or #method in the kind the
 * cursor is in. A method through a value ($obj.method) is left alone: which kind $obj is takes
 * types the server doesn't have, and a guess could show the wrong signature.
 */
fn call_signature($tokens, $at, $files, $offset) {
    if ($at == 0) {
        return null;
    }
    $callee = $tokens[$at - 1];
    $before = $at >= 2 ? $tokens[$at - 2].type : null;
    if ($callee.type == "HASH_IDENTIFIER") {
        $kind = enclosing_kind($files[0], $offset);
        $method = $kind == null ? null : find_member($files, $kind.name, slice($callee.value, 1));
        return $method == null ? null : CallSignature($method.signature, $method.doc);
    }
    if ($callee.type != "IDENTIFIER" || $before == "FN") {
        return null;
    }
    $name = $callee.value;
    if ($before == "DOUBLE_COLON" && $at >= 3) {
        $member = find_member($files, $tokens[$at - 3].value, $name);
        if ($member != null) {
            return CallSignature($member.signature, $member.doc);
        }
    } else if (has_key(builtins(), $name)) {
        return CallSignature($name, "builtin, " .. describe_arity(builtins()[$name]));
    }
    $found = find_declaration($files, $name);
    if ($found == null || $found[1].owner != null) {
        return null;
    }
    $declaration = $found[1];
    if ($declaration.what != "kind") {
        return CallSignature($declaration.signature, $declaration.doc);
    }
    // Constructing a kind runs its _, or the one it inherits
    $constructor = find_member($files, $name, "_");
    if ($constructor == null) {
        return null;
    }
    $signature = $constructor.signature;
    return CallSignature($name .. slice($signature, index_of($signature, "(")), $declaration.doc ?? $constructor.doc);
}

// The kind, enum or interface of a file whose body holds byte $offset, or null
fn enclosing_kind($file, $offset) {
    foreach ($file.outline.declarations as $declaration) {
        if ($declaration.owner == null && in_array($declaration.what, ["kind", "enum", "interface"])
            && $declaration.start <= $offset && $offset < $declaration.stop) {
            return $declaration;
        }
    }
    return null;
}

/*
 * The member $name of the kind named $kind in $files, or of the kind it extends, and so on up, as a
 * Declaration, or null. A qualified kind (ns::Kind) is looked up by its last part.
 */
fn find_member($files, $kind, $name) {
    $seen = [];
    while ($kind != null && !in_array($kind, $seen)) {
        $seen[] = $kind;
        $declared = null;
        foreach ($files as $file) {
            foreach ($file.outline.declarations as $declaration) {
                if ($declaration.owner == $kind && $declaration.name == $name) {
                    return $declaration;
                }
                if ($declaration.owner == null && $declaration.name == $kind && $declaration.what == "kind") {
                    $declared = $declared ?? $declaration;
                }
            }
        }
        $kind = $declared == null ? null : parent_of($declared);
    }
    return null;
}

// The name of the kind a kind's signature says it extends (its last part), or null
fn parent_of($declaration) {
    $found = regex::groups($declaration.signature, 'extends\s+([A-Za-z_][A-Za-z0-9_:]*)');
    if ($found == null) {
        return null;
    }
    return last(split($found[1], "::"));
}

// A parameter of a signature: where it lies in it as byte offsets, and the variables it names, each [name, start, stop]
kind Parameter {
    fn _(pub #start, pub #stop, pub #names) {}
}

/*
 * The parameters of a signature's first parameter list, read with the lexer so a default holding
 * a comma or a bracket is one parameter. A promoted #x names $x, a pattern each variable in it.
 */
fn parameters_of($signature) {
    $tokens = source_tokens($signature);
    $t = 0;
    while ($t < len($tokens) && $tokens[$t].type != "LEFT_PAREN") {
        $t++;
    }
    $parameters = [];
    $group = [];
    $depth = 0;
    while ($t < len($tokens)) {
        $token = $tokens[$t];
        $depth += depth_change($token);
        $ends = $depth == 0 || $depth == 1 && $token.type == "COMMA";
        if ($ends) {
            if ($group != []) {
                $parameters[] = parameter($group);
            }
            $group = [];
        } else if ($depth > 1 || $token.type != "LEFT_PAREN") {
            $group[] = $token;
        }
        if ($depth == 0) {
            break;
        }
        $t++;
    }
    return $parameters;
}

// A Parameter from its tokens: the variables are those before its default's =
fn parameter($group) {
    $names = [];
    foreach ($group as $token) {
        if ($token.type == "ASSIGN") {
            break;
        }
        if ($token.type == "VAR_IDENTIFIER") {
            $names[] = [$token.value, $token.start, $token.stop];
        } else if ($token.type == "HASH_IDENTIFIER") {
            $names[] = ["$" .. slice($token.value, 1), $token.start, $token.stop];
        }
    }
    return Parameter($group[0].start, last($group).stop, $names);
}

/*
 * Signature help for the call around the cursor: its signature as written (hover's), its
 * docblock, each parameter's place in the label, and which one the cursor is in, by the commas
 * before it at the call's own depth
 */
fn signature_help($uri, $position) {
    $text = @documents[$uri] ?? null;
    if ($text == null) {
        return null;
    }
    $offset = Positions($text).offset($position);
    $tokens = source_tokens($text);
    $call = open_call($tokens, $offset);
    if ($call == null) {
        return null;
    }
    $signature = call_signature($tokens, $call.at, reachable_files(path_from_uri($uri), $text), $offset);
    if ($signature == null) {
        return null;
    }
    $label = $signature.label;
    $information = {"label" => $label, "parameters" => map(parameters_of($label), $p -> ({
        "label" => [utf16_length(slice($label, 0, $p.start)), utf16_length(slice($label, 0, $p.stop))],
    }))};
    if ($signature.doc != null) {
        $information["documentation"] = {"kind" => "markdown", "value" => $signature.doc};
    }
    return {"signatures" => [$information], "activeSignature" => 0, "activeParameter" => $call.commas};
}

/*
 * The semantic token legend, announced at initialize: a token's type is its index in
 * TOKEN_TYPES, its modifiers a bit for each of TOKEN_MODIFIERS. A constant is a readonly
 * variable, as the protocol has no constant type.
 */
const TOKEN_TYPES = ["namespace", "class", "interface", "enum", "function", "method", "property", "enumMember", "parameter", "variable"];
const TOKEN_MODIFIERS = ["declaration", "readonly", "defaultLibrary"];
const DECLARATION = 1;
const READONLY = 2;
const DEFAULT_LIBRARY = 4;

// The token type for what a declaration is
const TYPE_OF_DECLARATION = {
    "function" => "function", "kind" => "class", "interface" => "interface", "enum" => "enum",
    "constant" => "variable", "case" => "enumMember", "field" => "property", "static field" => "property",
    "method" => "method", "static method" => "method", "constructor" => "method",
};

// A declaration a name can resolve to, and whether it is the standard library's
kind Named {
    fn _(pub #declaration, pub #library) {}
}

/*
 * What the names a document can reach resolve to, by name alone: its top level declarations and
 * those of what it imports (the standard library's too), each kind's members, and the namespaces
 */
kind Names {
    #top_level = {};
    #members = {};
    // name -> every member of that name in any kind, for a .name whose object's kind isn't known
    #members_named = {};
    #namespaces = {};

    fn _($files, $library) {
        foreach ([...$files, ...$library] as $file) {
            $is_library = in_array($file, $library);
            if ($file.outline.namespace != null) {
                #namespaces[$file.outline.namespace] = #namespaces[$file.outline.namespace] ?? $is_library;
            }
            foreach ($file.outline.declarations as $declaration) {
                #add(Named($declaration, $is_library));
            }
        }
    }

    fn add($named) {
        $declaration = $named.declaration;
        if ($declaration.owner == null) {
            #top_level[$declaration.name] = #top_level[$declaration.name] ?? $named;
            return;
        }
        #add_member($declaration.owner, $declaration.name, $named);
        if ($declaration.what == "constructor") {
            // A promoted parameter (pub #x) declares a field
            foreach (parameters_of($declaration.signature) as $parameter) {
                foreach ($parameter.names as [$name, $start, $stop]) {
                    if (char_at($declaration.signature, $start) == "#") {
                        $field = Declaration("field", slice($name, 1), false, $declaration.owner, "", $declaration.line, null);
                        #add_member($declaration.owner, $field.name, Named($field, $named.library));
                    }
                }
            }
        }
    }

    fn add_member($owner, $name, $named) {
        $key = "{$owner}.{$name}";
        #members[$key] = #members[$key] ?? $named;
        #members_named[$name] = [...(#members_named[$name] ?? []), $named];
    }

    // The top level declaration of a name, as a Named, or null
    pub fn top($name) {
        return #top_level[$name] ?? null;
    }

    // Whether a name is a namespace, and whether it is the standard library's, or null if it isn't one
    pub fn namespace($name) {
        return #namespaces[$name] ?? null;
    }

    // Whether a top level name is a kind, interface or enum
    pub fn is_kind($name) {
        $named = #top($name);
        return $named != null && in_array($named.declaration.what, ["kind", "interface", "enum"]);
    }

    // The member $name of the kind $kind, or of the kind it extends, and so on up, or null
    pub fn member($kind, $name) {
        $seen = [];
        while ($kind != null && !in_array($kind, $seen)) {
            $seen[] = $kind;
            $found = #members["{$kind}.{$name}"] ?? null;
            if ($found != null) {
                return $found;
            }
            $declared = #top($kind);
            $kind = $declared == null ? null : parent_of($declared.declaration);
        }
        return null;
    }

    /*
     * The member a .name means when the object's kind isn't known: one of the members of that
     * name, if every one is the same token type (all fields, or all methods), else null
     */
    pub fn any_member($name) {
        $named = #members_named[$name] ?? [];
        if ($named == []) {
            return null;
        }
        $type = TYPE_OF_DECLARATION[$named[0].declaration.what];
        foreach ($named as $each) {
            if (TYPE_OF_DECLARATION[$each.declaration.what] != $type) {
                return null;
            }
        }
        return $named[0];
    }
}

/*
 * The standard library's files the reachable ones import, as ReachableFiles named <std>/..., for
 * names to resolve into (and be marked defaultLibrary). Not chased further: a file sees only
 * what it imports.
 */
fn library_files($files) {
    $library = [];
    $seen = [];
    foreach ($files as $file) {
        foreach ($file.outline.imports as $import) {
            $std = import_target($import, "", "").std;
            $text = $std == null || in_array($std, $seen) ? null : std_source($std);
            if ($text != null) {
                $seen[] = $std;
                $library[] = ReachableFile("<std>/{$std}", $text, outline_of("<std>/{$std}", $text));
            }
        }
    }
    return $library;
}

// A semantic token before encoding: where it lies, as byte offsets, its type's name and its modifier bits
kind SemanticToken {
    fn _(pub #start, pub #stop, pub #type, pub #modifiers) {}
}

// A function, method or constructor of the document and the variables its parameters name
kind Scope {
    fn _(pub #declaration, pub #parameters) {}
}

/*
 * Semantic tokens for the document's names, by what each resolves to among the declarations it
 * can reach. A name that resolves to nothing gets no token, so the editor's own grammar colours
 * it, and a wrong guess is never shown.
 */
kind Highlighter {
    #names;
    #builtins;
    #source_tokens;
    // The document's own declarations by where their name starts, to mark each as a declaration
    #declared_at = {};
    #scopes = [];
    #kinds = [];

    fn _($files, $library) {
        #names = Names($files, $library);
        #builtins = builtins();
        #source_tokens = source_tokens($files[0].text);
        foreach ($files[0].outline.declarations as $declaration) {
            #declared_at[$declaration.name_start] = $declaration;
            if (in_array($declaration.what, ["function", "method", "static method", "constructor"])) {
                #scopes[] = Scope($declaration, parameters_of($declaration.signature));
            } else if ($declaration.owner == null && in_array($declaration.what, ["kind", "enum", "interface"])) {
                #kinds[] = $declaration;
            }
        }
    }

    pub fn tokens() {
        $found = [];
        foreach (#source_tokens as $i => $token) {
            $semantic = #classify($i, $token);
            if ($semantic != null) {
                $found[] = $semantic;
            }
        }
        return $found;
    }

    fn classify($i, $token) {
        $declared = #declared_at[$token.start] ?? null;
        if ($declared != null && in_array($token.type, ["IDENTIFIER", "HASH_IDENTIFIER"])) {
            return #named($token.start, $token.stop, Named($declared, false), DECLARATION);
        }
        return match ($token.type) {
            "IDENTIFIER", "TAG" => #identifier($i, $token),
            "VAR_IDENTIFIER", "GLOBAL_VAR_IDENTIFIER" => #variable($token),
            "HASH_IDENTIFIER" => #own_member($token, slice($token.value, 1), $token.start),
            "PARENT_IDENTIFIER" => #parent_member($token),
            "PROPERTY" => #any_member($token, 1),
            "NULLSAFE_PROPERTY" => #any_member($token, 2),
            default => null,
        };
    }

    fn type($i) {
        return $i >= 0 && $i < len(#source_tokens) ? #source_tokens[$i].type : null;
    }

    // A bare name, a qualifier before ::, or a name after one
    fn identifier($i, $token) {
        $name = $token.value;
        if (#type($i - 1) == "NAMESPACE") {
            return SemanticToken($token.start, $token.stop, "namespace", DECLARATION);
        }
        if (#type($i + 1) == "DOUBLE_COLON") {
            return #qualifier($token);
        }
        if (#type($i - 1) == "DOUBLE_COLON" && #type($i - 2) == "IDENTIFIER") {
            $qualifier = #source_tokens[$i - 2].value;
            $named = #names.is_kind($qualifier) ? #names.member($qualifier, $name) : #names.top($name);
            return #named($token.start, $token.stop, $named, 0);
        }
        // A namespace's own function may share a builtin's name, and wins over it
        $named = #names.top($name);
        // map is a builtin and a type name: only a call of it is surely the builtin
        $is_type = in_array($name, Parser::TYPE_NAMES) && #type($i + 1) != "LEFT_PAREN";
        if ($named == null && has_key(#builtins, $name) && !$is_type) {
            return SemanticToken($token.start, $token.stop, "function", DEFAULT_LIBRARY);
        }
        return #named($token.start, $token.stop, $named, 0);
    }

    // The name before a ::, a kind's or a namespace's
    fn qualifier($token) {
        if (#names.is_kind($token.value)) {
            return #named($token.start, $token.stop, #names.top($token.value), 0);
        }
        $library = #names.namespace($token.value);
        if ($library == null) {
            return null;
        }
        return SemanticToken($token.start, $token.stop, "namespace", $library ? DEFAULT_LIBRARY : 0);
    }

    /*
     * A $variable: a parameter of the function it is in (marked a declaration where its parameter
     * list names it), or any other variable. Its token is the name alone: an interpolated "$a[0]"
     * spans its key too.
     */
    fn variable($token) {
        $stop = $token.start + len($token.value);
        $scope = #scope_at($token.start);
        if ($token.type == "VAR_IDENTIFIER" && $scope != null) {
            foreach ($scope.parameters as $parameter) {
                foreach ($parameter.names as [$name, $start, $end]) {
                    if ($name == $token.value) {
                        $declaring = $scope.declaration.start + $start == $token.start;
                        return SemanticToken($token.start, $stop, "parameter", $declaring ? DECLARATION : 0);
                    }
                }
            }
        }
        return SemanticToken($token.start, $stop, "variable", 0);
    }

    // The innermost function, method or constructor of the document around byte $offset, or null
    fn scope_at($offset) {
        $inside = null;
        foreach (#scopes as $scope) {
            if ($scope.declaration.start <= $offset && $offset < $scope.declaration.stop) {
                $inside = $scope;
            }
        }
        return $inside;
    }

    // The kind of the document whose body holds byte $offset, or null
    fn kind_at($offset) {
        foreach (#kinds as $kind) {
            if ($kind.start <= $offset && $offset < $kind.stop) {
                return $kind;
            }
        }
        return null;
    }

    // #name: a member of the kind it is written in, or one that kind inherits
    fn own_member($token, $name, $start) {
        $kind = #kind_at($token.start);
        if ($kind == null) {
            return null;
        }
        return #named($start, $token.stop, #names.member($kind.name, $name), 0);
    }

    // ##name: the parent's version of a method
    fn parent_member($token) {
        $kind = #kind_at($token.start);
        $parent = $kind == null ? null : parent_of($kind);
        if ($parent == null) {
            return null;
        }
        return #named($token.start, $token.stop, #names.member($parent, slice($token.value, 2)), 0);
    }

    // .name or ?.name, the mark left out of the token: what every member of that name is
    fn any_member($token, $mark) {
        return #named($token.start + $mark, $token.stop, #names.any_member(slice($token.value, $mark)), 0);
    }

    // A token for what a name resolved to, or null when it resolved to nothing
    fn named($start, $stop, $named, $modifiers) {
        if ($named == null) {
            return null;
        }
        $declaration = $named.declaration;
        if ($named.library) {
            $modifiers = $modifiers | DEFAULT_LIBRARY;
        }
        if (#is_readonly($declaration)) {
            $modifiers = $modifiers | READONLY;
        }
        return SemanticToken($start, $stop, TYPE_OF_DECLARATION[$declaration.what], $modifiers);
    }

    // A constant, or a field declared readonly or of a readonly kind
    fn is_readonly($declaration) {
        if ($declaration.what == "constant") {
            return true;
        }
        if ($declaration.what != "field") {
            return false;
        }
        $owner = #names.top($declaration.owner);
        return is_marked_readonly($declaration.signature, "#")
            || $owner != null && is_marked_readonly($owner.declaration.signature, "kind");
    }
}

// Whether the words of a signature before $word include readonly
fn is_marked_readonly($signature, $word) {
    $before = index_of($signature, $word);
    return $before != null && in_array("readonly", split(slice($signature, 0, $before), " "));
}

/*
 * The document's semantic tokens, encoded as the protocol wants: five integers for each (line
 * and start character, each relative to the token before, then length, type and modifiers), in
 * UTF-16 code units
 */
fn semantic_tokens($uri) {
    $text = @documents[$uri] ?? null;
    if ($text == null) {
        return {"data" => []};
    }
    $files = reachable_files(path_from_uri($uri), $text);
    $positions = Positions($text);
    $type_index = {};
    foreach (TOKEN_TYPES as $i => $type) {
        $type_index[$type] = $i;
    }
    $data = [];
    $line = 0;
    $character = 0;
    foreach (Highlighter($files, library_files($files)).tokens() as $token) {
        $at = $positions.at($token.start);
        $data[] = $at["line"] - $line;
        $data[] = $at["line"] == $line ? $at["character"] - $character : $at["character"];
        $data[] = utf16_length(slice($text, $token.start, $token.stop - $token.start));
        $data[] = $type_index[$token.type];
        $data[] = $token.modifiers;
        $line = $at["line"];
        $character = $at["character"];
    }
    return {"data" => $data};
}


@documents = {}; // uri -> text, for hover and definition; didOpen and didChange fill it
@outlines = {};  // path -> [text, Outline], see outline_of()

$connection = Connection();
while (true) {
    $message = $connection.read();
    if ($message == null) {
        break;
    }
    $method = $message["method"] ?? null;
    $params = $message["params"] ?? {};

    /*
     * A message shaped other than a handler expects (params missing a key a real client
     * always sends, say) is an error response for a request, and just dropped for a
     * notification, either way not the end of the server: one bad message shouldn't cost
     * every document open in the session.
     */
    try {
        match ($method) {
            "initialize" => respond($connection, $message["id"], {
                "capabilities" => {
                    // Full sync only: a change replaces the whole text, the simplest that works
                    "textDocumentSync" => 1,
                    "hoverProvider" => true,
                    "definitionProvider" => true,
                    "completionProvider" => {},
                    "documentLinkProvider" => {},
                    "codeActionProvider" => {"codeActionKinds" => ["quickfix"]},
                    "documentSymbolProvider" => true,
                    "signatureHelpProvider" => {"triggerCharacters" => ["(", ","]},
                    "semanticTokensProvider" => {
                        "legend" => {"tokenTypes" => TOKEN_TYPES, "tokenModifiers" => TOKEN_MODIFIERS},
                        "full" => true,
                    },
                },
            }),
            "shutdown" => respond($connection, $message["id"], null),
            "exit" => exit(0),
            "textDocument/didOpen" => open_or_change($connection, $params["textDocument"]["uri"], $params["textDocument"]["text"]),
            "textDocument/didChange" => open_or_change(
                $connection,
                $params["textDocument"]["uri"],
                last($params["contentChanges"])["text"]
            ),
            "textDocument/hover" => respond($connection, $message["id"], hover($params["textDocument"]["uri"], $params["position"])),
            "textDocument/definition" => respond($connection, $message["id"], definition($params["textDocument"]["uri"], $params["position"])),
            "textDocument/completion" => respond($connection, $message["id"], completions($params["textDocument"]["uri"], $params["position"] ?? null)),
            "textDocument/documentLink" => respond($connection, $message["id"], document_links($params["textDocument"]["uri"])),
            "textDocument/documentSymbol" => respond($connection, $message["id"], document_symbols($params["textDocument"]["uri"])),
            "textDocument/signatureHelp" => respond($connection, $message["id"], signature_help($params["textDocument"]["uri"], $params["position"])),
            "textDocument/semanticTokens/full" => respond($connection, $message["id"], semantic_tokens($params["textDocument"]["uri"])),
            "textDocument/codeAction" => respond($connection, $message["id"], code_actions($params["textDocument"]["uri"], $params["context"]["diagnostics"])),
            default => has_key($message, "id")
                ? $connection.write({
                    "jsonrpc" => "2.0",
                    "id" => $message["id"],
                    "error" => {"code" => -32601, "message" => "Method not found: {$method}"},
                })
                /* An unhandled notification (initialized, textDocument/didClose, ...) is
                 * ignored, as the protocol allows */
                : null,
        }
    } catch (Error $e) {
        if (has_key($message, "id")) {
            $connection.write({"jsonrpc" => "2.0", "id" => $message["id"], "error" => {"code" => -32603, "message" => $e.message}});
        }
    }
}
