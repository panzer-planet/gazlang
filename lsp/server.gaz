/*
 * A Language Server Protocol server for GazLang: diagnostics for now (parse and lex errors),
 * over stdio, as every editor spawns one. bin/gaz lsp/server.gaz
 *
 * namespace gazlang, not its own: this reuses the compiler's own Lexer and Parser, which are
 * private to that namespace (as a test of the internals does; see CLAUDE.md).
 */
namespace gazlang;

/*
 * By path, not "std/json.gaz": that would pull in a second, differently-pathed copy of
 * chars.gaz alongside the one compiler/lexer.gaz already includes, and namespace privacy is
 * per namespace, not per file, so chars::char_at would be declared twice.
 */
include "../compiler/parser.gaz";
include "../lib/json.gaz" use decode, encode;
include "../lib/chars.gaz" use char_at, is_alnum, span;
include "../lib/regex.gaz";
include "../lib/http.gaz";

/*
 * The lexer's own keywords (compiler/lexer.gaz's Lexer::KEYWORDS, as a list kept by hand),
 * minus the ones reserved only to hint at the right spelling
 * (function, class, public, private, protected, interface, implements, final all say to write
 * something else): completing one of those would just teach an error.
 */
const KEYWORDS = [
    "echo", "if", "else", "while", "for", "foreach", "as", "break", "continue", "fn", "return",
    "null", "delete", "match", "default", "const", "include", "try", "catch", "finally", "throw",
    "true", "false", "kind", "extends", "abstract", "namespace", "use", "pub", "kin", "static",
    "shared",
];

/* A message framed with a Content-Length header, as every LSP transport uses, read and
 * written over standard input and output */
kind Connection {
    // The next message, or null at the end of the stream
    pub fn read() {
        $length = null;
        while (true) {
            $line = read_line();
            if ($line == null) {
                return null;
            }
            if ($line == "") {
                break;
            }
            if (starts_with($line, "Content-Length: ")) {
                $length = to_int(slice($line, len("Content-Length: ")), null);
            }
            // Any other header (Content-Type, say) is skipped: nothing else is used
        }
        if ($length == null) {
            throw "LSP error: a message with no Content-Length header";
        }
        return decode(read_stdin_bytes($length));
    }

    // A notification or response
    pub fn write($message) {
        $body = encode($message);
        print("Content-Length: " .. len($body) .. "\r\n\r\n" .. $body);
    }
}

// A file:// URI to the real path it names, for the parser to resolve its relative includes
// against, or null (piped-source rules: includes relative to the server's own working
// directory) for anything else, an unsaved document included
fn path_from_uri($uri) {
    if (!starts_with($uri, "file://")) {
        return null;
    }
    return http::url_decode(slice($uri, len("file://")));
}

// The whole extent of one line, as a range, for a diagnostic or a definition to point at
fn whole_line($lines, $at) {
    return {"start" => {"line" => $at, "character" => 0}, "end" => {"line" => $at, "character" => len($lines[$at])}};
}

/*
 * The diagnostics for one document's text: a syntax error, if any, else none. ponytail: only
 * ever one diagnostic, the first the parser hits; a parser that recovered past the first
 * error would give more.
 */
fn diagnostics($text, $uri) {
    try {
        Parser(Lexer($text), path_from_uri($uri)).parse();
        return [];
    } catch (ParseError $e) {
        $lines = split($text, "\n");
        $at = max(0, min($e.source_line - 1, len($lines) - 1));
        return [{
            "range" => whole_line($lines, $at),
            "severity" => 1, // Error
            "source" => "gazlang",
            "message" => $e.reason,
        }];
    } catch (Error $e) {
        /* Running out of call depth on deeply nested source, say: not a syntax error with a
         * line of its own, but still worth a diagnostic rather than killing the server */
        return [{
            "range" => {"start" => {"line" => 0, "character" => 0}, "end" => {"line" => 0, "character" => 0}},
            "severity" => 1,
            "source" => "gazlang",
            "message" => $e.message,
        }];
    }
}

fn publish($connection, $uri, $text) {
    $connection.write({
        "jsonrpc" => "2.0",
        "method" => "textDocument/publishDiagnostics",
        "params" => {"uri" => $uri, "diagnostics" => diagnostics($text, $uri)},
    });
}

fn respond($connection, $id, $result) {
    $connection.write({"jsonrpc" => "2.0", "id" => $id, "result" => $result});
}

// Opened or changed: keep the text, for hover to look at later, and diagnose it
fn open_or_change($connection, $uri, $text) {
    @documents[$uri] = $text;
    publish($connection, $uri, $text);
}

// The identifier touching $character of $line, or null: scans left and right through word
// characters, so a cursor anywhere in or right after a name finds all of it
fn word_at($line, $character) {
    $is_word = $c -> is_alnum($c) || $c == "_";
    $at = $is_word(char_at($line, $character)) ? $character : $character - 1;
    while ($is_word(char_at($line, $at - 1))) {
        $at--;
    }
    $length = span($line, $at, $is_word);
    return $length == 0 ? null : slice($line, $at, $length);
}

fn plural($n, $word) {
    return $n == 1 ? "1 {$word}" : "{$n} {$word}s";
}

// builtins() maps a name to its argument count, or [fewest, most] when some are optional
fn describe_arity($arity) {
    if (type_of($arity) == "list") {
        return $arity[0] == $arity[1] ? plural($arity[0], "argument") : "{$arity[0]} to {$arity[1]} arguments";
    }
    return plural($arity, "argument");
}

/*
 * A hover result for the word under the cursor: a builtin's arity from builtins(), or a
 * declared function's parameter list found by scanning the source text for "fn word(...)".
 * Textual, not from the parsed tree: the tree doesn't exist while the document has a syntax
 * error elsewhere, which is the common case while it is being edited. ponytail: finds only a
 * top-level function or a method of the same name, and only the first; no kinds, fields or
 * parameter types yet.
 */
fn hover($uri, $position) {
    $text = @documents[$uri] ?? null;
    if ($text == null) {
        return null;
    }
    $word = word_at(text_line($text, $position["line"]), $position["character"]);
    if ($word == null) {
        return null;
    }
    $builtins = builtins();
    if (has_key($builtins, $word)) {
        return {"contents" => {"kind" => "markdown", "value" => "**{$word}** \u{2014} builtin, " .. describe_arity($builtins[$word])}};
    }
    $found = regex::groups($text, "fn " .. $word .. "\\(([^)]*)\\)");
    if ($found == null) {
        return null;
    }
    return {"contents" => {"kind" => "markdown", "value" => "```gaz\nfn {$word}(" .. ($found[1] ?? "") .. ")\n```"}};
}

// A real path to the file:// URI that names it, percent-encoding each segment on its own so a
// literal / in the path stays a separator (http::url_encode would escape it as anyone else's)
fn uri_from_path($path) {
    return "file://" .. join(map(split($path, "/"), http::url_encode), "/");
}

// The directory a real path is in: "/a/b/c.gaz" is "/a/b". $path is always absolute here
// (real_path()'s or the document's own), so this never needs "." for a bare name.
fn dirname($path) {
    $parts = split($path, "/");
    delete $parts[len($parts) - 1];
    return join($parts, "/");
}

// The zero-based line $byte is on, in $text
fn line_at($text, $byte) {
    return len(split(slice($text, 0, $byte), "\n")) - 1;
}

// Every match of $pattern in $text, each as regex::groups() gives it ([whole, group 1, ...]).
// Repeated calls over ever-shorter slices, since regex.gaz gives one match at a time.
fn all_matches($text, $pattern) {
    $matches = [];
    $offset = 0;
    while (true) {
        $window = slice($text, $offset);
        $start = regex::find($window, $pattern);
        if ($start == null) {
            break;
        }
        $match = regex::groups($window, $pattern);
        $matches[] = $match;
        $offset += $start + len($match[0]);
    }
    return $matches;
}

/*
 * The real paths $text's own include "..."; statements name, relative to $path's directory,
 * for those that exist on disk (a std/ library include doesn't, and is skipped: only a
 * program's own files can be followed this way).
 */
fn included_paths($path, $text) {
    $dir = dirname($path);
    $paths = [];
    foreach (all_matches($text, 'include "([^"]*)"') as $match) {
        $candidate = $dir .. "/" .. $match[1];
        if (file_exists($candidate)) {
            $paths[] = real_path($candidate);
        }
    }
    return $paths;
}

// Every name declared with fn in $text, in the order they appear
fn function_names($text) {
    return map(all_matches($text, "fn ([A-Za-z_][A-Za-z0-9_]*)\\("), $match -> $match[1]);
}

/*
 * Every function fn declares, in $text and every file it includes, directly or not (the same
 * reach find_definition() searches), each name once even if declared more than once reachably.
 */
fn declared_functions($path, $text, $visited) {
    $names = function_names($text);
    if ($path != null) {
        foreach (included_paths($path, $text) as $included) {
            if (in_array($included, $visited)) {
                continue;
            }
            $visited[] = $included;
            $names = [...$names, ...declared_functions($included, read_file($included), $visited)];
        }
    }
    $unique = [];
    foreach ($names as $name) {
        if (!in_array($name, $unique)) {
            $unique[] = $name;
        }
    }
    return $unique;
}

/*
 * Completions: the language's keywords, every builtin with its arity, and every function this
 * document can reach by name (itself and what it includes, directly or not). No filtering by
 * what is typed so far: editors filter a completion list against the prefix themselves.
 */
fn completions($uri) {
    $items = map(KEYWORDS, $word -> ({"label" => $word, "kind" => 14})); // Keyword
    foreach (builtins() as $name => $arity) {
        $items[] = {"label" => $name, "kind" => 3, "detail" => describe_arity($arity)}; // Function
    }
    $text = @documents[$uri] ?? null;
    if ($text != null) {
        $path = path_from_uri($uri);
        foreach (declared_functions($path, $text, [$path]) as $name) {
            $items[] = {"label" => $name, "kind" => 3};
        }
    }
    return $items;
}

/*
 * Where $name is declared with fn: in $text (which is $path's, but the caller's own copy,
 * possibly unsaved), or the first place it turns up in a file $path includes, followed
 * breadth-first-ish by recursion; $visited holds every real path followed so far on this
 * branch, so a cycle of includes ends the search rather than looping. null when nothing
 * declares it within reach.
 */
fn find_definition($path, $text, $name, $visited) {
    $at = regex::find($text, "fn " .. $name .. "\\(");
    if ($at != null) {
        return {"uri" => uri_from_path($path), "range" => whole_line(split($text, "\n"), line_at($text, $at))};
    }
    foreach (included_paths($path, $text) as $included) {
        if (in_array($included, $visited)) {
            continue;
        }
        $visited[] = $included;
        $found = find_definition($included, read_file($included), $name, $visited);
        if ($found != null) {
            return $found;
        }
    }
    return null;
}

/*
 * Where the word under the cursor is declared with fn, in this document or a file it includes
 * (directly or not). ponytail: functions only, as hover is; a builtin has no source to jump to
 * and gives no result.
 */
fn definition($uri, $position) {
    $path = path_from_uri($uri);
    $text = @documents[$uri] ?? null;
    if ($path == null || $text == null) {
        return null;
    }
    $word = word_at(text_line($text, $position["line"]), $position["character"]);
    if ($word == null) {
        return null;
    }
    return find_definition($path, $text, $word, [$path]);
}

// The line at $at of $text, or "" past its end
fn text_line($text, $at) {
    $lines = split($text, "\n");
    return $lines[$at] ?? "";
}

@documents = {}; // uri -> text, for hover and definition; didOpen and didChange fill it

$connection = Connection();
while (true) {
    $message = $connection.read();
    if ($message == null) {
        break;
    }
    $method = $message["method"] ?? null;
    $params = $message["params"] ?? {};

    /*
     * A message shaped other than a handler expects (params missing a key a real client
     * always sends, say) is an error response for a request, and just dropped for a
     * notification, either way not the end of the server: one bad message shouldn't cost
     * every document open in the session.
     */
    try {
        match ($method) {
            "initialize" => respond($connection, $message["id"], {
                "capabilities" => {
                    // Full sync only: a change replaces the whole text, the simplest that works
                    "textDocumentSync" => 1,
                    "hoverProvider" => true,
                    "definitionProvider" => true,
                    "completionProvider" => {},
                },
            }),
            "shutdown" => respond($connection, $message["id"], null),
            "exit" => exit(0),
            "textDocument/didOpen" => open_or_change($connection, $params["textDocument"]["uri"], $params["textDocument"]["text"]),
            "textDocument/didChange" => open_or_change(
                $connection,
                $params["textDocument"]["uri"],
                last($params["contentChanges"])["text"]
            ),
            "textDocument/hover" => respond($connection, $message["id"], hover($params["textDocument"]["uri"], $params["position"])),
            "textDocument/definition" => respond($connection, $message["id"], definition($params["textDocument"]["uri"], $params["position"])),
            "textDocument/completion" => respond($connection, $message["id"], completions($params["textDocument"]["uri"])),
            default => has_key($message, "id")
                ? $connection.write({
                    "jsonrpc" => "2.0",
                    "id" => $message["id"],
                    "error" => {"code" => -32601, "message" => "Method not found: {$method}"},
                })
                /* An unhandled notification (initialized, textDocument/didClose, ...) is
                 * ignored, as the protocol allows */
                : null,
        }
    } catch (Error $e) {
        if (has_key($message, "id")) {
            $connection.write({"jsonrpc" => "2.0", "id" => $message["id"], "error" => {"code" => -32603, "message" => $e.message}});
        }
    }
}
