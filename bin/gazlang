#!/usr/bin/env php
<?php

// Settings that only take effect when PHP starts, so run again with them if they're missing:
// - With pcov enabled every PHP call uses the C stack, so deep GazLang recursion segfaults
//   long before the interpreter's call depth limit.
// - PHP's JIT compiling hot functions (opcache.jit=1235) makes the VM about 25% faster. The
//   default tracing mode makes it twice as slow, and compiling everything on load (1205)
//   adds 0.2s to every run. Not with Xdebug, which disables the JIT with a warning in the output.
$restart = [];
if (extension_loaded('pcov') && ini_get('pcov.enabled')) {
    array_push($restart, '-d', 'pcov.enabled=0');
}
if (extension_loaded('Zend OPcache') && ! extension_loaded('xdebug') && ! (ini_get('opcache.enable_cli') && ini_get('opcache.jit') === '1235')) {
    array_push($restart, '-d', 'opcache.enable_cli=1', '-d', 'opcache.jit_buffer_size=16M', '-d', 'opcache.jit=1235');
}
if ($restart !== []) {
    passthru(implode(' ', array_map('escapeshellarg', [PHP_BINARY, ...$restart, ...$argv])), $exitCode);
    exit($exitCode);
}

// Autoload classes
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php', // Composer autoload
    __DIR__ . '/../../../autoload.php', // Installed as a dependency
];

foreach ($autoloadPaths as $file) {
    if (file_exists($file)) {
        require_once $file;
        break;
    }
}

use GazLang\Lexer\Lexer;
use GazLang\Lexer\Token;
use GazLang\Parser\Parser;
use GazLang\Interpreter\Interpreter;
use GazLang\CodeGenerator\CodeGenerator;
use GazLang\CodeGenerator\Program;
use GazLang\VM\VM;
use GazLang\Runtime\ExitSignal;

/**
 * Display help message
 */
function showHelp() {
    echo "GazLang - A simple programming language compiler\n";
    echo "Usage: gazlang [options] [--] [program arguments...]\n";
    echo "Options:\n";
    echo "  -h, --help     Show this help message\n";
    echo "  -v, --version  Show version information\n";
    echo "  -c, --code         Print the compiled bytecode instead of running it (gazlang -c -f x.gaz > x.gzb)\n";
    echo "      --interpreter  Run on the tree-walking interpreter instead of the VM\n";
    echo "  -t, --tokens   Print the lexer's tokens, one LINE TYPE VALUE per line, instead of interpreting\n";
    echo "  -f, --file     Read input from a file instead of stdin\n";
}

/**
 * Display version information
 */
function showVersion() {
    echo "GazLang version 0.1.0\n";
}

// Parse command-line arguments
$options = getopt("hvf:ct", ["help", "version", "file:", "code", "tokens", "interpreter"], $rest_index);
// Everything after the options (or after --) is passed to the program, see args()
$programArgs = array_slice($argv, $rest_index);

// getopt silently skips options it doesn't know, which would drop a program's own
// flags (gazlang -f a.gaz -n 5 gives args() ["5"]), so reject them instead
for ($i = 1; $i < $rest_index; $i++) {
    if (preg_match('/^(-[hvct]*f|--file)$/', $argv[$i])) {
        $i++; // the file name that follows
    } elseif (! preg_match('/^(-[hvct]+|-[hvct]*f.+|--(help|version|code|tokens|interpreter|file=.+)|--)$/', $argv[$i])) {
        echo "Error: Unknown option {$argv[$i]} (put program arguments after --)\n";
        exit(1);
    }
}

if (isset($options['h']) || isset($options['help'])) {
    showHelp();
    exit(0);
}

if (isset($options['v']) || isset($options['version'])) {
    showVersion();
    exit(0);
}

$mode = match (true) {
    isset($options['t']) || isset($options['tokens']) => 'tokens',
    isset($options['c']) || isset($options['code']) => 'code',
    isset($options['interpreter']) => 'interpret',
    default => 'vm',
};
$inputFile = $options['f'] ?? ($options['file'] ?? null);

if ($inputFile) {
    // Read from file
    if (!is_file($inputFile) || !is_readable($inputFile)) {
        echo "Error: Cannot read file: $inputFile\n";
        exit(1);
    }
    
    $text = file_get_contents($inputFile);
    exit(processInput($text, $mode, $inputFile, $programArgs) ? 0 : 1);
}

// Check if input is piped
$isPiped = !posix_isatty(STDIN);

if ($isPiped) {
    // Process all piped input at once
    $input = '';
    while (!feof(STDIN)) {
        $input .= fgets(STDIN);
    }
    exit(processInput($input, $mode, null, $programArgs) ? 0 : 1);
}

// Interactive mode
echo "GazLang Interpreter\n";
echo "Type 'exit' or 'quit' to exit\n";

while (true) {
    $line = fgets(STDIN);
    // End of input (Ctrl-D)
    if ($line === false) {
        break;
    }
    $line = trim($line);

    if ($line === 'exit' || $line === 'quit') {
        break;
    }
    
    if (empty($line)) {
        continue;
    }
    
    processInput($line, $mode, null, $programArgs);
}

/**
 * Process input text
 * 
 * @param string $text         The input text to process
 * @param string $mode         vm (compile and run on the VM), interpret (run on the interpreter), code (print the bytecode) or tokens (print the tokens)
 * @param string|null $path    The file the text came from, so includes resolve relative to it
 * @param array  $args         Command line arguments for the program
 * @return bool Whether the input ran without errors
 */
function processInput(string $text, string $mode = 'vm', ?string $path = null, array $args = []): bool {
    try {
        // Bytecode is run as it is: it says so on its first line, which no GazLang program can
        if (str_starts_with($text, Program::MAGIC)) {
            if ($mode === 'code') {
                echo $text;

                return true;
            }
            if ($mode === 'tokens' || $mode === 'interpret') {
                echo "Error: {$path} is bytecode, which only the VM runs\n";

                return false;
            }
            (new VM(Program::read($text, $path), $args))->run();

            return true;
        }

        $lexer = new Lexer($text);

        if ($mode === 'tokens') {
            // Streamed, so the tokens before a lexer error are still printed
            do {
                $token = $lexer->get_next_token();
                echo $token, "\n";
            } while ($token->type !== Token::EOF);

            return true;
        }

        $parser = new Parser($lexer, $path);

        if ($mode === 'code') {
            // The compiled program as a bytecode file, which gazlang can run: gazlang -c -f x.gaz > x.gzb
            echo (new CodeGenerator($parser->parse()))->compile()->write($path);
        } elseif ($mode === 'interpret') {
            (new Interpreter($parser, $args))->interpret();
        } else {
            (new VM((new CodeGenerator($parser->parse()))->compile(), $args))->run();
        }
    } catch (ExitSignal $e) {
        exit($e->code);
    } catch (Throwable $e) {
        echo "Error: " . $e->getMessage() . "\n";

        return false;
    }

    return true;
} 