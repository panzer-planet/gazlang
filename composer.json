{
    "name": "werner/gazlang",
    "description": "A programming language",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^2.2",
        "laravel/pint": "^1.32"
    },
    "autoload-dev": {
        "psr-4": {
            "GazLang\\Tests\\": "tests/",
            "GazLang\\Games\\": "games/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint"
    }
}
