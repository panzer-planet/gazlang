{
    "name": "werner/gazlang",
    "description": "A programming language",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.2"
    },
    "autoload-dev": {
        "psr-4": {
            "GazLang\\Tests\\": "tests/",
            "GazLang\\Games\\": "games/"
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "pest --parallel"
        ],
        "test:serial": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "ci": [
            "phpstan clear-result-cache",
            "@analyse",
            "pint --test",
            "@test"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
