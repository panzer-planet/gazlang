{
    "name": "werner/gazlang",
    "description": "A simple programming language compiler",
    "type": "project",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "phpstan/phpstan": "^2.2",
        "laravel/pint": "^1.32"
    },
    "autoload": {
        "psr-4": {
            "GazLang\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GazLang\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "format": "pint"
    }
}
