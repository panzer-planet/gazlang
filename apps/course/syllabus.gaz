/**
 * The course as written: one Markdown file per lesson in `lessons/`, read in the order of their
 * names, which the database is filled from when the app starts (`course::seed()` in
 * `schema.gaz`).
 *
 * A lesson's file is named for its place and its slug, `03-first-program.md`, and looks like
 * this:
 *
 *     ---
 *     unit: Getting started
 *     title: Your first program
 *     ---
 *     The lesson, in the Markdown `markup.gaz` reads.
 *
 *     ## Question
 *     Which command runs hello.gaz?
 *
 *     - [ ] php hello.gaz
 *     - [x] gaz hello.gaz
 *
 * The slug is the lesson's identity: rename one and its students' progress on it is gone.
 */
namespace syllabus;

import "std/regex.gaz";
import "std/text.gaz";

const FILE_NAME = '\d\d-[a-z0-9-]+\.md';
const PREFIX_LENGTH = 3;            // "03-"
const EXTENSION = ".md";
const FRONT_MATTER = "---";
const QUESTION_HEADING = "## Question";
const RIGHT = "- [x] ";
const WRONG = "- [ ] ";
const LEAST_CHOICES = 2;

/**
 * One answer to a lesson's question.
 */
pub final kind Choice {
    fn _(pub string #text, pub bool #correct) {}
}

/**
 * A lesson as written: where it sits, what it teaches, and the question that checks it.
 */
pub final kind Lesson {
    fn _(
        pub string #slug,
        pub string #unit,
        pub string #title,
        pub string #body,
        pub string #question,
        pub list #choices,
    ) {}
}

/**
 * Every lesson in `$directory`, in the order of their file names. Anything wrong with a file
 * is an error naming it, so a broken lesson stops the app before it serves one.
 */
pub fn read(string $directory): list {
    $names = filter(list_dir($directory), $name -> regex::matches($name, FILE_NAME));
    if (len($names) == 0) {
        throw "No lessons in {$directory}: each is a file named like 01-welcome.md";
    }

    return map($names, $name -> parse(slug_of($name), read_file("{$directory}/{$name}"), $name));
}

/**
 * The lesson that `$text`, a lesson file's contents, writes. `$source` names it in errors.
 */
pub fn parse(string $slug, string $text, string $source): Lesson {
    $lines = text::lines($text);
    $end = front_matter_end($lines, $source);
    $fields = front_matter(slice($lines, 1, $end - 1), $source);
    $rest = slice($lines, $end + 1);
    $question_at = index_of_line($rest, QUESTION_HEADING);
    if ($question_at == null) {
        throw "{$source} has no \"{QUESTION_HEADING}\" section";
    }
    $body = join(slice($rest, 0, $question_at), "\n") |> trim;
    [$question, $choices] = question_and_choices(slice($rest, $question_at + 1), $source);
    $unit = required($fields, "unit", $source);
    $title = required($fields, "title", $source);

    return Lesson($slug, $unit, $title, $body, $question, $choices);
}

fn slug_of(string $name): string {
    return slice($name, PREFIX_LENGTH, len($name) - PREFIX_LENGTH - len(EXTENSION));
}

fn front_matter_end(list $lines, string $source): int {
    if (len($lines) == 0 || $lines[0] != FRONT_MATTER) {
        throw "{$source} must start with a {FRONT_MATTER} line, then its unit and title";
    }
    $end = index_of_line(slice($lines, 1), FRONT_MATTER);
    if ($end == null) {
        throw "{$source}'s front matter never ends: close it with a {FRONT_MATTER} line";
    }

    return $end + 1;
}

fn front_matter(list $lines, string $source): map {
    $fields = {};
    foreach ($lines as $line) {
        $parts = split($line, ":", 2);
        if (len($parts) != 2) {
            throw "{$source}: a front matter line is \"name: value\", not \"{$line}\"";
        }
        $fields[trim($parts[0])] = trim($parts[1]);
    }

    return $fields;
}

fn required(map $fields, string $name, string $source): string {
    $value = $fields[$name] ?? "";
    if ($value == "") {
        throw "{$source} needs a {$name} in its front matter";
    }

    return $value;
}

/*
 * The question is the text before the choices; each choice is a "- [x] " (the right one) or a
 * "- [ ] " line.
 */
fn question_and_choices(list $lines, string $source): list {
    $question = [];
    $choices = [];
    foreach ($lines as $line) {
        if (starts_with($line, RIGHT)) {
            $choices[] = Choice(slice($line, len(RIGHT)), true);
        } else if (starts_with($line, WRONG)) {
            $choices[] = Choice(slice($line, len(WRONG)), false);
        } else if (len($choices) > 0 && trim($line) != "") {
            throw "{$source}: nothing but choices may follow the first choice, not \"{$line}\"";
        } else if (trim($line) != "") {
            $question[] = trim($line);
        }
    }
    check_choices($choices, $source);
    if (len($question) == 0) {
        throw "{$source} asks no question";
    }

    return [join($question, " "), $choices];
}

fn check_choices(list $choices, string $source): null {
    $right = filter($choices, $choice -> $choice.correct);
    if (len($choices) < LEAST_CHOICES) {
        throw "{$source} needs at least {LEAST_CHOICES} choices";
    }
    if (len($right) != 1) {
        throw "{$source} must mark exactly one choice right with \"{RIGHT}\", not " .. len($right);
    }
}

fn index_of_line(list $lines, string $wanted): ?int {
    foreach ($lines as $index => $line) {
        if (trim($line) == $wanted) {
            return $index;
        }
    }

    return null;
}
