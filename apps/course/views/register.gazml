namespace course;
import "std/web.gaz";
import "accounts.gaz";
@template register_page(Registration $form, string $csrf)
<section class="card narrow">
<h1>Create your account</h1>
<form method="post" action="/register">
  {{ web::csrf_field($csrf) }}
  <label for="name">Your name</label>
  <input id="name" name="name" value="{{ $form.name }}" autocomplete="name" required>
  <p class="error">{{ $form.errors["name"] ?? "" }}</p>

  <label for="email">Email</label>
  <input id="email" name="email" type="email" value="{{ $form.email }}" autocomplete="email" required>
  <p class="error">{{ $form.errors["email"] ?? "" }}</p>

  <label for="password">Password</label>
  <input id="password" name="password" type="password" autocomplete="new-password" minlength="{{ MIN_PASSWORD }}" required>
  <p class="error">{{ $form.errors["password"] ?? "" }}</p>

  <button type="submit">Create account</button>
</form>
<p class="aside">Have an account already? <a href="/login">Sign in</a>.</p>
</section>
