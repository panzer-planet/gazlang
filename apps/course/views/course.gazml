namespace course;
import "store.gaz";
import "learning.gaz";
@template course_page(User $user, Progress $progress)
<h1>Hi, {{ $user.name }}</h1>
@if ($progress.finished())
<section class="card done">
  <h2>You finished the course</h2>
  <p>All {{ $progress.total() }} lessons passed. Keep the
  <a href="https://github.com/panzer-planet/gazlang/blob/master/docs/language.md">language reference</a>
  close, and build something.</p>
</section>
@else
<section class="card">
  <p>{{ $progress.passed_count() }} of {{ $progress.total() }} lessons passed.</p>
  <progress value="{{ $progress.passed_count() }}" max="{{ $progress.total() }}"></progress>
  <p><a class="button" href="/lessons/{{ $progress.next_up().slug }}">{{ $progress.passed_count() == 0 ? "Start" : "Continue" }}: {{ $progress.next_up().title }}</a></p>
</section>
@endif
@foreach ($progress.units() as $unit => $lessons)
<section class="unit">
  <h2>{{ $unit }} <span class="count">{{ $progress.passed_of($lessons) }} of {{ len($lessons) }}</span></h2>
  <ol class="lessons">
@foreach ($lessons as $lesson)
    <li value="{{ $lesson.number() }}" class="{{ $progress.has_passed($lesson) ? "passed" : "open" }}">
      <a href="/lessons/{{ $lesson.slug }}">{{ $lesson.title }}</a>
      <span class="mark">{{ $progress.has_passed($lesson) ? "Passed" : "" }}</span>
    </li>
@endforeach
  </ol>
</section>
@endforeach
