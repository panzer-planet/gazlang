/*
 * The response a handler gives for a page (a redirect is http::redirect). A response is a map, and
 * an Html body is sent as text/html.
 */
namespace todo;

fn page(Html $body, int $status = 200): map {
    return {"status" => $status, "body" => $body, "headers" => {"Cache-Control" => "no-store"}};
}
