namespace todo;
import "std/web.gaz";
import "forms.gaz";
@template edit_page(string $csrf, int $id, TodoForm $form, map $errors)
<h1>Edit todo</h1>

<form method="post" action="/todos/{{ $id }}" class="add">
    {{ web::csrf_field($csrf) }}
    <input
        type="text"
        name="title"
        value="{{ $form.title }}"
        maxlength="200"
        required
        autofocus
    >
    <input type="datetime-local" name="due" value="{{ $form.due }}" aria-label="Due (optional)">
    <button type="submit">Save</button>
</form>

@if (has_key($errors, "title"))
    <p class="error">{{ $errors["title"] }}</p>
@endif
@if (has_key($errors, "due"))
    <p class="error">{{ $errors["due"] }}</p>
@endif

<p><a href="/">Back to the list</a></p>
