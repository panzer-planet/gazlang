/*
 * UTF-8, which strings are bytes of: whether some are well formed (RFC 3629: no overlong forms, no
 * surrogates, nothing above U+10FFFF), and how many characters they hold. The database refuses
 * text that isn't, so a form's text is checked here, where it can be answered as a mistake in the
 * form, and not by the database, where it is a 500.
 */
namespace todo;

const CONTINUATION_FIRST = 0x80;
const CONTINUATION_LAST = 0xBF;

// How many bytes follow a lead byte, and the range its first follower must be in, or null for a byte that can't lead
fn lead_byte(int $byte): ?list {
    return match {
        $byte < 0x80 => [0, 0, 0],
        $byte >= 0xC2 && $byte <= 0xDF => [1, CONTINUATION_FIRST, CONTINUATION_LAST],
        $byte == 0xE0 => [2, 0xA0, CONTINUATION_LAST],
        $byte == 0xED => [2, CONTINUATION_FIRST, 0x9F],
        $byte >= 0xE1 && $byte <= 0xEF => [2, CONTINUATION_FIRST, CONTINUATION_LAST],
        $byte == 0xF0 => [3, 0x90, CONTINUATION_LAST],
        $byte == 0xF4 => [3, CONTINUATION_FIRST, 0x8F],
        $byte >= 0xF1 && $byte <= 0xF3 => [3, CONTINUATION_FIRST, CONTINUATION_LAST],
        default => null,
    };
}

fn is_continuation(int $byte): bool {
    return $byte >= CONTINUATION_FIRST && $byte <= CONTINUATION_LAST;
}

// Whether the bytes of $text are one well formed UTF-8 string
fn utf8_valid(string $text): bool {
    $at = 0;
    $end = len($text);
    while ($at < $end) {
        $lead = lead_byte(ord($text[$at]));
        if ($lead == null) {
            return false;
        }
        [$followers, $lowest, $highest] = $lead;
        if ($at + $followers >= $end) {
            return false;
        }
        if ($followers > 0) {
            $first = ord($text[$at + 1]);
            if ($first < $lowest || $first > $highest) {
                return false;
            }
            for ($i = 2; $i <= $followers; $i++) {
                if (!is_continuation(ord($text[$at + $i]))) {
                    return false;
                }
            }
        }
        $at += $followers + 1;
    }

    return true;
}

// The characters in well formed UTF-8: the bytes that begin one
fn utf8_length(string $text): int {
    $count = 0;
    foreach (split($text, "") as $byte) {
        if (!is_continuation(ord($byte))) {
            $count++;
        }
    }

    return $count;
}
