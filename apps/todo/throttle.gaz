/*
 * Limiting how often logins can be tried, per client: within the window a login is refused without
 * checking the password at all after MAX_PAIR_FAILURES wrong ones for the same email from the same
 * address, or MAX_ADDRESS_FAILURES from the same address whatever the emails, which also keeps the
 * work of hashing off the workers. The failures are rows, so every worker sees the same count.
 *
 * The address is http::client_address()'s. A client whose address isn't known (null) is counted
 * under UNKNOWN_ADDRESS, one bucket for all of them, so it is limited rather than let through; rows
 * from before addresses were recorded have a null address, match no bucket and age out.
 *
 * A login that works clears its own email and address's failures and nothing else: clearing the
 * address's would let a guesser start its count again by logging into an account of its own
 * between guesses.
 *
 * ponytail: nothing limits one email across many addresses, so that a stranger can't lock a known
 * email out; a guesser with many addresses is slowed only by Argon2id. A slower limit per email
 * (say 100 a day), or a check that costs a human little (a captcha) after a few, would close it.
 */
namespace todo;

import "std/db.gaz";

const MAX_PAIR_FAILURES = 5;
const MAX_ADDRESS_FAILURES = 20;
const UNKNOWN_ADDRESS = "unknown";   // never an address's text, so no client shares the bucket

kind LoginThrottle {
    fn _(#db) {}

    pub fn blocked(string $email, ?string $address): bool {
        $bucket = bucket($address);
        $counts = #db.row(db::sql"select count(*) filter (where email = {$email}) as pair, count(*) as address from login_failures where address = {$bucket} and failed_at > now() - interval '15 minutes'");

        return $counts["pair"] >= MAX_PAIR_FAILURES || $counts["address"] >= MAX_ADDRESS_FAILURES;
    }

    pub fn record_failure(string $email, ?string $address) {
        $bucket = bucket($address);
        #db.exec(db::sql"insert into login_failures (email, address) values ({$email}, {$bucket})");
    }

    // A login that worked starts the count for its email and address again, and only theirs
    pub fn clear(string $email, ?string $address) {
        $bucket = bucket($address);
        #db.exec(db::sql"delete from login_failures where email = {$email} and address = {$bucket}");
    }

    // Forget what is too old to count
    pub fn purge() {
        #db.exec(db::raw("delete from login_failures where failed_at < now() - interval '1 day'"));
    }
}

fn bucket(?string $address): string {
    return $address ?? UNKNOWN_ADDRESS;
}
