/* What the forms accept and say, without a request in the way */
namespace todo;

import "std/test.gaz" use expect;
import "forms.gaz";
import "todos.gaz";
import "std/date.gaz";

fn form_request($body) {
    return {"method" => "POST", "path" => "/", "query" => "", "headers" => {"content-type" => "application/x-www-form-urlencoded"}, "body" => $body};
}

fn registration($email, $password, $confirmation = null) {
    return RegistrationForm($email, $password, $confirmation ?? $password);
}

/* Registration */
expect("a good registration", registration("ada@example.com", "correct horse battery").errors(), {});
expect("an email is needed", registration("", "correct horse battery").errors(), {"email" => "Enter your email address"});
foreach (["nope", "a@b", "@example.com", "a b@example.com", "a@@example.com", "ada@example.", "a\x07@example.com", "\xff@example.com", repeat("a", 250) .. "@example.com"] as $email) {
    expect("not an email: " .. slice(to_string([$email]), 1, -1), registration($email, "correct horse battery").errors(), {"email" => "That doesn't look like an email address"});
}
expect("a password under ten characters", registration("ada@example.com", "123456789").errors(), {"password" => "Use at least 10 characters"});
expect("ten characters, counted as characters", registration("ada@example.com", repeat("\xc3\xa9", 10)).errors(), {});
expect("nine multibyte characters are nine", registration("ada@example.com", repeat("\xc3\xa9", 9)).errors(), {"password" => "Use at least 10 characters"});
expect("a password over 256 characters", registration("ada@example.com", repeat("x", 257)).errors(), {"password" => "Use at most 256 characters"});
expect("256 multibyte characters are allowed", registration("ada@example.com", repeat("\xc3\xa9", 256)).errors(), {});
expect("257 multibyte characters are not", registration("ada@example.com", repeat("\xc3\xa9", 257)).errors(), {"password" => "Use at most 256 characters"});
expect("an email of 254 characters", registration(repeat("a", 242) .. "@example.com", "correct horse battery").errors(), {});
expect("a password that isn't text", registration("ada@example.com", "\xff\xfe\xff\xfe\xff\xfe\xff\xfe\xff\xfe").errors(), {"password" => "Use letters, digits and symbols only"});
expect("the confirmation must match", registration("ada@example.com", "correct horse battery", "correct horse batter").errors(), {"confirmation" => "The two passwords are not the same"});

/* Reading a request */
$read = RegistrationForm::from_request(form_request("email=%20Ada%40Example.COM%20&password=correct+horse&confirmation=x"));
expect("an email is trimmed and lower cased, a password is not", [$read.email, $read.password], ["ada@example.com", "correct horse"]);
$blank = RegistrationForm::from_request({"method" => "POST", "path" => "/", "query" => "", "headers" => {"content-type" => "application/json"}, "body" => "{\"email\":\"ada@example.com\"}"});
expect("a body that isn't a form has every field blank", [$blank.email, $blank.password], ["", ""]);
$array = RegistrationForm::from_request(form_request("email[]=a&email[]=b"));
expect("email[] is another key, so the field is blank", $array.email, "");
$twice = RegistrationForm::from_request(form_request("email=a%40b.co&email=c%40d.co"));
expect("a field given twice keeps the last value", $twice.email, "c@d.co");
$missing = TodoForm::from_request(form_request(""));
expect("a missing field is blank", $missing.title, "");

/* Login */
expect("a login with both fields", LoginForm("ada@example.com", "x").errors(), {});
expect("a blank login", LoginForm("", "").errors(), {"login" => "Enter your email address and password"});
expect("an email that isn't text is a failed login, not an error", LoginForm("\xff", "x").errors(), {"login" => "Enter your email address and password"});
expect("a long password in characters is a login to try", LoginForm("a@b.co", repeat("\xc3\xa9", 256)).errors(), {});
expect("a huge password isn't hashed", LoginForm("a@b.co", repeat("x", 257)).errors(), {"login" => "Enter your email address and password"});

/* Todos */
expect("a title", TodoForm("buy milk").errors(), {});
expect("a title is needed", TodoForm("").errors(), {"title" => "Write something to do"});
expect("200 characters", TodoForm(repeat("x", 200)).errors(), {});
expect("201 characters", TodoForm(repeat("x", 201)).errors(), {"title" => "Keep it to 200 characters on one line"});
expect("200 emoji", TodoForm(repeat("\xf0\x9f\x98\x80", 200)).errors(), {});
foreach (["a\nb", "a\tb", "a\0b", "a\x7fb", "\xff"] as $title) {
    expect("not a title: " .. slice(to_string([$title]), 1, -1), TodoForm($title).errors(), {"title" => "Keep it to 200 characters on one line"});
}

/* When a todo is due */
$london = date::zone("Europe/London");
expect("no due date is fine", [TodoForm("x").errors(), TodoForm("x").due_at($london), TodoForm("x").due_note($london)], [{}, null, null]);
expect("a due date as the field sends it", [TodoForm("x", "2026-10-05T14:30").errors(), TodoForm("x", "2026-10-05T14:30").due_at($london)], [{}, date::parse("2026-10-05T14:30:00+01:00").time]);
expect("read in the zone it is given", TodoForm("x", "2026-10-05T14:30").due_at(date::utc()), date::parse("2026-10-05T14:30:00Z").time);
foreach (["tomorrow", "2026-10-05", "2026-10-05T14", "2026-02-29T10:00", "2026-10-05T14:30Z", "\xff"] as $due) {
    expect("not a due date: " .. slice(to_string([$due]), 1, -1), TodoForm("x", $due).errors(), {"due" => "Give the date and time it is due, such as 2026-10-05T14:30"});
}
expect("the years it may be in", [TodoForm("x", "1970-01-01T00:00").errors(), TodoForm("x", "2999-12-31T23:59").errors(), TodoForm("x", "1969-12-31T23:59").errors(), TodoForm("x", "3000-01-01T00:00").errors()], [{}, {}, {"due" => "Choose a date between 1970 and 2999"}, {"due" => "Choose a date between 1970 and 2999"}]);
expect("both fields can be wrong at once", TodoForm("", "nope").errors(), {"title" => "Write something to do", "due" => "Give the date and time it is due, such as 2026-10-05T14:30"});
expect("the field is trimmed", TodoForm::from_request(form_request("title=x&due=%202026-10-05T14%3A30%20")).due, "2026-10-05T14:30");
$skipped = TodoForm("x", "2026-03-29T01:30");
expect("a time the clocks skip", [$skipped.errors(), $skipped.due_at($london), $skipped.due_note($london)], [{}, date::parse("2026-03-29T02:30:00+01:00").time, "The clocks in Europe/London skip that time as they go forward, so it is due at 02:30 BST on 29 Mar."]);
$twice = TodoForm("x", "2026-10-25T01:30");
expect("a time the clocks show twice", [$twice.errors(), $twice.due_at($london), $twice.due_note($london)], [{}, date::parse("2026-10-25T01:30:00+01:00").time, "The clocks in Europe/London show that time twice as they go back, so it is due the first time, 01:30 BST on 25 Oct."]);
expect("neither happens in a zone whose clocks don't change", [$skipped.due_note(date::utc()), $twice.due_note(date::fixed(7200))], [null, null]);

/* Which todos the list shows */
$open = Todo(1, 1, "open", false, 0);
$done = Todo(2, 1, "done", true, 0);
expect("all, open and done", [Filter::All.shows($open), Filter::All.shows($done), Filter::Open.shows($open), Filter::Open.shows($done), Filter::Done.shows($open), Filter::Done.shows($done)], [true, true, true, false, false, true]);
expect("their addresses", map(Filter::cases(), $filter -> $filter.path()), ["/", "/?show=open", "/?show=done"]);
expect("their links and empty lists", map(Filter::cases(), $filter -> [$filter.label(), $filter.empty_text()]), [["All", "Nothing to do. Enjoy it."], ["Open", "Nothing left to do."], ["Done", "Nothing done yet."]]);
foreach (["", "//evil.example", "Open", "done ", "all\r\n"] as $name) {
    $filter = Filter::from($name, Filter::All);
    expect("anything else is all: " .. slice(to_string([$name]), 1, -1), [$filter, $filter.path()], [Filter::All, "/"]);
}
$query = $text -> ({"method" => "GET", "path" => "/", "query" => $text, "headers" => {}, "body" => ""});
expect("from the query string", [Filter::from_query($query("show=open")), Filter::from_query($query("")), Filter::from_query($query("show=%zz")), Filter::from_query($query("show[]=open"))], [Filter::Open, Filter::All, Filter::All, Filter::All]);
expect("from a form", [Filter::from_form(form_request("show=done")), Filter::from_form(form_request(""))], [Filter::Done, Filter::All]);
test::done();
