/*
 * What the app's tests share: a database made fresh, and a browser (http::TestClient) that talks to
 * the app's router as one does, keeping the cookies it is given, so a test reads like a person using
 * the site.
 * Nothing here is a test (it isn't named *_test.gaz), so `gaz test` doesn't run it.
 */
namespace todo;

import "std/http.gaz";
import "std/db.gaz";
import "std/date.gaz";
import "std/fs.gaz";
import "app.gaz";
import "database.gaz";
import "config.gaz";

const TEST_DATABASE = "postgres:///gaz_todo_test";
const CHEAP_PASSWORDS = {"m" => 64, "t" => 1, "p" => 1};
const TEST_SECRET = "a-secret-for-tests-that-is-long-enough";
const TEST_OFFSET = 7200;   // the zone times are shown in, two hours ahead of UTC
const BROWSER_ADDRESS = "192.0.2.1";   // where a browser's requests come from unless it says

// The app's own directory, the tests' parent, wherever they were started
fn app_directory(): string {
    return fs::parent(main_dir());
}

// The test database with the schema up to date and no rows
fn fresh_database() {
    $db = connect(getenv("TODO_TEST_DATABASE_URL") ?? TEST_DATABASE);
    migrate($db, app_directory() .. "/migrations");
    $db.exec(db::raw("truncate users, login_failures restart identity cascade"));

    return $db;
}

fn test_config(): Config {
    return Config("unused", TEST_SECRET, "127.0.0.1", 0, 1, false, CHEAP_PASSWORDS, date::fixed(TEST_OFFSET));
}

// The test Config behind a proxy at $proxy, whose X-Forwarded-For it trusts
fn proxied_config(string $proxy): Config {
    return Config("unused", TEST_SECRET, "127.0.0.1", 0, 1, false, CHEAP_PASSWORDS, date::fixed(TEST_OFFSET), [$proxy]);
}

// The same in a zone whose clocks change, from the system's time zone database
fn london_config(): Config {
    return Config("unused", TEST_SECRET, "127.0.0.1", 0, 1, false, CHEAP_PASSWORDS, date::zone("Europe/London"));
}

// A browser on the app's router, its requests from $address (null: a client the system no longer knows)
fn browser($db, Config $config, ?string $address = BROWSER_ADDRESS): http::TestClient {
    return http::TestClient(build_app($config, $db, app_directory()).handler(), {"remote_address" => $address});
}

// What a response's body says, as text
fn text_of(map $response): string {
    return $response["body"];
}

fn location_of(map $response): ?string {
    return $response["headers"]["location"] ?? null;
}

// The titles of the todos a page lists, in order
fn titles_in(map $response): list {
    $pieces = slice(split(text_of($response), "<span class=\"title\">"), 1);

    return map($pieces, $piece -> split($piece, "</span>")[0]);
}
