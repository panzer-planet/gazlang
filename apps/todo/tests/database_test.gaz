/* Migrations: applied in order, once each, and a broken one leaves nothing behind */
namespace todo;

import "std/test.gaz" use expect, throws;
import "std/db.gaz";
import "./support.gaz";
import "database.gaz";

// What the database refused, and which of its constraints said so, or null when it didn't
fn refusal($f) {
    try {
        $f();
    } catch (db::Failure $e) {
        return [$e.problem, $e.constraint];
    }
    return null;
}

$db = connect(getenv("TODO_TEST_DATABASE_URL") ?? TEST_DATABASE);
$db.exec(db::raw("drop table if exists users, todos, login_failures, schema_migrations cascade"));

$migrations = app_directory() .. "/migrations";
$files = filter(list_dir($migrations), $file -> ends_with($file, ".sql"));
expect("there are migrations to apply", len($files) >= 3, true);
$applied = migrate($db, $migrations);
expect("every migration is applied on a new database, in name order", $applied, $files);
$tables = map($db.query(db::sql"select table_name from information_schema.tables where table_schema = 'public' order by 1"), $row -> $row["table_name"]);
expect("and the tables are there", $tables, ["login_failures", "schema_migrations", "todos", "users"]);
expect("nothing is applied twice", migrate($db, $migrations), []);
expect("each is recorded", $db.value(db::sql"select count(*) from schema_migrations"), len($files));

/* The schema's own rules, which the app leans on */
$db.exec(db::sql"insert into users (email, password_hash) values ('a@b.co', 'x')");
expect("an email is unique", refusal(() -> $db.exec(db::sql"insert into users (email, password_hash) values ('a@b.co', 'y')")), [db::Problem::Unique, "users_email_key"]);
expect("a title can't be empty", refusal(() -> $db.exec(db::sql"insert into todos (user_id, title) values (1, '')")), [db::Problem::Check, "todos_title_check"]);
expect("a todo needs its user", refusal(() -> $db.exec(db::sql"insert into todos (user_id, title) values (999, 'x')")), [db::Problem::ForeignKey, "todos_user_id_fkey"]);
$db.exec(db::sql"insert into todos (user_id, title) values (1, 'x')");
$db.exec(db::sql"delete from users");
expect("a user's todos go with them", $db.value(db::sql"select count(*) from todos"), 0);

/* A migration that fails is rolled back whole, and not recorded */
$directory = "tests/.migrations_" .. rand_int(100000, 999999);
make_dir($directory);
write_file($directory .. "/001_ok.sql", "create table scratch_ok (id int);");
write_file($directory .. "/002_broken.sql", "create table scratch_half (id int); select nonsense_column from scratch_ok;");
$db.exec(db::raw("drop table if exists scratch_ok, scratch_half, schema_migrations_scratch cascade"));
throws("a broken migration raises", () -> migrate($db, $directory), "postgres: column \"nonsense_column\" does not exist");
expect("the one before it was kept", $db.value(db::sql"select count(*) from information_schema.tables where table_name = 'scratch_ok'"), 1);
expect("the broken one left nothing", $db.value(db::sql"select count(*) from information_schema.tables where table_name = 'scratch_half'"), 0);
expect("and was not recorded", $db.value(db::sql"select count(*) from schema_migrations where version like '%broken%'"), 0);
$db.exec(db::raw("drop table scratch_ok"));
$db.exec(db::sql"delete from schema_migrations where version = '001_ok.sql'");
delete_file($directory .. "/001_ok.sql");
delete_file($directory .. "/002_broken.sql");
delete_dir($directory);
test::done();
