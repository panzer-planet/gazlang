/* utf8_valid() and utf8_length(): what is well formed, checked at the edges of each form */
namespace todo;

include "std/test.gaz" use expect;
include "../utf8.gaz";

$well_formed = {
    "empty" => "", "ascii" => "plain text", "the last one byte character" => "\x7f", "the first two byte" => "\xc2\x80",
    "the last two byte" => "\xdf\xbf", "the first three byte" => "\xe0\xa0\x80", "just below the surrogates" => "\xed\x9f\xbf",
    "just above the surrogates" => "\xee\x80\x80", "the last of the basic plane" => "\xef\xbf\xbf", "the first four byte" => "\xf0\x90\x80\x80",
    "the last code point" => "\xf4\x8f\xbf\xbf", "accents and an emoji" => "caf\xc3\xa9 \xf0\x9f\x98\x80",
};
foreach ($well_formed as $label => $text) {
    expect("well formed: {$label}", utf8_valid($text), true);
}

$malformed = {
    "a continuation byte alone" => "\x80", "the last continuation byte alone" => "\xbf", "a byte that is never used (ff)" => "\xff", "a byte that is never used (fe)" => "\xfe",
    "an overlong slash (c0 af)" => "\xc0\xaf", "an overlong two byte (c1 bf)" => "\xc1\xbf", "an overlong three byte (e0 80 af)" => "\xe0\x80\xaf",
    "an overlong four byte (f0 80 80 af)" => "\xf0\x80\x80\xaf", "a surrogate (ed a0 80)" => "\xed\xa0\x80", "the last surrogate (ed bf bf)" => "\xed\xbf\xbf",
    "above the last code point (f4 90 80 80)" => "\xf4\x90\x80\x80", "a lead byte for five bytes (f8)" => "\xf8\x88\x80\x80\x80",
    "a two byte character cut off" => "ab\xc3", "a three byte character cut off after one" => "\xe2", "a three byte character cut off after two" => "\xe2\x82",
    "a four byte character cut off" => "\xf0\x9f\x98", "a follower that isn't one" => "\xe2\x28\xa1", "a lead byte then a lead byte" => "\xc3\xc3\xa9",
    "a NUL inside is fine for UTF-8 but not here" => null,
};
foreach ($malformed as $label => $text) {
    if ($text != null) {
        expect("malformed: {$label}", utf8_valid($text), false);
    }
}

expect("one character in each size", utf8_length("a\xc3\xa9\xe2\x82\xac\xf0\x9f\x98\x80"), 4);
expect("an empty string", utf8_length(""), 0);
expect("two hundred emoji are two hundred characters", utf8_length(repeat("\xf0\x9f\x98\x80", 200)), 200);
test::done();
