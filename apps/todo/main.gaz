/*
 * The todo app, run from any directory, with the environment saying where things are:
 *
 *   DATABASE_URL=postgres:///gaz_todo SESSION_SECRET=<32 or more random bytes> bin/gaz apps/todo/main.gaz
 *
 * Also read: HOST (127.0.0.1), PORT (8080), WORKERS (4), SECURE_COOKIES (1 to mark the session
 * cookie Secure, for use behind HTTPS), TRUSTED_PROXIES (none; the addresses of the proxies in front,
 * separated by commas, whose X-Forwarded-For says who the client is).
 * The schema is brought up to date, from migrations/ next to this file, before it listens.
 */
namespace todo;

import "std/http.gaz";
import "app.gaz";
import "config.gaz";
import "database.gaz";
import "throttle.gaz";

const REQUEST_BODY_LIMIT = 32768;
const REQUESTS_PER_WORKER = 5000;

$config = Config::from_environment();

// Migrate on a connection of its own, closed before the workers start
$setup = connect($config.database_url);
foreach (migrate($setup, main_dir() .. "/migrations") as $migration) {
    echo "migrated " .. $migration;
}
LoginThrottle($setup).purge();
$setup.close();

$listener = socket_listen($config.host, $config.port);
echo "listening on http://" .. $config.host .. ":" .. socket_port($listener);
workers($config.workers);

// Each worker opens its own: one opened before workers() can't be used in a worker
$db = connect($config.database_url);
http::serve($listener, build_app($config, $db, main_dir()).handler(), {
    "max_body" => REQUEST_BODY_LIMIT,
    "max_requests" => REQUESTS_PER_WORKER,
});
