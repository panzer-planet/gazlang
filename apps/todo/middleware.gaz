/*
 * The app's own middleware: who is logged in, and the routes only a logged in user reaches. The
 * rest of what wraps a request (security headers, the session and its flash, the CSRF and Origin
 * checks) is the library's (http::security_headers(), http::sessions(), http::csrf()), added before
 * these in build_app().
 */
namespace todo;

include "std/http.gaz";
include "users.gaz";

fn authentication(Users $users) {
    return ($request, $next) -> {
        $id = $request["session"]["user_id"] ?? null;
        $request["user"] = type_of($id) == "int" ? $users.find($id) : null;

        return $next($request);
    };
}

// A handler only a logged in user reaches; anyone else is sent to log in
fn authenticated($handler) {
    return $request -> $request["user"] == null ? http::redirect("/login") : $handler($request);
}
