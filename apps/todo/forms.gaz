/*
 * What a form or a query string sends, read and checked: a kind for each form, built from the
 * request, with errors() giving a map of field to message, empty when the form is good. A request
 * that isn't a form at all reads as one with every field blank, so it fails the same checks and
 * nothing else; a query string that can't be decoded reads as an empty one.
 */
namespace todo;

import "std/http.gaz";
import "std/regex.gaz";
import "std/date.gaz";
import "todos.gaz";

const MINIMUM_PASSWORD_LENGTH = 10;
const MAXIMUM_PASSWORD_LENGTH = 256;
const MAXIMUM_EMAIL_LENGTH = 254;
const EMAIL_PATTERN = '[^@ ]+@[^@ ]+\.[^@ ]+';
// Far enough for a todo, and near enough that the page can write the time in UTC whatever the zone
const FIRST_DUE_YEAR = 1970;
const LAST_DUE_YEAR = 2999;

fn field(map $fields, string $name): string {
    $value = $fields[$name] ?? "";

    return type_of($value) == "string" ? $value : "";
}

fn has_control_character(string $text): bool {
    foreach (split($text, "") as $byte) {
        if (ord($byte) < 32 || ord($byte) == 127) {
            return true;
        }
    }

    return false;
}

// Whether well formed text is longer than a limit, counted in characters as the messages say. Text that
// isn't well formed has no length, so it counts as too long: callers ask for validity first for the message
fn longer_than(string $text, int $maximum): bool {
    return !utf8_valid($text) || utf8_length($text) > $maximum;
}

// Text a person typed on one line: well formed UTF-8, since the database refuses anything else, and no control characters
fn is_plain_text(string $text): bool {
    return utf8_valid($text) && !has_control_character($text);
}

kind RegistrationForm {
    fn _(pub string #email, pub string #password, pub string #confirmation) {}

    pub static fn from_request(map $request): RegistrationForm {
        $fields = http::form($request, {});

        return RegistrationForm(lower(trim(field($fields, "email"))), field($fields, "password"), field($fields, "confirmation"));
    }

    pub fn errors(): map {
        $errors = {};
        $email = #email_error();
        if ($email != null) {
            $errors["email"] = $email;
        }
        $password = #password_error();
        if ($password != null) {
            $errors["password"] = $password;
        }
        if ($password == null && #confirmation != #password) {
            $errors["confirmation"] = "The two passwords are not the same";
        }

        return $errors;
    }

    fn email_error(): ?string {
        if (#email == "") {
            return "Enter your email address";
        }
        if (!is_plain_text(#email) || longer_than(#email, MAXIMUM_EMAIL_LENGTH) || !regex::matches(#email, EMAIL_PATTERN)) {
            return "That doesn't look like an email address";
        }

        return null;
    }

    fn password_error(): ?string {
        if (!utf8_valid(#password)) {
            return "Use letters, digits and symbols only";
        }
        if (utf8_length(#password) < MINIMUM_PASSWORD_LENGTH) {
            return "Use at least " .. MINIMUM_PASSWORD_LENGTH .. " characters";
        }
        if (longer_than(#password, MAXIMUM_PASSWORD_LENGTH)) {
            return "Use at most " .. MAXIMUM_PASSWORD_LENGTH .. " characters";
        }

        return null;
    }
}

kind LoginForm {
    fn _(pub string #email, pub string #password) {}

    pub static fn from_request(map $request): LoginForm {
        $fields = http::form($request, {});

        return LoginForm(lower(trim(field($fields, "email"))), field($fields, "password"));
    }

    // Blank fields only: whether the pair is right is the login's to say, and it says the same thing for both
    pub fn errors(): map {
        if (#email == "" || #password == "" || longer_than(#password, MAXIMUM_PASSWORD_LENGTH) || !is_plain_text(#email)) {
            return {"login" => "Enter your email address and password"};
        }

        return {};
    }
}

/*
 * A todo as the add and edit forms send it: a title, and when it is due as a datetime-local field
 * sends it ("2026-10-05T14:30", or "" for not due), read as the clocks of the app's zone show it
 */
kind TodoForm {
    fn _(pub string #title, pub string #due = "") {}

    pub static fn from_request(map $request): TodoForm {
        $fields = http::form($request, {});

        return TodoForm(trim(field($fields, "title")), trim(field($fields, "due")));
    }

    pub fn errors(): map {
        $errors = {};
        $title = #title_error();
        if ($title != null) {
            $errors["title"] = $title;
        }
        $due = #due_error();
        if ($due != null) {
            $errors["due"] = $due;
        }

        return $errors;
    }

    fn title_error(): ?string {
        if (#title == "") {
            return "Write something to do";
        }
        if (!is_plain_text(#title) || longer_than(#title, MAX_TITLE_LENGTH)) {
            return "Keep it to " .. MAX_TITLE_LENGTH .. " characters on one line";
        }

        return null;
    }

    fn due_error(): ?string {
        if (#due == "") {
            return null;
        }
        $reading = #reading();
        if ($reading == null) {
            return "Give the date and time it is due, such as 2026-10-05T14:30";
        }
        $year = date::year($reading.days);
        if ($year < FIRST_DUE_YEAR || $year > LAST_DUE_YEAR) {
            return "Choose a date between " .. FIRST_DUE_YEAR .. " and " .. LAST_DUE_YEAR;
        }

        return null;
    }

    fn reading(): ?date::Reading {
        return date::parse_reading(#due, null);
    }

    /*
     * When it is due, as a time, or null if it isn't, for a form without errors. A reading the
     * clocks skip or show twice is when an alarm set for it would go off: the time after the
     * skip, or the first of the two (due_note() says which happened)
     */
    pub fn due_at(date::Zone $zone): ?int {
        if (#due == "") {
            return null;
        }
        $reading = #reading();

        return $zone.time($reading.days, $reading.seconds, date::Resolution::Compatible);
    }

    // What a person should be told about when it is due, if the clocks skip it or show it twice
    pub fn due_note(date::Zone $zone): ?string {
        if (#due == "") {
            return null;
        }
        $reading = #reading();
        $times = $zone.occurrences($reading.days, $reading.seconds);
        if (len($times) == 1) {
            return null;
        }
        $due = $zone.at(#due_at($zone));
        $when = $due.short_clock() .. " " .. $due.abbreviation .. " on " .. $due.short();
        if (len($times) == 0) {
            return "The clocks in {$zone.name} skip that time as they go forward, so it is due at {$when}.";
        }

        return "The clocks in {$zone.name} show that time twice as they go back, so it is due the first time, {$when}.";
    }
}

/*
 * Which todos the list shows, from the list's ?show= or a form's "show" field. Anything else is
 * All, so path(), where a redirect goes, only ever names one of the three.
 */
enum Filter: string {
    All = "all";
    Open = "open";
    Done = "done";

    pub static fn from_query(map $request): Filter {
        return Filter::from(field(http::query($request, {}), "show"), Filter::All);
    }

    pub static fn from_form(map $request): Filter {
        return Filter::from(field(http::form($request, {}), "show"), Filter::All);
    }

    // The list's address with this filter: "/" or "/?show=open"
    pub fn path(): string {
        return # == Filter::All ? "/" : "/?show=" .. #value;
    }

    pub fn shows(Todo $todo): bool {
        return match (#) {
            Filter::All => true,
            Filter::Open => !$todo.done,
            Filter::Done => $todo.done,
        };
    }

    // What the list's link to it says
    pub fn label(): string {
        return match (#) {
            Filter::All => "All",
            Filter::Open => "Open",
            Filter::Done => "Done",
        };
    }

    // What the list says when it shows nothing
    pub fn empty_text(): string {
        return match (#) {
            Filter::All => "Nothing to do. Enjoy it.",
            Filter::Open => "Nothing left to do.",
            Filter::Done => "Nothing done yet.",
        };
    }
}
