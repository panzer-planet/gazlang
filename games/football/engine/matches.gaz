// What happens in a match
namespace matches;

include "../../../lib/format.gaz" use pad_left;
include "../../../lib/random.gaz";
include "../../../lib/lists.gaz" use max_by;

pub abstract kind Event {
    fn _(pub #minute, pub #team) {}
    pub abstract fn describe();
    pub fn to_string() { return pad_left("{#minute}'", 4) .. "  " .. #describe(); }
}

pub kind Goal extends Event {
    fn _($minute, $team, pub #scorer, #score) { ##_($minute, $team); }
    pub fn describe() { return "GOAL! {#scorer} scores for {#team}. {#score}"; }
}

pub kind Shot extends Event {
    // Without a keeper, the shot missed the target
    fn _($minute, $team, #shooter, #keeper) { ##_($minute, $team); }
    pub fn describe() {
        return #keeper == null ? "{#shooter} ({#team}) shoots wide" : "{#shooter} ({#team}) is denied by {#keeper}";
    }
}

pub kind Booking extends Event {
    fn _($minute, $team, pub #player, pub #red) { ##_($minute, $team); }
    pub fn describe() {
        return #red ? "RED CARD: {#player} ({#team}) is sent off" : "Yellow card for {#player} ({#team})";
    }
}

pub kind Injury extends Event {
    fn _($minute, $team, pub #player, pub #matches) { ##_($minute, $team); }
    pub fn describe() {
        return "{#player} ({#team}) is injured and has to go off: out for " .. #matches .. (#matches == 1 ? " match" : " matches");
    }
}

pub kind Substitution extends Event {
    fn _($minute, $team, pub #off, pub #on) { ##_($minute, $team); }
    pub fn describe() { return "Substitution for {#team}: {#on} replaces {#off}"; }
}

pub kind Whistle extends Event {
    fn _($minute, #text) { ##_($minute, null); }
    pub fn describe() { return #text; }
}

pub kind Fixture {
    pub #home_goals = 0;
    pub #away_goals = 0;
    // The minutes played so far
    pub #elapsed = 0;
    #started = false;
    #listeners = [];
    // How many fixtures have been played across every season this run, not just this league's
    pub static #matches_played = 0;

    fn _(pub #home, pub #away) {
        Fixture::matches_played++;
    }

    // $listener($event) is called for everything that happens
    pub fn on_event($listener) {
        #listeners[] = $listener;
        return #;
    }

    /* Get the players ready: rested, with nothing yet played. play() and tick() do this
       themselves, so it only matters to a matchday that starts every match before any is played. */
    pub fn start() {
        if (#started) {
            return #;
        }
        #started = true;
        #home.prepare();
        #away.prepare();
        #home.rest();
        #away.rest();

        return #;
    }

    pub fn finished() { return #elapsed >= 90; }

    /* Play the next minute: the match is played a minute at a time by calling this until it is
       finished(), which is how one is watched, and play() is just that in a loop */
    pub fn tick() {
        if (#finished()) {
            error("The match is over");
        }
        #start();
        #elapsed++;
        $minute = #elapsed;
        // Players tire as the match goes on
        if ($minute % 30 == 0) {
            #home.tire(30);
            #away.tire(30);
        }
        #minute($minute);
        if ($minute == 45) {
            #emit(Whistle(45, "Half time: {#}"));
        }
        if ($minute == 90) {
            #emit(Whistle(90, "Full time: {#}"));
        }

        return #;
    }

    /* Play what is left of the match */
    pub fn play() {
        while (!#finished()) {
            #tick();
        }

        return #;
    }

    // Thirty minutes more, for a cup tie level after ninety, the players tiring further
    pub fn extra_time() {
        for ($minute = 91; $minute <= 120; $minute++) {
            if ($minute % 15 == 0) {
                #home.tire(15);
                #away.tire(15);
            }
            // the clock runs on, so what happens in extra time is stamped with its minute
            #elapsed = $minute;
            #minute($minute);
        }
        #emit(Whistle(120, "After extra time: {#}"));
        return #;
    }

    // A shootout, giving how many each side scored: five kicks each, then one each until one
    // side is ahead, the sharpest attackers stepping up first, and each kick likelier to go in
    // the more the taker has over the keeper
    pub fn penalties() {
        $takers = map([#home, #away], $team -> sort($team.on_pitch(), ($a, $b) -> $b.attacking() <=> $a.attacking()));
        $keepers = [#away.goalkeeper(), #home.goalkeeper()];
        $scored = [0, 0];
        for ($kick = 0; $kick < 5 || $scored[0] == $scored[1]; $kick++) {
            foreach ([0, 1] as $side) {
                $taker = $takers[$side][$kick % len($takers[$side])];
                $keeper = $keepers[$side];
                if (random::chance(0.6 + 0.3 * $taker.attacking() / ($taker.attacking() + $keeper.defending() + 1))) {
                    $scored[$side]++;
                }
            }
        }
        return $scored;
    }

    fn minute($minute) {
        // A chance in about one minute in six, a foul in one in thirty, and most minutes nothing
        $roll = rand_float();
        if ($roll < 0.17) {
            // The home side gets a little more of the ball
            $home_attack = #home.attack() * 1.1;
            if (random::chance($home_attack / ($home_attack + #away.attack()))) {
                #attempt($minute, #home, #away);
            } else {
                #attempt($minute, #away, #home);
            }
        } else if ($roll < 0.2) {
            #foul($minute, random::chance(0.5) ? #home : #away);
        }
        // Now and then someone goes down: about two matches in five have an injury, and most are a
        // match or two but some are months, which leaves a club with a player or two out at a time
        if (random::chance(0.006)) {
            $team = random::chance(0.5) ? #home : #away;
            #injure($team, random::pick($team.on_pitch()), random::weighted([[1, 30], [2, 25], [3, 15], [4, 10], [6, 10], [8, 6], [12, 4]]));
        }
    }

    // $player of $team is injured, for this many matches: he goes off, and a substitute comes on for
    // him if there is one and a substitution left, and if not the team plays a man short
    pub fn injure($team, $player, $matches) {
        $player.injure($matches);
        $team.changed();
        #emit(Injury(#elapsed, $team, $player, $matches));
        if (!$team.can_substitute()) {
            return #;
        }
        $substitute = $team.best_substitute($player);
        if ($substitute != null) {
            $team.substitute($player, $substitute);
            #emit(Substitution(#elapsed, $team, $player, $substitute));
        }

        return #;
    }

    fn attempt($minute, $attackers, $defenders) {
        $shooter = $attackers.shooter();
        $keeper = $defenders.goalkeeper();

        // A better shooter against a weaker defence hits the target more often, and beats the keeper more often
        $on_target = $shooter.attacking() / ($shooter.attacking() + $defenders.defence() / 12);
        if (! random::chance($on_target * 0.8)) {
            #emit(Shot($minute, $attackers, $shooter, null));
            return;
        }
        if (random::chance($keeper.defending() / ($keeper.defending() + $shooter.attacking() * 1.1))) {
            $keeper.saves++;
            #emit(Shot($minute, $attackers, $shooter, $keeper));
            return;
        }

        $shooter.goals++;
        $shooter.match_goals++;
        if ($attackers == #home) {
            #home_goals++;
        } else {
            #away_goals++;
        }
        // The score as text now: the match itself will have moved on by the end
        #emit(Goal($minute, $attackers, $shooter, to_string(#)));
    }

    fn foul($minute, $team) {
        $player = random::weighted(map($team.on_pitch(), $player -> [$player, $player.defending() + 1]));
        $red = $player.book();
        if ($red) {
            $team.changed();
        }
        #emit(Booking($minute, $team, $player, $red));
    }

    fn emit($event) {
        foreach (#listeners as $listener) {
            $listener($event);
        }
    }

    pub fn to_string() { return "{#home} {#home_goals} - {#away_goals} {#away}"; }

    // The standout of the 22: goals and saves count for most, an overall attacking or
    // defensive display (attacking() + defending() reflects the day's sharpness) breaks a tie
    pub fn motm() {
        $all = [...#home.players, ...#away.players];
        return max_by($all, #motm_score);
    }

    fn motm_score($player) {
        return $player.match_goals * 5 + $player.saves * 2 + ($player.attacking() + $player.defending()) * 0.05;
    }
}
