// Players: a rating from 40 to 95, and every position turns it into attacking and defending
namespace players;

include "../../../lib/random.gaz";

pub abstract kind Player {
    kin #energy = 100;
    // What form() gives at the current energy and day_form, kept up to date by rest() and tire()
    kin #sharpness = 0;
    // Drawn fresh by rest(): some days everything comes off, others nothing does, whoever you
    // are, so a lesser player can have the game of their life and a star an off day
    kin #day_form = 1.0;
    // This season's, and every season's before it
    pub #goals = 0;
    pub #clean_sheets = 0;
    pub #career_goals = 0;
    pub #age = 0;
    pub #yellow_cards = 0;
    pub #sent_off = false;
    // This match only, reset by rest(): what motm() judges the man of the match on
    pub #match_goals = 0;
    pub #saves = 0;
    // How many matches are still to be missed, through injury or suspension. Counted down by the
    // team after each match the player was out at the start of (see Team.finish()), so what
    // happens in a match is served in the next one.
    pub #injured = 0;
    pub #suspended = 0;
    // Yellow cards this season, five of which are a suspension
    pub #season_yellows = 0;
    // Injured in the match being played, and off the pitch
    pub #hurt = false;

    fn _(#name, pub #rating, pub #number) {}

    pub abstract fn position();
    pub abstract fn attacking();
    pub abstract fn defending();
    // How much running the position does, which tires the player
    pub abstract fn work_rate();

    // How well the player is playing right now. Ability grows with the square of the rating,
    // so a 90 is far more dangerous than a 70, and tiredness wears it down
    pub fn form() {
        $ability = #rating / 75.0;
        return 70 * $ability * $ability * (60 + #energy * 0.4) / 100;
    }

    pub fn tire($minutes) {
        #energy = max(#energy - $minutes * #work_rate(), 40);
        #sharpness = #form() * #day_form;
    }

    pub fn rest() {
        #energy = 100;
        #day_form = #roll_day_form();
        #sharpness = #form() * #day_form;
        #yellow_cards = 0;
        #sent_off = false;
        #match_goals = 0;
        #saves = 0;
        #hurt = false;
    }

    // Most days are close to normal, but every so often, whoever you are, nothing comes off,
    // or everything does: uniform noise averages out over a season, so this leaves room for
    // rare, big swings that a run of them can carry a lesser player up the scoring charts
    fn roll_day_form() {
        $tier = random::weighted([["shocker", 10], ["normal", 65], ["good", 20], ["blinder", 5]]);
        return match ($tier) {
            "shocker" => 0.5 + rand_float() * 0.2,
            "normal" => 0.85 + rand_float() * 0.3,
            "good" => 1.2 + rand_float() * 0.3,
            "blinder" => 1.6 + rand_float() * 0.6,
        };
    }

    // The season is over: its goals join the career's, and the counts start again
    pub fn new_season() {
        #career_goals += #goals;
        #goals = 0;
        #clean_sheets = 0;
        #season_yellows = 0;
    }

    // A summer older, giving how much the rating moved: the young tend to improve, the
    // experienced hold steady and veterans fade
    pub fn grow_older() {
        #age++;
        $change = match {
            // Now and then a youngster has a breakthrough summer
            #age <= 21 => rand_int(0, 4) + (random::chance(0.1) ? rand_int(3, 6) : 0),
            #age <= 25 => rand_int(-1, 4),
            #age <= 29 => rand_int(-2, 2),
            #age <= 32 => rand_int(-4, 1),
            default => rand_int(-6, 0),
        };
        $rating = min(max(#rating + $change, 40), 95);
        $change = $rating - #rating;
        #rating = $rating;
        return $change;
    }

    // Whether this is the summer they hang up their boots: never before 33, always by 37
    pub fn retires() {
        return #age >= 33 && random::chance((#age - 32) * 0.2);
    }

    // A booking; the second yellow card is a red one, which is a match's suspension, and so is
    // the fifth yellow of a season
    pub fn book() {
        #yellow_cards++;
        #season_yellows++;
        #sent_off = #yellow_cards == 2;
        if (#sent_off) {
            #suspended = max(#suspended, 1);
        } else if (#season_yellows >= 5) {
            #suspended = max(#suspended, 1);
            #season_yellows = 0;
        }
        return #sent_off;
    }

    // Hurt in a match: off the pitch, and out for this many matches after it
    pub fn injure($matches) {
        #injured = $matches;
        #hurt = true;
    }

    // Whether the player can be picked
    pub fn available() { return #injured == 0 && #suspended == 0; }

    // Why not, as a few words, or "" when they can be picked
    pub fn status() {
        if (#injured > 0) {
            return "Injured " .. #injured;
        }
        if (#suspended > 0) {
            return "Banned " .. #suspended;
        }

        return "";
    }

    // What a saved career keeps of a player: who they are and what they have done, not how
    // they feel today, which the next match works out afresh
    pub fn to_data() {
        return {
            "position" => #position(), "name" => #name, "rating" => #rating, "number" => #number,
            "age" => #age, "career_goals" => #career_goals,
        };
    }

    pub fn to_string() { return #name; }
    pub fn profile() { return "#{#number} {#name} ({#position()} {#rating})"; }
}

pub kind Goalkeeper extends Player {
    pub fn position() { return "GK"; }
    pub fn work_rate() { return 0.2; }
    pub fn attacking() { return 0; }
    pub fn defending() { return #sharpness; }
}

pub kind Defender extends Player {
    pub fn position() { return "DF"; }
    pub fn work_rate() { return 0.8; }
    pub fn attacking() { return #sharpness * 0.2; }
    pub fn defending() { return #sharpness; }
}

pub kind Midfielder extends Player {
    pub fn position() { return "MF"; }
    pub fn work_rate() { return 1.3; }
    pub fn attacking() { return #sharpness * 0.6; }
    pub fn defending() { return #sharpness * 0.5; }
}

pub kind Forward extends Player {
    pub fn position() { return "FW"; }
    pub fn work_rate() { return 1.0; }
    pub fn attacking() { return #sharpness; }
    pub fn defending() { return #sharpness * 0.1; }

    // Strikers are at their sharpest while they are fresh
    pub fn form() { return ##form() * (#energy > 70 ? 1.1 : 0.9); }
}

// A player back from to_data()
pub fn from_data($data) {
    $kind = match ($data["position"]) {
        "GK" => Goalkeeper,
        "DF" => Defender,
        "MF" => Midfielder,
        "FW" => Forward,
    };
    $player = $kind($data["name"], $data["rating"], $data["number"]);
    $player.age = $data["age"];
    $player.career_goals = $data["career_goals"];
    return $player;
}
