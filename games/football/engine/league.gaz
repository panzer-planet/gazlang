// A league: everyone plays everyone home and away
namespace league;

include "../../../lib/format.gaz" use pad_left, pad_right;
include "../../../lib/random.gaz";
include "players.gaz" use Goalkeeper;
include "matches.gaz" use Fixture;

pub kind Standing {
    pub #played = 0;
    pub #won = 0;
    pub #drawn = 0;
    pub #lost = 0;
    pub #scored = 0;
    pub #conceded = 0;

    fn _(pub #team) {}

    pub fn record($scored, $conceded) {
        #played++;
        #scored += $scored;
        #conceded += $conceded;
        if ($scored > $conceded) {
            #won++;
        } else if ($scored == $conceded) {
            #drawn++;
        } else {
            #lost++;
        }
    }

    pub fn points() { return #won * 3 + #drawn; }
    pub fn difference() { return #scored - #conceded; }

    pub fn to_string() {
        $difference = #difference() > 0 ? "+" .. #difference() : #difference();
        return pad_right(#team, 22) .. pad_left(#team.rating(), 6)
            .. join(map([#played, #won, #drawn, #lost, #scored, #conceded], $n -> pad_left($n, 4)), "")
            .. pad_left($difference, 5) .. pad_left(#points(), 5);
    }
}

pub kind League {
    #teams;
    #standings = {};
    /* The season's matchdays, drawn in advance, each a list of [home, away]; and the matches played
       so far, a list of matchdays each a list of Fixtures */
    #schedule = [];
    #played = [];

    // Every club plays every other club twice, home and away
    pub static fn matches_for($clubs) { return $clubs * ($clubs - 1); }

    fn _($teams) {
        #teams = $teams;
        foreach ($teams as $team) {
            #standings[$team.name] = Standing($team);
        }
    }

    // The matchdays of a double round-robin (the circle method) in an order drawn for the
    // season: everyone plays everyone at home and away, and every team plays once a matchday,
    // except that with an odd number of teams one of them rests each matchday
    fn fixtures() {
        $teams = random::shuffle(#teams);
        if (len($teams) % 2 == 1) {
            // Whoever is drawn against null rests
            $teams[] = null;
        }
        $count = len($teams);
        $first_half = [];
        for ($round = 0; $round < $count - 1; $round++) {
            $matchday = [];
            for ($i = 0; $i < intdiv($count, 2); $i++) {
                $pair = [$teams[$i], $teams[$count - 1 - $i]];
                if (in_array(null, $pair)) {
                    continue;
                }
                $matchday[] = ($round + $i) % 2 == 0 ? $pair : [$pair[1], $pair[0]];
            }
            $first_half[] = $matchday;
            // Keep the first team in place and turn the rest one step
            $teams = [$teams[0], $teams[$count - 1], ...slice($teams, 1, $count - 2)];
        }

        // The second half of the season is the same fixtures with home and away swapped
        return [...$first_half, ...map($first_half, $matchday -> map($matchday, $pair -> [$pair[1], $pair[0]]))];
    }

    /* Start a season: draw its fixtures, and forget everything played, the table included.
       play_matchday() draws one itself if this wasn't called, but a screen that shows the fixtures
       needs them first. */
    pub fn draw() {
        foreach (#teams as $team) {
            #standings[$team.name] = Standing($team);
        }
        #schedule = #fixtures();
        #played = [];
        return #;
    }

    pub fn matchdays() { return len(#schedule); }
    pub fn matchdays_played() { return len(#played); }
    pub fn matchdays_left() { return len(#schedule) - len(#played); }

    /* Every match of $team, matchday by matchday, as {"matchday", "home", "away", "match"}, "match"
       being the Fixture once it has been played and null before */
    pub fn fixtures_of($team) {
        $matches = [];
        foreach (#schedule as $day => $pairs) {
            foreach ($pairs as [$home, $away]) {
                if ($home != $team && $away != $team) {
                    continue;
                }
                $found = null;
                if ($day < len(#played)) {
                    foreach (#played[$day] as $match) {
                        if ($match.home == $home && $match.away == $away) {
                            $found = $match;
                        }
                    }
                }
                $matches[] = {"matchday" => $day + 1, "home" => $home, "away" => $away, "match" => $found};
            }
        }
        return $matches;
    }

    /* Start the next matchday and give its matches, none of them played yet: each is made, given
       to $kick_off($match) if there is one (which is when to attach a listener), and made ready.
       Play them a minute at a time with tick(), or with play(), and then end_matchday() with them. */
    pub fn begin_matchday($kick_off = null) {
        if (len(#schedule) == 0) {
            #draw();
        }
        if (#matchdays_left() == 0) {
            error("The season is over");
        }
        $matches = [];
        foreach (#schedule[len(#played)] as [$home, $away]) {
            $match = Fixture($home, $away);
            if ($kick_off != null) {
                $kick_off($match);
            }
            $matches[] = $match.start();
        }

        return $matches;
    }

    /* The matchday's matches are over: their results go in the table and the fixtures */
    pub fn end_matchday($matches) {
        foreach ($matches as $match) {
            if (!$match.finished()) {
                error("A match is still being played");
            }
        }
        foreach ($matches as $match) {
            [$home, $away] = [$match.home, $match.away];
            #standings[$home.name].record($match.home_goals, $match.away_goals);
            #standings[$away.name].record($match.away_goals, $match.home_goals);
            if ($match.away_goals == 0) {
                $home.goalkeeper().clean_sheets++;
            }
            if ($match.home_goals == 0) {
                $away.goalkeeper().clean_sheets++;
            }
        }
        #played[] = $matches;

        return $matches;
    }

    /* Play the next matchday through and give its matches; $kick_off($match), if given, is called
       as each starts, before it is played */
    pub fn play_matchday($kick_off = null) {
        $matches = #begin_matchday($kick_off);
        foreach ($matches as $match) {
            $match.play();
        }

        return #end_matchday($matches);
    }

    /* Play what is left of the season; $kick_off($match) is called as each match starts, and
       $after_matchday($number, $matches) after each matchday */
    pub fn play_season($kick_off, $after_matchday) {
        while (#matchdays_left() > 0 || len(#schedule) == 0) {
            $matches = #play_matchday($kick_off);
            $after_matchday(#matchdays_played(), $matches);
        }
    }

    // Points, then goal difference, then goals scored, the most first, then name: lists order
    // element by element, and swapping $a and $b in an element turns its order round
    pub fn table() {
        return sort(#standings, ($a, $b) -> [$b.points(), $b.difference(), $b.scored, $a.team.name]
            <=> [$a.points(), $a.difference(), $a.scored, $b.team.name]);
    }

    pub fn top_scorers($count) {
        $scorers = [];
        foreach (#teams as $team) {
            foreach (filter($team.players, $player -> $player.goals > 0) as $player) {
                $scorers[] = {"player" => $player, "team" => $team};
            }
        }
        return slice(sort($scorers, ($a, $b) -> $b["player"].goals <=> $a["player"].goals), 0, $count);
    }

    pub fn top_keepers($count) {
        $keepers = [];
        foreach (#teams as $team) {
            foreach (filter($team.players, $player -> is_a($player, Goalkeeper) && $player.clean_sheets > 0) as $player) {
                $keepers[] = {"player" => $player, "team" => $team};
            }
        }
        return slice(sort($keepers, ($a, $b) -> $b["player"].clean_sheets <=> $a["player"].clean_sheets), 0, $count);
    }
}

// Commentary on the first few matches of the season
pub kind Commentator {
    #remaining;
    fn _($matches) { #remaining = $matches; }

    pub fn kick_off($match) {
        if (#remaining == 0) {
            return;
        }
        #remaining--;
        echo "";
        foreach ([$match.home, $match.away] as $team) {
            echo "{$team} ({$team.formation}, rated {$team.rating()}): " .. join(map($team.players, $player -> $player.profile()), ", ");
        }
        echo "";
        // A bound method as the listener: it remembers which commentator it belongs to
        $match.on_event(#report);
    }

    fn report($event) { echo $event; }
}
