/*
 * The state of a game: the clubs, their league, which club the manager has, and the inbox that
 * tells them what happened. Nothing here draws or reads a key: the interface (ui.gaz) asks it
 * questions and tells it to move time on, so all of it can be tested without a terminal.
 */
namespace game;

include "engine/teams.gaz" use Team, Scout, InvalidLineup, TransferRefused;
include "engine/league.gaz" use League;
include "engine/cup.gaz" use Cup;
include "engine/money.gaz";
include "engine/players.gaz" use Goalkeeper, Defender, Midfielder, Forward;
include "engine/calendar.gaz";
include "std/date.gaz";
include "std/random.gaz";
include "std/json.gaz";

/* The first TOP_SIZE are the top division and the next SECOND_SIZE the second */
const CLUBS = [
    "Riverside FC", "Northgate United", "Harbour Town", "Millbrook Athletic", "Kingsway Rovers",
    "Oakfield City", "Stonebridge", "Westmoor Wanderers", "Ashford Albion", "Lakeside Rangers",
    "Fernhill Town", "Marsh Lane FC", "Copperfield", "Thornbury Rovers", "Eastbrook United",
    "Priory Athletic", "Redcliffe", "Sandgate Wanderers", "Hollins Park", "Cranmere City",
    "Bramley Town", "Cliffe Rovers", "Dunmore United", "Elmstead", "Foxhall Athletic",
    "Greystone City", "Hartwell Rangers", "Ironbridge", "Jarrow Albion", "Kelthorne",
    "Lowick Wanderers", "Mossley Park", "Nettlebed FC", "Oldcastle United", "Pennybridge",
    "Queensmead", "Ravenscar Town", "Silverdale", "Tannerton Athletic", "Upminster Rovers",
    "Valebrook", "Wexcombe City", "Yarmouth Albion", "Ashgrove", "Blackwater Town",
    "Crowmarsh", "Denholme United", "Eastleigh Park", "Fallowfield", "Garstone Rovers",
    "Hexham Wanderers", "Ilkley Athletic", "Kingsmoor", "Larkfield Town",
];
const TOP_SIZE = 20;
const SECOND_SIZE = 24;
const DIVISIONS = ["Premier Division", "Championship"];
/* How many go up and down between the divisions each summer */
const MOVING = 2;
const FIRST_YEAR = 2026;
/* The formations the clubs prefer, in turn: the first for the club the manager starts with */
const FORMATIONS = ["4-4-2", "4-3-3", "3-5-2", "4-5-1", "5-3-2"];

/* 1st, 2nd, 3rd, 4th, 11th, 12th, 13th, 21st */
/* How many of $matches are still being played */
fn count_unfinished($matches) {
    return len(filter($matches, $match -> !$match.finished()));
}

/* The players whose contracts end on or before $day */
fn expiring_players($players, $day) {
    return filter($players, $player -> $player.contract_until <= $day);
}

pub fn ordinal($n) {
    $teens = $n % 100 >= 11 && $n % 100 <= 13;
    $suffix = $teens ? "th" : match ($n % 10) {
        1 => "st",
        2 => "nd",
        3 => "rd",
        default => "th",
    };
    return $n .. $suffix;
}

/*
 * A matchday being played: every match of it, the club's own among them, ticking together a minute
 * at a time, and the commentary on the club's match as it happens. Made by Game.begin_matchday().
 */
/*
 * How an AI club sets up against an opponent, from how the two elevens compare (the difference of
 * their ratings): the stronger side attacks, and the weaker sits back. An index into Team's
 * MENTALITIES, 0 (defensive) to 4 (attacking).
 */
pub fn ai_mentality($difference) {
    return match {
        $difference >= 10 => 4,
        $difference >= 5 => 3,
        $difference <= -10 => 0,
        $difference <= -5 => 1,
        default => 2,
    };
}

pub kind MatchDay {
    pub #matches = [];
    /* The club's match, or null on a matchday the club sits out */
    pub #mine = null;
    /* Everything that has happened in the club's match, oldest first */
    pub #commentary = [];
    /* The other division's matches, played alongside but not watched */
    #also = [];
    /* The cup, on a day of its rounds: its ties are the matches, and a level one goes on to extra time
       and penalties when all are over at ninety minutes */
    #cup = null;
    #settled = false;

    fn _(#club);

    pub fn play_cup($cup) { #cup = $cup; }
    pub fn is_cup() { return #cup != null; }

    pub fn unwatched() { return #also; }

    pub fn attach_other($match) {
        #also[] = $match;
    }

    /* The league gives each match to this as it is made, which is when to listen to it */
    pub fn attach($match) {
        #matches[] = $match;
        if ($match.home == #club || $match.away == #club) {
            #mine = $match;
            $match.on_event(#hear);
        }
    }

    fn hear($event) {
        #commentary[] = $event;
    }

    /* The minutes played, which every match has in common */
    pub fn clock() {
        $all = [...#matches, ...#also];

        return $all == [] ? 0 : $all[0].elapsed;
    }

    pub fn finished() {
        foreach ([...#matches, ...#also] as $match) {
            if (!$match.finished()) {
                return false;
            }
        }

        return #cup == null || #settled;
    }

    /* Play a minute of every match that isn't over */
    pub fn tick() {
        foreach ([...#matches, ...#also] as $match) {
            if (!$match.finished()) {
                $match.tick();
            }
        }
        // The ties that are level go on, all at once, when every match has had its ninety minutes
        if (#cup != null && !#settled && count_unfinished(#matches) == 0) {
            #cup.settle(#matches);
            #settled = true;
        }
    }
}

pub kind Game {
    /* The matchday being played, or null between them */
    pub #live = null;
    /* Who was out when the matchday began, by name, so what changed during it can be told */
    #out_before = {};
    /* The club's division: its clubs and their season. The other division is beside it, and #level says
       which the club's is: 0 the top, 1 the second. */
    pub #league;
    pub #other_league;
    /* The cup: every club in the game, a round on a Wednesday every few weeks and the final in May */
    pub #cup;
    pub #inbox = [];
    pub #season = FIRST_YEAR;
    /* Today, as a day number (lib/date.gaz): time moves a day at a time, and the game stops when
       something needs the manager (a match of the club's, the season's review, a transfer window) */
    pub #date = 0;
    /* The club's money in and out, newest last: {"matchday", "text", "amount"} */
    pub #ledger = [];

    fn _(pub #teams, pub #club, #scout, pub #other_teams, pub #level) {
        #date = calendar::season_start(#season);
        #new_leagues();
        #tell("Welcome to {#club}", "The board have appointed you manager of {#club}, in the " .. #division_name() .. ". There are "
            .. len(#teams) .. " clubs in the division and " .. #league.matchdays() .. " matchdays to play. "
            .. #expectation());
    }

    /* A season's fixtures for both divisions, on the calendar of the season that is starting */
    fn new_leagues() {
        #league = League(#teams).draw();
        #league.assign_dates(calendar::matchdays(#season, #league.matchdays()));
        #other_league = League(#other_teams).draw();
        #other_league.assign_dates(calendar::matchdays(#season, #other_league.matchdays()));
        // Strongest first: the top division by rating, then the second, so the byes go to the top clubs
        $top = #level == 0 ? #teams : #other_teams;
        $second = #level == 0 ? #other_teams : #teams;
        $by_rating = ($a, $b) -> [$b.rating(), $a.name] <=> [$a.rating(), $b.name];
        #cup = Cup("The Cup", [...sort($top, $by_rating), ...sort($second, $by_rating)]);
        #cup.assign_dates(calendar::cup_dates(#season, #cup.rounds_total()));
    }

    /* The cup's round being played, as "The Cup: Third round", or null when the matchday on is not the cup's */
    pub fn cup_label() {
        return #live != null && #live.is_cup() ? "The Cup: " .. #cup.round_name() : null;
    }

    /* Today as it is said: Sat 8 Aug 2026 */
    pub fn date_label() { return date::format(#date); }

    /* Every club in both divisions */
    pub fn everyone() { return [...#teams, ...#other_teams]; }

    /* The club's division by name, or the other's */
    pub fn division_name() { return DIVISIONS[#level]; }
    pub fn other_division_name() { return DIVISIONS[1 - #level]; }

    /* A new game: ten clubs made up from $seed, and the manager at the club $club (an index into CLUBS) */
    pub static fn start($seed, $club = 0) {
        rand_seed($seed);
        $scout = Scout();
        $teams = [];
        foreach (CLUBS as $i => $name) {
            $team = $scout.team($name, $i < TOP_SIZE ? rand_int(52, 78) : rand_int(40, 62), FORMATIONS[$i % len(FORMATIONS)]);
            $team.balance = money::starting_balance($team);
            $teams[] = $team;
        }
        // Contracts run out between one and four summers on
        foreach ($teams as $team) {
            foreach ($team.players as $player) {
                $player.contract_until = calendar::contract_end(calendar::season_start(FIRST_YEAR), random::weighted([[1, 35], [2, 30], [3, 25], [4, 10]]));
            }
        }
        $level = $club < TOP_SIZE ? 0 : 1;
        $top = slice($teams, 0, TOP_SIZE);
        $second = slice($teams, TOP_SIZE, SECOND_SIZE);
        [$mine, $other] = $level == 0 ? [$top, $second] : [$second, $top];

        return Game($mine, $teams[$club], $scout, $other, $level);
    }

    /* What a save file keeps: everything the game is, as data */
    pub fn to_json() {
        return {
            "game" => "football", "version" => 4, "season" => #season, "date" => #date, "club" => #club.name, "level" => #level,
            "names" => #scout.names(),
            "teams" => map(#teams, $team -> $team.to_json()),
            "other_teams" => map(#other_teams, $team -> $team.to_json()),
            "league" => #league.to_json(),
            "cup" => #cup.to_json(),
            "other_league" => #other_league.to_json(),
            "inbox" => #inbox, "ledger" => #ledger,
        };
    }

    /* A game back from to_json() */
    pub static fn from_json($data) {
        $teams = map($data["teams"], teams::from_json);
        $club = filter($teams, $team -> $team.name == $data["club"])[0];
        $scout = Scout();
        $scout.take($data["names"]);
        $others = map($data["other_teams"], teams::from_json);
        $game = Game($teams, $club, $scout, $others, $data["level"]);
        $game.season = $data["season"];
        $game.date = $data["date"];
        $game.league = League::from_json($data["league"], $teams);
        $game.other_league = League::from_json($data["other_league"], $others);
        $game.cup = Cup::from_json($data["cup"], [...$teams, ...$others]);
        $game.inbox = $data["inbox"];
        $game.ledger = $data["ledger"];

        return $game;
    }

    /* Write the game to $path. Gives "" when it is done, and why not when it isn't. */
    pub fn save($path) {
        if (#live != null) {
            return "Finish the match before saving";
        }
        try {
            write_file($path, json::encode(#to_json()) .. "\n");
        } catch (Error $e) {
            return "Couldn't save to {$path}: {$e.message}";
        }

        return "";
    }

    /* The game saved at $path; a file that isn't one is an error saying so */
    pub static fn load($path) {
        if (!file_exists($path)) {
            error("No saved game at {$path}");
        }
        try {
            $data = json::decode(read_file($path));
            if (($data["game"] ?? null) != "football" || ($data["version"] ?? null) != 4) {
                error("{$path} is not a saved football game");
            }

            return Game::from_json($data);
        } catch (Error $e) {
            error("{$path} is not a saved game: {$e.message}");
        }
    }

    /* The summer, once the season is over: prize money by finishing position, everybody a year
       older with the veterans retiring for youngsters from the academy, the transfer window among
       the clubs, and a new season's fixtures. Gives "" when it is done, and why not when it isn't. */
    pub fn new_season() {
        if (!#season_over()) {
            return "The season isn't over";
        }
        // A cup with rounds still to play (its final is after the league) is finished off, unwatched
        $first_unplayed = len(#cup.rounds);
        $rest = #cup.finished() ? [] : #cup.play_out();
        foreach ($rest as $i => [$name, $ties]) {
            #settle_cup($ties, $first_unplayed + $i);
        }
        $cup_note = "The Cup was won by " .. #cup.champion .. (#cup.champion == #club ? ": you won it!" : ".");
        foreach ([[#league, #level], [#other_league, 1 - #level]] as [$league, $level]) {
            foreach ($league.table() as $place => $standing) {
                $prize = money::prize(1 + $level, $place, len($league.table()));
                $standing.team.balance += $prize;
                if ($standing.team == #club) {
                    #ledger[] = {"matchday" => #league.matchdays_played(), "text" => "Prize money, " .. ordinal($place + 1), "amount" => $prize};
                }
            }
        }
        // The bottom of the top division and the top of the second change places
        $top_league = #level == 0 ? #league : #other_league;
        $second_league = #level == 0 ? #other_league : #league;
        $down = map(slice(reverse($top_league.table()), 0, MOVING), $standing -> $standing.team);
        $up = map(slice($second_league.table(), 0, MOVING), $standing -> $standing.team);
        $top = #level == 0 ? #teams : #other_teams;
        $second = #level == 0 ? #other_teams : #teams;
        $top = [...filter($top, $team -> !in_array($team, $down)), ...$up];
        $second = [...filter($second, $team -> !in_array($team, $up)), ...$down];
        $verdict = "";
        if (in_array(#club, $up)) {
            #level = 0;
            $verdict = "You are promoted to the " .. DIVISIONS[0] .. "!";
        } else if (in_array(#club, $down)) {
            #level = 1;
            $verdict = "You are relegated to the " .. DIVISIONS[1] .. ".";
        }
        [#teams, #other_teams] = #level == 0 ? [$top, $second] : [$second, $top];
        $retired = [];
        $academy = [];
        foreach (#everyone() as $team) {
            foreach ($team.players as $player) {
                $player.new_season();
                $player.develop();
                if ($player.retires()) {
                    $youth = #scout.youth(kind_of($player), $team, $player.number);
                    $youth.contract_until = calendar::contract_end(#date, 3);
                    $team.replace($player, $youth);
                    if ($team == #club) {
                        $retired[] = $player;
                        $academy[] = $youth;
                    }
                }
            }
        }
        #season++;
        #new_leagues();
        $body = $cup_note .. "\n\nA new season begins in the " .. #division_name() .. ". " .. ($verdict != "" ? $verdict .. " " : "") .. #expectation();
        if ($retired != []) {
            $body ..= "\n\nRetired: " .. join($retired, ", ") .. ". From the academy: " .. join(map($academy, $p -> "{$p} ({$p.position()}, {$p.rating})"), ", ") .. ".";
        }
        $warning = #contract_warning();
        if ($warning != "") {
            $body ..= "\n\n" .. $warning;
        }
        $body ..= "\n\nThe transfer window opens on 1 July, and the first matches are on " .. date::format(min(#league.next_date(), #other_league.next_date())) .. ".";
        #tell(#season_label() .. " begins", $body);

        return "";
    }

    /* What the finishing position means for next season, as a sentence */
    fn season_outcome() {
        $place = #position();
        if (#level == 1 && $place <= MOVING) {
            return "You are promoted!";
        }
        if (#level == 0 && $place > len(#teams) - MOVING) {
            return "You are relegated.";
        }

        return "";
    }

    /* What the board hopes for, by how the club's squad rates among the others */
    fn expectation() {
        $stronger = len(filter(#teams, $team -> $team.rating() > #club.rating()));
        if ($stronger < 2) {
            return "The board expect a challenge for the title.";
        }
        if ($stronger < len(#teams) / 2) {
            return "The board expect a place in the top half.";
        }
        return "The board expect you to steer clear of the bottom places.";
    }

    pub fn season_label() {
        return #season .. "/" .. slice(to_string(#season + 1), 2);
    }

    /* Both divisions have played every matchday: the second division's season is longer */
    pub fn season_over() { return #league.matchdays_left() == 0 && #other_league.matchdays_left() == 0; }

    /* The club's own division has played every matchday, though the other may still have some */
    pub fn club_done() { return #league.matchdays_left() == 0; }

    /* The season the club is in: the league it plays in */
    fn league_of($team) { return in_array($team, #teams) ? #league : #other_league; }

    /* The club's place in the table, from 1 */
    pub fn position() {
        foreach (#league.table() as $place => $standing) {
            if ($standing.team == #club) {
                return $place + 1;
            }
        }
    }

    /* The club's place as it is said: 1st, 2nd */
    pub fn place() { return ordinal(#position()); }

    fn tell($subject, $body) {
        #inbox[] = {"matchday" => #league.matchdays_played(), "date" => #date, "subject" => $subject, "body" => $body};
    }

    /* Move on, a day at a time, to the next date either division plays, and begin that matchday, to be
       played a minute at a time with live.tick(): every match is made and ready, and the commentary
       on the club's own is collected. end_matchday() when it is finished(). Gives the MatchDay.
       Events on the way happen and are told in the inbox (a season's review after its last match, a
       transfer window). Days the club's division doesn't play are passed over, the other's matches
       played out unwatched, until its season is over, and then they are the matchdays. With $stopping
       (which play_on() gives) an event stops the clock instead, giving null. */
    pub fn begin_matchday($stopping = false) {
        if (#live != null) {
            error("A matchday is already being played");
        }
        while (true) {
            $next = #next_fixture_date();
            if ($next == null || $next > #date) {
                // Nothing to play today: on to tomorrow, which may have its own business
                $notable = #step_day();
                if ($stopping && $notable) {
                    return null;
                }
                continue;
            }
            $day = #open_matchday();
            if ($day.is_cup()) {
                // The club's cup tie is for the manager to see; a day of the cup they are not in is passed
                if ($stopping && $day.mine != null) {
                    return #live;
                }
                while (!$day.finished()) {
                    $day.tick();
                }
                #end_matchday();
                continue;
            }
            // The club's match; or, once its division's season is over and not stopping, the other's
            if ($day.mine != null || (!$stopping && #league.matchdays_left() == 0)) {
                return #live;
            }
            // Not the club's division's day: the other plays it out, unwatched, and time goes on
            while (!$day.finished()) {
                $day.tick();
            }
            #end_matchday();
        }
    }

    /* A day of the cup is over: the winners go through, and the inbox says who, the club's tie first. Gives
       nothing, as no league match was played. */
    fn end_cup_day() {
        $round = #cup.round_name();
        $index = len(#cup.rounds);
        $ties = #cup.end_round(#live.matches);
        #live = null;
        #settle_cup($ties, $index);
        $available = filter(#club.players, $player -> $player.available());
        foreach ($ties as $tie) {
            if ($tie.match.home == #club || $tie.match.away == #club) {
                #report_cup($tie, $round);
            }
        }
        #tell("The Cup: " .. lower($round), join(map($ties, $tie -> to_string($tie)), "\n"));
        #report_availability($available);

        return [];
    }

    /* The manager's own cup tie, told: through, or out, or the Cup won */
    fn report_cup($tie, $round) {
        $match = $tie.match;
        $won = $tie.winner() == #club;
        $opponent = $match.home == #club ? $match.away : $match.home;
        $text = "{$tie}.";
        if ($won && #cup.finished()) {
            #tell("You have won the Cup!", "{$text} You beat {$opponent} in the final, and the club is paid " .. money::pounds(money::cup_prize(len(#cup.rounds) - 1)) .. ".");
        } else if ($won) {
            #tell("Cup: through", "{$text} You beat {$opponent} and go into the " .. lower(#cup.round_name()) .. ", on " .. date::format(#cup.next_date()) .. ".");
        } else {
            #tell("Cup: knocked out", "{$text} {$opponent} go through and you are out of the Cup, in the " .. lower($round) .. ".");
        }
    }

    /* The cup's money: the home club's gate for each tie, and a prize for each winner, by the round. Every
       tie is a match with no television and no wages, since a matchday of the league paid them. */
    fn settle_cup($ties, $round) {
        foreach ($ties as $tie) {
            foreach ([[$tie.match.home, "Gate receipts, cup", money::gate($tie.match.home)], [$tie.winner(), "Cup prize money, " .. lower(#cup_round_name($round)), money::cup_prize($round)]] as [$team, $text, $amount]) {
                $team.balance += $amount;
                if ($team == #club) {
                    #ledger[] = {"matchday" => #league.matchdays_played(), "date" => #date, "text" => $text, "amount" => $amount};
                }
            }
        }
    }

    /* The name of round $index of this season's cup, for a ledger entry */
    fn cup_round_name($index) {
        return #cup.round_name_of($index);
    }

    /* Move time on to the next matchday the manager should see or an event that needs them, and play
       through what doesn't matter on the way: the other division's matchdays, birthdays and the rest.
       Gives the MatchDay of the club's own next match, ready to be played a minute at a time, or null
       when something else stopped the clock (the inbox says what); with $watch false the match is
       played out at once and gives null too. */
    pub fn play_on($watch = true) {
        $day = #begin_matchday(true);
        if ($day == null || $watch) {
            return $day;
        }
        while (!$day.finished()) {
            $day.tick();
        }
        #end_matchday();

        return null;
    }

    /* The date of the next matchday of either division, or null when both seasons are over */
    pub fn next_fixture_date() {
        $dates = filter([#league.next_date(), #other_league.next_date(), #cup.next_date()], $date -> $date != null);

        return $dates == [] ? null : min($dates);
    }

    /* Begin every matchday that is due today: the club's division's if it has one, and the other's */
    fn open_matchday() {
        $due = filter([#league, #other_league], $league -> $league.next_date() != null && $league.next_date() <= #date);
        $cup_day = #cup.next_date() != null && #cup.next_date() <= #date;
        // The clubs playing pick their best eleven from who is fit; the manager's stays as it was set,
        // except that anyone who is out is replaced, which the inbox says
        $pairs = reduce($due, ($all, $league) -> [...$all, ...$league.next_pairs()], $cup_day ? #cup.next_pairs() : []);
        foreach ($pairs as [$home, $away]) {
            foreach ([[$home, $away], [$away, $home]] as [$team, $opponent]) {
                if ($team != #club) {
                    $team.auto_eleven();
                }
            }
        }
        // ... and set up against whom they play, once the elevens are known
        foreach ($pairs as [$home, $away]) {
            foreach ([[$home, $away], [$away, $home]] as [$team, $opponent]) {
                if ($team != #club) {
                    $team.set_mentality(ai_mentality($team.rating() - $opponent.rating()));
                }
            }
        }
        $picked = #club.eleven();
        // Live only once the league has begun it, so a matchday that couldn't begin isn't left half made
        $day = MatchDay(#club);
        if ($cup_day) {
            $day.play_cup(#cup);
            #cup.begin_round($day.attach);
        }
        if (in_array(#league, $due)) {
            #league.begin_matchday($day.attach);
        }
        if (in_array(#other_league, $due)) {
            #other_league.begin_matchday($day.attach_other);
        }
        foreach (#club.eleven() as $i => $player) {
            if ($player != $picked[$i]) {
                #tell("Lineup: {$player} starts", "{$picked[$i]} is out (" .. lower($picked[$i].status()) .. "), so {$player} starts in his place.");
            }
        }
        #out_before = {};
        foreach (filter(#club.players, $player -> !$player.available()) as $player) {
            #out_before[to_string($player)] = true;
        }
        #live = $day;

        return $day;
    }

    /* A day goes by: everybody's birthdays, and what the date brings: the season's review after its
       last match, the transfer windows opening and shutting. Gives whether anything happened that the
       manager should hear of. */
    fn step_day() {
        #date++;
        $notable = false;
        $birthday = date::month(#date) * 100 + date::day(#date);
        if ($birthday == 630 && #contracts_expire()) {
            $notable = true;
        }
        foreach (#everyone() as $team) {
            foreach ($team.players as $player) {
                if ($player.birthday == $birthday) {
                    $player.celebrate();
                }
                if ($player.recover() && $team == #club) {
                    #tell("Back: {$player}", "{$player} has recovered from his injury and is available again.");
                }
            }
        }
        if (#season_over() && #date >= calendar::review_day(#season)) {
            #new_season();
            $notable = true;
        }
        if ($birthday == 701) {
            #open_window("summer", "the end of August");
            $notable = true;
        } else if ($birthday == 831) {
            #tell("The transfer window has closed", "The summer window is shut until 1 January.");
            $notable = true;
        } else if ($birthday == 101) {
            $warning = #contract_warning();
            if ($warning != "") {
                #tell("Contracts", $warning);
            }
            #open_window("January", "the end of the month");
            $notable = true;
        } else if ($birthday == 131) {
            #tell("The transfer window has closed", "The January window is shut until 1 July.");
            $notable = true;
        }

        return $notable;
    }

    /* Which of the club's players are out of contract on the coming 30 June, as a sentence, or "" */
    fn contract_warning() {
        $ending = expiring_players(#club.players, calendar::expiry_day(date::month(#date) >= 7 ? date::year(#date) + 1 : date::year(#date)));
        if ($ending == []) {
            return "";
        }

        return len($ending) .. (len($ending) == 1 ? " contract runs" : " contracts run") .. " out on 30 June: " .. join($ending, ", ")
            .. ". A player whose contract runs out leaves; renew in the Squad (r).";
    }

    /* 30 June: the contracts that have run out. The other clubs renew theirs; the manager's players
       leave unless renewed, and the academy fills the squad, told in the inbox. */
    fn contracts_expire() {
        $leavers = [];
        foreach (#everyone() as $team) {
            foreach ($team.players as $player) {
                if ($player.contract_until > #date) {
                    continue;
                }
                if ($team == #club) {
                    $leavers[] = $player;
                } else {
                    $player.contract_until = calendar::expiry_day(date::year(#date) + random::weighted([[1, 35], [2, 30], [3, 25], [4, 10]]));
                }
            }
        }
        if ($leavers == []) {
            return false;
        }
        foreach ($leavers as $player) {
            #club.leave($player);
        }
        $signed = [];
        while (len(#club.players) < 17 || len(filter(#club.players, $p -> $p.position() == "GK")) < 2) {
            $kind = Goalkeeper;
            if (len(filter(#club.players, $p -> $p.position() == "GK")) >= 2) {
                // the position the squad is shortest of
                $shortest = Defender;
                $fewest = len(filter(#club.players, $p -> $p.position() == "DF"));
                foreach ([[Midfielder, "MF"], [Forward, "FW"]] as [$candidate, $position]) {
                    if (len(filter(#club.players, $p -> $p.position() == $position)) < $fewest) {
                        [$shortest, $fewest] = [$candidate, len(filter(#club.players, $p -> $p.position() == $position))];
                    }
                }
                $kind = $shortest;
            }
            $youth = #scout.youth($kind, #club, 1);
            $youth.contract_until = calendar::contract_end(#date, 3);
            #club.sign($youth);
            $signed[] = $youth;
        }
        #club.repair();
        #tell("Contracts have run out", join($leavers, ", ") .. (len($leavers) == 1 ? " has" : " have") .. " left: the contract ended on 30 June and was not renewed."
            .. ($signed == [] ? "" : " From the academy: " .. join(map($signed, $p -> "{$p} ({$p.position()}, {$p.rating})"), ", ") .. "."));

        return true;
    }

    /* What a club asks for a player, which is less once his contract is nearly over */
    pub fn asking_price($player) {
        return money::price_with_contract($player, $player.contract_until - #date);
    }

    /* A new contract for $player of the club's: as many years as his age deserves, for a signing-on fee.
       Gives "" when it is done, and why not when it isn't. */
    pub fn renew($player) {
        if (#live != null) {
            return "No contracts during a match";
        }
        if (!in_array($player, #club.players)) {
            return "{$player} isn't at {#club}";
        }
        if ($player.contract_until - #date > 730) {
            return "{$player} is on a contract until " .. date::format($player.contract_until) .. ": renew it in the last two years";
        }
        $years = $player.age <= 27 ? 4 : ($player.age <= 31 ? 2 : 1);
        $fee = money::renewal_fee($player);
        if ($fee > #club.balance) {
            return "You can't afford " .. money::pounds($fee) .. " to renew {$player}";
        }
        $player.contract_until = calendar::expiry_day(date::year(max($player.contract_until, #date)) + $years);
        #club.balance -= $fee;
        #ledger[] = {"matchday" => #league.matchdays_played(), "date" => #date, "text" => "Renewed {$player}", "amount" => -$fee};
        #tell("Renewed: {$player}", "{$player} signs a new contract until " .. date::format($player.contract_until) .. " for a fee of " .. money::pounds($fee) .. ".");

        return "";
    }

    /* A transfer window opens: the clubs do their business, which the manager hears of if it was theirs */
    fn open_window($name, $until) {
        $deals = money::window(#everyone());
        $body = "The {$name} transfer window is open until {$until}: buy and sell in Transfers.";
        foreach (filter($deals, $deal -> $deal["to"] == #club || $deal["from"] == #club) as $deal) {
            $signing = $deal["to"] == #club;
            $body ..= "\n\n{$deal["player"]} moved from {$deal["from"]} to {$deal["to"]} for " .. money::pounds($deal["fee"]) .. ".";
            #ledger[] = {"matchday" => #league.matchdays_played(), "text" => ($signing ? "Signed " : "Sold ") .. $deal["player"], "amount" => $signing ? -$deal["fee"] : $deal["fee"]};
        }
        #tell("The transfer window is open", $body);
    }

    /* The matchday is over: the table and the fixtures have its results, and the inbox says what
       happened. Gives the matches played. */
    pub fn end_matchday() {
        if (#live == null) {
            error("No matchday is being played");
        }
        if (#live.is_cup()) {
            return #end_cup_day();
        }
        $matches = #live.matches == [] ? [] : #league.end_matchday(#live.matches);
        $others = #live.unwatched() == [] ? [] : #other_league.end_matchday(#live.unwatched());
        #live = null;
        #settle([...$matches, ...$others]);
        $available = filter(#club.players, $player -> $player.available());
        if ($others != []) {
            #tell(#other_division_name() .. ", matchday " .. #other_league.matchdays_played(), join(map($others, $match -> "{$match}"), "\n"));
        }
        foreach ($matches as $match) {
            if ($match.home == #club || $match.away == #club) {
                #report($match);
            }
        }
        if ($matches != []) {
            #tell("Matchday " .. #league.matchdays_played() .. " results", join(map($matches, $match -> "{$match}"), "\n"));
        }
        #report_availability($available);
        if ($matches != [] && #league.matchdays_left() == 0) {
            $champions = #league.table()[0].team;
            #tell("The season is over", "{$champions} are the champions. You finished " .. ordinal(#position()) .. " in the " .. #division_name() .. ". "
                .. #season_outcome() .. (#season_over() ? "" : " The " .. #other_division_name() .. " has " .. #other_league.matchdays_left() .. (#other_league.matchdays_left() == 1 ? " matchday" : " matchdays") .. " to go: c plays them."));
        }
        return $matches;
    }

    /* Move time on to the next matchday without watching it: everyone plays, and the inbox says
       what happened. Gives the matches played. */
    pub fn advance() {
        $day = #begin_matchday();
        while (!$day.finished()) {
            $day.tick();
        }

        return #end_matchday();
    }

    /* The books for a matchday: every club is paid by television and pays its wages, and the home
       side takes the gate. The manager's club has each entry in its ledger. */
    fn settle($matches) {
        $home = {};
        foreach ($matches as $match) {
            $home[$match.home.name] = $match.home;
        }
        foreach ($matches as $match) {
            foreach ([$match.home, $match.away] as $team) {
                $league = #league_of($team);
                $entries = [["Television", money::TELEVISION], ["Wages", -money::matchday_wages($team, $league.matchdays())]];
                if (has_key($home, $team.name)) {
                    $entries[] = ["Gate receipts", money::gate($team)];
                }
                foreach ($entries as [$text, $amount]) {
                    $team.balance += $amount;
                    if ($team == #club) {
                        #ledger[] = {"matchday" => $league.matchdays_played(), "text" => $text, "amount" => $amount};
                    }
                }
            }
        }
    }

    /* Everyone at the other clubs, richest talent first, as [player, club] pairs */
    pub fn market() {
        $offers = [];
        foreach (filter(#everyone(), $team -> $team != #club) as $team) {
            foreach ($team.players as $player) {
                $offers[] = [$player, $team];
            }
        }

        return sort($offers, ($a, $b) -> [$b[0].rating, $a[0].number] <=> [$a[0].rating, $b[0].number]);
    }

    /* Buy $player from his club at its price. Gives "" when it is done, and why not when it isn't. */
    pub fn buy($player) {
        if (#live != null) {
            return "No transfers during a match";
        }
        if (!calendar::window_open(#date)) {
            return "The transfer window is closed until " .. calendar::window_opens(#date);
        }
        $owner = null;
        foreach (#everyone() as $team) {
            if (in_array($player, $team.players)) {
                $owner = $team;
            }
        }
        if ($owner == null || $owner == #club) {
            return "{$player} isn't at another club";
        }
        $fee = #asking_price($player);
        if ($fee > #club.balance) {
            return "You can't afford " .. money::pounds($fee) .. " for {$player}";
        }
        if (len(#club.players) >= Team::MAX_SQUAD) {
            return "{#club} already have " .. Team::MAX_SQUAD .. " players";
        }
        try {
            $owner.release($player);
        } catch (TransferRefused $e) {
            return $e.message;
        }
        #club.sign($player);
        $player.contract_until = calendar::contract_end(#date, 3);
        #club.balance -= $fee;
        $owner.balance += $fee;
        #ledger[] = {"matchday" => #league.matchdays_played(), "text" => "Signed {$player}", "amount" => -$fee};
        #tell("Signed: {$player}", "{$player} ({$player.position()}, {$player.rating}) joins from {$owner} for " .. money::pounds($fee) .. ".");

        return "";
    }

    /* Sell $player, to the richest club that can take him at the price, or abroad if none can.
       Gives "" when it is done, and why not when it isn't. */
    pub fn sell($player) {
        if (#live != null) {
            return "No transfers during a match";
        }
        if (!calendar::window_open(#date)) {
            return "The transfer window is closed until " .. calendar::window_opens(#date);
        }
        if (!in_array($player, #club.players)) {
            return "{$player} isn't at {#club}";
        }
        $fee = money::sale_price($player);
        try {
            #club.release($player);
        } catch (TransferRefused $e) {
            return $e.message;
        }
        $buyers = sort(filter(#everyone(), $team -> $team != #club && $team.balance >= $fee && len($team.players) < Team::MAX_SQUAD), ($a, $b) -> [$b.balance, $a.name] <=> [$a.balance, $b.name]);
        $to = "abroad";
        if ($buyers != []) {
            $buyers[0].sign($player);
            $buyers[0].balance -= $fee;
            $to = to_string($buyers[0]);
        }
        #club.balance += $fee;
        #ledger[] = {"matchday" => #league.matchdays_played(), "text" => "Sold {$player}", "amount" => $fee};
        #tell("Sold: {$player}", "{$player} leaves for {$to} for " .. money::pounds($fee) .. ".");

        return "";
    }

    /* What the match did to the club's players: who is hurt or banned now, and who has served it */
    fn report_availability($available) {
        foreach (#club.players as $player) {
            $name = to_string($player);
            if ($player.hurt && $player.injured > 0) {
                #tell("Injury: {$name}", "{$name} was injured and will be out for " .. players::days_text($player.injured) .. ".");
            } else if (!$player.available() && !has_key(#out_before, $name)) {
                #tell("Suspended: {$name}", "{$name} is suspended for the next " .. $player.suspended .. ($player.suspended == 1 ? " match." : " matches."));
            } else if ($player.available() && has_key(#out_before, $name)) {
                #tell("Back: {$name}", "{$name} has served his time out and is available again.");
            }
        }
    }

    /* The manager's change to the eleven: two players of the club, one in the eleven and one on
       the bench, swap places. Gives "" when it is done, and why not when it isn't. */
    pub fn swap($a, $b) {
        if (#live != null) {
            return "The lineup can't change during a match";
        }
        $starting = in_array($a, #club.eleven()) ? [$a, $b] : [$b, $a];
        if (!in_array($starting[0], #club.eleven()) || in_array($starting[1], #club.eleven())) {
            return "Swap a player in the eleven with one on the bench";
        }
        try {
            #club.swap($starting[0], $starting[1]);
        } catch (InvalidLineup $e) {
            return $e.message;
        }

        return "";
    }

    /* The best eleven who can play, in the formation the club prefers (or another). Gives "" when it
       is done, and why not when it isn't. */
    pub fn auto_lineup($formation = null) {
        if (#live != null) {
            return "The lineup can't change during a match";
        }
        #club.auto_eleven($formation);

        return "";
    }

    /* The formations the clubs play, for a choice of them */
    pub fn formations() { return FORMATIONS; }

    /* How the club plays: an index into the mentalities and the intensities, changed at any time,
       in a match too */
    pub fn set_mentality($level) { #club.set_mentality($level); }
    pub fn set_intensity($level) { #club.set_intensity($level); }

    /* A substitution in the match being played: $off leaves the pitch and $on comes on. Gives "" when
       it is done, and why not when it isn't. */
    pub fn substitute($off, $on) {
        if (#live == null || #live.mine == null) {
            return "There is no match to make a substitution in";
        }
        try {
            #live.mine.substitute(#club, $off, $on);
        } catch (InvalidLineup $e) {
            return $e.message;
        }

        return "";
    }

    /* The message about the club's own match */
    fn report($match) {
        $home = $match.home == #club;
        [$scored, $conceded] = $home ? [$match.home_goals, $match.away_goals] : [$match.away_goals, $match.home_goals];
        $opponent = $home ? $match.away : $match.home;
        $what = $scored > $conceded ? "Win" : ($scored == $conceded ? "Draw" : "Defeat");
        $points = #league.table()[#position() - 1].points();
        #tell("{$what}: {$match}", "You " .. ($scored > $conceded ? "beat" : ($scored == $conceded ? "drew with" : "lost to"))
            .. " {$opponent} " .. ($home ? "at home" : "away") .. " {$scored}-{$conceded}. You are "
            .. ordinal(#position()) .. " on {$points} points.");
    }
}
