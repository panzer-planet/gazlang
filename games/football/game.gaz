/*
 * The state of a game: the clubs, their league, which club the manager has, and the inbox that
 * tells them what happened. Nothing here draws or reads a key: the interface (ui.gaz) asks it
 * questions and tells it to move time on, so all of it can be tested without a terminal.
 */
namespace game;

include "engine/teams.gaz" use Team, Scout, InvalidLineup, TransferRefused;
include "engine/league.gaz" use League;
include "engine/money.gaz";
include "../../lib/json.gaz";

const CLUBS = [
    "Riverside FC", "Northgate United", "Harbour Town", "Millbrook Athletic", "Kingsway Rovers",
    "Oakfield City", "Stonebridge", "Westmoor Wanderers", "Ashford Albion", "Lakeside Rangers",
];
const FIRST_YEAR = 2026;
/* The formations the clubs prefer, in turn: the first for the club the manager starts with */
const FORMATIONS = ["4-4-2", "4-3-3", "3-5-2", "4-5-1", "5-3-2"];

/* 1st, 2nd, 3rd, 4th, 11th, 12th, 13th, 21st */
pub fn ordinal($n) {
    $teens = $n % 100 >= 11 && $n % 100 <= 13;
    $suffix = $teens ? "th" : match ($n % 10) {
        1 => "st",
        2 => "nd",
        3 => "rd",
        default => "th",
    };
    return $n .. $suffix;
}

/*
 * A matchday being played: every match of it, the club's own among them, ticking together a minute
 * at a time, and the commentary on the club's match as it happens. Made by Game.begin_matchday().
 */
/*
 * How an AI club sets up against an opponent, from how the two elevens compare (the difference of
 * their ratings): the stronger side attacks, and the weaker sits back. An index into Team's
 * MENTALITIES, 0 (defensive) to 4 (attacking).
 */
pub fn ai_mentality($difference) {
    return match {
        $difference >= 10 => 4,
        $difference >= 5 => 3,
        $difference <= -10 => 0,
        $difference <= -5 => 1,
        default => 2,
    };
}

pub kind MatchDay {
    pub #matches = [];
    /* The club's match, or null on a matchday the club sits out */
    pub #mine = null;
    /* Everything that has happened in the club's match, oldest first */
    pub #commentary = [];

    fn _(#club);

    /* The league gives each match to this as it is made, which is when to listen to it */
    pub fn attach($match) {
        #matches[] = $match;
        if ($match.home == #club || $match.away == #club) {
            #mine = $match;
            $match.on_event(#hear);
        }
    }

    fn hear($event) {
        #commentary[] = $event;
    }

    /* The minutes played, which every match has in common */
    pub fn clock() {
        return len(#matches) == 0 ? 0 : #matches[0].elapsed;
    }

    pub fn finished() {
        foreach (#matches as $match) {
            if (!$match.finished()) {
                return false;
            }
        }

        return true;
    }

    /* Play a minute of every match that isn't over */
    pub fn tick() {
        foreach (#matches as $match) {
            if (!$match.finished()) {
                $match.tick();
            }
        }
    }
}

pub kind Game {
    /* The matchday being played, or null between them */
    pub #live = null;
    /* Who was out when the matchday began, by name, so what changed during it can be told */
    #out_before = {};
    pub #league;
    pub #inbox = [];
    pub #season = FIRST_YEAR;
    /* The club's money in and out, newest last: {"matchday", "text", "amount"} */
    pub #ledger = [];

    fn _(pub #teams, pub #club, #scout) {
        #league = League(#teams).draw();
        #tell("Welcome to {#club}", "The board have appointed you manager of {#club}. There are "
            .. len(#teams) .. " clubs in the league and " .. #league.matchdays() .. " matchdays to play. "
            .. #expectation());
    }

    /* A new game: ten clubs made up from $seed, and the manager at the club $club (an index into CLUBS) */
    pub static fn start($seed, $club = 0) {
        rand_seed($seed);
        $scout = Scout();
        $teams = [];
        foreach (CLUBS as $i => $name) {
            $team = $scout.team($name, rand_int(52, 78), FORMATIONS[$i % len(FORMATIONS)]);
            $team.balance = money::starting_balance($team);
            $teams[] = $team;
        }
        return Game($teams, $teams[$club], $scout);
    }

    /* What a save file keeps: everything the game is, as data */
    pub fn to_data() {
        return {
            "game" => "football", "version" => 1, "season" => #season, "club" => #club.name,
            "names" => #scout.names(),
            "teams" => map(#teams, $team -> $team.to_data()),
            "league" => #league.to_data(),
            "inbox" => #inbox, "ledger" => #ledger,
        };
    }

    /* A game back from to_data() */
    pub static fn from_data($data) {
        $teams = map($data["teams"], teams::from_data);
        $club = filter($teams, $team -> $team.name == $data["club"])[0];
        $scout = Scout();
        $scout.take($data["names"]);
        $game = Game($teams, $club, $scout);
        $game.season = $data["season"];
        $game.league = League::from_data($data["league"], $teams);
        $game.inbox = $data["inbox"];
        $game.ledger = $data["ledger"];

        return $game;
    }

    /* Write the game to $path. Gives "" when it is done, and why not when it isn't. */
    pub fn save($path) {
        if (#live != null) {
            return "Finish the match before saving";
        }
        try {
            write_file($path, json::encode(#to_data()) .. "\n");
        } catch (Error $e) {
            return "Couldn't save to {$path}: {$e.message}";
        }

        return "";
    }

    /* The game saved at $path; a file that isn't one is an error saying so */
    pub static fn load($path) {
        if (!file_exists($path)) {
            error("No saved game at {$path}");
        }
        try {
            $data = json::decode(read_file($path));
            if (($data["game"] ?? null) != "football" || ($data["version"] ?? null) != 1) {
                error("{$path} is not a saved football game");
            }

            return Game::from_data($data);
        } catch (Error $e) {
            error("{$path} is not a saved game: {$e.message}");
        }
    }

    /* The summer, once the season is over: prize money by finishing position, everybody a year
       older with the veterans retiring for youngsters from the academy, the transfer window among
       the clubs, and a new season's fixtures. Gives "" when it is done, and why not when it isn't. */
    pub fn new_season() {
        if (!#season_over()) {
            return "The season isn't over";
        }
        $clubs = len(#teams);
        foreach (#league.table() as $place => $standing) {
            $prize = money::prize(2, $place, $clubs);
            $standing.team.balance += $prize;
            if ($standing.team == #club) {
                #ledger[] = {"matchday" => #league.matchdays_played(), "text" => "Prize money, " .. ordinal($place + 1), "amount" => $prize};
            }
        }
        $retired = [];
        $academy = [];
        foreach (#teams as $team) {
            foreach ($team.players as $player) {
                $player.new_season();
                $player.grow_older();
                if ($player.retires()) {
                    $youth = #scout.youth(kind_of($player), $team, $player.number);
                    $team.replace($player, $youth);
                    if ($team == #club) {
                        $retired[] = $player;
                        $academy[] = $youth;
                    }
                }
            }
        }
        $deals = money::window(#teams);
        #season++;
        #league = League(#teams).draw();
        $body = "A new season begins. " .. #expectation();
        if ($retired != []) {
            $body ..= "\n\nRetired: " .. join($retired, ", ") .. ". From the academy: " .. join(map($academy, $p -> "{$p} ({$p.position()}, {$p.rating})"), ", ") .. ".";
        }
        foreach (filter($deals, $deal -> $deal["to"] == #club || $deal["from"] == #club) as $deal) {
            $body ..= "\n\n{$deal["player"]} moved from {$deal["from"]} to {$deal["to"]} for " .. money::pounds($deal["fee"]) .. ".";
        }
        #tell(#season_label() .. " begins", $body);

        return "";
    }

    /* What the board hopes for, by how the club's squad rates among the others */
    fn expectation() {
        $stronger = len(filter(#teams, $team -> $team.rating() > #club.rating()));
        if ($stronger < 2) {
            return "The board expect a challenge for the title.";
        }
        if ($stronger < len(#teams) / 2) {
            return "The board expect a place in the top half.";
        }
        return "The board expect you to steer clear of the bottom places.";
    }

    pub fn season_label() {
        return #season .. "/" .. slice(to_string(#season + 1), 2);
    }

    pub fn season_over() { return #league.matchdays_left() == 0; }

    /* The club's place in the table, from 1 */
    pub fn position() {
        foreach (#league.table() as $place => $standing) {
            if ($standing.team == #club) {
                return $place + 1;
            }
        }
    }

    /* The club's place as it is said: 1st, 2nd */
    pub fn place() { return ordinal(#position()); }

    fn tell($subject, $body) {
        #inbox[] = {"matchday" => #league.matchdays_played(), "subject" => $subject, "body" => $body};
    }

    /* Start the next matchday, to be played a minute at a time with live.tick(): every match is
       made and ready, and the commentary on the club's own is collected. end_matchday() when it is
       finished(). Gives the MatchDay. */
    pub fn begin_matchday() {
        if (#season_over()) {
            error("The season is over");
        }
        if (#live != null) {
            error("A matchday is already being played");
        }
        // The other clubs pick their best eleven from who is fit; the manager's stays as it was set,
        // except that anyone who is out is replaced, which the inbox says
        foreach (#teams as $team) {
            if ($team != #club) {
                $team.auto_eleven();
            }
        }
        // ... and set up against whom they play, once the elevens are known
        foreach (#league.next_pairs() as [$home, $away]) {
            foreach ([[$home, $away], [$away, $home]] as [$team, $opponent]) {
                if ($team != #club) {
                    $team.set_mentality(ai_mentality($team.rating() - $opponent.rating()));
                }
            }
        }
        $picked = #club.eleven();
        // Live only once the league has begun it, so a matchday that couldn't begin isn't left half made
        $day = MatchDay(#club);
        #league.begin_matchday($day.attach);
        foreach (#club.eleven() as $i => $player) {
            if ($player != $picked[$i]) {
                #tell("Lineup: {$player} starts", "{$picked[$i]} is out (" .. lower($picked[$i].status()) .. "), so {$player} starts in his place.");
            }
        }
        #out_before = {};
        foreach (filter(#club.players, $player -> !$player.available()) as $player) {
            #out_before[to_string($player)] = true;
        }
        #live = $day;

        return #live;
    }

    /* The matchday is over: the table and the fixtures have its results, and the inbox says what
       happened. Gives the matches played. */
    pub fn end_matchday() {
        if (#live == null) {
            error("No matchday is being played");
        }
        $matches = #league.end_matchday(#live.matches);
        #live = null;
        #settle($matches);
        $available = filter(#club.players, $player -> $player.available());
        foreach ($matches as $match) {
            if ($match.home == #club || $match.away == #club) {
                #report($match);
            }
        }
        #tell("Matchday " .. #league.matchdays_played() .. " results", join(map($matches, $match -> "{$match}"), "\n"));
        #report_availability($available);
        if (#season_over()) {
            $champions = #league.table()[0].team;
            #tell("The season is over", "{$champions} are the champions. You finished " .. ordinal(#position()) .. ".");
        }
        return $matches;
    }

    /* Move time on to the next matchday without watching it: everyone plays, and the inbox says
       what happened. Gives the matches played. */
    pub fn advance() {
        $day = #begin_matchday();
        while (!$day.finished()) {
            $day.tick();
        }

        return #end_matchday();
    }

    /* The books for a matchday: every club is paid by television and pays its wages, and the home
       side takes the gate. The manager's club has each entry in its ledger. */
    fn settle($matches) {
        $day = #league.matchdays_played();
        $home = {};
        foreach ($matches as $match) {
            $home[$match.home.name] = $match.home;
        }
        foreach (#teams as $team) {
            $entries = [["Television", money::TELEVISION], ["Wages", -money::matchday_wages($team, #league.matchdays())]];
            if (has_key($home, $team.name)) {
                $entries[] = ["Gate receipts", money::gate($team)];
            }
            foreach ($entries as [$text, $amount]) {
                $team.balance += $amount;
                if ($team == #club) {
                    #ledger[] = {"matchday" => $day, "text" => $text, "amount" => $amount};
                }
            }
        }
    }

    /* Everyone at the other clubs, richest talent first, as [player, club] pairs */
    pub fn market() {
        $offers = [];
        foreach (filter(#teams, $team -> $team != #club) as $team) {
            foreach ($team.players as $player) {
                $offers[] = [$player, $team];
            }
        }

        return sort($offers, ($a, $b) -> [$b[0].rating, $a[0].number] <=> [$a[0].rating, $b[0].number]);
    }

    /* Buy $player from his club at its price. Gives "" when it is done, and why not when it isn't. */
    pub fn buy($player) {
        if (#live != null) {
            return "No transfers during a match";
        }
        $owner = null;
        foreach (#teams as $team) {
            if (in_array($player, $team.players)) {
                $owner = $team;
            }
        }
        if ($owner == null || $owner == #club) {
            return "{$player} isn't at another club";
        }
        $fee = money::price($player);
        if ($fee > #club.balance) {
            return "You can't afford " .. money::pounds($fee) .. " for {$player}";
        }
        if (len(#club.players) >= Team::MAX_SQUAD) {
            return "{#club} already have " .. Team::MAX_SQUAD .. " players";
        }
        try {
            $owner.release($player);
        } catch (TransferRefused $e) {
            return $e.message;
        }
        #club.sign($player);
        #club.balance -= $fee;
        $owner.balance += $fee;
        #ledger[] = {"matchday" => #league.matchdays_played(), "text" => "Signed {$player}", "amount" => -$fee};
        #tell("Signed: {$player}", "{$player} ({$player.position()}, {$player.rating}) joins from {$owner} for " .. money::pounds($fee) .. ".");

        return "";
    }

    /* Sell $player, to the richest club that can take him at the price, or abroad if none can.
       Gives "" when it is done, and why not when it isn't. */
    pub fn sell($player) {
        if (#live != null) {
            return "No transfers during a match";
        }
        if (!in_array($player, #club.players)) {
            return "{$player} isn't at {#club}";
        }
        $fee = money::sale_price($player);
        try {
            #club.release($player);
        } catch (TransferRefused $e) {
            return $e.message;
        }
        $buyers = sort(filter(#teams, $team -> $team != #club && $team.balance >= $fee && len($team.players) < Team::MAX_SQUAD), ($a, $b) -> [$b.balance, $a.name] <=> [$a.balance, $b.name]);
        $to = "abroad";
        if ($buyers != []) {
            $buyers[0].sign($player);
            $buyers[0].balance -= $fee;
            $to = to_string($buyers[0]);
        }
        #club.balance += $fee;
        #ledger[] = {"matchday" => #league.matchdays_played(), "text" => "Sold {$player}", "amount" => $fee};
        #tell("Sold: {$player}", "{$player} leaves for {$to} for " .. money::pounds($fee) .. ".");

        return "";
    }

    /* What the match did to the club's players: who is hurt or banned now, and who has served it */
    fn report_availability($available) {
        foreach (#club.players as $player) {
            $name = to_string($player);
            if ($player.hurt && $player.injured > 0) {
                #tell("Injury: {$name}", "{$name} was injured and will be out for " .. $player.injured .. ($player.injured == 1 ? " match." : " matches."));
            } else if (!$player.available() && !has_key(#out_before, $name)) {
                #tell("Suspended: {$name}", "{$name} is suspended for the next " .. $player.suspended .. ($player.suspended == 1 ? " match." : " matches."));
            } else if ($player.available() && has_key(#out_before, $name)) {
                #tell("Back: {$name}", "{$name} has served his time out and is available again.");
            }
        }
    }

    /* The manager's change to the eleven: two players of the club, one in the eleven and one on
       the bench, swap places. Gives "" when it is done, and why not when it isn't. */
    pub fn swap($a, $b) {
        if (#live != null) {
            return "The lineup can't change during a match";
        }
        $starting = in_array($a, #club.eleven()) ? [$a, $b] : [$b, $a];
        if (!in_array($starting[0], #club.eleven()) || in_array($starting[1], #club.eleven())) {
            return "Swap a player in the eleven with one on the bench";
        }
        try {
            #club.swap($starting[0], $starting[1]);
        } catch (InvalidLineup $e) {
            return $e.message;
        }

        return "";
    }

    /* The best eleven who can play, in the formation the club prefers (or another). Gives "" when it
       is done, and why not when it isn't. */
    pub fn auto_lineup($formation = null) {
        if (#live != null) {
            return "The lineup can't change during a match";
        }
        #club.auto_eleven($formation);

        return "";
    }

    /* The formations the clubs play, for a choice of them */
    pub fn formations() { return FORMATIONS; }

    /* How the club plays: an index into the mentalities and the intensities, changed at any time,
       in a match too */
    pub fn set_mentality($level) { #club.set_mentality($level); }
    pub fn set_intensity($level) { #club.set_intensity($level); }

    /* A substitution in the match being played: $off leaves the pitch and $on comes on. Gives "" when
       it is done, and why not when it isn't. */
    pub fn substitute($off, $on) {
        if (#live == null || #live.mine == null) {
            return "There is no match to make a substitution in";
        }
        try {
            #live.mine.substitute(#club, $off, $on);
        } catch (InvalidLineup $e) {
            return $e.message;
        }

        return "";
    }

    /* The message about the club's own match */
    fn report($match) {
        $home = $match.home == #club;
        [$scored, $conceded] = $home ? [$match.home_goals, $match.away_goals] : [$match.away_goals, $match.home_goals];
        $opponent = $home ? $match.away : $match.home;
        $what = $scored > $conceded ? "Win" : ($scored == $conceded ? "Draw" : "Defeat");
        $points = #league.table()[#position() - 1].points();
        #tell("{$what}: {$match}", "You " .. ($scored > $conceded ? "beat" : ($scored == $conceded ? "drew with" : "lost to"))
            .. " {$opponent} " .. ($home ? "at home" : "away") .. " {$scored}-{$conceded}. You are "
            .. ordinal(#position()) .. " on {$points} points.");
    }
}
