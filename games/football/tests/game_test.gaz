/*
 * The game's state: a new game, moving time on, and what the inbox says. What the inbox says about
 * a match is checked against the match itself, not against a recorded run.
 */
include "../../../tests/gaz/check.gaz";
include "../game.gaz" use Game, ordinal;

/* How many of $list satisfy $test */
fn count_where($list, $test) {
    return len(filter($list, $test));
}

/* ---- ordinals ---- */
$said = [];
foreach ([1, 2, 3, 4, 10, 11, 12, 13, 14, 21, 22, 23, 101, 111, 112, 113] as $n) {
    $said[] = ordinal($n);
}
check("ordinals", $said, ["1st", "2nd", "3rd", "4th", "10th", "11th", "12th", "13th", "14th", "21st", "22nd", "23rd", "101st", "111th", "112th", "113th"]);

/* ---- A new game ---- */
$game = Game::start(1);
check("ten clubs", len($game.teams), 10);
check("the manager has the first club by default", $game.club, $game.teams[0]);
$third = Game::start(1, 3);
check("or the one asked for", $third.club, $third.teams[3]);
check("clubs have different names", len(keys(map_of_names($game.teams))), 10);
fn map_of_names($teams) {
    $names = {};
    foreach ($teams as $team) {
        $names[$team.name] = true;
    }
    return $names;
}
check("every squad is eleven, with ages", [
    count_where($game.teams, $team -> len($team.players) == 11),
    count_where($game.teams, $team -> count_where($team.players, $player -> $player.age >= 17 && $player.age <= 35) == 11),
], [10, 10]);
check("clubs have money", count_where($game.teams, $team -> $team.balance > 0), 10);
check("the season", [$game.season_label(), $game.season_over()], ["2026/27", false]);
check("a season is eighteen matchdays for ten clubs", [$game.league.matchdays(), $game.league.matchdays_played()], [18, 0]);
check("the club has a place in the table", [$game.position() >= 1, $game.position() <= 10, $game.place()], [true, true, ordinal($game.position())]);
check("the inbox starts with a welcome", [len($game.inbox), $game.inbox[0]["subject"], $game.inbox[0]["matchday"]], [1, "Welcome to Riverside FC", 0]);
check("which says what the board expect", contains($game.inbox[0]["body"], "The board expect"), true);
check("the same seed makes the same game", [
    map(Game::start(7).club.players, $p -> $p.profile()),
    Game::start(7).inbox[0]["body"],
], [
    map(Game::start(7).club.players, $p -> $p.profile()),
    Game::start(7).inbox[0]["body"],
]);
check("another seed makes another", map(Game::start(7).club.players, $p -> $p.profile()) == map(Game::start(8).club.players, $p -> $p.profile()), false);

/* ---- Moving time on ---- */
foreach ([1, 2, 3] as $seed) {
    $game = Game::start($seed, $seed);
    $club = $game.club;
    for ($day = 1; $day <= 18; $day++) {
        $before = len($game.inbox);
        $matches = $game.advance();
        $label = "seed {$seed}, matchday {$day}";
        check("a matchday is five matches ({$label})", len($matches), 5);
        check("and counts as played ({$label})", $game.league.matchdays_played(), $day);

        $mine = null;
        foreach ($matches as $match) {
            if ($match.home == $club || $match.away == $club) {
                $mine = $match;
            }
        }
        check("the club played once ({$label})", $mine != null, true);
        [$scored, $conceded] = $mine.home == $club ? [$mine.home_goals, $mine.away_goals] : [$mine.away_goals, $mine.home_goals];
        $report = $game.inbox[$before];
        $verdict = $scored > $conceded ? "Win" : ($scored == $conceded ? "Draw" : "Defeat");
        check("the report says how it went ({$label})", [starts_with($report["subject"], $verdict .. ": "), contains($report["subject"], $club.name), $report["matchday"]], [true, true, $day]);
        check("and the score, as the club's ({$label})", contains($report["body"], " {$scored}-{$conceded}."), true);
        check("and where the club is ({$label})", contains($report["body"], "You are " .. $game.place() .. " on "), true);
        $results = $game.inbox[$before + 1];
        check("then all the results ({$label})", [$results["subject"], len(split($results["body"], "\n"))], ["Matchday {$day} results", 5]);
        check("the position is between 1 and 10 ({$label})", [$game.position() >= 1, $game.position() <= 10], [true, true]);
        check("two messages, or three when the season ends ({$label})", len($game.inbox) - $before, $day == 18 ? 3 : 2);
    }
    check("the season is over after eighteen ({$seed})", $game.season_over(), true);
    $last = $game.inbox[len($game.inbox) - 1];
    $table = $game.league.table();
    check("which the inbox says: the champions and where the club finished ({$seed})", [
        $last["subject"],
        contains($last["body"], $table[0].team.name .. " are the champions."),
        contains($last["body"], "You finished " .. $game.place() .. "."),
    ], ["The season is over", true, true]);
    try {
        $game.advance();
        check("no more matchdays ({$seed})", "no error", "an error");
    } catch (Error $e) {
        check("no more matchdays ({$seed})", $e.message, "The season is over");
    }
    check("the season played is a full one ({$seed})", sum(map($table, $row -> $row.played)), 10 * 18);
}
