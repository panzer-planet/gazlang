/* a substitution in a match */
$squad = usual_squad();
$team = Team("Testers", $squad);
$team.rest();
$team.substitute($squad[14], $squad[16]);
check("a substitute takes the place, and a substitution is used", [numbers($team.eleven()), $team.substitutions, $team.can_substitute()], [[1, 3, 4, 5, 6, 9, 10, 11, 12, 17, 16], 1, true]);
check("who was taken off can't come back on", swap_result_of_substitute($team, $squad[16], $squad[14]), "Testers can't play: P15 has been taken off and can't come back on");
fn swap_result_of_substitute($team, $off, $on) {
    try {
        $team.substitute($off, $on);
        return "no error";
    } catch (InvalidLineup $e) {
        return $e.message;
    }
}
$team.substitute($squad[3], $squad[6]);
$team.substitute($squad[4], $squad[7]);
check("three is the most", [$team.substitutions, $team.can_substitute()], [3, false]);
check("a fourth is refused", swap_result_of_substitute($team, $squad[5], $squad[12]), "Testers can't play: no substitutions left");
$team.rest();
check("a new match has three again, and the taken off can play", [$team.substitutions, $team.can_substitute(), swap_result_of_substitute($team, $squad[6], $squad[3])], [0, true, "no error"]);

$squad = usual_squad();
$team = Team("Testers", $squad);
$team.rest();
check("the substitute has to be on the bench", swap_result_of_substitute($team, $squad[2], $squad[3]), "Testers can't play: P4 isn't a substitute");
check("and the player going off on the pitch", swap_result_of_substitute($team, $squad[7], $squad[6]), "Testers can't play: P8 isn't on the pitch");
$squad[6].injure(1);
check("a substitute has to be fit", swap_result_of_substitute($team, $squad[2], $squad[6]), "Testers can't play: P7 can't play");
check("a goalkeeper can't come on for an outfield player while there is one in goal", swap_result_of_substitute($team, $squad[2], $squad[1]), "Testers can't play: P2 is a goalkeeper, and there is one on the pitch");
$squad[3].sent_off = true;
$team.changed();
check("nobody replaces a player who was sent off", swap_result_of_substitute($team, $squad[3], $squad[7]), "Testers can't play: P4 has been sent off, and can't be replaced");
$squad[0].injure(1);
$team.changed();
check("but with the goalkeeper hurt, a goalkeeper can come on for anyone", swap_result_of_substitute($team, $squad[4], $squad[1]), "no error");

