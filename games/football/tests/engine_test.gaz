$sitting = $teams[0].eleven()[5];
$sitting.injure(2);
$banned_player = $teams[1].eleven()[6];
$banned_player.suspended = 1;
$league.play_matchday();
check("a matchday served counts for a suspension and not for an injury", [$sitting.injured, $banned_player.suspended], [2, 0]);
$league.play_matchday();
check("however many are played: an injury is days", $sitting.injured, 2);

/* extra time keeps the clock, so what happens in it has its own minute */
[$home, $away] = clubs(2, 6);
$heard = [];
$long_match = Fixture($home, $away).on_event($hear).play().extra_time();
check("after extra time the clock says 120", $long_match.elapsed, 120);
$long_match.injure($home, $home.on_pitch()[3], 1);
check("and an injury then is at minute 120", $heard[len($heard) - 2].minute, 120);

/* ---- Tactics: how a team plays ---- */
$team = Team("Testers", usual_squad());
check("balanced and normal is a team exactly as strong as it is", [$team.mentality, $team.intensity, $team.attack_factor(), $team.defence_factor(), $team.tiring_factor(), $team.mentality_name(), $team.intensity_name()], [2, 1, 1, 1, 1, "Balanced", "Normal"]);
$rows = [];
foreach ([0, 1, 2, 3, 4] as $mentality) {
    $team.set_mentality($mentality);
    $rows[] = [$team.mentality_name(), round($team.attack_factor(), 4), round($team.defence_factor(), 4)];
}
check("attacking is more attack and less defence, a step at a time", $rows, [["Defensive", 0.76, 1.2], ["Cautious", 0.88, 1.1], ["Balanced", 1, 1], ["Positive", 1.12, 0.9], ["Attacking", 1.24, 0.8]]);
$team.set_mentality(2);
$rows = [];
foreach ([0, 1, 2] as $intensity) {
    $team.set_intensity($intensity);
    $rows[] = [$team.intensity_name(), round($team.attack_factor(), 4), $team.defence_factor(), $team.tiring_factor()];
}
check("playing hard is a little more attack and a lot more tiring, and doesn't touch the defence", $rows, [["Low", 0.95, 1, 0.75], ["Normal", 1, 1, 1], ["High", 1.05, 1, 1.25]]);
$team.set_mentality(-3);
$team.set_intensity(-1);
check("what is asked for stays within what there is: the least", [$team.mentality, $team.intensity], [0, 0]);
$team.set_mentality(9);
$team.set_intensity(7);
check("and the most", [$team.mentality, $team.intensity], [4, 2]);

/* tiring follows the intensity: the same player, rested and played thirty minutes */
$forms = [];
foreach ([0, 1, 2] as $intensity) {
    $tired_team = Team("Tired", usual_squad());
    $tired_team.set_intensity($intensity);
    $tired_team.rest();
    $tired_team.tire(30);
    $forms[] = $tired_team.eleven()[4].form();
}
check("a team playing hard is more tired: lower form the harder it plays", [$forms[0] > $forms[1], $forms[1] > $forms[2]], [true, true]);

/* how it plays changes what happens: the same two squads, the same random numbers, over many matches */
fn seasons_of_matches($home, $away, $matches) {
    rand_seed(11);
    $scored = 0;
    $attempts_against = 0;
    $on_target_against = 0;
    shared $seen = [];
    $listen = $event -> { $seen[] = $event; };
    for ($i = 0; $i < $matches; $i++) {
        $seen = [];
        $match = Fixture($home, $away).on_event($listen).play();
        $scored += $match.home_goals;
        foreach ($seen as $event) {
            if ((is_a($event, Goal) || is_a($event, Shot)) && $event.team == $away) {
                $attempts_against++;
                if (is_a($event, Goal) || $event.keeper != null) {
                    $on_target_against++;
                }
            }
        }
    }
    return [$scored, $on_target_against / $attempts_against];
}
[$home, $away] = clubs(2, 13);
$home.set_mentality(4);
[$attacking_goals, $attacking_on_target] = seasons_of_matches($home, $away, 400);
$home.set_mentality(0);
[$defensive_goals, $defensive_on_target] = seasons_of_matches($home, $away, 400);
check("attacking scores more than defending, over 400 matches", $attacking_goals > $defensive_goals * 1.08, true);
check("and defending lets less through: a smaller share of the other side's attempts are on target", $defensive_on_target < $attacking_on_target - 0.03, true);

/* a substitution the manager makes, in a match */
[$home, $away] = clubs(2, 3);
$heard = [];
$match = Fixture($home, $away).on_event($hear);
for ($minute = 1; $minute <= 20; $minute++) {
    $match.tick();
}
$off = $home.on_pitch()[4];
$on = $home.best_substitute($off);
$match.substitute($home, $off, $on);
check("a substitution is an event at the minute, and the team changes", [is_a($heard[len($heard) - 1], Substitution), $heard[len($heard) - 1].minute, $heard[len($heard) - 1].off == $off, $heard[len($heard) - 1].on == $on, in_array($on, $home.on_pitch()), in_array($off, $home.on_pitch()), $home.substitutions], [true, 20, true, true, true, false, 1]);
$events_before = len($heard);
try {
    $match.substitute($home, $off, $on);
    check("who has come on can't come off for who went off", "no error", "an error");
} catch (InvalidLineup $e) {
    check("who has gone off can't come back", contains($e.message, "isn't on the pitch"), true);
}
$match.substitute($home, $home.on_pitch()[2], $home.best_substitute($home.on_pitch()[2]));
$match.substitute($home, $home.on_pitch()[3], $home.best_substitute($home.on_pitch()[3]));
$events_before = len($heard);
try {
    $match.substitute($home, $home.on_pitch()[5], $home.best_substitute($home.on_pitch()[5]));
    check("a fourth substitution is refused", "no error", "an error");
} catch (InvalidLineup $e) {
    check("a fourth substitution is refused, and nothing is said about it", [$e.message, len($heard) == $events_before, $home.substitutions], ["{$home} can't play: no substitutions left", true, 3]);
}

/* who plays whom next, before it begins */
$teams = clubs(4, 9);
$league = League($teams);
$next = $league.next_pairs();
check("the next matchday's pairs, before it begins", [len($next), len($next[0]), $league.matchdays_played()], [2, 2, 0]);
check("asking again is the same, and changes nothing", [$league.next_pairs() == $next, $league.matchdays_played()], [true, 0]);
$begun = $league.begin_matchday();
check("they are the matches that begin", map($begun, $m -> [$m.home, $m.away]), $next);
foreach ($begun as $match) {
    $match.play();
}
$league.end_matchday($begun);
check("and the next matchday is another", $league.next_pairs() == $next, false);
$season = League(clubs(4, 10));
$season.play_season($m -> null, ($n, $ms) -> null);
check("when the season is over there are none", $season.next_pairs(), []);

/* who could come on */
[$home, $away] = clubs(2, 3);
$match = Fixture($home, $away).start();
$forward = filter($home.on_pitch(), $p -> $p.position() == "FW")[0];
$keeper = $home.goalkeeper();
$bench_keepers = filter($home.substitutes(), $p -> $p.position() == "GK");
check("the bench who can play includes a goalkeeper, which a forward can't be replaced with", [len($bench_keepers), len(filter($home.substitutes($forward), $p -> $p.position() == "GK")), len(filter($home.substitutes($keeper), $p -> $p.position() == "GK"))], [1, 0, 1]);
$on = $home.substitutes($forward)[0];
$home.substitute($forward, $on);
check("nobody taken off is offered again", [in_array($forward, $home.substitutes()), in_array($on, $home.substitutes())], [false, false]);
$injured = $home.substitutes()[0];
$injured.injure(2);
check("nor anyone who is out", in_array($injured, $home.substitutes()), false);

/* ---- Signing and releasing ---- */
[$home, $away] = clubs(2, 21);
$star = $away.players[0];
foreach ($away.players as $p) {
    if ($p.position() == "FW") {
        $star = $p;
    }
}
$size = len($home.players);
$home.sign($star);
$numbers = map($home.players, $p -> $p.number);
check("a signing joins the squad, on the lowest shirt number free", [len($home.players), in_array($star, $home.players), $star.number > 0], [$size + 1, true, true]);
check("and no two players share a number", len(filter($numbers, $n -> len(filter($numbers, $m -> $m == $n)) > 1)), 0);
$second = $away.players[1];
try {
    foreach ($away.players as $p) {
        $home.sign(Forward("X", 60, 1));
    }
    check("a squad can't grow forever", "no error", "an error");
} catch (TransferRefused $e) {
    check("a full squad is refused", [len($home.players), contains($e.message, "already have 24")], [24, true]);
}
$leaver = filter($away.eleven(), $p -> $p.position() == "DF")[0];
$away.release($leaver);
check("a player who leaves the eleven is covered", [len($away.eleven()), in_array($leaver, $away.eleven()), in_array($leaver, $away.players), $away.formation()], [11, false, false, "4-4-2"]);
$away.sign(Defender("Filler", 55, 1));
$keepers = filter($away.players, $p -> $p.position() == "GK");
try {
    foreach ($keepers as $k) {
        $away.release($k);
    }
    check("the last two goalkeepers can't go", "no error", "an error");
} catch (TransferRefused $e) {
    check("the last two goalkeepers can't go: {$e.message}", [contains($e.message, "two goalkeepers"), len(filter($away.players, $p -> $p.position() == "GK"))], [true, 2]);
}
$small = Team("Small", slice($away.players, 0, 16));
try {
    $small.release($small.players[15]);
    check("a squad can't be cut below sixteen", "no error", "an error");
} catch (TransferRefused $e) {
    check("a squad at sixteen keeps them", [contains($e.message, "at least 16"), len($small.players)], [true, 16]);
}
try {
    $home.release($leaver);
    check("who isn't there can't leave", "no error", "an error");
} catch (TransferRefused $e) {
    check("who isn't there can't leave", contains($e.message, "isn't at"), true);
}

/* ---- What a save keeps ---- */
$player = Defender("D. Test", 71, 4);
$player.age = 27;
$player.goals = 3;
$player.clean_sheets = 5;
$player.career_goals = 9;
$player.injured = 2;
$player.suspended = 1;
$player.season_yellows = 4;
$copy = players::from_data($player.to_data());
check("a player is saved with what he has done and what keeps him out", [$copy.position(), $copy.rating, $copy.number, $copy.age, $copy.goals, $copy.clean_sheets, $copy.career_goals, $copy.injured, $copy.suspended, $copy.season_yellows], ["DF", 71, 4, 27, 3, 5, 9, 2, 1, 4]);
$match = Fixture::played($home, $away, 3, 1);
check("a match played in a saved game is its score", [$match.finished(), $match.home_goals, $match.away_goals, to_string($match)], [true, 3, 1, "{$home} 3 - 1 {$away}"]);
$four = clubs(4, 31);
$table_league = League($four);
$table_league.draw();
$table_league.play_matchday();
$table_league.play_matchday();
$data = $table_league.to_data();
$again = League::from_data($data, $four);
check("a league saved mid-season comes back: same table, same fixtures, same results", [
    map($again.table(), $s -> $s.to_string()) == map($table_league.table(), $s -> $s.to_string()),
    $again.matchdays_played(), $again.matchdays(), $again.to_data() == $data,
], [true, 2, 6, true]);
$again.play_matchday();
check("and plays on", $again.matchdays_played(), 3);

/* ---- A goalkeeper back from injury takes the goal again ---- */
[$home, $away] = clubs(2, 41);
$keepers = filter($home.players, $p -> $p.position() == "GK");
foreach ($keepers as $k) {
    $k.injure(2);
}
$home.prepare();
check("with every goalkeeper out an outfielder is in goal", count_where_kind($home.eleven(), "GK"), 0);
$home.finish();
$keepers[0].injured = 0;
$keepers[1].injured = 0;
$changes = $home.prepare();
$best = $keepers[0].rating >= $keepers[1].rating ? $keepers[0] : $keepers[1];
check("and when one is fit again he takes the goal back, the change reported", [count_where_kind($home.eleven(), "GK"), in_array($best, $home.eleven()), len($changes), $changes[0][1] == $best, len($home.eleven())], [1, true, 1, true, 11]);
$home.finish();
check("and a side with its keeper in goal is left alone", [len($home.prepare()), in_array($best, $home.eleven())], [0, true]);

fn count_where_kind($list, $position) {
    return len(filter($list, $p -> $p.position() == $position));
}

/* a saved side whose goalkeepers are all out has an outfielder in goal, and loads */
[$home, $away] = clubs(2, 43);
foreach (filter($home.players, $p -> $p.position() == "GK") as $k) {
    $k.injure(3);
}
$home.prepare();
$home.finish();
$again = teams::from_data($home.to_data());
check("a side with no fit goalkeeper is saved and loaded as it is", [len($again.eleven()), count_where_kind($again.eleven(), "GK")], [11, 0]);
$fit = clubs(2, 44)[0];
try {
    $outfield = filter($fit.players, $p -> $p.position() != "GK");
    Team($fit.name, $fit.players, slice($outfield, 0, 11));
    check("but not while a goalkeeper could play", "no error", "an error");
} catch (InvalidLineup $e) {
    check("but not while a goalkeeper could play", contains($e.message, "0 goalkeepers"), true);
}

/* ---- Names ---- */
$scout = Scout();
$made = [];
for ($i = 0; $i < 2000; $i++) {
    $made[] = to_string($scout.youth(Forward, clubs(1, 5)[0], 9));
}
$surnames = {};
$full = {};
$odd = 0;
foreach ($made as $name) {
    $full[$name] = true;
    $surnames[slice($name, 3, len($name) - 3)] = true;
    if (!(len($name) > 4 && slice($name, 1, 2) == ". ")) {
        $odd++;
    }
}
$foreign = ["Abara", "Achebe", "Adeyemi", "Alvarez", "Andersen", "Bauer", "Becker", "Brandt", "Castillo", "Costa", "Diallo", "Dube", "Duarte", "Eriksen", "Ferreira", "Fischer", "Garcia", "Haddad", "Ivanova", "Kamara", "Kowalski", "Lindqvist", "Lopez", "Mbeki", "Mensah", "Moreau", "Morales", "Nakamura", "Novak", "Nwosu", "Okafor", "Olsen", "Ortega", "Petrov", "Rossi", "Ruiz", "Sato", "Silva", "Svensson", "Vargas", "Yilmaz", "Zielinski"];
$abroad = count_where($made, $n -> in_array(slice($n, 3, len($n) - 3), $foreign));
check("names are an initial and a surname, and every one is different", [$odd, len($full)], [0, 2000]);
check("with plenty of variety: hundreds of different surnames", len($surnames) > 200, true);
check("mostly English, about one in seven from elsewhere", [$abroad > 150, $abroad < 450], [true, true]);

/* saved after a match played with an outfielder in goal, once the goalkeepers are fit again */
[$home, $away] = clubs(2, 45);
foreach (filter($home.players, $p -> $p.position() == "GK") as $k) {
    $k.injure(1);
}
$home.prepare();
$home.finish();
foreach (filter($home.players, $p -> $p.position() == "GK") as $k) {
    $k.recover();
}
$loaded = teams::from_data($home.to_data());
check("a side saved with a stand-in in goal after its goalkeepers are fit again loads, and the next match puts a goalkeeper back", [count_where_kind($loaded.eleven(), "GK"), count_where_kind($loaded.eleven(), "GK") + len($loaded.prepare()) > 0 ? count_where_kind($loaded.eleven(), "GK") : -1], [0, 1]);
$doubled = filter($away.players, $p -> $p.position() == "GK");
try {
    $away.restore([...slice(filter($away.players, $p -> $p.position() != "GK"), 0, 9), $doubled[0], $doubled[1]]);
    check("but two goalkeepers are never allowed", "no error", "an error");
} catch (InvalidLineup $e) {
    check("but two goalkeepers are never allowed", contains($e.message, "2 goalkeepers"), true);
}

/* ---- The calendar ---- */
$saturdays = calendar::saturdays(2026);
check("a season's Saturdays: 41 from 8 August to 15 May, every seventh day", [len($saturdays), date::format($saturdays[0]), date::format($saturdays[40]), count_where($saturdays, $d -> date::weekday($d) == 5)], [41, "Sat 8 Aug 2026", "Sat 15 May 2027", 41]);
check("the first Saturday is on or after 8 August, whatever the year", [date::format(calendar::saturdays(2027)[0]), date::format(calendar::saturdays(2025)[0])], ["Sat 14 Aug 2027", "Sat 9 Aug 2025"]);
$premier = calendar::matchdays(2026, 38);
$championship = calendar::matchdays(2026, 46);
check("thirty-eight matchdays are Saturdays in order, with three weeks left out", [len($premier), count_where($premier, $d -> in_array($d, $saturdays)), $premier == sort($premier, ($a, $b) -> $a <=> $b), len(keys(dates_set($premier)))], [38, 38, true, 38]);
fn dates_set($days) {
    $set = {};
    foreach ($days as $d) {
        $set[$d] = true;
    }
    return $set;
}
$tuesdays = filter($championship, $d -> date::weekday($d) == 1);
check("forty-six: every Saturday and five Tuesdays, in order, none twice, within the season", [len($championship), count_where($championship, $d -> in_array($d, $saturdays)), len($tuesdays), $championship == sort($championship, ($a, $b) -> $a <=> $b), len(keys(dates_set($championship))), $championship[0] >= date::days(2026, 8, 8), $championship[45] <= date::days(2027, 5, 16)], [46, 41, 5, true, 46, true, true]);
check("each Tuesday is the one before a Saturday of the season", count_where($tuesdays, $d -> in_array($d + 4, $saturdays)), 5);
check("a division can be short of matchdays: fewer than the Saturdays are spread over them", [len(calendar::matchdays(2026, 10)), date::format(calendar::matchdays(2026, 10)[0])], [10, "Sat 8 Aug 2026"]);
try {
    calendar::matchdays(2026, 90);
    check("no room for ninety matchdays", "no error", "an error");
} catch (Error $e) {
    check("no room for ninety matchdays", contains($e.message, "has no room for 90 matchdays"), true);
}
check("the season begins on 1 July and is reviewed on 1 June", [date::format(calendar::season_start(2026)), date::format(calendar::review_day(2026))], ["Wed 1 Jul 2026", "Tue 1 Jun 2027"]);
check("the windows: July, August and January", map([[6, 30], [7, 1], [8, 31], [9, 1], [12, 31], [1, 1], [1, 31], [2, 1]], ([$m, $d]) -> calendar::window_open(date::days(2027, $m, $d))), [false, true, true, false, false, true, true, false]);
check("and when the next opens", [calendar::window_opens(date::days(2026, 9, 1)), calendar::window_opens(date::days(2027, 3, 1)), calendar::window_opens(date::days(2027, 6, 30))], ["1 January", "1 July", "1 July"]);

$dated = League(clubs(4, 61));
$dated.draw();
check("a league that hasn't been dated has no next date", [$dated.next_date(), $dated.dates], [null, []]);
$dated.assign_dates([100, 107, 114, 121, 128, 135]);
check("dated, its next matchday is the first, and then the next", [$dated.next_date()], [100]);
$first_day = $dated.play_matchday();
check("played, the next date moves on, and a club's fixtures have their dates", [$dated.next_date(), $dated.fixtures_of($first_day[0].home)[1]["date"], $dated.fixtures_of($first_day[0].home)[0]["date"]], [107, 107, 100]);
try {
    $dated.assign_dates([1, 2, 3]);
    check("a season needs a date for every matchday", "no error", "an error");
} catch (Error $e) {
    check("a season needs a date for every matchday", contains($e.message, "needs 6 dates, not 3"), true);
}
for ($i = 0; $i < 5; $i++) {
    $dated.play_matchday();
}
check("and none when it is over", [$dated.matchdays_left(), $dated.next_date()], [0, null]);
$restored = League::from_data($dated.to_data(), $four);
check("the dates are saved", $restored.dates, [100, 107, 114, 121, 128, 135]);

/* ---- Birthdays ---- */
$scout = Scout();
$squad_team = $scout.team("Birthday FC", 65, "4-4-2");
$odd = 0;
foreach ($squad_team.players as $p) {
    $month = intdiv($p.birthday, 100);
    $day = $p.birthday % 100;
    if ($month < 1 || $month > 12 || $day < 1 || $day > 28) {
        $odd++;
    }
}
check("every player has a birthday in the year, never the 29th of February", $odd, 0);
$months = {};
for ($i = 0; $i < 300; $i++) {
    $months[intdiv($scout.youth(Forward, $squad_team, 9).birthday, 100)] = true;
}
check("and they are spread over the twelve months", len($months), 12);
$aged = Defender("Old", 60, 4);
$aged.age = 30;
$aged.celebrate();
check("a birthday is a year older, and nothing else", [$aged.age, $aged.rating], [31, 60]);
$copy = players::from_data($aged.to_data());
check("the birthday is saved", $copy.birthday, $aged.birthday);

/* ---- Injuries heal with the days ---- */
$patient = Midfielder("M", 70, 8);
$patient.injure(3);
check("a day is a day nearer healed: recover() says when he is back", [$patient.recover(), $patient.injured, $patient.recover(), $patient.injured, $patient.available(), $patient.recover(), $patient.injured], [false, 2, false, 1, false, true, 0]);
check("and then he is available, and a healthy player recovering changes nothing", [$patient.available(), $patient.recover(), $patient.injured], [true, false, 0]);
$long = Defender("D", 70, 4);
$long.injure(31);
check("how long is said in days to a fortnight, then weeks", [players::days_text(1), players::days_text(5), players::days_text(13), players::days_text(14), players::days_text(31), players::days_text(90)], ["1 day", "5 days", "13 days", "2 weeks", "4 weeks", "13 weeks"]);
check("the status too", [$long.status(), $patient.status(), (function_status(9)), (function_status(20))], ["Injured 4w", "", "Injured 9d", "Injured 3w"]);
fn function_status($days) {
    $p = Forward("F", 60, 9);
    $p.injure($days);
    return $p.status();
}
$banned_only = Defender("B", 60, 3);
$banned_only.suspended = 2;
$banned_only.recover();
check("a suspension is matches and days don't touch it", $banned_only.suspended, 2);
