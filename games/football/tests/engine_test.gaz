/* the manager's swap */
fn swap_result($team, $starter, $reserve) {
    try {
        $team.swap($starter, $reserve);
        return "no error";
    } catch (InvalidLineup $e) {
        return $e.message;
    }
}
$squad = usual_squad();
$team = Team("Testers", $squad);
$team.rest();
check("the starters", numbers($team.on_pitch()), [1, 3, 4, 5, 6, 9, 10, 11, 12, 15, 16]);
$team.swap($squad[14], $squad[16]);
check("a swap puts the reserve in the starter's place, in the same slot", numbers($team.eleven()), [1, 3, 4, 5, 6, 9, 10, 11, 12, 17, 16]);
check("and who is on the pitch changed too, not what it was before", [in_array($squad[16], $team.on_pitch()), in_array($squad[14], $team.on_pitch())], [true, false]);
check("the formation is what they add up to", $team.formation(), "4-4-2");
$team.swap($squad[3], $squad[12]);
check("a midfielder for a defender is another formation", $team.formation(), "3-5-2");
$team.swap($squad[0], $squad[1]);
check("a goalkeeper for a goalkeeper is fine", $team.eleven()[0].number, 2);

$squad = usual_squad();
$team = Team("Testers", $squad);
check("the player going out has to be in the eleven", swap_result($team, $squad[13], $squad[7]), "Testers can't play: P14 isn't in the eleven");
check("the player coming in has to be a reserve", swap_result($team, $squad[2], $squad[3]), "Testers can't play: P4 isn't a reserve");
check("and one of the club's", swap_result($team, $squad[2], Forward("Stranger", 70, 99)), "Testers can't play: Stranger isn't a reserve");
check("an outfield player can't take the goalkeeper's place: there would be none", swap_result($team, $squad[0], $squad[6]), "Testers can't play: 0 goalkeepers in the eleven");
check("nor a second goalkeeper an outfield player's: there would be two", swap_result($team, $squad[2], $squad[1]), "Testers can't play: 2 goalkeepers in the eleven");
$squad[7].injure(2);
check("an injured reserve can't be picked", swap_result($team, $squad[2], $squad[7]), "Testers can't play: P8 can't play: Injured 2d");
$squad[6].suspended = 1;
check("nor a banned one", swap_result($team, $squad[2], $squad[6]), "Testers can't play: P7 can't play: Banned 1");
check("and a refused swap changes nothing", numbers($team.eleven()), [1, 3, 4, 5, 6, 9, 10, 11, 12, 15, 16]);

