/* injuries in a match, and the cover for them */
[$home, $away] = clubs(2, 3);
$heard = [];
$match = Fixture($home, $away).on_event($hear);
for ($minute = 1; $minute <= 30; $minute++) {
    $match.tick();
}
$victim = $home.on_pitch()[3];
$cover = $home.best_substitute($victim);
$match.injure($home, $victim, 3);
$last = slice($heard, len($heard) - 2);
check("an injury is an event, then the substitution for it", [is_a($last[0], Injury), is_a($last[1], Substitution), $last[0].minute, $last[1].minute, $last[0].player == $victim, $last[1].on == $cover, $last[1].off == $victim], [true, true, 30, 30, true, true, true]);
check("he is off, the substitute is on, and he is out for the matches said", [in_array($victim, $home.on_pitch()), in_array($cover, $home.on_pitch()), $home.substitutions, $victim.injured, $victim.hurt], [false, true, 1, 3, true]);
check("the events say it", [contains(to_string($last[0]), "is injured and has to go off: out for 3 days"), contains(to_string($last[1]), "Substitution for {$home}: ")], [true, true]);
$match.injure($home, $home.on_pitch()[2], 1);
$match.injure($home, $home.on_pitch()[2], 1);
check("three substitutions are made", $home.substitutions, 3);
$before = len($home.on_pitch());
$heard_before = len($heard);
$match.injure($home, $home.on_pitch()[2], 2);
check("a fourth injury has no cover: the team plays a man short", [len($home.on_pitch()), $before - 1, len($heard) - $heard_before], [10, 10, 1]);
check("and says a match, not matches, for one", contains(to_string(Injury(5, $home, $victim, 1)), "out for 1 day"), true);

$eleven_only = Team("Eleven", squad_of([[Goalkeeper, 70], [Defender, 60], [Defender, 60], [Defender, 60], [Defender, 60], [Midfielder, 60], [Midfielder, 60], [Midfielder, 60], [Midfielder, 60], [Forward, 60], [Forward, 60]]));
[$home, $away] = clubs(2, 4);
$heard = [];
$match = Fixture($eleven_only, $away).on_event($hear);
$match.injure($eleven_only, $eleven_only.on_pitch()[4], 2);
check("with no bench, an injury is a man short and no substitution", [count_where($heard, $e -> is_a($e, Injury)), count_where($heard, $e -> is_a($e, Substitution)), len($eleven_only.on_pitch())], [1, 0, 10]);

/* the start of a match takes the unavailable off the pitch */
