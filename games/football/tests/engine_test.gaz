check("a starter who is out isn't in the eleven when the match starts", [in_array($out, $home.eleven()), in_array($out, $home.on_pitch()), len($home.on_pitch()), $started.elapsed], [false, false, 11, 0]);

/* and they happen by themselves, in real matches */
$injuries = 0;
$reds = 0;
$problems = [];
for ($seed = 1; $seed <= 60; $seed++) {
    [$home, $away] = clubs(2, $seed);
    $heard = [];
    Fixture($home, $away).on_event($hear).play();
    foreach ($heard as $event) {
        if (is_a($event, Injury)) {
            $injuries++;
            if (!$event.player.hurt || $event.player.injured < 10 || $event.player.injured > 90) {
                $problems[] = "seed {$seed}: {$event.player} is hurt " .. to_string([$event.player.hurt]) .. " for {$event.player.injured}";
            }
            if (in_array($event.player, $event.team.on_pitch())) {
                $problems[] = "seed {$seed}: {$event.player} is injured and still on the pitch";
            }
        }
    }
    foreach ([$home, $away] as $side) {
        if ($side.substitutions > 3) {
            $problems[] = "seed {$seed}: {$side} made {$side.substitutions} substitutions";
        }
        foreach ($side.players as $player) {
            if ($player.sent_off) {
                $reds++;
                if ($player.suspended < 1) {
                    $problems[] = "seed {$seed}: {$player} was sent off and isn't banned";
                }
            }
        }
    }
}
check("in sixty matches there were injuries and red cards to look at", [$injuries > 0, $reds > 0], [true, true]);
check("every injury put the player off the pitch and out for ten to ninety days, no team made more than three substitutions, and every red card is a ban", $problems, []);

/* matches served, in a league */
