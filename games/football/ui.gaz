/*
 * The interface: a Shell (a top bar, a menu of sections down the left, the section on show, and a
 * line of hints at the bottom) and a tui::View for each section. A view is given a Rect of the
 * screen and draws in it; the shell cuts the screen up and decides where keys go. Like Football
 * Manager the game is mostly tables you move about in, and time moves on with one key: c.
 *
 * Views only read the game (game.gaz) and never change it: a key gives an Action, which the shell
 * carries out, so what a key does to the game is in one place, the actions, one kind each.
 * Nothing here talks to the terminal, so it is all tested by drawing into a tui::Screen and
 * reading its lines.
 */
namespace ui;

import "std/term.gaz";
import "std/tui.gaz";
import "std/format.gaz" use pad_left, pad_right;
import "std/date.gaz";
import "engine/money.gaz";
import "engine/teams.gaz" use Team;
import "engine/matches.gaz" use Goal, Booking, Whistle, Injury, Substitution;

/* ---- Actions: what a view asks the shell to do to the game ------------------------------- */

/*
 * A change to the game a key asked for. The shell carries it out, and what it gives is the note
 * for the bottom line: what was done, or why it couldn't be.
 */
pub abstract kind Action {
    pub abstract fn carry_out($game);
}

/* $note when the game reported no $problem, else the problem */
fn done($problem, $note) {
    return $problem == "" ? $note : $problem;
}

/* Swap one of the eleven with one from the bench */
pub kind Swap extends Action {
    fn _(pub #first, pub #second);

    pub fn carry_out($game) {
        return done($game.swap(#first, #second), "Lineup changed");
    }
}

/* Pick the best eleven for the formation as it is */
pub kind BestEleven extends Action {
    pub fn carry_out($game) {
        return done($game.auto_lineup(), "The best eleven, picked");
    }
}

/* Change the formation, and pick the best eleven for it */
pub kind Formation extends Action {
    fn _(pub #name);

    pub fn carry_out($game) {
        return done($game.auto_lineup(#name), "{#name}, with the best eleven for it");
    }
}

/* Set how attacking the side is, in or out of a match */
pub kind Mentality extends Action {
    fn _(pub #level);

    pub fn carry_out($game) {
        $game.set_mentality(#level);
        return "Mentality: " .. $game.club.mentality_name();
    }
}

/* Set how hard the side presses */
pub kind Intensity extends Action {
    fn _(pub #level);

    pub fn carry_out($game) {
        $game.set_intensity(#level);
        return "Intensity: " .. $game.club.intensity_name();
    }
}

/* Renew a player's contract */
pub kind Renew extends Action {
    fn _(pub #player);

    pub fn carry_out($game) {
        return done($game.renew(#player), "{#player} is on a contract until " .. date::format(#player.contract_until));
    }
}

/* Buy a player from another club */
pub kind Buy extends Action {
    fn _(pub #player);

    pub fn carry_out($game) {
        return done($game.buy(#player), "Signed {#player}");
    }
}

/* Sell one of the club's players */
pub kind Sell extends Action {
    fn _(pub #player);

    pub fn carry_out($game) {
        return done($game.sell(#player), "Sold {#player}");
    }
}

/* Bring a player on for one of the eleven, during a match */
pub kind Substitute extends Action {
    fn _(pub #off, pub #on);

    pub fn carry_out($game) {
        return done($game.substitute(#off, #on), "{#on} on for {#off}");
    }
}

/* The matchday is over: put its results in the table and the news in the inbox */
pub kind EndMatchday extends Action {
    pub fn carry_out($game) {
        $game.end_matchday();
        return "";
    }
}

/* Nothing to change: a key couldn't be obeyed, and the note says why */
pub kind Notice extends Action {
    fn _(pub #text);

    pub fn carry_out($game) {
        return #text;
    }
}

/* ---- Views ------------------------------------------------------------------------------- */

/* A section of the game: a view that reads the game and never changes it */
pub abstract kind GameView extends tui::View {
    fn _(kin #game);
}

/* Messages, the newest first: a list above and the one selected in full below */
pub kind InboxView extends GameView {
    #table = tui::Table(["Date", "Subject"], []);

    pub fn title() { return "Inbox"; }
    pub fn hints() { return [tui::Hint("j/k", "move")]; }

    pub fn draw($screen, $rect, $focused) {
        $messages = reverse(#game.inbox);
        #table.set_rows(map($messages, $message -> [date::short($message["date"]), $message["subject"]]));
        [$list, $rest] = $rect.split_top(max(min(len($messages), 8) + 1, 2));
        #table.draw($screen, $list, $focused);
        $index = #table.selected_index();
        if ($index == null || $rest.height < 3) {
            return null;
        }
        $message = $messages[$index];
        tui::box($screen, $rest, $message["subject"]);
        tui::paragraph($screen, $rest.inset(1), $message["body"]);
    }

    pub fn handle($key) {
        #table.handle($key);
        return null;
    }
}

/*
 * The club's players, and where the manager picks the eleven: the eleven first, then the bench,
 * each with its role and whether it can play. Enter picks a player and enter on another swaps
 * them (one from the eleven with one from the bench), and a picks the best eleven.
 */
pub kind SquadView extends GameView {
    #table = tui::Table(["#", "Name", "Pos", "Age", "Rating", "Goals", "Role", "Status", "Contract"], [], ($row, $index) -> match {
        starts_with($row[1], "▸") => "bold cyan",
        $row[7] != "" => "red",
        $row[6] == "sub" => "dim",
        default => "",
    }).drop_when_narrow([5, 6, 8, 3]);  // goals, role (the dim rows say it), contract, age
    /* The players in the order the table has them, so a row is a player, and who is picked up */
    #shown = [];
    #picked = null;

    pub fn title() { return "Squad"; }
    pub fn hints() {
        return [
            tui::Hint("j/k", "move"),
            tui::Hint("enter", "pick, then enter to swap"),
            tui::Hint("a", "best eleven"),
            tui::Hint("r", "renew"),
            tui::Hint(". ,", "sort"),
            tui::Hint("o", "reverse"),
            tui::Hint("x", "unsorted"),
        ];
    }

    /* Put the game's squad in the table, the eleven first: done for a key as well as for a frame, so
       what a key means never depends on whether a frame came first */
    fn refresh() {
        $club = #game.club;
        $eleven = $club.eleven();
        #shown = [...$eleven, ...$club.bench()];
        #table.set_rows(map(#shown, $player -> [$player.number, (#picked == $player ? "▸ " : "") .. to_string($player), $player.position(), $player.age, $player.rating, $player.goals, in_array($player, $eleven) ? "XI" : "sub", $player.status(), date::year($player.contract_until)]));
    }

    pub fn draw($screen, $rect, $focused) {
        $club = #game.club;
        #refresh();
        [$body, $footer] = $rect.split_bottom(2);
        #table.draw($screen, $body, $focused);
        $help = #picked == null ? "Enter picks a player to swap: one of the eleven with one from the bench" : "Swap {#picked} with: move to the other player and press enter";
        tui::label($screen, $footer.line(0), "{$club.formation()}   Team rating {$club.rating()}", "dim");
        tui::label($screen, $footer.line(1), $help, #picked == null ? "dim" : "cyan");
    }

    pub fn handle($key) {
        #refresh();
        $name = term::name($key);
        if ($name == "a") {
            #picked = null;

            return BestEleven();
        }
        if ($name == "r") {
            $index = #table.selected_index();

            return $index == null ? null : Renew(#shown[$index]);
        }
        if ($name != "enter" && $name != "space") {
            #table.handle($key);

            return null;
        }
        $index = #table.selected_index();
        if ($index == null) {
            return null;
        }
        $player = #shown[$index];
        if (#picked == null) {
            #picked = $player;

            return null;
        }
        $first = #picked;
        #picked = null;

        // the same player again puts him down
        return $first == $player ? null : Swap($first, $player);
    }
}

/* A line of the fixture list: when it is, its cells, and whether it has been played */
kind FixtureLine {
    fn _(pub #when, pub #cells, pub #played);
}

/* The club's matches, played and to come */
pub kind FixturesView extends GameView {
    #table = tui::Table(["Date", "Home", "", "Away", "Score", "Res"], [], ($row, $index) -> match ($row[5]) {
        "W" => "green",
        "D" => "yellow",
        "L" => "red",
        default => $row[4] == "next ▸" ? "bold" : "",
    });

    pub fn title() { return "Fixtures"; }
    pub fn hints() { return [tui::Hint("j/k", "move")]; }

    pub fn draw($screen, $rect, $focused) {
        $club = #game.club;
        $lines = [];
        foreach (#game.league.fixtures_of($club) as $fixture) {
            $match = $fixture["match"];
            $result = "";
            $score = "-";
            if ($match != null) {
                [$mine, $theirs] = $fixture["home"] == $club ? [$match.home_goals, $match.away_goals] : [$match.away_goals, $match.home_goals];
                $result = $mine > $theirs ? "W" : ($mine == $theirs ? "D" : "L");
                $score = "{$match.home_goals} - {$match.away_goals}";
            }
            $lines[] = FixtureLine($fixture["date"] ?? $fixture["matchday"], [$fixture["date"] == null ? $fixture["matchday"] : date::short($fixture["date"]), to_string($fixture["home"]), "v", to_string($fixture["away"]), $score, $result], $match != null);
        }
        // The cup: the ties played, and the round the club is in next, whose draw isn't made yet
        foreach (#game.cup.fixtures_of($club) as $fixture) {
            $tie = $fixture["tie"];
            $day = $fixture["date"] == null ? "" : date::short($fixture["date"]);
            if ($tie == null) {
                $lines[] = FixtureLine($fixture["date"] ?? 999999, [$day, "The Cup: " .. $fixture["round"], "cup", "(draw to come)", "-", ""], false);
            } else {
                $match = $tie.match;
                $mine = $tie.winner() == $club;
                $lines[] = FixtureLine($fixture["date"] ?? 0, [$day, to_string($match.home), "cup", to_string($match.away), "{$match.home_goals} - {$match.away_goals}" .. ($tie.penalties != null ? " pens" : ($tie.extra_time ? " aet" : "")), $mine ? "W" : "L"], true);
            }
        }
        $lines = sort($lines, ($a, $b) -> $a.when <=> $b.when);
        $rows = [];
        $next = true;
        foreach ($lines as $line) {
            if (!$line.played && $next) {
                $line.cells[4] = "next ▸";
                $next = false;
            }
            $rows[] = $line.cells;
        }
        #table.set_rows($rows);
        #table.draw($screen, $rect, $focused);
    }

    pub fn handle($key) {
        #table.handle($key);
        return null;
    }
}

/*
 * The league table of the club's division, with the club's own row marked and the places that go
 * up green and the ones that go down red; d looks at the other division's.
 */
pub kind LeagueView extends GameView {
    #table;
    #other = false;
    /* How many clubs the division on show has, for where relegation begins */
    #size = 10;

    fn _($game) {
        ##_($game);
        $name = $game.club.name;
        #table = tui::Table(["Pos", "Club", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"], [], ($row, $index) -> match {
            $row[1] == $name => "bold cyan",
            #shown_level() == 0 && $row[0] == 1 => "green",
            #shown_level() == 0 && $row[0] > #size - 2 => "red",
            #shown_level() == 1 && $row[0] <= 2 => "green",
            default => "",
        }).drop_when_narrow([6, 7]);  // goals for and against: the difference stays
    }

    /* Which division is on show: 0 the top, 1 the second */
    fn shown_level() { return #other ? 1 - #game.level : #game.level; }

    pub fn title() { return (#other ? #game.other_division_name() : #game.division_name()) .. " table"; }
    pub fn hints() {
        return [tui::Hint("j/k", "move"), tui::Hint("d", "other division"), tui::Hint(". ,", "sort"), tui::Hint("o", "reverse"), tui::Hint("x", "unsorted")];
    }

    pub fn draw($screen, $rect, $focused) {
        $rows = [];
        foreach ((#other ? #game.other_league : #game.league).table() as $place => $standing) {
            $rows[] = [$place + 1, $standing.team.name, $standing.played, $standing.won, $standing.drawn, $standing.lost, $standing.scored, $standing.conceded, $standing.difference(), $standing.points()];
        }
        #size = len($rows);
        #table.set_rows($rows);
        #table.draw($screen, $rect, $focused);
    }

    pub fn handle($key) {
        if (term::name($key) == "d") {
            #other = !#other;

            return null;
        }
        #table.handle($key);
        return null;
    }
}

/* A section that isn't built yet */
pub kind PlaceholderView extends GameView {
    fn _($game, #heading, #text) {
        ##_($game);
    }

    pub fn title() { return #heading; }

    pub fn draw($screen, $rect, $focused) {
        tui::paragraph($screen, $rect, #text, "dim");
    }

    pub fn handle($key) { return null; }
}

/* A percentage with its sign: +12, -10, 0 */
fn signed($n) {
    return $n > 0 ? "+" .. $n : to_string($n);
}

/*
 * The club's money: the balance, what came in and went out this season, and every entry in the
 * books, newest first. Green in, red out.
 */
pub kind FinancesView extends GameView {
    #table = tui::Table(["MD", "Item", "Amount"], [], ($row, $index) -> starts_with($row[2], "-") ? "red" : "green");

    pub fn title() { return "Finances"; }
    pub fn hints() { return [tui::Hint("j/k", "move")]; }

    pub fn draw($screen, $rect, $focused) {
        $club = #game.club;
        $in = sum(map(filter(#game.ledger, $e -> $e["amount"] > 0), $e -> $e["amount"]));
        $out = -sum(map(filter(#game.ledger, $e -> $e["amount"] < 0), $e -> $e["amount"]));
        [$head, $body] = $rect.split_top(4);
        tui::label($screen, $head.line(0), "Balance  " .. money::pounds($club.balance), $club.balance < 0 ? "bold red" : "bold green");
        tui::label($screen, $head.line(1), "Income   " .. money::pounds($in), "green");
        tui::label($screen, $head.line(2), "Spending " .. money::pounds($out), "red");
        tui::label($screen, $head.line(3), "Wages a season " .. money::pounds(money::wages($club)) .. "   Transfers: press 7", "dim");
        #table.set_rows(map(reverse(#game.ledger), $e -> [$e["matchday"], $e["text"], ($e["amount"] > 0 ? "+" : "") .. money::pounds($e["amount"])]));
        #table.draw($screen, $body, $focused);
    }

    pub fn handle($key) {
        #table.handle($key);

        return null;
    }
}

/*
 * Buying and selling. The market lists every player at the other clubs with the price they ask;
 * t switches to your own squad, with what a club would pay. Enter buys or sells the player picked.
 */
pub kind TransfersView extends GameView {
    #market = tui::Table(["Name", "Pos", "Age", "Rating", "Club", "Contract", "Price"], []).drop_when_narrow([5, 2]);
    #squad = tui::Table(["Name", "Pos", "Age", "Rating", "Goals", "Fee"], []).drop_when_narrow([4, 2]);
    #selling = false;
    #shown = [];

    pub fn title() { return #selling ? "Transfers: sell" : "Transfers: buy"; }
    pub fn hints() {
        return [
            tui::Hint("j/k", "move"),
            tui::Hint("enter", #selling ? "sell" : "buy"),
            tui::Hint("t", #selling ? "buy instead" : "sell instead"),
            tui::Hint(". ,", "sort"),
        ];
    }

    fn refresh() {
        $club = #game.club;
        if (#selling) {
            #shown = $club.players;
            #squad.set_rows(map(#shown, $p -> [to_string($p), $p.position(), $p.age, $p.rating, $p.goals, money::pounds(money::sale_price($p))]));
        } else {
            #shown = map(#game.market(), $offer -> $offer[0]);
            #market.set_rows(map(#game.market(), $offer -> [to_string($offer[0]), $offer[0].position(), $offer[0].age, $offer[0].rating, to_string($offer[1]), date::year($offer[0].contract_until), money::pounds(#game.asking_price($offer[0]))]));
        }
    }

    pub fn draw($screen, $rect, $focused) {
        #refresh();
        [$body, $footer] = $rect.split_bottom(2);
        (#selling ? #squad : #market).draw($screen, $body, $focused);
        tui::label($screen, $footer, "Budget " .. money::pounds(#game.club.balance) .. "   Squad " .. len(#game.club.players) .. " of " .. Team::MAX_SQUAD, "bold");
    }

    pub fn handle($key) {
        #refresh();
        $name = term::name($key);
        if ($name == "t") {
            #selling = !#selling;
            #refresh();

            return null;
        }
        $table = #selling ? #squad : #market;
        if ($name != "enter") {
            $table.handle($key);

            return null;
        }
        $index = $table.selected_index();
        if ($index == null) {
            return null;
        }

        return #selling ? Sell(#shown[$index]) : Buy(#shown[$index]);
    }
}

/* One of the tactics: its name, what it is set to, and what that does */
kind Setting {
    fn _(pub #name, pub #value, pub #effect);
}

/*
 * How the club plays: the eleven as a picture in its formation, and three settings to move
 * between with j/k and change with h/l (or enter): the formation (which picks the best eleven for
 * it), how attacking the side is, and how hard it presses. What each does is said under it.
 */
pub kind TacticsView extends GameView {
    /* The rows the picture of the eleven takes: a line of the pitch every other row, then a gap */
    const PITCH_ROWS = 9;
    /* Each setting takes its row, the row under it for what it does, and a blank one */
    const ROWS_A_SETTING = 3;
    #row = 0;

    pub fn title() { return "Tactics"; }
    pub fn hints() { return [tui::Hint("j/k", "choose"), tui::Hint("h/l", "change")]; }

    /* Each setting; the percentages are Team's factors */
    fn settings() {
        $club = #game.club;
        $mentality = $club.mentality - 2;
        $intensity = $club.intensity - 1;

        return [
            Setting("Formation", $club.formation(), "Picks the best eleven who can play in it"),
            Setting("Mentality", $club.mentality_name(), "Attack " .. signed(12 * $mentality) .. "%, defence " .. signed(-10 * $mentality) .. "%: a side that attacks leaves gaps"),
            Setting("Intensity", $club.intensity_name(), "Attack " .. signed(5 * $intensity) .. "%, tiredness " .. signed(25 * $intensity) .. "%: pressing hard wears players out"),
        ];
    }

    pub fn draw($screen, $rect, $focused) {
        $club = #game.club;
        /* the eleven, a row a line of the pitch: forwards at the top */
        foreach (["FW", "MF", "DF", "GK"] as $i => $position) {
            $names = map(filter($club.eleven(), $p -> $p.position() == $position), $p -> $p.number .. " " .. $p);
            tui::label($screen, $rect.line($i * 2), join($names, "   "), match ($position) { "GK" => "yellow", "DF" => "blue", "MF" => "green", default => "red" }, "center");
        }
        $settings = $rect.without_top(#PITCH_ROWS);
        foreach (#settings() as $i => $setting) {
            $selected = $i == #row;
            $line = $settings.line($i * #ROWS_A_SETTING);
            tui::label($screen, $line, ($selected ? "▸ " : "  ") .. pad_right($setting.name, 10) .. "◂ " .. $setting.value .. " ▸", $selected && $focused ? "bold cyan" : ($selected ? "bold" : ""));
            $effect = $settings.line($i * #ROWS_A_SETTING + 1).without_left(2);
            tui::label($screen, $effect, $setting.effect, "dim");
        }
        if (#game.live != null) {
            tui::label($screen, $settings.line(len(#settings()) * #ROWS_A_SETTING), "The formation can't change during a match.", "dim");
        }
    }

    pub fn handle($key) {
        $club = #game.club;
        $name = term::name($key);
        $step = match ($name) {
            "h", "left" => -1,
            "l", "right", "enter", "space" => 1,
            default => 0,
        };
        if ($step == 0) {
            if ($name == "j" || $name == "down") {
                #row = min(#row + 1, 2);
            } else if ($name == "k" || $name == "up") {
                #row = max(#row - 1, 0);
            }

            return null;
        }
        if (#row == 0) {
            $formations = #game.formations();
            $at = 0;
            foreach ($formations as $i => $f) {
                if ($f == $club.formation()) {
                    $at = $i;
                }
            }

            return Formation($formations[($at + $step + len($formations)) % len($formations)]);
        }
        if (#row == 1) {
            return Mentality($club.mentality + $step);
        }

        return Intensity($club.intensity + $step);
    }
}

/* How a line of commentary is drawn: our goals and their goals, cards, and the whistle */
fn event_style($event, $club) {
    if (is_a($event, Goal)) {
        return $event.team == $club ? "bold green" : "bold red";
    }
    if (is_a($event, Booking)) {
        return $event.red ? "bold red" : "yellow";
    }
    if (is_a($event, Whistle)) {
        return "dim";
    }
    if (is_a($event, Injury)) {
        return "red";
    }
    if (is_a($event, Substitution)) {
        return "cyan";
    }

    return "";
}

/* A line of the commentary as drawn: its text, wrapped, and the style of its event */
kind CommentaryLine {
    fn _(pub #text, pub #style);
}

/*
 * The matchday being played, as it happens: the score and the clock, what is being said about
 * the club's match, the club's eleven with their goals and cards, and the other matches' scores.
 * Time passes when the shell calls step(); the view says how much, since it has the speed.
 */
pub kind MatchView extends GameView {
    /* Minutes played each time step() is called, at each speed */
    const SPEEDS = [1, 2, 5, 15];
    /* The rows of the head: the score, how the side plays, and a rule */
    const HEAD_ROWS = 3;
    /* The columns the state ("Paused", the speed) and the clock take at the head's ends */
    const STATE_WIDTH = 12;
    const CLOCK_WIDTH = 6;
    /* The rows the eleven and the other matches take below the commentary, at most, and the rows the commentary keeps */
    const PANEL_ROWS = 13;
    const COMMENTARY_ROWS = 5;
    #speed = 0;
    #paused = false;
    /* A substitution being made: null, or the player going off once chosen, and the players to choose from */
    #making = null;
    #off = null;
    #choice = null;

    pub fn title() { return "Match day"; }

    pub fn hints() {
        if (#making != null) {
            $question = #off == null ? "Who goes off?" : "Who comes on for {#off}?";
            return [tui::Hint::prompt($question), tui::Hint("j/k", "move"), tui::Hint("enter", "choose"), tui::Hint("escape", "cancel")];
        }
        if (#game.live.finished()) {
            return [tui::Hint("c", "continue")];
        }

        return [
            tui::Hint("space", "pause"),
            tui::Hint("+/-", "speed"),
            tui::Hint("s", "skip"),
            tui::Hint("w", "substitute"),
            tui::Hint("[ ]", "mentality"),
            tui::Hint("i", "intensity"),
        ];
    }

    /* Whether a substitution is being chosen, which stops the clock */
    pub fn choosing() { return #making != null; }

    /* Who the list on show offers: the eleven, then the substitutes who can come on */
    fn candidates() {
        return #off == null ? #game.club.eleven() : #game.club.substitutes(#off);
    }

    /* A new matchday: at the slowest speed, and not paused */
    pub fn reset() {
        #speed = 0;
        #paused = false;
        #making = null;
        #off = null;
    }

    /* Time passes: play the minutes the speed says, unless it is paused or over */
    pub fn step() {
        $day = #game.live;
        if ($day == null || #paused || #making != null) {
            return null;
        }
        for ($i = 0; $i < #SPEEDS[#speed] && !$day.finished(); $i++) {
            $day.tick();
        }
    }

    /* Take a key: an Action for the shell (EndMatchday when the matchday is over and it is time to
       go on, a Notice when a key can't be obeyed, a Substitute or a change of tactics), and null
       otherwise */
    pub fn handle($key) {
        $day = #game.live;
        if (#making != null) {
            return #choose($key);
        }
        match (term::name($key)) {
            "w" => {
                if ($day.finished()) {
                    return Notice("The match is over");
                }
                if (!#game.club.can_substitute()) {
                    return Notice("No substitutions left");
                }
                #making = true;
                #off = null;
                #list_candidates();
            }
            "[" => { return Mentality(#game.club.mentality - 1); }
            "]" => { return Mentality(#game.club.mentality + 1); }
            "i" => { return Intensity((#game.club.intensity + 1) % 3); }
            "space" => { #paused = !#paused; }
            "+", "=" => { #speed = min(#speed + 1, len(#SPEEDS) - 1); }
            "-" => { #speed = max(#speed - 1, 0); }
            "s" => {
                while (!$day.finished()) {
                    $day.tick();
                }
            }
            "c", "enter" => {
                if ($day.finished()) {
                    return EndMatchday();
                }

                return Notice("The match isn't over: s skips to the end");
            }
            default => {}
        }

        return null;
    }

    /* The players to choose from now, as a list to move in */
    fn list_candidates() {
        #choice = tui::List(map(#candidates(), $player -> $player.profile() .. ($player.status() == "" ? "" : "  " .. $player.status())));
        #choice.marked("▸ ", "  ");
    }

    /* A key while choosing a substitution: two lists in turn, who goes off and who comes on */
    fn choose($key) {
        if (term::name($key) == "escape") {
            #making = null;
            #off = null;

            return null;
        }
        if (term::name($key) == "enter" && #choice.selected_index() == null) {
            #making = null;
            #off = null;

            return Notice("There is nobody on the bench who can play");
        }
        if (#choice.handle($key) == tui::Outcome::Select) {
            return #choose_selected();
        }

        return null;
    }

    /* Enter on a player: going off, which asks who comes on, or coming on, which makes the change */
    fn choose_selected() {
        $chosen = #candidates()[#choice.selected_index()];
        if (#off == null) {
            if (#game.club.substitutes($chosen) == []) {
                return Notice("Nobody on the bench can come on for {$chosen}: they are hurt, banned or only goalkeepers");
            }
            #off = $chosen;
            #list_candidates();

            return null;
        }
        $off = #off;
        #making = null;
        #off = null;

        return Substitute($off, $chosen);
    }

    pub fn draw($screen, $rect, $focused) {
        $day = #game.live;
        $club = #game.club;
        $mine = $day.mine;
        if ($mine == null) {
            tui::label($screen, $rect, "{$club} doesn't play this matchday.", "dim");

            return null;
        }

        /* the score, in the middle, with what the game is doing on the left and the clock on the right */
        [$head, $rest] = $rect.split_top(#HEAD_ROWS);
        $state = $day.finished() ? "Full time" : (#making != null ? "Paused" : (#paused ? "Paused" : "▶ x" .. #SPEEDS[#speed]));
        tui::label($screen, $head.line(0), to_string($mine), "bold yellow", "center");
        tui::label($screen, $head.line(1), "{$club.mentality_name()}, {$club.intensity_name()} intensity", match ($club.mentality) { 0, 1 => "blue", 2 => "dim", default => "magenta" }, "center");
        $state_part = $head.line(0).split_left(#STATE_WIDTH)[0];
        tui::label($screen, $state_part, $state, $day.finished() ? "bold" : "dim");
        [, $clock] = $head.line(0).split_right(#CLOCK_WIDTH);
        tui::label($screen, $clock, $day.clock() .. "'", "bold", "right");
        $screen.fill($head.line(2), "─", "dim");

        /* the eleven and the other matches below, as much of them as fits, and the commentary above */
        [$commentary, $panels] = $rest.split_bottom(min(#PANEL_ROWS, max($rest.height - #COMMENTARY_ROWS, 0)));
        if (#making != null) {
            // choosing takes the whole of the space below the score
            #draw_choice($screen, $rest, $club);

            return null;
        }
        if (len($day.commentary) == 0) {
            tui::label($screen, $commentary, "The teams are out.", "dim");
        }
        foreach (#commentary_lines($day, $club, $commentary) as $i => $line) {
            tui::label($screen, $commentary.line($i), $line.text, $line.style);
        }
        if ($panels.height < 3) {
            return null;
        }
        $rows = map($club.eleven(), $player -> [$player.number, to_string($player), $player.position(), $player.match_goals, $player.sent_off ? "R" : ($player.hurt ? "+" : ($player.yellow_cards > 0 ? "Y" : ""))]);
        $headers = ["#", "Name", "Pos", "G", "C"];
        [$eleven, $others] = $panels.split_left(min(tui::table_width($headers, $rows) + 2, $panels.width));
        tui::table($screen, $eleven, $headers, $rows);
        if ($others.width > 4) {
            #draw_others($screen, $others, $day, $mine);
        }
    }

    /* The substitution being chosen: the question, then the players to choose from with the cursor on one */
    fn draw_choice($screen, $rect, $club) {
        tui::label($screen, $rect.line(0), #off == null ? "Substitution ({$club.substitutions} of 3 used): who goes off?" : "Who comes on for {#off}?", "bold cyan");
        #choice.draw($screen, $rect.without_top(1).without_left(2));
    }

    /* The commentary as drawn in $rect: newest first, each under its minute and wrapped to the pane, so a long line keeps its score */
    fn commentary_lines($day, $club, $rect) {
        $lines = [];
        foreach (reverse($day.commentary) as $event) {
            if (len($lines) >= $rect.height) {
                break;
            }
            foreach (tui::wrap($event.describe(), max($rect.width - 6, 10)) as $i => $part) {
                $lines[] = CommentaryLine(($i == 0 ? pad_left("{$event.minute}'", 4) .. "  " : "      ") .. $part, event_style($event, $club));
            }
        }

        return slice($lines, 0, $rect.height);
    }

    // The other matches of the matchday, in full where they fit and by the clubs' short names where not
    fn draw_others($screen, $rect, $day, $mine) {
        $inner = $rect.without_left(2);
        tui::label($screen, $inner.line(0), "Other matches", "bold");
        $others = filter($day.matches, $match -> $match != $mine);
        $fits = reduce($others, ($fits, $match) -> $fits && term::width(to_string($match)) <= $inner.width, true);
        $list = $inner.without_top(2);
        foreach (slice($others, 0, $list.height) as $i => $match) {
            tui::label($screen, $list.line($i), $fits ? to_string($match) : short_result($match));
        }
    }
}

// A club by the first word of its name, which no other club's shares ("Millbrook")
fn short_name($team) {
    return split(to_string($team), " ")[0];
}

// A result in a narrow space: "Millbrook 2-1 Sandgate"
fn short_result($match) {
    return short_name($match.home) .. " {$match.home_goals}-{$match.away_goals} " .. short_name($match.away);
}

/* ---- The shell --------------------------------------------------------------------------- */

/* A section of the shell: what the menu calls it, and the view that draws it */
pub kind Section {
    fn _(pub #name, pub #view);
}

/*
 * The whole screen. Keys: 1 to 7 (or the arrows in the menu) choose a section, tab moves between
 * the menu and the section, escape goes back to the menu, c moves time on to the next matchday
 * and q quits; the rest go to the section on show.
 */
pub kind Shell {
    /* The columns of the menu, and of the key to press at the bar's right end */
    const MENU_WIDTH = 16;
    const NEXT_WIDTH = 14;

    #current = 0;
    #where = "menu";
    #note = "";
    #keys_shown = false;

    fn _(#game, #sections, #match, #save_path = null);

    pub static fn for_game($game, $save_path = null) {
        return Shell($game, [
            Section("Inbox", InboxView($game)),
            Section("Squad", SquadView($game)),
            Section("Tactics", TacticsView($game)),
            Section("Fixtures", FixturesView($game)),
            Section("Table", LeagueView($game)),
            Section("Finances", FinancesView($game)),
            Section("Transfers", TransfersView($game)),
        ], MatchView($game), $save_path);
    }

    // The keys that work on every screen, and while a match is on
    fn keys_everywhere() {
        return [
            tui::Hint("1-7", "sections"),
            tui::Hint("tab", "menu or section"),
            tui::Hint("escape", "back to the menu"),
            tui::Hint("c", "continue"),
            tui::Hint("C", "play the match at once"),
            tui::Hint("S", "save"),
            tui::Hint("q", "quit"),
        ];
    }

    fn keys_in_a_match() {
        return [tui::Hint("ctrl+c", "quit")];
    }

    /* Which section is on show, by name, and whether keys go to the menu or the section */
    pub fn section() { return #sections[#current].name; }
    pub fn focus() { return #where; }
    pub fn notice() { return #note; }

    /* The view keys go to: the matchday being played, or the section on show */
    fn current_view() {
        return #game.live != null ? #match : #sections[#current].view;
    }

    pub fn draw($screen) {
        [$top, $rest] = $screen.bounds().split_top(1);
        [$rest, $bottom] = $rest.split_bottom(1);
        [$menu, $content] = $rest.split_left(min(#MENU_WIDTH, $rest.width));
        $live = #game.live != null;

        #draw_bar($screen, $top, $live);

        /* a matchday being played takes over the section, and the menu waits */
        $in_menu = #where == "menu" && !$live;
        tui::box($screen, $menu, "", $in_menu ? "cyan" : "");
        $inside = $menu.inset(1);
        foreach (#sections as $i => $section) {
            $shown = $i == #current && !$live;
            tui::label($screen, $inside.line($i), " " .. ($i + 1) .. " " .. $section.name, $live ? "dim" : ($shown ? ($in_menu ? "inverse" : "bold") : ""));
        }
        $below = $inside.without_top(len(#sections) + 1);
        #draw_board($screen, $below);

        $view = #current_view();
        tui::box($screen, $content, $view.title(), $in_menu ? "" : "cyan");
        $view.draw($screen, $content.inset(1), !$in_menu);

        #draw_bottom($screen, $bottom, $view);
        if (#keys_shown) {
            #draw_keys($screen, $view);
        }
    }

    /* The bar: the club on the left, where the season is in the middle, the key to press on the right */
    fn draw_bar($screen, $rect, $live) {
        $screen.fill($rect, " ", "inverse");
        [$club, $rest] = $rect.split_left(term::width(#game.club.name) + 2);
        [$rest, $next] = $rest.split_right(#NEXT_WIDTH);
        $status = $rest.without_left(1);
        tui::label($screen, $club, " " .. #game.club.name, "bold inverse");
        tui::label($screen, $status, #status(), "inverse", "center");
        $key = match {
            $live && !#game.live.finished() => "s Skip ▸ ",
            #game.sacked() => "q Quit ▸ ",
            default => "c Continue ▸ ",
        };
        tui::label($screen, $next, $key, "bold inverse", "right");
    }

    /* The board, under the menu: how much it trusts the manager, as a bar and a word, and what it wants */
    fn draw_board($screen, $rect) {
        if ($rect.height < 5 || $rect.width < 6) {
            return null;
        }
        $board = #game.board;
        $style = match {
            #game.sacked() => "red",
            $board.confidence > 55 => "green",
            $board.confidence > 25 => "yellow",
            default => "red",
        };
        $inner = $rect.inset(1, 0);
        tui::label($screen, $inner.line(0), "Board", "bold");
        tui::progress($screen, $inner.line(1), $board.confidence / 100, $style);
        tui::label($screen, $inner.line(2), #game.sacked() ? "Sacked" : $board.mood(), $style);
        tui::label($screen, $inner.line(3), "Aim", "dim");
        tui::label($screen, $inner.line(4), $board.aim);
    }

    /* Where the season is: the date, the matchday or the cup's round, and the club's place once there is one */
    fn status() {
        $league = #game.league;
        $played = $league.matchdays_played() + (#game.live != null && $league.matchdays_left() > 0 ? 1 : 0);
        if ($played == 0 && #game.cup_label() == null) {
            return #game.date_label() .. " · Pre-season · " .. #game.division_name();
        }
        $stage = #game.cup_label() ?? "Matchday " .. min($played, $league.matchdays()) .. " of " .. $league.matchdays();
        return #game.date_label() .. " · " .. $stage .. " · " .. #game.place() .. " in the " .. #game.division_name();
    }

    /* The line at the bottom: a notice, or the section's keys as many as fit, and ? for the rest */
    fn draw_bottom($screen, $rect, $view) {
        $line = $rect.inset(1, 0);
        if (#note != "") {
            tui::label($screen, $line, #note, "bold yellow");
            return null;
        }
        tui::hints($screen, $line, $view.hints(), "? keys");
    }

    /* Every key there is on this screen, in a box over it, until the next key */
    fn draw_keys($screen, $view) {
        tui::key_help($screen, {$view.title() => $view.hints(), "Everywhere" => #game.live != null ? #keys_in_a_match() : #keys_everywhere()});
    }

    /* Time passes, while nobody is pressing keys: a matchday being played moves on, unless the keys are being read */
    pub fn tick() {
        if (#game.live != null && !#keys_shown) {
            #match.step();
        }

        return null;
    }

    /* Take a key: "quit" when it is time to leave, and null otherwise */
    pub fn handle($key) {
        $name = term::name($key);
        #note = "";
        if (in_array($name, ["ctrl+c", "eof"])) {
            return "quit";
        }
        if (#keys_shown || $name == "?") {
            // the list of keys closes at the next key, which does nothing else
            #keys_shown = !#keys_shown;
            return null;
        }
        if (#game.live != null) {
            if ($name == "q") {
                #note = "Finish the match first: s skips to the end";
                return null;
            }
            #carry_out(#match.handle($key));
            if (#game.live == null) {
                // the matchday ended: the inbox is where its news is
                #current = 0;
            }

            return null;
        }
        if ($name == "q") {
            return "quit";
        }
        if (($name == "c" || $name == "C") && #game.sacked()) {
            #note = "You have been sacked: q quits, and a saved game can be loaded";
            return null;
        }
        if ($name == "c" || $name == "C") {
            // Time goes on a day at a time until something needs the manager: their match, which C plays at once
            #game.play_on($name == "c");
            if (#game.live != null) {
                #match.reset();
            } else {
                // The inbox says what stopped the clock
                #current = 0;
                #note = "Time has moved on to " .. #game.date_label();
            }
            return null;
        }
        if ($name == "S") {
            if (#save_path == null) {
                #note = "There is nowhere to save to";
            } else {
                $problem = #game.save(#save_path);
                #note = $problem == "" ? "Saved to {#save_path}" : $problem;
            }

            return null;
        }
        if ($name == "tab") {
            #where = #where == "menu" ? "content" : "menu";
            return null;
        }
        $number = to_int($name, null);
        if ($number != null && $number >= 1 && $number <= len(#sections)) {
            #current = $number - 1;
            return null;
        }
        if (#where == "menu") {
            match ($name) {
                "up", "k" => { #current = max(#current - 1, 0); }
                "down", "j" => { #current = min(#current + 1, len(#sections) - 1); }
                "enter", "right", "l" => { #where = "content"; }
                default => {}
            }
            return null;
        }
        if ($name == "escape") {
            #where = "menu";
            return null;
        }
        #carry_out(#sections[#current].view.handle($key));
        return null;
    }

    /* What a section asked for, or nothing: the game changes here, through the action, and the note says what happened */
    fn carry_out($action) {
        if ($action != null) {
            #note = $action.carry_out(#game);
        }
    }
}
