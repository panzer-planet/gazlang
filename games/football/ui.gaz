/*
 * The interface: a Shell (a top bar, a menu of sections down the left, the section on show, and a
 * line of hints at the bottom) and a View for each section. A view is given a Rect of the screen
 * and draws in it; the shell cuts the screen up and decides where keys go. Like Football Manager
 * the game is mostly tables you move about in, and time moves on with one key: c.
 *
 * Views only read the game (game.gaz) and never change it: the shell does that, so what a key
 * does is in one place. Nothing here talks to the terminal, so it is all tested by drawing into
 * a tui::Screen and reading its lines.
 */
namespace ui;

include "../../lib/term.gaz";
include "../../lib/tui.gaz";
include "../../lib/format.gaz" use pad_left;
include "engine/matches.gaz" use Goal, Booking, Whistle, Injury, Substitution;

/* $text cut into lines no wider than $width, on the spaces, keeping its own line breaks */
fn wrap($text, $width) {
    $lines = [];
    foreach (split($text, "\n") as $paragraph) {
        $line = "";
        foreach (split($paragraph, " ") as $word) {
            if ($line == "") {
                $line = $word;
            } else if (term::width($line) + 1 + term::width($word) <= $width) {
                $line ..= " " .. $word;
            } else {
                $lines[] = $line;
                $line = $word;
            }
        }
        $lines[] = $line;
    }
    return $lines;
}

/* What the shell needs of a section */
pub abstract kind View {
    fn _(kin #game);

    pub abstract fn title();

    /* Draw in $rect; $focused is whether keys are going to this view */
    pub abstract fn draw($screen, $rect, $focused);

    /* Take a key that reached the view. It changes nothing in the game: it gives null, or an action
       for the shell to carry out (["swap", $a, $b], ["auto"]). */
    pub abstract fn handle($key);

    /* What the keys of this view do, for the line at the bottom */
    pub fn hints() { return ""; }
}

/* Messages, the newest first: a list above and the one selected in full below */
pub kind InboxView extends View {
    #table = tui::Table(["MD", "Subject"], []);

    pub fn title() { return "Inbox"; }
    pub fn hints() { return "j/k move"; }

    pub fn draw($screen, $rect, $focused) {
        $messages = reverse(#game.inbox);
        #table.set_rows(map($messages, $message -> [$message["matchday"], $message["subject"]]));
        [$list, $rest] = $rect.split_top(max(min(len($messages), 8) + 1, 2));
        #table.draw($screen, $list, $focused);
        $index = #table.selected_index();
        if ($index == null || $rest.height < 3) {
            return null;
        }
        $message = $messages[$index];
        tui::box($screen, $rest.col, $rest.row, $rest.width, $rest.height, $message["subject"]);
        $inside = $rest.inset(1);
        foreach (slice(wrap($message["body"], $inside.width), 0, $inside.height) as $i => $line) {
            $screen.put($inside.col, $inside.row + $i, $line);
        }
    }

    pub fn handle($key) {
        #table.handle($key);
        return null;
    }
}

/*
 * The club's players, and where the manager picks the eleven: the eleven first, then the bench,
 * each with its role and whether it can play. Enter picks a player and enter on another swaps
 * them (one from the eleven with one from the bench), and a picks the best eleven.
 */
pub kind SquadView extends View {
    #table = tui::Table(["#", "Name", "Pos", "Age", "Rating", "Goals", "Role", "Status"], [], ($row, $index) -> match {
        starts_with($row[1], "▸") => "bold cyan",
        $row[7] != "" => "red",
        $row[6] == "sub" => "dim",
        default => "",
    });
    /* The players in the order the table has them, so a row is a player, and who is picked up */
    #shown = [];
    #picked = null;

    pub fn title() { return "Squad"; }
    pub fn hints() { return "j/k move  enter pick, then enter to swap  a best eleven  . , sort"; }

    /* Put the game's squad in the table, the eleven first: done for a key as well as for a frame, so
       what a key means never depends on whether a frame came first */
    fn refresh() {
        $club = #game.club;
        $eleven = $club.eleven();
        #shown = [...$eleven, ...$club.bench()];
        #table.set_rows(map(#shown, $player -> [$player.number, (#picked == $player ? "▸ " : "") .. to_string($player), $player.position(), $player.age, $player.rating, $player.goals, in_array($player, $eleven) ? "XI" : "sub", $player.status()]));
    }

    pub fn draw($screen, $rect, $focused) {
        $club = #game.club;
        #refresh();
        [$body, $footer] = $rect.split_bottom(2);
        #table.draw($screen, $body, $focused);
        $help = #picked == null ? "Enter picks a player to swap: one of the eleven with one from the bench" : "Swap {#picked} with: move to the other player and press enter";
        tui::label($screen, $footer.col, $footer.row, $footer.width, "{$club.formation()}   Team rating {$club.rating()}", "dim");
        tui::label($screen, $footer.col, $footer.row + 1, $footer.width, $help, #picked == null ? "dim" : "cyan");
    }

    pub fn handle($key) {
        #refresh();
        $name = term::name($key);
        if ($name == "a") {
            #picked = null;

            return ["auto"];
        }
        if ($name != "enter" && $name != "space") {
            #table.handle($key);

            return null;
        }
        $index = #table.selected_index();
        if ($index == null) {
            return null;
        }
        $player = #shown[$index];
        if (#picked == null) {
            #picked = $player;

            return null;
        }
        $first = #picked;
        #picked = null;

        // the same player again puts him down
        return $first == $player ? null : ["swap", $first, $player];
    }
}

/* The club's matches, played and to come */
pub kind FixturesView extends View {
    #table = tui::Table(["MD", "Home", "", "Away", "Score", "Res"], [], ($row, $index) -> match ($row[5]) {
        "W" => "green",
        "D" => "yellow",
        "L" => "red",
        default => $row[4] == "next ▸" ? "bold" : "",
    });

    pub fn title() { return "Fixtures"; }
    pub fn hints() { return "j/k move"; }

    pub fn draw($screen, $rect, $focused) {
        $club = #game.club;
        $rows = [];
        $next = true;
        foreach (#game.league.fixtures_of($club) as $fixture) {
            $match = $fixture["match"];
            $result = "";
            $score = "-";
            if ($match != null) {
                [$mine, $theirs] = $fixture["home"] == $club ? [$match.home_goals, $match.away_goals] : [$match.away_goals, $match.home_goals];
                $result = $mine > $theirs ? "W" : ($mine == $theirs ? "D" : "L");
                $score = "{$match.home_goals} - {$match.away_goals}";
            } else if ($next) {
                $score = "next ▸";
                $next = false;
            }
            $rows[] = [$fixture["matchday"], to_string($fixture["home"]), "v", to_string($fixture["away"]), $score, $result];
        }
        #table.set_rows($rows);
        #table.draw($screen, $rect, $focused);
    }

    pub fn handle($key) {
        #table.handle($key);
        return null;
    }
}

/* The league table, with the club's own row marked */
pub kind LeagueView extends View {
    #table;

    fn _($game) {
        ##_($game);
        $name = $game.club.name;
        #table = tui::Table(["Pos", "Club", "P", "W", "D", "L", "GF", "GA", "GD", "Pts"], [], ($row, $index) -> $row[1] == $name ? "cyan" : "");
    }

    pub fn title() { return "League table"; }
    pub fn hints() { return "j/k move  . , sort  o reverse  x reset"; }

    pub fn draw($screen, $rect, $focused) {
        $rows = [];
        foreach (#game.league.table() as $place => $standing) {
            $rows[] = [$place + 1, $standing.team.name, $standing.played, $standing.won, $standing.drawn, $standing.lost, $standing.scored, $standing.conceded, $standing.difference(), $standing.points()];
        }
        #table.set_rows($rows);
        #table.draw($screen, $rect, $focused);
    }

    pub fn handle($key) {
        #table.handle($key);
        return null;
    }
}

/* A section that isn't built yet */
pub kind PlaceholderView extends View {
    fn _($game, #heading, #text) {
        ##_($game);
    }

    pub fn title() { return #heading; }

    pub fn draw($screen, $rect, $focused) {
        foreach (slice(wrap(#text, $rect.width), 0, $rect.height) as $i => $line) {
            $screen.put($rect.col, $rect.row + $i, $line, "dim");
        }
    }

    pub fn handle($key) { return null; }
}

/* How a line of commentary is drawn: our goals and their goals, cards, and the whistle */
fn event_style($event, $club) {
    if (is_a($event, Goal)) {
        return $event.team == $club ? "bold green" : "bold red";
    }
    if (is_a($event, Booking)) {
        return $event.red ? "bold red" : "yellow";
    }
    if (is_a($event, Whistle)) {
        return "dim";
    }
    if (is_a($event, Injury)) {
        return "red";
    }
    if (is_a($event, Substitution)) {
        return "cyan";
    }

    return "";
}

/*
 * The matchday being played, as it happens: the score and the clock, what is being said about
 * the club's match, the club's eleven with their goals and cards, and the other matches' scores.
 * Time passes when the shell calls step(); the view says how much, since it has the speed.
 */
pub kind MatchView extends View {
    /* Minutes played each time step() is called, at each speed */
    const SPEEDS = [1, 2, 5, 15];
    #speed = 0;
    #paused = false;

    pub fn title() { return "Match day"; }

    pub fn hints() {
        return #game.live.finished() ? "c continue" : "space pause  +/- speed  s skip to the end";
    }

    /* A new matchday: at the slowest speed, and not paused */
    pub fn reset() {
        #speed = 0;
        #paused = false;
    }

    /* Time passes: play the minutes the speed says, unless it is paused or over */
    pub fn step() {
        $day = #game.live;
        if ($day == null || #paused) {
            return null;
        }
        for ($i = 0; $i < #SPEEDS[#speed] && !$day.finished(); $i++) {
            $day.tick();
        }
    }

    /* Take a key: "end" when the matchday is over and it is time to go on, a message to show
       when a key can't be obeyed, and null otherwise */
    pub fn handle($key) {
        $day = #game.live;
        match (term::name($key)) {
            "space" => { #paused = !#paused; }
            "+", "=" => { #speed = min(#speed + 1, len(#SPEEDS) - 1); }
            "-" => { #speed = max(#speed - 1, 0); }
            "s" => {
                while (!$day.finished()) {
                    $day.tick();
                }
            }
            "c", "enter" => {
                if ($day.finished()) {
                    return "end";
                }

                return "The match isn't over: s skips to the end";
            }
            default => {}
        }

        return null;
    }

    pub fn draw($screen, $rect, $focused) {
        $day = #game.live;
        $club = #game.club;
        $mine = $day.mine;
        if ($mine == null) {
            $screen.put($rect.col, $rect.row, "{$club} doesn't play this matchday.", "dim");

            return null;
        }

        /* the score, in the middle, with what the game is doing on the left and the clock on the right */
        [$head, $rest] = $rect.split_top(2);
        $state = $day.finished() ? "Full time" : (#paused ? "Paused" : "▶ x" .. #SPEEDS[#speed]);
        tui::label($screen, $head.col, $head.row, $head.width, to_string($mine), "bold", "center");
        tui::label($screen, $head.col, $head.row, min(12, $head.width), $state, $day.finished() ? "bold" : "dim");
        tui::label($screen, $head.col + max($head.width - 6, 0), $head.row, min(6, $head.width), $day.clock() .. "'", "bold", "right");
        $screen.put($head.col, $head.row + 1, repeat("─", $head.width), "dim");

        /* the eleven and the other matches below, as much of them as fits, and the commentary above */
        [$commentary, $panels] = $rest.split_bottom(min(13, max($rest.height - 5, 0)));
        if (len($day.commentary) == 0) {
            $screen.put($commentary.col, $commentary.row, "The teams are out.", "dim");
        }
        /* newest first, each under its minute and wrapped to the pane, so a long line keeps its score */
        $lines = [];
        foreach (reverse($day.commentary) as $event) {
            if (len($lines) >= $commentary.height) {
                break;
            }
            foreach (wrap($event.describe(), max($commentary.width - 6, 10)) as $i => $part) {
                $lines[] = [($i == 0 ? pad_left("{$event.minute}'", 4) .. "  " : "      ") .. $part, event_style($event, $club)];
            }
        }
        foreach (slice($lines, 0, $commentary.height) as $i => [$text, $style]) {
            tui::label($screen, $commentary.col, $commentary.row + $i, $commentary.width, $text, $style);
        }
        if ($panels.height < 3) {
            return null;
        }
        [$eleven, $others] = $panels.split_left(min(44, $panels.width));
        $rows = map($club.eleven(), $player -> [$player.number, to_string($player), $player.position(), $player.match_goals, $player.sent_off ? "R" : ($player.hurt ? "+" : ($player.yellow_cards > 0 ? "Y" : ""))]);
        tui::table($screen, $eleven.col, $eleven.row, ["#", "Name", "Pos", "G", "C"], slice($rows, 0, max($eleven.height - 2, 0)));
        if ($others.width > 4) {
            tui::label($screen, $others.col + 2, $others.row, $others.width - 2, "Other matches", "bold");
            $line = 0;
            foreach ($day.matches as $match) {
                if ($match != $mine && $line < $others.height - 2) {
                    tui::label($screen, $others.col + 2, $others.row + 2 + $line, $others.width - 2, to_string($match));
                    $line++;
                }
            }
        }
    }
}

/*
 * The whole screen. Keys: 1 to 6 (or the arrows in the menu) choose a section, tab moves between
 * the menu and the section, escape goes back to the menu, c moves time on to the next matchday
 * and q quits; the rest go to the section on show.
 */
pub kind Shell {
    #current = 0;
    #where = "menu";
    #note = "";

    fn _(#game, #sections, #match);

    pub static fn for_game($game) {
        return Shell($game, [
            ["Inbox", InboxView($game)],
            ["Squad", SquadView($game)],
            ["Tactics", PlaceholderView($game, "Tactics", "Formation, mentality and the instructions each player plays to come with the match day.")],
            ["Fixtures", FixturesView($game)],
            ["Table", LeagueView($game)],
            ["Finances", PlaceholderView($game, "Finances", "The books: wages, income and the transfer budget.")],
        ], MatchView($game));
    }

    /* Which section is on show, by name, and whether keys go to the menu or the section */
    pub fn section() { return #sections[#current][0]; }
    pub fn focus() { return #where; }
    pub fn notice() { return #note; }

    pub fn draw($screen) {
        [$top, $rest] = $screen.bounds().split_top(1);
        [$rest, $bottom] = $rest.split_bottom(1);
        [$menu, $content] = $rest.split_left(min(16, $rest.width));
        $league = #game.league;
        $live = #game.live != null;

        /* the bar: the club on the left, where the season is in the middle, the key to press on the right */
        $screen.fill($top.col, $top.row, $top.width, 1, " ", "inverse");
        tui::label($screen, $top.col, $top.row, $top.width, #game.season_label() .. "  ·  Matchday " .. ($league.matchdays_played() + ($live ? 1 : 0)) .. " of " .. $league.matchdays() .. "  ·  " .. #game.place(), "inverse", "center");
        tui::label($screen, $top.col, $top.row, term::width(#game.club.name) + 2, " " .. #game.club.name, "bold inverse");
        tui::label($screen, $top.col + $top.width - 14, $top.row, 14, $live && !#game.live.finished() ? "s Skip ▸ " : "c Continue ▸ ", "bold inverse", "right");

        /* a matchday being played takes over the section, and the menu waits */
        $in_menu = #where == "menu" && !$live;
        tui::box($screen, $menu.col, $menu.row, $menu.width, $menu.height, "", $in_menu ? "cyan" : "");
        $inside = $menu.inset(1);
        foreach (#sections as $i => [$title, $view]) {
            $shown = $i == #current && !$live;
            tui::label($screen, $inside.col, $inside.row + $i, $inside.width, " " .. ($i + 1) .. " " .. $title, $live ? "dim" : ($shown ? ($in_menu ? "inverse" : "bold") : ""));
        }

        $view = $live ? #match : #sections[#current][1];
        tui::box($screen, $content.col, $content.row, $content.width, $content.height, $view.title(), $in_menu ? "" : "cyan");
        $view.draw($screen, $content.inset(1), !$in_menu);

        $hints = $view.hints();
        $keys = $live ? "ctrl+c quit" : "1-6 sections  tab focus  c continue  C quick  q quit";
        tui::label($screen, $bottom.col + 1, $bottom.row, max($bottom.width - 2, 0), #note != "" ? #note : ($hints == "" ? $keys : $hints .. "   " .. $keys), #note != "" ? "bold yellow" : "dim");
    }

    /* Time passes, while nobody is pressing keys: a matchday being played moves on */
    pub fn tick() {
        if (#game.live != null) {
            #match.step();
        }

        return null;
    }

    /* Take a key: "quit" when it is time to leave, and null otherwise */
    pub fn handle($key) {
        $name = term::name($key);
        #note = "";
        if (in_array($name, ["ctrl+c", "eof"])) {
            return "quit";
        }
        if (#game.live != null) {
            if ($name == "q") {
                #note = "Finish the match first: s skips to the end";
                return null;
            }
            $result = #match.handle($key);
            if ($result == "end") {
                #game.end_matchday();
                // the inbox is where a matchday's news is
                #current = 0;
            } else if ($result != null) {
                #note = $result;
            }

            return null;
        }
        if ($name == "q") {
            return "quit";
        }
        if ($name == "c" || $name == "C") {
            if (#game.season_over()) {
                #note = "The season is over.";
            } else if ($name == "c") {
                #game.begin_matchday();
                #match.reset();
            } else {
                #game.advance();
                #current = 0;
            }
            return null;
        }
        if ($name == "tab") {
            #where = #where == "menu" ? "content" : "menu";
            return null;
        }
        $number = to_int($name, null);
        if ($number != null && $number >= 1 && $number <= len(#sections)) {
            #current = $number - 1;
            return null;
        }
        if (#where == "menu") {
            match ($name) {
                "up", "k" => { #current = max(#current - 1, 0); }
                "down", "j" => { #current = min(#current + 1, len(#sections) - 1); }
                "enter", "right", "l" => { #where = "content"; }
                default => {}
            }
            return null;
        }
        if ($name == "escape") {
            #where = "menu";
            return null;
        }
        $action = #sections[#current][1].handle($key);
        if ($action != null) {
            #carry_out($action);
        }
        return null;
    }

    /* What a section asked for: the game changes here, in one place */
    fn carry_out($action) {
        if ($action[0] == "swap") {
            $problem = #game.swap($action[1], $action[2]);
            #note = $problem == "" ? "Lineup changed" : $problem;
        } else if ($action[0] == "auto") {
            #game.auto_lineup();
            #note = "The best eleven, picked";
        }
    }
}
