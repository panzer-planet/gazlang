// Every operator and punctuation token, including longest-match cases
=== == = => !== != ! < <= > >= && || + - * / % ; , ( ) { } [ ]
$a===$b==$c=>$d!==$e!=!$f<=$g>=$h
1-2/3*4+5%6
$i++ ++$i $i-- --$i $a += 1 $a -= 1 $a *= 2 $a /= 2 $a %= 3 $a+++$b $a---$b 1 - -1
$a ?? $b ?? "c" $x["k"]??1
$a ??= 1 $b["k"]??=[] ?? = ??==
"a" .. "b" $s ..= "c" 1..2 1.5..2 ..= .. = ..==
$a ? 1 : 2 ?:?? ???
$x -> $x $a-->$b ->- - > ->->
$a <=> $b <= > <=>= <=>
& | ^ ~ && || &= |= ^= << >> <<= >>= &&= ||= <<== >>== ~= <<<
$a&$b|$c^~$d $a&&&$b $a|||$b $flags &= 1 $flags <<= 2 $x>>1 $y<<2 $a<<=$b>>=$c
// ... is one token, and the longest match wins: ..... is ... then ..
[...$a, ...[1]];
$a.....$b;
