2 VAR_IDENTIFIER $name
2 ASSIGN =
2 STRING "Gaz"
2 SEMICOLON ;
3 ECHO echo
3 STRING_START "Hi "
3 VAR_IDENTIFIER $name
3 STRING_MIDDLE "! "
3 VAR_IDENTIFIER $name
3 STRING_MIDDLE "_2 "
3 VAR_IDENTIFIER $name_2
3 STRING_END ""
3 SEMICOLON ;
4 ECHO echo
4 STRING_START ""
4 GLOBAL_VAR_IDENTIFIER @count
4 PLUS +
4 INTEGER 1
4 STRING_MIDDLE " "
4 VAR_IDENTIFIER $items
4 LEFT_BRACKET [
4 IDENTIFIER len
4 LEFT_PAREN (
4 VAR_IDENTIFIER $items
4 RIGHT_PAREN )
4 MINUS -
4 INTEGER 1
4 RIGHT_BRACKET ]
4 STRING_MIDDLE " "
4 VAR_IDENTIFIER $user
4 LEFT_BRACKET [
4 STRING "tags"
4 RIGHT_BRACKET ]
4 LEFT_BRACKET [
4 INTEGER 0
4 RIGHT_BRACKET ]
4 STRING_END ""
4 SEMICOLON ;
5 ECHO echo
5 STRING_START "nested "
5 VAR_IDENTIFIER $m
5 LEFT_BRACKET [
5 STRING_START "k "
5 VAR_IDENTIFIER $name
5 STRING_END " z"
5 RIGHT_BRACKET ]
5 STRING_END " done"
5 PLUS +
5 STRING_START ""
5 VAR_IDENTIFIER $name
5 STRING_MIDDLE ""
5 VAR_IDENTIFIER $name
5 STRING_MIDDLE ""
5 VAR_IDENTIFIER $name
5 STRING_END ""
5 SEMICOLON ;
6 ECHO echo
6 STRING_START "costs $5, me@example.com { "
6 VAR_IDENTIFIER $name
6 STRING_MIDDLE "} {} $ \$name {"
6 VAR_IDENTIFIER $name
6 STRING_END "} \{\$name}"
6 SEMICOLON ;
7 ECHO echo
7 STRING_START "multi\nline "
8 VAR_IDENTIFIER $name
8 STRING_MIDDLE "\n"
9 VAR_IDENTIFIER $name
10 STRING_END " end"
10 SEMICOLON ;
11 ECHO echo
11 STRING "\$name \{\$name} stays raw"
11 SEMICOLON ;
12 ECHO echo
12 STRING_START ""
12 VAR_IDENTIFIER $a
12 LEFT_BRACKET [
12 INTEGER 0
12 RIGHT_BRACKET ]
12 STRING_MIDDLE " "
12 VAR_IDENTIFIER $a
12 LEFT_BRACKET [
12 INTEGER -12
12 RIGHT_BRACKET ]
12 STRING_MIDDLE " "
12 VAR_IDENTIFIER $a
12 LEFT_BRACKET [
12 STRING "key_1"
12 RIGHT_BRACKET ]
12 STRING_MIDDLE " "
12 VAR_IDENTIFIER $a
12 LEFT_BRACKET [
12 VAR_IDENTIFIER $i
12 RIGHT_BRACKET ]
12 STRING_MIDDLE " "
12 VAR_IDENTIFIER $a
12 LEFT_BRACKET [
12 STRING "01"
12 RIGHT_BRACKET ]
12 STRING_MIDDLE " "
12 VAR_IDENTIFIER $a
12 LEFT_BRACKET [
12 STRING "-0"
12 RIGHT_BRACKET ]
12 STRING_MIDDLE " "
12 VAR_IDENTIFIER $a
12 LEFT_BRACKET [
12 INTEGER 0
12 RIGHT_BRACKET ]
12 STRING_END "[1]"
12 SEMICOLON ;
13 EOF
