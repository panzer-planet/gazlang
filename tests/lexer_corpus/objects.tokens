2 ABSTRACT abstract
2 CLASS class
2 IDENTIFIER Shape
2 LEFT_BRACE {
3 HASH_IDENTIFIER #name
3 SEMICOLON ;
4 HASH_IDENTIFIER #history
4 ASSIGN =
4 LEFT_BRACKET [
4 RIGHT_BRACKET ]
4 SEMICOLON ;
5 FN fn
5 IDENTIFIER _
5 LEFT_PAREN (
5 VAR_IDENTIFIER $name
5 RIGHT_PAREN )
5 LEFT_BRACE {
5 HASH_IDENTIFIER #name
5 ASSIGN =
5 VAR_IDENTIFIER $name
5 SEMICOLON ;
5 RIGHT_BRACE }
6 ABSTRACT abstract
6 FN fn
6 IDENTIFIER area
6 LEFT_PAREN (
6 RIGHT_PAREN )
6 SEMICOLON ;
7 FN fn
7 IDENTIFIER to_string
7 LEFT_PAREN (
7 RIGHT_PAREN )
7 LEFT_BRACE {
7 RETURN return
7 STRING_START ""
7 HASH_IDENTIFIER #name
7 STRING_MIDDLE " with area "
7 HASH_IDENTIFIER #area
7 LEFT_PAREN (
7 RIGHT_PAREN )
7 STRING_END ""
7 SEMICOLON ;
7 RIGHT_BRACE }
8 RIGHT_BRACE }
10 CLASS class
10 IDENTIFIER Circle
10 EXTENDS extends
10 IDENTIFIER Shape
10 LEFT_BRACE {
11 HASH_IDENTIFIER #radius
11 SEMICOLON ;
12 FN fn
12 IDENTIFIER _
12 LEFT_PAREN (
12 VAR_IDENTIFIER $radius
12 RIGHT_PAREN )
12 LEFT_BRACE {
12 PARENT_IDENTIFIER ##_
12 LEFT_PAREN (
12 STRING "circle"
12 RIGHT_PAREN )
12 SEMICOLON ;
12 HASH_IDENTIFIER #radius
12 ASSIGN =
12 VAR_IDENTIFIER $radius
12 SEMICOLON ;
12 RIGHT_BRACE }
13 FN fn
13 IDENTIFIER area
13 LEFT_PAREN (
13 RIGHT_PAREN )
13 LEFT_BRACE {
13 RETURN return
13 FLOAT 3.14159
13 MULTIPLY *
13 HASH_IDENTIFIER #radius
13 MULTIPLY *
13 HASH_IDENTIFIER #radius
13 SEMICOLON ;
13 RIGHT_BRACE }
14 FN fn
14 IDENTIFIER to_string
14 LEFT_PAREN (
14 RIGHT_PAREN )
14 LEFT_BRACE {
14 RETURN return
14 PARENT_IDENTIFIER ##to_string
14 LEFT_PAREN (
14 RIGHT_PAREN )
14 CONCAT ..
14 STRING_START " (r = "
14 HASH_IDENTIFIER #radius
14 STRING_END ")"
14 SEMICOLON ;
14 RIGHT_BRACE }
15 FN fn
15 IDENTIFIER self
15 LEFT_PAREN (
15 RIGHT_PAREN )
15 LEFT_BRACE {
15 RETURN return
15 HASH #
15 SEMICOLON ;
15 RIGHT_BRACE }
16 RIGHT_BRACE }
18 VAR_IDENTIFIER $c
18 ASSIGN =
18 IDENTIFIER Circle
18 LEFT_PAREN (
18 INTEGER 2
18 RIGHT_PAREN )
18 SEMICOLON ;
19 ECHO echo
19 VAR_IDENTIFIER $c
19 PROPERTY .radius
19 CONCAT ..
19 VAR_IDENTIFIER $c
19 PROPERTY .area
19 LEFT_PAREN (
19 RIGHT_PAREN )
19 CONCAT ..
19 STRING_START ""
19 VAR_IDENTIFIER $c
19 PROPERTY .radius
19 STRING_MIDDLE " #fff "
19 VAR_IDENTIFIER $c
19 STRING_END ".txt"
19 SEMICOLON ;
20 VAR_IDENTIFIER $rows
20 LEFT_BRACKET [
20 INTEGER 0
20 RIGHT_BRACKET ]
20 PROPERTY .total
20 ASSIGN =
20 INTEGER 5
20 SEMICOLON ;
21 VAR_IDENTIFIER $query
22 PROPERTY .where
22 LEFT_PAREN (
22 STRING "x"
22 RIGHT_PAREN )
23 PROPERTY .order
23 LEFT_PAREN (
23 STRING "y"
23 RIGHT_PAREN )
23 SEMICOLON ;
24 ECHO echo
24 HASH_IDENTIFIER #class
24 HASH_IDENTIFIER #final
24 PARENT ##
24 HASH #
24 PROPERTY .x
24 PARENT ##
24 CONCAT ..
24 IDENTIFIER y
24 SEMICOLON ;
