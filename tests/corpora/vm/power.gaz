// ** by square-and-multiply: exact ints, floats multiplied step by step, never libm's pow
echo 2 ** 10;
echo 2 ** 62;
echo (-2) ** 63;
echo (-3) ** 3;
echo 0 ** 0;
echo 0.0 ** 0;
echo 7 ** 1;
echo 1 ** 9223372036854775807;
echo (-1) ** 9223372036854775807;
echo 2 ** -1;
echo 10 ** -2;
echo 2 ** 3.0;
echo 1.5 ** 2;
echo 0.1 ** 3;
echo 2.0 ** -1100;
echo 2 ** 3 ** 2;
echo -2 ** 2;
$x = 3;
$x **= 2;
echo $x;
$m = {"n" => 2.0};
$m["n"] **= -2;
echo $m;
echo sqrt(2);
echo sqrt(16);
echo sqrt(0.25);
echo sqrt(-0.0);

$errors = [
    () -> 2 ** 63,
    () -> -2 ** 63,   // -(2 ** 63), which is too big before it is negated
    () -> (-2) ** 64,
    () -> 3 ** 40,
    () -> 0 ** -1,
    () -> 0.0 ** -2,
    () -> 2.0 ** 1024,
    () -> 0.5 ** -2000,
    () -> 2 ** 0.5,
    () -> 2 ** -1.5,
    () -> 10 ** 1e300,
    () -> "2" ** 2,
    () -> 2 ** true,
    () -> null ** 2,
    () -> [2] ** 2,
    () -> sqrt(-1),
    () -> sqrt(-0.5),
    () -> sqrt("4"),
];
foreach ($errors as $f) {
    try {
        echo $f();
    } catch (Error $e) {
        echo $e.message;
    }
}
