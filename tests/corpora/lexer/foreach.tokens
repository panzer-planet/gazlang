1 FOREACH foreach
1 LEFT_PAREN (
1 VAR_IDENTIFIER $items
1 AS as
1 VAR_IDENTIFIER $value
1 RIGHT_PAREN )
1 LEFT_BRACE {
1 ECHO echo
1 VAR_IDENTIFIER $value
1 SEMICOLON ;
1 RIGHT_BRACE }
2 FOREACH foreach
2 LEFT_PAREN (
2 LEFT_BRACKET [
2 STRING "a"
2 DOUBLE_ARROW =>
2 INTEGER 1
2 RIGHT_BRACKET ]
2 AS as
2 VAR_IDENTIFIER $key
2 DOUBLE_ARROW =>
2 VAR_IDENTIFIER $value
2 RIGHT_PAREN )
2 LEFT_BRACE {
2 CONTINUE continue
2 SEMICOLON ;
2 RIGHT_BRACE }
3 FOREACH foreach
3 LEFT_PAREN (
3 IDENTIFIER keys
3 LEFT_PAREN (
3 VAR_IDENTIFIER $m
3 RIGHT_PAREN )
3 AS as
3 VAR_IDENTIFIER $k
3 RIGHT_PAREN )
3 LEFT_BRACE {
3 RIGHT_BRACE }
4 EOF
