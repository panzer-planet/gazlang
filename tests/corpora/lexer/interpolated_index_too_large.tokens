2 VAR_IDENTIFIER $a
2 ASSIGN =
2 LEFT_BRACE {
2 RIGHT_BRACE }
2 SEMICOLON ;
3 ECHO echo
3 STRING_START ""
3 VAR_IDENTIFIER $a
3 LEFT_BRACKET [
3 STRING "99999999999999999999"
3 RIGHT_BRACKET ]
3 STRING_MIDDLE " "
3 VAR_IDENTIFIER $a
3 LEFT_BRACKET [
3 STRING "007"
3 RIGHT_BRACKET ]
3 STRING_MIDDLE " "
3 VAR_IDENTIFIER $a
3 LEFT_BRACKET [
3 INTEGER -5
3 RIGHT_BRACKET ]
3 STRING_END ""
3 SEMICOLON ;
4 EOF
