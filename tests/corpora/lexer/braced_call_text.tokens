2 VAR_IDENTIFIER $x
2 ASSIGN =
2 LEFT_BRACKET [
2 INTEGER 1
2 COMMA ,
2 INTEGER 2
2 RIGHT_BRACKET ]
2 SEMICOLON ;
3 ECHO echo
3 STRING_START "\{len("
3 VAR_IDENTIFIER $x
3 STRING_MIDDLE ")} {len ("
3 VAR_IDENTIFIER $x
3 STRING_END ")}"
3 SEMICOLON ;
4 ECHO echo
4 STRING "\{len(\$x)}"
4 SEMICOLON ;
5 ECHO echo
5 STRING "{f"
5 CONCAT ..
5 STRING "(x)}"
5 CONCAT ..
5 STRING "\{ns::g("
5 SEMICOLON ;
6 EOF
