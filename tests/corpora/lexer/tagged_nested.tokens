2 LEFT_PAREN (
2 TAG inner
2 STRING_START "b "
2 VAR_IDENTIFIER $x
2 STRING_END "\nc"
3 RIGHT_PAREN )
3 STRING_END " d"
4 TAG outer
4 STRING_START ""
