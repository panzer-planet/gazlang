fn shop::product_card 1 2
locals $product $note $#html
@ "templates/namespaced.gazml" 3
ARGC
PUSH 1
GT
NOT
JZ PASSED_0
PUSH ""
STORE 1
LABEL PASSED_0
CHECK_PARAM 0 shop::Product|null
CHECK_PARAM 1 string
PUSH ""
STORE 2
LOAD 2
POP
@ "templates/namespaced.gazml" 4
PUSH "<div class=\"card\">\n"
CONCAT_ASSIGN 2
POP
@ "templates/namespaced.gazml" 5
PUSH "<b>"
CONCAT_ASSIGN 2
POP
LOAD 0
GET_PROPERTY name
CALL Html::escape 1
CONCAT_ASSIGN 2
POP
PUSH "</b>\n"
CONCAT_ASSIGN 2
POP
@ "templates/namespaced.gazml" 6
LOAD 1
PUSH ""
NOT_EQUALS
JZ ELSE_1
@ "templates/namespaced.gazml" 7
PUSH "<p>"
CONCAT_ASSIGN 2
POP
LOAD 1
CALL Html::escape 1
CONCAT_ASSIGN 2
POP
PUSH "</p>\n"
CONCAT_ASSIGN 2
POP
@ "templates/namespaced.gazml" 6
JMP ENDIF_1
LABEL ELSE_1
LABEL ENDIF_1
@ "templates/namespaced.gazml" 9
PUSH "</div>\n"
CONCAT_ASSIGN 2
POP
@ "templates/namespaced.gazml" 10
LOAD 2
NEW Html 1
RET
@ "templates/namespaced.gazml" 3
PUSH null
RET

