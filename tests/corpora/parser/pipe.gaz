// The value on the left becomes the first argument of the call on the right
$x |> f;
$x |> f(1);
$x |> $g;
$x |> $g(1);
$x |> Point;
$x |> Point::make(1);
$x |> ($v -> $v * 2);
$x |> (f)(1);
$x |> ($handlers["k"]);
// Left associative, and a chain may start its lines with |>
$x |> f |> g(1) |> h;
$x
    |> f
    |> g(
        1
    );
// Looser than .. and arithmetic, tighter than comparison and equality
"Hello " .. $name |> upper;
$a + 1 |> f;
$items |> len > 3;
$a |> f == $b |> g;
$a |> f ?? $b;
$c ? $a |> f : $b;
$c |> f ? $a : $b;
// Parenthesised on the right of ?? or after a ternary's :, which says what is piped
$a ?? ($b |> f);
($a ?? $b) |> f;
$c ? $a : ($b |> g);
($c ? $a : $b) |> g;
$a ?? ($b |> f) ?? $c;
fn f($a, $b = 0) { return $a; }
fn g($a, $b = 0) { return $a; }
fn h($a) { return $a; }
kind Point {
    fn _($x) {}
    pub static fn make($x, $y) { return Point($x); }
}
