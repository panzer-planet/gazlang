/*
 * A football league simulator: rated players, a double round-robin season with commentary
 * on the opening match, every matchday's scores, the final table and the top scorers; or,
 * over several seasons or divisions, a pyramid of leagues with promotion and relegation.
 *
 *   bin/gazlang -f tests/programs/football.gaz -- [CLUBS] [SEED] [--seasons N] [--divisions N]
 *                                             [--save FILE] [--load FILE]
 *
 * CLUBS is how many clubs play in each division, from 2 to 20 (4 by default), taken from the
 * strongest down. With more than one season or division, each season prints every division's
 * table and who goes up and down, then the summer: players age, veterans retire and academy
 * youngsters replace them, and the transfer window moves players up to the richer clubs; the
 * last season adds the honours. Every season also has a knockout cup for every club.
 *
 * --save FILE writes the career to a file once the last season's summer is over, and
 * --load FILE carries it on for --seasons more, from the same pyramid, squads and history, as
 * if the run had never stopped: a career saved after two seasons and loaded for a third plays
 * that third season exactly as a run of three would. CLUBS and --divisions come from the file. Everything random is seeded:
 * the squads are always the same, and the same seed always plays the same seasons. Seasons
 * are named from 2026/27 whatever the seed; the Nth is played with SEED + N - 1.
 */
include "../../lib/format.gaz" use pad_left, pad_right;
include "football/players.gaz" use Goalkeeper;
include "football/teams.gaz" use InvalidLineup, Team, Formation, Scout;
include "football/matches.gaz" use Fixture;
include "football/league.gaz" use League, Commentator;
include "football/money.gaz";
include "football/cup.gaz" use Cup;
include "../../lib/lists.gaz" use flatten, max_by, min_by;
include "../../lib/json.gaz";

// The clubs, strongest first: name, level (the squad's typical rating) and formation. The
// first CLUBS make the First Division, the next CLUBS the Second, and so on down
$clubs = [
    ["Harbour City", 82, "4-3-3"], ["Northgate Rovers", 81, "4-4-2"], ["Riverside Athletic", 79, "4-3-3"],
    ["Kingsbridge Wanderers", 78, "3-5-2"], ["Valley United", 77, "4-4-2"], ["Port Albion", 76, "4-3-3"],
    ["Eastfield Town", 75, "4-5-1"], ["Castleton Forest", 74, "4-4-2"], ["Marsh Lane", 73, "3-4-3"],
    ["Oakham Athletic", 72, "4-3-3"], ["Westmoor Albion", 71, "4-4-2"], ["Redcliffe Rangers", 70, "5-3-2"],
    ["Hollins Park", 70, "4-4-2"], ["Stonebridge County", 69, "4-3-3"], ["Ashby Villa", 68, "4-5-1"],
    ["Fairhaven Borough", 67, "4-4-2"], ["Millbrook Dynamo", 66, "3-5-2"], ["Bramley Orient", 65, "4-4-2"],
    ["Greywater Celtic", 64, "5-4-1"], ["Dunmore United", 62, "4-4-2"],
    ["Saltmarsh Town", 61, "4-4-2"], ["Little Hampden", 61, "4-3-3"],
    ["Kingsmere United", 61, "4-5-1"], ["Ashcombe Rovers", 60, "3-5-2"],
    ["Brackenmoor Athletic", 60, "4-4-2"], ["Wexley Park", 60, "5-3-2"],
    ["Burnside Albion", 59, "4-3-3"], ["Chalkhill Town", 59, "4-4-2"],
    ["Elmstead Wanderers", 59, "3-4-3"], ["Holloway Rangers", 58, "5-4-1"],
    ["Fenwick City", 58, "4-4-2"], ["Oxley Vale", 58, "4-3-3"], ["Dunsford Athletic", 57, "4-5-1"],
    ["Cresswell United", 57, "3-5-2"], ["Pennington Town", 57, "4-4-2"],
    ["Harrowgate Borough", 56, "5-3-2"], ["Lowther Rovers", 56, "4-3-3"],
    ["Moorcroft Villa", 56, "4-4-2"], ["Netherby Albion", 55, "3-4-3"],
    ["Sedgemoor Park", 55, "5-4-1"], ["Tidewater Town", 55, "4-4-2"],
    ["Whitcombe United", 54, "4-3-3"], ["Yarrowby Rovers", 54, "4-5-1"],
    ["Coldharbour Athletic", 54, "3-5-2"], ["Amberley Town", 53, "4-4-2"],
    ["Birchwood Rangers", 53, "5-3-2"], ["Copperfield United", 53, "4-3-3"],
    ["Draycott Wanderers", 52, "4-4-2"], ["Eversleigh Town", 52, "3-4-3"],
    ["Foxhollow Athletic", 52, "5-4-1"], ["Glenfield Park", 51, "4-4-2"],
    ["Hartwell Rovers", 51, "4-3-3"], ["Ivybridge Albion", 51, "4-5-1"],
    ["Juniper Vale", 50, "3-5-2"], ["Kestrel Heath", 50, "4-4-2"], ["Larkspur Town", 50, "5-3-2"],
    ["Mallow Green", 49, "4-3-3"], ["Northwold United", 49, "4-4-2"],
    ["Ottery Rangers", 49, "3-4-3"], ["Pebblecombe", 48, "5-4-1"],
    ["Quarry Bank Athletic", 48, "4-4-2"], ["Rookwood Town", 48, "4-3-3"],
    ["Swanmere Villa", 47, "4-5-1"], ["Tarnside Rovers", 47, "3-5-2"], ["Upton Marsh", 47, "4-4-2"],
    ["Vellacott United", 46, "5-3-2"], ["Wyvern Park", 46, "4-3-3"],
    ["Yewdale Athletic", 46, "4-4-2"], ["Barnstow Borough", 45, "3-4-3"],
    ["Cheddleton Town", 45, "5-4-1"], ["Dunwich Rovers", 45, "4-4-2"],
    ["Emberton United", 44, "4-3-3"], ["Farthing Wood", 44, "4-5-1"],
    ["Grimsdyke Athletic", 44, "3-5-2"], ["Hazelmere Town", 43, "4-4-2"],
    ["Inglebrook", 43, "5-3-2"], ["Kirkwell Rangers", 43, "4-3-3"], ["Lindenhurst", 42, "4-4-2"],
    ["Maplestead Albion", 42, "3-4-3"], ["Nettlebed Town", 42, "5-4-1"],
];

const DIVISIONS = ["First Division", "Second Division", "Third Division", "Fourth Division"];
const MAX_CLUBS = 20;
const MAX_SEASONS = 50;
const FIRST_SEASON = 2026;

// A season by its English name: the one starting in 2026 is 2026/27
fn season_name($year) {
    return "{$year}/" .. slice("0" .. ($year + 1) % 100, -2);
}

// Print the usage and the problem, and stop with exit code 1
fn fail($message) {
    echo "Usage: bin/gazlang -f tests/programs/football.gaz -- [CLUBS] [SEED] [--seasons N] [--divisions N] [--save FILE] [--load FILE]";
    echo "Error: {$message}";
    exit(1);
}

fn whole_number($text, $name) {
    return to_int($text, null) ?? fail("{$name} must be a whole number, got \"{$text}\"");
}

// The command line: CLUBS and SEED in that order, and the options anywhere. "given" lists
// what was written rather than left to its default
fn options() {
    $options = {"clubs" => 4, "seed" => 2026, "seasons" => 1, "divisions" => 1, "save" => null, "load" => null, "given" => []};
    $positional = [];
    $arguments = args();
    for ($i = 0; $i < len($arguments); $i++) {
        $argument = $arguments[$i];
        if (!starts_with($argument, "--")) {
            $positional[] = $argument;
            continue;
        }
        $name = slice($argument, 2);
        if (!in_array($name, ["seasons", "divisions", "save", "load"])) {
            fail("unknown option {$argument}");
        }
        $file = in_array($name, ["save", "load"]);
        if ($i + 1 == len($arguments)) {
            fail("{$argument} needs " .. ($file ? "a file" : "a number"));
        }
        $i++;
        $options[$name] = $file ? $arguments[$i] : whole_number($arguments[$i], $argument);
        $options["given"][] = $name;
    }
    if (len($positional) > 2) {
        fail("expected at most 2 arguments, got " .. len($positional));
    }
    foreach ($positional as $i => $text) {
        $options[["clubs", "seed"][$i]] = whole_number($text, ["CLUBS", "SEED"][$i]);
        $options["given"][] = ["clubs", "seed"][$i];
    }
    return $options;
}

$options = options();
$count = $options["clubs"];
$seed = $options["seed"];
$seasons = $options["seasons"];
$divisions = $options["divisions"];
if ($options["load"] != null && (in_array("clubs", $options["given"]) || in_array("divisions", $options["given"]))) {
    fail("a loaded career brings its own clubs and divisions: leave out CLUBS and --divisions");
}
if ($count < 2 || $count > MAX_CLUBS) {
    fail("CLUBS must be from 2 to " .. MAX_CLUBS .. ", got {$count}");
}
if ($divisions < 1 || $divisions > len(DIVISIONS)) {
    fail("--divisions must be from 1 to " .. len(DIVISIONS) .. ", got {$divisions}");
}
if ($seasons < 1 || $seasons > MAX_SEASONS) {
    fail("--seasons must be from 1 to " .. MAX_SEASONS .. ", got {$seasons}");
}

// The same squads whatever the season
rand_seed(1);
$scout = Scout();
// The divisions, strongest first, each a list of its teams
$pyramid = [];
foreach (slice($clubs, 0, $count * $divisions) as $i => [$name, $level, $formation]) {
    if ($i % $count == 0) {
        $pyramid[] = [];
    }
    $pyramid[intdiv($i, $count)][] = $scout.team($name, $level, $formation);
}
// Ages once the squads are made, so that making them draws the same numbers as ever
foreach (flatten($pyramid) as $team) {
    foreach ($team.players as $player) {
        $player.age = $scout.age();
    }
}

// The table, with a header
fn print_table($league) {
    echo pad_right("", 26) .. "Rating" .. join(map(["P", "W", "D", "L", "F", "A"], $label -> pad_left($label, 4)), "") .. "   GD  Pts";
    foreach ($league.table() as $position => $standing) {
        echo pad_left($position + 1, 2) .. ". " .. $standing;
    }
}

if ($options["load"] != null) {
    play_pyramid(load_career($options["load"], $scout), $scout, $seasons, $options["save"]);
    exit();
}
if ($seasons > 1 || $divisions > 1 || $options["save"] != null) {
    play_pyramid(new_career($pyramid, $seed), $scout, $seasons, $options["save"]);
    exit();
}

// One season of one division, told in full, after showing that a squad has to be a proper eleven
try {
    Team("Sunday Strollers", Formation("4-4-2"), [Goalkeeper("J. Bloggs", 50, 1), Goalkeeper("J. Doe", 50, 2)]);
} catch (InvalidLineup $e) {
    echo "Refused: {$e.message}";
}
$teams = $pyramid[0];
echo "Season " .. season_name(FIRST_SEASON) .. ": {$count} clubs, " .. League::matches_for($count) .. " matches";

rand_seed($seed);
$league = League($teams);
// Globals, since a plain $ variable assigned inside the callback would be local to each call
@all_matches = [];
@motm_awards = {};
$league.play_season(Commentator(1).kick_off, ($number, $matches) -> {
    echo "";
    echo "Matchday {$number}";
    foreach ($matches as $index => $match) {
        echo pad_left($match.home, 22) .. "  " .. $match.home_goals .. " - " .. $match.away_goals .. "  " .. $match.away;
        // Read off right away: match_goals and saves reset the moment the next match rests
        $motm = $match.motm();
        $name = $motm.to_string();
        @motm_awards[$name] = {"player" => $motm, "awards" => (@motm_awards[$name]["awards"] ?? 0) + 1};
        if ($number == 1 && $index == 0) {
            echo "Player of the match: " .. $motm.profile();
        }
    }
    @all_matches = [...@all_matches, ...$matches];
});

echo "";
print_table($league);

echo "";
echo "Top scorers";
foreach ($league.top_scorers(10) as $row) {
    echo pad_left($row["player"].goals, 3) .. "  " .. $row["player"].profile() .. ", {$row["team"]}";
}

echo "";
echo "Top goalkeepers, by clean sheets";
foreach ($league.top_keepers(10) as $row) {
    echo pad_left($row["player"].clean_sheets, 3) .. "  " .. $row["player"].profile() .. ", {$row["team"]}";
}

echo "";
echo "Season stats";
$goals = sum(map(@all_matches, $match -> $match.home_goals + $match.away_goals));
echo "Goals: " .. $goals .. " in " .. Fixture::matches_played .. " matches, " .. round($goals / Fixture::matches_played, 2) .. " a game";
$biggest_win = max_by(@all_matches, $match -> abs($match.home_goals - $match.away_goals));
echo "Biggest win: {$biggest_win}";
$highest_scoring = max_by(@all_matches, $match -> $match.home_goals + $match.away_goals);
echo "Highest-scoring match: {$highest_scoring}";
$player_of_season = max_by(values(@motm_awards), $award -> $award["awards"]);
echo "Player of the season: " .. $player_of_season["player"].profile() .. " ({$player_of_season["awards"]} man of the match awards)";

// A career about to begin: the squads the scout made, with the money they start with
fn new_career($pyramid, $seed) {
    foreach (flatten($pyramid) as $team) {
        $team.balance = money::starting_balance($team);
    }
    // played: how many seasons are over; honours: each season's champions of each division
    // and cup winners, by name; retired: everyone who has retired, {"player", "team"}; record:
    // the dearest transfer so far, with its season
    return {"seed" => $seed, "played" => 0, "pyramid" => $pyramid, "honours" => [], "retired" => [], "record" => null};
}

// Several seasons of the pyramid: every division's table, who goes up and down, the cup, the
// summer in between, and at the end the honours. With $save, the last season's summer is
// played too and the career written there, so that loading it carries straight on
fn play_pyramid($career, $scout, $seasons, $save) {
    [$seed, $pyramid, $honours, $retired, $record] = [$career["seed"], $career["pyramid"], $career["honours"], $career["retired"], $career["record"]];
    $count = len($pyramid[0]);
    // Each season a sixth of a division, and at least one club, swaps with the one below
    $moving = max(1, intdiv($count, 6));
    $first = $career["played"];
    for ($n = $first; $n < $first + $seasons; $n++) {
        rand_seed($seed + $n);
        $season = season_name(FIRST_SEASON + $n);
        if ($n > $first) {
            echo "";
        }
        echo "Season {$season}";
        $finishes = [];
        $champions = [];
        foreach ($pyramid as $level => $teams) {
            $league = League($teams);
            $league.play_season($match -> null, ($number, $matches) -> null);
            $finish = map($league.table(), $standing -> $standing.team);
            $finishes[] = $finish;
            $champions[] = $finish[0].name;
            foreach ($finish as $position => $team) {
                $team.balance += money::prize($level, $position, $count) - money::wages($team);
            }

            echo "";
            echo DIVISIONS[$level];
            print_table($league);
            $scorer = $league.top_scorers(1)[0] ?? null;
            if ($scorer != null) {
                echo "Top scorer: {$scorer["player"]} ({$scorer["team"]}), {$scorer["player"].goals} goals";
            }
            if ($level > 0) {
                echo "Promoted: " .. join(slice($finish, 0, $moving), ", ");
            }
            if ($level < len($pyramid) - 1) {
                echo "Relegated: " .. join(slice($finish, -$moving), ", ");
            }
        }
        // The cup, drawn once the league is over and seeded by how it finished
        $divisions = {};
        foreach ($finishes as $level => $finish) {
            foreach ($finish as $team) {
                $divisions[object_id($team)] = $level;
            }
        }
        $cup = Cup("Albion Cup");
        $winner = $cup.play(flatten($finishes));
        print_cup($cup, $winner, $divisions);
        $honours[] = [$season, $champions, $winner.name];

        // Next season's divisions: the clubs that stay, those coming down and those going up
        $pyramid = [];
        foreach ($finishes as $level => $finish) {
            $stay = slice($finish, $level > 0 ? $moving : 0, $count - ($level > 0 ? $moving : 0) - ($level < len($finishes) - 1 ? $moving : 0));
            $down = $level > 0 ? slice($finishes[$level - 1], -$moving) : [];
            $up = $level < len($finishes) - 1 ? slice($finishes[$level + 1], 0, $moving) : [];
            $pyramid[] = [...$down, ...$stay, ...$up];
        }
        foreach (flatten($pyramid) as $team) {
            foreach ($team.players as $player) {
                $player.new_season();
            }
        }
        if ($n < $first + $seasons - 1 || $save != null) {
            $retired = [...$retired, ...summer(flatten($pyramid), $scout)];
            $deals = money::window(flatten($pyramid));
            print_window($deals, flatten($pyramid));
            if ($deals != []) {
                $biggest = max_by($deals, $deal -> $deal["fee"]);
                if ($record == null || $biggest["fee"] > $record["fee"]) {
                    $record = {...$biggest, "season" => $season};
                }
            }
        }
    }

    if (len($honours) > 1) {
        print_honours($pyramid, $honours, $retired, $record);
    }
    if ($save != null) {
        save_career($save, $seed, $first + $seasons, $pyramid, $scout, $honours, $retired, $record);
    }
}

// The career as JSON: the clubs, strongest division first, their squads and money, and the
// history. A transfer record and the retired keep only what is printed of them
fn save_career($path, $seed, $played, $pyramid, $scout, $honours, $retired, $record) {
    $data = {
        "career" => "football.gaz", "version" => 1, "seed" => $seed, "played" => $played,
        "names" => $scout.names(),
        "pyramid" => map($pyramid, $teams -> map($teams, $team -> $team.to_data())),
        "honours" => $honours,
        "retired" => map($retired, $row -> ({"player" => $row["player"].to_data(), "team" => to_string($row["team"])})),
        "record" => $record == null ? null : {
            "player" => to_string($record["player"]), "from" => to_string($record["from"]),
            "to" => to_string($record["to"]), "fee" => $record["fee"], "season" => $record["season"],
        },
    };
    write_file($path, json::encode($data) .. "\n");
}

// A career from save_career(); what it can't make sense of stops the program
fn load_career($path, $scout) {
    if (!file_exists($path)) {
        fail("no saved career at {$path}");
    }
    try {
        $data = json::decode(read_file($path));
        if (($data["career"] ?? null) != "football.gaz" || ($data["version"] ?? null) != 1) {
            fail("{$path} is not a saved football.gaz career");
        }
        $scout.take($data["names"]);
        return {
            "seed" => $data["seed"], "played" => $data["played"],
            "pyramid" => map($data["pyramid"], $teams -> map($teams, teams::from_data)),
            "honours" => $data["honours"],
            "retired" => map($data["retired"], $row -> ({"player" => players::from_data($row["player"]), "team" => $row["team"]})),
            "record" => $data["record"],
        };
    } catch (Error $e) {
        fail("{$path} is not a saved career: {$e.message}");
    }
}

// Between seasons every player grows a year older, and the veterans who retire make way for
// youngsters from the academy; prints what stood out, and gives who retired
fn summer($teams, $scout) {
    $retired = [];
    $newcomers = [];
    $stayed = [];
    foreach ($teams as $team) {
        foreach ($team.players as $player) {
            $change = $player.grow_older();
            if ($player.retires()) {
                $retired[] = {"player" => $player, "team" => $team};
                $youth = $scout.youth(kind_of($player), $team, $player.number);
                $team.replace($player, $youth);
                $newcomers[] = {"player" => $youth, "team" => $team};
            } else {
                $stayed[] = {"player" => $player, "team" => $team, "change" => $change};
            }
        }
    }

    echo "";
    if ($retired == []) {
        echo "Summer: nobody retired";
    } else {
        $oldest = max_by($retired, $row -> $row["player"].age);
        $best = max_by($newcomers, $row -> $row["player"].rating);
        echo "Summer: " .. len($retired) .. " retired, the oldest {$oldest["player"]} ({$oldest["player"].age}, {$oldest["team"]})";
        echo "Best from the academy: {$best["player"]} ({$best["player"].age}, {$best["player"].position()} {$best["player"].rating}, {$best["team"]})";
    }
    $improved = max_by($stayed, $row -> $row["change"]);
    if ($improved["change"] > 0) {
        $player = $improved["player"];
        echo "Most improved: {$player} ({$player.age}, up {$improved["change"]} to {$player.rating}, {$improved["team"]})";
    }
    return $retired;
}

// The cup from the quarter-finals on, the rounds before them in a line, and the biggest upset:
// the winner the most divisions below the club it knocked out
fn print_cup($cup, $winner, $divisions) {
    echo "";
    echo $cup.name;
    $early = filter($cup.rounds, ([$name, $ties]) -> len($ties) > 4);
    if ($early != []) {
        echo join(map($early, ([$name, $ties]) -> $name), ", ") .. ": " .. sum(map($early, ([$name, $ties]) -> len($ties))) .. " ties";
    }
    foreach ($cup.rounds as [$name, $ties]) {
        if (len($ties) <= 4) {
            echo $name;
            foreach ($ties as $tie) {
                echo "  {$tie}";
            }
        }
    }
    echo "Winners: {$winner}";

    $ties = flatten(map($cup.rounds, ([$name, $ties]) -> map($ties, $tie -> [$name, $tie])));
    $gap = ([$round, $tie]) -> $divisions[object_id($tie.winner())] - $divisions[object_id($tie.loser())];
    // The latest round first, so of two as big the one nearer the final is told
    $upset = max_by(reverse($ties), $gap);
    if ($gap($upset) > 0) {
        [$round, $tie] = $upset;
        echo "Giant-killing: {$tie.winner()} (" .. DIVISIONS[$divisions[object_id($tie.winner())]] .. ") knocked out "
            .. "{$tie.loser()} (" .. DIVISIONS[$divisions[object_id($tie.loser())]] .. ") in the " .. lower($round) .. ", {$tie}";
    }
}

// The summer's deals, the biggest of them, and who has the most and least money now
fn print_window($deals, $teams) {
    if ($deals == []) {
        echo "Transfer window: no deals";
    } else {
        $biggest = max_by($deals, $deal -> $deal["fee"]);
        echo "Transfer window: " .. len($deals) .. " deals, the biggest {$biggest["player"]} ({$biggest["player"].position()} {$biggest["player"].rating}) "
            .. "from {$biggest["from"]} to {$biggest["to"]} for " .. money::pounds($biggest["fee"]);
    }
    $richest = max_by($teams, $team -> $team.balance);
    $poorest = min_by($teams, $team -> $team.balance);
    echo "Richest: {$richest} " .. money::pounds($richest.balance) .. ", poorest: {$poorest} " .. money::pounds($poorest.balance);
}

fn print_honours($pyramid, $honours, $retired, $record) {
    echo "";
    echo "Honours";
    echo trim(pad_right("Season", 8) .. join(map([...slice(DIVISIONS, 0, len($pyramid)), "Albion Cup"], $name -> pad_right($name, 24)), ""));
    $titles = {};
    foreach ($honours as [$season, $champions, $cup]) {
        echo trim(pad_right($season, 8) .. join(map([...$champions, $cup], $name -> pad_right($name, 24)), ""));
        $titles[$champions[0]] = ($titles[$champions[0]] ?? 0) + 1;
    }
    $table = sort(keys($titles), ($a, $b) -> [$titles[$b], $a] <=> [$titles[$a], $b]);
    echo "League titles: " .. join(map($table, $name -> "{$name} {$titles[$name]}"), ", ");
    if ($record != null) {
        echo "Record transfer: {$record["player"]} from {$record["from"]} to {$record["to"]} for "
            .. money::pounds($record["fee"]) .. " in {$record["season"]}";
    }

    echo "";
    echo "All-time top scorers";
    $scorers = [];
    foreach (flatten($pyramid) as $team) {
        foreach ($team.players as $player) {
            $scorers[] = {"player" => $player, "team" => $team, "retired" => false};
        }
    }
    foreach ($retired as $row) {
        $scorers[] = {"player" => $row["player"], "team" => $row["team"], "retired" => true};
    }
    $scorers = sort($scorers, ($a, $b) -> $b["player"].career_goals <=> $a["player"].career_goals);
    foreach (slice($scorers, 0, 10) as $row) {
        echo pad_left($row["player"].career_goals, 4) .. "  " .. $row["player"].profile() .. ", {$row["team"]}"
            .. ($row["retired"] ? ", retired" : "");
    }
}
