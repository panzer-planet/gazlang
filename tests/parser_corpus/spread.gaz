// ... spreads a list into a list literal, anywhere among its elements
const LETTERS = ["a", "b"];
const ALL = [...LETTERS, "c", ...[]];
class T { const MORE = [...ALL, ...LETTERS]; }
$a = [1, 2];
echo [...$a];
echo [0, ...$a, 3, ...$a,];
echo [...[...$a], ...f()];
fn f() { return [4]; }
$g = $x -> [...$x, ...$a];
// Located at the ..., each on its own line
echo [
    1,
    ...
    $a
];
