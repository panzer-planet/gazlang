// Made from ConstTest::expressions(): every operator and kind of value a constant can have. The values are
// in the tree, on each use, so the two parsers are compared on what they work out.
const C0 = 1 + 2;
const C1 = 7 - 9;
const C2 = 3 * 4;
const C3 = 7 / 2;
const C4 = 6 / 2;
const C5 = -7 % 3;
const C6 = 7 % -3;
const C7 = 1.5 + 1;
const C8 = 2 * 0.25;
const C9 = "a" .. 1 .. 2.0 .. true .. null .. [1] .. {"k" => 1};
const C10 = 1 == 1.0;
const C11 = "1" == 1;
const C12 = [1] == [1.0];
const C13 = {"a" => 1, "b" => 2} == {"b" => 2, "a" => 1};
const C14 = [] == {};
const C15 = 1 != 2;
const C16 = null == false;
const C17 = 1 <=> 2;
const C18 = "b" <=> "a";
const C19 = 2.0 <=> 2;
const C20 = 1 < 2;
const C21 = "10" < "9";
const C22 = 2 <= 2;
const C23 = 3 > 2.5;
const C24 = 2 >= 3;
const C25 = [1, 2] <=> [1, 3];
const C26 = [1] < [1, 0];
const C27 = [["a"], 2] >= [["a"], 2];
const C28 = 6 & 3;
const C29 = 6 | 3;
const C30 = 6 ^ 3;
const C31 = 1 << 62;
const C32 = 1 << 63;
const C33 = -1 << 1;
const C34 = -8 >> 1;
const C35 = ~0;
const C36 = ~-1;
const C37 = -5;
const C38 = -2.5;
const C39 = -0.0;
const C40 = - -3;
const C41 = !0;
const C42 = !"";
const C43 = !"0";
const C44 = ![];
const C45 = !{};
const C46 = ![0];
const C47 = !null;
const C48 = !!1.5;
const C49 = 1 && 2;
const C50 = 0 && 2;
const C51 = "" || "x";
const C52 = 0 || null;
const C53 = null ?? 1;
const C54 = 0 ?? 1;
const C55 = false ?? 1;
const C56 = null ?? null ?? 3;
const C57 = 1 ? "a" : "b";
const C58 = 0.0 ? "a" : "b";
const C59 = [] ? "a" : "b";
const C60 = 1 ? 2 ? "x" : "y" : "z";
const C61 = [1, [2.5, "s"], {"k" => [true, null]}];
const C62 = {"a" => 1, 1 => "one", "1" => "string one", "a" => 2};
const C63 = 9223372036854775807;
const C64 = -9223372036854775807 - 1;
const C65 = 9007199254740993 == 9007199254740992.0;
const C66 = 0.1 + 0.2;
const C67 = 1 + 2 * 3 - 4 / 5;
const C68 = "n = " .. 1 + 2;
const C69 = "x" .. 6 & 3;
const C70 = 1 << 2 + 1;
const C71 = 6 & 3 == 2;
const C72 = [...[1, 2], 3, ...[]];
const C73 = [...[[1]], ...["a" .. 1], ...[] ? [1] : [2]];
echo [C0, C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11, C12, C13, C14, C15, C16, C17, C18, C19, C20, C21, C22, C23, C24, C25, C26, C27, C28, C29, C30, C31, C32, C33, C34, C35, C36, C37, C38, C39, C40, C41, C42, C43, C44, C45, C46, C47, C48, C49, C50, C51, C52, C53, C54, C55, C56, C57, C58, C59, C60, C61, C62, C63, C64, C65, C66, C67, C68, C69, C70, C71, C72, C73];
