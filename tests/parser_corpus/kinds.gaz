// Used before it is declared, parent declared after child
$c = Circle(2);
echo is_a($c, Shape);
$make = Circle;

kind Circle extends Shape {
    #radius;
    #history = [];
    #doubled = #radius * 2;
    #callback = $x -> #radius + $x;

    fn _($radius) {
        ##_("circle");
        #radius = $radius;
        #history[] = $radius;
        #history[0] += 1;
        #radius++;
    }

    fn area() { return 3.14159 * #radius * #radius; }
    fn to_string() { return ##to_string() .. " (r = {#radius})"; }
    fn parent_area() { return ##describe; }
    fn scale($by = 2) { return Circle(#radius * $by); }
    fn me() { return #; }
    fn chained() { return #me().area(); }
    fn later() { return () -> #area() + #radius; }
    fn swap() { [#radius, #doubled] = [#doubled, #radius]; }
    fn drop($i) { delete #history[$i]; }
}

abstract kind Shape {
    #name;
    fn _($name) { #name = $name; }
    abstract fn area();
    fn describe($prefix = "") { return $prefix .. #name; }
    fn to_string() { return "{#name} with area " .. #area(); }
}

// No constructor of its own: the parent's, or none
kind Dot extends Circle {}
kind Empty {}
echo Dot(1) .. Empty();

// Any word can name a member, keywords included
kind Words {
    #class;
    #if = 1;
    fn echo() { return #class; }
    fn match($default) { return #if + $default; }
    fn delete() { return #echo(); }
    fn fn() { return #match(1); }
}
echo Words().echo();

// An abstract child of an abstract parent; a concrete grandchild defines both
abstract kind A { abstract fn one(); abstract fn two($x, $y = 1); }
abstract kind B extends A { fn one() { return 1; } }
kind C extends B { fn two($x, $y = 1, $z = 2) { return #one(); } }
echo C().two(1);

// A method called with every argument count it accepts; a field holding a function is called too
kind Calls {
    #f;
    fn _() { #f = $x -> $x; }
    fn opt($a, $b = 1) { return #opt(1) + #opt(1, 2) + #f(1, 2, 3); }
}

// Names in another case than a keyword
kind If { fn _($x) {} }
kind Match extends If { fn _() { ##_(1); } }
echo If(1) .. Match();

// to_string must accept no arguments, which one with only optional parameters does
kind Printable { fn to_string($indent = 0) { return "p"; } }
