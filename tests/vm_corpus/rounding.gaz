// round() as PHP rounds, including precisions past what a division can do
$cases = [[1.5, 0], [2.5, 0], [-2.5, 0], [1.005, 2], [0.285, 2], [1234.5678, -2], [1.45, 1], [-1.45, 1],
    [5.055, 2], [1.955, 2], [123456.789, -3], [0.5, 0], [-0.5, 0], [1.5, 30], [123.456, -25],
    [1e20, 2], [3, -1], [15, -1], [-15, -1], [7, 2], [2.675, 2], [1.0000000000000002, 15], [0.1, 400], [5.0, -400]];
foreach ($cases as [$x, $p]) {
    echo "round({$x}, {$p}) = " .. round($x, $p);
}
echo [round(2.5), round(-3.5), round(7), floor(-2.5), ceil(-2.5), floor(3), ceil(3)];
