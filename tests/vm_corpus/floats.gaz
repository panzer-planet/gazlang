// Every shape a float is printed in
$values = [0.0, -0.0, 1.0, -1.5, 0.1, 0.30000000000000004, 1e15, 1e16, 1e17, 1.5e17, 123456789012345678.0,
    1e-4, 1.5e-4, 1e-5, 1.25e-5, 1e25, 1.2345e25, -2.5e-300, 5e-324, 1.7976931348623157e308,
    100.0, 1234.5678, 0.001, 9007199254740993.0, 2.0 / 3.0, 1.0 / 3.0, 12345678.9, 4.35, 0.1 + 0.2];
foreach ($values as $v) {
    echo $v .. " " .. -$v .. " " .. to_string([$v]);
}
try { echo to_float("1e308") * 10.0; } catch (Error $e) { echo $e.message; }
