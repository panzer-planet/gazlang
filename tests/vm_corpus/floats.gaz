// Every shape a float is printed in
$values = [0.0, -0.0, 1.0, -1.5, 0.1, 0.30000000000000004, 1e15, 1e16, 1e17, 1.5e17, 123456789012345678.0,
    1e-4, 1.5e-4, 1e-5, 1.25e-5, 1e25, 1.2345e25, -2.5e-300, 5e-324, 1.7976931348623157e308,
    100.0, 1234.5678, 0.001, 9007199254740993.0, 2.0 / 3.0, 1.0 / 3.0, 12345678.9, 4.35, 0.1 + 0.2];
foreach ($values as $v) {
    echo $v .. " " .. -$v .. " " .. to_string([$v]);
}
try { echo to_float("1e308") * 10.0; } catch (Error $e) { echo $e.message; }
// Next to a power of two the floats around a value are not evenly spaced, and the shortest digits
// that read back can be the ones rounded the other way (4776 of a million random floats were)
foreach ([5.684341886080802E-14, 6.156563468186638E+113, 8.209073602596753E-289, 5.986310706507379E+51,
          5.896816288783659E+166, 6.243497100631985E+144, 5.966672584960166E-154, 6.617444900424222E-24,
          5.225680706521042E-200, 7.174648137343064E-43, 5.940911144672375E-213] as $v) {
    echo $v;
}
