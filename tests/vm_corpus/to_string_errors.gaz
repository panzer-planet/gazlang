// A to_string() that fails, reached from everywhere that prints
class Bad { fn to_string() { return 1 / 0; } }
class NotText { fn to_string() { return 5; } }
foreach ([() -> join([1, Bad()], ","), () -> print(Bad()), () -> print_error(NotText()), () -> "x" .. Bad(),
          () -> to_string([Bad()]), () -> "{Bad()}", () -> error(Bad())] as $f) {
    try {
        $f();
    } catch (Error $e) {
        echo $e.message .. " " .. $e.line;
    } catch ($e) {
        echo "caught a " .. type_of($e);
    }
}
$s = "a";
try { $s ..= Bad(); } catch (Error $e) { echo $e.message .. " " .. $s; }
// A to_string() that changes the variable being appended to
@target = "start";
class Sneaky { fn to_string() { @target = 5; return "!"; } }
@target ..= Sneaky();
echo @target;
