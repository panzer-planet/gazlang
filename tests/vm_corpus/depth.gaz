// Running out of call depth, by every kind of call, caught each time
fn down($n) { return down($n + 1); }
try { down(0); } catch (Error $e) { echo $e.message; echo len($e.trace); echo $e.trace[10]; }

kind Walker {
    #steps = 0;
    fn walk() { #steps++; return #walk(); }
    fn to_string() { return "walker " .. #; }
}
try { Walker().walk(); } catch (Error $e) { echo $e.message; }

$f = $n -> $f($n + 1);
try { $f(0); } catch (Error $e) { echo $e.message; }

// A bound method called as a value
$w = Walker();
$walk = $w.walk;
try { $walk(); } catch (Error $e) { echo $e.message; }

// Constructing, which is two frames deep each time: the limit is met at the construction and at
// the constructor, depending on how deep it started
kind Nest { fn _($n) { Nest($n + 1); } }
try { Nest(0); } catch (Error $e) { echo $e.message .. " " .. $e.line; }
fn nest_from_one() { Nest(0); }
try { nest_from_one(); } catch (Error $e) { echo $e.message .. " " .. $e.line; }

// A kind called as a value
$make = Nest;
try { $make(0); } catch (Error $e) { echo $e.message; }

// ##name(...)
kind Base { fn go($n) { return #go($n + 1); } }
kind Child extends Base { fn go($n) { return ##go($n); } }
try { Child().go(0); } catch (Error $e) { echo $e.message; }

// to_string() printing itself forever runs in nested loops
try { echo Walker(); } catch (Error $e) { echo $e.message; }

// Through a builtin's callback, which runs in a loop of its own, with the limit met at deep()
// and, starting one deeper, at the callback
fn deep($n) { return map([$n], $x -> deep($x + 1)); }
try { deep(0); } catch (Error $e) { echo $e.message; echo len($e.trace); echo $e.trace[10]; }
fn start_deep() { deep(0); }
try { start_deep(); } catch (Error $e) { echo $e.message; echo len($e.trace); echo $e.trace[10]; }

// The depth is given back after each: this still works
echo down2(3);
fn down2($n) { return $n == 0 ? "done" : down2($n - 1); }
