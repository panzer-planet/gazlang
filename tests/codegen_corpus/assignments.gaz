// Every way to assign, and what compound updates and ++ are lowered to
$a = 1;
$a += 2;
$a -= $a;
$b = 6;
$b *= 3;
$b %= 4;
$c = 1;
$c /= 2;
$d = 5;
$d &= 3; $d |= 8; $d ^= 1; $d <<= 2; $d >>= 1;
$s = "x";
$s ..= "y";
$s ..= 1;
$m = {"n" => 1, "l" => [1, 2], "s" => ""};
$m["n"] += 5;
$m["l"][0] *= 2;
$m["l"][] = 3;
$m["new"] = 1;
$m["c"] ??= 0;
$m["c"]++;
++$m["c"];
$m["n"]--;
echo $m["n"]++ + --$m["n"];
$m["s"] ..= "appended";
$k = "n";
$m[$k .. ""] += len("ab");
@g = 1;
@g += 1;
@g++;
@h ??= 2;
@l = [];
@l[] = 1;
@l[0] += 1;
[$p, $q] = [1, 2];
[$p, $q] = [$q, $p];
[@g, $m["n"], $r] = [1, 2, 3];
$x = $y = 5;
$u ??= 3;
$u ??= 4;
$v = ++$x;
$w = $x--;
$z = [$m["n"] ??= 1, $m["zz"] ??= 2];
kind P {
    pub #n = 0;
    pub #l = [];
    pub #s = "";
    pub fn bump() {
        #n += 1;
        #n++;
        #l[] = #n;
        #s ..= "x";
        #n ??= 3;
        [#n, $t] = [1, 2];
        return #n + $t;
    }
}
$o = P();
$o.n = 5;
$o.n += 1;
$o.l[] = 2;
$o.n++;
$o.s ..= "y";
echo $o.bump();
$rows = [P()];
$rows[0].n += 1;
$rows[0].l[] = 1;
