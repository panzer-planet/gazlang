include "std/test.gaz" use expect, throws;

// An expression: arms are tried in order and compared with ==, several to an arm
expect("the first arm", match (1) { 1 => "one", 2 => "two", default => "many" }, "one");
expect("a later arm", match (2) { 1 => "one", 2 => "two", default => "many" }, "two");
expect("several values to an arm", match (3) { 1, 2, 3 => "few", default => "many" }, "few");
expect("the default arm", match (9) { 1 => "one", default => "many" }, "many");
expect("a trailing comma", match (1) { 1 => "one", }, "one");
expect("one arm and no default", match (1) { 1 => "one" }, "one");

// Arm values are full expressions, not just literals
$n = 4;
fn double($x) { return $x * 2; }
expect("an expression arm value", match (8) { $n => "n", double($n) => "double n", default => "no" }, "double n");
expect("the subject is an expression", match (2 + 2) { 4 => "four", default => "no" }, "four");
expect("a match in a match", match (1) { 1 => match (2) { 2 => "inner" }, default => "no" }, "inner");

// == decides, so no conversion between strings and numbers, and 1 == 1.0
expect("an int matches an equal float", match (1.0) { 1 => "yes", default => "no" }, "yes");
expect("a string never matches a number", match ("1") { 1 => "yes", default => "no" }, "no");
expect("a bool matches only itself", match (true) { 1 => "one", true => "true", default => "no" }, "true");
expect("null matches null", match (null) { 0 => "zero", null => "null", default => "no" }, "null");
expect("lists compare element by element", match ([1, 2]) { [1, 2] => "yes", default => "no" }, "yes");

// Only the values before the match are evaluated
@tested = [];
fn loud($v) { @tested[] = $v; return $v; }
expect("stops at the first match", match (2) { loud(1) => "a", loud(2) => "b", loud(3) => "c" }, "b");
expect("later arm values never ran", @tested, [1, 2]);

// The subject is evaluated once, however many arms are tried
@subjects = 0;
fn subject() { @subjects++; return 3; }
expect("a subject that misses every arm but the last", match (subject()) { 1 => "a", 2 => "b", 3 => "c" }, "c");
expect("the subject ran once", @subjects, 1);

// As a statement: arms may be blocks, no trailing semicolon, and the value is discarded
$log = [];
match ("b") {
    "a" => { $log[] = "was a"; }
    "b" => { $log[] = "was b"; $log[] = "twice"; }
    default => { $log[] = "was neither"; }
}
expect("a block arm ran", $log, ["was b", "twice"]);

// A statement match may mix block and expression arms, and default => {} ignores the rest
match (9) {
    1 => { $log[] = "one"; }
    2 => $log[] = "two",
    default => {}
}
expect("default => {} ignores the rest", $log, ["was b", "twice"]);

match (2) {
    1 => { $log[] = "one"; }
    2 => $log[] = "two",
    default => {}
}
expect("an expression arm beside a block one", $log, ["was b", "twice", "two"]);

// No fallthrough, so break and continue in an arm belong to the loop around the match
$seen = [];
$i = 0;
while ($i < 6) {
    $i++;
    match ($i) {
        2 => { continue; }
        5 => { break; }
        default => {}
    }
    $seen[] = $i;
}
expect("continue in an arm skips the rest of the loop body", $seen, [1, 3, 4]);
expect("break in an arm leaves the loop", $i, 5);

// return in an arm returns from the function
fn describe($x) {
    match ($x) {
        0 => { return "zero"; }
        default => {}
    }

    return "not zero";
}
expect("return in an arm", describe(0), "zero");
expect("past the match", describe(1), "not zero");

// Nothing matching and no default is an error naming the subject, strings quoted
@printed = 0;
kind Loud {
    pub fn to_string() { @printed++; return "loud"; }
}

throws("no arm matches a string", () -> match ("x") { "a" => 1 }, "No arm matches \"x\"");
throws("no arm matches a number", () -> match (5) { 1 => 1 }, "No arm matches 5");
throws("no arm matches a bool", () -> match (true) { 1 => 1 }, "No arm matches true");
throws("no arm matches null", () -> match (null) { 1 => 1 }, "No arm matches null");
// Anything that isn't a scalar is named by its type: describing it could run a to_string(),
// which raising an error must never do
throws("no arm matches a list", () -> match ([1]) { [2] => 1 }, "No arm matches list");
throws("no arm matches a map", () -> match ({"a" => 1}) { 1 => 1 }, "No arm matches map");
// A kind and a function name themselves: dispatching on one is what match is for, so a
// visitor that meets a node it does not handle has to say which kind that was
throws("no arm matches a kind", () -> match (kind_of(Loud())) { 1 => 1 }, "No arm matches kind Loud");
throws("no arm matches a function", () -> match (double) { 1 => 1 }, "No arm matches function double");
throws("an object's to_string never runs while the error is raised", () -> match (Loud()) { 1 => 1 }, "No arm matches object");
expect("and it really never ran", @printed, 0);

// An arm's body can raise, and a match is an expression anywhere one goes
throws("an arm that raises", () -> match (1) { 1 => throw "from an arm" }, "from an arm");
expect("a match as a call argument", to_string(match (1) { 1 => 7 }), "7");
$f = $x -> match ($x) { 1 => "one", default => "other" };
expect("a match in a lambda", $f(1), "one");

// A lambda captures the variables an arm's values use, not only its bodies
fn matcher($target, $label) {
    return $x -> match ($x) { $target => $label, default => "miss" };
}
$hit = matcher(7, "seven");
expect("a captured arm value", $hit(7), "seven");
expect("a captured arm body", $hit(8), "miss");
$pair = matcher([1, 2], "the pair");
expect("a captured list arm value", $pair([1, 2]), "the pair");

// Without a subject the arms are conditions, tested for truth as if does, so a chain of
// them is one match rather than an if/else if tower
fn classify($c) {
    return match {
        $c >= "0" && $c <= "9" => "digit",
        $c >= "a" && $c <= "z" => "lower",
        default => "other"
    };
}
expect("a condition arm", classify("7"), "digit");
expect("a later condition arm", classify("q"), "lower");
expect("no condition true", classify("!"), "other");

// Truth, not ==, so a truthy non-bool matches where match (true) would silently miss it
expect("a truthy int is a true condition", match { 1 => "yes", default => "no" }, "yes");
expect("match (true) compares, so it misses", match (true) { 1 => "yes", default => "no" }, "no");
expect("several conditions to an arm read as or", match { "", 0, "x" => "one was true", default => "no" }, "one was true");
expect("a falsy value is not a condition", match { 0 => "yes", default => "no" }, "no");

// Only the conditions before the true one are evaluated, as arm values are
@asked = [];
fn ask($v, $answer) { @asked[] = $v; return $answer; }
expect("stops at the first true condition", match { ask(1, false) => "a", ask(2, true) => "b", ask(3, true) => "c" }, "b");
expect("later conditions never ran", @asked, [1, 2]);

// Nothing true and no default names no value: there was nothing to compare
throws("no condition true and no default", () -> match { false => "never" }, "No arm matched");

// As a statement, with block arms, which is the shape a dispatch loop wants
$c = "q";
$seen = "";
match {
    $c >= "0" && $c <= "9" => { $seen = "digit"; }
    $c >= "a" && $c <= "z" => { $seen = "lower"; $seen ..= "case"; }
    default => {}
}
expect("a subject-less statement match", $seen, "lowercase");

// In an expression a { after => is a map literal, since only a statement's arms are blocks
$m = match (1) { 1 => {"k" => 2} };
expect("a map literal arm", $m, {"k" => 2});
