include "std/test.gaz" use expect, throws;
include "../../../lib/random.gaz";

// Unseeded, only the kind of result can be checked
$shuffled = random::shuffle([1, 2, 3, 4, 5]);
expect("unseeded shuffle keeps the elements", sort($shuffled, ($a, $b) -> $a <=> $b), [1, 2, 3, 4, 5]);
expect("unseeded pick is an element", in_array(random::pick(["a", "b"]), ["a", "b"]), true);
expect("unseeded key is a key", in_array(random::key({"x" => 1, "y" => 2}), ["x", "y"]), true);
expect("unseeded chance is a bool", type_of(random::chance(0.5)), "bool");

// Seeded, the same choices every run and in every runtime
rand_seed(7);
expect("seeded shuffle of a list", random::shuffle([1, 2, 3, 4, 5, 6, 7, 8]), [4, 7, 5, 2, 6, 1, 8, 3]);
expect("seeded shuffle of a string", random::shuffle("abcdefgh"), "fecgbhda");
expect("seeded pick from a list", random::pick([10, 20, 30, 40]), 40);
expect("seeded pick from a map", random::pick({"a" => 1, "b" => 2, "c" => 3}), 3);
expect("seeded key of a list", random::key([10, 20, 30, 40]), 3);
expect("seeded key of a map", random::key({"a" => 1, "b" => 2, "c" => 3}), "b");
expect("seeded chance", map(range_of(10), $i -> random::chance(0.3)), [true, false, false, true, false, true, true, false, true, false]);
expect("seeded weighted", map(range_of(10), $i -> random::weighted([["rare", 1], ["common", 9]])), ["rare", "common", "common", "common", "common", "common", "common", "common", "common", "common"]);
expect("seeded weighted with a total", map(range_of(5), $i -> random::weighted([["x", 0.5], ["y", 1.5]], 2.0)), ["y", "x", "y", "x", "y"]);

fn range_of($n) {
    $list = [];
    for ($i = 0; $i < $n; $i++) {
        $list[] = $i;
    }
    return $list;
}

// The edges
expect("shuffle nothing", [random::shuffle([]), random::shuffle(""), random::shuffle([1])], [[], "", [1]]);
expect("chance 0 and 1", [random::chance(0), random::chance(1), random::chance(0.0), random::chance(1.0)], [false, true, false, true]);
expect("weighted skips a zero weight", random::weighted([["never", 0], ["always", 3]]), "always");
throws("pick of nothing", () -> random::pick([]), "random::key() expects a non-empty list or map");
throws("key of nothing", () -> random::key({}), "random::key() expects a non-empty list or map");
throws("weighted of nothing", () -> random::weighted([]), "random::weighted() expects weights that add up to more than 0");
throws("shuffle of a map", () -> random::shuffle({}), "random::shuffle() expects list or string, got map");
