import "std/test.gaz" use expect, throws;
import "std/lists.gaz" use flatten, max_by, min_by;

expect("flatten joins the lists in order", flatten([[1, 2], [], [3]]), [1, 2, 3]);
expect("flatten goes one level deep", flatten([[[1]], [2, [3]]]), [[1], 2, [3]]);
expect("flatten of nothing", flatten([]), []);
expect("flatten keeps maps whole", flatten([[{"k" => 1}]]), [{"k" => 1}]);

$people = [{"name" => "Ada", "age" => 36}, {"name" => "Bob", "age" => 25}, {"name" => "Cy", "age" => 36}];
expect("max_by gives the element with the largest key", max_by($people, $p -> $p["age"])["name"], "Ada");
expect("min_by gives the smallest", min_by($people, $p -> $p["age"])["name"], "Bob");
expect("max_by gives the first on a tie", max_by([[1, "a"], [2, "b"], [2, "c"]], $x -> $x[0]), [2, "b"]);
expect("min_by gives the first on a tie", min_by([3, 1, 1.0], $x -> $x), 1);
expect("a list of keys breaks ties in order", max_by($people, $p -> [$p["age"], $p["name"]])["name"], "Cy");
expect("max_by of one element", max_by(["only"], $x -> 0), "only");
// A global, since a closure's captured variables are its own
@calls = [];
max_by([5, 6, 7], $x -> { @calls[] = $x; return $x; });
expect("the key is called once for each element, in order", @calls, [5, 6, 7]);

throws("flatten needs a list", () -> flatten({"a" => [1]}), "lists::flatten() expects a list of lists, got map");
throws("flatten needs lists in it", () -> flatten([[1], 2]), "lists::flatten() expects a list of lists, got int among them");
throws("max_by needs a list", () -> max_by({"a" => 1}, $x -> $x), "lists::max_by() expects a non-empty list, got map");
throws("min_by needs something in it", () -> min_by([], $x -> $x), "lists::min_by() expects a non-empty list");
throws("keys must be orderable", () -> max_by([1, "a"], $x -> $x), "Cannot use <=> on string and int");

expect("unique keeps the first of each, in order", lists::unique([3, 1, 3, 2, 1]), [3, 1, 2]);
expect("unique compares with ==: 1 and 1.0 are one, \"1\" another", lists::unique([1, 1.0, "1", true]), [1, "1", true]);
expect("unique of lists and maps compares them whole", lists::unique([[1], [1], {"a" => 1}, {"a" => 1}, [1, 2]]), [[1], {"a" => 1}, [1, 2]]);
expect("unique of nothing", lists::unique([]), []);

$numbers = [1, 2, 3, 4, 5];
expect("group_by keeps the order keys first come", lists::group_by($numbers, $n -> $n % 2 == 0 ? "even" : "odd"), {"odd" => [1, 3, 5], "even" => [2, 4]});
expect("group_by of nothing", lists::group_by([], $n -> $n), {});
expect("group_by takes int keys", lists::group_by(["a", "bb", "cc"], $s -> len($s)), {1 => ["a"], 2 => ["bb", "cc"]});
@keyed = [];
lists::group_by([7, 8], $n -> { @keyed[] = $n; return "k"; });
expect("group_by calls the key once for each element", @keyed, [7, 8]);
expect("count_by counts each key", lists::count_by(["a", "b", "a", "c", "a"], $s -> $s), {"a" => 3, "b" => 1, "c" => 1});
expect("count_by of nothing", lists::count_by([], $s -> $s), {});
expect("partition splits in order", lists::partition($numbers, $n -> $n > 2), [[3, 4, 5], [1, 2]]);
expect("partition reads truthiness", lists::partition([0, 1, "", "a"], $v -> $v), [[1, "a"], [0, ""]]);
expect("partition of nothing", lists::partition([], $n -> true), [[], []]);
[$big, $small] = lists::partition($numbers, $n -> $n > 3);
expect("partition pairs with a list pattern", [$big, $small], [[4, 5], [1, 2, 3]]);
expect("chunk leaves a short last list", lists::chunk($numbers, 2), [[1, 2], [3, 4], [5]]);
expect("chunk that divides evenly", lists::chunk([1, 2, 3, 4], 2), [[1, 2], [3, 4]]);
expect("chunk larger than the list", lists::chunk([1, 2], 5), [[1, 2]]);
expect("chunk of nothing", lists::chunk([], 3), []);
throws("chunk refuses a size below 1", () -> lists::chunk([1], 0), "lists::chunk() expects an int of 1 or more, got 0");
expect("zip pairs up", lists::zip([1, 2], ["a", "b"]), [[1, "a"], [2, "b"]]);
expect("zip stops at the shorter list", lists::zip([1, 2, 3], ["a"]), [[1, "a"]]);
expect("zip stops at the shorter list, other way", lists::zip([1], ["a", "b"]), [[1, "a"]]);
expect("zip of nothing", lists::zip([], [1]), []);
expect("take", lists::take($numbers, 2), [1, 2]);
expect("take more than there is", lists::take([1], 5), [1]);
expect("take none", lists::take($numbers, 0), []);
throws("take refuses a negative count", () -> lists::take($numbers, -1), "lists::take() expects an int of 0 or more, got -1");
expect("drop", lists::drop($numbers, 2), [3, 4, 5]);
expect("drop more than there is", lists::drop([1], 5), []);
expect("drop none", lists::drop([1, 2], 0), [1, 2]);
throws("drop refuses a float count", () -> lists::drop($numbers, 1.5), "lists::drop() expects an int of 0 or more, got 1.5");
$rows = [{"n" => 1, "s" => "a"}, {"n" => 2, "s" => "b"}];
expect("pluck", lists::pluck($rows, "n"), [1, 2]);
expect("pluck of nothing", lists::pluck([], "n"), []);
throws("pluck of a missing key is the map's error", () -> lists::pluck($rows, "x"), Error);
throws("pluck refuses what isn't a map", () -> lists::pluck([1], "n"), "lists::pluck() expects a list of maps, got int among them");
expect("sum_by", lists::sum_by($rows, $r -> $r["n"]), 3);
expect("sum_by of nothing", lists::sum_by([], $r -> 1), 0);
expect("sum_by adds floats", lists::sum_by([0.5, 1], $x -> $x), 1.5);
expect("avg is a float", lists::avg([1, 2]), 1.5);
expect("avg of whole numbers is still a float", lists::avg([2, 4]), 3.0);
throws("avg of nothing is an error", () -> lists::avg([]), "lists::avg() expects a non-empty list");
expect("avg_by", lists::avg_by($rows, $r -> $r["n"]), 1.5);
throws("avg_by of nothing is an error", () -> lists::avg_by([], $r -> 1), "lists::avg_by() expects a non-empty list");
expect("first", lists::first([7, 8]), 7);
throws("first of nothing is an error", () -> lists::first([]), "lists::first() expects a non-empty list");
expect("find gives the first match", lists::find($numbers, $n -> $n > 2), 3);
expect("find gives null when nothing matches", lists::find($numbers, $n -> $n > 9), null);
@seen = [];
lists::find($numbers, $n -> { @seen[] = $n; return $n == 2; });
expect("find stops at the first match", @seen, [1, 2]);
expect("contains_by finds one", lists::contains_by($numbers, $n -> $n == 4), true);
expect("contains_by finds none", lists::contains_by($numbers, $n -> $n == 9), false);
expect("contains_by of nothing", lists::contains_by([], $n -> true), false);
throws("take names a string count as a string", () -> lists::take([1], "x"), "lists::take() expects an int of 0 or more, got \"x\"");
throws("a helper refuses what isn't a list", () -> lists::first("abc"), "lists::first() expects a list, got string");
