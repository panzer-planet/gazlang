import "std/test.gaz" use expect, throws;
import "std/sorting.gaz";

expect("numbers", sorting::values([5, 3, 9, 1, 3]), [1, 3, 3, 5, 9]);
expect("descending", sorting::values([5, 3, 9, 1], true), [9, 5, 3, 1]);
expect("strings compare byte by byte", sorting::values(["b", "B", "a", "10", "9"]), ["10", "9", "B", "a", "b"]);
expect("floats and ints together", sorting::values([2.5, 1, -0.5, 2]), [-0.5, 1, 2, 2.5]);
expect("empty", sorting::values([]), []);
expect("one item", sorting::values(["x"]), ["x"]);
expect("keys are dropped", sorting::values({"z" => 2, "y" => 1}), [1, 2]);

$people = [
    {"name" => "Ada", "team" => "b"},
    {"name" => "Bob", "team" => "a"},
    {"name" => "Cy", "team" => "b"},
    {"name" => "Di", "team" => "a"},
];
$by_team = [];
foreach (sorting::by($people, "team") as $person) {
    $by_team[] = $person["name"];
}
expect("sort_by is stable", $by_team, ["Bob", "Di", "Ada", "Cy"]);
$by_team_descending = [];
foreach (sorting::by($people, "team", true) as $person) {
    $by_team_descending[] = $person["name"];
}
expect("stable when descending too", $by_team_descending, ["Ada", "Cy", "Bob", "Di"]);
expect("sort_by an int key", sorting::by([[3, "c"], [1, "a"], [2, "b"]], 0), [[1, "a"], [2, "b"], [3, "c"]]);

throws("values that can't be ordered", () -> sorting::values([1, "one"]), "Cannot use <=> on string and int");
