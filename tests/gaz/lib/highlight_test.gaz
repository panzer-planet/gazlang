// std/highlight.gaz: the class each piece of source is shown in, and HTML that escapes it all
import "std/highlight.gaz";
import "std/test.gaz" use expect;

// The pieces of some GazLang as "class:text" strings, whitespace left out, for comparing
fn shown(string $language, string $source): list {
    $pieces = filter(highlight::pieces($language, $source), $piece -> trim($piece.text) != "");

    return map($pieces, $piece -> "{$piece.class}:{$piece.text}");
}

// Whether joining the pieces' text gives the source back
fn round_trips(string $language, string $source): bool {
    return join(map(highlight::pieces($language, $source), $piece -> $piece.text), "") == $source;
}

// Every piece as "line:class:text"
fn lined(string $language, string $source): list {
    return map(highlight::pieces($language, $source), $piece -> "{$piece.line}:{$piece.class}:{$piece.text}");
}

// The pieces as "line:class:text", whitespace left out, and a piece of TEXT_TYPE as "line:TEXT:text"
fn typed(string $language, string $source): list {
    $pieces = filter(highlight::pieces($language, $source), $piece -> trim($piece.text) != "");

    return map($pieces, $piece -> {
        $label = $piece.type == highlight::TEXT_TYPE ? "TEXT" : $piece.class;

        return "{$piece.line}:{$label}:{$piece.text}";
    });
}

// The text of every piece with a line break anywhere but at its end
fn spanning(string $language, string $source): list {
    $pieces = filter(highlight::pieces($language, $source), $piece -> contains($piece.text, "\n") && !ends_with($piece.text, "\n"));

    return map($pieces, $piece -> $piece.text);
}

// lines() as lists of "class:text", whitespace left out
fn by_line(string $language, string $source): list {
    return map(highlight::lines($language, $source), $line -> shown_pieces($line));
}

fn shown_pieces(list $pieces): list {
    return map(filter($pieces, $piece -> trim($piece.text) != ""), $piece -> "{$piece.class}:{$piece.text}");
}

// Every class a token can be given
expect("keywords, literals, numbers and operators", shown("gaz", "if (true) { return 1 + 2.5; } else { null; }"),
    ["kw:if", ":(", "lit:true", ":)", ":{", "kw:return", "num:1", "op:+", "num:2.5", ":;", ":}", "kw:else", ":{", "lit:null", ":;", ":}"]);
expect("variables, members and names", shown("gaz", "\$a = @b.c ?? #d.e(#) ?? ##f() ?? \$g?.h;"),
    ["var:\$a", "op:=", "var:@b", "mem:.c", "op:??", "mem:#d", "mem:.e", ":(", "mem:#", ":)", "op:??", "mem:##f", ":(", ":)", "op:??", "var:\$g", "mem:?.h", ":;"]);
expect("a kind or constant, a call, a type and a plain name", shown("gaz", "fn f(int \$n): Point { return g(MAX, x); }"),
    ["kw:fn", "fn:f", ":(", "ty:int", "var:\$n", ":)", "op::", "ty:Point", ":{", "kw:return", "fn:g", ":(", "ty:MAX", ":,", ":x", ":)", ":;", ":}"]);
expect("a kind called is still a kind", shown("gaz", "Point(1)"), ["ty:Point", ":(", "num:1", ":)"]);
expect("a type name called is a call", shown("gaz", "map(\$x, \$f)"), ["fn:map", ":(", "var:\$x", ":,", "var:\$f", ":)"]);
expect("every keyword the lexer knows", shown("gaz", "pub kin static abstract kind shared namespace use"),
    ["kw:pub", "kw:kin", "kw:static", "kw:abstract", "kw:kind", "kw:shared", "kw:namespace", "kw:use"]);

// Comments and whitespace, which the lexer drops, are cut from the source
expect("a line comment", shown("gaz", "1; // one\n2;"), ["num:1", ":;", "com:// one", "num:2", ":;"]);
expect("an opener inside a block comment is text, and the first closer ends it", shown("gaz", "/* a /* b */ 1"), ["com:/* a /* b */", "num:1"]);
expect("a comment at the end", shown("gaz", "1 /* x */"), ["num:1", "com:/* x */"]);
expect("a script's first line", shown("gaz", "#!/usr/bin/env gaz\necho 1;"), ["com:#!/usr/bin/env gaz", "kw:echo", "num:1", ":;"]);

// Strings as they are written, escapes and interpolation included
expect("escapes stay as written", shown("gaz", "\"a\\n\\u\{e9}\\\"\" 'b\\'c'"), ["str:\"a\\n\\u\{e9}\\\"\"", "str:'b\\'c'"]);
expect("an interpolation is its tokens", shown("gaz", "\"x {\$a.b} y \$c[0] z\""),
    ["str:\"x {", "var:\$a", "mem:.b", "str:} y ", "var:\$c[0]", "str: z\""]);
expect("so is a constant's name in braces", shown("gaz", "\"x \{N} y \{k::M}\""),
    ["str:\"x {", "ty:N", "str:} y {", ":k", "op:::", "ty:M", "str:}\""]);
expect("a tag is a call, a keyword before a string still a keyword", shown("gaz", "echo\"a\" tag\"b {\$c}\" q::Sql\"d\";"),
    ["kw:echo", "str:\"a\"", "fn:tag", "str:\"b {", "var:\$c", "str:}\"", ":q", "op:::", "fn:Sql", "str:\"d\"", ":;"]);
expect("a string in an interpolation", shown("gaz", "\"a {\$m[\"k\"]} b\""), ["str:\"a {", "var:\$m", ":[", "str:\"k\"", ":]", "str:} b\""]);

// What the lexer refuses: the tokens before it as read, and plain text from the refused token on
expect("an unterminated string", shown("gaz", "echo \"open"), ["kw:echo", ":\"open"]);
expect("a character the lexer refuses", shown("gaz", "1 ` 2"), ["num:1", ":` 2"]);
expect("an unterminated comment", shown("gaz", "1 /* 2"), ["num:1", ": /* 2"]);
expect("a bad escape", round_trips("gaz", "\"\\q\""), true);
expect("a bad interpolated index", shown("gaz", "\"a \$b[c d]\""), ["str:\"a ", ":\$b[c d]\""]);
expect("a string left open inside its interpolation", shown("gaz", "\"a {\$b"), ["str:\"a {", "var:\$b"]);

// A file being typed keeps its colours above the mistake, and the text below is plain, line by line
const TYPED = "fn f() {\n    return \"ok\"; // fine\n}\n\$x = \"open\n/* not */ fn g() {}\n";
expect("a file with an unclosed string half-way", typed("gaz", TYPED), [
    "1:kw:fn", "1:fn:f", "1::(", "1::)", "1::{", "2:kw:return", "2:str:\"ok\"", "2::;", "2:com:// fine", "3::}",
    "4:var:\$x", "4:op:=", "4:TEXT:\"open\n", "5:TEXT:/* not */ fn g() {}\n",
]);
expect("which round trips", round_trips("gaz", TYPED), true);
expect("only the text from the mistake on is TEXT", map(filter(highlight::gaz(TYPED), $p -> $p.type == highlight::TEXT_TYPE), $p -> $p.line), [4, 5]);
expect("a mistake on the first token is all plain", typed("gaz", "\"open\nmore\n"), ["1:TEXT:\"open\n", "2:TEXT:more\n"]);

// CRLF line ends are kept
expect("CRLF", shown("gaz", "1;\r\n// c\r\n2;\r\n"), ["num:1", ":;", "com:// c\r", "num:2", ":;"]);
expect("CRLF round trips", round_trips("gaz", "fn f() {\r\n    return \"a\r\nb\";\r\n}\r\n"), true);

// No piece spans a line: one that would is cut at each newline, each with the line it is on
expect("a block comment across three lines is three pieces", lined("gaz", "/* a\n * b\n */ 1"),
    ["1:com:/* a\n", "2:com: * b\n", "3:com: */", "3:: ", "3:num:1"]);
expect("a multi-line string the same", lined("gaz", "\$s = \"a\nb\nc\";"),
    ["1:var:\$s", "1:: ", "1:op:=", "1:: ", "1:str:\"a\n", "2:str:b\n", "3:str:c\"", "3::;"]);
expect("a string's interpolation on a later line", lined("gaz", "\"a\n{\$b}\""), ["1:str:\"a\n", "2:str:{", "2:var:\$b", "2:str:}\""]);
expect("whitespace with line breaks", lined("gaz", "1;\n\n    2;"),
    ["1:num:1", "1::;", "1::\n", "2::\n", "3::    ", "3:num:2", "3::;"]);
expect("a line comment ends before its line break", lined("gaz", "// a\n1"), ["1:com:// a", "1::\n", "2:num:1"]);
expect("CRLF is a line end too", lined("gaz", "/* a\r\n */"), ["1:com:/* a\r\n", "2:com: */"]);
expect("the other languages' pieces have lines", lined("gzb", "top\n  RET\n"), ["1:ty:top", "1::\n", "2::  ", "2:kw:RET", "2::\n"]);
expect("so does plain text", lined("text", "a\nb"), ["1::a\n", "2::b"]);
expect("no piece of any language holds a line break inside it", filter(map([
    ["gaz", "/* a\nb */ \"c\nd\" \$e\n\n  // f\n"], ["gzb", "top\n  PUSH \"a\nb\"\n"], ["gazml", "@if (\$a)\n<p>{{ \$a }}</p>\n@endif\n"],
    ["bash", "make # a\nmake\n"], ["text", "a\nb\n"],
], ([$language, $source]) -> spanning($language, $source)), $spanning -> $spanning != []), []);

// lines(): a line's pieces without its line break, one list per line, an empty line an empty list
expect("the lines of a program", by_line("gaz", "fn f() {\n\n    return 1; // one\n}"),
    [["kw:fn", "fn:f", ":(", ":)", ":{"], [], ["kw:return", "num:1", ":;", "com:// one"], [":}"]]);
expect("the last line without a line break is a line, and with one no extra line", [len(highlight::lines("gaz", "a\nb")), len(highlight::lines("gaz", "a\nb\n"))], [2, 2]);
expect("an empty source has no lines, a line break one empty line", [highlight::lines("gaz", ""), highlight::lines("gaz", "\n")], [[], [[]]]);
expect("a block comment's lines", by_line("gaz", "/* a\n */ 1"), [["com:/* a"], ["com: */", "num:1"]]);
expect("a line's pieces carry its number", map(highlight::lines("gaz", "1\n\n3")[2], $p -> $p.line), [3]);
expect("the lines of a file being typed are plain below the mistake", by_line("gaz", "1;\n\"open\n2;"), [["num:1", ":;"], [":\"open"], [":2;"]]);
expect("joining a line's pieces gives the line", join(map(highlight::lines("gaz", "\$a = \"b\n  c\";")[1], $p -> $p.text), ""), "  c\";");

// HTML: every piece escaped, a class a span, and the pieces a newline cut from one run one span
expect("a block comment across lines is one span", highlight::to_html("gaz", "/* a\n */ 1").text, "<span class=\"com\">/* a\n */</span> <span class=\"num\">1</span>");
expect("a multi-line string is one span", highlight::to_html("gaz", "\"a\nb\"").text, "<span class=\"str\">&quot;a\nb&quot;</span>");
expect("two members are still two spans", highlight::to_html("gaz", "#a.b").text, "<span class=\"mem\">#a</span><span class=\"mem\">.b</span>");
expect("a string's line break before its interpolation", highlight::to_html("gaz", "\"a\n\$b\"").text, "<span class=\"str\">&quot;a\n</span><span class=\"var\">\$b</span><span class=\"str\">&quot;</span>");

// HTML: every piece escaped, a class a span
expect("HTML is an Html, so nothing escapes it again", kind_of(highlight::to_html("gaz", "1")) == Html, true);
expect("HTML is escaped", highlight::to_html("gaz", "\$a < \"<b>&'\" // <i>").text,
    "<span class=\"var\">\$a</span> <span class=\"op\">&lt;</span> <span class=\"str\">&quot;&lt;b&gt;&amp;&#39;&quot;</span> <span class=\"com\">// &lt;i&gt;</span>");
expect("plain text is escaped", highlight::to_html("", "<a href=\"x\">&</a>").text, "&lt;a href=&quot;x&quot;&gt;&amp;&lt;/a&gt;");
expect("a language without a highlighter is plain", shown("text", "echo 1;"), [":echo 1;"]);

// Bytecode, a line at a time
expect("bytecode headers and instructions", shown("gzb", "GAZLANG BYTECODE 3\nglobals @total\nfn f 1 2 in K\n  LOAD \$a\n  JMP L1\nlocals \$a \$#b\n"),
    ["kw:GAZLANG BYTECODE", "num:3", "ty:globals", "var:@total", "ty:fn", ":f", "num:1", "num:2", "kw:in", "ty:K", "kw:LOAD", "var:\$a", "kw:JMP", "ty:L1", "ty:locals", "var:\$a", "var:\$#b"]);
expect("a bytecode value is a literal", shown("gzb", "PUSH {\"a\" => [-1, 2.5]}\n@ \"lib/x.gaz\" 42"),
    ["kw:PUSH", ":{", "str:\"a\"", "op:=>", ":[", "op:-", "num:1", ":,", "num:2.5", ":]", ":}", "op:@", "str:\"lib/x.gaz\"", "num:42"]);
expect("bytecode round trips", round_trips("gzb", "top\r\n  PUSH \"a b\"  \n\n  RET\nlocals"), true);

// Templates: directives, {{ }}, {!! !!}, comments, and @{{ as text
expect("a template", shown("gazml", "@template p(\$u)\n<b>{{ \$u.name }}</b> {!! \$raw !!} {{-- note --}} @{{ x\n  @endif\n"),
    ["kw:@template", "fn:p", ":(", "var:\$u", ":)", ":<b>", "op:{{", "var:\$u", "mem:.name", "op:}}", ":</b> ", "op:{!!", "var:\$raw", "op:!!}", "com:{{-- note --}}", ": @{{ x\n", "kw:@endif"]);
expect("an unclosed {{ is text", shown("gazml", "a {{ b"), [":a {{ b"]);
expect("a template round trips", round_trips("gazml", "@if (\$a)\r\n  <p>{{ \$a }} {{ ` }}</p>\r\n@endif"), true);

// Shell: a comment, not a # inside quotes
expect("a shell comment", shown("bash", "make -C vm  # build\necho '#no' \"#no\" a#b\n"),
    [":make -C vm  ", "com:# build", ":echo '#no' \"#no\" a#b\n"]);
