include "std/test.gaz" use expect;
include "std/chars.gaz" use char_at, is_char, is_digit, is_hex_digit, is_alpha, is_alnum, is_space, span;

// char_at stays inside the string
expect("char_at first", char_at("abc", 0), "a");
expect("char_at last", char_at("abc", 2), "c");
expect("char_at past the end", char_at("abc", 3), "");
expect("char_at negative", char_at("abc", -1), "");
expect("char_at empty string", char_at("", 0), "");

// span: how long a run of characters satisfying a predicate is
expect("span of a number", span("123abc", 0, is_digit), 3);
expect("span from an offset", span("123abc", 3, is_alpha), 3);
expect("span is 0 when the first doesn't", span("abc", 0, is_digit), 0);
expect("span of everything", span("abc", 0, is_alpha), 3);
expect("span at the end", span("abc", 3, is_alpha), 0);
expect("span past the end", span("abc", 9, is_alpha), 0);
expect("span before the start", span("abc", -1, is_alpha), 0);
expect("span of nothing", span("", 0, is_alpha), 0);
expect("span with a lambda", span("xxxy", 0, $c -> $c == "x"), 3);
expect("span reaches the end of the string", span("xxx", 0, $c -> $c == "x"), 3);
expect("span reads bytes", span("é1", 0, $c -> $c != "1"), 2);
expect("span with a qualified name", chars::span("12x", 0, chars::is_digit), 2);
expect("span cuts a token out", slice("ab12 cd", 2, span("ab12 cd", 2, is_digit)), "12");

/* The predicate is called for each character that satisfies it and for the one that doesn't, and then no more */
kind Watcher {
    pub #calls = 0;
    pub fn wants_a($c) {
        #calls++;
        return $c == "a";
    }
}
$watcher = Watcher();
expect("span stops at the first that fails", span("aabaa", 0, $watcher.wants_a), 2);
expect("span called the predicate no more than it had to", $watcher.calls, 3);

// Boundaries: the characters either side of each range
expect("digit below 0", is_digit("/"), false);
expect("digit 0", is_digit("0"), true);
expect("digit 9", is_digit("9"), true);
expect("digit above 9", is_digit(":"), false);
expect("alpha below A", is_alpha("@"), false);
expect("alpha A", is_alpha("A"), true);
expect("alpha Z", is_alpha("Z"), true);
expect("alpha above Z", is_alpha("["), false);
expect("alpha below a", is_alpha("`"), false);
expect("alpha a", is_alpha("a"), true);
expect("alpha z", is_alpha("z"), true);
expect("alpha above z", is_alpha("{"), false);
expect("underscore is not alpha", is_alpha("_"), false);
expect("hex digit 9", is_hex_digit("9"), true);
expect("hex digit f", is_hex_digit("f"), true);
expect("hex digit F", is_hex_digit("F"), true);
expect("hex digit above f", is_hex_digit("g"), false);
expect("hex digit above F", is_hex_digit("G"), false);
expect("hex digit two characters", is_hex_digit("ab"), false);
expect("alnum digit", is_alnum("7"), true);
expect("alnum letter", is_alnum("q"), true);
expect("alnum underscore", is_alnum("_"), false);

expect("space", is_space(" "), true);
expect("tab", is_space("\t"), true);
expect("newline", is_space("\n"), true);
expect("carriage return", is_space("\r"), true);
expect("not space", is_space("x"), false);

// Only single characters count; anything else is false, not an error
expect("digit two characters", is_digit("12"), false);
expect("alpha empty string", is_alpha(""), false);
expect("space two spaces", is_space("  "), false);
expect("digit null", is_digit(null), false);
expect("alpha number", is_alpha(5), false);
expect("alnum past the end", is_alnum(char_at("ab", 2)), false);
