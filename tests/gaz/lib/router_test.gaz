import "std/test.gaz" use expect, throws;
import "std/http.gaz";

fn request($method, $path, $query = "") {
    return {"method" => $method, "path" => $path, "query" => $query, "headers" => {}, "body" => ""};
}

fn body($text) {
    return {"body" => $text};
}

$app = http::Router();
$app.get("/", $r -> body("home"));
$app.get("/users/:id", $r -> body("user " .. $r["params"]["id"]));
$app.get("/users/:id/posts/:post", $r -> body("post " .. $r["params"]["post"] .. " of " .. $r["params"]["id"]));
$app.post("/users", $r -> ({"status" => 201, "body" => "made"}));
$app.delete("/users/:id", $r -> body("gone " .. $r["params"]["id"]));
$app.route("OPTIONS", "/users", $r -> body("options"));
$app.get("/about/", $r -> body("about"));
$app.get("/first", $r -> body("first"));
$app.get("/first", $r -> body("second"));
$handle = $app.handler();

/* Matching */
expect("a literal path", $handle(request("GET", "/")), body("home"));
expect(":name takes a segment", $handle(request("GET", "/users/7")), body("user 7"));
expect("two names", $handle(request("GET", "/users/7/posts/3")), body("post 3 of 7"));
expect("a name is percent-decoded", $handle(request("GET", "/users/caf%C3%A9")), body("user café"));
expect("a %2F is a / in the value, not a separator", $handle(request("GET", "/users/a%2Fb")), body("user a/b"));
expect("the handler gets the request, with its params", $handle(request("GET", "/users/7")) == body("user 7"), true);
expect("the first route that matches wins", $handle(request("GET", "/first")), body("first"));
expect("other methods by name", [$handle(request("POST", "/users"))["status"], $handle(request("DELETE", "/users/9")), $handle(request("OPTIONS", "/users"))], [201, body("gone 9"), body("options")]);
expect("a GET route answers HEAD", $handle(request("HEAD", "/users/7")), body("user 7"));

/* What matches nothing */
$wrong_method = $handle(request("PUT", "/users/7"));
expect("a path with other methods is a 405 naming them", [$wrong_method["status"], $wrong_method["headers"]["Allow"]], [405, "GET, DELETE, HEAD"]);
expect("a path nothing has is a 404", $handle(request("GET", "/nope")), {"status" => 404, "headers" => {"Content-Type" => "text/plain"}, "body" => "Not Found\n"});
expect("more segments than a route is a 404", $handle(request("GET", "/users/7/extra"))["status"], 404);
expect("a bad escape is a 400", $handle(request("GET", "/users/%zz"))["status"], 400);
expect("a param that isn't UTF-8 is a 400", $handle(request("GET", "/users/%ff"))["status"], 400);
expect("a raw byte that isn't UTF-8 is a 400", $handle(request("GET", "/users/a\xffb"))["status"], 400);
expect("a param of UTF-8 is decoded", $handle(request("GET", "/users/%C3%A9")), body("user é"));

/* The other spelling of a path, with and without its trailing slash */
expect("a slash taken away", $handle(request("GET", "/users/7/", "tab=1")), {"status" => 308, "headers" => {"Location" => "/users/7?tab=1"}, "body" => ""});
expect("a slash added", $handle(request("GET", "/about"))["headers"]["Location"], "/about/");
expect("a :name is never empty, so /users/ is /users", $handle(request("GET", "/users/"))["headers"]["Location"], "/users");
expect("no other spelling: a 404", $handle(request("GET", "/nope/"))["status"], 404);

/* A 404 of your own */
$custom = http::Router();
$custom.not_found($r -> ({"status" => 404, "body" => "no page at " .. $r["path"]}));
expect("not_found()", $custom.handler()(request("GET", "/x")), {"status" => 404, "body" => "no page at /x"});

/* Middleware wraps everything, the first added outermost */
$layered = http::Router();
$layered.get("/", $r -> body($r["seen"]));
$layered.use(($r, $next) -> {
    $r["seen"] = "outer";
    $response = $next($r);
    $response["body"] ..= " < outer";
    return $response;
});
$layered.use(($r, $next) -> {
    $r["seen"] ..= " > inner";
    $response = $next($r);
    $response["body"] ..= " < inner";
    return $response;
});
expect("middleware runs in the order added, and back out", $layered.handler()(request("GET", "/"))["body"], "outer > inner < inner < outer");
expect("middleware sees a 404 too", $layered.handler()(request("GET", "/x"))["body"], "Not Found\n < inner < outer");
$short = http::Router();
$short.get("/", $r -> body("never"));
$short.use(($r, $next) -> ({"status" => 401, "body" => "log in first"}));
expect("middleware can answer itself", $short.handler()(request("GET", "/")), {"status" => 401, "body" => "log in first"});

/* A route is checked when it is added */
$failures = [];
foreach (["users", "/users/:", "/a/:id/b/:id", 5] as $pattern) {
    try {
        http::Router().get($pattern, $r -> null);
        $failures[] = "no error for $pattern";
    } catch (Error $e) {
        $failures[] = $e.message;
    }
}
expect("bad patterns", $failures, [
    "A route's pattern starts with /, got \"users\"",
    "A : in a route's pattern needs a name: /users/:",
    "A route's pattern names :id twice: /a/:id/b/:id",
    "A route's pattern starts with /, got 5",
]);

/* Groups: middleware for a set of routes, a prefix for their paths */

// Middleware that marks the body it wraps, to show what ran and in which order
fn marked($mark) {
    return ($r, $next) -> {
        $response = $next($r);

        return {...$response, "body" => $mark .. "(" .. ($response["body"] ?? "") .. ")"};
    };
}

$grouped = http::Router();
$grouped.use(marked("app"));
$grouped.get("/open", $r -> body("open"));
$grouped.middleware(marked("login")).group($routes -> {
    $routes.get("/home", $r -> body("home"));
    $routes.post("/todos", $r -> body("made"));
    $routes.middleware(marked("owner")).delete("/todos/:id", $r -> body("gone " .. $r["params"]["id"]));
});
$grouped.prefix("/admin").middleware(marked("admin")).group($admin -> {
    $admin.get("/", $r -> body("dashboard"));
    $admin.prefix("/users").get("/:id", $r -> body("user " .. $r["params"]["id"]));
});
$kept = $grouped.middleware(marked("kept"));
$kept.get("/kept", $r -> body("kept"));
$grouped.get("/home", $r -> body("never: the group's route was added first"));
$serve = $grouped.handler();
expect("a route outside the group has only the router's middleware", $serve(request("GET", "/open")), body("app(open)"));
expect("one in it has the group's too, inside the router's", $serve(request("GET", "/home")), body("app(login(home))"));
expect("for every method", $serve(request("POST", "/todos")), body("app(login(made))"));
expect("a nested group's middleware runs inside the outer one's", $serve(request("DELETE", "/todos/4")), body("app(login(owner(gone 4)))"));
expect("a prefix: / under it is the prefix itself", $serve(request("GET", "/admin")), body("app(admin(dashboard))"));
expect("prefixes add up, with params after them", $serve(request("GET", "/admin/users/9")), body("app(admin(user 9))"));
expect("a group kept in a variable", $serve(request("GET", "/kept")), body("app(kept(kept))"));
expect("a group's routes match in the order added among the router's", $serve(request("GET", "/home")), body("app(login(home))"));
expect("a path no route has gets no group's middleware", $serve(request("GET", "/admin/nope")), {"status" => 404, "headers" => {"Content-Type" => "text/plain"}, "body" => "app(Not Found\n)"});
expect("nor does a 405", $serve(request("PUT", "/home"))["status"], 405);
expect("nor a trailing slash's redirect", $serve(request("GET", "/admin/"))["status"], 308);
throws("a prefix ending in /", () -> http::Router().prefix("/admin/"), "A group's prefix starts with / and doesn't end with one, got \"/admin/\"");
throws("or not starting with one", () -> http::Router().prefix("admin"), "A group's prefix starts with / and doesn't end with one, got \"admin\"");
throws("middleware that isn't a function", () -> http::Router().middleware("auth"), "Middleware is a function of a request and the next handler, not string");
throws("for the router's own too", () -> http::Router().use("auth"), "Middleware is a function of a request and the next handler, not string");
throws("a prefix of / alone", () -> http::Router().prefix("/"), "A group's prefix of / adds nothing: give the group middleware() alone");
throws("a prefix's segments are checked when it is given", () -> http::Router().prefix("/a/:"), "A : in a route's pattern needs a name: /a/:");
throws("a pattern in a group is checked as the router checks one", () -> http::Router().prefix("/a").get("users", $r -> null), "A route's pattern starts with /, got \"users\"");
