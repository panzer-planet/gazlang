import "std/test.gaz" use expect, throws;
import "std/regex.gaz";

expect("literal match", regex::matches("cat", "cat"), true);
expect("literal too long fails full match", regex::matches("cats", "cat"), false);
expect("dot matches any byte", regex::matches("cat", "c.t"), true);
expect("star matches zero", regex::matches("ct", "ca*t"), true);
expect("star matches many", regex::matches("caaaat", "ca*t"), true);
expect("plus needs at least one", regex::matches("ct", "ca+t"), false);
expect("plus matches one", regex::matches("cat", "ca+t"), true);
expect("opt matches zero", regex::matches("ct", "ca?t"), true);
expect("opt matches one", regex::matches("cat", "ca?t"), true);
expect("alternation left", regex::matches("cat", "cat|dog"), true);
expect("alternation right", regex::matches("dog", "cat|dog"), true);
expect("alternation neither", regex::matches("bird", "cat|dog"), false);
expect("three-way alternation", regex::matches("bird", "cat|dog|bird"), true);
expect("group with star", regex::matches("abab", "(ab)*"), true);
expect("group with star, zero reps", regex::matches("", "(ab)*"), true);
expect("group with star rejects partial rep", regex::matches("aba", "(ab)*"), false);
expect("nested group and opt", regex::matches("ababab", "(a(b)?)*"), true);

expect("class range hit", regex::matches("5", "[0-9]"), true);
expect("class range miss", regex::matches("x", "[0-9]"), false);
expect("class list", regex::matches("y", "[xyz]"), true);
expect("negated class hit", regex::matches("x", "[^0-9]"), true);
expect("negated class miss", regex::matches("5", "[^0-9]"), false);
expect("class with trailing dash is literal", regex::matches("-", "[a-]"), true);
expect("class with leading caret-as-content", regex::matches("^", "[\\^]"), true);

expect("matches is anchored at both ends", regex::matches("xcatx", "cat"), false);
expect("search finds a substring", regex::search("xcatx", "cat"), true);
expect("search finds nothing", regex::search("dog", "cat"), false);
expect("find gives the start index", regex::find("xxcatxx", "cat"), 2);
expect("find is leftmost", regex::find("catcat", "cat"), 0);
expect("find gives null when absent", regex::find("dog", "cat"), null);
expect("find on an empty pattern is position 0", regex::find("abc", ""), 0);
expect("matches an empty pattern only on an empty string", regex::matches("", ""), true);
expect("matches an empty pattern rejects a non-empty string", regex::matches("x", ""), false);

expect("explicit anchors act like a full match inside search", regex::search("xxcatxx", "^cat$"), false);
expect("explicit anchors satisfied", regex::search("cat", "^cat$"), true);
expect("caret only matches at position 0", regex::find("acat", "^cat"), null);
expect("dollar only matches at the end", regex::find("catx", "cat$"), null);
expect("dollar matches at the end", regex::find("xcat", "cat$"), 1);

expect("backslash escapes a metacharacter", regex::matches("c.t", "c\\.t"), true);
expect("an escaped dot no longer matches any byte", regex::matches("cat", "c\\.t"), false);

expect("a small email-shaped pattern", regex::matches("a@b.com", "[a-z]+@[a-z]+\\.[a-z]+"), true);
expect("the same pattern rejects a bare word", regex::matches("nope", "[a-z]+@[a-z]+\\.[a-z]+"), false);

throws("an unclosed group is a catchable error", () -> regex::matches("x", "(abc"), "regex: expected ')' at 4 in /(abc/");

throws("an unclosed class is a catchable error", () -> regex::matches("x", "[abc"), "regex: unterminated '[' in /[abc/");

throws("a stray ')' is a catchable error", () -> regex::matches("x", "abc)"), "regex: unexpected ')' at 3 in /abc)/");

/* Which match: the leftmost, and there Perl's, the greedy and the earlier alternative first */
expect("find is leftmost even when a later start matches first", regex::find("abcd", "abcd|c"), 0);
expect("find of an anchor at the end", regex::find("ab", "$"), 2);
expect("the earlier alternative wins", regex::groups("abab", "(a|ab)(b*)"), ["ab", "a", "b"]);
expect("the first repetition is greedy", regex::groups("aab", "(a*)(a*)b"), ["aab", "aa", ""]);
expect("a lazy-looking optional is greedy too", regex::groups("ab", "(a?)(ab)?b"), ["ab", "a", null]);

/* groups(): the whole match first, then each group by its "(" from the left */
expect("groups", regex::groups("key = value", "([a-z]+) *= *([a-z]+)"), ["key = value", "key", "value"]);
expect("groups in the first match only", regex::groups("a1 b2", "([a-z])([0-9])"), ["a1", "a", "1"]);
expect("nested groups count by their (", regex::groups("ab", "((a)(b))"), ["ab", "ab", "a", "b"]);
expect("a group that takes no part is null", regex::groups("ab", "(x)?(a)(b)"), ["ab", null, "a", "b"]);
expect("a repeated group keeps its last", regex::groups("abc", "([a-c])+"), ["abc", "c"]);
expect("a group can take nothing", regex::groups("ab", "a(x*)b"), ["ab", ""]);
expect("no groups is the match alone", regex::groups("xabx", "ab"), ["ab"]);
expect("an empty match", regex::groups("xyz", "a*"), [""]);
expect("groups of no match is null", regex::groups("zzz", "a"), null);
expect("groups respects anchors", [regex::groups("xa", "^(a)"), regex::groups("ax", "(a)$")], [null, null]);

/* replace(): every match, left to right, not overlapping, the text taken as it is */
expect("replace", regex::replace("hello world", "o", "0"), "hell0 w0rld");
expect("replace a class", regex::replace("a1b22c333", "[0-9]+", "#"), "a#b#c#");
expect("replace an escaped dot", regex::replace("a.b.c", "\\.", "::"), "a::b::c");
expect("replace without a match", regex::replace("abc", "x", "y"), "abc");
expect("replace doesn't overlap", regex::replace("aaaa", "aa", "b"), "bb");
expect("replace takes $1 as it is", regex::replace("ab", "(a)", "$1"), "$1b");
expect("replace with nothing", regex::replace("a-b-c", "-", ""), "abc");
expect("replace at the start only", regex::replace("aaa", "^a", "b"), "baa");
expect("replace at the end only", regex::replace("aaa", "a$", "b"), "aab");
expect("an empty match moves on a byte", regex::replace("abc", "x*", "-"), "-a-b-c-");
expect("an empty match after a match", regex::replace("baaac", "a*", "-"), "-b--c-");
expect("an empty string", regex::replace("", "x*", "-"), "-");
expect("an empty pattern", regex::replace("ab", "", "."), ".a.b.");

/* Linear time: what would take a backtracking engine 2^200 steps */
expect("no catastrophic backtracking", regex::matches(repeat("a", 200), "(a*)*b"), false);
expect("nor in replace", regex::replace(repeat("ab", 3), "(a*)*", "-"), "--b--b--b-");
