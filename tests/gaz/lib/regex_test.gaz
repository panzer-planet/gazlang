include "../check.gaz";
include "../../../lib/regex.gaz";

check("literal match", regex::matches("cat", "cat"), true);
check("literal too long fails full match", regex::matches("cats", "cat"), false);
check("dot matches any byte", regex::matches("cat", "c.t"), true);
check("star matches zero", regex::matches("ct", "ca*t"), true);
check("star matches many", regex::matches("caaaat", "ca*t"), true);
check("plus needs at least one", regex::matches("ct", "ca+t"), false);
check("plus matches one", regex::matches("cat", "ca+t"), true);
check("opt matches zero", regex::matches("ct", "ca?t"), true);
check("opt matches one", regex::matches("cat", "ca?t"), true);
check("alternation left", regex::matches("cat", "cat|dog"), true);
check("alternation right", regex::matches("dog", "cat|dog"), true);
check("alternation neither", regex::matches("bird", "cat|dog"), false);
check("three-way alternation", regex::matches("bird", "cat|dog|bird"), true);
check("group with star", regex::matches("abab", "(ab)*"), true);
check("group with star, zero reps", regex::matches("", "(ab)*"), true);
check("group with star rejects partial rep", regex::matches("aba", "(ab)*"), false);
check("nested group and opt", regex::matches("ababab", "(a(b)?)*"), true);

check("class range hit", regex::matches("5", "[0-9]"), true);
check("class range miss", regex::matches("x", "[0-9]"), false);
check("class list", regex::matches("y", "[xyz]"), true);
check("negated class hit", regex::matches("x", "[^0-9]"), true);
check("negated class miss", regex::matches("5", "[^0-9]"), false);
check("class with trailing dash is literal", regex::matches("-", "[a-]"), true);
check("class with leading caret-as-content", regex::matches("^", "[\\^]"), true);

check("matches is anchored at both ends", regex::matches("xcatx", "cat"), false);
check("search finds a substring", regex::search("xcatx", "cat"), true);
check("search finds nothing", regex::search("dog", "cat"), false);
check("find gives the start index", regex::find("xxcatxx", "cat"), 2);
check("find is leftmost", regex::find("catcat", "cat"), 0);
check("find gives null when absent", regex::find("dog", "cat"), null);
check("find on an empty pattern is position 0", regex::find("abc", ""), 0);
check("matches an empty pattern only on an empty string", regex::matches("", ""), true);
check("matches an empty pattern rejects a non-empty string", regex::matches("x", ""), false);

check("explicit anchors act like a full match inside search", regex::search("xxcatxx", "^cat$"), false);
check("explicit anchors satisfied", regex::search("cat", "^cat$"), true);
check("caret only matches at position 0", regex::find("acat", "^cat"), null);
check("dollar only matches at the end", regex::find("catx", "cat$"), null);
check("dollar matches at the end", regex::find("xcat", "cat$"), 1);

check("backslash escapes a metacharacter", regex::matches("c.t", "c\\.t"), true);
check("an escaped dot no longer matches any byte", regex::matches("cat", "c\\.t"), false);

check("a small email-shaped pattern", regex::matches("a@b.com", "[a-z]+@[a-z]+\\.[a-z]+"), true);
check("the same pattern rejects a bare word", regex::matches("nope", "[a-z]+@[a-z]+\\.[a-z]+"), false);

try {
    regex::matches("x", "(abc");
} catch ($e) {
    check("an unclosed group is a catchable error", $e.message, "regex: expected ')' at 4 in /(abc/");
}

try {
    regex::matches("x", "[abc");
} catch ($e) {
    check("an unclosed class is a catchable error", $e.message, "regex: unterminated '[' in /[abc/");
}

try {
    regex::matches("x", "abc)");
} catch ($e) {
    check("a stray ')' is a catchable error", $e.message, "regex: unexpected ')' at 3 in /abc)/");
}

/* Which match: the leftmost, and there Perl's, the greedy and the earlier alternative first */
check("find is leftmost even when a later start matches first", regex::find("abcd", "abcd|c"), 0);
check("find of an anchor at the end", regex::find("ab", "$"), 2);
check("the earlier alternative wins", regex::groups("abab", "(a|ab)(b*)"), ["ab", "a", "b"]);
check("the first repetition is greedy", regex::groups("aab", "(a*)(a*)b"), ["aab", "aa", ""]);
check("a lazy-looking optional is greedy too", regex::groups("ab", "(a?)(ab)?b"), ["ab", "a", null]);

/* groups(): the whole match first, then each group by its "(" from the left */
check("groups", regex::groups("key = value", "([a-z]+) *= *([a-z]+)"), ["key = value", "key", "value"]);
check("groups in the first match only", regex::groups("a1 b2", "([a-z])([0-9])"), ["a1", "a", "1"]);
check("nested groups count by their (", regex::groups("ab", "((a)(b))"), ["ab", "ab", "a", "b"]);
check("a group that takes no part is null", regex::groups("ab", "(x)?(a)(b)"), ["ab", null, "a", "b"]);
check("a repeated group keeps its last", regex::groups("abc", "([a-c])+"), ["abc", "c"]);
check("a group can take nothing", regex::groups("ab", "a(x*)b"), ["ab", ""]);
check("no groups is the match alone", regex::groups("xabx", "ab"), ["ab"]);
check("an empty match", regex::groups("xyz", "a*"), [""]);
check("groups of no match is null", regex::groups("zzz", "a"), null);
check("groups respects anchors", [regex::groups("xa", "^(a)"), regex::groups("ax", "(a)$")], [null, null]);

/* replace(): every match, left to right, not overlapping, the text taken as it is */
check("replace", regex::replace("hello world", "o", "0"), "hell0 w0rld");
check("replace a class", regex::replace("a1b22c333", "[0-9]+", "#"), "a#b#c#");
check("replace an escaped dot", regex::replace("a.b.c", "\\.", "::"), "a::b::c");
check("replace without a match", regex::replace("abc", "x", "y"), "abc");
check("replace doesn't overlap", regex::replace("aaaa", "aa", "b"), "bb");
check("replace takes $1 as it is", regex::replace("ab", "(a)", "$1"), "$1b");
check("replace with nothing", regex::replace("a-b-c", "-", ""), "abc");
check("replace at the start only", regex::replace("aaa", "^a", "b"), "baa");
check("replace at the end only", regex::replace("aaa", "a$", "b"), "aab");
check("an empty match moves on a byte", regex::replace("abc", "x*", "-"), "-a-b-c-");
check("an empty match after a match", regex::replace("baaac", "a*", "-"), "-b--c-");
check("an empty string", regex::replace("", "x*", "-"), "-");
check("an empty pattern", regex::replace("ab", "", "."), ".a.b.");

/* Linear time: what would take a backtracking engine 2^200 steps */
check("no catastrophic backtracking", regex::matches(repeat("a", 200), "(a*)*b"), false);
check("nor in replace", regex::replace(repeat("ab", 3), "(a*)*", "-"), "--b--b--b-");
