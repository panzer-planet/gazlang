include "std/test.gaz" use expect, throws;
include "../../../lib/db.gaz";

// What a failing call raises, or null
fn failure($f) {
    try {
        $f();
    } catch ($e) {
        return $e.message;
    }
    return null;
}

$db = db::open("sqlite::memory:");
expect("the handle is its own type", type_of(db_open("sqlite::memory:")), "db");
expect("a script makes tables", $db.run("create table t (id integer primary key, name text, score real, note text); insert into t (name, score) values ('seed', 0.5);"), {"rows" => [], "changes" => 1});
expect("exec gives the rows changed", $db.exec("insert into t (name, score, note) values (?, ?, ?), (?, ?, ?)", ["a", 2, null, "b", true, "x"]), 2);
expect("query gives maps", $db.query("select id, name, score, note from t order by id"), [
    {"id" => 1, "name" => "seed", "score" => 0.5, "note" => null},
    {"id" => 2, "name" => "a", "score" => 2.0, "note" => null},
    {"id" => 3, "name" => "b", "score" => 1.0, "note" => "x"},
]);
expect("row", $db.row("select name from t where id = ?", [2]), {"name" => "a"});
expect("row of nothing", $db.row("select name from t where id = ?", [99]), null);
expect("value", $db.value("select count(*) from t"), 3);
expect("value of nothing", $db.value("select name from t where id = 99"), null);
expect("a select changes nothing, whatever ran before", $db.run("select * from t")["changes"], 0);
expect("update counts what it changed", $db.exec("update t set score = score + 1 where id > ?", [1]), 2);
expect("returning gives rows and changes", $db.run("delete from t where id = ? returning name", [3]), {"rows" => [{"name" => "b"}], "changes" => 1});
expect("a script gives its last result", $db.query("select 1 as a; select 2 as b"), [{"b" => 2}]);
expect("a comment after the statement", $db.query("select 1 as a; -- done"), [{"a" => 1}]);
expect("a comment after the statement, with parameters", $db.query("select ? as a -- by id", [1]), [{"a" => 1}]);
expect("nothing to run", $db.run(" "), {"rows" => [], "changes" => 0});
expect("strings that look like SQL are only strings", [$db.exec("insert into t (name) values (?)", ["x'); drop table t; --"]), $db.value("select count(*) from t")], [1, 3]);
expect("bytes pass through", $db.value("select ?", ["é\0\xff"]), "é\0\xff");
expect("floats keep their digits", $db.value("select ?", [0.1 + 0.2]), 0.30000000000000004);
expect("big ints", $db.value("select ?", [9223372036854775807]), 9223372036854775807);
expect("a column named twice keeps the last", $db.row("select 1 as a, 2 as a"), {"a" => 2});

throws("a bad statement", () -> $db.query("select nope"), "sqlite: no such column: nope");
throws("too few parameters", () -> $db.query("select ?"), "sqlite: the SQL takes 1 parameter, got 0");
throws("too many parameters", () -> $db.query("select 1", [1, 2]), "sqlite: the SQL takes 0 parameters, got 2");
throws("a list can't be a parameter", () -> $db.query("select ?", [[1]]), "sqlite: parameter 1 is a list, which cannot be stored");
throws("parameters need one statement", () -> $db.query("select ?; select ?", [1, 2]), "sqlite: parameters need a single statement");
throws("a failed statement changes nothing", () -> $db.exec("insert into t (id) values (?)", [1]), "sqlite: UNIQUE constraint failed: t.id");
throws("infinity is not a float here", () -> $db.value("select 1e999"), "sqlite: column 1e999 is infinite, and floats are always finite");

expect("a transaction gives what its work returns", $db.transaction($d -> { $d.exec("delete from t"); return $d.value("select count(*) from t"); }), 0);
expect("and commits", $db.value("select count(*) from t"), 0);
$db.exec("insert into t (name) values ('kept')");
throws("it rolls back and raises again when the work raises", () -> $db.transaction($d -> { $d.exec("delete from t"); throw "boom"; }), "boom");
expect("and nothing was deleted", $db.value("select count(*) from t"), 1);
expect("an inner transaction rolls back alone", $db.transaction($d -> {
    $d.exec("insert into t (name) values ('outer')");
    $inner = failure(() -> $d.transaction($x -> { $x.exec("delete from t"); throw "inner"; }));
    return [$inner, $d.value("select count(*) from t")];
}), ["inner", 2]);
expect("the outer one committed", $db.value("select count(*) from t"), 2);
throws("an error from the database rolls back too", () -> $db.transaction($d -> { $d.exec("delete from t"); $d.exec("nonsense"); }), "sqlite: near \"nonsense\": syntax error");
expect("and the delete is undone", $db.value("select count(*) from t"), 2);

$db.close();
$db.close();
throws("a closed database", () -> $db.query("select 1"), "db_run() on a closed database");
throws("an unknown scheme", () -> db::open("mysql://localhost/x"), "db_open() expects a URL starting sqlite: or postgres:, got mysql://localhost/x");
throws("no path", () -> db::open("sqlite:"), "sqlite: no path: write sqlite:FILE or sqlite::memory:");
throws("an unopenable path", () -> db::open("sqlite:/nonexistent/dir/x.db"), "sqlite: cannot open /nonexistent/dir/x.db: unable to open database file");
throws("a bad type", () -> db_run(1, "select 1"), "db_run() expects db, got int");
throws("a bad postgres URL", () -> db::open("postgres://localhost:1/x?connect_timeout=1"), Error);
