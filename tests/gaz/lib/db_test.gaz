import "std/test.gaz" use expect, throws;
import "std/db.gaz";
import "std/fs.gaz";

// What a failing call raises, or null
fn failure($f) {
    try {
        $f();
    } catch ($e) {
        return $e.message;
    }
    return null;
}

$db = db::open("sqlite::memory:");
expect("the handle is its own type", type_of(db_open("sqlite::memory:")), "db");
expect("a script makes tables", $db.run(db::sql"create table t (id integer primary key, name text, score real, note text); insert into t (name, score) values ('seed', 0.5);"), {"rows" => [], "changes" => 1});
$a = ["a", 2, null];
$b = ["b", true, "x"];
expect("exec gives the rows changed", $db.exec(db::sql"insert into t (name, score, note) values {$a}, {$b}"), 2);
expect("query gives maps", $db.query(db::sql"select id, name, score, note from t order by id"), [
    {"id" => 1, "name" => "seed", "score" => 0.5, "note" => null},
    {"id" => 2, "name" => "a", "score" => 2.0, "note" => null},
    {"id" => 3, "name" => "b", "score" => 1.0, "note" => "x"},
]);
$id = 2;
expect("row", $db.row(db::sql"select name from t where id = {$id}"), {"name" => "a"});
$missing = 99;
expect("row of nothing", $db.row(db::sql"select name from t where id = {$missing}"), null);
expect("value", $db.value(db::sql"select count(*) from t"), 3);
expect("value of nothing", $db.value(db::sql"select name from t where id = 99"), null);
expect("a select changes nothing, whatever ran before", $db.run(db::sql"select * from t")["changes"], 0);
$first = 1;
expect("update counts what it changed", $db.exec(db::sql"update t set score = score + 1 where id > {$first}"), 2);
$last = 3;
expect("returning gives rows and changes", $db.run(db::sql"delete from t where id = {$last} returning name"), {"rows" => [{"name" => "b"}], "changes" => 1});
expect("a script gives its last result", $db.query(db::sql"select 1 as a; select 2 as b"), [{"b" => 2}]);
expect("a comment after the statement", $db.query(db::sql"select 1 as a; -- done"), [{"a" => 1}]);
expect("a comment after the statement, with parameters", $db.query(db::sql"select {$first} as a -- by id"), [{"a" => 1}]);
expect("nothing to run", $db.run(db::sql" "), {"rows" => [], "changes" => 0});
$attack = "x'); drop table t; --";
expect("strings that look like SQL are only strings", [$db.exec(db::sql"insert into t (name) values ({$attack})"), $db.value(db::sql"select count(*) from t")], [1, 3]);
$bytes = "é\0\xff";
expect("bytes pass through", $db.value(db::sql"select {$bytes}"), "é\0\xff");
$float = 0.1 + 0.2;
expect("floats keep their digits", $db.value(db::sql"select {$float}"), 0.30000000000000004);
$big = 9223372036854775807;
expect("big ints", $db.value(db::sql"select {$big}"), 9223372036854775807);
expect("a column named twice keeps the last", $db.row(db::sql"select 1 as a, 2 as a"), {"a" => 2});

throws("a bad statement", () -> $db.query(db::sql"select nope"), "sqlite: no such column: nope");
throws("too few parameters", () -> $db.query(db::sql"select ?"), "sqlite: the SQL takes 1 parameter, got 0");
throws("too many parameters", () -> db_run(db_open("sqlite::memory:"), "select 1", [1, 2]), "sqlite: the SQL takes 0 parameters, got 2");
throws("a list can't be a parameter", () -> db_run(db_open("sqlite::memory:"), "select ?", [[1]]), "sqlite: parameter 1 is a list, which cannot be stored");
$second = 2;
throws("a named placeholder is counted by the driver", () -> $db.query(db::sql"select {$first} as a, :name as b"), "sqlite: the SQL takes 2 parameters, got 1");
throws("parameters need one statement", () -> $db.query(db::sql"select {$first}; select {$second}"), "sqlite: parameters need a single statement");
throws("a failed statement changes nothing", () -> $db.exec(db::sql"insert into t (id) values ({$first})"), "sqlite: UNIQUE constraint failed: t.id");
throws("infinity is not a float here", () -> $db.value(db::sql"select 1e999"), "sqlite: column 1e999 is infinite, and floats are always finite");

expect("a transaction gives what its work returns", $db.transaction($d -> { $d.exec(db::sql"delete from t"); return $d.value(db::sql"select count(*) from t"); }), 0);
expect("and commits", $db.value(db::sql"select count(*) from t"), 0);
$db.exec(db::sql"insert into t (name) values ('kept')");
throws("it rolls back and raises again when the work raises", () -> $db.transaction($d -> { $d.exec(db::sql"delete from t"); throw "boom"; }), "boom");
expect("and nothing was deleted", $db.value(db::sql"select count(*) from t"), 1);
expect("an inner transaction rolls back alone", $db.transaction($d -> {
    $d.exec(db::sql"insert into t (name) values ('outer')");
    $inner = failure(() -> $d.transaction($x -> { $x.exec(db::sql"delete from t"); throw "inner"; }));
    return [$inner, $d.value(db::sql"select count(*) from t")];
}), ["inner", 2]);
expect("the outer one committed", $db.value(db::sql"select count(*) from t"), 2);
throws("an error from the database rolls back too", () -> $db.transaction($d -> { $d.exec(db::sql"delete from t"); $d.exec(db::sql"nonsense"); }), "sqlite: near \"nonsense\": syntax error");
expect("and the delete is undone", $db.value(db::sql"select count(*) from t"), 2);

/*
 * A plain string is refused by every method, so SQL can't be put together from values by mistake;
 * db::raw() is the way round.
 */
$refused = ': write db::sql"select ... where id = {$id}", or db::raw($text) for SQL built some other way';
throws("run refuses a string", () -> $db.run("select 1"), 'Db.run() takes db::sql"...", not a string' .. $refused);
throws("query refuses a string", () -> $db.query("select 1"), 'Db.query() takes db::sql"...", not a string' .. $refused);
throws("row refuses a string", () -> $db.row("select 1"), 'Db.row() takes db::sql"...", not a string' .. $refused);
throws("value refuses a string", () -> $db.value("select 1"), 'Db.value() takes db::sql"...", not a string' .. $refused);
throws("exec refuses a string", () -> $db.exec("delete from t"), 'Db.exec() takes db::sql"...", not a string' .. $refused);
throws("and anything else", () -> $db.query(null), 'Db.query() takes db::sql"...", not null' .. $refused);
expect("and ran nothing", $db.value(db::sql"select count(*) from t"), 2);
expect("raw runs as it is", $db.value(db::raw("select count(*) from t")), 2);
expect("a raw script", $db.run(db::raw("create table people (id integer primary key, \"Full name\" text, age int); insert into people (\"Full name\", age) values ('Ada', 36), ('Alan', 41), ('Grace', null)")),
    {"rows" => [], "changes" => 3});

$ids = [1, 3];
expect("a list is in (...)", $db.query(db::sql"select id from people where id in {$ids} order by id"), [{"id" => 1}, {"id" => 3}]);
expect("and not in (...)", $db.query(db::sql"select id from people where id not in {$ids}"), [{"id" => 2}]);
$column = db::ident("Full name");
expect("a name is quoted", $db.value(db::sql"select {$column} from people where id = {$second}"), "Alan");
fn older_than($age) {
    if ($age == null) {
        return db::sql"";
    }
    return db::sql" and age > {$age}";
}
$name = "A%";
$no_filter = older_than(null);
expect("a condition left out", $db.query(db::sql"select id from people where {$column} like {$name}{$no_filter} order by id"), [{"id" => 1}, {"id" => 2}]);
$age = 40;
$filter = older_than($age);
expect("a condition added, its value numbered with the rest", $db.query(db::sql"select id from people where {$column} like {$name}{$filter} and id > {$first}"), [{"id" => 2}]);
$nothing = null;
expect("null is sent as null", $db.value(db::sql"select count(*) from people where age is {$nothing}"), 1);
$names = ["O'Brien", "a\"b", "x\0y", "'; drop table people; --"];
foreach ($names as $i => $text) {
    $db.exec(db::sql"insert into people (id, {$column}) values ({$i + 10}, {$text})");
}
expect("quotes, NUL bytes and SQL in values are data", $db.query(db::sql"select {$column} as name from people where id >= 10 order by id"),
    map($names, $text -> ({"name" => $text})));
expect("and the table is still there", $db.value(db::sql"select count(*) from people"), 7);

$db.close();
$db.close();
throws("a closed database", () -> $db.query(db::sql"select 1"), "db_run() on a closed database");
throws("an unknown scheme", () -> db::open("mysql://localhost/x"), "db_open() expects a URL starting sqlite: or postgres:, got mysql://localhost/x");
throws("no path", () -> db::open("sqlite:"), "sqlite: no path: write sqlite:FILE or sqlite::memory:");
throws("an unopenable path", () -> db::open("sqlite:/nonexistent/dir/x.db"), "sqlite: cannot open /nonexistent/dir/x.db: unable to open database file");
throws("a bad type", () -> db_run(1, "select 1"), "db_run() expects db, got int");
throws("a bad postgres URL", () -> db::open("postgres://localhost:1/x?connect_timeout=1"), Error);

/*
 * What the database itself refuses is a db::Failure: the message as it always was, SQLite's
 * extended result code and its name, and a db::Problem that is the same for PostgreSQL.
 */
fn refusal($f) {
    try {
        $f();
    } catch (db::Failure $e) {
        return [$e.driver, $e.code, $e.name, $e.problem];
    }
    return null;
}

$db = db::open("sqlite::memory:");
$db.run(db::sql"pragma foreign_keys = on; create table parents (id integer primary key); create table kids (id integer primary key, email text unique, parent int references parents (id), name text not null default 'x', age int check (age >= 0))");
$db.run(db::sql"insert into parents (id) values (1); insert into kids (id, email, parent) values (1, 'a@b.co', 1)");
expect("a unique column", refusal(() -> $db.exec(db::sql"insert into kids (email) values ('a@b.co')")), ["sqlite", 2067, "SQLITE_CONSTRAINT_UNIQUE", db::Problem::Unique]);
expect("a primary key is unique too", refusal(() -> $db.exec(db::sql"insert into kids (id) values (1)")), ["sqlite", 1555, "SQLITE_CONSTRAINT_PRIMARYKEY", db::Problem::Unique]);
expect("a foreign key", refusal(() -> $db.exec(db::sql"insert into kids (parent) values (5)")), ["sqlite", 787, "SQLITE_CONSTRAINT_FOREIGNKEY", db::Problem::ForeignKey]);
expect("a row others point at", refusal(() -> $db.exec(db::sql"delete from parents")), ["sqlite", 787, "SQLITE_CONSTRAINT_FOREIGNKEY", db::Problem::ForeignKey]);
expect("not null", refusal(() -> $db.exec(db::sql"insert into kids (name) values (null)")), ["sqlite", 1299, "SQLITE_CONSTRAINT_NOTNULL", db::Problem::NotNull]);
expect("a check", refusal(() -> $db.exec(db::sql"insert into kids (age) values (-1)")), ["sqlite", 275, "SQLITE_CONSTRAINT_CHECK", db::Problem::Check]);
expect("anything else", refusal(() -> $db.query(db::sql"select nope")), ["sqlite", 1, "SQLITE_ERROR", db::Problem::Other]);
expect("inside a transaction, which is rolled back", [refusal(() -> $db.transaction($d -> $d.exec(db::sql"insert into kids (email) values ('a@b.co')"))), $db.value(db::sql"select count(*) from kids")],
    [["sqlite", 2067, "SQLITE_CONSTRAINT_UNIQUE", db::Problem::Unique], 1]);
throws("its message is the database's, as it was", () -> $db.exec(db::sql"insert into kids (id) values (1)"), db::Failure, "sqlite: UNIQUE constraint failed: kids.id");
$e = null;
try {
    $db.exec(db::sql"insert into kids (id) values (1)");
} catch (db::Failure $caught) {
    $e = $caught;
}
expect("it is an Error, with no constraint, table or column from SQLite", [is_a($e, Error), $e.constraint, $e.table, $e.column, $e.cause], [true, null, null, null, null]);
$wrapped = Error("could not save the kid", $e);
expect("and can be a cause", $wrapped.cause.problem, db::Problem::Unique);
throws("a mistake gaz finds before the database is a plain Error", () -> $db.query(db::sql"select ?"), Error, "sqlite: the SQL takes 1 parameter, got 0");
$values = [[1]];
throws("and so is a value no database can store", () -> db_run(db_open("sqlite::memory:"), "select ?", $values), Error, "sqlite: parameter 1 is a list, which cannot be stored");
$handle = db_open("sqlite::memory:");
expect("db_error() of a new handle", db_error($handle), null);
failure(() -> db_run($handle, "selec"));
expect("db_error() of a handle whose last run the database refused", db_error($handle), {"code" => 1});
db_run($handle, "select 1");
expect("and null once one succeeds", db_error($handle), null);
failure(() -> db_run($handle, "select ?"));
expect("or fails before reaching the database", db_error($handle), null);
failure(() -> db_run($handle, "selec"));
failure(() -> db_run($handle, "select ?", "not a list"));
expect("or has an argument refused before the database is asked", db_error($handle), null);
$db.close();

/*
 * Two connections to one file: one holding the write lock makes the other's write Busy (with no
 * busy timeout, so it doesn't wait), and in WAL mode a reader whose snapshot another write has
 * passed must start its transaction again, which is Retry.
 */
$dir = fs::temp_dir("db-test");
$url = "sqlite:" .. $dir .. "/busy.db";
$writer = db::open($url);
$reader = db::open($url);
$writer.run(db::sql"pragma journal_mode = wal; create table t (n int)");
$reader.query(db::sql"pragma busy_timeout = 0");
$writer.exec(db::sql"begin immediate");
expect("a lock another connection holds", refusal(() -> $reader.exec(db::sql"insert into t values (1)")), ["sqlite", 5, "SQLITE_BUSY", db::Problem::Busy]);
$writer.exec(db::sql"commit");
$reader.exec(db::sql"begin");
$reader.query(db::sql"select * from t");
$writer.exec(db::sql"insert into t values (2)");
expect("a snapshot another write has passed", refusal(() -> $reader.exec(db::sql"insert into t values (3)")), ["sqlite", 517, "SQLITE_BUSY_SNAPSHOT", db::Problem::Retry]);
$reader.exec(db::sql"rollback");
$writer.close();
$reader.close();
fs::remove_tree($dir);

/*
 * Each database's codes and the Problem each is, as docs/library.md lists them, through a Failure
 * made as the library makes one from what db_error() gives
 */
fn sqlite_problem($code) {
    return db::Failure("m", "sqlite", {"code" => $code}).problem;
}

fn postgres_problem($sqlstate) {
    return db::Failure("m", "postgres", {"code" => $sqlstate}).problem;
}

$sqlite_codes = {
    2067 => db::Problem::Unique,        // SQLITE_CONSTRAINT_UNIQUE
    1555 => db::Problem::Unique,        // SQLITE_CONSTRAINT_PRIMARYKEY
    2579 => db::Problem::Unique,        // SQLITE_CONSTRAINT_ROWID
    787 => db::Problem::ForeignKey,     // SQLITE_CONSTRAINT_FOREIGNKEY
    1299 => db::Problem::NotNull,       // SQLITE_CONSTRAINT_NOTNULL
    275 => db::Problem::Check,          // SQLITE_CONSTRAINT_CHECK
    517 => db::Problem::Retry,          // SQLITE_BUSY_SNAPSHOT
    5 => db::Problem::Busy,             // SQLITE_BUSY
    261 => db::Problem::Busy,           // SQLITE_BUSY_RECOVERY
    773 => db::Problem::Busy,           // SQLITE_BUSY_TIMEOUT
    6 => db::Problem::Busy,             // SQLITE_LOCKED
    262 => db::Problem::Busy,           // SQLITE_LOCKED_SHAREDCACHE
    19 => db::Problem::Other,           // SQLITE_CONSTRAINT
    1811 => db::Problem::Other,         // SQLITE_CONSTRAINT_TRIGGER
    1 => db::Problem::Other,            // SQLITE_ERROR
    8 => db::Problem::Other,            // SQLITE_READONLY
    99999 => db::Problem::Other,        // none yet
};
foreach ($sqlite_codes as $code => $problem) {
    expect("SQLite's {$code}", sqlite_problem($code), $problem);
}
$sqlstates = {
    "23505" => db::Problem::Unique,
    "23503" => db::Problem::ForeignKey,
    "23502" => db::Problem::NotNull,
    "23514" => db::Problem::Check,
    "40001" => db::Problem::Retry,
    "40P01" => db::Problem::Retry,
    "55P03" => db::Problem::Busy,
    "08000" => db::Problem::Disconnected,
    "08006" => db::Problem::Disconnected,
    "08P01" => db::Problem::Disconnected,
    "57P01" => db::Problem::Disconnected,
    "57P02" => db::Problem::Disconnected,
    "57P03" => db::Problem::Disconnected,
    "23000" => db::Problem::Other,
    "23P01" => db::Problem::Other,
    "40000" => db::Problem::Other,
    "57014" => db::Problem::Other,
    "42601" => db::Problem::Other,
};
foreach ($sqlstates as $sqlstate => $problem) {
    expect("SQLSTATE {$sqlstate}", postgres_problem($sqlstate), $problem);
}
expect("an error libpq made itself has no SQLSTATE", postgres_problem(null), db::Problem::Other);
$fields = {"code" => "23505", "constraint" => "users_email_key", "table" => "users", "column" => null};
$made = db::Failure("postgres: duplicate key", "postgres", $fields);
expect("PostgreSQL's fields", [$made.message, $made.driver, $made.code, $made.name, $made.constraint, $made.table, $made.column],
    ["postgres: duplicate key", "postgres", "23505", null, "users_email_key", "users", null]);
expect("a code SQLite may add later has no name", db::Failure("m", "sqlite", {"code" => 99999}).name, null);
