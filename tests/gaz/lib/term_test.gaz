import "std/test.gaz" use expect, throws;
import "std/term.gaz";

// The keys in $bytes, named
fn names($bytes, $flush = false) {
    return join(map(term::decode($bytes, $flush)["keys"], $k -> term::name($k)), " ");
}

// Styles
expect("start: attribute", term::start("bold"), "\e[1m");
expect("start: several words", term::start("bold underline red"), "\e[1;4;31m");
expect("start: extra spaces", term::start("  bold   red "), "\e[1;31m");
expect("start: background", term::start("on_blue"), "\e[44m");
expect("start: bright", term::start("bright_green"), "\e[92m");
expect("start: bright background", term::start("on_bright_black"), "\e[100m");
expect("start: #rrggbb", term::start("#ff8800"), "\e[38;2;255;136;0m");
expect("start: #rgb", term::start("#f80"), "\e[38;2;255;136;0m");
expect("start: hex is any case", term::start("on_#FfA"), "\e[48;2;255;255;170m");
expect("start: 256 colours", term::start("c208 on_c17"), "\e[38;5;208;48;5;17m");
expect("style", term::style("hi", "bold red"), "\e[1;31mhi\e[0m");
foreach (["bogus", "bright_bogus", "on_bogus", "#12", "#ggg", "c256", "c-1", "cx", "bright_"] as $word) {
    throws("unknown style " .. $word, () -> term::style("x", $word), "term: unknown style \"" .. $word .. "\"");
}

// Moving and clearing
expect("move_to is column then row, sent row first", term::move_to(5, 2), "\e[2;5H");
expect("up", term::up(3), "\e[3A");
expect("up by default is one", term::up(), "\e[1A");
expect("moving by nothing is nothing", term::left(0) .. term::down(0) .. term::right(-1), "");
expect("column", term::column(7), "\e[7G");
expect("cursor", term::hide_cursor() .. term::show_cursor(), "\e[?25l\e[?25h");
expect("screen", term::enter_screen() .. term::leave_screen(), "\e[?1049h\e[?1049l");
expect("clear", term::clear() .. term::clear_line(), "\e[2J\e[2K");
expect("title", term::title("x"), "\e]0;x\x07");

// Measuring
expect("strip: plain", term::strip("hello"), "hello");
expect("strip: styles", term::strip(term::style("hi", "bold red") .. " there"), "hi there");
expect("strip: cursor moves", term::strip("a" .. term::move_to(3, 4) .. "b" .. term::clear()), "ab");
expect("strip: a title", term::strip(term::title("x") .. "y"), "y");
expect("strip: an escape at the end", term::strip("a\e"), "a");
expect("strip: cut off", term::strip("a\e[1;"), "a");
expect("strip: nothing", term::strip(""), "");
expect("strip: a newline ends a broken sequence and is text", term::strip("\e[\nfoo"), "\nfoo");
expect("strip: a title ended by ST", term::strip("a\e]0;t\e\\b"), "ab");
expect("strip: a title ended by BEL, and an ST outside one is an escape of its own", term::strip("a\e]0;t\x07b\e\\c"), "abc");
expect("strip: a title that never ends takes the rest", term::strip("a\e]0;title"), "a");
expect("strip: intermediates and a final byte", term::strip("a\e[?25lb\e[ qc"), "abc");
expect("chars: ascii", term::chars("abc"), ["a", "b", "c"]);
expect("chars: each length of character", term::chars("aé→😀x"), ["a", "é", "→", "😀", "x"]);
expect("chars: nothing", term::chars(""), []);
expect("chars: a cut-off character is a byte each, as utf8_width counts it", term::chars("a\xe2\x9c"), ["a", "\xe2", "\x9c"]);
expect("chars: a stray continuation byte is its own", term::chars("\x80a"), ["\x80", "a"]);
expect("chars: a lead byte doesn't eat what isn't a continuation", term::chars("\xc3a"), ["\xc3", "a"]);
expect("chars: nor two of three", term::chars("\xe2\x9cz"), ["\xe2", "\x9c", "z"]);
expect("chars: an overlong form is bytes too", term::chars("\xc0\x80a"), ["\xc0", "\x80", "a"]);
expect("width: agrees with chars on bad UTF-8", [term::width("\xc3a"), term::width("\x80a"), term::width("a\xe2\x9c")], [2, 2, 3]);
expect("width: ascii", term::width("hello"), 5);
expect("width: multibyte", term::width("héllo → ✓"), 9);
expect("width: ignores styles", term::width(term::style("héllo", "bold")), 5);
expect("width: a wide character is two columns, CJK or an emoji", [term::width("中文"), term::width("a😀b")], [4, 4]);
expect("width: a combining mark takes none", [term::width("e\u{301}"), term::width("中\u{301}")], [1, 2]);
expect("width: escape sequences take none, whatever they hold", term::width(term::style("中", "bold") .. term::move_to(1, 1) .. "x"), 3);
expect("width: a tab and a control character count one each, as utf8_width says", term::width("a\tb\x01"), 4);

// A Style is a spec parsed once, and a value
$bold = term::Style::of("bold red");
expect("Style::of: the spec and the sequence that starts it", [$bold.spec, $bold.sequence], ["bold red", "\e[1;31m"]);
expect("Style::of: the same spec is the same object", term::Style::of("bold red") == $bold, true);
expect("Style: two from one spec are ==, however made", term::Style("bold red", "\e[1;31m") == $bold, true);
expect("Style::of: spaces don't make another style", term::Style::of("  bold   red ") == $bold, true);
expect("Style::of: the words in another order are another style", term::Style::of("red bold") == $bold, false);
expect("Style::of: a Style is given back", term::Style::of($bold) == $bold, true);
expect("Style::of: no style", [term::Style::of("").spec, term::Style::of("").sequence, term::Style::of("").is_plain(), $bold.is_plain()], ["", "", true, false]);
expect("with: the style and more words", [$bold.with("inverse").spec, $bold.with("inverse") == term::Style::of("bold red inverse"), term::Style::of("").with("dim").spec], ["bold red inverse", true, "dim"]);
throws("Style::of: an unknown word fails when the style is made", () -> term::Style::of("bold bogus"), "term: unknown style \"bogus\"");
throws("with: an unknown word", () -> $bold.with("shiny"), "term: unknown style \"shiny\"");
expect("start: no style starts with nothing", term::start(""), "");

// Keys
expect("printable", names("abZ 9~"), "a b Z space 9 ~");
expect("enter, tab, backspace, escape", names("\r\t\x7f\x08") .. " " .. names("\e", true), "enter tab backspace backspace escape");
expect("ctrl letters", names("\x01\x03\x1a"), "ctrl+a ctrl+c ctrl+z");
expect("ctrl space and the punctuation ones", names("\x00\x1c\x1d\x1e\x1f"), "ctrl+space ctrl+\\ ctrl+] ctrl+^ ctrl+_");
expect("arrows", names("\e[A\e[B\e[C\e[D"), "up down right left");
expect("arrows, application mode", names("\eOA\eOB\eOC\eOD"), "up down right left");
expect("home, end, insert, delete, pages", names("\e[H\e[F\e[2~\e[3~\e[5~\e[6~"), "home end insert delete page_up page_down");
expect("home and end, other spellings", names("\e[1~\e[4~\e[7~\e[8~\eOH\eOF"), "home end home end home end");
expect("function keys", names("\eOP\eOQ\eOR\eOS\e[15~\e[17~\e[18~\e[19~\e[20~\e[21~\e[23~\e[24~"), "f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12");
expect("function keys, CSI spelling", names("\e[11~\e[12~\e[13~\e[14~"), "f1 f2 f3 f4");
expect("shift tab", names("\e[Z"), "shift+tab");
expect("modifiers", names("\e[1;2A\e[1;3A\e[1;5A\e[1;6A\e[1;7A"), "shift+up alt+up ctrl+up ctrl+shift+up ctrl+alt+up");
expect("modifiers on a ~ key", names("\e[3;5~\e[5;2~\e[15;7~"), "ctrl+delete shift+page_up ctrl+alt+f5");
expect("alt letters", names("\ea\eZ\e "), "alt+a alt+Z alt+space");
expect("alt and ctrl", names("\e\x03"), "ctrl+alt+c");
expect("alt enter", names("\e\r"), "alt+enter");
expect("alt and a sequence", names("\e\e[A"), "escape up");
expect("utf-8", names("é→✓😀"), "é → ✓ 😀");
expect("alt utf-8", names("\eé"), "alt+é");
expect("unknown: a cursor position report", names("\e[12;40R"), "unknown");
expect("unknown: a mouse report in the old form", names("\e[M"), "unknown");
expect("unknown: a cursor report from row 1, whose column is no modifier", names("\e[1;80R"), "unknown");
expect("a modifier of 16 is still one", names("\e[1;16A"), "ctrl+alt+shift+up");
expect("a modifier of 17 is not", names("\e[1;17A"), "unknown");
expect("ctrl+f3 is what its bytes say", names("\e[1;5R"), "ctrl+f3");
expect("a control byte ends a sequence, and is a key", names("\e[\nx"), "unknown ctrl+j x");
expect("a bad UTF-8 byte doesn't eat the next key", [term::decode("\xc3a")["keys"][0]["key"], term::decode("\xc3a")["keys"][1]["key"]], ["\xc3", "a"]);
expect("half a character still waits for the rest", term::decode("\xe2\x9c")["rest"], "\xe2\x9c");
expect("unknown is kept", term::decode("\e[12;40R")["keys"][0]["raw"], "\e[12;40R");
expect("a mix", names("ab\e[Acd\r"), "a b up c d enter");

// A sequence cut off waits for the rest, unless nothing more is coming
expect("rest: a lone escape", term::decode("\e"), {"keys" => [], "rest" => "\e"});
expect("rest: a cut-off sequence", term::decode("a\e[1;"), {"keys" => [{"key" => "a", "ctrl" => false, "alt" => false, "shift" => false}], "rest" => "\e[1;"});
expect("rest: half a character", term::decode("\xe2\x9c")["rest"], "\xe2\x9c");
expect("rest: half of an alt key", term::decode("\e\xc3")["rest"], "\e\xc3");
expect("rest: joined with the next read", names("\e[1;" .. "5A"), "ctrl+up");
expect("flush: a lone escape", names("\e", true), "escape");
expect("flush: a cut-off sequence", names("\e[1;", true), "alt+[ 1 ;");
expect("flush: ESC O", names("\eO", true), "alt+O");
expect("flush: half a character", term::decode("\xe2\x9c", true)["rest"], "");
expect("flush leaves a whole sequence alone", names("\e[A", true), "up");

// What a key types
foreach ([["a", "a"], ["Z", "Z"], [" ", " "], ["é", "é"], ["\x03", null], ["\ea", null], ["\r", null], ["\e[A", null], ["\e[15~", null]] as [$bytes, $typed]) {
    expect("text of " .. to_string([$bytes]), term::text(term::decode($bytes)["keys"][0]), $typed);
}
expect("name of a plain key", term::name({"key" => "x", "ctrl" => false, "alt" => false, "shift" => false}), "x");

// What the terminal reports when asked to (fullscreen()'s options): a paste is one key
$paste = term::decode("\e[200~abc\e[201~x")["keys"];
expect("paste: one key holding the text, and the key after it", $paste, [
    {"key" => "paste", "ctrl" => false, "alt" => false, "shift" => false, "text" => "abc"},
    {"key" => "x", "ctrl" => false, "alt" => false, "shift" => false},
]);
expect("paste: a newline is \\n however the terminal sent it", term::decode("\e[200~a\rb\r\nc\nd\e[201~")["keys"][0]["text"], "a\nb\nc\nd");
expect("paste: sequences inside it are text", term::decode("\e[200~\e[A\x03\e\e[201~")["keys"][0]["text"], "\e[A\x03\e");
expect("paste: nothing", term::decode("\e[200~\e[201~")["keys"][0]["text"], "");
expect("paste: cut across reads, it waits for its end", term::decode("\e[200~abc"), {"keys" => [], "rest" => "\e[200~abc"});
expect("paste: its end cut in two waits too", term::decode("\e[200~abc\e[20")["rest"], "\e[200~abc\e[20");
expect("paste: its start cut off waits as any sequence does", term::decode("\e[20")["rest"], "\e[20");
expect("paste: joined with the next read", term::decode("\e[200~abc" .. "def\e[201~")["keys"][0]["text"], "abcdef");
expect("paste: never ended, flushed as its text", term::decode("\e[200~abc", true), {"keys" => [{"key" => "paste", "ctrl" => false, "alt" => false, "shift" => false, "text" => "abc"}], "rest" => ""});
expect("paste: an escape before it is a key of its own", names("\e\e[200~a\e[201~"), "escape paste");
expect("paste: name and text", [term::name($paste[0]), term::text($paste[0])], ["paste", null]);

// A mouse report: the button, what it did, and where
fn mouse($bytes) {
    $key = term::decode($bytes)["keys"][0];
    return [term::name($key), $key["button"] ?? null, $key["action"] ?? null, $key["col"] ?? null, $key["row"] ?? null];
}
expect("mouse: a press", term::decode("\e[<0;10;5M")["keys"][0], {"key" => "mouse", "ctrl" => false, "alt" => false, "shift" => false, "button" => "left", "action" => "press", "col" => 10, "row" => 5});
expect("mouse: the buttons", [mouse("\e[<1;1;1M")[1], mouse("\e[<2;1;1M")[1]], ["middle", "right"]);
expect("mouse: a release names its button", mouse("\e[<2;7;8m"), ["mouse", "right", "release", 7, 8]);
expect("mouse: dragging", mouse("\e[<32;3;4M"), ["mouse", "left", "drag", 3, 4]);
expect("mouse: moving with no button held", mouse("\e[<35;2;2M"), ["mouse", "none", "move", 2, 2]);
expect("mouse: the wheel", [mouse("\e[<64;1;1M"), mouse("\e[<65;9;9M")], [["mouse", "none", "scroll_up", 1, 1], ["mouse", "none", "scroll_down", 9, 9]]);
expect("mouse: the modifier bits", [mouse("\e[<4;1;1M")[0], mouse("\e[<8;1;1M")[0], mouse("\e[<16;1;1M")[0], mouse("\e[<28;1;1M")[0]], ["shift+mouse", "alt+mouse", "ctrl+mouse", "ctrl+alt+shift+mouse"]);
expect("mouse: modifiers with the wheel and a drag", [mouse("\e[<68;1;1M"), mouse("\e[<50;5;6M")], [["shift+mouse", "none", "scroll_up", 1, 1], ["ctrl+mouse", "right", "drag", 5, 6]]);
expect("mouse: a wide screen", mouse("\e[<0;223;58M"), ["mouse", "left", "press", 223, 58]);
expect("mouse: the buttons past the third are unknown", names("\e[<128;1;1M\e[<130;1;1m"), "unknown unknown");
expect("mouse: the wheel sideways is unknown", names("\e[<66;1;1M\e[<67;1;1M"), "unknown unknown");
expect("mouse: a press of no button is unknown", names("\e[<3;1;1M"), "unknown");
expect("mouse: a report short of a field, or with a bad one, is unknown", names("\e[<0;10M\e[<0;;5M\e[<0;1;1;1M"), "unknown unknown unknown");
expect("mouse: the old form is unknown, and its bytes are keys", names("\e[M !!"), "unknown space ! !");
expect("mouse: cut off waits", term::decode("\e[<0;10")["rest"], "\e[<0;10");
expect("mouse: text", term::text(term::decode("\e[<0;10;5M")["keys"][0]), null);

// Focus
expect("focus", names("\e[I\e[O"), "focus_in focus_out");
expect("focus: with parameters it is something else", names("\e[1;2I\e[2O"), "unknown unknown");
expect("focus: text", [term::text(term::decode("\e[I")["keys"][0]), term::text(term::decode("\e[O")["keys"][0])], [null, null]);

// The kitty keyboard protocol's keys decode to the same names
expect("csi u: the keys it numbers by their control character", names("\e[13u\e[9u\e[27u\e[127u\e[32u"), "enter tab escape backspace space");
expect("csi u: shift+enter, and ctrl+i and ctrl+h told from tab and backspace", names("\e[13;2u\e[105;5u\e[104;5u"), "shift+enter ctrl+i ctrl+h");
expect("csi u: a letter with its modifiers", names("\e[97;2u\e[97;3u\e[97;5u\e[97;6u\e[97;7u\e[97;8u"), "shift+a alt+a ctrl+a ctrl+shift+a ctrl+alt+a ctrl+alt+shift+a");
expect("csi u: the names the terminal's own sequences give", [names("\e[106;3u"), names("\e[57419;5u"), names("\e[27u"), names("\e[97;5u"), names("\e[9;2u")], [names("\ej"), names("\e[1;5A"), names("\e", true), names("\x01"), names("\e[Z")]);
expect("csi u: unicode", names("\e[233u\e[8594u\e[128512u"), "é → 😀");
expect("csi u: the keypad", names("\e[57414u\e[57417u\e[57418u\e[57419u\e[57420u\e[57421u\e[57422u\e[57423u\e[57424u\e[57425u\e[57426u"), "enter left right up down page_up page_down home end insert delete");
expect("csi u: the modifier's higher bits (super, caps lock) are passed over", names("\e[97;9u\e[97;65u\e[97;129u"), "a a a");
expect("csi u: an alternate key, a repeat and a release", names("\e[97:65;2u\e[97;1:2u\e[97;1:3u"), "shift+a a unknown");
expect("csi u: text as code points is passed over", names("\e[97;1;97u"), "a");
expect("csi u: an empty modifier is none", names("\e[97;u"), "a");
expect("csi u: what it doesn't read is unknown", names("\e[57358u\e[7u\e[128u\e[55296u\e[1114112u\e[-1u\e[u\e[97;0u\e[97;1;2;3u\e[97;1:u\e[;u"), "unknown unknown unknown unknown unknown unknown unknown unknown unknown unknown unknown");
expect("csi u: cut off waits", term::decode("\e[13;")["rest"], "\e[13;");
expect("csi u: text", [term::text(term::decode("\e[97;2u")["keys"][0]), term::text(term::decode("\e[233u")["keys"][0]), term::text(term::decode("\e[97;5u")["keys"][0])], ["a", "é", null]);

// Asking the terminal for them
expect("paste on and off", term::enable_paste() .. term::disable_paste(), "\e[?2004h\e[?2004l");
expect("mouse on and off", term::enable_mouse() .. term::disable_mouse(), "\e[?1000h\e[?1006h\e[?1006l\e[?1000l");
expect("mouse with every movement", term::enable_mouse(true) .. term::disable_mouse(true), "\e[?1003h\e[?1006h\e[?1006l\e[?1003l");
expect("focus on and off", term::enable_focus() .. term::disable_focus(), "\e[?1004h\e[?1004l");
expect("the kitty keyboard protocol pushed and popped", term::enable_kitty_keys() .. term::disable_kitty_keys(), "\e[>1u\e[<u");
expect("enable: nothing by default", term::enable({}) .. term::disable({}), "");
expect("enable: everything, in order", term::enable({"paste" => true, "mouse" => "all", "focus" => true, "keys" => "kitty"}), "\e[?2004h\e[?1003h\e[?1006h\e[?1004h\e[>1u");
expect("disable: in the other order", term::disable({"paste" => true, "mouse" => true, "focus" => true, "keys" => "kitty"}), "\e[<u\e[?1004l\e[?1006l\e[?1000l\e[?2004l");
expect("enable: off is off", term::enable({"paste" => false, "mouse" => null, "focus" => false, "keys" => false}), "");
throws("enable: an unknown option", () -> term::enable({"mice" => true}), "term: unknown option \"mice\" (the options are paste, mouse, focus and keys)");
throws("enable: a flag that isn't one", () -> term::enable({"paste" => "yes"}), "term: option \"paste\" is true or false");
throws("enable: a mouse option that isn't one", () -> term::enable({"mouse" => "yes"}), "term: option \"mouse\" is true, false or \"all\"");
throws("enable: a keys option that isn't one", () -> term::enable({"keys" => "xterm"}), "term: option \"keys\" is \"kitty\", or false for the terminal's own sequences");
throws("fullscreen checks its options before it needs a terminal", () -> term::fullscreen(() -> null, {"focus" => "always"}), "term: option \"focus\" is true or false");
expect("cursor shapes", [term::cursor_block(), term::cursor_block(true), term::cursor_underline(), term::cursor_underline(true), term::cursor_bar(), term::cursor_bar(true), term::cursor_default()], ["\e[2 q", "\e[1 q", "\e[4 q", "\e[3 q", "\e[6 q", "\e[5 q", "\e[0 q"]);
expect("an Input with its own escape wait", kind_of(term::Input(0.2)), term::Input);

// The keys a gaz --tty script's words name
expect("key: a character", term::key("j"), term::decode("j")["keys"][0]);
expect("key: a capital, a digit and a punctuation mark", [term::name(term::key("J")), term::name(term::key("2")), term::name(term::key("+")), term::name(term::key("."))], ["J", "2", "+", "."]);
expect("key: a named key", term::name(term::key("enter")), "enter");
expect("key: as decode gives it", [term::key("enter"), term::key("page_up"), term::key("f5"), term::key("space")], [term::decode("\r")["keys"][0], term::decode("\e[5~")["keys"][0], term::decode("\e[15~")["keys"][0], term::decode(" ")["keys"][0]]);
expect("key: with modifiers", [term::key("ctrl+c"), term::key("alt+x"), term::key("shift+tab"), term::key("ctrl+alt+up")], [term::decode("\x03")["keys"][0], term::decode("\ex")["keys"][0], term::decode("\e[Z")["keys"][0], term::decode("\e[1;7A")["keys"][0]]);
expect("key: a modified plus", term::name(term::key("ctrl++")), "ctrl++");
expect("key: a quoted character", term::name(term::key("\"é\"")), "é");
expect("key: a mouse report", term::key("mouse left press 10 5"), term::decode("\e[<0;10;5M")["keys"][0]);
expect("key: a paste", term::key("paste \"two words\"")["text"], "two words");
expect("keys: several, in order", join(map(term::keys("j down  ctrl+c\nenter"), $k -> term::name($k)), " "), "j down ctrl+c enter");
expect("keys: text typed a character at a time", join(map(term::keys("\"héy\" enter"), $k -> term::name($k)), " "), "h é y enter");
expect("keys: a space, a newline and a quote typed", join(map(term::keys("\"a b\\\"\""), $k -> term::name($k)), "|"), "a|space|b|\"");
expect("keys: a word that is a command's name, typed", join(map(term::keys("\"snap\""), $k -> term::name($k)), ""), "snap");
expect("keys: a paste and a mouse report among keys", join(map(term::keys("a paste \"x\" mouse right release 3 4 b"), $k -> term::name($k)), " "), "a paste mouse b");
expect("keys: none", term::keys("  "), []);
$refusal = "no key is called \"entr\" (text to type goes in double quotes: \"...\"; a key is a character or enter tab backspace space escape up down left right home end insert delete page_up page_down f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 focus_in focus_out, after ctrl+ alt+ or shift+ if held)";
throws("key: a word that is no key, in --tty's words", () -> term::key("entr"), $refusal);
throws("keys: the same, among good ones", () -> term::keys("j entr enter"), $refusal);
throws("key: a modifier that isn't one", () -> term::key("super+x"), "no key is called \"super+x\" (text to type goes in double quotes: \"...\"; a key is a character or enter tab backspace space escape up down left right home end insert delete page_up page_down f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12 focus_in focus_out, after ctrl+ alt+ or shift+ if held)");
throws("keys: a quote never closed", () -> term::keys("\"abc"), "a quote in the keys is never closed");
throws("keys: a mouse report that isn't one", () -> term::keys("mouse left press 0 5"), "'mouse left press 0 5' isn't a mouse report: 'mouse' needs a button, an action, a column and a row after it (mouse left press 10 5): left, middle, right or none, after ctrl+ alt+ or shift+ if held; press, release, drag, move, scroll_up or scroll_down; and the column and the row, from 1");
throws("keys: a paste without text", () -> term::keys("paste"), "'paste' needs its text in double quotes after it: paste \"...\"");
$command = "is no key: it is a command of gaz --tty. A test reads a screen with Screen.lines() or Screen.text(), waits by calling the program's own tick, and resizes with Screen.resize()";
throws("keys: snap is a command, not a key", () -> term::keys("j snap"), "'snap' " .. $command);
throws("keys: nor is wait", () -> term::keys("wait 0.5 j"), "'wait 0.5' " .. $command);
throws("keys: nor resize", () -> term::keys("resize 80x24"), "'resize 80x24' " .. $command);
throws("keys: a wait without its seconds is --tty's own error", () -> term::keys("wait"), "'wait' needs a number of seconds after it, 0 or more");
throws("key: none", () -> term::key(""), "term::key() takes one key, and \"\" is 0: write keys() for a script of several");
throws("key: two", () -> term::key("j k"), "term::key() takes one key, and \"j k\" is 2: write keys() for a script of several");
