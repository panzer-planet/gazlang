import "std/test.gaz" use expect, throws;
import "std/fs.gaz";
import "std/text.gaz";

/*
 * std/fs.gaz: copying, walking, globbing, replacing a file in one step and removing a tree, in a
 * directory of this run's own made by fs::temp_dir() and removed at the end however the checks
 * went.
 */
fn every_byte(): string {
    $bytes = "";
    for ($b = 0; $b < 256; $b++) {
        $bytes ..= chr($b);
    }
    return $bytes;
}

// A small tree: files, a hidden file and directory, a nested directory and links
fn plant(string $root): null {
    make_dir($root .. "/src/lib/deep", true);
    make_dir($root .. "/.cache");
    write_file($root .. "/README.md", "readme");
    write_file($root .. "/src/main.gaz", "main");
    write_file($root .. "/src/lib/a.gaz", "a");
    write_file($root .. "/src/lib/b.txt", "b");
    write_file($root .. "/src/lib/deep/c.gaz", "c");
    write_file($root .. "/src/.hidden.gaz", "hidden");
    write_file($root .. "/.cache/x.gaz", "x");
    symlink("..", $root .. "/src/lib/up");
    symlink("main.gaz", $root .. "/src/link.gaz");
    symlink("src/lib/deep", $root .. "/shortcut");
}

fn temp_dirs(): null {
    $one = fs::temp_dir();
    $two = fs::temp_dir("mine");
    expect("a temporary directory is made", is_dir($one), true);
    expect("and is empty", list_dir($one), []);
    expect("each is new", $one != $two, true);
    expect("named by the prefix", starts_with(last(split($two, "/")), "mine-"), true);
    expect("and gaz by default", starts_with(last(split($one, "/")), "gaz-"), true);
    expect("under TMPDIR", fs::parent($one), text::trim_end(getenv("TMPDIR") ?? "/tmp", "/"));
    expect("and its owner's alone", file_info($one)["mode"], 0o700);
    delete_dir($one);
    delete_dir($two);
}

fn walking(string $root): null {
    expect("every path, depth first, a directory before what it holds", fs::walk($root), [
        ".cache", ".cache/x.gaz", "README.md", "shortcut", "src", "src/.hidden.gaz", "src/lib", "src/lib/a.gaz",
        "src/lib/b.txt", "src/lib/deep", "src/lib/deep/c.gaz", "src/lib/up", "src/link.gaz", "src/main.gaz",
    ]);
    expect("a link to a directory is one entry", in_array("shortcut/c.gaz", fs::walk($root)), false);
    expect("a link to a directory isn't followed", fs::walk($root .. "/src/lib"), ["a.gaz", "b.txt", "deep", "deep/c.gaz", "up"]);
    expect("an empty directory", fs::walk($root .. "/src/lib/deep"), ["c.gaz"]);
    throws("a file isn't a directory", () -> fs::walk($root .. "/README.md"), "Cannot list directory \"{$root}/README.md\": Not a directory");
}

fn globbing(string $root): null {
    $at = len($root) + 1;
    $relative = $paths -> map($paths, $p -> slice($p, $at));
    expect("a name in a directory", $relative(fs::glob($root .. "/src/*.gaz")), ["src/link.gaz", "src/main.gaz"]);
    expect("** for any depth", $relative(fs::glob($root .. "/src/**/*.gaz")),
        ["src/lib/a.gaz", "src/lib/deep/c.gaz", "src/link.gaz", "src/main.gaz"]);
    expect("** at the end is everything below", $relative(fs::glob($root .. "/src/lib/**")),
        ["src/lib/a.gaz", "src/lib/b.txt", "src/lib/deep", "src/lib/deep/c.gaz", "src/lib/up"]);
    expect("** goes through no link", $relative(fs::glob($root .. "/**/c.gaz")), ["src/lib/deep/c.gaz"]);
    expect("a link the pattern names is followed", $relative(fs::glob($root .. "/shortcut/**")), ["shortcut/c.gaz"]);
    expect("nor into a hidden directory", fs::glob($root .. "/**/x.gaz"), []);
    expect("hidden names need a dot", $relative(fs::glob($root .. "/**/.*")), [".cache", "src/.hidden.gaz"]);
    expect("a literal hidden name", $relative(fs::glob($root .. "/.cache/*")), [".cache/x.gaz"]);
    expect("? is one byte", $relative(fs::glob($root .. "/src/lib/?.*")), ["src/lib/a.gaz", "src/lib/b.txt"]);
    expect("a set", $relative(fs::glob($root .. "/src/lib/[ab].gaz")), ["src/lib/a.gaz"]);
    expect("a range", $relative(fs::glob($root .. "/src/lib/[a-b].*")), ["src/lib/a.gaz", "src/lib/b.txt"]);
    expect("not in a set", $relative(fs::glob($root .. "/src/lib/[!a]*")), ["src/lib/b.txt", "src/lib/deep", "src/lib/up"]);
    expect("a wildcard name in the middle", $relative(fs::glob($root .. "/*/lib/*.txt")), ["src/lib/b.txt"]);
    expect("nothing matching", fs::glob($root .. "/*.nothing"), []);
    expect("a missing directory", fs::glob($root .. "/nope/*"), []);
    expect("a plain path", $relative(fs::glob($root .. "/README.md")), ["README.md"]);
    expect("a missing plain path", fs::glob($root .. "/README.txt"), []);
    expect("a name doesn't continue through a file", fs::glob($root .. "/README.md/*"), []);
    expect("a star matching nothing", $relative(fs::glob($root .. "/src/main*.gaz")), ["src/main.gaz"]);
    expect("several stars", $relative(fs::glob($root .. "/src/*a*i*")), ["src/main.gaz"]);
    expect("an unclosed [ is itself", fs::glob($root .. "/src/[a"), []);
    expect("a doubled ** still finds each once", $relative(fs::glob($root .. "/src/**/**/c.gaz")), ["src/lib/deep/c.gaz"]);
    $here = cwd();
    expect("a relative pattern, from the working directory, gives relative paths", fs::glob("tests/gaz/files/[hi]*_test.gaz"),
        ["tests/gaz/files/handle_test.gaz", "tests/gaz/files/info_test.gaz"]);
    expect("absolute is absolute", fs::glob($here .. "/tests/gaz/lib/fs_test.gaz"), [$here .. "/tests/gaz/lib/fs_test.gaz"]);
}

fn copying(string $root): null {
    $bytes = repeat(every_byte(), 1000);
    write_file($root .. "/bytes.bin", $bytes);
    fs::copy($root .. "/bytes.bin", $root .. "/copy.bin");
    expect("a copy has the same bytes", read_file($root .. "/copy.bin") == $bytes, true);
    write_file($root .. "/copy.bin", "something else, longer than nothing");
    fs::copy($root .. "/README.md", $root .. "/copy.bin");
    expect("a copy replaces what was there", read_file($root .. "/copy.bin"), "readme");
    write_file($root .. "/empty", "");
    fs::copy($root .. "/empty", $root .. "/empty-copy");
    expect("an empty file copies", read_file($root .. "/empty-copy"), "");
    throws("onto itself", () -> fs::copy($root .. "/README.md", $root .. "/README.md"),
        "fs::copy(): \"{$root}/README.md\" and \"{$root}/README.md\" are the same file");
    expect("which leaves it alone", read_file($root .. "/README.md"), "readme");
    throws("from nothing", () -> fs::copy($root .. "/nope", $root .. "/x"), "Cannot open \"{$root}/nope\": No such file or directory");
    throws("a directory", () -> fs::copy($root .. "/src", $root .. "/x"), "Cannot open \"{$root}/src\": Is a directory");
    $left_out = fs::copy_tree($root .. "/src", $root .. "/copied/src");
    expect("a tree, made with its parents", fs::walk($root .. "/copied"), [
        "src", "src/.hidden.gaz", "src/lib", "src/lib/a.gaz", "src/lib/b.txt", "src/lib/deep", "src/lib/deep/c.gaz", "src/lib/up",
        "src/link.gaz", "src/main.gaz",
    ]);
    expect("nothing is left out", $left_out, []);
    expect("links are links again", [file_info($root .. "/copied/src/lib/up", false)["kind"], file_info($root .. "/copied/src/link.gaz", false)["kind"]], ["link", "link"]);
    expect("with the same text", [readlink($root .. "/copied/src/lib/up"), readlink($root .. "/copied/src/link.gaz")], ["..", "main.gaz"]);
    expect("so one within the tree points within the copy", real_path($root .. "/copied/src/link.gaz"), real_path($root .. "/copied/src/main.gaz"));
    expect("its files' contents", read_file($root .. "/copied/src/lib/deep/c.gaz"), "c");
    fs::copy_tree($root .. "/src", $root .. "/copied/src");
    expect("again, into a tree that is there", read_file($root .. "/copied/src/main.gaz"), "main");
    expect("whose links are made again", readlink($root .. "/copied/src/link.gaz"), "main.gaz");
    throws("a tree from a file", () -> fs::copy_tree($root .. "/README.md", $root .. "/x"), "fs::copy_tree(): \"{$root}/README.md\" is not a directory");
}

// What copy() and copy_tree() keep: modes, times when asked, and what they leave out
fn keeping(string $root): null {
    $from = $root .. "/keep";
    make_dir($from .. "/locked", true);
    write_file($from .. "/script.sh", "#!/bin/sh");
    chmod($from .. "/script.sh", 0o755);
    write_file($from .. "/secret", "secret");
    chmod($from .. "/secret", 0o600);
    write_file($from .. "/locked/read-only", "r");
    chmod($from .. "/locked/read-only", 0o444);
    write_file($from .. "/setuid", "s");
    chmod($from .. "/setuid", 0o4755);
    chmod($from .. "/locked", 0o555);
    set_mtime($from .. "/secret", 1000000000);
    fs::copy($from .. "/secret", $root .. "/secret-copy");
    expect("a copy keeps the mode", file_info($root .. "/secret-copy")["mode"], 0o600);
    expect("but not the time unless asked", file_info($root .. "/secret-copy")["mtime"] != 1000000000, true);
    fs::copy($from .. "/secret", $root .. "/timed-copy", true);
    expect("and with keep_time, the time too", file_info($root .. "/timed-copy")["mtime"], 1000000000);
    fs::copy($from .. "/setuid", $root .. "/setuid-copy");
    expect("a setuid bit survives the writing", file_info($root .. "/setuid-copy")["mode"], 0o4755);
    run(["mkfifo", $from .. "/fifo"]);
    $left_out = fs::copy_tree($from, $root .. "/kept");
    expect("a fifo is still left out, and said", $left_out, ["fifo"]);
    expect("modes in a tree", map(["script.sh", "secret", "locked", "locked/read-only", "setuid"], $p -> file_info($root .. "/kept/" .. $p)["mode"]),
        [0o755, 0o600, 0o555, 0o444, 0o4755]);
    expect("the top directory's too", file_info($root .. "/kept")["mode"], file_info($from)["mode"]);
    chmod($from .. "/locked", 0o755);
    chmod($root .. "/kept/locked", 0o755);
    symlink("nowhere", $from .. "/dangling");
    symlink("dangling", $from .. "/to-dangling");
    fs::copy_tree($from, $root .. "/kept-links");
    expect("a link to nothing is copied as a link", readlink($root .. "/kept-links/dangling"), "nowhere");
    expect("and a link to that link", readlink($root .. "/kept-links/to-dangling"), "dangling");
}

fn touching(string $root): null {
    $path = $root .. "/touched";
    fs::touch($path);
    expect("touch makes an empty file", read_file($path), "");
    write_file($path, "kept");
    set_mtime($path, 1000000000);
    fs::touch($path);
    expect("and on one that is there, sets the time to now", abs(file_info($path)["mtime"] - time()) < 60, true);
    expect("leaving its contents", read_file($path), "kept");
    throws("a missing directory", () -> fs::touch($root .. "/nope/x"), "Cannot open \"{$root}/nope/x\": No such file or directory");
}

// Links to links and links to nothing, in a walk and a glob: listed, never followed
fn link_chains(string $root): null {
    $tree = $root .. "/chains";
    make_dir($tree .. "/real", true);
    write_file($tree .. "/real/file.txt", "x");
    symlink("real", $tree .. "/first");
    symlink("first", $tree .. "/second");
    symlink("missing", $tree .. "/broken");
    symlink("broken", $tree .. "/to-broken");
    symlink("..", $tree .. "/real/up");
    expect("a walk lists each link once and goes through none", fs::walk($tree),
        ["broken", "first", "real", "real/file.txt", "real/up", "second", "to-broken"]);
    $at = len($tree) + 1;
    expect("** goes through no link, however many lead on", map(fs::glob($tree .. "/**"), $p -> slice($p, $at)),
        ["broken", "first", "real", "real/file.txt", "real/up", "second", "to-broken"]);
    expect("a pattern naming a link to a link follows it", map(fs::glob($tree .. "/second/*.txt"), $p -> slice($p, $at)), ["second/file.txt"]);
    expect("a broken link is no directory to go into", fs::glob($tree .. "/broken/*"), []);
    expect("nor is one to a broken link", fs::glob($tree .. "/to-broken/*"), []);
    fs::remove_tree($tree);
    expect("removing goes through no link either", file_exists($tree), false);
}

fn atomic_writes(string $root): null {
    $path = $root .. "/atomic.txt";
    fs::write_atomic($path, "first");
    expect("written", read_file($path), "first");
    fs::write_atomic($path, "second");
    expect("replaced", read_file($path), "second");
    expect("nothing is left beside it", filter(list_dir($root), $n -> contains($n, "atomic")), ["atomic.txt"]);
    try {
        fs::write_atomic($root .. "/nope/x.txt", "x");
    } catch (Error $e) {
        expect("into a missing directory", starts_with($e.message, "Cannot open \"{$root}/nope/.x.txt."), true);
    }
    make_dir($root .. "/in-the-way");
    $before = list_dir($root);
    try {
        fs::write_atomic($root .. "/in-the-way", "x");
    } catch (Error $e) {
        expect("a rename that fails is the error", starts_with($e.message, "Cannot rename"), true);
    }
    expect("and the new file is removed", list_dir($root), $before);
    $private = $root .. "/private.txt";
    write_file($private, "old");
    chmod($private, 0o600);
    fs::write_atomic($private, "new");
    expect("a file that was there keeps its mode", file_info($private)["mode"], 0o600);
    expect("with the new contents", read_file($private), "new");
    fs::write_atomic($root .. "/fresh.txt", "x");
    expect("a new one gets a new file's", file_info($root .. "/fresh.txt")["mode"], file_info($root .. "/README.md")["mode"]);
}

fn removing(string $root): null {
    fs::remove_tree($root .. "/copied");
    expect("a tree goes", file_exists($root .. "/copied"), false);
    make_dir($root .. "/outside");
    write_file($root .. "/outside/keep.txt", "keep");
    make_dir($root .. "/doomed");
    symlink("../outside", $root .. "/doomed/link");
    fs::remove_tree($root .. "/doomed");
    expect("a link in it goes, not what it points at", read_file($root .. "/outside/keep.txt"), "keep");
    symlink("outside", $root .. "/top-link");
    fs::remove_tree($root .. "/top-link");
    expect("a link given itself goes, not what it points at", [file_info($root .. "/top-link", false), is_dir($root .. "/outside")], [null, true]);
    fs::remove_tree($root .. "/outside/keep.txt");
    expect("a file", file_exists($root .. "/outside/keep.txt"), false);
    throws("nothing there", () -> fs::remove_tree($root .. "/nope"), "Cannot delete file \"{$root}/nope\": No such file or directory");
}

fn parents(): null {
    expect("a file's directory", fs::parent("a/b/c.txt"), "a/b");
    expect("a name alone", fs::parent("c.txt"), ".");
    expect("at the root", fs::parent("/x"), "/");
    expect("a trailing slash", fs::parent("a/b/"), "a");
    expect("the root itself", fs::parent("/"), "/");
    expect("absolute", fs::parent("/usr/local/bin"), "/usr/local");
}

temp_dirs();
parents();
$root = fs::temp_dir("fs-test");
try {
    plant($root);
    walking($root);
    globbing($root);
    copying($root);
    keeping($root);
    touching($root);
    link_chains($root);
    atomic_writes($root);
    removing($root);
} finally {
    fs::remove_tree($root);
}
expect("the scratch directory is gone", file_exists($root), false);
