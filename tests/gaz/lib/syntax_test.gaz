// std/syntax.gaz as the parser and the highlighter use it. That it gives the right tokens is
// SelfHostedLexerTest's job, on tests/corpora/lexer.
import "std/syntax.gaz" use Lexer, LexError, Token, TEMPLATE_BUFFER;
import "std/test.gaz" use expect;

// The parser makes tokens of its own (the .. of an interpolated string), which have no line
expect("a token made by hand prints", to_string(Token("CONCAT", "..")), " CONCAT ..");

$lexer = Lexer("1\n  `");
expect("a token from the lexer has its line", to_string($lexer.get_next_token()), "1 INTEGER 1");
try {
    $lexer.get_next_token();
    echo "FAIL no error for a bad character";
} catch (LexError $e) {
    expect("the reason, for the parser to add the file to", $e.reason, "Unexpected character '`'");
    // Not $e.line, which is Error's own and says where in syntax.gaz the error was raised
    expect("the line in the source being read", $e.source_line, 2);
    expect("the message, as --tokens prints it", $e.message, "Unexpected character '`' on line 2");
}

// Two lexers at once, which is what import needs of the parser
$outer = Lexer("a b");
$outer.get_next_token();
$inner = Lexer('"x {$y} z"');
expect("the inner lexer starts afresh", $inner.get_next_token().type, "STRING_START");
expect("the outer one carries on", $outer.get_next_token().value, "b");

// Source translated from a template alone may name the buffer its output is gathered in
expect("a template's buffer is one token", Lexer("\$#html", true).get_next_token().value, TEMPLATE_BUFFER);
try {
    Lexer("\$#html").get_next_token();
    echo "FAIL no error for the buffer outside a template";
} catch (LexError $e) {
    expect("anywhere else it is no name", $e.reason, "Invalid variable name: \$");
}
