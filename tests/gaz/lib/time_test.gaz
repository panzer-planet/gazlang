include "std/test.gaz" use expect, throws;

$first = monotonic_time();
expect("a float", type_of($first), "float");
$second = monotonic_time();
expect("it never goes back", $second >= $first, true);

/* and it moves: look until it does, for as long as it takes a clock with a microsecond to tick */
$looks = 0;
while (monotonic_time() == $first && $looks < 20000000) {
    $looks++;
}
expect("it moves on", monotonic_time() > $first, true);
expect("in seconds: that didn't take a minute", monotonic_time() - $first < 60, true);
expect("and it is positive", $first > 0, true);
$readings = [];
for ($i = 0; $i < 100; $i++) {
    $readings[] = monotonic_time();
}
$sorted = sort($readings, ($a, $b) -> $a <=> $b);
expect("a hundred readings come in order", $readings, $sorted);

/* time(): the wall clock, whole seconds since 1970 (HttpServerTest checks it against PHP's) */
$now = time();
expect("time() is an int", type_of($now), "int");
expect("after 2026 began and before 2100", $now > 1767225600 && $now < 4102444800, true);
expect("and doesn't go back in a moment", time() >= $now, true);

/* sleep(): at least as long as it was asked for, and not a lot longer */
$before = monotonic_time();
expect("sleep() gives null", sleep(0.05), null);
$slept = monotonic_time() - $before;
expect("sleep(0.05) waits that long", $slept >= 0.05, true);
expect("and not a second", $slept < 1, true);
expect("sleep(0) and an int", [sleep(0), sleep(1 - 1)], [null, null]);
$errors = [];
foreach ([-1, -0.5, "1", null] as $bad) {
    try {
        sleep($bad);
    } catch (Error $e) {
        $errors[] = $e.message;
    }
}
expect("sleep() takes 0 seconds or more", $errors, [
    "sleep() expects 0 seconds or more, got -1",
    "sleep() expects 0 seconds or more, got -0.5",
    "sleep() expects int or float, got string",
    "sleep() expects int or float, got null",
]);

/* getenv(): a string, or null for a name that isn't set (StdlibTest checks a value it sets) */
expect("PATH is a string", type_of(getenv("PATH")), "string");
expect("a name not set is null", getenv("GAZLANG_NOT_SET_ANYWHERE"), null);
expect("nor is the empty name", getenv(""), null);
throws("a NUL byte is a mistake", () -> getenv("PA\0TH"), "getenv() expects a name without a NUL byte");
