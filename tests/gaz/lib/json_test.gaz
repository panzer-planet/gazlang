include "../check.gaz";
include "../../../lib/json.gaz";

// Unicode escapes are built from parts so they stay escapes in this source file
$u = "\\" .. "u";

// Decoding: types
check("int", json::decode("42"), 42);
check("negative zero int", json::decode("-0"), 0);
check("float", json::decode("1.5"), 1.5);
check("exponent makes a float", json::decode("1e2"), 100.0);
check("negative zero float", to_string(json::decode("-0.0")), "-0.0");
check("largest int stays an int", json::decode("9223372036854775807"), 9223372036854775807);
check("smallest int stays an int", json::decode("-9223372036854775808"), -9223372036854775807 - 1);
check("too large for an int becomes a float", json::decode("9223372036854775808"), 9.223372036854775808e18);
check("true, false, null", json::decode("[true, false, null]"), [true, false, null]);
check("string", json::decode("\"text\""), "text");

// Decoding: structures
check("object", json::decode("{\"a\": 1, \"b\": [2]}"), {"a" => 1, "b" => [2]});
check("empty object and array", json::decode("[{}, []]"), [{}, []]);
check("numeric object keys stay strings", json::decode("{\"0\": \"a\", \"1\": \"b\"}"), {"0" => "a", "1" => "b"});
check("leading zero key stays a string", has_key(json::decode("{\"01\": 1}"), "01"), true);
check("empty key", json::decode("{\"\": 1}"), {"" => 1});
check("duplicate keys: last wins", json::decode("{\"a\": 1, \"a\": 2}"), {"a" => 2});
check("whitespace", json::decode(" \t\n\r[ 1 , 2 ]\r\n "), [1, 2]);

// Decoding: strings
check("simple escapes", json::decode("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\""), "\"\\/" .. chr(8) .. "\f\n\r\t");
check("unicode escape", json::decode("\"" .. $u .. "0041" .. $u .. "00e9\""), "A" .. chr(195) .. chr(169));
check("three byte UTF-8", json::decode("\"" .. $u .. "20ac\""), chr(226) .. chr(130) .. chr(172));
check("surrogate pair", json::decode("\"" .. $u .. "d83d" .. $u .. "de00\""), chr(240) .. chr(159) .. chr(152) .. chr(128));
check("escaped NUL", json::decode("\"" .. $u .. "0000\""), chr(0));
check("raw UTF-8 passes through", json::decode("\"caf" .. chr(195) .. chr(169) .. "\""), "caf" .. chr(195) .. chr(169));

// Encoding
check("encode scalars", json::encode([1, -2, 1.5, 1.0, true, false, null]), "[1,-2,1.5,1.0,true,false,null]");
check("encode exact floats", json::encode([0.1 + 0.2, 1e25]), "[0.30000000000000004,1.0E+25]");
check("encode object", json::encode({"a" => 1, "b" => {"c" => null}}), "{\"a\":1,\"b\":{\"c\":null}}");
check("a map is an object, int keys as strings", json::encode({1 => "a", 0 => "b"}), "{\"1\":\"a\",\"0\":\"b\"}");
check("empty list and map", json::encode([[], {}]), "[[],{}]");
check("encode string escapes", json::encode("\"\\/\n\r\t\f" .. chr(8)), "\"\\\"\\\\/\\n\\r\\t\\f\\b\"");
check("encode other control bytes", json::encode(chr(1) .. chr(31)), "\"" .. $u .. "0001" .. $u .. "001f\"");
check("encode UTF-8 as is", json::encode("caf" .. chr(195) .. chr(169)), "\"caf" .. chr(195) .. chr(169) .. "\"");
check("encode $ and { literally", json::encode('{$x} $y'), '"{$x} $y"');

// Round trips
$document = {"name" => "Gaz", "tags" => ["a", "b"], "n" => -12, "f" => 0.1, "nested" => [[], {"k" => false}]};
check("decode undoes encode", json::decode(json::encode($document)), $document);
$text = "{\"a\":[1,2.5,\"x\"],\"b\":{\"c\":null}}";
check("encode undoes decode for compact JSON", json::encode(json::decode($text)), $text);

// Functions have no JSON form
try {
    json::encode([len]);
    echo "FAIL encoding a function";
} catch ($e) {
    check("encoding a function is an error", $e.message, "Cannot encode a function as JSON");
}

// Nor do classes and objects
class Point { #x = 1; }
try {
    json::encode({"p" => Point});
    echo "FAIL encoding a class";
} catch ($e) {
    check("encoding a class is an error", $e.message, "Cannot encode a class as JSON");
}
try {
    json::encode([Point()]);
    echo "FAIL encoding an object";
} catch ($e) {
    check("encoding an object is an error", $e.message, "Cannot encode an object as JSON");
}
