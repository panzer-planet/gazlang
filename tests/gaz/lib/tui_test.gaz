include "std/test.gaz" use expect, throws;
include "std/term.gaz";
include "std/tui.gaz";

/* $line without the spaces at its end */
fn trim_end_of($line) {
    while (ends_with($line, " ")) {
        $line = slice($line, 0, -1);
    }
    return $line;
}

/* Type $bytes at $widget, key by key, and give what its handle() said last that wasn't null */
fn press($widget, $bytes) {
    $said = null;
    foreach (term::decode($bytes, true)["keys"] as $key) {
        $said = $widget.handle($key) ?? $said;
    }
    return $said;
}

/* $text without the spaces at its end */
fn rtrim($text) {
    while (ends_with($text, " ")) {
        $text = slice($text, 0, -1);
    }
    return $text;
}

/* The screen's rows with the trailing blanks off, joined with "|" */
fn rows($screen) {
    return join(map($screen.lines(), $line -> rtrim($line)), "|");
}

/* ---- Screen ---- */
$s = tui::Screen(6, 3);
expect("a screen starts blank", $s.lines(), ["      ", "      ", "      "]);
expect("size", [$s.cols, $s.rows], [6, 3]);
$s.put(2, 1, "abc");
expect("put", $s.lines()[0], " abc  ");
expect("put: a cell is a character and a style", $s.cell(2, 1), ["a", ""]);
$s.put(5, 2, "wxyz", "bold");
expect("put clips on the right", $s.lines()[1], "    wx");
expect("put keeps the style", $s.cell(6, 2), ["x", "bold"]);
$s.put(-1, 3, "abcd");
expect("put clips on the left", $s.lines()[2], "cd    ");
$s.put(1, 0, "no");
$s.put(1, 4, "no");
expect("put outside the rows does nothing", $s.lines()[0], " abc  ");
$s.put(1, 1, "é→x");
expect("put is a character to a cell", $s.lines()[0], "é→xc  ");
$s.fill(2, 2, 2, 2, "#", "dim");
expect("fill", $s.lines(), ["é→xc  ", " ## wx", "c##   "]);
expect("fill: the style", $s.cell(2, 3), ["#", "dim"]);
$s.fill(1, 1, 0, 3);
$s.fill(1, 1, -2, 3);
expect("fill of no width does nothing", $s.lines()[0], "é→xc  ");
$s.clear();
expect("clear", $s.lines(), ["      ", "      ", "      "]);
expect("clear: the cells are blank again", $s.cell(2, 2), [" ", ""]);
$s.put(1, 1, "keep");
$s.resize(3, 2);
expect("resize: blank at the new size", [$s.cols, $s.rows, $s.lines()], [3, 2, ["   ", "   "]]);

/* ---- Rendering ---- */
$s = tui::Screen(5, 3);
$s.put(2, 1, "hi");
$s.put(1, 3, "ab", "bold");
expect(
    "the first render clears and draws what isn't blank",
    $s.render(),
    "\e[0m\e[2J\e[1;2Hhi\e[3;1H\e[1mab\e[0m\e[?25l"
);
expect("a render of nothing new is only the cursor", $s.render(), "\e[?25l");
$s.put(3, 1, "o");
expect("a changed cell", $s.render(), "\e[1;3Ho\e[?25l");
$s.put(1, 1, "x");
$s.put(5, 1, "y");
expect("a changed row is redrawn from its first change to its last", $s.render(), "\e[1;1Hxho y\e[?25l");
$s.put(1, 3, "ab", "italic");
expect("a style change alone", $s.render(), "\e[3;1H\e[3mab\e[0m\e[?25l");
$s.clear();
expect("cleared again: what was there is blanked", $s.render(), "\e[1;1H     \e[3;1H  \e[?25l");
$s.invalidate();
expect("invalidate draws everything again", $s.render(), "\e[0m\e[2J\e[?25l");
$s.put(2, 2, "z");
$s.cursor(3, 2);
expect("the cursor is shown where it was put", $s.render(), "\e[2;2Hz\e[2;3H\e[?25h");
$s.clear();
expect("clear forgets the cursor", $s.render(), "\e[2;2H \e[?25l");

/* A style ends at the cell where it changes, and each run says where it is */
$s = tui::Screen(8, 1);
$s.put(1, 1, "ab", "red");
$s.put(3, 1, "cd", "on_blue");
$s.put(5, 1, "ef");
expect("styles in a row", $s.render(), "\e[0m\e[2J\e[1;1H\e[31mab\e[0m\e[44mcd\e[0mef\e[?25l");

/* ---- label ---- */
$s = tui::Screen(12, 1);
tui::label($s, 2, 1, 8, "abc");
expect("label: left", $s.lines()[0], " abc        ");
$s.clear();
tui::label($s, 2, 1, 8, "abc", "", "right");
expect("label: right", $s.lines()[0], "      abc   ");
$s.clear();
tui::label($s, 2, 1, 8, "abc", "", "center");
expect("label: centre", $s.lines()[0], "   abc      ");
$s.clear();
tui::label($s, 2, 1, 4, "abcdefgh");
expect("label: cut off", $s.lines()[0], " abcd       ");
$s.clear();
tui::label($s, 1, 1, 12, "é→");
expect("label: characters, not bytes", $s.lines()[0], "é→          ");
tui::label($s, 1, 1, 0, "no");
tui::label($s, 1, 1, -3, "no");
expect("label: no room", $s.lines()[0], "é→          ");

/* ---- box ---- */
$s = tui::Screen(10, 4);
tui::box($s, 1, 1, 10, 4);
expect("box", $s.lines(), ["┌────────┐", "│        │", "│        │", "└────────┘"]);
tui::box($s, 1, 1, 10, 4, "Hi");
expect("box: a title", $s.lines()[0], "┌─ Hi ───┐");
tui::box($s, 1, 1, 10, 4, "A very long title");
expect("box: a long title is cut", $s.lines()[0], "┌─ A very┐");
$s.put(3, 2, "text");
tui::box($s, 1, 1, 10, 4, "", "", "double");
expect("box: the inside is cleared", $s.lines(), ["╔════════╗", "║        ║", "║        ║", "╚════════╝"]);
$b = tui::Screen(4, 3);
tui::box($b, 1, 1, 4, 3, "", "", "ascii");
expect("box: ascii", $b.lines(), ["+--+", "|  |", "+--+"]);
tui::box($b, 1, 1, 4, 3, "", "", "round");
expect("box: round", $b.lines(), ["╭──╮", "│  │", "╰──╯"]);
tui::box($b, 1, 1, 4, 3, "", "", "heavy");
expect("box: heavy", $b.lines(), ["┏━━┓", "┃  ┃", "┗━━┛"]);
tui::box($b, 1, 1, 4, 3, "ab");
expect("box: a title too wide for the box is left out", $b.lines()[0], "┌──┐");
$b.clear();
tui::box($b, 3, 2, 4, 3);
expect("box: clipped by the screen", rows($b), "|  ┌─|  │");
tui::box($b, 1, 1, 1, 1);
throws("box: an unknown border", () -> tui::box($b, 1, 1, 4, 3, "", "", "wavy"), "tui::box: unknown border \"wavy\"");

/* ---- progress ---- */
$s = tui::Screen(15, 1);
tui::progress($s, 1, 1, 15, 0);
expect("progress: none", $s.lines()[0], "░░░░░░░░░░   0%");
tui::progress($s, 1, 1, 15, 0.5);
expect("progress: half", $s.lines()[0], "█████░░░░░  50%");
tui::progress($s, 1, 1, 15, 1);
expect("progress: all", $s.lines()[0], "██████████ 100%");
tui::progress($s, 1, 1, 15, 7);
expect("progress: more than all is all", $s.lines()[0], "██████████ 100%");
tui::progress($s, 1, 1, 15, -1);
expect("progress: less than none is none", $s.lines()[0], "░░░░░░░░░░   0%");
tui::progress($s, 1, 1, 15, 0.42, "red");
expect("progress: filled cells take the style, the rest is dim", [$s.cell(4, 1), $s.cell(5, 1)], [["█", "red"], ["░", "dim"]]);
$s = tui::Screen(5, 1);
tui::progress($s, 1, 1, 5, 0.5);
expect("progress: too narrow for a bar", $s.lines()[0], "     ");

/* ---- table ---- */
$s = tui::Screen(20, 6);
$height = tui::table($s, 1, 1, ["Name", "Pts"], [["Ann", 12], ["Bob", 7], ["Christina", 105]]);
expect("table", rows($s), "Name      │ Pts|──────────┼────|Ann       │  12|Bob       │   7|Christina │ 105|");
expect("table: how many rows it took", $height, 5);
expect("table: the header is bold, the rule dim", [$s.cell(1, 1)[1], $s.cell(1, 2)[1], $s.cell(1, 3)[1]], ["bold", "dim", ""]);
$s = tui::Screen(20, 4);
tui::table($s, 2, 2, ["é", "x"], [["→→→", 1.5]]);
expect("table: characters, and floats on the right", rows($s), "| é   │ x| ────┼────| →→→ │ 1.5");

$s = tui::Screen(24, 6);
$height = tui::table($s, 1, 1, ["a"], [[1, 2, 3]]);
expect("table: a row longer than the headers", [rows($s), $height], ["a │   │|──┼───┼──|1 │ 2 │ 3|||", 3]);
$s = tui::Screen(24, 6);
tui::table($s, 1, 1, ["a", "b", "c"], [[1], ["xx", 2]]);
expect("table: rows shorter than the headers", rows($s), "a  │ b │ c|───┼───┼──| 1 │   │|xx │ 2 │||");
$s = tui::Screen(24, 4);
$height = tui::table($s, 1, 1, [], [[7, 8]]);
expect("table: no headers", [rows($s), $height], ["  │|──┼──|7 │ 8|", 3]);
$s = tui::Screen(24, 4);
$height = tui::table($s, 1, 1, ["x"], []);
expect("table: no rows", [rows($s), $height], ["x|─||", 2]);

/* ---- Menu ---- */
$menu = tui::Menu(["one", "two", "three", "four"], "Pick");
expect("menu: starts on the first", [$menu.index(), $menu.item()], [0, "one"]);
expect("menu: down", [press($menu, "\e[B"), $menu.index()], [null, 1]);
press($menu, "j");
expect("menu: j is down too", $menu.index(), 2);
press($menu, "\e[B\e[B\e[B");
expect("menu: stops at the last", $menu.index(), 3);
press($menu, "\e[A");
expect("menu: up", $menu.index(), 2);
press($menu, "k");
press($menu, "k");
press($menu, "k");
expect("menu: stops at the first", $menu.index(), 0);
press($menu, "\e[F");
expect("menu: end", $menu.index(), 3);
press($menu, "\e[H");
expect("menu: home", $menu.index(), 0);
press($menu, "G");
expect("menu: G", $menu.index(), 3);
press($menu, "g");
expect("menu: g", $menu.index(), 0);
expect("menu: enter selects", press($menu, "\r"), "select");
expect("menu: escape cancels", press($menu, "\e"), "cancel");
expect("menu: q cancels", press($menu, "q"), "cancel");
expect("menu: ctrl+c cancels", press($menu, "\x03"), "cancel");
expect("menu: a key it doesn't know is nothing", press($menu, "x"), null);
expect("menu: the end of the input cancels", $menu.handle({"key" => "eof", "ctrl" => false, "alt" => false, "shift" => false}), "cancel");

$s = tui::Screen(12, 5);
$menu = tui::Menu(["one", "two", "three", "four", "five"], "Pick");
$menu.draw($s, 1, 1, 12, 5);
expect("menu: draw", $s.lines(), ["┌─ Pick ───┐", "│> one     │", "│  two     │", "│  three   │", "└──────────┘"]);
expect("menu: the selected item is inverse", [$s.cell(3, 2)[1], $s.cell(3, 3)[1]], ["inverse", ""]);
press($menu, "\e[B\e[B\e[B");
$menu.draw($s, 1, 1, 12, 5);
expect("menu: scrolls to keep the selection in view", $s.lines()[1] .. $s.lines()[2] .. $s.lines()[3], "│  two     ││  three   ││> four    │");
press($menu, "\e[6~");
expect("menu: page down goes to the last", $menu.index(), 4);
$menu.draw($s, 1, 1, 12, 5);
expect("menu: scrolled to the end", $s.lines()[3], "│> five    │");
press($menu, "\e[5~");
expect("menu: page up is a page (the rows showing, less one)", $menu.index(), 2);
$empty = tui::Menu([]);
expect("menu: no items, nothing to move", [press($empty, "\e[B"), press($empty, "\e[F"), $empty.index()], [null, null, 0]);
expect("menu: j and page down on nothing", [press($empty, "j"), press($empty, "\e[6~"), $empty.index()], [null, null, 0]);
expect("menu: nothing to select", press($empty, "\r"), null);
$one = tui::Menu(["only"]);
expect("menu: one item can still be selected", press($one, "j\r"), "select");
expect("tui::choose of nothing is nothing", tui::choose([]), null);

