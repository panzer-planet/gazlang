include "../check.gaz";
include "../../../lib/term.gaz";
include "../../../lib/tui.gaz";

/* Type $bytes at $widget, key by key, and give what its handle() said last that wasn't null */
fn press($widget, $bytes) {
    $said = null;
    foreach (term::decode($bytes, true)["keys"] as $key) {
        $said = $widget.handle($key) ?? $said;
    }
    return $said;
}

/* $text without the spaces at its end */
fn rtrim($text) {
    while (ends_with($text, " ")) {
        $text = slice($text, 0, -1);
    }
    return $text;
}

/* The screen's rows with the trailing blanks off, joined with "|" */
fn rows($screen) {
    return join(map($screen.lines(), $line -> rtrim($line)), "|");
}

/* ---- Screen ---- */
$s = tui::Screen(6, 3);
check("a screen starts blank", $s.lines(), ["      ", "      ", "      "]);
check("size", [$s.cols, $s.rows], [6, 3]);
$s.put(2, 1, "abc");
check("put", $s.lines()[0], " abc  ");
check("put: a cell is a character and a style", $s.cell(2, 1), ["a", ""]);
$s.put(5, 2, "wxyz", "bold");
check("put clips on the right", $s.lines()[1], "    wx");
check("put keeps the style", $s.cell(6, 2), ["x", "bold"]);
$s.put(-1, 3, "abcd");
check("put clips on the left", $s.lines()[2], "cd    ");
$s.put(1, 0, "no");
$s.put(1, 4, "no");
check("put outside the rows does nothing", $s.lines()[0], " abc  ");
$s.put(1, 1, "é→x");
check("put is a character to a cell", $s.lines()[0], "é→xc  ");
$s.fill(2, 2, 2, 2, "#", "dim");
check("fill", $s.lines(), ["é→xc  ", " ## wx", "c##   "]);
check("fill: the style", $s.cell(2, 3), ["#", "dim"]);
$s.fill(1, 1, 0, 3);
$s.fill(1, 1, -2, 3);
check("fill of no width does nothing", $s.lines()[0], "é→xc  ");
$s.clear();
check("clear", $s.lines(), ["      ", "      ", "      "]);
check("clear: the cells are blank again", $s.cell(2, 2), [" ", ""]);
$s.put(1, 1, "keep");
$s.resize(3, 2);
check("resize: blank at the new size", [$s.cols, $s.rows, $s.lines()], [3, 2, ["   ", "   "]]);

/* ---- Rendering ---- */
$s = tui::Screen(5, 3);
$s.put(2, 1, "hi");
$s.put(1, 3, "ab", "bold");
check(
    "the first render clears and draws what isn't blank",
    $s.render(),
    "\e[0m\e[2J\e[1;2Hhi\e[3;1H\e[1mab\e[0m\e[?25l"
);
check("a render of nothing new is only the cursor", $s.render(), "\e[?25l");
$s.put(3, 1, "o");
check("a changed cell", $s.render(), "\e[1;3Ho\e[?25l");
$s.put(1, 1, "x");
$s.put(5, 1, "y");
check("a changed row is redrawn from its first change to its last", $s.render(), "\e[1;1Hxho y\e[?25l");
$s.put(1, 3, "ab", "italic");
check("a style change alone", $s.render(), "\e[3;1H\e[3mab\e[0m\e[?25l");
$s.clear();
check("cleared again: what was there is blanked", $s.render(), "\e[1;1H     \e[3;1H  \e[?25l");
$s.invalidate();
check("invalidate draws everything again", $s.render(), "\e[0m\e[2J\e[?25l");
$s.put(2, 2, "z");
$s.cursor(3, 2);
check("the cursor is shown where it was put", $s.render(), "\e[2;2Hz\e[2;3H\e[?25h");
$s.clear();
check("clear forgets the cursor", $s.render(), "\e[2;2H \e[?25l");

/* A style ends at the cell where it changes, and each run says where it is */
$s = tui::Screen(8, 1);
$s.put(1, 1, "ab", "red");
$s.put(3, 1, "cd", "on_blue");
$s.put(5, 1, "ef");
check("styles in a row", $s.render(), "\e[0m\e[2J\e[1;1H\e[31mab\e[0m\e[44mcd\e[0mef\e[?25l");

/* ---- label ---- */
