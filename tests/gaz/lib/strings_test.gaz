import "std/test.gaz" use expect, throws;

expect("upper", upper("abC1_z"), "ABC1_Z");
expect("lower", lower("AbC1_Z"), "abc1_z");

expect("trim both ends", trim(" \t x y \n\r"), "x y");
expect("trim keeps inner whitespace", trim("a  b"), "a  b");
expect("trim only whitespace", trim(" \n "), "");
expect("trim leaves other control bytes", trim("\v x \f"), "\v x \f");

expect("split", split("a,b,c", ","), ["a", "b", "c"]);
expect("split keeps empty pieces", split(",a,,b,", ","), ["", "a", "", "b", ""]);
expect("split multi-character separator", split("a::b", "::"), ["a", "b"]);
expect("split without the separator", split("abc", ","), ["abc"]);
expect("split empty string", split("", ","), [""]);
expect("split into characters", split("abc", ""), ["a", "b", "c"]);
expect("split empty string into characters", split("", ""), []);
expect("split at most two", split("a=b=c", "=", 2), ["a", "b=c"]);
expect("split at most one is the string", split("a=b=c", "=", 1), ["a=b=c"]);
expect("split with a limit above the parts", split("a=b=c", "=", 9), ["a", "b", "c"]);
expect("split with a null limit", split("a=b=c", "=", null), ["a", "b", "c"]);
expect("split keeps an empty rest", split("a=", "=", 2), ["a", ""]);
expect("split into characters, at most two", split("abc", "", 2), ["a", "bc"]);
expect("split empty string, at most two", [split("", "=", 2), split("", "", 2)], [[""], []]);

expect("join", join(["a", "b", "c"], ", "), "a, b, c");
expect("join converts like echo", join([1, true, false, null, [2]], "|"), "1|true|false|null|[2]");
expect("join empty array", join([], ","), "");
expect("join undoes split", join(split("a b c", " "), " "), "a b c");

expect("replace every occurrence", replace("a.b.c", ".", "::"), "a::b::c");
expect("replace with empty", replace("a-b-c", "-", ""), "abc");
expect("replace not found", replace("abc", "x", "y"), "abc");

expect("contains", contains("hello", "ell"), true);
expect("contains not", contains("hello", "elo"), false);
expect("contains empty needle", contains("hello", ""), true);
expect("starts_with", starts_with("hello", "he"), true);
expect("starts_with not", starts_with("hello", "lo"), false);
expect("starts_with at an offset", starts_with("hello", "ll", 2), true);
expect("starts_with at the wrong offset", starts_with("hello", "ll", 3), false);
expect("starts_with negative offset counts from the end", starts_with("hello", "lo", -2), true);
expect("starts_with a prefix longer than what is left", starts_with("hello", "lo!", 3), false);
expect("starts_with at the last byte", starts_with("hello", "o", 4), true);
expect("starts_with an empty prefix at the end", starts_with("hello", "", 5), true);
expect("starts_with anything else at the end", starts_with("hello", "x", 5), false);
expect("starts_with an empty prefix is always there", starts_with("", "", 0), true);
throws("starts_with offset past the end is an error", () -> starts_with("abc", "a", 4), "starts_with() offset 4 is outside the string");
throws("starts_with negative offset before the start is an error", () -> starts_with("abc", "a", -4), "starts_with() offset -4 is outside the string");
expect("ends_with", ends_with("hello", "lo"), true);
expect("ends_with not", ends_with("hello", "he"), false);

expect("index_of first match", index_of("hello", "l"), 2);
expect("index_of at start", index_of("hello", "he"), 0);
expect("index_of not found is null", index_of("hello", "z"), null);
expect("index_of from an offset", index_of("a-b-c", "-", 2), 3);
expect("index_of offset at the match", index_of("a-b-c", "-", 1), 1);
expect("index_of negative offset counts from the end", index_of("a-b-a", "a", -1), 4);
expect("index_of offset at the end", index_of("abc", "c", 3), null);
throws("index_of empty needle is an error", () -> index_of("abc", ""), "index_of() cannot search for an empty string");
throws("index_of offset past the end is an error", () -> index_of("abc", "a", 4), "index_of() offset 4 is outside the string");

expect("repeat", repeat("ab", 3), "ababab");
expect("repeat zero times", repeat("ab", 0), "");

expect("single quotes are raw", 'C:\path\new', "C:\\path\\new");
expect("single quote escapes", 'it\'s a back\\slash', "it's a back\\slash");
expect("single and double quotes concatenate", 'a' .. "b", "ab");
