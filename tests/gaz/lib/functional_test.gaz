import "std/test.gaz" use expect, throws;

// map
expect("map a list", map([1, 2, 3], $x -> $x * 2), [2, 4, 6]);
expect("map keeps keys", map({"a" => 1, "b" => 2}, $x -> $x + 1), {"a" => 2, "b" => 3});
expect("map with a builtin", map(["a", "b"], upper), ["A", "B"]);
expect("map an empty list and map", [map([], $x -> $x), map({}, $x -> $x)], [[], {}]);

// filter
expect("filter a list gives a list", filter([1, 2, 3, 4], $x -> $x % 2 == 0), [2, 4]);
expect("filter a map keeps keys", filter({"a" => 1, "b" => 2, "c" => 3}, $x -> $x != 2), {"a" => 1, "c" => 3});
expect("filter everything out", filter([1, 2], $x -> false), []);
expect("filter uses truthiness", filter([0, 1, "", "x", [], [0], {}], $x -> $x), [1, "x", [0]]);

// reduce
expect("reduce sums", reduce([1, 2, 3], ($sum, $x) -> $sum + $x, 0), 6);
expect("reduce from the initial value", reduce([], ($sum, $x) -> $sum + $x, 10), 10);
expect("reduce builds a string", reduce(["a", "b"], ($s, $x) -> $s .. $x, ">"), ">ab");
expect("reduce with a named function", reduce([[1], [2, 3]], ($n, $a) -> $n + len($a), 0), 3);

// sort
expect("sort numbers", sort([5, 3, 9, 1, 3], ($a, $b) -> $a <=> $b), [1, 3, 3, 5, 9]);
expect("sort descending", sort([5, 3, 9, 1], ($a, $b) -> $b <=> $a), [9, 5, 3, 1]);
expect("sort strings byte by byte", sort(["b", "B", "a", "10", "9"], ($a, $b) -> $a <=> $b), ["10", "9", "B", "a", "b"]);
expect("sort drops keys", sort({"z" => 2, "y" => 1}, ($a, $b) -> $a <=> $b), [1, 2]);
expect("sort empty and one", [sort([], ($a, $b) -> 0), sort(["x"], ($a, $b) -> 0)], [[], ["x"]]);
$people = [{"n" => "Ada", "t" => 2}, {"n" => "Bob", "t" => 1}, {"n" => "Cy", "t" => 2}, {"n" => "Di", "t" => 1}];
expect("sort is stable", map(sort($people, ($a, $b) -> $a["t"] <=> $b["t"]), $p -> $p["n"]), ["Bob", "Di", "Ada", "Cy"]);
$by_length_then_text = ($a, $b) -> {
    $by_length = len($a) <=> len($b);
    return $by_length != 0 ? $by_length : $a <=> $b;
};
// Without a comparator, or with null, it is <=>: the same order and the same errors
expect("sort by <=>", sort([5, 3.5, 9, -1, 3]), [-1, 3, 3.5, 5, 9]);
expect("sort strings by <=>", sort(["b", "B", "a", "10", "9"]), ["10", "9", "B", "a", "b"]);
expect("sort lists by <=>", sort([[1, "b"], [0, "z"], [1, "a"], [1]]), [[0, "z"], [1], [1, "a"], [1, "b"]]);
expect("sort a map's values by <=>", sort({"z" => 2, "y" => 1}), [1, 2]);
expect("a null comparator is <=>", sort([2, 1], null), [1, 2]);
expect("<=> is stable", sort([1.0, 1, 0]), [0, 1.0, 1]);
throws("sort by <=> of a string and a number", () -> sort([1, "a"]), "Cannot use <=> on string and int");
throws("sort by <=> of a map", () -> sort([{}, {}]), "Cannot use <=> on map");
expect("sort by length then text", sort(["bb", "a", "ccc", "aa"], $by_length_then_text), ["a", "aa", "bb", "ccc"]);
throws("a comparator error comes out", () -> sort([1, "one"], ($a, $b) -> $a <=> $b), "Cannot use <=> on string and int");

// composing
expect("map then filter then reduce", reduce(filter(map([1, 2, 3, 4], $x -> $x * $x), $x -> $x > 4), ($s, $x) -> $s + $x, 0), 25);

// Arguments are checked before anything is called, even with nothing to call it on
fn message($f) {
    try {
        $f();
    } catch (Error $e) {
        return $e.message;
    }
}
throws("map needs a list or map", () -> map(5, $x -> $x), "map() expects list or map, got int");
throws("map needs something to call", () -> map([], 5), "map() expects function or kind, got int");
throws("filter checks too", () -> filter("abc", $x -> $x), "filter() expects list or map, got string");
throws("reduce checks too", () -> reduce([], null, 0), "reduce() expects function or kind, got null");
throws("sort checks too", () -> sort({}, "x"), "sort() expects function or kind or null, got string");

// Anything callable is called as a call in the program is
kind Pair {
    pub #value;
    fn _($value) { #value = $value; }
    pub fn twice($x) { return $x * 2; }
}
abstract kind Shape {}
expect("a kind constructs", map(map([1, 2], Pair), $p -> $p.value), [1, 2]);
expect("a bound method", map([1, 2], Pair(0).twice), [2, 4]);
expect("a builtin", map([[1], [1, 2]], len), [1, 2]);
throws("an abstract kind can't", () -> map([1], Shape), "Cannot construct abstract kind Shape");
throws("a builtin with the wrong count", () -> map([1], slice), "Function slice expects 2 to 3 arguments, 1 given");
throws("a lambda with the wrong count", () -> map([1], ($a, $b, $c) -> $a), "Function -> at tests/gaz/lib/functional_test.gaz:74 expects 3 arguments, 2 given");
throws("a bound method with the wrong count", () -> reduce([1], Pair(0).twice, 0), "Method Pair.twice expects 1 argument, 2 given");

// Keys stay what they were: 1 and "1" are different keys
expect("map keeps int and string keys apart", map({1 => "a", "1" => "b"}, upper), {1 => "A", "1" => "B"});
expect("filter too", filter({1 => "a", "1" => "", 2 => "c"}, $x -> $x), {1 => "a", 2 => "c"});
expect("reduce folds a map's values", reduce({"x" => 1, "y" => 2}, ($s, $v) -> $s + $v, 0), 3);

// sort's comparator must give an int, as <=> does, and isn't asked when there is nothing to compare
throws("a float is not an int", () -> sort([2, 1], ($a, $b) -> 1.5), "sort's comparator must return an int, got float");
throws("nor a bool", () -> sort([2, 1], ($a, $b) -> $a > $b), "sort's comparator must return an int, got bool");
expect("one value isn't compared", sort([1], ($a, $b) -> "x"), [1]);

// Which comparisons sort makes, and in what order, is part of what it does
@compared = [];
$sorted = sort([3, 1, 2], ($a, $b) -> {
    @compared[] = [$a, $b];
    return $a <=> $b;
});
expect("sort's comparisons", [$sorted, @compared], [[1, 2, 3], [[2, 1], [1, 3], [2, 3]]]);

// A failing callback stops the rest, and the error comes out of the builtin
@called = 0;
fn count_then_divide($x) {
    @called++;
    return 1 / $x;
}
expect("map stops", [message(() -> map([1, 0, 2], count_then_divide)), @called], ["Division by zero", 2]);
throws("an error value comes out as it is", () -> filter([1], $x -> throw "no"), "no");
try {
    reduce([1], ($c, $x) -> throw [$c, $x], "c");
} catch ($thrown) {
    expect("a thrown value", $thrown, ["c", 1]);
}
throws("sort stops mid-merge", () -> sort([3, 1, 2, "a"], ($a, $b) -> $a <=> $b), "Cannot use <=> on string and int");

// A closure keeps its variables between the calls
$n = 0;
$number = $x -> {
    $n++;
    return $n;
};
expect("a closure counts", map(["a", "b", "c"], $number), [1, 2, 3]);
expect("nested", map([[1, 2], [3]], $l -> map($l, $x -> $x * 10)), [[10, 20], [30]]);
$list = [1, 2];
expect("changing the list inside doesn't change what is mapped", map($list, $x -> {
    $list[] = 9;
    return $x;
}), [1, 2]);

// A map with entries deleted, at the end and in the middle, holds only what is left
$holes = {"a" => 1, "b" => 2, "c" => 3, "d" => 4};
delete $holes["b"];
delete $holes["d"];
expect("map skips what was deleted", map($holes, $x -> $x * 10), {"a" => 10, "c" => 30});
expect("filter too", filter($holes, $x -> true), {"a" => 1, "c" => 3});
expect("reduce too", reduce($holes, ($s, $x) -> $s .. $x, ""), "13");
expect("sort too", sort($holes, ($a, $b) -> $b <=> $a), [3, 1]);

// More failures on the way: over a map, in sort's left half, and the first argument's type
throws("mapping a map stops", () -> map({"a" => 1, "b" => 0}, $x -> 1 / $x), "Division by zero");
throws("filtering a map stops", () -> filter({"a" => 0}, $x -> 1 / $x), "Division by zero");
throws("sort stops in the left half", () -> sort(["a", 1, 3, 2], ($a, $b) -> $a <=> $b), "Cannot use <=> on string and int");
throws("reduce needs a list or map", () -> reduce(5, ($c, $x) -> $c, 0), "reduce() expects list or map, got int");
throws("sort needs a list or map", () -> sort(5, ($a, $b) -> 0), "sort() expects list or map, got int");

// A builtin as the callback that runs program code itself: to_string() calling a method, map()
// calling a lambda
kind Named {
    #name;
    fn _($name) { #name = $name; }
    pub fn to_string() { return "named " .. #name; }
}
expect("to_string runs each object's method", map([Named("a"), Named("b")], to_string), ["named a", "named b"]);
expect("map as reduce's callback", reduce([$x -> "a" .. $x, $x -> $x .. "b"], map, ["p", "q"]), ["apb", "aqb"]);
$both = [Named(""), Named("x")];
expect("filter with to_string", filter($both, to_string), $both);
$apply = map;
expect("map as a value, with to_string", $apply({"k" => Named("c")}, to_string), {"k" => "named c"});
kind Broken {
    pub fn to_string() { return 1 / 0; }
}
throws("its error comes out", () -> map([Named("a"), Broken(), Named("b")], to_string), "Division by zero");

// a function that needs two arguments is given the element's index or key as the second
expect("map gives a two-parameter function the index", map(["a", "b", "c"], ($v, $i) -> $i .. $v), ["0a", "1b", "2c"]);
expect("filter gives it the index: every other element", filter([5, 6, 7, 8], ($v, $i) -> $i % 2 == 0), [5, 7]);
expect("over a map the second argument is the key", map({"x" => 1, "y" => 2}, ($v, $k) -> $k .. $v), {"x" => "x1", "y" => "y2"});
expect("and filter keeps the keys it is given", filter({"x" => 1, "y" => 2, "z" => 3}, ($v, $k) -> $k != "y"), {"x" => 1, "z" => 3});
expect("reduce gives a three-parameter function the index as the third", reduce(["a", "b", "c"], ($acc, $v, $i) -> $acc .. $i .. $v, ""), "0a1b2c");
expect("over a map reduce's third argument is the key", reduce({"p" => 2, "q" => 5}, ($acc, $v, $k) -> $acc .. $k .. $v, ""), "p2q5");
fn tag_with_index($value, $index) { return "{$index}:{$value}"; }
expect("a named function that needs two is given the index too", map(["u", "v"], tag_with_index), ["0:u", "1:v"]);
kind Tagger {
    fn tag($value, $index) { return "{$index}={$value}"; }
    pub fn all($values) { return map($values, #tag); }
}
expect("and so is a method", Tagger().all(["m", "n"]), ["0=m", "1=n"]);
// a function that takes the value alone is called with the value alone, as it always was
expect("one parameter: the value alone", map([10, 20], $v -> $v + 1), [11, 21]);
expect("a parameter with a default isn't given the index: it asked for one argument", map([10, 20], ($v, $i = 99) -> $i), [99, 99]);
expect("a builtin is never given the index: to_int's second argument is a default", map(["1", "2"], to_int), [1, 2]);
kind Point {
    fn _(pub #x, pub #y = 0);
}
kind NeedsTwo {
    fn _(pub #x, pub #y);
}
expect("a kind is called with the value alone: Point(x, 0) for each", map(map([1, 2], Point), $p -> [$p.x, $p.y]), [[1, 0], [2, 0]]);
try {
    map([1], NeedsTwo);
    expect("and one that needs two is an arity error, not given the index", "no error", "an error");
} catch (Error $e) {
    expect("and one that needs two is an arity error, not given the index", contains($e.message, "expects 2"), true);
}
try {
    filter([1], ($a, $b, $c) -> 1);
    expect("a function that needs three is still an arity error in filter", "no error", "an error");
} catch (Error $e) {
    expect("a function that needs three is still an arity error in filter", contains($e.message, "expects 3"), true);
}
