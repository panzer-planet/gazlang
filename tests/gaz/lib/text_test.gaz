include "std/test.gaz" use expect, throws;
include "std/text.gaz";

expect("lines split on newlines", text::lines("a\nb\nc"), ["a", "b", "c"]);
expect("a last line needs no end", text::lines("a\nb"), text::lines("a\nb\n"));
expect("a final newline leaves no empty line", text::lines("a\nb\n"), ["a", "b"]);
expect("an empty line at the end is kept", text::lines("a\n\n"), ["a", ""]);
expect("an empty line in the middle is kept", text::lines("a\n\nb"), ["a", "", "b"]);
expect("an empty line first is kept", text::lines("\na"), ["", "a"]);
expect("a lone newline is one empty line", text::lines("\n"), [""]);
expect("the empty string has no lines", text::lines(""), []);
expect("a line without a newline", text::lines("only"), ["only"]);
expect("\\r\\n ends a line as \\n does", text::lines("a\r\nb\r\n"), ["a", "b"]);
expect("a mix of both", text::lines("a\r\nb\nc"), ["a", "b", "c"]);
expect("a \\r inside a line stays", text::lines("a\rb\nc"), ["a\rb", "c"]);
expect("a \\r with no \\n after it stays, as read_line leaves it", text::lines("a\r"), ["a\r"]);
expect("only a line that ends is stripped of its \\r", text::lines("a\r\nb\r"), ["a", "b\r"]);
expect("a \\r\\n and nothing else is one empty line", text::lines("\r\n"), [""]);
expect("spaces are kept", text::lines("  a \n b"), ["  a ", " b"]);
expect("bytes past ASCII pass through", text::lines("é\nü\n"), ["é", "ü"]);
throws("a list is an error", () -> text::lines(["a"]), "text::lines() expects a string, got list");

expect("no indentation", text::indentation("a b"), 0);
expect("spaces count", text::indentation("   a"), 3);
expect("tabs count, mixed with spaces", text::indentation("\t \ta"), 3);
expect("other whitespace doesn't", text::indentation("\r a"), 0);
expect("a blank line is all indentation", text::indentation("  "), 2);
expect("the empty line has none", text::indentation(""), 0);
throws("indentation wants a string", () -> text::indentation(1), "text::indentation() expects \$line to be string, got int");
expect("unindented drops the spaces and tabs", text::unindented(" \t a b "), "a b ");
expect("unindented keeps a line without any", text::unindented("a"), "a");
expect("a blank line unindented is empty", text::unindented("  \t"), "");

expect("a string is quoted", text::quote("a b"), "\"a b\"");
expect("so a quote shows", text::quote("say \"hi\""), "\"say \\\"hi\\\"\"");
expect("and a NUL byte and a line break", text::quote("a\0b\n"), "\"a\\x00b\\n\"");
expect("an empty string is two quotes", text::quote(""), "\"\"");
expect("a number is as echo prints it", text::quote(1.5), "1.5");
expect("so is null", text::quote(null), "null");
expect("a list is a literal, strings inside quoted", text::quote(["a", 1]), "[\"a\", 1]");
