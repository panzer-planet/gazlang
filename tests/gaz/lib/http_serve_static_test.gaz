import "std/test.gaz" use expect;
import "std/http.gaz";

fn request($path) {
    return {"method" => "GET", "path" => $path, "query" => "", "headers" => {}, "body" => ""};
}

$serve = http::serve_static("tests/fixtures/static_site");

/* A file, and its Content-Type from the extension */
expect("an existing file", $serve(request("/style.css")), {
    "status" => 200, "headers" => {"Content-Type" => "text/css"}, "body" => "body { color: red; }\n",
});

/* / resolves to index.html */
expect("/ serves index.html", $serve(request("/")), {
    "status" => 200, "headers" => {"Content-Type" => "text/html; charset=utf-8"}, "body" => "<h1>home</h1>\n",
});

/* A directory, with or without its trailing slash, serves its own index.html */
expect("a directory without a slash", $serve(request("/sub"))["body"], "<p>sub</p>\n");
expect("a directory with a slash", $serve(request("/sub/"))["body"], "<p>sub</p>\n");

/* An extension not in the table is application/octet-stream */
expect("an unknown extension", $serve(request("/data.bin"))["headers"]["Content-Type"], "application/octet-stream");

/* A missing file is a 404, not an error */
expect("a missing file", $serve(request("/nope.txt")), {
    "status" => 404, "headers" => {"Content-Type" => "text/plain"}, "body" => "Not Found\n",
});

/* .. in a segment is refused, plainly or percent-encoded, the same as a missing file */
expect("literal .. is refused", $serve(request("/../style.css"))["status"], 404);
expect("percent-encoded .. is refused", $serve(request("/%2e%2e/style.css"))["status"], 404);
expect("a bad escape is a 404 too", $serve(request("/%zz"))["status"], 404);

/*
 * A %2F decodes to a / inside one segment, so ..%2f is a .. the segment check never sees; each of
 * these would reach tests/fixtures/read_me.txt, a file that exists outside the directory served
 */
expect("..%2f is refused", $serve(request("/..%2fread_me.txt"))["status"], 404);
expect("%2e%2e%2f is refused", $serve(request("/%2e%2e%2fread_me.txt"))["status"], 404);
expect("..%2f after a directory is refused", $serve(request("/sub/..%2f..%2fread_me.txt"))["status"], 404);
expect("a / inside one segment is refused", $serve(request("/sub%2f..%2f..%2fread_me.txt"))["status"], 404);
expect("%2F is never a separator, even for a file that is there", $serve(request("/sub%2findex.html"))["status"], 404);
