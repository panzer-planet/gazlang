include "std/test.gaz" use expect, throws;

kind Shape { kin #name = "shape"; }
kind Circle extends Shape { pub #r; fn _($r) { #name = "circle"; #r = $r; } }
kind Square extends Shape { pub #s; fn _($s) { #name = "square"; #s = $s; } }

$c = Circle(2);

// kind_of gives exactly the kind, where is_a tests the hierarchy: the two answer
// different questions, and a visitor wants the exact one
expect("the object's own kind", kind_of($c) == Circle, true);
expect("not a parent", kind_of($c) == Shape, false);
expect("is_a still follows the hierarchy", is_a($c, Shape), true);
expect("kinds are values, so == is identity", kind_of($c) == kind_of(Circle(9)), true);
expect("type_of of a kind", type_of(kind_of($c)), "kind");
expect("printed as a kind", to_string(kind_of($c)), "kind Circle");
expect("it is the kind, so it constructs", kind_of($c)(5).r, 5);
expect("and is_a accepts it", is_a($c, kind_of($c)), true);

// What it is for: dispatching a pass written outside the node kinds, which is how a
// compiler with more than one backend has to be written
kind Num { pub #v; fn _($v) { #v = $v; } }
kind Add { pub #l; pub #r; fn _($l, $r) { #l = $l; #r = $r; } }
kind Mul { pub #l; pub #r; fn _($l, $r) { #l = $l; #r = $r; } }
kind Neg { pub #e; fn _($e) { #e = $e; } }

fn eval($n) {
    return match (kind_of($n)) {
        Num => $n.v,
        Add => eval($n.l) + eval($n.r),
        Mul => eval($n.l) * eval($n.r),
        Neg => -eval($n.e),
        default => throw "cannot evaluate " .. to_string(kind_of($n)),
    };
}

fn show($n) {
    return match (kind_of($n)) {
        Num => to_string($n.v),
        Add => "(" .. show($n.l) .. " + " .. show($n.r) .. ")",
        Mul => "(" .. show($n.l) .. " * " .. show($n.r) .. ")",
        Neg => "-" .. show($n.e),
        default => "?",
    };
}

$tree = Add(Num(2), Mul(Num(3), Neg(Num(4))));
expect("a second pass over the same tree", show($tree), "(2 + (3 * -4))");
expect("evaluating it", eval($tree), -10);

// A node the pass doesn't know reaches the default arm, naming itself
kind Unknown {}
throws("an unhandled node", () -> eval(Unknown()), "cannot evaluate kind Unknown");

// A kind is a value like any other, so it keys nothing but compares by identity
expect("kinds in a list", in_array(Circle, [Square, Circle]), true);
expect("a kind that isn't there", in_array(Num, [Square, Circle]), false);

// kind_of is an accessor, so it is strict: there is no kind for an int
throws("kind_of of an int", () -> kind_of(1), "kind_of() expects object, got int");
throws("kind_of of null", () -> kind_of(null), "kind_of() expects object, got null");
throws("kind_of of a kind", () -> kind_of(Circle), "kind_of() expects object, got kind");
