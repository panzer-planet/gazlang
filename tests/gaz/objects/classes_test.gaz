include "../check.gaz";

// Constructing, fields and defaults
class Point {
    #x;
    #y = 0;
    #tags = [];
    fn _($x, $y = 0) { #x = $x; #y = $y; }
    fn moved($dx) { return Point(#x + $dx, #y); }
    fn tag($t) { #tags[] = $t; return #; }
}
$p = Point(1);
check("field set by the constructor", $p.x, 1);
check("default parameter", $p.y, 0);
check("methods can construct", $p.moved(2).x, 3);
check("defaults are per object", Point(0).tag("a").tags, ["a"]);
check("and not shared", Point(0).tags, []);
check("a class value constructs", (Point)(5).x, 5);
check("type_of an object", type_of($p), "object");
check("type_of a class", type_of(Point), "class");
check("a class prints its name", to_string(Point), "class Point");
check("an object prints its fields", to_string(Point(1, 2)), 'Point {#x => 1, #y => 2, #tags => []}');

// Handles and identity
$q = $p;
$q.x = 10;
check("objects are shared, not copied", $p.x, 10);
check("== is identity", $p == $q, true);
check("equal fields don't make equal objects", Point(1) == Point(1), false);
$list = [$p];
$copy = $list;
$copy[0].y = 7;
check("a list copy still holds the same object", $list[0].y, 7);

// Unset fields
class Lazy {
    #value;
    fn get() { return #value ??= "computed"; }
}
$lazy = Lazy();
check("an unset field reads as null under ??", $lazy.value ?? "unset", "unset");
check("??= sets it", $lazy.get(), "computed");
check("and keeps it", $lazy.value, "computed");
try {
    echo Lazy().value;
} catch ($e) {
    check("reading an unset field is an error", $e.message, "Property value of Lazy is not set");
}

// Inheritance
abstract class Animal {
    #name;
    #sound = "...";
    fn _($name) { #name = $name; }
    abstract fn kind();
    fn speak($times = 1) { return "{#name} the {#kind()} says " .. repeat(#sound .. " ", $times); }
    fn to_string() { return "{#kind()} {#name}"; }
}
class Dog extends Animal {
    #tricks = 0;
    fn _($name) { ##_($name); #sound = "woof"; }
    fn kind() { return "dog"; }
    fn speak($times = 1, $loud = false) {
        $said = ##speak($times);
        return $loud ? upper($said) : $said;
    }
}
class Puppy extends Dog {
    fn kind() { return "puppy"; }
}
$rex = Dog("Rex");
check("a child calls the parent's method", $rex.speak(2), "Rex the dog says woof woof ");
check("with its own argument", $rex.speak(1, true), "REX THE DOG SAYS WOOF ");
check("a grandchild inherits the constructor", Puppy("Bit").speak(), "Bit the puppy says woof ");
check("to_string is used by ..", "I have a " .. $rex, "I have a dog Rex");
check("and by interpolation", "{$rex}!", "dog Rex!");
check("is_a follows parents", [is_a($rex, Animal), is_a($rex, Dog), is_a($rex, Puppy)], [true, true, false]);

// Methods and closures as values
$speak = $rex.speak;
check("a bound method remembers its object", $speak(), "Rex the dog says woof ");
check("bound methods compare by object and method", $rex.speak == $speak, true);
check("and differ for another object", Dog("Rex").speak == $speak, false);
check("bound methods print their class", to_string($speak), "function Dog.speak");

class Tally {
    #count = 0;
    fn adder() { return $n -> #count += $n; }
}
$tally = Tally();
$add = $tally.adder();
$add(2);
$add(3);
check("a closure made in a method keeps its object", $tally.count, 5);
