import "std/test.gaz" use expect, throws;

/*
 * readonly at run time: a read-only field is written while its object is constructed (by the
 * constructor, a promoted parameter, a default, a parent's constructor through ##_, and through a
 * handle to the object from the kind's own code while the constructor runs) and refused by every
 * write path after that, from anywhere; a read-only kind's fields all are; a field that holds a
 * list or map can't be written inside either, while the object a field holds still can. The
 * checks when the program is read are the parser corpus's (tests/corpora/parser/error_readonly_*),
 * and the loader's the bytecode corpus's.
 */

kind Owner {
    fn _(pub #name) {}
}

kind Account {
    pub readonly #id;
    pub readonly list #tags = ["new"];
    pub readonly map #limits = {"daily" => 100};
    pub readonly #owner;
    pub readonly ?string #memo;
    pub #balance = 0;

    fn _(pub readonly int #number, $id) {
        #id = $id;
        #tags[] = "opened";
        #owner = Owner("werner");
        #fill(#);
    }

    // The kind's own code, writing through a handle while the constructor runs
    pub fn fill($account) {
        $account.limits["weekly"] = 500;
    }

    pub fn deposit($amount) {
        #balance += $amount;
    }
}

readonly kind Money {
    fn _(pub int #cents, pub string #currency) {}

    pub fn plus(Money $other): Money {
        return Money(#cents + $other.cents, #currency);
    }
}

readonly kind Change extends Money {
    pub #coins = [];

    fn _($cents) {
        ##_($cents, "ZAR");
        #coins[] = $cents;
    }
}

$account = Account(42, 7);
expect("the constructor, a promoted parameter and defaults set read-only fields", [$account.id, $account.number, $account.tags, $account.limits], [7, 42, ["new", "opened"], {"daily" => 100, "weekly" => 500}]);
expect("a field the kind never set is unset, as any field is", $account.memo ?? "unset", "unset");
$account.deposit(5);
expect("the kind's other fields are written as ever", $account.balance, 5);

$message = "Account #id is read-only: only Account's constructor sets it";
throws("assigning a read-only field", () -> ($account.id = 1), $message);
throws("a compound assignment", () -> ($account.id += 1), $message);
throws("++", () -> $account.id++, $message);
throws("--", () -> $account.id--, $message);
throws("..=", () -> ($account.id ..= "!"), $message);
throws("??= on one never set", () -> ($account.memo ??= "x"), "Account #memo is read-only: only Account's constructor sets it");
expect("??= on one that is set writes nothing, so nothing is refused", $account.id ??= 9, 7);
throws("appending to a list it holds", () -> ($account.tags[] = "x"), "Account #tags is read-only: only Account's constructor sets it");
throws("writing an element of the list", () -> ($account.tags[0] = "x"), "Account #tags is read-only: only Account's constructor sets it");
throws("writing a key of a map it holds", () -> ($account.limits["daily"] = 0), "Account #limits is read-only: only Account's constructor sets it");
throws("deleting under it", () -> { delete $account.tags[0]; }, "Account #tags is read-only: only Account's constructor sets it");
throws("the kind's own code, once construction is over", () -> $account.fill($account), "Account #limits is read-only: only Account's constructor sets it");
throws("a promoted parameter's field", () -> ($account.number = 1), "Account #number is read-only: only Account's constructor sets it");
expect("so nothing changed", [$account.id, $account.tags, $account.limits, $account.number], [7, ["new", "opened"], {"daily" => 100, "weekly" => 500}, 42]);

$account.owner.name = "ada";
expect("the object a read-only field holds is still a handle anyone can write", $account.owner.name, "ada");
throws("but the field itself can't be pointed elsewhere", () -> ($account.owner = Owner("x")), "Account #owner is read-only: only Account's constructor sets it");

$price = Money(1500, "ZAR");
expect("a read-only kind is constructed and its methods run", [$price.plus(Money(1, "ZAR")).cents, $price.currency], [1501, "ZAR"]);
throws("every field of a read-only kind is read-only", () -> ($price.cents = 0), "Money #cents is read-only: only Money's constructor sets it");
throws("the kind's own method after construction too", () -> ($price.currency ..= "!"), "Money #currency is read-only: only Money's constructor sets it");
$change = Change(5);
expect("a read-only child's constructor sets its own fields and the parent's through ##_", [$change.cents, $change.currency, $change.coins], [5, "ZAR", [5]]);
throws("and both are read-only afterwards", () -> ($change.cents = 1), "Money #cents is read-only: only Money's constructor sets it");
throws("the child's own field included", () -> ($change.coins[] = 1), "Change #coins is read-only: only Change's constructor sets it");
expect("a read-only kind is a kind like any other", [type_of(Money), is_a($change, Money), to_string($price)], ["kind", true, "Money \{#cents => 1500, #currency => \"ZAR\"}"]);

// A constructor that throws ends the object's construction too, even where the object escaped
kind Escaping {
    pub static #last = null;
    pub readonly #id;

    fn _($id) {
        Escaping::last = #;
        #id = $id;
        throw "stopped";
    }
}
try {
    Escaping(1);
} catch ($e) {
    expect("the error left the object where the constructor put it", Escaping::last.id, 1);
}
throws("and its read-only field is closed", () -> (Escaping::last.id = 2), "Escaping #id is read-only: only Escaping's constructor sets it");

// What readonly refuses when the program is read, for the shapes a test of the VM can't hold
fn refused($source) {
    $result = run([program_path(), "-e", $source]);
    return trim($result["stderr"]);
}
expect("a method writing a read-only field", refused("kind A \{ pub readonly #x; pub fn f() \{ #x = 1; } }"), "Error: A #x is read-only: only A's constructor sets it on line 1");
expect("a child's constructor writing a parent's", refused("kind A \{ pub readonly #x; }\nkind B extends A \{\n    fn _() \{ #x = 1; }\n}"), "Error: A #x is read-only: only A's constructor sets it on line 3");
expect("a mutable kind extending a read-only one", refused("readonly kind A \{}\nkind B extends A \{}"), "Error: Kind B must be read-only: it extends A, which is on line 2");
