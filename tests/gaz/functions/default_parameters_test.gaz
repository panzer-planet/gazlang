include "../check.gaz";

function greet($name, $greeting = "Hello", $end = "!") {
    return "$greeting, $name$end";
}
check("both defaults", greet("Gaz"), "Hello, Gaz!");
check("one default", greet("Gaz", "Hi"), "Hi, Gaz!");
check("no defaults", greet("Gaz", "Hi", "?"), "Hi, Gaz?");
check("passing null doesn't use the default", greet("Gaz", null), "null, Gaz!");

// Defaults are evaluated on every call that needs them, so they are never shared
function add_to($item, $list = []) {
    $list[] = $item;
    return $list;
}
check("fresh default array", add_to(1), [1]);
check("still fresh on the next call", add_to(2), [2]);

// A default can use earlier parameters and globals, and call functions
function area($width, $height = $width) {
    return $width * $height;
}
check("default from an earlier parameter", area(3), 9);
check("given explicitly", area(3, 4), 12);

@next_id = 0;
function new_id() {
    @next_id++;
    return @next_id;
}
function make_item($name, $id = new_id()) {
    return ["id" => $id, "name" => $name];
}
check("default calls a function", make_item("a"), ["id" => 1, "name" => "a"]);
check("given explicitly, the default isn't evaluated", make_item("b", 99), ["id" => 99, "name" => "b"]);
check("evaluated again on the next call", make_item("c"), ["id" => 2, "name" => "c"]);

// Defaults run inside the function: its locals, not the caller's
$outside = "caller's";
function scoped($value = $outside) {
    return $value;
}
try {
    scoped();
} catch ($e) {
    check("default doesn't see the caller's variables", $e["message"], "Undefined variable: \$outside");
}
check("given explicitly, the default isn't evaluated either", scoped("fine"), "fine");

// A failing default is a normal, catchable error
function strict($n = 1 / 0) {
    return $n;
}
try {
    strict();
} catch ($e) {
    check("error in a default", $e["message"], "Division by zero");
}
check("not evaluated when the argument is given", strict(5), 5);

// Recursion with a default accumulator
function sum_to($n, $total = 0) {
    if ($n === 0) {
        return $total;
    }
    return sum_to($n - 1, $total + $n);
}
check("recursion with a default", sum_to(4), 10);

// slice's length is optional too: to the end
check("slice to the end", slice("hello", 2), "llo");
check("slice negative start to the end", slice([1, 2, 3], -2), [2, 3]);
check("slice with a length", slice("hello", 1, 2), "el");
