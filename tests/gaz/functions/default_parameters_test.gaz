import "std/test.gaz" use expect, throws;

fn greet($name, $greeting = "Hello", $end = "!") {
    return "$greeting, $name$end";
}
expect("both defaults", greet("Gaz"), "Hello, Gaz!");
expect("one default", greet("Gaz", "Hi"), "Hi, Gaz!");
expect("no defaults", greet("Gaz", "Hi", "?"), "Hi, Gaz?");
expect("passing null doesn't use the default", greet("Gaz", null), "null, Gaz!");

// Defaults are evaluated on every call that needs them, so they are never shared
fn add_to($item, $list = []) {
    $list[] = $item;
    return $list;
}
expect("fresh default array", add_to(1), [1]);
expect("still fresh on the next call", add_to(2), [2]);

// A default can use earlier parameters and globals, and call functions
fn area($width, $height = $width) {
    return $width * $height;
}
expect("default from an earlier parameter", area(3), 9);
expect("given explicitly", area(3, 4), 12);

@next_id = 0;
fn new_id() {
    @next_id++;
    return @next_id;
}
fn make_item($name, $id = new_id()) {
    return {"id" => $id, "name" => $name};
}
expect("default calls a function", make_item("a"), {"id" => 1, "name" => "a"});
expect("given explicitly, the default isn't evaluated", make_item("b", 99), {"id" => 99, "name" => "b"});
expect("evaluated again on the next call", make_item("c"), {"id" => 2, "name" => "c"});

// Defaults run inside the function: its locals, not the caller's
$outside = "caller's";
fn scoped($value = $outside) {
    return $value;
}
throws("default doesn't see the caller's variables", () -> scoped(), "Undefined variable: \$outside");
expect("given explicitly, the default isn't evaluated either", scoped("fine"), "fine");

// A failing default is a normal, catchable error
fn strict($n = 1 / 0) {
    return $n;
}
throws("error in a default", () -> strict(), "Division by zero");
expect("not evaluated when the argument is given", strict(5), 5);

// Recursion with a default accumulator
fn sum_to($n, $total = 0) {
    if ($n == 0) {
        return $total;
    }
    return sum_to($n - 1, $total + $n);
}
expect("recursion with a default", sum_to(4), 10);

// slice's length is optional too: to the end
expect("slice to the end", slice("hello", 2), "llo");
expect("slice negative start to the end", slice([1, 2, 3], -2), [2, 3]);
expect("slice with a length", slice("hello", 1, 2), "el");
