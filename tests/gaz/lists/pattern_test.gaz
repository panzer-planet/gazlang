include "../check.gaz";

// An empty slot in a pattern takes an element and does nothing with it
[, $b] = [1, 2];
check("an empty first slot", $b, 2);
[$a, , $c] = [1, 2, 3];
check("an empty middle slot", [$a, $c], [1, 3]);
[$a, $b, ,] = [7, 8, 9];
check("an empty last slot", [$a, $b], [7, 8]);
[, , $z] = ["p", "q", "r"];
check("several", $z, "r");

// The count still has to match: the slot is an element
try {
    [, $w] = [1, 2, 3];
    check("an empty slot counts as an element", "no error", "an error");
} catch (Error $e) {
    check("an empty slot counts as an element", contains($e.message, "Cannot destructure a list of 3 elements into 2"), true);
}
try {
    [$x, , $y] = [1, 2];
    check("too few is the same error", "no error", "an error");
} catch (Error $e) {
    check("too few is the same error", contains($e.message, "into 3"), true);
}

// Nothing is assigned to a slot, so a variable of that position is left as it was
$kept = "before";
[$kept, , $other] = ["after", 1, 2];
check("targets either side are assigned", [$kept, $other], ["after", 2]);

// In foreach
$sum = 0;
foreach ([[1, 10], [2, 20]] as [, $second]) {
    $sum += $second;
}
check("foreach with an empty slot", $sum, 30);
$keys = [];
foreach ({"a" => [1, 2, 3]} as $key => [, $mid, ,]) {
    $keys[] = [$key, $mid];
}
check("with a key and a trailing slot", $keys, [["a", 2]]);

// In parameters
fn tail([, $y]) { return $y; }
check("a function parameter", tail([1, 2]), 2);
$lambda = ([, $m]) -> $m;
check("a lambda parameter in parentheses", $lambda([5, 6]), 6);
kind Holder {
    #value;
    fn _([, $v]) { #value = $v; }
    pub fn get() { return #value; }
}
check("a constructor parameter", Holder([1, 2]).get(), 2);

// A list pattern as a lambda's parameter needs no parentheses
$add = [$a, $b] -> $a + $b;
check("a bare list pattern lambda", $add([3, 4]), 7);
check("in map", map([[1, 2], [3, 4]], [$a, $b] -> $a * $b), [2, 12]);
check("with an empty slot", map([[1, 2], [3, 4]], [, $b] -> $b), [2, 4]);
check("with a block body", map([[1, 2]], [$a, $b] -> { return $a - $b; }), [-1]);
check("nested lambdas", (([$a, $b] -> [$c, $d] -> $a + $b + $c + $d)([1, 2]))([3, 4]), 10);
$captured = 100;
check("it captures what a lambda does", (([$a] -> $a + $captured))([1]), 101);
check("wrong size is the destructuring error", (() -> { try { ([$a, $b] -> $a)([1]); return "no error"; } catch (Error $e) { return $e.message; } })() != "no error", true);
