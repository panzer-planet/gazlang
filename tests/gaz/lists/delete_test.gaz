include "../check.gaz";

// A list's later elements move down, so its indexes stay 0 to len - 1
$list = [1, 2, 3];
delete $list[1];
check("a list closes the gap", $list, [1, 3]);
check("the list is shorter", len($list), 2);

delete $list[1];
check("the last element goes", $list, [1]);

// A map keeps the order of what is left
$map = {"a" => 1, "b" => 2, "c" => 3};
delete $map["b"];
check("a map keeps its order", $map, {"a" => 1, "c" => 3});
check("the keys are left", join(keys($map), ","), "a,c");
check("the key is gone", has_key($map, "b"), false);

// Lists and maps are values, so a copy is untouched
$original = {"a" => 1, "b" => 2};
$copy = $original;
delete $copy["a"];
check("the copy changed", has_key($copy, "a"), false);
check("the original did not", has_key($original, "a"), true);

// Any path an assignment can write, ending at an element
$nested = {"rows" => [[1, 2], [3, 4]]};
delete $nested["rows"][0][1];
check("through a path", $nested, {"rows" => [[1], [3, 4]]});

@global = [1, 2];
delete @global[0];
check("a global", @global, [2]);

fn scope_out($scopes, $name) {
    delete $scopes[len($scopes) - 1][$name];

    return $scopes;
}
check("what it is for", scope_out([{"x" => 1, "y" => 2}], "x"), [{"y" => 2}]);

// A closure's captured variable
fn counter() {
    $seen = {"a" => 1, "b" => 2};

    return $key -> { delete $seen[$key]; return $seen; };
}
$forget = counter();
$forget("a");
check("a captured variable", $forget("b"), {});

kind Cart {
    #items = ["apple", "pear"];
    fn drop($index) { delete #items[$index]; }
    fn contents() { return #items; }
}
$cart = Cart();
$cart.drop(0);
check("a field of an object", $cart.contents(), ["pear"]);

$rows = [{"total" => 1}];
delete $rows[0]["total"];
check("a map inside a list", $rows, [{}]);

// Removing what isn't there is an error, as reading it is
try {
    $gone = {"a" => 1};
    delete $gone["b"];
    echo "FAIL a missing key should fail";
} catch (Error $e) {
    check("a missing key", $e.message, "Undefined key: \"b\"");
}

try {
    $short = [1];
    delete $short[5];
    echo "FAIL an index out of range should fail";
} catch (Error $e) {
    check("an index out of range", $e.message, "Index out of range: 5");
}

try {
    $text = "abc";
    delete $text[0];
    echo "FAIL deleting from a string should fail";
} catch (Error $e) {
    check("a string", $e.message, "Cannot use [] on string");
}

try {
    delete $never[0];
    echo "FAIL an undefined variable should fail";
} catch (Error $e) {
    check("an undefined variable", $e.message, "Undefined variable: \$never");
}
