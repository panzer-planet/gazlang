include "std/test.gaz" use expect, throws;

// A list's later elements move down, so its indexes stay 0 to len - 1
$list = [1, 2, 3];
delete $list[1];
expect("a list closes the gap", $list, [1, 3]);
expect("the list is shorter", len($list), 2);

delete $list[1];
expect("the last element goes", $list, [1]);

// A map keeps the order of what is left
$map = {"a" => 1, "b" => 2, "c" => 3};
delete $map["b"];
expect("a map keeps its order", $map, {"a" => 1, "c" => 3});
expect("the keys are left", join(keys($map), ","), "a,c");
expect("the key is gone", has_key($map, "b"), false);

// Lists and maps are values, so a copy is untouched
$original = {"a" => 1, "b" => 2};
$copy = $original;
delete $copy["a"];
expect("the copy changed", has_key($copy, "a"), false);
expect("the original did not", has_key($original, "a"), true);

// Any path an assignment can write, ending at an element
$nested = {"rows" => [[1, 2], [3, 4]]};
delete $nested["rows"][0][1];
expect("through a path", $nested, {"rows" => [[1], [3, 4]]});

@global = [1, 2];
delete @global[0];
expect("a global", @global, [2]);

fn scope_out($scopes, $name) {
    delete $scopes[len($scopes) - 1][$name];

    return $scopes;
}
expect("what it is for", scope_out([{"x" => 1, "y" => 2}], "x"), [{"y" => 2}]);

// A closure's captured variable
fn counter() {
    $seen = {"a" => 1, "b" => 2};

    return $key -> { delete $seen[$key]; return $seen; };
}
$forget = counter();
$forget("a");
expect("a captured variable", $forget("b"), {});

kind Cart {
    #items = ["apple", "pear"];
    pub fn drop($index) { delete #items[$index]; }
    pub fn contents() { return #items; }
}
$cart = Cart();
$cart.drop(0);
expect("a field of an object", $cart.contents(), ["pear"]);

$rows = [{"total" => 1}];
delete $rows[0]["total"];
expect("a map inside a list", $rows, [{}]);

// Removing what isn't there is an error, as reading it is
throws("a missing key", () -> {
    $gone = {"a" => 1};
    delete $gone["b"];
}, "Undefined key: \"b\"");

throws("an index out of range", () -> {
    $short = [1];
    delete $short[5];
}, "Index out of range: 5");

throws("a string", () -> {
    $text = "abc";
    delete $text[0];
}, "Cannot use [] on string");

// Written out rather than as a thunk: in a lambda $never would be a capture, another instruction
try {
    delete $never[0];
    echo "FAIL an undefined variable should fail";
} catch (Error $e) {
    expect("an undefined variable", $e.message, "Undefined variable: \$never");
}
