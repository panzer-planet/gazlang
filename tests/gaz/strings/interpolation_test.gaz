import "std/test.gaz" use expect;

$name = "Gaz";
$name_2 = "two";
$items = ["first", "second"];
$i = 1;
$keys = {"01" => "string 01", "-0" => "string -0", 1 => "int 1", -1 => "int -1"};
$user = {"name" => "Werner", "tags" => ["admin"]};
@count = 41;

// Shorthand: $name, greedy over letters, digits and underscores
expect("bare variable", "Hi $name!", "Hi Gaz!");
expect("bare variable at the start and end", "$name", "Gaz");
expect("bare variable is greedy", "$name_2", "two");

// Shorthand takes one PHP-style index: [int], [-int], [unquoted key] or [$variable]
expect("shorthand int index", "got $items[1]!", "got second!");
expect("shorthand negative index", "$keys[-1]", "int -1");
expect("shorthand unquoted key", "$user[name]", "Werner");
expect("shorthand variable index", "$items[$i]", "second");
expect("shorthand reads only one index", "$items[0][1]", "first[1]");
expect("shorthand non-canonical digits are a string key", "$keys[01] $keys[-0] $keys[1]", "string 01 string -0 int 1");

// Braces: any expression starting with $ or @
expect("braces", "Hi {$name}!", "Hi Gaz!");
expect("braces around a longer name", "{$name}_2", "Gaz_2");
expect("index", "{$items[1]}", "second");
expect("nested keys with quotes inside", "{$user["tags"][0]}", "admin");
expect("global", "{@count} calls", "41 calls");
expect("expression", "{@count + 1}", "42");
expect("function call after the sigil", "{$items[len($items) - 1]}", "second");
expect("several in a row", "$name{$name}$name", "GazGazGaz");
expect("map literal inside interpolation", "{$user["missing"] ?? {}}", "{}");
expect("nested braces inside interpolation", "{$keys[1] ?? {1 => {}}} {@count ?? (() -> { return 0; })()}", "int 1 41");
expect("interpolated string inside interpolation", "{$user["na{$name}"] ?? "none"}", "none");

// Values convert like echo and +
expect("ints convert", "n={@count}", "n=41");
expect("null, lists and maps", "{$user["missing"] ?? null} {$user["tags"]} {$keys}", "null [\"admin\"] {\"01\" => \"string 01\", \"-0\" => \"string -0\", 1 => \"int 1\", -1 => \"int -1\"}");

// Not interpolation
expect("dollar before a digit", "costs $5", "costs " .. "$" .. "5");
expect("lone dollar", "$", "\$");
expect("email address", "me@example.com", "me" .. "@" .. "example.com");
expect("brace before a space", "{ $name}", "{ Gaz}");
expect("brace alone", "{}", "{" .. "}");
expect("escaped dollar", "\$name", "$" .. "name");
expect("escaped brace", "\{$name}", "\{Gaz}");
expect("escaped both", "\{\$name}", "{" .. "$" .. "name}");
expect("single quotes stay raw", '$name {$name}', "\$name \{\$name}");
