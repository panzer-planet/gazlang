include "std/test.gaz" use expect;
include "std/json.gaz";

// The caught error is an Error object with #message, #file and #line
try {
    $x = 1 / 0;
} catch ($e) {
    expect("message", $e.message, "Division by zero");
    expect("file", $e.file, "tests/gaz/errors/try_catch_test.gaz");
    expect("line", $e.line, 6);
}

fn fail_with($message) {
    throw $message;
}

try {
    fail_with("custom problem");
} catch ($e) {
    expect("throw's message is exact", $e.message, "custom problem");
    expect("throw's line is where it was written", $e.line, 14);
}

// Every kind of runtime error can be caught (running out of call depth too, tested in TryCatchTest,
// since recursing that deep in-process can segfault while pcov is loaded)
fn caught_message($code) {
    try {
        if ($code == "undefined") { return $missing; }
        if ($code == "type") { return "a" * 2; }
        if ($code == "key") { $a = {}; $a["x"]["y"] = 1; }
        if ($code == "builtin") { return lower(5); }
        if ($code == "file") { return read_file("tests/gaz/errors/no_such_file"); }
        if ($code == "json") { return json::decode("[1,"); }
    } catch ($e) {
        return $e.message;
    }
    return "nothing thrown";
}
expect("undefined variable", caught_message("undefined"), "Undefined variable: \$missing");
expect("type error", caught_message("type"), "Cannot use * on string");
expect("missing key", caught_message("key"), "Undefined key: \"x\"");
expect("builtin argument", caught_message("builtin"), "lower() expects string, got int");
expect("file error", caught_message("file"), "Cannot read file: tests/gaz/errors/no_such_file");
expect("invalid JSON", caught_message("json"), "Invalid JSON: unexpected end of input at position 3");
expect("no error", caught_message("none"), "nothing thrown");

// Execution continues after the catch block; nothing after the error in the try runs
$steps = [];
try {
    $steps[] = "before";
    throw "stop";
    $steps[] = "after";
} catch ($e) {
    $steps[] = "caught";
}
$steps[] = "continued";
expect("control flow", $steps, ["before", "caught", "continued"]);

// A failed update changes nothing
$item = {"count" => "not a number"};
try {
    $item["count"]++;
} catch ($e) {
}
expect("failed ++ leaves the value", $item, {"count" => "not a number"});
$totals = [];
try {
    $totals["missing"] += 1;
} catch ($e) {
}
expect("failed += creates no key", $totals, []);

// Nesting and rethrowing
try {
    try {
        throw "inner";
    } catch ($e) {
        throw "rethrown: " .. $e.message;
    }
} catch ($outer) {
    expect("rethrow reaches the outer catch", $outer.message, "rethrown: inner");
}

// return, break and continue are not errors: they pass through try
fn first_positive($numbers) {
    foreach ($numbers as $n) {
        try {
            if ($n > 0) {
                return $n;
            }
        } catch ($e) {
            return null;
        }
    }
    return null;
}
expect("return from inside try", first_positive([-1, 0, 7, 8]), 7);

$seen = [];
foreach ([1, 2, 3, 4] as $n) {
    try {
        if ($n == 2) {
            continue;
        }
        if ($n == 4) {
            break;
        }
        $seen[] = $n;
    } catch ($e) {
    }
}
expect("continue and break inside try", $seen, [1, 3]);

// Errors keep unwinding through functions until a try catches them
fn level_three() { throw "from level three"; }
fn level_two() { level_three(); return "unreachable"; }
fn level_one() {
    try {
        return level_two();
    } catch ($e) {
        return "level one caught: " .. $e.message;
    }
}
expect("unwinds through calls", level_one(), "level one caught: from level three");

// Globals work as the catch variable
try {
    throw "global";
} catch (@last_error) {
}
expect("global catch variable", @last_error.message, "global");

// Handling bad input without stopping: the reason json_decode needed try/catch
fn parse_config($text) {
    try {
        return {"ok" => true, "config" => json::decode($text)};
    } catch ($e) {
        return {"ok" => false, "reason" => $e.message};
    }
}
expect("valid config", parse_config("{\"debug\": true}"), {"ok" => true, "config" => {"debug" => true}});
expect("invalid config", parse_config("{debug}")["ok"], false);

// Error objects and typed catch clauses
kind NotFound extends Error {
    pub #key;
    fn _($key) { ##_("Not found: {$key}"); #key = $key; }
}
kind MissingFile extends NotFound {}

fn caught_by($value) {
    try {
        throw $value;
    } catch (MissingFile $e) {
        return "MissingFile";
    } catch (NotFound $e) {
        return "NotFound";
    } catch (Error $e) {
        return "Error";
    } catch ($e) {
        return "anything";
    }
}
expect("a child kind matches its own clause first", caught_by(MissingFile("f")), "MissingFile");
expect("a kind matches its clause", caught_by(NotFound("k")), "NotFound");
expect("a string error is an Error", caught_by("text"), "Error");
expect("an Error made directly", caught_by(Error("plain")), "Error");
expect("any other value", caught_by(42), "anything");

try {
    throw NotFound("k");
} catch (NotFound $e) {
    expect("an error object's message", $e.message, "Not found: k");
    expect("its own fields", $e.key, "k");
    expect("where it was thrown", $e.line, 171);
    expect("it prints as its message", "{$e}", "Not found: k");
}

try {
    throw [1, 2];
} catch ($e) {
    expect("a thrown list is caught as it is", $e, [1, 2]);
}

// An error no clause matches carries on, running finally on the way
$log = [];
try {
    try {
        $log[] = "try";
        throw "plain";
    } catch (NotFound $e) {
        $log[] = "not run";
    } finally {
        $log[] = "finally";
    }
} catch (Error $e) {
    $log[] = "outer caught {$e.message}";
}
expect("unmatched errors carry on through finally", $log, ["try", "finally", "outer caught plain"]);
