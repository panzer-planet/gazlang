include "../check.gaz";

fn inner($n) { return 1 / $n; }
fn outer($n) { return inner($n); }

try {
    outer(0);
} catch (Error $e) {
    check("the innermost call first", $e.trace[0], "inner at tests/gaz/errors/trace_test.gaz:3");
    check("its caller next", $e.trace[1], "outer at tests/gaz/errors/trace_test.gaz:4");
    check("the top level last", $e.trace[2], "top level at tests/gaz/errors/trace_test.gaz:7");
    check("nothing else", len($e.trace), 3);
}

// error() is traced where it was thrown, and a rethrow keeps that trace
fn fails() { error("no good"); }
try {
    try {
        fails();
    } catch (Error $first) {
        error($first);
    }
} catch (Error $again) {
    check("error() is traced", $again.trace[0], "fails at tests/gaz/errors/trace_test.gaz:16");
    check("a rethrow keeps where it was first thrown", $again.trace[1], "top level at tests/gaz/errors/trace_test.gaz:19");
}

kind Account {
    pub #balance;
    fn _($balance) { #balance = $balance; }
    pub fn share($people) { return #balance / $people; }
}

try {
    Account(100).share(0);
} catch (Error $e) {
    check("a method", $e.trace[0], "Account.share at tests/gaz/errors/trace_test.gaz:31");
    check("its caller", $e.trace[1], "top level at tests/gaz/errors/trace_test.gaz:35");
}

try {
    Account("x");
} catch (Error $e) {
    check("a constructor", $e.trace[0], "Account._ at tests/gaz/errors/trace_test.gaz:30");
    check("the object being made", $e.trace[1], "new Account at tests/gaz/errors/trace_test.gaz:28");
}

$divide = $n -> 1 / $n;
try {
    $divide(0);
} catch (Error $e) {
    check("a lambda is ->", $e.trace[0], "-> at tests/gaz/errors/trace_test.gaz:48");
}

// A method run from inside an expression, as printing runs to_string(), is called from where
// the expression is running
kind Broken {
    #n = 0;
    pub fn to_string() { return "n is " .. (1 / #n); }
}
fn show($thing) { echo $thing; }
try {
    show(Broken());
} catch (Error $e) {
    check("printing calls to_string", $e.trace, [
        "Broken.to_string at tests/gaz/errors/trace_test.gaz:59",
        "show at tests/gaz/errors/trace_test.gaz:61",
        "top level at tests/gaz/errors/trace_test.gaz:63",
    ]);
}

// The trace is whole when the error is raised, not as it leaves: caught inside to_string()
kind Careful {
    pub fn to_string() {
        try {
            error("inner");
        } catch (Error $e) {
            return join($e.trace, "; ");
        }
    }
}
fn label($thing) {
    return "label: "
        .. $thing;
}
check("caught inside to_string", label(Careful()), "label: Careful.to_string at tests/gaz/errors/trace_test.gaz:76; "
    .. "label at tests/gaz/errors/trace_test.gaz:84; top level at tests/gaz/errors/trace_test.gaz:86");

// Every instruction that can run to_string() says where it is running
kind Fails {
    pub fn to_string() { return error("fails"); }
}
fn called_from($f) {
    try {
        $f();
    } catch (Error $e) {
        return $e.trace[1];
    }
}
$fails = Fails();
@text = "";
$captured = "";
$sites = [
    ["echo", () -> { echo Fails(); }],
    ["..", () -> "x" .. Fails()],
    ["interpolation", () -> "x{$fails}"],
    ["..= on a local", () -> { $s = ""; $s ..= Fails(); }],
    ["..= on a global", () -> { @text ..= Fails(); }],
    ["..= on a captured variable", () -> { $captured ..= Fails(); }],
    ["to_string()", () -> to_string(Fails())],
    ["join()", () -> join([Fails()], ",")],
    ["print()", () -> print(Fails())],
    ["a builtin as a value", () -> { $convert = to_string; return $convert(Fails()); }],
];
foreach ($sites as [$site, $f]) {
    check("{$site} calls to_string", called_from($f), "-> at tests/gaz/errors/trace_test.gaz:" .. {"echo" => 104, ".." => 105, "interpolation" => 106, "..= on a local" => 107, "..= on a global" => 108, "..= on a captured variable" => 109, "to_string()" => 110, "join()" => 111, "print()" => 112, "a builtin as a value" => 113}[$site]);
}

// A second call from the same instruction is still called from it, though the first ran
// instructions of its own
kind Shouts {
    pub fn to_string() { return upper("a"); }
}
$after_another = [
    ["join()", () -> join([Shouts(), Fails()], ",")],
    ["map()", () -> map([1, 0],
        $x -> upper("a") .. 1 / $x)],
];
foreach ($after_another as [$site, $f]) {
    check("{$site} calls again from the same place", called_from($f), "-> at tests/gaz/errors/trace_test.gaz:" .. {"join()" => 125, "map()" => 126}[$site]);
}

// A builtin's callback is called from where the builtin runs, which isn't itself in the trace
try {
    map([0], $x -> 1 / $x);
} catch (Error $e) {
    check("a callback's trace", $e.trace, [
        "-> at tests/gaz/errors/trace_test.gaz:135",
        "top level at tests/gaz/errors/trace_test.gaz:135",
    ]);
}
$callers = [
    ["map()", () -> map([0], $x -> 1 / $x)],
    ["filter()", () -> filter([0], $x -> 1 / $x)],
    ["reduce()", () -> reduce([0], ($c, $x) -> 1 / $x, 0)],
    ["sort()", () -> sort([0, 1], ($a, $b) -> 1 / 0)],
    ["map() as a value", () -> { $apply = map; return $apply([0], $x -> 1 / $x); }],
];
foreach ($callers as [$builtin, $f]) {
    check("{$builtin} calls back", called_from($f), "-> at tests/gaz/errors/trace_test.gaz:" .. {"map()" => 143, "filter()" => 144, "reduce()" => 145, "sort()" => 146, "map() as a value" => 147}[$builtin]);
}

// The cap on a deep trace is tested through the CLI (FunctionTest): 10000 calls in process
// would segfault PHP under pcov, long before GazLang's own call depth limit
