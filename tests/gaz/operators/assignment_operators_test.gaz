include "../check.gaz";

// Compound assignment applies the operator and assigns the result
$n = 10;
$n += 5;
check("+=", $n, 15);
$n -= 3;
check("-=", $n, 12);
$n *= 2;
check("*=", $n, 24);
$n /= 4;
check("/= gives a float", $n, 6.0);
$n /= 4;
check("/= again", $n, 1.5);
$m = 17;
$m %= 5;
check("%=", $m, 2);

$s = "Hello";
$s ..= ", ";
$s ..= "world " .. 1;
check("..= concatenates, converting like ..", $s, "Hello, world 1");

// The assignment is an expression with the new value, and is right associative
$a = 2;
$b = 3;
check("value of a compound assignment", $a += 1, 3);
$a += $b *= 2;
check("right associative", [$a, $b], [9, 6]);
$k = 3;
check("the target is read after the right side runs", $k += $k *= 2, 12);

// ++ and --
$i = 5;
check("postfix ++ gives the old value", $i++, 5);
check("and increments", $i, 6);
check("prefix ++ gives the new value", ++$i, 7);
check("postfix --", $i--, 7);
check("prefix --", --$i, 5);
$f = 1.5;
$f++;
check("++ on a float", $f, 2.5);

// Array elements, nested elements and globals
$totals = {"apples" => 1, "counts" => [10, 20]};
$totals["apples"] += 4;
$totals["counts"][1]++;
++$totals["counts"][0];
$totals["counts"][0] *= 2;
check("elements", $totals, {"apples" => 5, "counts" => [22, 21]});

@calls = 0;
function count_call() {
    @calls++;
    return @calls;
}
count_call();
count_call();
check("global ++ inside a function", @calls, 2);

// Index keys are evaluated once
@key_calls = 0;
function next_key() {
    @key_calls += 1;
    return "apples";
}
$totals[next_key()] += 10;
$totals[next_key()]++;
check("keys evaluated once per update", [@key_calls, $totals["apples"]], [2, 16]);

// Loops
$sum = 0;
for ($j = 0; $j < 5; $j++) {
    $sum += $j;
}
check("for with ++ and +=", $sum, 10);

$countdown = [];
$c = 3;
while ($c-- > 0) {
    $countdown[] = $c;
}
check("postfix -- in a condition", $countdown, [2, 1, 0]);
