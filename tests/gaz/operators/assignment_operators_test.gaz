import "std/test.gaz" use expect, throws;

// Compound assignment applies the operator and assigns the result
$n = 10;
$n += 5;
expect("+=", $n, 15);
$n -= 3;
expect("-=", $n, 12);
$n *= 2;
expect("*=", $n, 24);
$n /= 4;
expect("/= gives a float", $n, 6.0);
$n /= 4;
expect("/= again", $n, 1.5);
$m = 17;
$m %= 5;
expect("%=", $m, 2);

$s = "Hello";
$s ..= ", ";
$s ..= "world " .. 1;
expect("..= concatenates, converting like ..", $s, "Hello, world 1");

// ..= appends in place on a plain variable, so every other way of reaching a string must
// still behave identically: its value is the new string, a non-string converts like .. does,
// and an undefined variable is an error rather than an empty string
expect("the value of ..= is the new string", $s ..= "!", "Hello, world 1!");
$t = 1;
$t ..= 2;
expect("..= on a non-string converts", $t, "12");
$u = "n";
$u ..= [1, 2];
expect("..= converts the right side like echo", $u, "n[1, 2]");
// Whatever is appended, a string target appends in place: .. is toString on both sides, so
// converting the right one and appending that is the same operation, and stays linear
$v = "";
$v ..= 1;
$v ..= 2.5;
$v ..= true;
$v ..= null;
$v ..= {"k" => 1};
expect("..= appends any value to a string", $v, "12.5truenull{\"k\" => 1}");
kind Loud { pub fn to_string() { return "L"; } }
$w = "x";
$w ..= Loud();
expect("..= runs to_string on an object", $w, "xL");
kind Angry { pub fn to_string() { throw "nope"; } }
$z = "keep";
try {
    $z ..= Angry();
    expect("unreachable", 1, 2);
} catch (Error $e) {
    expect("nothing is appended when converting fails", $z, "keep");
}
// Written out rather than as a thunk: in a lambda $missing would be a capture, another instruction
try {
    $missing ..= "x";
    expect("unreachable", 1, 2);
} catch (Error $e) {
    expect("..= needs the variable", $e.message, 'Undefined variable: $missing');
}
@global_buffer = "g";
@global_buffer ..= "h";
expect("..= on a global", @global_buffer, "gh");
$row = {"k" => "a"};
$row["k"] ..= "b";
expect("..= through a map key", $row, {"k" => "ab"});
$list = ["a"];
$list[0] ..= "b";
expect("..= through a list index", $list, ["ab"]);
fn make_appender() { $buffer = ""; return $c -> { $buffer ..= $c; return $buffer; }; }
$append = make_appender();
$append("1");
expect("..= on a captured variable persists between calls", $append("2"), "12");
expect("a second closure has its own", make_appender()("9"), "9");
kind Buffer { #text = ""; pub fn add($c) { #text ..= $c; return #text; } }
$buffer = Buffer();
$buffer.add("a");
expect("..= on a field", $buffer.add("b"), "ab");
// A copy taken before the append must not see it: strings are values, appending in place
// is only safe while nothing else holds the string
$before = "one";
$copy = $before;
$before ..= " two";
expect("a copy taken first is unchanged", $copy, "one");

// The assignment is an expression with the new value, and is right associative
$a = 2;
$b = 3;
expect("value of a compound assignment", $a += 1, 3);
$a += $b *= 2;
expect("right associative", [$a, $b], [9, 6]);
$k = 3;
expect("the target is read after the right side runs", $k += $k *= 2, 12);

// ++ and --
$i = 5;
expect("postfix ++ gives the old value", $i++, 5);
expect("and increments", $i, 6);
expect("prefix ++ gives the new value", ++$i, 7);
expect("postfix --", $i--, 7);
expect("prefix --", --$i, 5);
$f = 1.5;
$f++;
expect("++ on a float", $f, 2.5);

// Array elements, nested elements and globals
$totals = {"apples" => 1, "counts" => [10, 20]};
$totals["apples"] += 4;
$totals["counts"][1]++;
++$totals["counts"][0];
$totals["counts"][0] *= 2;
expect("elements", $totals, {"apples" => 5, "counts" => [22, 21]});

@calls = 0;
fn count_call() {
    @calls++;
    return @calls;
}
count_call();
count_call();
expect("global ++ inside a function", @calls, 2);

// Index keys are evaluated once
@key_calls = 0;
fn next_key() {
    @key_calls += 1;
    return "apples";
}
$totals[next_key()] += 10;
$totals[next_key()]++;
expect("keys evaluated once per update", [@key_calls, $totals["apples"]], [2, 16]);

// Loops
$sum = 0;
for ($j = 0; $j < 5; $j++) {
    $sum += $j;
}
expect("for with ++ and +=", $sum, 10);

$countdown = [];
$c = 3;
while ($c-- > 0) {
    $countdown[] = $c;
}
expect("postfix -- in a condition", $countdown, [2, 1, 0]);
