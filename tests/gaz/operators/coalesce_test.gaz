import "std/test.gaz" use expect, throws;

$values = {"null" => null, "zero" => 0, "false" => false, "empty" => "", "list" => [10, 20]};

// Only null or missing falls through to the right side
expect("null", $values["null"] ?? "default", "default");
expect("zero is kept", $values["zero"] ?? "default", 0);
expect("false is kept", $values["false"] ?? "default", false);
expect("empty string is kept", $values["empty"] ?? "default", "");
expect("a value", "value" ?? "default", "value");

// Missing variables and keys are not errors on the left of ??
expect("undefined variable", $never_assigned ?? "default", "default");
expect("undefined global", @never_assigned ?? "default", "default");
expect("missing key", $values["missing"] ?? "default", "default");
expect("missing key of a missing key", $values["missing"]["deeper"] ?? "default", "default");
expect("missing index", $values["list"][5] ?? "default", "default");
expect("string position out of range", "abc"[10] ?? "default", "default");

// Right associative, and the right side only runs when needed
expect("chain", null ?? $never_assigned ?? "last", "last");
@calls = 0;
fn called() {
    @calls++;
    return "called";
}
expect("not evaluated when the left is set", "set" ?? called(), "set");
expect("evaluated when the left is null", null ?? called(), "called");
expect("so called once", @calls, 1);

// Precedence: lower than || and comparisons, higher than assignment
expect("|| first", false || null ?? "right", false);
expect("comparison first", 1 < 2 ?? "right", true);
$assigned = $never_assigned ?? 7;
expect("assignment last", $assigned, 7);
expect("in interpolation", "{$values["missing"] ?? "fallback"}", "fallback");

// Counting with ??= instead of checking has_key first
$counts = {};
foreach (["a", "b", "a", "a"] as $word) {
    $counts[$word] ??= 0;
    $counts[$word]++;
}
expect("counting", $counts, {"a" => 3, "b" => 1});

// Other errors on the left still happen
throws("indexing an int is still an error", () -> 5["key"] ?? "default", "Cannot use [] on int");
throws("a bad key type is still an error", () -> $values[true] ?? "default", "Keys must be int or string, got bool");

// ??= assigns only when the target is null or missing, and gives the resulting value
$settings = {"port" => 0, "host" => null};
expect("??= sets a missing key", $settings["name"] ??= "app", "app");
expect("??= sets a null key", $settings["host"] ??= "localhost", "localhost");
expect("??= keeps a set key, even 0", $settings["port"] ??= 8080, 0);
expect("??= result", $settings, {"port" => 0, "host" => "localhost", "name" => "app"});
expect("??= creates a variable", $created ??= [], []);
@shared ??= "first";
@shared ??= "second";
expect("??= on a global", @shared, "first");

// The key runs once; the right side only when needed
@keys = 0;
fn next_key() {
    @keys++;
    return "k";
}
$lazy = {"k" => "set"};
expect("right side not run when set", $lazy[next_key()] ??= called(), "set");
expect("key evaluated once, right side skipped", [@keys, @calls], [1, 1]);

$groups = {};
foreach ({"x" => "a", "y" => "b", "z" => "a"} as $item => $group) {
    $groups[$group] ??= [];
    $groups[$group][] = $item;
}
expect("grouping with ??=", $groups, {"a" => ["x", "z"], "b" => ["y"]});

// Like =, it doesn't create missing keys along the way
try {
    $empty = {};
    $empty["outer"]["inner"] ??= 1;
} catch ($e) {
    expect("missing outer key is an error", $e.message, "Undefined key: \"outer\"");
}
