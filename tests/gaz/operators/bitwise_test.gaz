include "std/test.gaz" use expect, throws;

// & | ^ ~ << >> are ints only and see the int as 64 bits, not as a quantity
expect("&", 12 & 10, 8);
expect("|", 12 | 10, 14);
expect("^", 12 ^ 10, 6);
expect("~ is -x - 1", ~5, -6);
expect("~0", ~0, -1);
expect("~ of the smallest int", ~(-9223372036854775807 - 1), 9223372036854775807);
expect("<<", 1 << 10, 1024);
expect(">>", 1024 >> 10, 1);
expect(">> keeps the sign", -16 >> 2, -4);
expect(">> of -1 stays -1", -1 >> 63, -1);

// Bits shifted off the top of a << are gone: a shift moves a pattern, so it wraps
expect("<< to the sign bit", 1 << 63, -9223372036854775807 - 1);
expect("<< dropping a bit", 3 << 62, -4611686018427387904);
expect("<< of a negative", -1 << 1, -2);
expect("shifting by 0", 5 << 0, 5);

// Rust and Python precedence, not C: .. is below | is below ^ is below & is below <<,
// and all of them are above the comparisons
expect("& binds tighter than ==", 6 & 3 == 2, true);
expect("| binds looser than ^", 1 | 2 ^ 3, 1);
expect("^ binds looser than &", 1 ^ 3 & 2, 3);
expect("& binds tighter than ..", 12 & 10 .. "!", "8!");
expect(".. binds looser than & on the left too", "x = " .. 12 & 10, "x = 8");
expect(".. binds looser than <<", "n = " .. 1 << 4, "n = 16");
expect(".. still binds tighter than ==", "a" .. 1 == "a1", true);
expect("+ binds tighter than <<", 1 << 2 + 1, 8);
expect("~ is a unary, so it binds tightest", ~2 + 1, -2);
expect("~ then &", ~12 & 10, 2);
expect("shifts are left associative", 256 >> 2 >> 2, 16);

// The compound forms, which the tower gives for free
$flags = 12;
$flags &= 10;
expect("&=", $flags, 8);
$flags |= 1;
expect("|=", $flags, 9);
$flags ^= 3;
expect("^=", $flags, 10);
$flags <<= 4;
expect("<<=", $flags, 160);
$flags >>= 2;
expect(">>=", $flags, 40);

$bits = [1, 2];
$bits[0] <<= 3;
expect("<<= on an element", $bits[0], 8);

// A worked example: \u{H} as UTF-8. lib/json.gaz encoded this with intdiv and % before
// these existed, so they are a clearer and faster way to write it, not the only way
fn utf8($code_point) {
    if ($code_point < 128) {
        return chr($code_point);
    }
    if ($code_point < 2048) {
        return chr(192 | $code_point >> 6) .. chr(128 | $code_point & 63);
    }
    if ($code_point < 65536) {
        return chr(224 | $code_point >> 12) .. chr(128 | $code_point >> 6 & 63) .. chr(128 | $code_point & 63);
    }

    return chr(240 | $code_point >> 18) .. chr(128 | $code_point >> 12 & 63)
        .. chr(128 | $code_point >> 6 & 63) .. chr(128 | $code_point & 63);
}

expect("utf8 of one byte", utf8(65), "A");
expect("utf8 of two bytes", utf8(233), "\u{e9}");
expect("utf8 of three bytes", utf8(8364), "\u{20ac}");
expect("utf8 of four bytes", utf8(128169), "\u{1f4a9}");

// Errors: ints only, and a shift count of 0 to 63
throws("a float on the left", () -> 1.5 & 1, "Cannot use & on float");
throws("a float on the right", () -> 1 & 1.5, "Cannot use & on float");
throws("a bool", () -> true | 1, "Cannot use | on bool");
throws("a string", () -> "a" ^ 1, "Cannot use ^ on string");
throws("a list", () -> [1] << 1, "Cannot use << on list");
throws("~ of a float", () -> ~1.5, "Cannot use ~ on float");
throws("~ of null", () -> ~null, "Cannot use ~ on null");
throws("a shift count of 64", () -> 1 << 64, "Shift count must be between 0 and 63, got 64");
throws("a negative shift count", () -> 1 >> -1, "Shift count must be between 0 and 63, got -1");
throws("a float shift count", () -> 1 << 2.0, "Cannot use << on float");
