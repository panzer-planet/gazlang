/*
 * site/pages.gaz and its templates: every piece of text a page shows is escaped by the template,
 * whatever it holds, and the navigation lists nest as they should
 */
import "site/pages.gaz";
import "site/markdown.gaz";
import "site/library.gaz";
import "site/documents.gaz";
import "std/test.gaz" use expect;
import "site/templates/entry.gazml";
import "site/templates/nav_list.gazml";
import "site/templates/downloads.gazml";
import "site/templates/layout.gazml";
import "site/templates/library_index.gazml";
import "site/templates/library_page.gazml";

const HOSTILE = "<b id=\"x\">it's & \"so\"</b>";
const ESCAPED = "&lt;b id=&quot;x&quot;&gt;it&#39;s &amp; &quot;so&quot;&lt;/b&gt;";

// Whether some HTML shows the hostile text escaped, and never as it is
fn escapes(Html $html): list {
    return [contains($html.text, ESCAPED), contains($html.text, "<b id")];
}

$renderer = markdown::Renderer();

// An entry's kind, name and comment
$entry = library::Entry(HOSTILE, "f", [], HOSTILE);
expect("an entry", escapes(entry(EntryView($entry, "ns", null, $renderer))), [true, false]);
expect("a member", escapes(entry(EntryView($entry, "ns", "Kind", $renderer))), [true, false]);

// A navigation list's titles and links
$nav = nav_list([documents::NavItem(HOSTILE, HOSTILE, true, [documents::NavItem(HOSTILE, "#y")])]);
expect("a navigation list", escapes($nav), [true, false]);

// The download box's version, links and their text
$box = downloads(HOSTILE, [documents::Link(HOSTILE, HOSTILE)], [documents::Link(HOSTILE, HOSTILE)]);
expect("the download box", escapes($box), [true, false]);

// A page's title, description, pager and sidebar
$page = Page("reference/a.html", "reference", HOSTILE, HOSTILE, Html("<p>body</p>"));
$page.previous = documents::Link(HOSTILE, "reference/b.html");
$page.next = documents::Link(HOSTILE, "reference/c.html");
$page.sidebar = [documents::NavItem(HOSTILE, "#z")];
$page.sidebar_label = HOSTILE;
$html = layout($page, documents::Repository("o/n"));
expect("a page", escapes($html), [true, false]);
expect("the title is escaped", contains($html.text, "<title>" .. ESCAPED .. "</title>"), true);
expect("a page two down finds the root", Page("a/b/c.html", "home", "t", "d", Html("")).root(), "../../");

// The library's index and a page of it
$library = library::Library("x", "x", HOSTILE, [$entry]);
expect("the library index", escapes(library_index([LibraryView($library, $renderer)])), [true, false]);
expect("a library page", escapes(library_page(LibraryView($library, $renderer))), [true, false]);

// A sidebar: the second level, with the third under each; a third before any second is left out
$headings = [
    markdown::Heading(3, "Early", "early"), markdown::Heading(2, "A", "a"), markdown::Heading(3, "B", "b"),
    markdown::Heading(4, "Deep", "deep"), markdown::Heading(2, "C", "c"),
];
$shape = map(heading_navigation($headings), $item -> [$item.title, map($item.children, $child -> $child.title)]);
expect("a sidebar's levels", $shape, [["A", ["B"]], ["C", []]]);

expect("a release's version", [version_of("v1.2.3"), version_of("1.2.3")], ["1.2.3", "1.2.3"]);
expect("before the first section", before_first_section("<h1>T</h1><p>a</p><h2 id=\"b\">B</h2>", "[box]"),
    "<h1>T</h1><p>a</p>[box]<h2 id=\"b\">B</h2>");
expect("at the end without one", before_first_section("<p>a</p>", "[box]"), "<p>a</p>[box]");
