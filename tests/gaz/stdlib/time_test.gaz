include "../check.gaz";

$first = monotonic_time();
check("a float", type_of($first), "float");
$second = monotonic_time();
check("it never goes back", $second >= $first, true);

/* and it moves: look until it does, for as long as it takes a clock with a microsecond to tick */
$looks = 0;
while (monotonic_time() == $first && $looks < 20000000) {
    $looks++;
}
check("it moves on", monotonic_time() > $first, true);
check("in seconds: that didn't take a minute", monotonic_time() - $first < 60, true);
check("and it is positive", $first > 0, true);
$readings = [];
for ($i = 0; $i < 100; $i++) {
    $readings[] = monotonic_time();
}
$sorted = sort($readings, ($a, $b) -> $a <=> $b);
check("a hundred readings come in order", $readings, $sorted);

/* time(): the wall clock, whole seconds since 1970 (HttpServerTest checks it against PHP's) */
$now = time();
check("time() is an int", type_of($now), "int");
check("after 2026 began and before 2100", $now > 1767225600 && $now < 4102444800, true);
check("and doesn't go back in a moment", time() >= $now, true);
