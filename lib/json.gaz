// JSON (RFC 8259) for GazLang: json::decode($text) and json::encode($value).
//
// Decoding follows PHP's json_decode($text), with maps for objects:
// - objects become maps with string keys (a key like "0" stays the string "0"), arrays lists;
// - numbers with a fraction or exponent become floats, others ints, and an integer
//   too large for an int becomes a float;
// - true, false, null and strings map directly, with escapes decoded and surrogate
//   pairs joined into one code point written as UTF-8;
// - nesting deeper than 511 arrays or objects is an error, as with PHP's default depth.
// Invalid JSON raises "Invalid JSON: <what> at position <byte offset>", which try/catch
// can catch.
// Differences from PHP: a number too large for a float is an error rather than INF
// (GazLang has no INF), and strings are not checked for valid UTF-8.
//
// Encoding writes compact JSON: a list is a JSON array and a map an object, with int keys
// written as strings. Strings are written as UTF-8, escaping only what JSON requires, and
// floats keep their exact digits (1.0, 0.30000000000000004, 1.0E+25).
//
// An object is written as what its pub to_json() returns, which is a value to encode (a map, say),
// not JSON text, and may hold objects itself; one without it is an error ("Team has no member
// to_json"), and so is one that comes back inside its own. The kind decides what escapes it, so
// nothing private is written by accident. Decoding gives maps, never objects: a kind that can be
// read back has a static from_json($data) by convention, which can set its private fields and
// check them, and a document never gets to choose which kinds are built.

namespace json;

include "chars.gaz" use char_at, is_digit, is_hex_digit, is_space;

pub fn decode($text) {
    return Reader($text).parse();
}

pub fn encode($value) {
    return write($value, {});
}

// $open holds the object_id() of each object being written around this value, so an object that
// comes back inside its own to_json() is an error rather than a loop until the calls run out
fn write($value, $open) {
    $type = type_of($value);
    if ($type == "string") {
        return encode_string($value);
    }
    if ($type == "function" || $type == "kind") {
        throw "Cannot encode a {$type} as JSON";
    }
    if ($type == "object") {
        $id = object_id($value);
        if (has_key($open, $id)) {
            throw "Cannot encode " .. kind_name($value) .. " as JSON: its to_json() comes back to itself";
        }
        $open[$id] = true;
        return write($value.to_json(), $open);
    }
    if ($type != "list" && $type != "map") {
        // null, true, false, ints and floats are already written the way JSON writes them
        return to_string($value);
    }

    $parts = [];
    if ($type == "list") {
        foreach ($value as $item) {
            $parts[] = write($item, $open);
        }
        return "[" .. join($parts, ",") .. "]";
    }
    foreach ($value as $key => $item) {
        $parts[] = encode_string(to_string($key)) .. ":" .. write($item, $open);
    }
    return "{" .. join($parts, ",") .. "}";
}

// --- Decoding ---

// A JSON document being read: the text, the byte position, and how many arrays and objects
// are open. Objects are handles, so every method moves the same reader and none of this has
// to be global; a decode running inside another decode gets a reader of its own.
kind Reader {
    #text;
    #pos = 0;
    #depth = 0;
    // Built once per reader, where the local in parse_escape() was rebuilt for every escape
    #simple = {"\"" => "\"", "\\" => "\\", "/" => "/", "b" => chr(8), "f" => "\f", "n" => "\n", "r" => "\r", "t" => "\t"};

    fn _($text) { #text = $text; }

    // The whole document: one value, then nothing but whitespace
    pub fn parse() {
        #skip_whitespace();
        $value = #parse_value();
        #skip_whitespace();
        if (#pos < len(#text)) {
            #fail("unexpected " .. #describe_char() .. " after the value");
        }

        return $value;
    }

    fn fail($message) {
        throw "Invalid JSON: $message at position " .. #pos;
    }

    // The character at the current position, quoted, or "end of input"
    fn describe_char() {
        $c = char_at(#text, #pos);
        if ($c == "") {
            return "end of input";
        }
        return encode_string($c);
    }

    fn skip_whitespace() {
        while (is_space(char_at(#text, #pos))) {
            #pos++;
        }
    }

    fn parse_value() {
        $c = char_at(#text, #pos);
        if ($c == "{") {
            return #parse_object();
        }
        if ($c == "[") {
            return #parse_array();
        }
        if ($c == "\"") {
            return #parse_string();
        }
        if ($c == "-" || is_digit($c)) {
            return #parse_number();
        }
        if (#match("true")) {
            return true;
        }
        if (#match("false")) {
            return false;
        }
        if (#match("null")) {
            return null;
        }
        #fail("unexpected " .. #describe_char());
    }

    // If the text continues with $word, move past it and return true
    fn match($word) {
        if (slice(#text, #pos, len($word)) == $word) {
            #pos += len($word);
            return true;
        }
        return false;
    }

    // Called at the [ or { that opens an array or object
    fn enter() {
        #depth++;
        if (#depth > 511) {
            #fail("nesting deeper than 511 levels");
        }
        #pos++;
        #skip_whitespace();
    }

    fn parse_array() {
        #enter();
        $array = [];
        if (char_at(#text, #pos) == "]") {
            #pos++;
            #depth--;
            return $array;
        }

        while (true) {
            #skip_whitespace();
            $array[] = #parse_value();
            #skip_whitespace();

            $c = char_at(#text, #pos);
            if ($c == "]") {
                #pos++;
                #depth--;
                return $array;
            }
            if ($c != ",") {
                #fail("expected , or ] but found " .. #describe_char());
            }
            #pos++;
        }
    }

    fn parse_object() {
        #enter();
        $object = {};
        if (char_at(#text, #pos) == "}") {
            #pos++;
            #depth--;
            return $object;
        }

        while (true) {
            #skip_whitespace();
            if (char_at(#text, #pos) != "\"") {
                #fail("expected a string key but found " .. #describe_char());
            }
            $key = #parse_string();

            #skip_whitespace();
            if (char_at(#text, #pos) != ":") {
                #fail("expected : but found " .. #describe_char());
            }
            #pos++;
            #skip_whitespace();
            // Duplicate keys: the last one wins
            $object[$key] = #parse_value();
            #skip_whitespace();

            $c = char_at(#text, #pos);
            if ($c == "}") {
                #pos++;
                #depth--;
                return $object;
            }
            if ($c != ",") {
                #fail("expected , or } but found " .. #describe_char());
            }
            #pos++;
        }
    }

    // Called at the opening quote. Runs of plain characters are copied with slice(),
    // rather than one character at a time. This is the hot loop for most documents, so it
    // indexes the text directly instead of calling char_at().
    fn parse_string() {
        $text = #text;
        $length = len($text);
        $pos = #pos + 1;
        $run_start = $pos;
        $result = "";

        while ($pos < $length) {
            $c = $text[$pos];
            if ($c == "\"") {
                #pos = $pos + 1;
                return $result .. slice($text, $run_start, $pos - $run_start);
            }
            if ($c == "\\") {
                $result ..= slice($text, $run_start, $pos - $run_start);
                #pos = $pos;
                $result ..= #parse_escape();
                $pos = #pos;
                $run_start = $pos;
            } else if (ord($c) < 32) {
                #pos = $pos;
                #fail("unescaped control character in string");
            } else {
                $pos++;
            }
        }

        #pos = $pos;
        #fail("unterminated string");
    }

    // Called at a backslash in a string: returns what the escape stands for and moves past it
    fn parse_escape() {
        $c = char_at(#text, #pos + 1);
        if (has_key(#simple, $c)) {
            #pos += 2;
            return #simple[$c];
        }
        if ($c != "u") {
            #fail("invalid escape " .. encode_string("\\" .. $c));
        }

        $unit = #parse_hex4(#pos + 2);
        #pos += 6;

        // UTF-16 surrogates: a high one (0xD800 to 0xDBFF) followed by a low one (0xDC00 to
        // 0xDFFF) make one code point
        if ($unit >= 0xDC00 && $unit <= 0xDFFF) {
            #fail("unpaired UTF-16 surrogate");
        }
        if ($unit < 0xD800 || $unit > 0xDBFF) {
            return utf8($unit);
        }
        if (slice(#text, #pos, 2) != "\\u") {
            #fail("unpaired UTF-16 surrogate");
        }
        $low = #parse_hex4(#pos + 2);
        if ($low < 0xDC00 || $low > 0xDFFF) {
            #fail("unpaired UTF-16 surrogate");
        }
        #pos += 6;
        return utf8(0x10000 + ($unit - 0xD800) * 0x400 + ($low - 0xDC00));
    }

    // The four hex digits starting at $at, as an int
    fn parse_hex4($at) {
        $value = 0;
        for ($i = 0; $i < 4; $i++) {
            $c = char_at(#text, $at + $i);
            if (!is_hex_digit($c)) {
                #pos = $at + $i;
                #fail("expected four hex digits after \\u");
            }
            $value = $value * 16 + index_of("0123456789abcdef", lower($c));
        }
        return $value;
    }

    // JSON's number grammar: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
    fn parse_number() {
        $text = #text;
        $start = #pos;
        $pos = $start;
        $negative = char_at($text, $pos) == "-";
        if ($negative) {
            $pos++;
        }

        if (char_at($text, $pos) == "0") {
            $pos++;
        } else if (is_digit(char_at($text, $pos))) {
            $pos = skip_digits($text, $pos);
        } else {
            #pos = $pos;
            #fail("expected a digit but found " .. #describe_char());
        }
        $digits_end = $pos;

        $is_float = false;
        if (char_at($text, $pos) == ".") {
            if (!is_digit(char_at($text, $pos + 1))) {
                #pos = $pos + 1;
                #fail("expected a digit after the decimal point");
            }
            $pos = skip_digits($text, $pos + 1);
            $is_float = true;
        }

        $c = char_at($text, $pos);
        if ($c == "e" || $c == "E") {
            $pos++;
            $sign = char_at($text, $pos);
            if ($sign == "+" || $sign == "-") {
                $pos++;
            }
            if (!is_digit(char_at($text, $pos))) {
                #pos = $pos;
                #fail("expected a digit in the exponent");
            }
            $pos = skip_digits($text, $pos);
            $is_float = true;
        }

        #pos = $pos;
        $number = slice($text, $start, $pos - $start);
        if ($is_float || !int_fits(slice($text, $start, $digits_end - $start), $negative)) {
            return to_float($number);
        }
        return to_int($number);
    }
}

fn skip_digits($text, $pos) {
    while (is_digit(char_at($text, $pos))) {
        $pos++;
    }
    return $pos;
}

// Whether an integer (with its minus, if any, and no leading zeros) fits in an int.
// Equal-length digit strings compare byte by byte, which is numeric order.
fn int_fits($integer, $negative) {
    $digits = $integer;
    $limit = "9223372036854775807";
    if ($negative) {
        $digits = slice($integer, 1);
        $limit = "9223372036854775808";
    }
    return len($digits) < 19 || len($digits) == 19 && $digits <= $limit;
}

// A code point written as UTF-8 bytes: each continuation byte carries the low 6 bits of
// what is left, so the tail is shifted away 6 bits at a time
fn utf8($code_point) {
    if ($code_point < 0x80) {
        return chr($code_point);
    }
    $continuation = chr(0x80 | $code_point & 0x3F);
    if ($code_point < 0x800) {
        return chr(0xC0 | $code_point >> 6) .. $continuation;
    }
    if ($code_point < 0x10000) {
        return chr(0xE0 | $code_point >> 12) .. chr(0x80 | $code_point >> 6 & 0x3F) .. $continuation;
    }
    return chr(0xF0 | $code_point >> 18) .. chr(0x80 | $code_point >> 12 & 0x3F)
        .. chr(0x80 | $code_point >> 6 & 0x3F) .. $continuation;
}

// --- Encoding ---

// A string as a JSON string: quote, backslash and control characters escaped
fn encode_string($string) {
    $escapes = {"\"" => "\\\"", "\\" => "\\\\", "\n" => "\\n", "\r" => "\\r", "\t" => "\\t", "\f" => "\\f", chr(8) => "\\b"};
    $hex = "0123456789abcdef";
    $result = "";
    $run_start = 0;
    $length = len($string);

    for ($i = 0; $i < $length; $i++) {
        $c = $string[$i];
        $code = ord($c);
        // Most characters need nothing, so test for that cheaply first
        if ($code >= 32 && $c != "\"" && $c != "\\") {
            continue;
        }
        $escaped = "\\u00" .. $hex[intdiv($code, 16)] .. $hex[$code % 16];
        if (has_key($escapes, $c)) {
            $escaped = $escapes[$c];
        }
        $result ..= slice($string, $run_start, $i - $run_start) .. $escaped;
        $run_start = $i + 1;
    }

    return "\"" .. $result .. slice($string, $run_start, $length - $run_start) .. "\"";
}
