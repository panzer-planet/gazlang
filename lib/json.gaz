// JSON (RFC 8259) for GazLang: json_decode($text) and json_encode($value).
//
// Decoding follows PHP's json_decode($text, true):
// - objects and arrays both become arrays (an object key like "0" becomes the int 0);
// - numbers with a fraction or exponent become floats, others ints, and an integer
//   too large for an int becomes a float;
// - true, false, null and strings map directly, with escapes decoded and surrogate
//   pairs joined into one code point written as UTF-8;
// - nesting deeper than 511 arrays or objects is an error, as with PHP's default depth.
// Invalid JSON raises "Invalid JSON: <what> at position <byte offset>", which try/catch
// can catch.
// Differences from PHP: a number too large for a float is an error rather than INF
// (GazLang has no INF), and strings are not checked for valid UTF-8.
//
// Encoding writes compact JSON. An array whose keys are 0, 1, 2, ... in order is a JSON
// array and any other array is an object, so an empty array is [] (GazLang can't tell
// {} from []). Strings are written as UTF-8, escaping only what JSON requires, and
// floats keep their exact digits (1.0, 0.30000000000000004, 1.0E+25).

include "chars.gaz";

// Parser state: the text being decoded, the byte position, and how many arrays and
// objects are open. Globals, because every parse function moves the same position.
@json_text = "";
@json_pos = 0;
@json_depth = 0;

function json_decode($text) {
    @json_text = $text;
    @json_pos = 0;
    @json_depth = 0;

    json_skip_whitespace();
    $value = json_parse_value();
    json_skip_whitespace();
    if (@json_pos < len(@json_text)) {
        json_fail("unexpected " + json_describe_char() + " after the value");
    }

    return $value;
}

function json_encode($value) {
    $type = type_of($value);
    if ($type === "string") {
        return json_encode_string($value);
    }
    if ($type !== "array") {
        // null, true, false, ints and floats are already written the way JSON writes them
        return to_string($value);
    }

    $parts = [];
    if (json_is_list($value)) {
        foreach ($value as $item) {
            $parts[] = json_encode($item);
        }
        return "[" + join($parts, ",") + "]";
    }
    foreach ($value as $key => $item) {
        $parts[] = json_encode_string(to_string($key)) + ":" + json_encode($item);
    }
    return "{" + join($parts, ",") + "}";
}

// --- Decoding ---

function json_fail($message) {
    error("Invalid JSON: $message at position " + @json_pos);
}

// The character at the current position, quoted, or "end of input"
function json_describe_char() {
    $c = char_at(@json_text, @json_pos);
    if ($c === "") {
        return "end of input";
    }
    return json_encode_string($c);
}

function json_skip_whitespace() {
    while (is_space(char_at(@json_text, @json_pos))) {
        @json_pos++;
    }
}

function json_parse_value() {
    $c = char_at(@json_text, @json_pos);
    if ($c === "{") {
        return json_parse_object();
    }
    if ($c === "[") {
        return json_parse_array();
    }
    if ($c === "\"") {
        return json_parse_string();
    }
    if ($c === "-" || is_digit($c)) {
        return json_parse_number();
    }
    if (json_match("true")) {
        return true;
    }
    if (json_match("false")) {
        return false;
    }
    if (json_match("null")) {
        return null;
    }
    json_fail("unexpected " + json_describe_char());
}

// If the text continues with $word, move past it and return true
function json_match($word) {
    if (slice(@json_text, @json_pos, len($word)) === $word) {
        @json_pos += len($word);
        return true;
    }
    return false;
}

// Called at the [ or { that opens an array or object
function json_enter() {
    @json_depth++;
    if (@json_depth > 511) {
        json_fail("nesting deeper than 511 levels");
    }
    @json_pos++;
    json_skip_whitespace();
}

function json_parse_array() {
    json_enter();
    $array = [];
    if (char_at(@json_text, @json_pos) === "]") {
        @json_pos++;
        @json_depth--;
        return $array;
    }

    while (true) {
        json_skip_whitespace();
        $array[] = json_parse_value();
        json_skip_whitespace();

        $c = char_at(@json_text, @json_pos);
        if ($c === "]") {
            @json_pos++;
            @json_depth--;
            return $array;
        }
        if ($c !== ",") {
            json_fail("expected , or ] but found " + json_describe_char());
        }
        @json_pos++;
    }
}

function json_parse_object() {
    json_enter();
    $object = [];
    if (char_at(@json_text, @json_pos) === "}") {
        @json_pos++;
        @json_depth--;
        return $object;
    }

    while (true) {
        json_skip_whitespace();
        if (char_at(@json_text, @json_pos) !== "\"") {
            json_fail("expected a string key but found " + json_describe_char());
        }
        $key = json_parse_string();

        json_skip_whitespace();
        if (char_at(@json_text, @json_pos) !== ":") {
            json_fail("expected : but found " + json_describe_char());
        }
        @json_pos++;
        json_skip_whitespace();
        // Duplicate keys: the last one wins
        $object[$key] = json_parse_value();
        json_skip_whitespace();

        $c = char_at(@json_text, @json_pos);
        if ($c === "}") {
            @json_pos++;
            @json_depth--;
            return $object;
        }
        if ($c !== ",") {
            json_fail("expected , or } but found " + json_describe_char());
        }
        @json_pos++;
    }
}

// Called at the opening quote. Runs of plain characters are copied with slice(),
// rather than one character at a time. This is the hot loop for most documents, so it
// indexes the text directly instead of calling char_at().
function json_parse_string() {
    $text = @json_text;
    $length = len($text);
    $pos = @json_pos + 1;
    $run_start = $pos;
    $result = "";

    while ($pos < $length) {
        $c = $text[$pos];
        if ($c === "\"") {
            @json_pos = $pos + 1;
            return $result + slice($text, $run_start, $pos - $run_start);
        }
        if ($c === "\\") {
            $result += slice($text, $run_start, $pos - $run_start);
            @json_pos = $pos;
            $result += json_parse_escape();
            $pos = @json_pos;
            $run_start = $pos;
        } else if (ord($c) < 32) {
            @json_pos = $pos;
            json_fail("unescaped control character in string");
        } else {
            $pos++;
        }
    }

    @json_pos = $pos;
    json_fail("unterminated string");
}

// Called at a backslash in a string: returns what the escape stands for and moves past it
function json_parse_escape() {
    $c = char_at(@json_text, @json_pos + 1);
    $simple = ["\"" => "\"", "\\" => "\\", "/" => "/", "b" => chr(8), "f" => "\f", "n" => "\n", "r" => "\r", "t" => "\t"];
    if (has_key($simple, $c)) {
        @json_pos += 2;
        return $simple[$c];
    }
    if ($c !== "u") {
        json_fail("invalid escape " + json_encode_string("\\" + $c));
    }

    $unit = json_parse_hex4(@json_pos + 2);
    @json_pos += 6;

    // UTF-16 surrogates (D800 to DFFF): a high one followed by a low one make one code point
    if ($unit >= 56320 && $unit <= 57343) {
        json_fail("unpaired UTF-16 surrogate");
    }
    if ($unit < 55296 || $unit > 56319) {
        return json_utf8($unit);
    }
    if (slice(@json_text, @json_pos, 2) !== "\\u") {
        json_fail("unpaired UTF-16 surrogate");
    }
    $low = json_parse_hex4(@json_pos + 2);
    if ($low < 56320 || $low > 57343) {
        json_fail("unpaired UTF-16 surrogate");
    }
    @json_pos += 6;
    return json_utf8(65536 + ($unit - 55296) * 1024 + ($low - 56320));
}

// The four hex digits starting at $at, as an int
function json_parse_hex4($at) {
    $value = 0;
    for ($i = 0; $i < 4; $i++) {
        $c = lower(char_at(@json_text, $at + $i));
        // index_of finds "" at 0, so the end of the text needs its own check
        $digit = null;
        if ($c !== "") {
            $digit = index_of("0123456789abcdef", $c);
        }
        if ($digit === null) {
            @json_pos = $at + $i;
            json_fail("expected four hex digits after \\u");
        }
        $value = $value * 16 + $digit;
    }
    return $value;
}

// A code point written as UTF-8 bytes
function json_utf8($code_point) {
    if ($code_point < 128) {
        return chr($code_point);
    }
    $continuation = chr(128 + $code_point % 64);
    if ($code_point < 2048) {
        return chr(192 + intdiv($code_point, 64)) + $continuation;
    }
    if ($code_point < 65536) {
        return chr(224 + intdiv($code_point, 4096)) + chr(128 + intdiv($code_point, 64) % 64) + $continuation;
    }
    return chr(240 + intdiv($code_point, 262144)) + chr(128 + intdiv($code_point, 4096) % 64)
        + chr(128 + intdiv($code_point, 64) % 64) + $continuation;
}

// JSON's number grammar: -?(0|[1-9][0-9]*)(.[0-9]+)?([eE][+-]?[0-9]+)?
function json_parse_number() {
    $text = @json_text;
    $start = @json_pos;
    $pos = $start;
    $negative = char_at($text, $pos) === "-";
    if ($negative) {
        $pos++;
    }

    if (char_at($text, $pos) === "0") {
        $pos++;
    } else if (is_digit(char_at($text, $pos))) {
        $pos = json_skip_digits($text, $pos);
    } else {
        @json_pos = $pos;
        json_fail("expected a digit but found " + json_describe_char());
    }
    $digits_end = $pos;

    $is_float = false;
    if (char_at($text, $pos) === ".") {
        if (!is_digit(char_at($text, $pos + 1))) {
            @json_pos = $pos + 1;
            json_fail("expected a digit after the decimal point");
        }
        $pos = json_skip_digits($text, $pos + 1);
        $is_float = true;
    }

    $c = char_at($text, $pos);
    if ($c === "e" || $c === "E") {
        $pos++;
        $sign = char_at($text, $pos);
        if ($sign === "+" || $sign === "-") {
            $pos++;
        }
        if (!is_digit(char_at($text, $pos))) {
            @json_pos = $pos;
            json_fail("expected a digit in the exponent");
        }
        $pos = json_skip_digits($text, $pos);
        $is_float = true;
    }

    @json_pos = $pos;
    $number = slice($text, $start, $pos - $start);
    if ($is_float || !json_int_fits(slice($text, $start, $digits_end - $start), $negative)) {
        return to_float($number);
    }
    return to_int($number);
}

function json_skip_digits($text, $pos) {
    while (is_digit(char_at($text, $pos))) {
        $pos++;
    }
    return $pos;
}

// Whether an integer (with its minus, if any, and no leading zeros) fits in an int.
// Equal-length digit strings compare byte by byte, which is numeric order.
function json_int_fits($integer, $negative) {
    $digits = $integer;
    $limit = "9223372036854775807";
    if ($negative) {
        $digits = slice($integer, 1, len($integer) - 1);
        $limit = "9223372036854775808";
    }
    return len($digits) < 19 || len($digits) === 19 && $digits <= $limit;
}

// --- Encoding ---

function json_is_list($array) {
    $expected = 0;
    foreach ($array as $key => $item) {
        if ($key !== $expected) {
            return false;
        }
        $expected++;
    }
    return true;
}

// A string as a JSON string: quote, backslash and control characters escaped
function json_encode_string($string) {
    $escapes = ["\"" => "\\\"", "\\" => "\\\\", "\n" => "\\n", "\r" => "\\r", "\t" => "\\t", "\f" => "\\f", chr(8) => "\\b"];
    $hex = "0123456789abcdef";
    $result = "";
    $run_start = 0;
    $length = len($string);

    for ($i = 0; $i < $length; $i++) {
        $c = $string[$i];
        $code = ord($c);
        // Most characters need nothing, so test for that cheaply first
        if ($code >= 32 && $c !== "\"" && $c !== "\\") {
            continue;
        }
        $escaped = "\\u00" + $hex[intdiv($code, 16)] + $hex[$code % 16];
        if (has_key($escapes, $c)) {
            $escaped = $escapes[$c];
        }
        $result += slice($string, $run_start, $i - $run_start) + $escaped;
        $run_start = $i + 1;
    }

    return "\"" + $result + slice($string, $run_start, $length - $run_start) + "\"";
}
