/**
 * Testing GazLang code: a test file imports this and checks values, and `gaz test` runs every
 * test file it finds.
 *
 *   import "std/test.gaz" use expect, throws;
 *   expect("two plus two", 2 + 2, 4);
 *   throws("past the end", () -> [1, 2][5], "Index out of range: 5");
 *   test::snapshot("the report", build_report());
 *   test::done();
 *
 * Every check prints one line: `ok <label>` when it holds, or `FAIL <label>: ...` saying what was
 * wanted and what came instead. `gaz test` reads those lines, so their shape is the contract.
 *
 * - `expect($label, $actual, $expected)` holds when the values are `==` and of the same type.
 *   For two lists or two maps a FAIL line also names the first index or key where they differ.
 *   A value longer than 200 bytes is cut short on a FAIL line, which stays one line.
 * - `throws($label, $thunk, $message)` calls `$thunk` and holds when it throws an error with
 *   that message; `throws($label, $thunk, $kind, $message)` also requires the error to be of
 *   exactly that kind (not a child of it, so a test names the kind it means), and the message
 *   may be left out to check the kind alone. A runtime error and `throw "text"` are an `Error`.
 *   A thrown value that isn't an `Error` (`throw 5`) is compared as it is, as `expect` would.
 * - `snapshot($label, $actual)` compares `$actual`, written as a literal, against a file
 *   recorded next to the test file, named after it and the label; `gaz test --update` (re)writes
 *   the file instead of comparing.
 * - `done()` ends the program, with status 1 if any check in it failed and 0 otherwise, so a
 *   test file run on its own tells a script whether it passed.
 *
 * `gaz test [path...] [--update] [-v]` finds every `*_test.gaz` file under each path (the current
 * directory by default), recursively, and runs each as a `gaz` process of its own: `import`
 * takes only a string literal, so a runner can't import a path it finds while running, and a
 * process per file means one file's crash or endless loop can't touch another's run. For each
 * file it prints the FAIL lines, what the file wrote to standard error, and a line counting its
 * checks; `-v` prints everything the file printed instead of only the FAIL lines. A file fails
 * the run if a check failed, it exited with a status other than 0, or it checked nothing. The
 * run exits 1 if any file failed.
 *
 * The runner starts each file as `gaz <file> <file> [--update]`: once to say what to run, and
 * again as the file's first argument, since a program has no builtin giving its own path;
 * `snapshot()` reads it to find where "next to the test" is.
 */
namespace test;

import "std/text.gaz" use quote;

const UPDATE_FLAG = "--update";
const VERBOSE_FLAGS = ["-v", "--verbose"];

// The most of a value a FAIL line shows, so a huge value still leaves a readable line
const SHOWN_BYTES = 200;

// How many checks in this program have failed, for done()
kind Tally {
    pub static #failures = 0;
}

/**
 * Prints "ok <label>" when $actual == $expected and both are of one type, or a FAIL line naming both
 */
pub fn expect($label, $actual, $expected) {
    if ($actual == $expected && type_of($actual) == type_of($expected)) {
        pass($label);
        return;
    }
    $reason = "expected " .. described($expected) .. ", got " .. described($actual);
    if (is_container($actual) && type_of($actual) == type_of($expected)) {
        $reason ..= "; first difference " .. first_difference($actual, $expected, "");
    }
    fail($label, $reason);
}

/**
 * Calls $thunk and prints "ok <label>" when it throws what is described, or a FAIL line naming
 * what was wanted and what was thrown, if anything: throws($label, $thunk, $message), or
 * throws($label, $thunk, $kind, $message) to require that exact kind too.
 */
pub fn throws($label, $thunk, $kind_or_message, $message = null) {
    if ($message != null && type_of($kind_or_message) != "kind") {
        throw "test::throws() takes a kind before a message, not " .. type_of($kind_or_message);
    }
    $kind = null;
    $wanted = $kind_or_message;
    if (type_of($kind_or_message) == "kind") {
        $kind = $kind_or_message;
        $wanted = $message;
    }
    $wanted_text = described_error($kind, $wanted);
    $caught = thrown_by($thunk);
    if (len($caught) == 0) {
        fail($label, "expected {$wanted_text} to be thrown, nothing was");
        return;
    }
    $thrown = $caught[0];
    if (is_kind($thrown, $kind) && has_message($thrown, $wanted)) {
        pass($label);
        return;
    }
    fail($label, "expected {$wanted_text} to be thrown, got " .. described_thrown($thrown));
}

/**
 * Compares $actual against the file recorded next to the calling test file, or under --update
 * (re)writes it. Needs the test file's own path, which gaz test passes as args()[0].
 */
pub fn snapshot($label, $actual) {
    $path = snapshot_path($label);
    $text = quote($actual);
    if (has_flag(UPDATE_FLAG)) {
        write_file($path, $text);
        echo "ok " .. one_line($label) .. " (snapshot recorded at {$path})";
        return;
    }
    if (!file_exists($path)) {
        fail($label, "no snapshot at {$path}; run gaz test --update to record it");
        return;
    }
    $expected = read_file($path);
    if ($text == $expected) {
        pass($label);
    } else {
        fail($label, "snapshot {$path} expected " .. clipped($expected) .. ", got " .. clipped($text));
    }
}

/**
 * Ends the program: status 1 if any check in it failed, 0 if none did
 */
pub fn done() {
    exit(Tally::failures > 0 ? 1 : 0);
}

/**
 * Runs every *_test.gaz file gaz test finds and reports; the entry point of its bootstrap program
 */
pub fn main() {
    $paths = [];
    $update = false;
    $verbose = false;
    foreach (args() as $arg) {
        if ($arg == UPDATE_FLAG) {
            $update = true;
        } else if (in_array($arg, VERBOSE_FLAGS)) {
            $verbose = true;
        } else if (starts_with($arg, "-")) {
            print_error("gaz test: unknown option {$arg}; it takes paths, --update and -v\n");
            exit(2);
        } else {
            $paths[] = $arg;
        }
    }
    if (len($paths) == 0) {
        $paths = ["."];
    }
    $files = [];
    foreach ($paths as $path) {
        $files = [...$files, ...discover($path)];
    }
    $failed = 0;
    foreach ($files as $file) {
        if (!run_file($file, $update, $verbose)) {
            $failed++;
        }
    }
    echo len($files) .. " file" .. (len($files) == 1 ? "" : "s") .. " run, " .. $failed .. " failed";
    exit($failed > 0 ? 1 : 0);
}

// Runs one test file, prints what the run shows of it, and gives whether it passed
fn run_file($file, $update, $verbose) {
    $argv = [program_path(), $file, $file];
    if ($update) {
        $argv[] = UPDATE_FLAG;
    }
    $result = run($argv);
    $lines = output_lines($result["stdout"]);
    $checks = 0;
    $failures = 0;
    foreach ($lines as $line) {
        if (starts_with($line, "ok ")) {
            $checks++;
        } else if (starts_with($line, "FAIL ")) {
            $checks++;
            $failures++;
        }
        if ($verbose || starts_with($line, "FAIL ") || $update && contains($line, " (snapshot recorded at ")) {
            echo $line;
        }
    }
    if ($result["stderr"] != "") {
        print_error($result["stderr"]);
    }
    $summary = "{$file}: {$checks} check" .. ($checks == 1 ? "" : "s") .. ", {$failures} failed";
    if ($result["status"] != 0) {
        $summary ..= "; exited with status " .. $result["status"];
    }
    if ($checks == 0) {
        $summary ..= "; nothing was checked";
    }
    echo $summary;

    return $failures == 0 && $result["status"] == 0 && $checks > 0;
}

// The lines of what a program printed, without the empty one after its last newline
fn output_lines($text) {
    if ($text == "") {
        return [];
    }
    $lines = split($text, "\n");
    if (last($lines) == "") {
        delete $lines[len($lines) - 1];
    }

    return $lines;
}

// Every *_test.gaz under $path, recursively; $path itself if it already names one
fn discover($path) {
    if (!file_exists($path)) {
        print_error("gaz test: {$path} does not exist\n");
        exit(2);
    }
    if (!is_dir($path)) {
        return ends_with($path, "_test.gaz") ? [$path] : [];
    }
    $files = [];
    foreach (list_dir($path) as $name) {
        if (starts_with($name, ".")) {
            continue;   // .git and the like
        }
        $full = $path .. "/" .. $name;
        if (is_dir($full)) {
            $files = [...$files, ...discover($full)];
        } else if (ends_with($name, "_test.gaz")) {
            $files[] = $full;
        }
    }

    return $files;
}

// Prints the line of a check that held
fn pass($label) {
    echo "ok " .. one_line($label);
}

// Prints a FAIL line, one line whatever the reason holds, and counts it for done()
fn fail($label, $reason) {
    Tally::failures++;
    echo "FAIL " .. one_line($label) .. ": " .. $reason;
}

// A list or a map, which a FAIL line can say where in two of them the difference is
fn is_container($value) {
    return type_of($value) == "list" || type_of($value) == "map";
}

/*
 * Where two values that aren't == first differ, as the path of indexes and keys down to it and
 * the two values there: `at [2]["name"]: expected "a" (string), got "b" (string)`. A list is
 * walked in order, a map by the expected keys in their order and then the keys only $actual has.
 */
fn first_difference($actual, $expected, $path) {
    if (!is_container($actual) || type_of($actual) != type_of($expected)) {
        return difference_at($path, described($expected), described($actual));
    }
    if (type_of($expected) == "list") {
        return first_list_difference($actual, $expected, $path);
    }

    return first_map_difference($actual, $expected, $path);
}

fn first_list_difference($actual, $expected, $path) {
    $shared = min(len($actual), len($expected));
    for ($i = 0; $i < $shared; $i++) {
        if ($actual[$i] != $expected[$i]) {
            return first_difference($actual[$i], $expected[$i], "{$path}[{$i}]");
        }
    }
    if (len($expected) > $shared) {
        return difference_at("{$path}[{$shared}]", described($expected[$shared]), "nothing");
    }

    return difference_at("{$path}[{$shared}]", "nothing", described($actual[$shared]));
}

fn first_map_difference($actual, $expected, $path) {
    foreach ($expected as $key => $value) {
        $place = $path .. "[" .. quote($key) .. "]";
        if (!has_key($actual, $key)) {
            return difference_at($place, described($value), "nothing");
        }
        if ($actual[$key] != $value) {
            return first_difference($actual[$key], $value, $place);
        }
    }
    foreach ($actual as $key => $value) {
        if (!has_key($expected, $key)) {
            return difference_at($path .. "[" .. quote($key) .. "]", "nothing", described($value));
        }
    }

    return "not found";   // == told them apart, so this is never reached
}

fn difference_at($path, $expected, $actual) {
    return "at {$path}: expected {$expected}, got {$actual}";
}

// A value on a FAIL line: as echo prints it, cut short, then its type
fn described($value) {
    $shown = type_of($value) == "string" ? quote($value) : to_string($value);

    return clipped($shown) .. " (" .. type_of($value) .. ")";
}

// $text on one line: a carriage return or a newline is written out, so a FAIL line stays one
fn one_line($text) {
    return replace(replace($text, "\r", "\\r"), "\n", "\\n");
}

// $text on one line and at most SHOWN_BYTES long, saying how long it was when cut
fn clipped($text) {
    $line = one_line($text);
    if (len($line) <= SHOWN_BYTES) {
        return $line;
    }

    return slice($line, 0, SHOWN_BYTES) .. "... (" .. len($line) .. " bytes)";
}

// What throws() was asked for, as its FAIL line names it
fn described_error($kind, $message) {
    if ($kind == null) {
        return $message == null ? "an error" : clipped(quote($message));
    }
    if ($message == null) {
        return kind_name($kind);
    }

    return kind_name($kind) .. " " .. clipped(quote($message));
}

// What was thrown, as throws()'s FAIL line names it: an Error by its kind and message
fn described_thrown($thrown) {
    if (is_error($thrown)) {
        return kind_name($thrown) .. " " .. clipped(quote($thrown.message));
    }

    return described($thrown);
}

// What $thunk threw, as a list of one, or an empty list when it returned
fn thrown_by($thunk) {
    try {
        $thunk();
    } catch ($e) {
        return [$e];
    }

    return [];
}

fn is_error($value) {
    return type_of($value) == "object" && is_a($value, Error);
}

// Whether $thrown is exactly of $kind, or anything when no kind was asked for
fn is_kind($thrown, $kind) {
    if ($kind == null) {
        return true;
    }

    return type_of($thrown) == "object" && kind_of($thrown) == $kind;
}

// Whether $thrown carries $message: an Error's message, or any other value itself
fn has_message($thrown, $message) {
    if ($message == null) {
        return true;
    }
    $carried = is_error($thrown) ? $thrown.message : $thrown;

    return $carried == $message && type_of($carried) == type_of($message);
}

// Whether $flag is one of this process's own arguments
fn has_flag($flag) {
    return in_array($flag, args());
}

// The calling test file's own path, which gaz test passes as args()[0]
fn own_path() {
    $given = args();
    if (len($given) == 0) {
        throw "test::snapshot needs the test file's own path; run it with gaz test, not gaz directly";
    }

    return $given[0];
}

// Where $label's snapshot for the calling test file lives: next to it, named after it and the label
fn snapshot_path($label) {
    $path = own_path();
    $parts = split($path, "/");
    $dir = len($parts) > 1 ? join(slice($parts, 0, len($parts) - 1), "/") : ".";
    $name = last($parts);
    if (ends_with($name, ".gaz")) {
        $name = slice($name, 0, len($name) - 4);
    }

    return "{$dir}/{$name}.{$label}.snap";
}

