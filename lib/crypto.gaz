/*
 * Cryptography for GazLang programs, on the builtins random_bytes(), sha256(), hmac_sha256(),
 * pbkdf2_sha256(), scrypt() and argon2id():
 *   crypto::hash_password($password, $options)   a string to store, naming its algorithm,
 *   crypto::verify_password($password, $stored)  parameters and salt, and checking one
 *   crypto::needs_rehash($stored, $options)      whether it was made with other settings
 *   crypto::token($bytes)                        a random, URL-safe string
 *   crypto::sign($value, $secret), unsign($signed, $secret)   tamper-evident values (cookies)
 *   crypto::equals($a, $b)                       comparing secrets without leaking where they differ
 *   crypto::hex(), from_hex(), base64(), from_base64(), base64url(), from_base64url()
 */
namespace crypto;

include "text.gaz" use quote;

const SALT_BYTES = 16;
const HASH_BYTES = 32;
const TOKEN_BYTES = 32;

/*
 * The algorithms hash_password() can use, each with its parameters in the order the stored
 * string writes them, and the defaults:
 *   argon2id       m memory in KiB, t passes, p lanes: RFC 9106's second recommendation (64 MiB)
 *   scrypt         ln log2 of the cost N, r block size, p parallelism: 2 ** 17, 8, 1 (128 MiB)
 *   pbkdf2-sha256  i iterations: 600000
 */
const DEFAULT_ALGORITHM = "argon2id";
const ALGORITHMS = {
    "argon2id" => {"m" => 65536, "t" => 3, "p" => 4},
    "scrypt" => {"ln" => 17, "r" => 8, "p" => 1},
    "pbkdf2-sha256" => {"i" => 600000},
};
const ARGON2_VERSION = 19;
const MOST_SCRYPT_LN = 62;
const SEPARATOR = '$';

/*
 * The most a stored string may ask verify_password() for, unless its $limits raise it: each
 * parameter up to about four times its default. A stored string can come from anywhere a
 * database row can, and without these one could ask for 4 GiB and 2^32 passes; with them the
 * worst is 512 MiB (scrypt) and about sixteen times a default's work.
 */
const LIMITS = {
    "argon2id" => {"m" => 262144, "t" => 12, "p" => 16},
    "scrypt" => {"ln" => 18, "r" => 16, "p" => 4},
    "pbkdf2-sha256" => {"i" => 2400000},
};
/* What a stored string's salt and hash must be to be read at all: a hash of a byte or two would
   match a wrong password one time in a few hundred */
const MIN_SALT_BYTES = 8;
const MIN_HASH_BYTES = 16;
const MOST_HASH_BYTES = 64;
/* Argon2id needs 8 KiB of memory per lane, and scrypt a cost below 2 ** (16 * block size) */
const ARGON2_MEMORY_PER_LANE = 8;
const SCRYPT_LN_PER_BLOCK_SIZE = 16;

const HEX_DIGITS = "0123456789abcdef";
const BASE64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const BASE64URL = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

/* ---- Passwords --------------------------------------------------------------------------- */

/*
 * A password as a string to store, in the PHC string format: the algorithm, its parameters, a
 * random salt and the hash, the last two in base64 without padding:
 *   $argon2id$v=19$m=65536,t=3,p=4$<salt>$<hash>
 *   $scrypt$ln=17,r=8,p=1$<salt>$<hash>
 *   $pbkdf2-sha256$i=600000$<salt>$<hash>
 * $options picks the algorithm ("algorithm" => "scrypt") and any of its parameters ("ln" => 15);
 * the rest are the defaults above.
 */
pub fn hash_password(string $password, map $options = {}): string {
    $settings = Settings::from_options($options);
    $salt = random_bytes(SALT_BYTES);
    $hash = $settings.derive($password, $salt, HASH_BYTES);
    return $settings.header() .. SEPARATOR .. encode64($salt, BASE64, false) .. SEPARATOR .. encode64($hash, BASE64, false);
}

/*
 * Whether $password is the one hash_password() made $stored from. A $stored this can't read,
 * or that asks for more than LIMITS allow, is false, as a wrong password is: it may be damaged,
 * or planted to make each login cost gigabytes and hours. $limits raises or lowers LIMITS for
 * the algorithms it names ({"argon2id" => {"m" => 1048576}}).
 */
pub fn verify_password(string $password, string $stored, map $limits = {}): bool {
    $parsed = Stored::read($stored, limits_with($limits));
    if ($parsed == null) {
        return false;
    }
    $hash = $parsed.settings.derive($password, $parsed.salt, len($parsed.hash));
    return equals($hash, $parsed.hash);
}

/*
 * Whether $stored was made with other settings than $options give, so that a program can hash
 * the password again, with what it now uses, once a login has shown it. A $stored this can't
 * read needs it too: true. LIMITS don't apply, since they are verify_password()'s.
 */
pub fn needs_rehash(string $stored, map $options = {}): bool {
    $parsed = Stored::read($stored, null);
    return $parsed == null || $parsed.settings.header() != Settings::from_options($options).header();
}

/* LIMITS with what $limits changes; a name that isn't an algorithm or parameter is the
   program's mistake, and an error */
fn limits_with($limits) {
    $all = LIMITS;
    foreach ($limits as $algorithm => $caps) {
        if (!has_key($all, $algorithm)) {
            throw "crypto: unknown algorithm " .. quote($algorithm) .. " in the limits, expected argon2id, scrypt or pbkdf2-sha256";
        }
        foreach ($caps as $name => $value) {
            if (!has_key($all[$algorithm], $name) || type_of($value) != "int") {
                throw "crypto: {$algorithm}'s limits are ints for " .. join(keys($all[$algorithm]), ", ") .. ", got " .. quote($name) .. " => " .. quote($value);
            }
            $all[$algorithm][$name] = $value;
        }
    }
    return $all;
}

/* An algorithm and its parameters, in the order the stored string writes them */
kind Settings {
    fn _(pub #algorithm, pub #params);

    pub static fn from_options($options) {
        $algorithm = $options["algorithm"] ?? DEFAULT_ALGORITHM;
        $params = ALGORITHMS[$algorithm] ?? throw "crypto: unknown algorithm " .. quote($algorithm) .. ", expected argon2id, scrypt or pbkdf2-sha256";
        foreach ($options as $name => $value) {
            if ($name == "algorithm") {
                continue;
            }
            if (!has_key($params, $name)) {
                throw "crypto: {$algorithm} has no parameter " .. quote($name) .. ", expected " .. join(keys($params), ", ");
            }
            if (type_of($value) != "int") {
                throw "crypto: {$algorithm}'s {$name} must be an int, got " .. type_of($value);
            }
            $params[$name] = $value;
        }
        return Settings($algorithm, $params);
    }

    /* "$argon2id$v=19$m=65536,t=3,p=4": everything the stored string says before the salt */
    pub fn header() {
        $pairs = [];
        foreach (#params as $name => $value) {
            $pairs[] = "{$name}={$value}";
        }
        $version = #algorithm == "argon2id" ? SEPARATOR .. "v=" .. ARGON2_VERSION : "";
        return SEPARATOR .. #algorithm .. $version .. SEPARATOR .. join($pairs, ",");
    }

    /* Whether every parameter is from 1 to its limit, and they fit together */
    pub fn within($limits) {
        foreach (#params as $name => $value) {
            if ($value < 1 || $value > $limits[$name]) {
                return false;
            }
        }
        return match (#algorithm) {
            "argon2id" => #params["m"] >= ARGON2_MEMORY_PER_LANE * #params["p"],
            "scrypt" => #params["ln"] < SCRYPT_LN_PER_BLOCK_SIZE * #params["r"],
            default => true,
        };
    }

    pub fn derive($password, $salt, $length) {
        return match (#algorithm) {
            "argon2id" => argon2id($password, $salt, #params["t"], #params["m"], #params["p"], $length),
            "scrypt" => scrypt($password, $salt, #scrypt_cost(), #params["r"], #params["p"], $length),
            "pbkdf2-sha256" => pbkdf2_sha256($password, $salt, #params["i"], $length),
        };
    }

    fn scrypt_cost() {
        $ln = #params["ln"];
        if ($ln < 1 || $ln > MOST_SCRYPT_LN) {
            throw "crypto: scrypt's ln must be from 1 to " .. MOST_SCRYPT_LN .. ", got {$ln}";
        }
        return 1 << $ln;
    }
}

/* A stored string taken apart */
kind Stored {
    fn _(pub #settings, pub #salt, pub #hash);

    /* The parts of $stored, or null if it isn't one hash_password() could have written, its salt
       or hash is too short or long, or (unless $limits is null) it asks for more than they allow */
    pub static fn read($stored, $limits) {
        $parts = split($stored, SEPARATOR);
        $algorithm = $parts[1] ?? "";
        if ($parts[0] != "" || !has_key(ALGORITHMS, $algorithm)) {
            return null;
        }
        if ($algorithm == "argon2id") {
            if (len($parts) != 6 || $parts[2] != "v=" .. ARGON2_VERSION) {
                return null;
            }
            delete $parts[2];
        }
        if (len($parts) != 5) {
            return null;
        }
        $params = Stored::params($parts[2], keys(ALGORITHMS[$algorithm]));
        $salt = Stored::decode($parts[3]);
        $hash = Stored::decode($parts[4]);
        if ($params == null || $salt == null || $hash == null) {
            return null;
        }
        $settings = Settings($algorithm, $params);
        if ($limits != null && !$settings.within($limits[$algorithm])) {
            return null;
        }
        if (len($salt) < MIN_SALT_BYTES || len($hash) < MIN_HASH_BYTES || len($hash) > MOST_HASH_BYTES) {
            return null;
        }
        return Stored($settings, $salt, $hash);
    }

    /* "m=65536,t=3,p=4": each parameter the algorithm has, in its order, as a plain decimal int */
    static fn params($text, $names) {
        $pairs = split($text, ",");
        if (len($pairs) != len($names)) {
            return null;
        }
        $params = {};
        foreach ($names as $i => $name) {
            $value = Stored::param($pairs[$i], $name);
            if ($value == null) {
                return null;
            }
            $params[$name] = $value;
        }
        return $params;
    }

    static fn param($pair, $name) {
        $sides = split($pair, "=", 2);
        if (len($sides) != 2 || $sides[0] != $name) {
            return null;
        }
        $number = to_int($sides[1], null);
        if ($number == null || to_string($number) != $sides[1]) {
            return null;
        }
        return $number;
    }

    static fn decode($text) {
        try {
            return decode64($text, BASE64, false, "base64");
        } catch (Error $e) {
            return null;
        }
    }
}

/* ---- Tokens and comparing -------------------------------------------------------------- */

/* A random string for a session, a reset link or a CSRF token: $bytes random bytes (32, 256
   bits, by default) in base64url, so it goes in a URL or a cookie as it is. Fewer than one byte
   is an error: an empty token would match every empty one. */
pub fn token(int $bytes = TOKEN_BYTES): string {
    if ($bytes < 1) {
        throw "crypto::token() expects 1 byte or more, got {$bytes}";
    }
    return base64url(random_bytes($bytes));
}

/*
 * $value with an HMAC of itself appended, so a caller can hand it to something untrusted (a
 * cookie, a URL) and tell whether it comes back unchanged: crypto::unsign() recovers $value if
 * the MAC still checks out, or null if it doesn't (or the text isn't one sign() made at all).
 * $secret is the caller's: generate one with crypto::random_bytes() and hold it (config, an
 * environment variable), since a secret this made up itself couldn't be checked between runs.
 * The MAC is base64url, so the result is a cookie value or a URL segment as it is; the separator
 * is a dot, which base64url never contains, so unsign() can always find the last one, whatever
 * $value holds.
 */
const SIGNATURE_SEPARATOR = ".";

pub fn sign(string $value, string $secret): string {
    return $value .. SIGNATURE_SEPARATOR .. base64url(hmac_sha256($value, $secret));
}

pub fn unsign(string $signed, string $secret): ?string {
    $from_end = index_of(reverse($signed), SIGNATURE_SEPARATOR);
    if ($from_end == null) {
        return null;
    }
    $at = len($signed) - 1 - $from_end;
    $value = slice($signed, 0, $at);
    $mac = slice($signed, $at + 1);
    if (!equals(base64url(hmac_sha256($value, $secret)), $mac)) {
        return null;
    }
    return $value;
}

/*
 * Whether two strings are the same, in a time that tells nothing about where they differ.
 * Comparing byte by byte stops at the first difference, so how long a wrong guess takes says
 * how much of it was right, and a secret can be found a byte at a time. Here each is run through
 * HMAC under a key drawn for this call and the MACs are compared: where those differ is a place
 * nobody can predict or steer. The time still depends on the two lengths.
 * ponytail: HMAC's time grows with its input, so how long this takes says how long $a and $b
 * are (not where they differ); an equals builtin in C that reads a fixed maximum length whatever
 * the strings' own would lift it, for secrets under that size.
 */
pub fn equals(string $a, string $b): bool {
    $key = random_bytes(HASH_BYTES);
    return hmac_sha256($a, $key) == hmac_sha256($b, $key);
}

/* ---- Hex and base64 -------------------------------------------------------------------- */

/*
 * Bytes as lowercase hex, two digits each: sha256("") |> crypto::hex starts "e3b0c442".
 * ponytail: each byte goes through $bytes[$i], and a one-byte string is made the first time its
 * value is seen in the program, so how long this takes can hint which byte values a secret
 * holds (the effect equals() avoids); a hex encoder in C would lift it.
 */
pub fn hex(string $bytes): string {
    $text = "";
    for ($i = 0; $i < len($bytes); $i++) {
        $byte = ord($bytes[$i]);
        $text ..= HEX_DIGITS[$byte >> 4] .. HEX_DIGITS[$byte & 15];
    }
    return $text;
}

/* The bytes hex digits (either case) stand for; an odd count or another character is an error */
pub fn from_hex(string $text): string {
    if (len($text) % 2 != 0) {
        throw "crypto::from_hex() expects an even number of digits, got " .. len($text);
    }
    $bytes = "";
    for ($i = 0; $i < len($text); $i += 2) {
        $bytes ..= chr(hex_digit($text, $i) * 16 + hex_digit($text, $i + 1));
    }
    return $bytes;
}

/* ponytail: index_of() finds a digit by scanning, so its time says which digit it was, and the
   one-byte string of each character is made the first time it is seen; a decoder in C with a
   table lookup would lift both */
fn hex_digit($text, $at) {
    return index_of(HEX_DIGITS, lower($text[$at]))
        ?? throw "crypto::from_hex() expects hex digits, got " .. quote($text[$at]) .. " at {$at}";
}

/* Base64 (RFC 4648, section 4), padded with = to a multiple of 4 characters */
pub fn base64(string $bytes): string {
    return encode64($bytes, BASE64, true);
}

/* The bytes of padded base64; anything else (a missing =, another character, bits left over
   that aren't zero) is an error, so a value has only one spelling */
pub fn from_base64(string $text): string {
    return decode64($text, BASE64, true, "base64");
}

/* Base64url (RFC 4648, section 5): - and _ for + and /, and no padding, so it needs no
   escaping in a URL, a file name or a cookie */
pub fn base64url(string $bytes): string {
    return encode64($bytes, BASE64URL, false);
}

pub fn from_base64url(string $text): string {
    return decode64($text, BASE64URL, false, "base64url");
}

/*
 * Each 3 bytes as 4 characters of 6 bits; 1 or 2 bytes left over as 2 or 3 characters, and =
 * to fill the 4 when padding.
 * ponytail: the alphabet is indexed by secret bits, and $alphabet[$i] makes each one-byte string
 * the first time it is seen, a timing hint about the bytes (as in hex()); an encoder in C would
 * lift it.
 */
fn encode64($bytes, $alphabet, $pad) {
    $text = "";
    for ($i = 0; $i < len($bytes); $i += 3) {
        $group = slice($bytes, $i, 3);
        $bits = group_bits($group);
        $characters = len($group) + 1;
        for ($k = 0; $k < $characters; $k++) {
            $text ..= $alphabet[($bits >> (18 - 6 * $k)) & 63];
        }
        if ($pad) {
            $text ..= repeat("=", 4 - $characters);
        }
    }
    return $text;
}

/* Up to 3 bytes as 24 bits, the first byte highest and missing ones zero.
   ponytail: $group[$k] goes through one-byte-string creation, as hex() does; C would lift it */
fn group_bits($group) {
    $bits = 0;
    for ($k = 0; $k < 3; $k++) {
        $byte = $k < len($group) ? ord($group[$k]) : 0;
        $bits = ($bits << 8) | $byte;
    }
    return $bits;
}

/* ponytail: the characters are secret too when a key is decoded, and sextet()'s index_of() and
   one-byte strings leak timing as hex_digit()'s do; a decoder in C would lift it */
fn decode64($text, $alphabet, $padded, $name) {
    $body = $padded ? unpad($text, $name) : $text;
    if (len($body) % 4 == 1) {
        throw "crypto::from_{$name}() can't end with a single character";
    }
    $bytes = "";
    for ($i = 0; $i < len($body); $i += 4) {
        $bytes ..= decode_group($body, $i, $alphabet, $name);
    }
    return $bytes;
}

/* Padded text without its = signs: at most two, at the end of a multiple of 4 characters */
fn unpad($text, $name) {
    if (len($text) % 4 != 0) {
        throw "crypto::from_{$name}() expects a multiple of 4 characters, got " .. len($text);
    }
    $end = len($text);
    while ($end > 0 && len($text) - $end < 2 && $text[$end - 1] == "=") {
        $end--;
    }
    return slice($text, 0, $end);
}

/* 2 to 4 characters from $at as 1 to 3 bytes; the bits a short group has over must be zero */
fn decode_group($body, $at, $alphabet, $name) {
    $characters = min(4, len($body) - $at);
    $bits = 0;
    for ($k = 0; $k < 4; $k++) {
        $value = $k < $characters ? sextet($body, $at + $k, $alphabet, $name) : 0;
        $bits = ($bits << 6) | $value;
    }
    $count = $characters - 1;
    if (($bits & ((1 << (8 * (3 - $count))) - 1)) != 0) {
        throw "crypto::from_{$name}() expects the bits after the last byte to be zero";
    }
    $bytes = "";
    for ($k = 0; $k < $count; $k++) {
        $bytes ..= chr(($bits >> (16 - 8 * $k)) & 255);
    }
    return $bytes;
}

/* ponytail: index_of() scans the alphabet, so its time says which character it was; a table
   lookup in C would lift it */
fn sextet($body, $at, $alphabet, $name) {
    return index_of($alphabet, $body[$at])
        ?? throw "crypto::from_{$name}() expects {$name} characters, got " .. quote($body[$at]) .. " at {$at}";
}
