    [0x1ffffee, 25], [0x1ffffef, 25], [0xfffff4, 24], [0xfffff5, 24], [0x3ffffea, 26], [0x7ffff4, 23],
    [0x3ffffeb, 26], [0x7ffffe6, 27], [0x3ffffec, 26], [0x3ffffed, 26], [0x7ffffe7, 27], [0x7ffffe8, 27],
    [0x7ffffe9, 27], [0x7ffffea, 27], [0x7ffffeb, 27], [0xffffffe, 28], [0x7ffffec, 27], [0x7ffffed, 27],
    [0x7ffffee, 27], [0x7ffffef, 27], [0x7fffff0, 27], [0x3ffffee, 26], [0x3fffffff, 30],
];

/**
 * What a peer did wrong, as HTTP/2 names it: the code a GOAWAY says (`#code`, PROTOCOL_ERROR and
 * the rest), and why, for a log
 */
pub kind ConnectionError extends Error {
    /**
     * An error to end a connection with: the code its GOAWAY says, and the message
     */
    fn _(pub int #code, string $message) {
        ##_($message);
    }
}

/**
 * A frame: its type (DATA, HEADERS, ...), flags, stream (0 for the connection) and payload
 */
pub kind Frame {
    /**
     * A frame of $type, with $flags, on $stream (0 for the connection), carrying $payload
     */
    fn _(pub int #type, pub int #flags, pub int #stream, pub string #payload);

    /**
     * Whether a flag (END_STREAM, END_HEADERS, ...) is set
     */
    pub fn has(int $flag): bool {
        return (#flags & $flag) != 0;
    }
}

/**
 * A frame's bytes: its head (the payload's length, the type, the flags and the stream) and its payload
 */
pub fn frame(int $type, int $flags, int $stream, string $payload = ""): string {
    return u24(len($payload)) .. chr($type) .. chr($flags) .. u32($stream) .. $payload;
}

/**
 * $n as four bytes, most significant first, as HTTP/2 writes a stream, a window or a setting's value
 */
pub fn u32(int $n): string {
    return chr(($n >> 24) & 255) .. chr(($n >> 16) & 255) .. chr(($n >> 8) & 255) .. chr($n & 255);
}

/**
 * The number in four bytes of $bytes from $at, most significant first
 */
pub fn read_u32(string $bytes, int $at = 0): int {
    return (ord($bytes[$at]) << 24) | (ord($bytes[$at + 1]) << 16) | (ord($bytes[$at + 2]) << 8) | ord($bytes[$at + 3]);
}

fn u24($n) {
    return chr(($n >> 16) & 255) .. chr(($n >> 8) & 255) .. chr($n & 255);
}

/**
 * A SETTINGS frame's payload: each setting (HEADER_TABLE_SIZE, ...) and its value, as a map of
 * them read back by `settings()`
 */
pub fn settings_payload(map $settings): string {
    $payload = "";
    foreach ($settings as $id => $value) {
        $payload ..= chr(($id >> 8) & 255) .. chr($id & 255) .. u32($value);
    }
    return $payload;
}

/**
 * A SETTINGS frame's payload as a list of [setting, value], in the order sent, as a later one of
 * a setting overrides an earlier one
 */
pub fn settings(string $payload): list {
    if (len($payload) % 6 != 0) {
        throw ConnectionError(FRAME_SIZE_ERROR, "a SETTINGS frame of " .. len($payload) .. " bytes, not a multiple of 6");
    }
    $found = [];
    for ($at = 0; $at < len($payload); $at += 6) {
        $found[] = [(ord($payload[$at]) << 8) | ord($payload[$at + 1]), read_u32($payload, $at + 2)];
    }
    return $found;
}

/**
 * Reads frames from a socket: whole ones, each at most `$most` bytes of payload (the
 * MAX_FRAME_SIZE this end said it takes); anything longer is a FRAME_SIZE_ERROR
 */
pub kind FrameReader {
    /**
     * Frames read from $socket, each at most $most bytes of payload; $data is what was read of
     * the connection already, which comes first
     */
    fn _(#socket, #most = DEFAULT_FRAME_SIZE, #data = "");

    /**
     * Whether a whole frame has been read already, so next() gives it without reading
     */
    pub fn buffered(): bool {
        if (len(#data) < FRAME_HEAD) {
            return false;
        }
        return len(#data) >= FRAME_HEAD + #length();
    }

    /**
     * Whether part of a frame, or anything at all, has been read but not given yet
     */
    pub fn pending(): bool {
        return #data != "";
    }

    /**
     * The next frame, read within $seconds (the socket's own timeout when null): null if the
     * connection ends between frames, false if $seconds passed first; a connection that ends in
     * the middle of one is a PROTOCOL_ERROR
     */
    pub fn next($seconds = null) {
        $deadline = $seconds == null ? null : monotonic_time() + $seconds;
        while (!#buffered()) {
            if (len(#data) >= FRAME_HEAD && #length() > #most) {
                throw ConnectionError(FRAME_SIZE_ERROR, "a frame of " .. #length() .. " bytes, past the " .. #most .. " this end takes");
            }
            $left = $deadline == null ? null : $deadline - monotonic_time();
            if ($left != null && $left <= 0) {
                return false;
            }
            $chunk = #read($left);
            if ($chunk == null) {
                return false;
            }
            if ($chunk == "") {
                if (#data == "") {
                    return null;
                }
                throw ConnectionError(PROTOCOL_ERROR, "the connection closed in the middle of a frame");
            }
            #data ..= $chunk;
        }
        $length = #length();
        if ($length > #most) {
            throw ConnectionError(FRAME_SIZE_ERROR, "a frame of $length bytes, past the " .. #most .. " this end takes");
        }
        $head = slice(#data, 0, FRAME_HEAD);
        $payload = slice(#data, FRAME_HEAD, $length);
        #data = slice(#data, FRAME_HEAD + $length);
        // The stream's top bit is reserved, and ignored
        return Frame(ord($head[3]), ord($head[4]), read_u32($head, 5) & MAX_WINDOW, $payload);
    }

    /**
     * Exactly $n bytes, within $seconds: the client's preface comes before any frame. Null if the
     * connection ends first, false if the time runs out.
     */
    pub fn bytes(int $n, $seconds) {
        $deadline = monotonic_time() + $seconds;
        while (len(#data) < $n) {
            $left = $deadline - monotonic_time();
            $chunk = $left > 0 ? #read($left) : null;
            if ($chunk == null) {
                return false;
            }
            if ($chunk == "") {
                return null;
            }
            #data ..= $chunk;
        }
        $taken = slice(#data, 0, $n);
        #data = slice(#data, $n);
        return $taken;
    }

    fn length() {
        return (ord(#data[0]) << 16) | (ord(#data[1]) << 8) | ord(#data[2]);
    }

    /*
     * What has arrived, within $seconds (the socket's own timeout when null): null if they pass,
     * "" at the end. A read that fails (a reset, TLS ended without its goodbye) is an end too:
     * nothing more can come on the connection either way.
     */
    fn read($seconds) {
        try {
            return $seconds == null ? socket_read(#socket) : socket_read(#socket, $seconds);
        } catch (Error $e) {
            return "";
        }
    }
}

/**
 * A frame's payload without its padding (a PADDED DATA or HEADERS frame: its length first, then
 * that many bytes at the end), or a PROTOCOL_ERROR when the padding is longer than the frame
 */
pub fn unpadded(Frame $frame): string {
    if (!$frame.has(PADDED)) {
        return $frame.payload;
    }
    $payload = $frame.payload;
    if ($payload == "" || ord($payload[0]) >= len($payload)) {
        throw ConnectionError(PROTOCOL_ERROR, "a frame's padding is longer than the frame");
    }
    return slice($payload, 1, len($payload) - 1 - ord($payload[0]));
}

/**
 * Decodes the header blocks of one connection (RFC 7541): its dynamic table is the connection's,
 * filled by one block and read by the next, so a block is decoded in the order it was sent.
 * What can't be decoded is a COMPRESSION_ERROR, which ends the connection.
 */
pub kind Decoder {
    #table = [];      // the dynamic table, newest first: [name, value]
    #size = 0;        // what its entries cost, as RFC 7541 §4.1 counts it
    #max_size = DEFAULT_TABLE_SIZE;

    /**
     * $limit is the most the table may hold: the HEADER_TABLE_SIZE this end said it takes, which
     * is also its size until the peer's encoder says a smaller one. $list_most, when given, is the
     * most a block's decoded fields may cost as RFC 9113 §6.5.2 counts them (MAX_HEADER_LIST_SIZE):
     * past it is an error, so a small block of references to one big entry can't decode to megabytes
     */
    fn _(#limit = DEFAULT_TABLE_SIZE, #list_most = null) {
        #max_size = #limit;
    }

    /**
     * A header block as a list of [name, value], in order
     */
    pub fn decode(string $block): list {
        $fields = [];
        $at = 0;
        $first = true;
        $listed = 0;
        while ($at < len($block)) {
            $byte = ord($block[$at]);
            if ($byte >= 128) {
                // An indexed field: 1xxxxxxx
                [$index, $at] = integer($block, $at, 7);
                $field = #entry($index);
                $fields[] = $field;
            } else if ($byte >= 64) {
                // A literal to add to the table: 01xxxxxx
                [$field, $at] = #literal($block, $at, 6);
                $fields[] = $field;
                #add($field);
            } else if ($byte >= 32) {
                // A table size update: 001xxxxx, only before the first field
                [$size, $at] = integer($block, $at, 5);
                if (!$first) {
                    throw ConnectionError(COMPRESSION_ERROR, "a table size update after a header field");
                }
                if ($size > #limit) {
                    throw ConnectionError(COMPRESSION_ERROR, "a table size of $size, past the " .. #limit .. " allowed");
                }
                #max_size = $size;
                #evict($size);
                continue;
            } else {
                // A literal not to add, 0000xxxx, or never to add, 0001xxxx: the same here
                [$field, $at] = #literal($block, $at, 4);
                $fields[] = $field;
            }
            $first = false;
            $listed += len($field[0]) + len($field[1]) + ENTRY_OVERHEAD;
            if (#list_most != null && $listed > #list_most) {
                throw ConnectionError(COMPRESSION_ERROR, "a header list of more than " .. #list_most .. " bytes");
            }
        }
        return $fields;
    }

    fn entry($index) {
        if ($index == 0) {
            throw ConnectionError(COMPRESSION_ERROR, "a header field indexed 0");
        }
        if ($index <= len(STATIC_TABLE)) {
            return STATIC_TABLE[$index - 1];
        }
        $dynamic = $index - len(STATIC_TABLE) - 1;
        if ($dynamic >= len(#table)) {
            throw ConnectionError(COMPRESSION_ERROR, "a header field indexed $index, past the table");
        }
        return #table[$dynamic];
    }

    // A literal field from $at, its name indexed in a $prefix-bit integer (0 for a name that follows): [[name, value], where it ends]
    fn literal($block, $at, $prefix) {
        [$index, $at] = integer($block, $at, $prefix);
        if ($index == 0) {
            [$name, $at] = text($block, $at);
        } else {
            $name = #entry($index)[0];
        }
        [$value, $at] = text($block, $at);
        return [[$name, $value], $at];
    }

    fn add($field) {
        $cost = len($field[0]) + len($field[1]) + ENTRY_OVERHEAD;
        // One bigger than the table empties it, and is not added (RFC 7541 §4.4)
        #evict(max(#max_size - $cost, 0));
        if ($cost <= #max_size) {
            #table = [$field, ...#table];
            #size += $cost;
        }
    }

    // Oldest entries out until what is left costs at most $room
    fn evict($room) {
        while (#size > $room) {
            [...#table, $oldest] = #table;
            #size -= len($oldest[0]) + len($oldest[1]) + ENTRY_OVERHEAD;
        }
    }
}

/*
 * An integer of RFC 7541 §5.1 from $at, in the byte's low $prefix bits and, when those are all
 * set, the bytes after it 7 bits at a time: [the integer, where it ends]. Past 2^31 is refused:
 * nothing in a header block is that big, and a peer could otherwise send bytes without end. So
 * are more bytes than 2^31 needs, which could otherwise add nothing but zeros past any shift.
 */
fn integer($block, $at, $prefix) {
    $most = (1 << $prefix) - 1;
    $n = ord($block[$at]) & $most;
    $at++;
    if ($n < $most) {
        return [$n, $at];
    }
    $shift = 0;
    while (true) {
        if ($at >= len($block)) {
            throw ConnectionError(COMPRESSION_ERROR, "a header block ends in the middle of an integer");
        }
        $byte = ord($block[$at]);
        $at++;
        $n += ($byte & 127) << $shift;
        if ($n > MAX_WINDOW) {
            throw ConnectionError(COMPRESSION_ERROR, "an integer past 2^31 in a header block");
        }
        if ($byte < 128) {
            return [$n, $at];
        }
        $shift += 7;
        if ($shift > INTEGER_SHIFT_MOST) {
            throw ConnectionError(COMPRESSION_ERROR, "an integer past 2^31 in a header block");
        }
    }
}

// A string of RFC 7541 §5.2 from $at, Huffman-coded or as it is: [the string, where it ends]
fn text($block, $at) {
    if ($at >= len($block)) {
        throw ConnectionError(COMPRESSION_ERROR, "a header block ends before a string");
    }
    $coded = ord($block[$at]) >= 128;
    [$length, $at] = integer($block, $at, 7);
    if ($at + $length > len($block)) {
        throw ConnectionError(COMPRESSION_ERROR, "a header block ends in the middle of a string");
    }
    $bytes = slice($block, $at, $length);
    return [$coded ? Huffman::decode($bytes) : $bytes, $at + $length];
}

/**
 * A header list as a block: each [name, value] as a literal not added to a table, its name by the
 * static table's index where it has one, nothing Huffman-coded. So the peer's table is never used,
 * and no setting of its can make a block wrong. A `:status` the static table has whole is its index.
 */
pub fn encode(list $fields): string {
    $block = "";
    foreach ($fields as [$name, $value]) {
        $whole = StaticTable::whole_index($name, $value);
        if ($whole != null) {
            $block ..= encoded_integer($whole, 7, 128);
            continue;
        }
        $index = StaticTable::name_index($name);
        if ($index == null) {
            $block ..= chr(0) .. encoded_text($name);
        } else {
            $block ..= encoded_integer($index, 4, 0);
        }
        $block ..= encoded_text($value);
    }
    return $block;
}

/**
 * $n as an integer of RFC 7541 §5.1 in a byte's low $prefix bits, the byte's high bits being $high
 */
pub fn encoded_integer(int $n, int $prefix, int $high = 0): string {
    $most = (1 << $prefix) - 1;
    if ($n < $most) {
        return chr($high | $n);
    }
    $bytes = chr($high | $most);
    $n -= $most;
    while ($n >= 128) {
        $bytes ..= chr(($n & 127) | 128);
        $n = $n >> 7;
    }
    return $bytes .. chr($n);
}

fn encoded_text($text) {
    return encoded_integer(len($text), 7) .. $text;
}

/*
 * RFC 7541's Huffman code decoded a nibble at a time: a table of
 * what four bits do from each place in the code's tree (where they lead, the bytes they finish,
 * whether they reach EOS, which no string may hold), made once from HUFFMAN when first needed.
 * A place is an internal node of the tree; a string may end only at the root or in fewer than 8
 * bits of 1s, a prefix of EOS (RFC 7541 §5.2).
 */
kind Huffman {
    static #steps = null;       // [node * 16 + nibble] => [next node, bytes finished, EOS reached]
    static #ends = null;        // [node] => whether a string may end there

    pub static fn decode($bytes) {
        if (Huffman::steps == null) {
            Huffman::build();
        }
        $node = 0;
        $out = [];
        foreach (split($bytes, "") as $c) {
            $byte = ord($c);
            foreach ([$byte >> 4, $byte & 15] as $nibble) {
                [$node, $finished, $eos] = Huffman::steps[$node * 16 + $nibble];
                if ($eos) {
                    throw ConnectionError(COMPRESSION_ERROR, "a Huffman-coded string holds EOS");
                }
                if ($finished != "") {
                    $out[] = $finished;
                }
            }
        }
        if (!Huffman::ends[$node]) {
            throw ConnectionError(COMPRESSION_ERROR, "a Huffman-coded string ends in the middle of a code");
        }
        return join($out, "");
    }

    // The tree, then each node's four-bit steps
    static fn build() {
        // A node is [child for 0, child for 1]: an int is another node, a string a byte, "EOS" EOS
        $nodes = [[null, null]];
        $depths = [0];
        $ones = [true];
        foreach (HUFFMAN as $symbol => [$code, $length]) {
            $node = 0;
            for ($bit = $length - 1; $bit >= 0; $bit--) {
                $b = ($code >> $bit) & 1;
                if ($bit == 0) {
                    $nodes[$node][$b] = $symbol == 256 ? "EOS" : chr($symbol);
                    continue;
                }
                if ($nodes[$node][$b] == null) {
                    $nodes[] = [null, null];
                    $depths[] = $depths[$node] + 1;
                    $ones[] = $ones[$node] && $b == 1;
                    $nodes[$node][$b] = len($nodes) - 1;
                }
                $node = $nodes[$node][$b];
            }
        }
        $steps = [];
        foreach ($nodes as $start => $children) {
            for ($nibble = 0; $nibble < 16; $nibble++) {
                $steps[] = Huffman::step($nodes, $start, $nibble);
            }
        }
        $ends = [];
        foreach ($nodes as $node => $children) {
            $ends[] = $node == 0 || ($ones[$node] && $depths[$node] < 8);
        }
        Huffman::steps = $steps;
        Huffman::ends = $ends;
    }

    static fn step($nodes, $node, $nibble) {
        $finished = "";
        for ($bit = 3; $bit >= 0; $bit--) {
            $next = $nodes[$node][($nibble >> $bit) & 1];
            if ($next == "EOS") {
                return [0, $finished, true];
            }
            if (type_of($next) == "string") {
                $finished ..= $next;
                $node = 0;
            } else {
                $node = $next;
            }
        }
        return [$node, $finished, false];
    }
}

// RFC 7541's static table by name, for the encoder: made once from STATIC_TABLE when first needed
kind StaticTable {
    static #names = null;       // a field's name => its first index
    static #wholes = null;      // "name\0value" => its index, for a field the table has whole

    pub static fn name_index($name) {
        StaticTable::index_tables();
        return StaticTable::names[$name] ?? null;
    }

    pub static fn whole_index($name, $value) {
        StaticTable::index_tables();
        return StaticTable::wholes[$name .. "\0" .. $value] ?? null;
    }

    static fn index_tables() {
        if (StaticTable::names != null) {
            return;
        }
        $names = {};
        $wholes = {};
        foreach (STATIC_TABLE as $i => [$name, $value]) {
            $names[$name] ??= $i + 1;
            if ($value != "") {
                $wholes[$name .. "\0" .. $value] = $i + 1;
            }
        }
        StaticTable::names = $names;
        StaticTable::wholes = $wholes;
    }
}
