/**
 * HTTP/2's frames and header compression (RFC 9113 and RFC 7541), for `http::serve()`, which
 * speaks HTTP/2 to a client that asks for it when it serves TLS. A program needs none of it to
 * serve HTTP/2: this is the protocol's own arithmetic, kept apart from the server so it can be
 * read and tested alone.
 *
 * A frame is `http2::Frame`, read by `http2::FrameReader` and written by `http2::frame()`; header
 * blocks are decoded by an `http2::Decoder` (one for each connection, as its table is the
 * connection's) and encoded by `http2::encode()`. What a peer gets wrong is an
 * `http2::ConnectionError` with the code to send in a GOAWAY.
 */
namespace http2;

/**
 * What a client sends first on an HTTP/2 connection, before its SETTINGS
 */
pub const PREFACE = "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n";

/**
 * The frame types (RFC 9113 §6)
 */
pub const DATA = 0;
/**
 * A header block's first part, which opens a stream
 */
pub const HEADERS = 1;
/**
 * A stream's priority, which the server reads and leaves alone
 */
pub const PRIORITY = 2;
/**
 * A stream given up on, by either end
 */
pub const RST_STREAM = 3;
/**
 * A connection's settings, and their acknowledgement
 */
pub const SETTINGS = 4;
/**
 * A server's promise of a response it pushes, which no client may send
 */
pub const PUSH_PROMISE = 5;
/**
 * A ping, answered with the same eight bytes
 */
pub const PING = 6;
/**
 * The end of a connection, with the last stream it saw and why
 */
pub const GOAWAY = 7;
/**
 * More room to send, on a stream or the whole connection
 */
pub const WINDOW_UPDATE = 8;
/**
 * The rest of a header block too long for one frame
 */
pub const CONTINUATION = 9;

/**
 * A frame's flag: the last frame its stream sends (DATA, HEADERS)
 */
pub const END_STREAM = 1;
/**
 * A frame's flag: an acknowledgement (SETTINGS, PING)
 */
pub const ACK = 1;
/**
 * A frame's flag: the header block is whole (HEADERS, CONTINUATION)
 */
pub const END_HEADERS = 4;
/**
 * A frame's flag: padding follows the payload, its length first
 */
pub const PADDED = 8;
/**
 * A frame's flag: a HEADERS frame carries a priority
 */
pub const PRIORITY_FLAG = 32;

/**
 * An error code (RFC 9113 §7): none, for a GOAWAY that only says goodbye
 */
pub const NO_ERROR = 0;
/**
 * An error code: the peer broke the protocol
 */
pub const PROTOCOL_ERROR = 1;
/**
 * An error code: something went wrong here
 */
pub const INTERNAL_ERROR = 2;
/**
 * An error code: flow control was broken
 */
pub const FLOW_CONTROL_ERROR = 3;
/**
 * An error code: a frame on a stream that is closed
 */
pub const STREAM_CLOSED = 5;
/**
 * An error code: a frame of the wrong size
 */
pub const FRAME_SIZE_ERROR = 6;
/**
 * An error code: a stream the server won't take, which the client may send again
 */
pub const REFUSED_STREAM = 7;
/**
 * An error code: a stream no longer wanted
 */
pub const CANCEL = 8;
/**
 * An error code: a header block that can't be decoded
 */
pub const COMPRESSION_ERROR = 9;

/**
 * A setting (RFC 9113 §6.5.2): the most a peer's header table may hold
 */
pub const HEADER_TABLE_SIZE = 1;
/**
 * A setting: whether the server may push
 */
pub const ENABLE_PUSH = 2;
/**
 * A setting: how many streams may be open at once
 */
pub const MAX_CONCURRENT_STREAMS = 3;
/**
 * A setting: a new stream's room to send
 */
pub const INITIAL_WINDOW_SIZE = 4;
/**
 * A setting: the largest frame payload the peer takes
 */
pub const MAX_FRAME_SIZE = 5;
/**
 * A setting: the most a header list may be, decoded
 */
pub const MAX_HEADER_LIST_SIZE = 6;

/**
 * The room each end has to send at first, on a stream and on the connection
 */
pub const DEFAULT_WINDOW = 65535;
/**
 * The largest frame payload a peer takes until it says otherwise
 */
pub const DEFAULT_FRAME_SIZE = 16384;
/**
 * The most a window may grow to
 */
pub const MAX_WINDOW = 2147483647;

const FRAME_HEAD = 9;          // bytes of a frame's length, type, flags and stream
const ENTRY_OVERHEAD = 32;     // RFC 7541 §4.1: what an entry costs beyond its name and value
const INTEGER_SHIFT_MOST = 28; // an integer's last byte starts at bit 28, as 2^31 needs no more
/**
 * The header table's size until a SETTINGS says another (RFC 7541 §4.2)
 */
pub const DEFAULT_TABLE_SIZE = 4096;
const STATIC_TABLE = [
    [":authority", ""], [":method", "GET"], [":method", "POST"], [":path", "/"], [":path", "/index.html"],
    [":scheme", "http"], [":scheme", "https"], [":status", "200"], [":status", "204"], [":status", "206"],
    [":status", "304"], [":status", "400"], [":status", "404"], [":status", "500"], ["accept-charset", ""],
    ["accept-encoding", "gzip, deflate"], ["accept-language", ""], ["accept-ranges", ""], ["accept", ""],
    ["access-control-allow-origin", ""], ["age", ""], ["allow", ""], ["authorization", ""],
    ["cache-control", ""], ["content-disposition", ""], ["content-encoding", ""], ["content-language", ""],
    ["content-length", ""], ["content-location", ""], ["content-range", ""], ["content-type", ""],
    ["cookie", ""], ["date", ""], ["etag", ""], ["expect", ""], ["expires", ""], ["from", ""], ["host", ""],
    ["if-match", ""], ["if-modified-since", ""], ["if-none-match", ""], ["if-range", ""],
    ["if-unmodified-since", ""], ["last-modified", ""], ["link", ""], ["location", ""], ["max-forwards", ""],
    ["proxy-authenticate", ""], ["proxy-authorization", ""], ["range", ""], ["referer", ""], ["refresh", ""],
    ["retry-after", ""], ["server", ""], ["set-cookie", ""], ["strict-transport-security", ""],
    ["transfer-encoding", ""], ["user-agent", ""], ["vary", ""], ["via", ""], ["www-authenticate", ""],
];
// RFC 7541 Appendix B: each byte's code and its length in bits, then EOS (256), which no string may hold
const HUFFMAN = [
    [0x1ff8, 13], [0x7fffd8, 23], [0xfffffe2, 28], [0xfffffe3, 28], [0xfffffe4, 28], [0xfffffe5, 28],
    [0xfffffe6, 28], [0xfffffe7, 28], [0xfffffe8, 28], [0xffffea, 24], [0x3ffffffc, 30], [0xfffffe9, 28],
    [0xfffffea, 28], [0x3ffffffd, 30], [0xfffffeb, 28], [0xfffffec, 28], [0xfffffed, 28], [0xfffffee, 28],
    [0xfffffef, 28], [0xffffff0, 28], [0xffffff1, 28], [0xffffff2, 28], [0x3ffffffe, 30], [0xffffff3, 28],
    [0xffffff4, 28], [0xffffff5, 28], [0xffffff6, 28], [0xffffff7, 28], [0xffffff8, 28], [0xffffff9, 28],
