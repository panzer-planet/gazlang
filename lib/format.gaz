// Formatting numbers and text for display: format::number(), format::pad_left() and
// format::pad_right().
namespace format;

// $number with $decimals digits after the point and thousands separated:
// format::number(1234.5) is "1,234.50", format::number(-0.004) is "0.00".
// Rounds like round($number, $decimals), so it gives "1.01" for 1.005, as with PHP's
// number_format. The number must fit in an int once scaled by 10^$decimals.
pub fn number($number, $decimals = 2, $thousands = ",") {
    $scale = 1;
    for ($i = 0; $i < $decimals; $i++) {
        $scale *= 10;
    }
    // Rounding to the decimals first avoids float error: 1.005 * 100 is 100.49999...
    $scaled = to_int(round(round(abs($number), $decimals) * $scale));

    $whole = to_string(intdiv($scaled, $scale));
    $grouped = "";
    while (len($whole) > 3) {
        $grouped = $thousands .. slice($whole, -3) .. $grouped;
        $whole = slice($whole, 0, -3);
    }
    $text = $whole .. $grouped;

    if ($decimals > 0) {
        $text ..= "." .. pad_left($scaled % $scale, $decimals, "0");
    }
    // Only negative if something non-zero is shown
    if ($number < 0 && $scaled > 0) {
        $text = "-" .. $text;
    }
    return $text;
}

// $value as echo prints it, padded with $pad on the left to at least $width characters (bytes),
// so numbers and objects line up without converting them first
pub fn pad_left($value, $width, $pad = " ") {
    $text = to_string($value);
    $missing = $width - len($text);
    if ($missing <= 0) {
        return $text;
    }
    return repeat($pad, $missing) .. $text;
}

// $value as echo prints it, padded with $pad on the right to at least $width characters (bytes)
pub fn pad_right($value, $width, $pad = " ") {
    $text = to_string($value);
    $missing = $width - len($text);
    if ($missing <= 0) {
        return $text;
    }
    return $text .. repeat($pad, $missing);
}
