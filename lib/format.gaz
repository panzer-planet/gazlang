// Formatting numbers and text for display: format::number(), format::pad_left(),
// format::pad_right() and format::sprintf().
namespace format;

// $number with $decimals digits after the point and thousands separated:
// format::number(1234.5) is "1,234.50", format::number(-0.004) is "0.00".
// Rounds like round($number, $decimals), so it gives "1.01" for 1.005, as with PHP's
// number_format. The number must fit in an int once scaled by 10^$decimals.
pub fn number($number, $decimals = 2, $thousands = ",") {
    $scale = 1;
    for ($i = 0; $i < $decimals; $i++) {
        $scale *= 10;
    }
    // Rounding to the decimals first avoids float error: 1.005 * 100 is 100.49999...
    $scaled = to_int(round(round(abs($number), $decimals) * $scale));

    $whole = to_string(intdiv($scaled, $scale));
    $grouped = "";
    while (len($whole) > 3) {
        $grouped = $thousands .. slice($whole, -3) .. $grouped;
        $whole = slice($whole, 0, -3);
    }
    $text = $whole .. $grouped;

    if ($decimals > 0) {
        $text ..= "." .. pad_left($scaled % $scale, $decimals, "0");
    }
    // Only negative if something non-zero is shown
    if ($number < 0 && $scaled > 0) {
        $text = "-" .. $text;
    }
    return $text;
}

// $value as echo prints it, padded with $pad on the left to at least $width characters (bytes),
// so numbers and objects line up without converting them first
pub fn pad_left($value, $width, $pad = " ") {
    $text = to_string($value);
    $missing = $width - len($text);
    if ($missing <= 0) {
        return $text;
    }
    return repeat($pad, $missing) .. $text;
}

// $value as echo prints it, padded with $pad on the right to at least $width characters (bytes)
pub fn pad_right($value, $width, $pad = " ") {
    $text = to_string($value);
    $missing = $width - len($text);
    if ($missing <= 0) {
        return $text;
    }
    return $text .. repeat($pad, $missing);
}

/*
 * $template with each placeholder replaced by the next of $args, a list (GazLang has no
 * variadic calls): format::sprintf("%-6s|%5.1f|%03d", ["ab", 2.25, 7]) is "ab    |  2.3|007".
 * A placeholder is % then flags (- to pad on the right, 0 to pad a number with zeros after its
 * sign), a width (the fewest bytes), a precision (.2, %f only; 6 without one) and one of:
 *   %s  the value as echo prints it, whatever it is
 *   %d  an int
 *   %f  an int or float with the precision's digits, rounded as round() does (format::number)
 *   %x  an int of 0 or more in lowercase hex
 *   %%  a %
 * As many placeholders as arguments, a type %d, %f or %x can't take, and a placeholder this
 * doesn't know are errors, raised before anything is formatted.
 */
const CONVERSIONS = ["s", "d", "f", "x", "%"];
const DEFAULT_PRECISION = 6;
const MAX_PRECISION = 18;
const HEX_DIGITS = "0123456789abcdef";

pub fn sprintf($template, $args) {
    check_arguments($template, $args);
    $pieces = split_template($template);
    check_count($pieces, $args);

    return fill($pieces, $args);
}

fn check_arguments($template, $args) {
    if (type_of($template) != "string" || type_of($args) != "list") {
        error("sprintf: expects a string and a list, got " .. type_of($template) .. " and " .. type_of($args));
    }
}

// The template in order: its text between placeholders as strings, its placeholders as Placeholders
fn split_template($template) {
    $pieces = [];
    $at = 0;
    while (true) {
        $percent = index_of($template, "%", $at);
        if ($percent == null) {
            $pieces[] = slice($template, $at);

            return $pieces;
        }
        $pieces[] = slice($template, $at, $percent - $at);
        $placeholder = Placeholder::read($template, $percent);
        $at = $percent + len($placeholder.text);
        if ($placeholder.is_percent_sign()) {
            $pieces[] = "%";
        } else {
            $pieces[] = $placeholder;
        }
    }
}

fn check_count($pieces, $args) {
    $wanted = len(filter($pieces, is_placeholder));
    if ($wanted != len($args)) {
        error("sprintf: the template takes {$wanted} arguments, " .. len($args) .. " given");
    }
}

fn is_placeholder($piece) {
    return type_of($piece) == "object";
}

fn fill($pieces, $args) {
    $out = "";
    $next = 0;
    foreach ($pieces as $piece) {
        if (!is_placeholder($piece)) {
            $out ..= $piece;
            continue;
        }
        $out ..= $piece.format($args[$next], $next + 1);
        $next++;
    }

    return $out;
}

// One % placeholder: its flags, width, precision and conversion, and how it formats a value
kind Placeholder {
    fn _(pub #text, #left, #zeros, #width, #precision, #conversion) {}

    // The placeholder whose % is at $start, checked
    pub static fn read($template, $start) {
        $at = $start + 1;
        $left = false;
        $zeros = false;
        while ($at < len($template) && is_flag($template[$at])) {
            if ($template[$at] == "-") {
                $left = true;
            } else {
                $zeros = true;
            }
            $at++;
        }

        $width = digits($template, $at);
        $at += len($width);

        $precision = null;
        if ($at < len($template) && $template[$at] == ".") {
            $precision = digits($template, $at + 1);
            $at += 1 + len($precision);
            if ($precision == "") {
                refuse($template, $start, $at, "a precision needs its digits");
            }
        }
        if ($at >= len($template)) {
            refuse($template, $start, $at, "the template ends in the middle of a placeholder");
        }

        $conversion = $template[$at];
        $end = $at + 1;
        $text = slice($template, $start, $end - $start);
        check_shape($template, $start, $end, $text, $conversion, $precision, $zeros);

        return Placeholder($text, $left, $zeros, number_or($width, 0), number_or($precision, DEFAULT_PRECISION), $conversion);
    }

    pub fn is_percent_sign() {
        return #conversion == "%";
    }

    // $value, argument number $position, as this placeholder shows it
    pub fn format($value, $position) {
        #check_value($value, $position);

        return #pad(#convert($value));
    }

    fn check_value($value, $position) {
        $type = type_of($value);
        if (!#accepts($type)) {
            error("sprintf: {#text} expects " .. #expected() .. ", got {$type} (argument {$position})");
        }
        if (#conversion == "x" && $value < 0) {
            error("sprintf: {#text} expects an int of 0 or more, got {$value} (argument {$position})");
        }
        // ponytail: format::number() scales to an int, which caps %f at 9.2E+18 over 10^precision
        if (#conversion == "f" && abs($value) >= 9.2e18 / 10.0 ** #precision) {
            error("sprintf: {#text} can't show {$value} (argument {$position}): with its decimals it must fit in an int");
        }
    }

    fn accepts($type) {
        return match (#conversion) {
            "d", "x" => $type == "int",
            "f" => $type == "int" || $type == "float",
            default => true,
        };
    }

    fn expected() {
        if (#conversion == "f") {
            return "an int or float";
        }

        return "an int";
    }

    fn convert($value) {
        return match (#conversion) {
            "s", "d" => to_string($value),
            "f" => number($value, #precision, ""),
            default => hex($value),
        };
    }

    // $text widened to the width: spaces on the left, on the right with -, or zeros after the sign with 0
    fn pad($text) {
        $missing = #width - len($text);
        if ($missing <= 0) {
            return $text;
        }
        if (#left) {
            return $text .. repeat(" ", $missing);
        }
        if (#zeros) {
            return zero_pad($text, $missing);
        }

        return repeat(" ", $missing) .. $text;
    }
}

// What a placeholder can't be, in the order the errors are checked
fn check_shape($template, $start, $end, $text, $conversion, $precision, $zeros) {
    if (!in_array($conversion, CONVERSIONS)) {
        refuse($template, $start, $end, "there is no %{$conversion}");
    }
    if ($conversion == "%" && $text != "%%") {
        refuse($template, $start, $end, "%% takes no flags, width or precision");
    }
    if ($precision != null && $conversion != "f") {
        refuse($template, $start, $end, "only %f takes a precision");
    }
    if ($precision != null && to_int($precision) > MAX_PRECISION) {
        refuse($template, $start, $end, "a precision is at most " .. MAX_PRECISION);
    }
    if ($zeros && $conversion == "s") {
        refuse($template, $start, $end, "only a number is padded with zeros");
    }
}

fn is_flag($c) {
    return $c == "-" || $c == "0";
}

// The digits at $at, as a string, "" when there are none
fn digits($s, $at) {
    $from = $at;
    while ($at < len($s) && $s[$at] >= "0" && $s[$at] <= "9") {
        $at++;
    }

    return slice($s, $from, $at - $from);
}

// Digits as an int, or $default when there are none
fn number_or($digits, $default) {
    if ($digits == null || $digits == "") {
        return $default;
    }

    return to_int($digits);
}

// The placeholder from $from to $to, quoted, and why it can't be
fn refuse($template, $from, $to, $why) {
    $placeholder = slice($template, $from, $to - $from);
    error("sprintf: " .. slice(to_string([$placeholder]), 1, -1) .. ": " .. $why);
}

// Zeros between a number's sign and its digits
fn zero_pad($text, $missing) {
    $sign = "";
    if (starts_with($text, "-")) {
        $sign = "-";
    }

    return $sign .. repeat("0", $missing) .. slice($text, len($sign));
}

// A non-negative int in lowercase hex
fn hex($n) {
    $text = "";
    while ($n >= 16) {
        $text = HEX_DIGITS[$n % 16] .. $text;
        $n = intdiv($n, 16);
    }

    return HEX_DIGITS[$n] .. $text;
}
