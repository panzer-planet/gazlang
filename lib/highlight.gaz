/**
 * Syntax highlighting, as the GazLang website shows code: source text as a list of `Piece`s,
 * each a run of the text with the class it is shown in and the line it is on, and the pieces as
 * HTML.
 *
 *     $pieces = highlight::gaz("echo 1;");       // [Piece("kw", "echo"), Piece("", " "), ...]
 *     $lines = highlight::lines("gaz", $source); // the pieces of each line, for an editor
 *     echo highlight::to_html("gaz", $source);   // <span class="kw">echo</span> ...
 *
 * GazLang is split by the compiler's own lexer (`std/syntax.gaz`), so a colour can never
 * disagree with the language. The lexer drops whitespace and comments and decodes strings, so
 * the text of every piece is cut from the source by where the lexer says each token lies, never
 * written back from a token: joining the pieces' text gives the source, byte for byte. Source
 * the lexer refuses is pieced up to the token it refused and plain from there, so a broken
 * example is shown, not fatal, and a file being typed keeps its colours above the mistake.
 *
 * No piece spans a line: one that would (a block comment, a string with a line break in it) is
 * cut at each newline into pieces of its kind, the newline ending the piece it is in, so an
 * editor draws a line from the pieces whose `line` it is, which `lines()` gathers.
 *
 * Bytecode, templates and shell commands have small highlighters of their own, line by line.
 *
 * The classes, for a stylesheet to colour: `kw` a keyword, `lit` true, false and null, `num` a
 * number, `str` a string, `com` a comment, `var` a variable, `mem` a member (`#name`, `.name`),
 * `ty` a kind, constant or type, `fn` a name that is called, `op` an operator; plain text has
 * none.
 */
namespace highlight;

import "std/syntax.gaz" use Lexer, LexError;
import "std/text.gaz";

// The class of text shown plain: whitespace, punctuation, and anything not recognised
const PLAIN = "";

// A class for each thing a reader tells apart, which the stylesheet colours
const KEYWORD = "kw";
const LITERAL = "lit";          // true, false, null
const NUMBER = "num";
const STRING = "str";
const COMMENT = "com";
const VARIABLE = "var";         // $local, @global
const MEMBER = "mem";           // #, #name, ##name, .name, ?.name
const TYPE = "ty";              // a kind or constant (a capital first), or a type's name
const FUNCTION = "fn";          // a name that is called
const OPERATOR = "op";

/**
 * A piece's type for whitespace between GazLang tokens
 */
pub const SPACE_TYPE = "SPACE";
/**
 * A piece's type for a comment between GazLang tokens
 */
pub const COMMENT_TYPE = "COMMENT";
/**
 * A piece's type for anything that isn't GazLang read by the lexer: other languages, and source
 * from the token the lexer refused on
 */
pub const TEXT_TYPE = "TEXT";

const TOKEN_CLASSES = {
    "INTEGER" => NUMBER, "FLOAT" => NUMBER,
    "STRING" => STRING, "STRING_START" => STRING, "STRING_MIDDLE" => STRING, "STRING_END" => STRING,
    "VAR_IDENTIFIER" => VARIABLE, "GLOBAL_VAR_IDENTIFIER" => VARIABLE,
    "HASH" => MEMBER, "HASH_IDENTIFIER" => MEMBER, "PARENT" => MEMBER, "PARENT_IDENTIFIER" => MEMBER,
    "PROPERTY" => MEMBER, "NULLSAFE_PROPERTY" => MEMBER,
    // A tag is called with its string, sql"...", so it is shown as any called name is
    "TAG" => FUNCTION,
    "TRUE" => LITERAL, "FALSE" => LITERAL, "NULL" => LITERAL,
    "LEFT_PAREN" => PLAIN, "RIGHT_PAREN" => PLAIN, "LEFT_BRACKET" => PLAIN, "RIGHT_BRACKET" => PLAIN,
    "LEFT_BRACE" => PLAIN, "RIGHT_BRACE" => PLAIN, "COMMA" => PLAIN, "SEMICOLON" => PLAIN,
};

// The names of types that aren't keywords, as type_of() gives them; followed by ( one is a call
const TYPE_NAMES = ["int", "float", "string", "bool", "list", "map", "function", "object", "socket", "db", "file"];

// The words that start a template directive line
const TEMPLATE_DIRECTIVES = ["template", "if", "elseif", "else", "endif", "foreach", "endforeach"];

// The words in a bytecode header or record line, as against an instruction's name
const BYTECODE_HEADERS = [
    "globals", "statics", "top", "fn", "kind", "abstract", "final", "readonly", "interface", "enum", "lambda",
    "locals", "field", "method", "static", "case", "capture", "self",
];
const BYTECODE_KEYWORDS = ["in", "extends", "implements", "pub", "kin", "final", "readonly", "local", "captured"];

/**
 * A run of source text, on one line, and how it is shown
 */
pub kind Piece {
    /**
     * $class is the class it is shown in (`""` for plain text), $text the source itself, $type
     * the lexer's token type for a token of GazLang, or `SPACE_TYPE`, `COMMENT_TYPE` or
     * `TEXT_TYPE`, so a reader of the pieces can tell a token from what the lexer skipped, and
     * source the lexer refused from source it read, and $line the line of the source it starts
     * on, from 1. A piece never spans a line: its text holds a newline only as its last byte,
     * where one ends the piece
     */
    fn _(pub string #class, pub string #text, pub string #type = TEXT_TYPE, pub int #line = 1);
}

/*
 * Gathers pieces in order, giving each the line it starts on and cutting one that would span
 * lines at each newline, so no piece holds a newline except as its last byte; a piece with no
 * text is left out
 */
kind Pieces {
    pub #pieces = [];
    #line = 1;

    pub fn add(string $class, string $text, string $type) {
        $end = index_of($text, "\n");
        // Most pieces are on one line, so they are kept as they are, not cut from themselves
        if ($end == null) {
            if ($text != "") {
                #pieces[] = Piece($class, $text, $type, #line);
            }
            return;
        }
        $start = 0;
        while ($end != null) {
            #pieces[] = Piece($class, slice($text, $start, $end + 1 - $start), $type, #line);
            #line++;
            $start = $end + 1;
            $end = index_of($text, "\n", $start);
        }
        #add($class, slice($text, $start), $type);
    }
}

// Pieces made without lines, line by line, given theirs and cut at each newline
fn lined(list $pieces): list {
    $lined = Pieces();
    foreach ($pieces as $piece) {
        $lined.add($piece.class, $piece.text, $piece.type);
    }

    return $lined.pieces;
}

// Text in no language the highlighter knows: plain, a piece per line
fn plain(string $source): list {
    return lined([Piece(PLAIN, $source)]);
}

/**
 * The pieces of $source in a language named as a Markdown fence names it: `gaz`, `gzb`
 * (bytecode), `gazml` (a template) or `bash`; any other is plain
 */
pub fn pieces(string $language, string $source): list {
    return match ($language) {
        "gaz" => gaz($source),
        "gzb" => bytecode($source),
        "gazml" => template($source),
        "bash", "sh", "shell" => shell($source),
        default => plain($source),
    };
}

/**
 * The pieces of $source in $language (as `pieces()` names it), a list for each line: what an
 * editor draws a line from. A line's pieces hold its text without the line break that ends it,
 * so an empty line is an empty list; a line break ends a line, and text after the last one is a
 * line too, so `"a\nb"` and `"a\nb\n"` both have two lines, and an empty source has none
 */
pub fn lines(string $language, string $source): list {
    return by_line(pieces($language, $source));
}

// Pieces gathered by their line, each line's last piece without the newline that ended it
fn by_line(list $pieces): list {
    $lines = [];
    $line = [];
    foreach ($pieces as $piece) {
        if (!ends_with($piece.text, "\n")) {
            $line[] = $piece;
            continue;
        }
        // The newline ends the line, and is the last byte of exactly one piece
        $text = slice($piece.text, 0, len($piece.text) - 1);
        if ($text != "") {
            $line[] = Piece($piece.class, $text, $piece.type, $piece.line);
        }
        $lines[] = $line;
        $line = [];
    }
    if (len($line) > 0) {
        $lines[] = $line;
    }

    return $lines;
}

/**
 * $source in $language (as `pieces()` names it) as HTML, for inside a `<pre><code>`
 */
pub fn to_html(string $language, string $source): Html {
    return render(pieces($language, $source));
}

/**
 * Pieces as HTML: a piece with a class is a `<span>` of that class, and all the text is escaped.
 * The pieces a newline cut from one run (a block comment across lines) are one `<span>`, as the
 * run would be
 */
pub fn render(list $pieces): Html {
    $html = "";
    $open = false;
    foreach ($pieces as $i => $piece) {
        $text = Html::escape($piece.text);
        if ($piece.class == PLAIN) {
            $html ..= $text;
            continue;
        }
        if (!$open) {
            $html ..= "<span class=\"{$piece.class}\">";
        }
        $html ..= $text;
        $open = continues($piece, $pieces[$i + 1] ?? null);
        if (!$open) {
            $html ..= "</span>";
        }
    }

    return Html($html);
}

// Whether $next was cut from one run with $piece: the same kind, after the newline that ended it
fn continues(Piece $piece, ?Piece $next): bool {
    if ($next == null || !ends_with($piece.text, "\n")) {
        return false;
    }

    return $next.class == $piece.class && $next.type == $piece.type;
}

/**
 * GazLang source, split by the compiler's lexer. Source the lexer refuses is pieced up to the
 * token it refused, exactly as the lexer read it, and from that token on is plain text
 * (`TEXT_TYPE`), a piece per line: a file being typed keeps its colours above the mistake, and
 * nothing after it is guessed at.
 *
 * ponytail: whole-file, about 50 ms for the compiler's parser.gaz, so an editor on a big file
 * can't call it at every keystroke; it wants incremental highlighting, lexing again from the
 * start of the token the edited line is in, which waits for the editor to show its shape.
 */
pub fn gaz(string $source): list {
    $lexer = Lexer($source);
    $tokens = [];
    $spans = [];
    // Where the lexer stopped: the end of the text, or the start of the token it refused
    $cut = len($source);
    try {
        $type = null;
        while ($type != "EOF") {
            $token = $lexer.get_next_token();
            $tokens[] = $token;
            $spans[] = $lexer.span();
            $type = $token.type;
        }
    } catch (LexError $e) {
        $cut = $lexer.span()[0];
    }

    $pieces = Pieces();
    $end = 0;
    foreach ($tokens as $i => $token) {
        [$start, $stop] = $spans[$i];
        // A token queued with the one before it (the [0] of "$a[0]") was read with it
        if ($start == $stop) {
            continue;
        }
        between($pieces, slice($source, $end, $start - $end));
        $next = $tokens[$i + 1] ?? null;
        $pieces.add(token_class($token, $next), slice($source, $start, $stop - $start), $token.type);
        $end = $stop;
    }
    // What is left after the last token: whitespace and comments, then what the lexer refused
    between($pieces, slice($source, $end, $cut - $end));
    $pieces.add(PLAIN, slice($source, $cut), TEXT_TYPE);

    return $pieces.pieces;
}

// How a token is shown, by its type, and for a name by what it looks like and what follows it
fn token_class($token, $next): string {
    $class = TOKEN_CLASSES[$token.type] ?? null;
    if ($class != null) {
        return $class;
    }
    if ($token.type == "IDENTIFIER") {
        return identifier_class($token.value, $next);
    }
    if (is_keyword($token)) {
        return KEYWORD;
    }

    return OPERATOR;
}

fn identifier_class(string $name, $next): string {
    if ($name[0] >= "A" && $name[0] <= "Z") {
        return TYPE;
    }
    if ($next != null && $next.type == "LEFT_PAREN") {
        return FUNCTION;
    }
    if (in_array($name, TYPE_NAMES)) {
        return TYPE;
    }

    return PLAIN;
}

// A keyword's token type is its word in capitals, which no operator's is
fn is_keyword($token): bool {
    $value = $token.value;
    if (type_of($value) != "string" || $value == "" || $token.type == "IDENTIFIER") {
        return false;
    }

    return $value[0] >= "a" && $value[0] <= "z" && $token.type == upper($value);
}

/*
 * The text between two tokens, which the lexer skipped, added to $pieces: whitespace, line and
 * block comments, and a #! line at the start of a script
 */
fn between(Pieces $pieces, string $text) {
    $i = 0;
    $length = len($text);
    while ($i < $length) {
        $end = match {
            starts_with($text, "//", $i) || starts_with($text, "#!", $i) => line_end($text, $i),
            starts_with($text, "/*", $i) => block_comment_end($text, $i),
            default => null,
        };
        if ($end == null) {
            $end = whitespace_end($text, $i);
            $pieces.add(PLAIN, slice($text, $i, $end - $i), SPACE_TYPE);
        } else {
            $pieces.add(COMMENT, slice($text, $i, $end - $i), COMMENT_TYPE);
        }
        $i = $end;
    }
}

// Where the line $i is on ends, before its line break
fn line_end(string $text, int $i): int {
    return index_of($text, "\n", $i) ?? len($text);
}

// Where the block comment starting at $i ends: past the first closer after its opener (they don't nest)
fn block_comment_end(string $text, int $i): int {
    return (index_of($text, "*/", $i + 2) ?? len($text) - 2) + 2;
}

// Where the run of whitespace at $i ends; anything else the lexer skipped is one character
fn whitespace_end(string $text, int $i): int {
    $end = $i;
    while ($end < len($text) && contains(" \t\r\n", $text[$end])) {
        $end++;
    }

    return max($end, $i + 1);
}

// Text split into lines that keep their line breaks, so joining them gives the text again
fn split_lines(string $text): list {
    $lines = split($text, "\n");
    $last = len($lines) - 1;
    foreach ($lines as $i => $line) {
        if ($i < $last) {
            $lines[$i] = $line .. "\n";
        }
    }
    if ($lines[$last] == "") {
        delete $lines[$last];
    }

    return $lines;
}

// A line as [its indentation, the rest]
fn indented(string $line): list {
    $indent = text::indentation($line);

    return [slice($line, 0, $indent), slice($line, $indent)];
}

// A line as [its first word, the rest], the rest starting with the space after the word
fn first_word(string $line): list {
    $i = 0;
    while ($i < len($line) && !contains(" \t\r\n", $line[$i])) {
        $i++;
    }

    return [slice($line, 0, $i), slice($line, $i)];
}

/**
 * Bytecode, a line at a time: a header or record word, or an instruction and its operands. A
 * value (after `PUSH` or a case's name, or in an `@` location line) is a GazLang literal, which
 * the lexer highlights; the other operands are names, variables and numbers.
 */
pub fn bytecode(string $source): list {
    $pieces = [];
    foreach (split_lines($source) as $line) {
        [$indent, $rest] = indented($line);
        if ($indent != "") {
            $pieces[] = Piece(PLAIN, $indent);
        }
        foreach (bytecode_line($rest) as $piece) {
            $pieces[] = $piece;
        }
    }

    return lined($pieces);
}

fn bytecode_line(string $line): list {
    if (starts_with($line, "GAZLANG BYTECODE")) {
        return [Piece(KEYWORD, "GAZLANG BYTECODE"), ...bytecode_operands(slice($line, 16))];
    }
    [$word, $rest] = first_word($line);
    if ($word == "") {
        return [Piece(PLAIN, $rest)];
    }
    // A location's path and line, and a pushed value, are literals
    if ($word == "@") {
        return [Piece(OPERATOR, $word), ...gaz($rest)];
    }
    if ($word == "PUSH") {
        return [Piece(KEYWORD, $word), ...gaz($rest)];
    }
    // An enum's case: its name, then its value, if it has one, as a literal
    if ($word == "case") {
        [$space, $after] = indented($rest);
        [$name, $value] = first_word($after);
        if ($name == "") {
            return [Piece(TYPE, $word), Piece(PLAIN, $rest)];
        }

        return [Piece(TYPE, $word), Piece(PLAIN, $space), Piece(operand_class($name), $name), ...gaz($value)];
    }
    $class = in_array($word, BYTECODE_HEADERS) ? TYPE : KEYWORD;

    return [Piece($class, $word), ...bytecode_operands($rest)];
}

// Operands separated by whitespace, each shown by what it looks like
fn bytecode_operands(string $text): list {
    $pieces = [];
    $i = 0;
    while ($i < len($text)) {
        [$space, $rest] = indented(slice($text, $i));
        if ($space != "") {
            $pieces[] = Piece(PLAIN, $space);
            $i += len($space);
            continue;
        }
        $word = first_word($rest)[0];
        if ($word == "") {
            // A line break
            $word = $rest[0];
        }
        $pieces[] = Piece(operand_class($word), $word);
        $i += len($word);
    }

    return $pieces;
}

fn operand_class(string $word): string {
    $first = $word[0];

    return match {
        $first == "$" || $first == "@" => VARIABLE,
        $first >= "0" && $first <= "9" || $first == "-" && len($word) > 1 => NUMBER,
        in_array($word, BYTECODE_KEYWORDS) => KEYWORD,
        $first >= "A" && $first <= "Z" => TYPE,
        default => PLAIN,
    };
}

/**
 * A `.gazml` template, a line at a time: a directive line is its word and GazLang, and anywhere
 * else `{{ }}`, `{!! !!}` and `{{-- --}}` are GazLang or a comment in HTML text
 */
pub fn template(string $source): list {
    $pieces = [];
    foreach (split_lines($source) as $line) {
        [$indent, $rest] = indented($line);
        [$word, $after] = first_word($rest);
        $line_pieces = template_text($line);
        if (starts_with($word, "@") && in_array(slice($word, 1), TEMPLATE_DIRECTIVES)) {
            $line_pieces = [Piece(PLAIN, $indent), Piece(KEYWORD, $word), ...gaz($after)];
        }
        foreach ($line_pieces as $piece) {
            $pieces[] = $piece;
        }
    }

    return lined($pieces);
}

// HTML text with {{ }}, {!! !!} and {{-- --}} in it; @{{ is text
fn template_text(string $line): list {
    $pieces = [];
    $i = 0;
    $text_start = 0;
    while ($i < len($line)) {
        $mark = template_mark($line, $i);
        if ($mark == null) {
            $i++;
            continue;
        }
        [$open, $close] = $mark;
        $end = index_of($line, $close, $i + len($open));
        if ($end == null) {
            break;
        }
        $pieces[] = Piece(PLAIN, slice($line, $text_start, $i - $text_start));
        if ($open == "{{--") {
            $pieces[] = Piece(COMMENT, slice($line, $i, $end + len($close) - $i));
        } else {
            $inside = slice($line, $i + len($open), $end - $i - len($open));
            $pieces = [...$pieces, Piece(OPERATOR, $open), ...gaz($inside), Piece(OPERATOR, $close)];
        }
        $i = $end + len($close);
        $text_start = $i;
    }
    $pieces[] = Piece(PLAIN, slice($line, $text_start));

    return $pieces;
}

// The [opening, closing] marks of what starts at $i, or null
fn template_mark(string $line, int $i): ?list {
    // @{{ is a literal {{
    if ($i > 0 && $line[$i - 1] == "@") {
        return null;
    }

    return match {
        starts_with($line, "{{--", $i) => ["{{--", "--}}"],
        starts_with($line, "{{", $i) => ["{{", "}}"],
        starts_with($line, "{!!", $i) => ["{!!", "!!}"],
        default => null,
    };
}

/**
 * Shell commands: a `#` comment, at the start of a line or after a space, to the end of the line
 */
pub fn shell(string $source): list {
    $pieces = [];
    foreach (split_lines($source) as $line) {
        $hash = shell_comment_start($line);
        if ($hash == null) {
            $pieces[] = Piece(PLAIN, $line);
            continue;
        }
        $end = line_end($line, $hash);
        $pieces[] = Piece(PLAIN, slice($line, 0, $hash));
        $pieces[] = Piece(COMMENT, slice($line, $hash, $end - $hash));
        $pieces[] = Piece(PLAIN, slice($line, $end));
    }

    return lined($pieces);
}

// Where a line's comment starts, or null; a # inside quotes is text
fn shell_comment_start(string $line): ?int {
    $quote = null;
    foreach (split($line, "") as $i => $c) {
        if ($quote != null) {
            if ($c == $quote) {
                $quote = null;
            }
        } else if ($c == "'" || $c == "\"") {
            $quote = $c;
        } else if ($c == "#" && ($i == 0 || $line[$i - 1] == " ")) {
            return $i;
        }
    }

    return null;
}
