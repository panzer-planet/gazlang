/**
 * HTTP/1.1 for GazLang, on the socket builtins (TLS for https): http::get($url,
 * $headers = {}), http::post($url, $body, $headers = {}) and http::request($method,
 * $url, $headers = {}, $body = null). Each returns
 * {"status" => 200, "headers" => {"content-type" => "text/plain", ...}, "body" => "..."}.
 *
 * - Any status is a response, 404 and 500 included. A request that gets no response (no such
 *   host, refused, a certificate that doesn't check out, a malformed response) is an error.
 * - https checks the server's certificate against the system's trusted ones and the host name.
 * - Redirects are followed, up to 20. A 303 becomes a GET (a HEAD stays a HEAD), and so does a
 *   POST after a 301 or 302, as browsers do; the others keep the method and body. Authorization
 *   and Cookie headers are dropped when a redirect leaves the scheme, host and port.
 * - Response header names are lowercased; a repeated header's values are joined with ", ".
 * - Host, Content-Length, Connection and Transfer-Encoding are written here; giving one is an
 *   error. No Content-Type is sent unless given.
 * - Each connection waits 30 seconds at most to connect and for each read.
 * - ponytail: one connection per request (Connection: close); keeping it alive would save the
 *   handshake for several requests to one server. Redirect targets' ./ and ../ are left for the
 *   server to resolve.
 */

namespace http;

import "std/chars.gaz" use is_alnum, is_digit, is_hex_digit;
import "std/date.gaz";
import "std/crypto.gaz";
import "std/json.gaz";
import "std/text.gaz" use quote;

const MAX_REDIRECTS = 20;
const MAX_HEAD = 65536;      // a request's line and headers, in bytes

/**
 * A GET request for $url with $headers: the response, as the overview above says
 */
pub fn get($url, $headers = {}) {
    return request("GET", $url, $headers);
}

/**
 * A POST request of $body, a string, to $url with $headers: the response, as the overview
 * above says
 */
pub fn post($url, $body, $headers = {}) {
    return request("POST", $url, $headers, $body);
}

/**
 * A request with any method, and $body null for none: the response, as the overview above
 * says. A method or header name that isn't an HTTP token, or a URL with a space or control
 * character in it, is an error, so nothing can end a line of the request.
 */
pub fn request($method, $url, $headers = {}, $body = null) {
    check_token("method", $method);
    if ($body != null && type_of($body) != "string") {
        throw "HTTP error: the body must be a string, got " .. type_of($body);
    }
    // By lowercased name: [the name as given, its value]
    $sent = {};
    foreach ($headers as $name => $value) {
        $value = checked_header($name, $value);
        if (in_array(lower($name), ["host", "content-length", "connection", "transfer-encoding"])) {
            throw "HTTP error: header $name is written by http::request";
        }
        $sent[lower($name)] = [$name, $value];
    }
    $target = parse_url($url);
    $redirects = 0;
    while (true) {
        $response = exchange($method, $target, $sent, $body);
        $location = $response["headers"]["location"] ?? null;
        if (!in_array($response["status"], [301, 302, 303, 307, 308]) || $location == null) {
            return $response;
        }
        if ($redirects == MAX_REDIRECTS) {
            throw "HTTP error: more than " .. MAX_REDIRECTS .. " redirects";
        }
        $redirects++;
        $next = parse_url(resolve($target, $location));
        $status = $response["status"];
        if ($status == 303 && $method != "HEAD" || ($status == 301 || $status == 302) && $method == "POST") {
            $method = "GET";
            $body = null;
            if (has_key($sent, "content-type")) {
                delete $sent["content-type"];
            }
        }
        // Credentials are for the server they were written for
        if ($next["origin"] != $target["origin"]) {
            foreach (["authorization", "cookie"] as $name) {
                if (has_key($sent, $name)) {
                    delete $sent[$name];
                }
            }
        }
        $target = $next;
    }
}

// $value as text, for the header $name of a request: an error if either could end its line
fn checked_header($name, $value) {
    check_token("header name", $name);
    $value = to_string($value);
    if (contains($value, "\r") || contains($value, "\n") || contains($value, "\0")) {
        throw "HTTP error: header $name has a line break or NUL byte in its value";
    }
    return $value;
}

// One request on its own connection, and its response
fn exchange($method, $target, $sent, $body) {
    $lines = ["$method {$target["path"]} HTTP/1.1", "Host: {$target["host_header"]}"];
    foreach ({"user-agent" => ["User-Agent", "gazlang"], "accept" => ["Accept", "*/*"]} as $key => $default) {
        $sent[$key] ??= $default;
    }
    foreach ($sent as [$name, $value]) {
        $lines[] = "$name: $value";
    }
    $lines[] = "Connection: close";
    if ($body != null) {
        $lines[] = "Content-Length: " .. len($body);
    }
    $socket = socket_open($target["host"], $target["port"], $target["scheme"] == "https");
    try {
        socket_write($socket, join($lines, "\r\n") .. "\r\n\r\n" .. ($body ?? ""));
        return read_response(Reader($socket), $method);
    } finally {
        socket_close($socket);
    }
}

// {"scheme", "host", "port", "path", "host_header", "origin"} from an http or https URL
fn parse_url($url) {
    if (type_of($url) != "string") {
        throw "HTTP error: a URL must be a string, got " .. type_of($url);
    }
    $shown = quote($url);
    // Nothing a request line can't carry: no space or control character
    foreach (split($url, "") as $c) {
        if (ord($c) <= 32 || ord($c) == 127) {
            throw "HTTP error: bad URL: $shown";
        }
    }
    $scheme_end = index_of($url, "://");
    if ($scheme_end == null) {
        throw "HTTP error: bad URL: $shown";
    }
    $scheme = lower(slice($url, 0, $scheme_end));
    if ($scheme != "http" && $scheme != "https") {
        throw "HTTP error: only http and https URLs, got $shown";
    }
    $rest = slice($url, $scheme_end + 3);
    $fragment = index_of($rest, "#");
    if ($fragment != null) {
        $rest = slice($rest, 0, $fragment);
    }
    // The authority ends at the path or the query
    $end = len($rest);
    foreach (["/", "?"] as $c) {
        $at = index_of($rest, $c);
        if ($at != null && $at < $end) {
            $end = $at;
        }
    }
    $authority = slice($rest, 0, $end);
    $path = slice($rest, $end);
    if ($path == "" || starts_with($path, "?")) {
        $path = "/" .. $path;
    }
    if (contains($authority, "@")) {
        throw "HTTP error: a URL can't carry credentials; send an Authorization header: $shown";
    }
    // [::1]:8080 or name:8080
    $port_text = "";
    if (starts_with($authority, "[")) {
        $close = index_of($authority, "]");
        if ($close == null) {
            throw "HTTP error: bad URL: $shown";
        }
        $host = slice($authority, 1, $close - 1);
        $after = slice($authority, $close + 1);
        if ($after != "") {
            if (!starts_with($after, ":")) {
                throw "HTTP error: bad URL: $shown";
            }
            $port_text = slice($after, 1);
        }
    } else {
        $colon = index_of($authority, ":");
        $host = $colon == null ? $authority : slice($authority, 0, $colon);
        $port_text = $colon == null ? "" : slice($authority, $colon + 1);
    }
    $host = lower($host);
    $default_port = $scheme == "https" ? 443 : 80;
    $port = $default_port;
    if ($port_text != "") {
        if (len($port_text) > 5 || !all_digits($port_text) || to_int($port_text) < 1 || to_int($port_text) > 65535) {
            throw "HTTP error: bad port in URL: $shown";
        }
        $port = to_int($port_text);
    }
    if ($host == "") {
        throw "HTTP error: no host in URL: $shown";
    }
    $host_header = (contains($host, ":") ? "[$host]" : $host) .. ($port == $default_port ? "" : ":$port");
    return {"scheme" => $scheme, "host" => $host, "port" => $port, "path" => $path,
        "host_header" => $host_header, "origin" => "$scheme://$host_header"};
}

// Where a Location header points, from the URL that sent it
fn resolve($target, $location) {
    // Absolute when what comes before :// is a scheme, not a relative path or query holding a URL
    $scheme_end = index_of($location, "://");
    if ($scheme_end != null && $scheme_end > 0) {
        $absolute = true;
        foreach (split(slice($location, 0, $scheme_end), "") as $c) {
            if (!is_alnum($c) && !contains("+-.", $c)) {
                $absolute = false;
            }
        }
        if ($absolute) {
            return $location;
        }
    }
    if (starts_with($location, "//")) {
        return $target["scheme"] .. ":" .. $location;
    }
    if (starts_with($location, "/")) {
        return $target["origin"] .. $location;
    }
    $query = index_of($target["path"], "?");
    $path = $query == null ? $target["path"] : slice($target["path"], 0, $query);
    if (starts_with($location, "?")) {
        return $target["origin"] .. $path .. $location;
    }
    $parts = split($path, "/");
    $parts[len($parts) - 1] = $location;
    return $target["origin"] .. join($parts, "/");
}

// Reads a message from a socket: lines up to a delimiter, a count of bytes, or the rest
kind Reader {
    #deadline = null;           // a monotonic_time() after which a read is refused (408), or null
    #message_deadline = null;   // the whole message's, which #deadline becomes once its head is in
    #heard_at = null;           // the monotonic_time() the message being read began to come, or null

    // #data: read but not taken yet, kept between messages; with no socket, the whole message
    fn _(#socket, #data = "");

    /*
     * Give the message about to be read until $deadline, a monotonic_time(), and its head (up to
     * its blank line) until $head_deadline, which is no later
     */
    pub fn start($head_deadline, $deadline) {
        #deadline = $head_deadline;
        #message_deadline = $deadline;
        #heard_at = #data == "" ? null : monotonic_time();
    }

    // The head is in: the rest of the message has until the whole message's deadline
    pub fn head_read() {
        #deadline = #message_deadline;
    }

    // Up to $most empty lines (a bare CRLF each) dropped from the start of what has been read, without reading more
    pub fn drop_empty_lines($most) {
        $dropped = 0;
        while ($dropped < $most && starts_with(#data, "\r\n")) {
            #data = slice(#data, 2);
            $dropped++;
        }
    }

    // Whether anything has been read but not taken
    pub fn pending() {
        return #data != "";
    }

    // Whether any byte of the message being read has come, since start()
    pub fn heard_anything() {
        return #heard_at != null;
    }

    // When the message being read began to come, a monotonic_time(), or null if nothing has
    pub fn first_byte_at() {
        return #heard_at;
    }

    // Up to $most empty lines (a bare CRLF each) dropped from where the next message starts
    pub fn skip_empty_lines($most) {
        $skipped = 0;
        while ($skipped < $most) {
            while (len(#data) < 2) {
                if (!#more()) {
                    return;
                }
            }
            if (!starts_with(#data, "\r\n")) {
                return;
            }
            #data = slice(#data, 2);
            $skipped++;
        }
    }

    // Read more; false at the end of the stream
    fn more() {
        if (#socket == null) {
            return false;
        }
        $chunk = #deadline == null ? socket_read(#socket) : #read_by_deadline();
        if ($chunk == "") {
            return false;
        }
        #data ..= $chunk;
        #heard_at ??= monotonic_time();
        return true;
    }

    /*
     * A read that waits no longer than the deadline leaves, or the socket's own timeout if that is
     * sooner, so the deadline holds to the moment; past it, a 408
     */
    fn read_by_deadline() {
        $left = #deadline - monotonic_time();
        $chunk = $left > 0 ? socket_read(#socket, $left) : null;
        if ($chunk == null) {
            throw Refusal(408, "HTTP error: the request took too long to arrive");
        }
        return $chunk;
    }

    /*
     * Up to $delimiter, which is dropped; null if the stream ends first. With a $limit, a line
     * that runs past that many bytes is refused (431) rather than read into memory forever.
     */
    pub fn line($delimiter, $limit = null) {
        $from = 0;
        while (true) {
            $at = index_of(#data, $delimiter, $from);
            if ($at != null && ($limit == null || $at <= $limit)) {
                $line = slice(#data, 0, $at);
                #data = slice(#data, $at + len($delimiter));
                return $line;
            }
            if ($limit != null && len(#data) > $limit) {
                throw Refusal(431, "HTTP error: more than $limit bytes without a line end");
            }
            // A delimiter may straddle what is here and what comes next
            $from = max(0, len(#data) - len($delimiter) + 1);
            if (!#more()) {
                return null;
            }
        }
    }

    // Exactly $n bytes; an error if the stream ends first
    pub fn bytes($n) {
        $parts = [];
        while (len(#data) < $n) {
            $parts[] = #data;
            $n -= len(#data);
            #data = "";
            if (!#more()) {
                throw "HTTP error: the connection closed in the middle of the body";
            }
        }
        $parts[] = slice(#data, 0, $n);
        #data = slice(#data, $n);
        return join($parts, "");
    }

    // Everything until the stream ends
    pub fn rest() {
        $parts = [#data];
        #data = "";
        while (true) {
            $chunk = #socket == null ? "" : socket_read(#socket);
            if ($chunk == "") {
                return join($parts, "");
            }
            $parts[] = $chunk;
        }
    }
}

fn read_response($reader, $method) {
    while (true) {
        $head = $reader.line("\r\n\r\n");
        if ($head == null) {
            throw "HTTP error: the connection closed before a response came";
        }
        $lines = split($head, "\r\n");
        // "HTTP/1.1 200 OK"
        $words = split($lines[0], " ");
        if (len($words) < 2 || !starts_with($words[0], "HTTP/1.") || len($words[1]) != 3 || !all_digits($words[1])) {
            throw "HTTP error: not an HTTP response: " .. quote(slice($lines[0], 0, 100));
        }
        $status = to_int($words[1]);
        $headers = {};
        foreach (slice($lines, 1) as $line) {
            $colon = index_of($line, ":");
            if ($colon == null) {
                continue;
            }
            $name = lower(trim(slice($line, 0, $colon)));
            $value = trim(slice($line, $colon + 1));
            $headers[$name] = has_key($headers, $name) ? $headers[$name] .. ", " .. $value : $value;
        }
        // An interim response (103 Early Hints, say) comes before the real one
        if ($status < 200) {
            continue;
        }
        $body = match {
            $method == "HEAD" || $status == 204 || $status == 304 => "",
            contains(lower($headers["transfer-encoding"] ?? ""), "chunked") => read_chunked($reader),
            has_key($headers, "content-length") => $reader.bytes(content_length($headers["content-length"])),
            default => $reader.rest(),
        };
        return {"status" => $status, "headers" => $headers, "body" => $body};
    }
}

fn content_length($text) {
    if ($text == "" || len($text) > 18 || !all_digits($text)) {
        throw "HTTP error: bad Content-Length: " .. quote($text);
    }
    return to_int($text);
}

/*
 * Chunks, each a size in hex (maybe with ;extensions) and that many bytes, up to a size of 0
 * and trailer lines, which are skipped. With a $limit (a server's), a body that adds up to more
 * is refused (413), and so is a size or trailer line past a few KB.
 */
/*
 * A chunk size line or a trailer ends in CRLF and holds no other line break: a lone line feed or
 * carriage return is a line end to some programs, a proxy among them, and not to this one, which is
 * how a request is smuggled past it, and the connection would go on with what follows
 */
fn check_chunk_line($line) {
    if (contains($line, "\n") || contains($line, "\r")) {
        throw "HTTP error: a line break that is not CRLF in a chunked body";
    }
}

fn read_chunked($reader, $limit = null) {
    $parts = [];
    $total = 0;
    $line_limit = $limit == null ? null : MAX_HEAD;
    while (true) {
        $line = $reader.line("\r\n", $line_limit);
        if ($line == null) {
            throw "HTTP error: the connection closed in the middle of the body";
        }
        check_chunk_line($line);
        $size_text = trim(split($line, ";")[0]);
        if ($size_text == "" || len($size_text) > 15) {
            throw "HTTP error: bad chunk size: " .. quote($line);
        }
        $size = 0;
        foreach (split(lower($size_text), "") as $c) {
            $digit = index_of("0123456789abcdef", $c);
            if ($digit == null) {
                throw "HTTP error: bad chunk size: " .. quote($line);
            }
            $size = $size * 16 + $digit;
        }
        $total += $size;
        if ($limit != null && $total > $limit) {
            throw Refusal(413, "HTTP error: a body of more than $limit bytes");
        }
        if ($size == 0) {
            while (true) {
                $trailer = $reader.line("\r\n", $line_limit);
                if ($trailer != null) {
                    check_chunk_line($trailer);
                }
                if ($trailer == null || $trailer == "") {
                    return join($parts, "");
                }
            }
        }
        $parts[] = $reader.bytes($size);
        if ($reader.line("\r\n", $line_limit) != "") {
            throw "HTTP error: a chunk is longer than its size says";
        }
    }
}

fn all_digits($text) {
    foreach (split($text, "") as $c) {
        if (!is_digit($c)) {
            return false;
        }
    }
    return true;
}

// A method or header name must be an HTTP token, which keeps it from ending a line
fn check_token($what, $name) {
    if (type_of($name) != "string" || !is_token($name)) {
        throw "HTTP error: bad $what: " .. quote($name);
    }
}

// Whether $text is an RFC 9110 token: one or more letters, digits and !#$%&'*+-.^_`|~
fn is_token($text) {
    if ($text == "") {
        return false;
    }
    foreach (split($text, "") as $c) {
        if (!is_alnum($c) && !contains('!#$%&\'*+-.^_`|~', $c)) {
            return false;
        }
    }
    return true;
}

const REASONS = {
    100 => "Continue", 200 => "OK", 201 => "Created", 202 => "Accepted", 204 => "No Content",
    301 => "Moved Permanently", 302 => "Found", 303 => "See Other", 304 => "Not Modified",
    307 => "Temporary Redirect", 308 => "Permanent Redirect", 400 => "Bad Request",
    401 => "Unauthorized", 403 => "Forbidden", 404 => "Not Found", 405 => "Method Not Allowed",
    408 => "Request Timeout", 409 => "Conflict", 410 => "Gone", 413 => "Content Too Large",
    415 => "Unsupported Media Type", 417 => "Expectation Failed", 422 => "Unprocessable Content",
    429 => "Too Many Requests", 431 => "Request Header Fields Too Large",
    500 => "Internal Server Error", 501 => "Not Implemented", 502 => "Bad Gateway",
    503 => "Service Unavailable", 504 => "Gateway Timeout", 505 => "HTTP Version Not Supported",
};
const SERVER_OPTIONS = {
    "timeout" => 10, "request_timeout" => 30, "max_body" => 1048576, "max_requests" => null,
    "idle_timeout" => 5, "requests_per_connection" => 100, "access_log" => true,
    "handler_timeout" => 10, "header_timeout" => 10,
};
const LONGEST_HANDLER_TIMEOUT = 100000000;   // seconds, worker_deadline()'s own ceiling: three years
const MAX_EMPTY_LINES = 4;  // skipped before a request line, as RFC 9112 asks; more is a 400
const YIELD_GRACE = 0.01;    // seconds an idle connection's client has before its worker gives way
const TURN = 0.05;           // seconds a connection keeps its worker from a waiting client, at least
const HOT_GAP = 0.005;       // a client that asks again within this of a response is kept on
const CROWDED = 5;           // seconds a worker hands over at responses after giving way while idle
const OWN_CLIENT = 0;        // socket_wait()'s answer for an idle connection's own socket
const DAY_NAMES = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const MONTH_NAMES = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

/*
 * A request's method and target as the access log shows them, set once its line is read: kept
 * apart from the request map so that a request refused after its line (a 413, a 408) is logged
 * with them, and one refused before it with "-"
 */
kind RequestLine {
    pub #method = null;
    pub #target = null;
    #shown = null;

    // The method and target as the log shows them, worked out once for a deadline's line and the real one
    pub fn logged() {
        #shown ??= logged_text(#method, LOGGED_METHOD) .. " " .. logged_text(#target, LOGGED_TARGET);
        return #shown;
    }
}

// A request refused before the handler sees it, with the status to answer
kind Refusal extends Error {
    fn _(pub #status, $message) {
        ##_($message);
    }
}

/**
 * The server: http::serve($listener, $handler, $options = {}) answers connections on a
 * socket_listen() listener for ever, each request by calling $handler($request) with
 *
 *   {"method" => "GET", "path" => "/users/7", "query" => "tab=posts", "headers" => {...}, "body" => "",
 *    "remote_address" => "192.0.2.7"}
 *
 * (header names lowercased, a repeated header's values joined with ", ", the path and query as they
 * came, not decoded; "remote_address" the connection's peer, or null if it is no longer known,
 * which behind a proxy is the proxy: see client_address()) and writing what it returns, a map of "status" (200 if left out), "headers"
 * and "body" (a string, "" if left out, or a template's Html, which is text/html unless a
 * Content-Type says otherwise). A header's value is a string, or a list of strings to write it as
 * that many lines (Set-Cookie, which RFC 6265 forbids joining with a comma). With workers() first,
 * each worker serves on its own.
 *
 * - A request that isn't well formed HTTP/1.x is answered 400 (431 for a head over 64KB, 413 for a
 *   body over "max_body", 501 for a transfer coding other than chunked, 505 for another HTTP
 *   version) without calling the handler. One with both Content-Length and Transfer-Encoding is
 *   refused too, as the way requests are smuggled past a proxy.
 * - A handler that raises, or returns what can't be written (a header with a line break in it, a
 *   Content-Length of its own), is answered 500, and the error goes to standard error with its
 *   trace and its causes (`#cause`), as gaz shows an uncaught one. The exception is what query(),
 *   query_all(), form() and form_all() refuse, with no default given (a bad escape, text that
 *   isn't UTF-8, a body that isn't a form): that is answered 400 with nothing logged, as the
 *   client's mistake, whoever built the request map they were given.
 * - Content-Length and Date are written here, and so is Connection: close when the connection is
 *   about to close; a handler may ask for that with a Connection header of "close", and any other
 *   Connection header of its own is an error. No Content-Type unless given.
 * - A HEAD request gets the headers the body would have, without it.
 * - A connection is kept open for the next request (HTTP/1.1's keep-alive) unless the request is
 *   HTTP/1.0 or says Connection: close, it was refused or the handler failed (the bytes after it
 *   can't be trusted to start a request), the handler asked to close, or it was the connection's
 *   "requests_per_connection"th, the worker's last before "max_requests", one while it retires
 *   (see serve()), or one handed over to a client waiting for a worker (see Turns). Up to four
 *   empty lines before a request line are skipped. A connection that sends nothing, before its
 *   first request or between two, is closed without a word once its wait is over, or sooner when a
 *   new client is waiting for a worker (see another_request()).
 * - Options: "timeout", seconds each read and write may wait, and a connection's first request
 *   (10); "request_timeout", seconds a whole request may take to arrive (30), after which it is
 *   answered 408, so a client trickling a byte at a time can't hold a worker; "header_timeout",
 *   seconds its request line and headers may take, out of those (10, at most "request_timeout",
 *   null for only "request_timeout"), also a 408, and the body then has what is left of
 *   "request_timeout"; both start when a connection is taken for its first request, and when a
 *   later request's first byte comes; "max_body", in bytes
 *   (1MB); "idle_timeout", seconds to wait for a connection's next request (5);
 *   "requests_per_connection" (100; 1 never keeps one open); "max_requests" (see serve());
 *   "access_log", true for a line on standard error for each request answered (see
 *   access_line()), false for none; and "handler_timeout", seconds the handler may take (10, at most
 *   100000000, null for no limit), after which the client is answered 503 and the worker ends, for
 *   the master to start another. The deadline needs workers(): in a single process nobody would
 *   start another, so there is none. A stop or a hand-over still gives a worker only 10 seconds,
 *   so a longer handler_timeout can be cut short by one.
 * - It returns when its worker is asked to stop (SIGTERM, see workers()), once the request in hand
 *   is answered.
 * - In production, run it behind a reverse proxy that buffers whole requests (nginx, Caddy): a
 *   worker answers one connection at a time, so without one, each client sending slowly holds a
 *   worker for up to "header_timeout", or "request_timeout" with a body. TLS is the proxy's job too.
 * - ponytail: writing the response has only the per-write timeout.
 */
pub fn serve($listener, $handler, $options = {}) {
    $options = server_options($options);
    // PHP-FPM's pm.max_requests: retiring a worker after N requests throws away whatever state it
    // built up over its life, belt and suspenders next to the process boundary between workers
    $max_requests = $options["max_requests"];
    /*
     * Requests answered, not connections accepted: a connection may carry more than one request
     * once it is kept open, and a limit on requests is what retiring a worker is about. A
     * connection that closes before asking anything counts for nothing.
     */
    $served = 0;
    /*
     * Once it has answered that many, a worker retires by handing over (worker_retire()): it serves
     * on, a request to a connection so it can leave at any moment, until its replacement is ready
     * and it is asked to stop, and then recycles. Outside workers() there is no one to hand over
     * to, and it recycles at once.
     */
    $retiring = false;
    $turns = Turns($listener);
    // Null once a worker is asked to stop: the request in hand has been answered
    while (($socket = socket_accept($listener, $options["timeout"])) != null) {
        $left = $max_requests == null ? null : $max_requests - $served;
        if ($retiring) {
            $left = 1;
        }
        $served += connection($socket, $turns, $handler, $options, $left);
        if (!$retiring && $max_requests != null && $served >= $max_requests) {
            $retiring = true;
            if (!worker_retire()) {
                worker_recycle();
            }
        }
    }
    if ($retiring) {
        worker_recycle();
    }
}

/**
 * One connection: its requests read and answered, and the connection closed, whatever happens
 */
pub fn handle($socket, $handler, $options = {}) {
    connection($socket, Turns(null), $handler, server_options($options), null);
}

/*
 * Answer the requests on a connection, then close it, whatever happens; gives how many were
 * answered. $left is how many more this worker may answer (null: no limit), and $turns how the
 * worker shares itself with the clients waiting on its listener (see Turns).
 */
fn connection($socket, $turns, $handler, $options, $left) {
    $most = $options["requests_per_connection"];
    if ($left != null) {
        $most = min($most, $left);
    }
    $answered = 0;
    $accepted = monotonic_time();
    try {
        $reader = Reader($socket);
        $address = remote_address($socket);
        $keep = true;
        while ($keep) {
            if ($answered > 0 && !another_request($reader, $socket, $turns, $options)) {
                break;
            }
            $last = $answered + 1 == $most || $turns.hands_over($accepted);
            $line = RequestLine();
            $answer = answer($reader, $socket, $handler, $address, $options, $last, $line);
            if ($answer == null) {
                break;
            }
            [$bytes, $keep] = $answer;
            $answered++;
            $sent = send_quietly($socket, $bytes);
            if ($options["access_log"]) {
                // From the request's first byte, so a wait before it counts for no request
                $seconds = monotonic_time() - $reader.first_byte_at();
                // One print_error(), which is one write, so lines from several workers never mix
                print_error(access_line($line, $address, $bytes, $seconds, LogClock::now()) .. "\n");
            }
            if (!$sent) {
                break;
            }
        }
    } finally {
        socket_close($socket);
    }
    return $answered;
}

/*
 * Whether a kept-open connection has another request coming: one already read in part (pipelined)
 * is answered at once, and otherwise the wait is "idle_timeout", or less if the worker is asked to
 * stop, which socket_wait() notices within a second.
 *
 * An idle connection would hold a whole worker, so the worker watches its listener too, and gives
 * the connection up when a new client is waiting there that no free worker takes: it gives its own
 * client a grace to say something first, then looks again, and a client still waiting means none
 * is free. The grace is between one and two times YIELD_GRACE, drawn by each worker (the generator
 * is seeded again in each), since idle workers that all looked again at the same moment would all
 * see the client still waiting and all give up their connections: with four idle workers and one
 * new client, two or three did, where one is enough. A worker whose clients ask again at once
 * (Turns.patience()) waits until the connection has been idle for a TURN, since such a client is
 * likelier to be late than gone.
 *
 * Closing an idle connection races with a request its client sends at that moment, which then
 * meets the end, or a reset, and no response: HTTP/1.1 has no way to say "don't" to an idle
 * client. So the worker looks at its own client once more just before closing, which halves how
 * often that happens, and closes at once; and having given way it hands over at responses instead
 * for a while (Turns.hands_over()), where a Connection: close leaves nothing to race.
 *
 * ponytail: a request pipelined before a stop is still answered (bounded by
 * "requests_per_connection" and the master's grace), and a response written after a stop doesn't
 * say Connection: close; a worker_stopping() builtin would let it.
 */
fn another_request($reader, $socket, $turns, $options) {
    // The empty line some clients send after a body is not a request coming
    $reader.drop_empty_lines(MAX_EMPTY_LINES);
    if ($reader.pending()) {
        return true;
    }
    $idle = monotonic_time();
    $deadline = $idle + $options["idle_timeout"];
    $listener = $turns.listener;
    // OWN_CLIENT is this socket's place in the list
    $watched = $listener == null ? [$socket] : [$socket, $listener];
    while (true) {
        $left = $deadline - monotonic_time();
        if ($left <= 0) {
            $turns.went_quiet();
            return false;
        }
        $ready = socket_wait($watched, $left);
        if ($ready == null) {
            $turns.went_quiet();
            return false;
        }
        if ($ready == OWN_CLIENT) {
            $turns.heard_after(monotonic_time() - $idle);
            return true;
        }
        $grace = max(YIELD_GRACE * (1 + rand_float()), $idle + $turns.patience() - monotonic_time());
        if (socket_wait([$socket], $grace) != null) {
            $turns.heard_after(monotonic_time() - $idle);
            return true;
        }
        if (socket_wait([$listener], 0) != null) {
            // The last look, and the close right after it, to leave as little time as there can be
            if (socket_wait([$socket], 0) != null) {
                $turns.heard_after(monotonic_time() - $idle);
                return true;
            }
            socket_close($socket);
            $turns.gave_way();
            return false;
        }
    }
}

/*
 * How a worker shares itself between the connection it keeps open and the clients waiting on its
 * listener for a worker (none for handle(), which has no listener). A worker answers one connection
 * at a time, so a kept-open connection keeps every waiting client out until it closes, and the
 * only moment to close it that races with nothing is a response, which can say Connection: close.
 * So that is where it is given up (hands_over()) when a client is waiting and it has had a TURN,
 * which is a turn each among busy clients, and when the worker has had to give an idle connection
 * up lately (CROWDED) and its clients pause before asking again, which is when an idle connection
 * would otherwise be given up while idle, in the race another_request() describes. A client that
 * asks again within HOT_GAP keeps its connection: a connection per request would cost such
 * clients a third of their throughput (measured with wrk), and they are the ones least likely to
 * be idle when a worker is needed.
 */
kind Turns {
    // Whether this worker's last kept-open client asked again within HOT_GAP
    #hot = true;
    // When this worker last gave an idle connection up to a waiting client
    #gave_way_at = null;

    fn _(pub #listener) {
    }

    // Whether the response about to be written on a connection accepted at $accepted closes it
    pub fn hands_over($accepted) {
        if (#listener == null) {
            return false;
        }
        $now = monotonic_time();
        if (!#hot && #gave_way_at != null && $now - #gave_way_at < CROWDED) {
            return true;
        }
        return $now - $accepted >= TURN && socket_wait([#listener], 0) != null;
    }

    // How long an idle connection is kept from a waiting client, at least
    pub fn patience() {
        return #hot ? TURN : 0;
    }

    pub fn heard_after($seconds) {
        #hot = $seconds < HOT_GAP;
    }

    pub fn went_quiet() {
        #hot = false;
    }

    pub fn gave_way() {
        #hot = false;
        #gave_way_at = monotonic_time();
    }
}

/*
 * The next request on a connection read and answered: [the response's bytes, whether to keep
 * the connection open for another], or null if it closed, or went quiet, before asking anything.
 * $last says the connection closes after this one whatever the request says, and $line is given
 * the request's method and target for the access log once they are read.
 */
fn answer($reader, $socket, $handler, $address, $options, $last, $line = RequestLine()) {
    start_reading($reader, $options);
    try {
        $read = read_request($reader, $socket, $address, $options["max_body"], $line);
    } catch (Error $e) {
        // Refused, cut off, timed out or malformed: say so, unless nothing came at all
        if (!$reader.heard_anything()) {
            return null;
        }
        $status = is_a($e, Refusal) ? $e.status : 400;
        return [refusal($status), false];
    }
    if ($read == null) {
        return null;
    }
    [$request, $persistent] = $read;
    $close = $last || !$persistent;
    $head = $request["method"] == "HEAD";
    $limit = $options["handler_timeout"];
    try {
        // In the try, so anything it raises is a 500 rather than the end of the worker
        set_deadline($socket, $limit, $head, $line, $address, $options["access_log"]);
        return write_response($handler($request), $head, $close);
    } catch (Undecodable $e) {
        // The client's own request, which a decoder refused: a 400, and nothing for the log
        return [refusal(400, $head), false];
    } catch (Error $e) {
        print_error(error_prefix($request) .. describe_error($e) .. "\n");
    } catch ($e) {
        print_error(error_prefix($request) .. "the handler raised $e\n");
    } finally {
        // Whatever happened, so no timer is left to end the worker in its next request's wait
        clear_deadline($socket, $limit);
    }
    return [refusal(500, $head), false];
}

/*
 * The request's deadlines, from now: when answer() starts, which is when the connection is taken
 * for its first request and when the next one's first byte is seen (or the response before it is
 * written, if it was already read) for the rest, since the wait between requests is idle_timeout's.
 * The head has "header_timeout", the whole request "request_timeout".
 */
fn start_reading($reader, $options) {
    $now = monotonic_time();
    $deadline = $now + $options["request_timeout"];
    $head_limit = $options["header_timeout"];
    $reader.start($head_limit == null ? $deadline : $now + $head_limit, $deadline);
}

/*
 * The handler's deadline ("handler_timeout"), set just before it is called: past it the worker
 * writes a 503 to the client, the access log's line for it to standard error, and ends, and the
 * master starts another (worker_deadline()). Nothing has been written to the client by then, since
 * connection() sends the response once answer() returns, so the 503 is the whole of what it hears.
 * Outside workers() it does nothing, there being nobody to start another worker; so too for
 * http::TestClient, which has no socket.
 */
fn set_deadline($socket, $limit, $head, $line, $address, $logged) {
    if ($socket == null || $limit == null) {
        return;
    }
    [$answer, $tail] = TimedOut::parts($head, $limit);
    $log = "";
    if ($logged) {
        // access_line() but for the tail, which is the same for every request with this limit
        $log = LogClock::later($limit) .. " " .. ($address ?? "-") .. " " .. $line.logged() .. $tail;
    }
    worker_deadline($socket, $limit, $answer, $log);
}

fn clear_deadline($socket, $limit) {
    if ($socket != null && $limit != null) {
        worker_deadline($socket, 0);
    }
}

/*
 * The 503 a handler past its deadline is answered with, and the end of its access line (its status,
 * bytes and the deadline as its time taken), made once for a HEAD and once for the rest, and again
 * only if the limit changes. No Date header (RFC 9110 lets a 5xx leave it out): one written when
 * the deadline is set would be stale by the time it is sent.
 */
kind TimedOut {
    static #limit = null;
    static #made = {};

    // [the 503's bytes, the end of its access line with its line end]
    pub static fn parts($head, $limit) {
        if ($limit != #limit) {
            #limit = $limit;
            #made = {};
        }
        $key = $head ? "HEAD" : "other";
        #made[$key] ??= TimedOut::make($head, $limit);
        return #made[$key];
    }

    static fn make($head, $limit) {
        $answer = refusal(503, $head, false);
        return [$answer, access_tail($answer, $limit) .. "\n"];
    }
}

// How a 500's line on standard error starts, the method and path escaped as the access log's are
fn error_prefix($request) {
    $method = logged_text($request["method"], LOGGED_METHOD);
    $path = logged_text($request["path"], LOGGED_TARGET);

    return "http::serve: $method $path: ";
}

fn server_options($given) {
    $options = with_defaults("http::serve()", $given, SERVER_OPTIONS);
    $idle = $options["idle_timeout"];
    if (!in_array(type_of($idle), ["int", "float"]) || $idle <= 0) {
        throw "http::serve() expects an idle_timeout above 0 seconds, got " .. quote($idle);
    }
    $whole = $options["request_timeout"];
    if (!in_array(type_of($whole), ["int", "float"]) || $whole <= 0) {
        throw "http::serve() expects a request_timeout above 0 seconds, got " .. quote($whole);
    }
    $options["header_timeout"] = header_timeout($given, $options["header_timeout"], $whole);
    $most = $options["requests_per_connection"];
    if (type_of($most) != "int" || $most < 1) {
        throw "http::serve() expects a requests_per_connection of 1 or more, got " .. quote($most);
    }
    if (type_of($options["access_log"]) != "bool") {
        throw "http::serve() expects an access_log of true or false, got " .. quote($options["access_log"]);
    }
    $limit = $options["handler_timeout"];
    $number = in_array(type_of($limit), ["int", "float"]);
    if ($limit != null && (!$number || $limit <= 0 || $limit > LONGEST_HANDLER_TIMEOUT)) {
        $range = "above 0 seconds and at most " .. LONGEST_HANDLER_TIMEOUT;
        throw "http::serve() expects a handler_timeout $range, or null, got " .. quote($limit);
    }
    return $options;
}

/*
 * The head's deadline, which can't be later than the whole request's: one given that is would never
 * be reached, so it is refused as a mistake, while the default gives way to a shorter
 * request_timeout, so that setting request_timeout alone is never an error
 */
fn header_timeout($given, $limit, $whole) {
    if (!has_key($given, "header_timeout")) {
        return min($limit, $whole);
    }
    $number = in_array(type_of($limit), ["int", "float"]);
    if ($limit != null && (!$number || $limit <= 0 || $limit > $whole)) {
        $range = "above 0 seconds and at most the request_timeout ($whole)";
        throw "http::serve() expects a header_timeout $range, or null, got " .. quote($limit);
    }
    return $limit;
}

const LOGGED_METHOD = 20;    // bytes of a method the access log shows, escapes included
const LOGGED_TARGET = 360;   // and of a target, so a line fits the 512 bytes a pipe writes whole
// The bytes the access log writes as they are: printable ASCII, "!" to "~", but the backslash
const LOGGED_AS_IS = "!\"#\$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[]^_`abcdefghijklmnopqrstuvwxyz\{|}~";

/*
 * The access log's time, written out once a second rather than for every request: one clock for
 * now, and one for the second a handler's deadline would pass, which its line is stamped with
 */
kind LogClock {
    static #current = null;
    static #ahead = null;
    #second = null;
    #text = "";

    pub static fn now() {
        #current ??= LogClock();
        return #current.at(time());
    }

    pub static fn later($seconds) {
        #ahead ??= LogClock();
        return #ahead.at(to_int(time() + $seconds));
    }

    pub fn at($second) {
        if ($second != #second) {
            #second = $second;
            #text = date::utc().at($second).rfc3339();
        }

        return #text;
    }
}

/*
 * The access log's line for a request answered with $bytes, from $address, $seconds after its first
 * byte came, at $time (as LogClock writes it), without its line end:
 *
 *   2026-10-07T14:02:09Z 192.0.2.7 GET /search?q=gaz 200 1234 0.412ms
 *
 * the time (UTC), the client's address, the method and target as the request line gave them, the
 * status, the body's length in bytes as sent (0 for a HEAD), and the milliseconds taken. Fields are
 * split by single spaces and none holds one; what isn't known (no address, a request line that
 * couldn't be read) is "-". The address is the connection's peer, a proxy's behind one: the
 * X-Forwarded-For header is the client's to write, and only the program knows which proxies to
 * trust (client_address()).
 */
fn access_line($line, $address, $bytes, $seconds, $time) {
    return "$time " .. ($address ?? "-") .. " " .. $line.logged() .. access_tail($bytes, $seconds);
}

// The end of an access line, from the status on: " 200 1234 0.412ms"
fn access_tail($bytes, $seconds) {
    $status = slice($bytes, len("HTTP/1.1 "), 3);
    $body = len($bytes) - index_of($bytes, "\r\n\r\n") - 4;
    $milliseconds = milliseconds_text($seconds);

    return " $status $body {$milliseconds}ms";
}

/*
 * Seconds as milliseconds to three places, "0.412" or "1500.000", from whole microseconds: writing
 * out a float costs more than the rest of the line together
 */
fn milliseconds_text($seconds) {
    $micros = to_int(round($seconds * 1000000));
    $fraction = to_string($micros % 1000);

    return intdiv($micros, 1000) .. "." .. repeat("0", 3 - len($fraction)) .. $fraction;
}

/*
 * Text from a request as the access log shows it, so a request can't write a line of its own, a
 * terminal's escape or anything that isn't plain ASCII into the log: every byte but the printable
 * ASCII ones from "!" to "~" is written \xHH, and so is a backslash, so an escape always means one.
 * Text that runs past $most bytes is cut off at a whole escape and ends "\..."; null or "" is "-".
 */
fn logged_text($text, $most) {
    if ($text == null || $text == "") {
        return "-";
    }
    // The common case, nothing to escape, in one pass in C: trim() takes away every byte that stays
    if (len($text) <= $most && trim($text, LOGGED_AS_IS) == "") {
        return $text;
    }
    $shown = "";
    foreach (split($text, "") as $c) {
        $piece = logged_byte($c);
        if (len($shown) + len($piece) > $most) {
            return $shown .. "\\...";
        }
        $shown ..= $piece;
    }
    return $shown;
}

fn logged_byte($c) {
    $byte = ord($c);
    if ($byte < 33 || $byte > 126 || $c == "\\") {
        return "\\x" .. HEX[intdiv($byte, 16)] .. HEX[$byte % 16];
    }
    return $c;
}

/*
 * The address of the client on a connection, as socket_peer() writes it, or null: a client that has
 * already gone may no longer be known to the system, and a handler is not to fail for that. Behind a
 * proxy this is the proxy's address; the client's is in its X-Forwarded-For header, which only the
 * program knows whether to trust.
 */
fn remote_address($socket) {
    try {
        return socket_peer($socket)["address"];
    } catch (Error $e) {
        return null;
    }
}

/*
 * The request on a connection from $address and whether its client would keep the connection
 * open after it, or null if it closed before sending anything; its method and target go into
 * $request_line as soon as they are read
 */
fn read_request($reader, $socket, $address, $max_body, $request_line) {
    $reader.skip_empty_lines(MAX_EMPTY_LINES);
    $head = $reader.line("\r\n\r\n", MAX_HEAD);
    if ($head == null) {
        if ($reader.pending()) {
            throw Refusal(400, "HTTP error: the connection closed in the middle of the head");
        }
        return null;
    }
    $reader.head_read();
    $lines = split($head, "\r\n");
    // "GET /path?query HTTP/1.1"
    $words = split($lines[0], " ");
    if (len($words) != 3) {
        throw Refusal(400, "HTTP error: bad request line");
    }
    [$method, $target, $version] = $words;
    $request_line.method = $method;
    $request_line.target = $target;
    if ($version != "HTTP/1.1" && $version != "HTTP/1.0") {
        throw Refusal(starts_with($version, "HTTP/") ? 505 : 400, "HTTP error: bad version");
    }
    check_request_token($method);
    if (!(starts_with($target, "/") || $target == "*" && $method == "OPTIONS") || has_control($target)) {
        throw Refusal(400, "HTTP error: bad request target");
    }
    $headers = {};
    foreach (slice($lines, 1) as $line) {
        $colon = index_of($line, ":");
        if ($colon == null || has_control($line, true)) {
            throw Refusal(400, "HTTP error: bad header line");
        }
        // No space before the colon, and no line folded onto the one before
        $name = lower(slice($line, 0, $colon));
        check_request_token($name);
        $value = trim(slice($line, $colon + 1));
        $headers[$name] = has_key($headers, $name) ? $headers[$name] .. ", " .. $value : $value;
    }
    if ($version == "HTTP/1.1" && !has_key($headers, "host")) {
        throw Refusal(400, "HTTP error: no Host header");
    }
    $query = index_of($target, "?");
    $request = {
        "method" => $method,
        "path" => $query == null ? $target : slice($target, 0, $query),
        "query" => $query == null ? "" : slice($target, $query + 1),
        "headers" => $headers,
        "body" => "",
        "remote_address" => $address,
    };
    $chunked = has_key($headers, "transfer-encoding");
    $length = has_key($headers, "content-length") ? content_length($headers["content-length"]) : 0;
    if ($chunked && has_key($headers, "content-length")) {
        throw Refusal(400, "HTTP error: both Content-Length and Transfer-Encoding");
    }
    if ($chunked && lower($headers["transfer-encoding"]) != "chunked") {
        throw Refusal(501, "HTTP error: a transfer coding other than chunked");
    }
    if ($length > $max_body) {
        throw Refusal(413, "HTTP error: a body of more than $max_body bytes");
    }
    $persistent = keeps_open($version, $headers);
    if (!$chunked && $length == 0) {
        return [$request, $persistent];
    }
    // A client that waits to hear the body is wanted before sending it
    if (has_key($headers, "expect")) {
        if (lower($headers["expect"]) != "100-continue") {
            throw Refusal(417, "HTTP error: an expectation other than 100-continue");
        }
        if ($socket != null) {
            socket_write($socket, "HTTP/1.1 100 Continue\r\n\r\n");
        }
    }
    $request["body"] = $chunked ? read_chunked($reader, $max_body) : $reader.bytes($length);
    return [$request, $persistent];
}

// Whether a client would keep its connection open: HTTP/1.1's default, unless it says close
fn keeps_open($version, $headers) {
    if ($version == "HTTP/1.0") {
        return false;
    }
    // Repeated Connection headers came joined with ", "
    foreach (split($headers["connection"] ?? "", ",") as $option) {
        if (lower(trim($option)) == "close") {
            return false;
        }
    }
    return true;
}

fn check_request_token($name) {
    try {
        check_token("token", $name);
    } catch (Error $e) {
        throw Refusal(400, $e.message);
    }
}

// Whether a string has a byte below 33 or DEL (with $spaces, a space or tab is fine)
fn has_control($text, $spaces = false) {
    foreach (split($text, "") as $c) {
        $byte = ord($c);
        if (($byte < 33 || $byte == 127) && !($spaces && ($c == " " || $c == "\t"))) {
            return true;
        }
    }
    return false;
}

/*
 * A handler's response, which is checked as a request's headers are: [its bytes, whether the
 * connection stays open after it]. It closes if $close says so or the handler asked to, and then
 * says Connection: close, which this is the one place to write.
 */
fn write_response($response, $head, $close = true, $dated = true) {
    if (type_of($response) != "map") {
        throw "the handler returned " .. type_of($response) .. ", not a map of status, headers and body";
    }
    foreach ($response as $key => $value) {
        if (!in_array($key, ["status", "headers", "body"])) {
            throw "a response has status, headers and body, not " .. quote($key);
        }
    }
    $status = $response["status"] ?? 200;
    $body = $response["body"] ?? "";
    $headers = $response["headers"] ?? {};
    if (type_of($status) != "int" || $status < 200 || $status > 599) {
        throw "a response's status must be an int from 200 to 599, got " .. quote($status);
    }
    if (type_of($headers) != "map") {
        throw "a response's headers must be a map, got " .. type_of($headers);
    }
    if (is_html($body)) {
        $headers = with_html_type($headers);
        $body = to_string($body);
    }
    if (type_of($body) != "string") {
        throw "a response's body must be a string or Html, got " .. type_of($body);
    }
    $bodiless = $status == 204 || $status == 304;
    if ($bodiless && $body != "") {
        throw "a $status response has no body";
    }
    $lines = [];
    foreach ($headers as $name => $value) {
        check_token("header name", $name);
        if (lower($name) == "connection") {
            check_close($name, $value);
            $close = true;
            continue;
        }
        if (in_array(lower($name), ["content-length", "transfer-encoding", "date"])) {
            throw "HTTP error: header $name is written by http::serve";
        }
        // A list writes one line per value, since a repeated header (Set-Cookie above all,
        // whose values RFC 6265 forbids joining with a comma: an Expires attribute has one of
        // its own) needs more than one line; anything else is the one value it always was.
        foreach (type_of($value) == "list" ? $value : [$value] as $one) {
            $one = to_string($one);
            if (contains($one, "\r") || contains($one, "\n") || contains($one, "\0")) {
                throw "HTTP error: header $name has a line break or NUL byte in its value";
            }
            $lines[] = "$name: $one";
        }
    }
    if (!$bodiless) {
        $lines[] = "Content-Length: " .. len($body);
    }
    $first = [status_line($status)];
    if ($dated) {
        $first[] = "Date: " .. http_date(time());
    }
    if ($close) {
        $first[] = "Connection: close";
    }
    $bytes = join([...$first, ...$lines], "\r\n") .. "\r\n\r\n" .. ($head ? "" : $body);
    return [$bytes, !$close];
}

// A handler's own Connection header may only ask for the connection to close
fn check_close($name, $value) {
    if (type_of($value) != "string" || lower(trim($value)) != "close") {
        throw "HTTP error: header $name is written by http::serve; a handler may only give \"close\"";
    }
}

// A template's result, the builtin kind Html (which only a program using it has)
fn is_html($body) {
    return type_of($body) == "object" && kind_name($body) == "Html";
}

// An Html body is text/html unless the handler said otherwise
fn with_html_type($headers) {
    foreach (keys($headers) as $name) {
        if (lower($name) == "content-type") {
            return $headers;
        }
    }
    $headers["Content-Type"] = "text/html; charset=utf-8";

    return $headers;
}

/*
 * A response the server writes itself, the status and its reason as plain text, before it closes;
 * $dated false leaves out the Date header
 */
fn refusal($status, $head = false, $dated = true) {
    $text = (REASONS[$status] ?? "Error") .. "\n";
    $response = {"status" => $status, "headers" => {"Content-Type" => "text/plain"}, "body" => $text};
    return write_response($response, $head, true, $dated)[0];
}

fn status_line($status) {
    return "HTTP/1.1 $status " .. (REASONS[$status] ?? "");
}

/*
 * Sent if the other end still listens; a client that has gone away is no error of the server's.
 * Gives whether it was sent.
 */
fn send_quietly($socket, $bytes) {
    try {
        socket_write($socket, $bytes);
    } catch (Error $e) {
        return false;
    }
    return true;
}

// How many causes a 500's log shows before saying how many more there are, as gaz itself does
const MAX_CAUSES = 10;

/*
 * A handler's error as the log shows it: the message and where, its calls, then what caused it,
 * in the shape gaz gives an uncaught error's causes (report() in vm/vm.c), so a log reads as a
 * crash does
 */
fn describe_error($e) {
    $where = $e.file == null ? "line {$e.line}" : "{$e.file}:{$e.line}";
    return "{$e.message} at $where" .. describe_calls($e.trace) .. describe_causes($e);
}

// A trace's calls, each on a line of its own, indented; only strings, as a program can set #trace
fn describe_calls($trace) {
    $text = "";
    if (type_of($trace) != "list") {
        return $text;
    }
    foreach ($trace as $call) {
        if (type_of($call) == "string") {
            $text ..= "\n  $call";
        }
    }
    return $text;
}

/*
 * The chain of causes under an error: each until one that is null or not an Error, or one
 * already walked (a chain can loop back), the first MAX_CAUSES shown and the rest counted.
 * ponytail: in_array() searches from the start for each cause, so a chain of n costs n^2.
 */
fn describe_causes($e) {
    $seen = [$e];
    $walked = 0;
    $text = "";
    $cause = $e.cause ?? null;
    while ($cause != null) {
        $is_error = is_error($cause);
        if ($is_error && in_array($cause, $seen)) {
            if ($walked <= MAX_CAUSES) {
                $text ..= "\nCaused by: an error shown above, so the causes go round in a loop";
            }
            break;
        }
        if ($walked < MAX_CAUSES) {
            $text ..= describe_cause($cause);
        }
        $walked++;
        if (!$is_error) {
            break;
        }
        $seen[] = $cause;
        $cause = $cause.cause ?? null;
    }
    if ($walked > MAX_CAUSES) {
        $more = $walked - MAX_CAUSES;
        $text ..= "\n... $more more " .. ($more == 1 ? "cause" : "causes");
    }
    return $text;
}

// One cause: the value as echo prints it, then an Error's calls, even one, as no message says where
fn describe_cause($cause) {
    try {
        $shown = to_string($cause);
    } catch ($e) {
        $shown = "(a value whose to_string() failed)";
    }
    $calls = is_error($cause) ? describe_calls($cause.trace ?? null) : "";
    return "\nCaused by: $shown" .. $calls;
}

fn is_error($value) {
    return type_of($value) == "object" && is_a($value, Error);
}

const REDIRECT_STATUSES = [301, 302, 303, 307, 308];

/**
 * A response that sends the client somewhere else: `return http::redirect("/login");`. 303 See
 * Other is the default, which a browser follows with a GET, as a form's POST wants; 301 and 308
 * are the permanent moves, 302 and 307 the temporary ones that keep the method as 308 does. $to
 * is written as given, so a path of your own is safe, and one from a request (a `next` parameter)
 * must be checked by the caller, or it is an open redirect. A $to with a line break or a NUL byte
 * is an error here, where it would otherwise be a 500 while the response is written.
 */
pub fn redirect(string $to, int $status = 303): map {
    if ($to == "") {
        throw "http::redirect() needs somewhere to go, got an empty string";
    }
    if (contains($to, "\r") || contains($to, "\n") || contains($to, "\0")) {
        throw "http::redirect() can't send a location with a line break or NUL byte in it";
    }
    if (!in_array($status, REDIRECT_STATUSES)) {
        throw "http::redirect() expects a status of " .. join(REDIRECT_STATUSES, ", ") .. ", got " .. $status;
    }

    return {"status" => $status, "headers" => {"Location" => $to}, "body" => ""};
}

/**
 * Seconds since 1970 as HTTP writes a date: "Sat, 08 Aug 2026 14:02:09 GMT"
 */
pub fn http_date($time) {
    $moment = date::utc().at($time);
    $day = ($moment.day < 10 ? "0" : "") .. $moment.day;
    $date = "{$day} " .. MONTH_NAMES[$moment.month - 1] .. " {$moment.year}";

    return DAY_NAMES[$moment.weekday()] .. ", {$date} " .. $moment.clock() .. " GMT";
}

const CONTENT_TYPES = {
    "html" => "text/html; charset=utf-8", "css" => "text/css", "js" => "text/javascript",
    "json" => "application/json", "png" => "image/png", "jpg" => "image/jpeg",
    "jpeg" => "image/jpeg", "gif" => "image/gif", "svg" => "image/svg+xml",
    "ico" => "image/x-icon", "webp" => "image/webp", "txt" => "text/plain",
    "pdf" => "application/pdf", "woff" => "font/woff", "woff2" => "font/woff2",
    "ttf" => "font/ttf", "wasm" => "application/wasm", "mp4" => "video/mp4",
};

/**
 * A static file server: http::serve_static($dir) is a handler for http::serve() (or a
 * Router's not_found()) that answers from files under $dir.
 *
 * - The path is percent-decoded and split into segments, as a Router's is; a segment of ".."
 *   is refused the same way a missing file is, a 404, rather than resolved and hoped to land
 *   inside $dir: the two look alike to whoever asked, which is the point. So is a segment that
 *   decodes to hold a "/" (%2F is never a separator here), or "..%2f" would be a ".." too.
 * - A path ending in "/", or one naming a directory, looks for "index.html" inside it.
 * - Content-Type comes from the extension (CONTENT_TYPES); anything else is
 *   application/octet-stream.
 * - Every file carries a validator: an ETag, W/"size-mtime" (weak, since a size and a time in
 *   whole seconds can't promise the bytes are the same), and Last-Modified, from file_info(). A GET
 *   or HEAD whose If-None-Match names that tag (or is *) is a 304 with no body; If-Modified-Since is
 *   read only when there is no If-None-Match, and only the date Last-Modified gave counts.
 * - Options: "cache_control", the Cache-Control header ("no-cache": a browser keeps the file but
 *   asks each time, which the ETag makes a cheap 304). A file whose name changes with its contents
 *   (style.3f9a1c.css) can be kept for good: {"cache_control" => "public, max-age=31536000,
 *   immutable"}.
 */
pub fn serve_static($dir, $options = {}) {
    $options = with_defaults("http::serve_static()", $options, STATIC_OPTIONS);

    return $request -> {
        $segments = decoded_segments($request["path"]);
        if ($segments == null || leaves_directory($segments)) {
            return plain(404, "Not Found");
        }
        $path = len($segments) == 0 ? $dir : $dir .. "/" .. join($segments, "/");
        if (ends_with($path, "/")) {
            $path ..= "index.html";
        } else if (is_dir($path)) {
            $path ..= "/index.html";
        }
        // file_info() raises on a name too long or a loop, which file_exists() answers false
        $info = file_exists($path) ? file_info($path) : null;
        if ($info == null || $info["kind"] != "file") {
            return plain(404, "Not Found");
        }
        $validators = {
            "Cache-Control" => $options["cache_control"],
            "ETag" => "W/\"" .. $info["size"] .. "-" .. $info["mtime"] .. "\"",
            "Last-Modified" => http_date($info["mtime"]),
        };
        if (not_modified($request, $validators)) {
            return {"status" => 304, "headers" => $validators, "body" => ""};
        }
        $headers = {"Content-Type" => file_content_type($path), ...$validators};

        return {"status" => 200, "headers" => $headers, "body" => read_file($path)};
    };
}

const STATIC_OPTIONS = {"cache_control" => "no-cache"};

/*
 * Whether a GET or HEAD already holds what $validators describe (RFC 9110, 13.1.2 and 13.1.3):
 * If-None-Match when there is one, compared weakly, else If-Modified-Since.
 * ponytail: If-Modified-Since counts only when it is Last-Modified's own text, which is what a
 * browser sends back; a later date gets a 200, never a wrong 304. Parsing HTTP dates would lift it.
 */
fn not_modified($request, $validators) {
    if (!in_array($request["method"], ["GET", "HEAD"])) {
        return false;
    }
    $headers = $request["headers"];
    $none_match = $headers["if-none-match"] ?? null;
    if ($none_match != null) {
        return names_tag($none_match, $validators["ETag"]);
    }

    return ($headers["if-modified-since"] ?? null) == $validators["Last-Modified"];
}

// Whether an If-None-Match value (a list of tags, or *) names $tag, W/ or not on either side
fn names_tag($list, $tag) {
    if (trim($list) == "*") {
        return true;
    }
    foreach (split($list, ",") as $candidate) {
        if (opaque_tag(trim($candidate)) == opaque_tag($tag)) {
            return true;
        }
    }

    return false;
}

// An entity tag without its W/, which weak comparison ignores
fn opaque_tag($tag) {
    return starts_with($tag, "W/") ? slice($tag, 2) : $tag;
}

// Whether decoded segments could name anything but a path down from the directory: a segment of
// ".." goes up, and a segment holding a "/" (it was %2F) is several, so "..%2f" is a ".." the
// check on whole segments never sees
fn leaves_directory($segments) {
    foreach ($segments as $segment) {
        if ($segment == ".." || contains($segment, "/")) {
            return true;
        }
    }

    return false;
}

// The extension after the last "."; none of the table's is application/octet-stream
fn file_content_type($path) {
    $parts = split($path, ".");
    $extension = len($parts) > 1 ? lower(last($parts)) : "";

    return CONTENT_TYPES[$extension] ?? "application/octet-stream";
}

/**
 * Routing requests to handlers, for http::serve():
 *
 *   $app = http::Router();
 *   $app.get("/users/:id", $request -> ({"body" => "user {$request["params"]["id"]}"}));
 *   $app.post("/users", $create_user);
 *   $app.use(($request, $next) -> $next($request));      // middleware
 *   http::serve($listener, $app.handler());
 *
 * - A pattern is a path whose segments are literal or :name. A :name takes one whole segment,
 *   never an empty one, percent-decoded, into $request["params"]; the handler gets the request
 *   with them in it. A %2F in a segment is a / in its value, never a separator.
 * - The first route added that matches wins.
 * - A path that matches with another method is a 405 with an Allow header; a GET route answers
 *   HEAD too. A path nothing matches is a 404, or what not_found() was given.
 * - A path that only matches with its trailing slash added or taken away is a 308 redirect to
 *   that spelling, so a link written either way works and each page has one URL.
 * - A bad percent-escape in the path is a 400.
 * - Middleware is ($request, $next) -> response, and wraps everything, the 404s included; the
 *   first added is the outermost.
 */
pub kind Router {
    #routes = [];
    #middleware = [];
    #not_found_handler = null;

    /**
     * Route GET requests for paths $pattern matches to $handler (and HEAD requests too)
     */
    pub fn get($pattern, $handler) {
        #add("GET", $pattern, $handler);
    }

    /**
     * Route POST requests for paths $pattern matches to $handler
     */
    pub fn post($pattern, $handler) {
        #add("POST", $pattern, $handler);
    }

    /**
     * Route PUT requests for paths $pattern matches to $handler
     */
    pub fn put($pattern, $handler) {
        #add("PUT", $pattern, $handler);
    }

    /**
     * Route PATCH requests for paths $pattern matches to $handler
     */
    pub fn patch($pattern, $handler) {
        #add("PATCH", $pattern, $handler);
    }

    /**
     * Route DELETE requests for paths $pattern matches to $handler
     */
    pub fn delete($pattern, $handler) {
        #add("DELETE", $pattern, $handler);
    }

    /**
     * Any other method, by name
     */
    pub fn route($method, $pattern, $handler) {
        #add($method, $pattern, $handler);
    }

    /**
     * Add middleware, ($request, $next) -> response, around everything the router does, inside
     * what was added before it
     */
    pub fn use($middleware) {
        #middleware[] = $middleware;
    }

    /**
     * The handler for a path no route matches, instead of a plain 404 (serve_static(), say)
     */
    pub fn not_found($handler) {
        #not_found_handler = $handler;
    }

    /**
     * The function to give http::serve(): the router with its middleware around it
     */
    pub fn handler() {
        $dispatch = $request -> #dispatch($request);
        foreach (reverse(#middleware) as $middleware) {
            $dispatch = wrap($middleware, $dispatch);
        }

        return $dispatch;
    }

    fn add($method, $pattern, $handler) {
        #routes[] = Route($method, $pattern, $handler);
    }

    fn dispatch($request) {
        $segments = decoded_segments($request["path"]);
        if ($segments == null) {
            return plain(400, "Bad Request");
        }

        $allowed = [];
        foreach (#routes as $route) {
            $params = $route.match($segments);
            if ($params == null) {
                continue;
            }
            if ($route.answers($request["method"])) {
                return $route.run($request, $params);
            }
            $allowed[] = $route.method;
        }

        if (len($allowed) > 0) {
            return method_not_allowed($allowed);
        }

        return #elsewhere($request, $segments);
    }

    // No route has this path: its other spelling, or not found
    fn elsewhere($request, $segments) {
        $other = other_spelling($request["path"]);
        if ($other != null && #has_path(decoded_segments($other))) {
            return spelling_redirect($other, $request["query"]);
        }
        if (#not_found_handler != null) {
            return (#not_found_handler)($request);
        }

        return plain(404, "Not Found");
    }

    fn has_path($segments) {
        foreach (#routes as $route) {
            if ($route.match($segments) != null) {
                return true;
            }
        }

        return false;
    }
}

// One route: a method, a pattern cut into segments, and its handler
kind Route {
    #segments;
    #handler;

    fn _(pub #method, $pattern, $handler) {
        #segments = pattern_segments($pattern);
        #handler = $handler;
    }

    // The params the path's segments give this route, or null when it doesn't match
    pub fn match($segments) {
        if (len($segments) != len(#segments)) {
            return null;
        }
        $params = {};
        foreach (#segments as $i => $expected) {
            if (!is_param($expected)) {
                if ($expected != $segments[$i]) {
                    return null;
                }
                continue;
            }
            // A :name takes a whole segment, never an empty one: /users/ is not /users/:id
            if ($segments[$i] == "") {
                return null;
            }
            $params[param_name($expected)] = $segments[$i];
        }

        return $params;
    }

    pub fn answers($method) {
        return $method == #method || $method == "HEAD" && #method == "GET";
    }

    pub fn run($request, $params) {
        $request["params"] = $params;

        return (#handler)($request);
    }
}

// A pattern's segments, checked: "/users/:id" is ["users", ":id"]
fn pattern_segments($pattern) {
    if (type_of($pattern) != "string" || !starts_with($pattern, "/")) {
        throw "A route's pattern starts with /, got " .. quote($pattern);
    }
    $segments = segments($pattern);
    $names = [];
    foreach ($segments as $segment) {
        if (!is_param($segment)) {
            continue;
        }
        $name = param_name($segment);
        if ($name == "") {
            throw "A : in a route's pattern needs a name: $pattern";
        }
        if (in_array($name, $names)) {
            throw "A route's pattern names :$name twice: $pattern";
        }
        $names[] = $name;
    }

    return $segments;
}

// "/users/7" is ["users", "7"], and "/" is []
fn segments($path) {
    if ($path == "/") {
        return [];
    }

    return split(slice($path, 1), "/");
}

// A request path's segments, each percent-decoded, or null when an escape is bad or one isn't UTF-8
fn decoded_segments($path) {
    return decoded(() -> map(segments($path), text_decode), null);
}

fn is_param($segment) {
    return starts_with($segment, ":");
}

fn param_name($segment) {
    return slice($segment, 1);
}

// The path with its trailing slash taken away or added, or null for "/"
fn other_spelling($path) {
    if ($path == "/") {
        return null;
    }
    if (ends_with($path, "/")) {
        return slice($path, 0, -1);
    }

    return $path .. "/";
}

fn wrap($middleware, $next) {
    return $request -> $middleware($request, $next);
}

// The 308 to a path's other spelling, with its query kept
fn spelling_redirect($path, $query) {
    $location = $path;
    if ($query != "") {
        $location ..= "?" .. $query;
    }

    return {"status" => 308, "headers" => {"Location" => $location}, "body" => ""};
}

fn method_not_allowed($methods) {
    $allowed = [];
    foreach ($methods as $method) {
        if (!in_array($method, $allowed)) {
            $allowed[] = $method;
        }
    }
    if (in_array("GET", $allowed)) {
        $allowed[] = "HEAD";
    }
    $response = plain(405, "Method Not Allowed");
    $response["headers"]["Allow"] = join($allowed, ", ");

    return $response;
}

fn plain($status, $text) {
    return {"status" => $status, "headers" => {"Content-Type" => "text/plain"}, "body" => $text .. "\n"};
}

// Decoding what a request carries: percent-escapes, query strings and form bodies

const UNRESERVED = "-._~";
const FORM_TYPE = "application/x-www-form-urlencoded";
const HEX = "0123456789ABCDEF";

/**
 * $text with its percent-escapes undone (%20 is a space), as RFC 3986 has them: a + stays a +.
 * A % that isn't followed by two hex digits is an error, unless $default is given, which is then
 * returned instead. The bytes are given back whatever they are, UTF-8 or not, so url_decode() of
 * a piece of `$request["query"]` or `$request["body"]` is the way to the bytes that query(),
 * form(), cookies() and the router's params refuse. Its error is a plain one, a 500 in a handler,
 * since the text may be the program's own.
 */
pub fn url_decode($text, $default = NoDefault()) {
    try {
        return decoded(() -> percent_decode($text), $default);
    } catch (Undecodable $e) {
        // A plain error, not the request's 400: the text may be the program's own, and a bug is a 500
        throw $e.message;
    }
}

/**
 * $text percent-escaped, url_decode()'s other way: everything but letters, digits and - . _ ~
 * as %XX
 */
pub fn url_encode($text) {
    $encoded = "";
    foreach (split($text, "") as $c) {
        if (is_alnum($c) || contains(UNRESERVED, $c)) {
            $encoded ..= $c;
        } else {
            $encoded ..= percent_escape($c);
        }
    }

    return $encoded;
}

/**
 * The request's query string as a map of strings, decoded: + is a space, as HTML forms send it,
 * and a key given twice keeps its last value (query_all() has them all). A bad percent-escape, or
 * a key or value that isn't UTF-8 once decoded, is an error, unless $default is given, which is
 * then returned instead: the query string is the client's, so `http::query($request, {})` reads
 * one that can't be decoded as an empty one. Uncaught in a handler, the error is a 400.
 */
pub fn query($request, $default = NoDefault()) {
    return decoded(() -> last_values(decode_pairs($request["query"])), $default);
}

/**
 * The request's query string as a map from each key to the list of every value it was given, in
 * order; a bad percent-escape or text that isn't UTF-8 is an error, unless $default is given, as
 * query() has it
 */
pub fn query_all($request, $default = NoDefault()) {
    return decoded(() -> decode_pairs($request["query"]), $default);
}

/**
 * A form body (Content-Type application/x-www-form-urlencoded) as a map of strings, as query()
 * reads a query string. A body of another type, a bad percent-escape, or a key or value that isn't
 * UTF-8 once decoded, is an error, unless $default is given, which is then returned instead:
 * `http::form($request, {})` reads a request that isn't a form as one with no fields. Uncaught in
 * a handler, the error is a 400.
 */
pub fn form($request, $default = NoDefault()) {
    return decoded(() -> last_values(form_pairs($request)), $default);
}

/**
 * A form body as a map from each key to the list of every value it was given, as query_all()
 * reads a query string; a body of another type, a bad percent-escape or text that isn't UTF-8 is
 * an error, unless $default is given, as form() has it
 */
pub fn form_all($request, $default = NoDefault()) {
    return decoded(() -> form_pairs($request), $default);
}

/*
 * What a client sent that can't be decoded: a bad percent-escape, text that isn't UTF-8, or a body
 * that isn't a form. Uncaught in a handler it is a 400, being the client's mistake, so only the
 * decoders that take a request let it out; url_decode() turns it into a plain error.
 */
kind Undecodable extends Error {
    fn _($message) {
        ##_($message);
    }
}

// A $default's own default: only this file can make one, so no value a caller passes is one
kind NoDefault {}

/*
 * What $decode returns, or $default if what it decodes is Undecodable; with no $default given the
 * Undecodable carries on, for serve() to answer 400. Only Undecodable is caught, so a program's own
 * mistake (a request that isn't a map) and running out of call depth are still errors.
 */
fn decoded($decode, $default) {
    try {
        return $decode();
    } catch (Undecodable $e) {
        if (is_a($default, NoDefault)) {
            throw $e;
        }

        return $default;
    }
}

fn percent_decode($text) {
    $decoded = "";
    $at = 0;
    while (true) {
        $percent = index_of($text, "%", $at);
        if ($percent == null) {
            return $decoded .. slice($text, $at);
        }
        $decoded ..= slice($text, $at, $percent - $at) .. escaped_byte($text, $percent);
        $at = $percent + 3;
    }
}

// The byte the escape at $percent stands for: "%41" is "A"
fn escaped_byte($text, $percent) {
    $digits = slice($text, $percent + 1, 2);
    if (len($digits) < 2 || !is_hex_digit($digits[0]) || !is_hex_digit($digits[1])) {
        $escape = slice($text, $percent, 3);
        throw Undecodable("bad percent-escape " .. quote($escape) .. " at $percent");
    }

    return chr(hex_digit($digits[0]) * 16 + hex_digit($digits[1]));
}

fn hex_digit($c) {
    return index_of(HEX, upper($c));
}

fn percent_escape($c) {
    $byte = ord($c);

    return "%" .. HEX[intdiv($byte, 16)] .. HEX[$byte % 16];
}

/*
 * "a=1&b=x+y&a=2" as {"a" => ["1", "2"], "b" => ["x y"]}, keys in the order they first come:
 * empty pieces are skipped, and a piece without = is a key whose value is ""
 */
fn decode_pairs($text) {
    $pairs = {};
    foreach (split($text, "&") as $piece) {
        if ($piece == "") {
            continue;
        }
        [$key, $value] = key_and_value($piece);
        $pairs[$key] ??= [];
        $pairs[$key][] = $value;
    }

    return $pairs;
}

fn key_and_value($piece) {
    $parts = split($piece, "=", 2);
    $key = form_decode($parts[0]);
    $value = "";
    if (len($parts) == 2) {
        $value = form_decode($parts[1]);
    }

    return [$key, $value];
}

// A form's text: + is a space, then percent-escapes
fn form_decode($text) {
    return text_decode(replace($text, "+", " "));
}

// $text percent-decoded, refused unless it is UTF-8: checked after decoding, since %ff is how bad bytes get in
fn text_decode($text) {
    $decoded = percent_decode($text);
    if (!utf8_valid($decoded)) {
        throw Undecodable("text that isn't UTF-8 once decoded");
    }

    return $decoded;
}

fn last_values($all) {
    return map($all, $values -> last($values));
}

fn form_pairs($request) {
    if (media_type($request) != FORM_TYPE) {
        $type = $request["headers"]["content-type"] ?? "";
        throw Undecodable("http::form() needs a body sent as " .. FORM_TYPE .. ", not " .. quote($type));
    }

    return decode_pairs($request["body"]);
}

// The request's Content-Type without its parameters, lowercased
fn media_type($request) {
    $type = $request["headers"]["content-type"] ?? "";

    return lower(trim(split($type, ";")[0]));
}

// multipart/form-data, the body of a form that uploads files (RFC 7578, framed as RFC 2046 has it)

const MULTIPART_TYPE = "multipart/form-data";
const MAX_BOUNDARY = 70;      // RFC 2046's longest
const MAX_PARTS = 1000;       // in one body, so a body of tiny parts can't have a handler build maps without end
const MAX_PART_HEAD = 8192;   // a part's header lines, in bytes, as MAX_HEAD bounds a request's
const TRANSFER_ENCODINGS = ["7bit", "8bit", "binary"];   // a part's bytes as they are, the only ones RFC 7578 allows
const FILE_TYPE = "application/octet-stream";             // a file's Content-Type when its part gives none

/**
 * A multipart/form-data body, what a form with `enctype="multipart/form-data"` sends, as
 * `{"fields" => {...}, "files" => {...}}`. Each text field is a string, as form() gives one, and
 * each file a map:
 *
 *     {"filename" => "beach.jpg", "content_type" => "image/jpeg", "content" => "..."}
 *
 * A name given twice keeps its last value (multipart_all() has them all). "content" is the bytes
 * as the client sent them; "content_type" is the part's own Content-Type, application/octet-stream
 * when it gives none; a file input left empty arrives as a file whose filename and content are "".
 * **Never use "filename" as a path**: it is exactly what the client sent, which can be
 * "../../etc/passwd" or anything else; name the stored file yourself. A quoted filename runs to
 * the next quote with every byte kept, backslashes too, as browsers send them (a quote comes as
 * %22, which stays %22).
 *
 * The whole body is in memory, so "max_body" (http::serve()'s option, 1MB by default) bounds an
 * upload: raise it for a server that takes big files. A body of another type, a malformed one, more
 * than 1000 parts, a field name, filename or text value that isn't UTF-8, a nested multipart body
 * or a filename* parameter (or any parameter with a * in its name) is an error, unless $default is given, which is then returned instead.
 * Uncaught in a handler, the error is a 400.
 */
pub fn multipart($request, $default = NoDefault()) {
    return decoded(() -> map(grouped_parts(multipart_parts($request)), $named -> last_values($named)), $default);
}

/**
 * A multipart/form-data body as multipart() reads it, but with each name's every value, in order:
 * `{"fields" => {"tag" => ["a", "b"]}, "files" => {"photos" => [{...}, {...}]}}`, so the files of
 * an `<input type="file" multiple>` are all there. Errors and $default as multipart() has them.
 */
pub fn multipart_all($request, $default = NoDefault()) {
    return decoded(() -> grouped_parts(multipart_parts($request)), $default);
}

fn grouped_parts($parts) {
    $grouped = {"fields" => {}, "files" => {}};
    foreach ($parts as $part) {
        $group = $part.filename == null ? "fields" : "files";
        $grouped[$group][$part.name] ??= [];
        $grouped[$group][$part.name][] = $part.value();
    }

    return $grouped;
}

fn multipart_parts($request) {
    if (media_type($request) != MULTIPART_TYPE) {
        $type = $request["headers"]["content-type"] ?? "";
        throw Undecodable("http::multipart() needs a body sent as " .. MULTIPART_TYPE .. ", not " .. quote($type));
    }
    [, $parameters] = header_parameters($request["headers"]["content-type"]);
    $boundary = $parameters["boundary"] ?? "";
    if ($boundary == "" || len($boundary) > MAX_BOUNDARY) {
        throw Undecodable("a multipart boundary of 1 to " .. MAX_BOUNDARY .. " bytes, not " .. quote($boundary));
    }

    return MultipartReader($request["body"], $boundary).parts();
}

/*
 * A multipart body read part by part, each boundary found with index_of(), so the time is linear in
 * the body. The preamble before the first boundary and the epilogue after the last are ignored.
 */
kind MultipartReader {
    #body;
    #dash;        // "--boundary", which starts every boundary line
    #at = 0;      // just after the boundary line last read

    fn _($body, $boundary) {
        #body = $body;
        #dash = "--" .. $boundary;
    }

    pub fn parts() {
        #at = #first_boundary();
        $parts = [];
        while (!starts_with(#body, "--", #at)) {
            #end_boundary_line();
            if (len($parts) == MAX_PARTS) {
                throw Undecodable("a multipart body of more than " .. MAX_PARTS .. " parts");
            }
            $end = index_of(#body, "\r\n" .. #dash, #at);
            if ($end == null) {
                throw Undecodable("a multipart body that ends before its closing boundary");
            }
            $parts[] = multipart_part(slice(#body, #at, $end - #at));
            #at = $end + 2 + len(#dash);
        }

        return $parts;
    }

    // Where the first boundary line's boundary ends: at the very start, or after a preamble and CRLF
    fn first_boundary() {
        if (starts_with(#body, #dash)) {
            return len(#dash);
        }
        $start = index_of(#body, "\r\n" .. #dash);
        if ($start == null) {
            throw Undecodable("a multipart body without its boundary");
        }

        return $start + 2 + len(#dash);
    }

    // A boundary line ends in CRLF after optional spaces and tabs; anything else means the boundary was in the content
    fn end_boundary_line() {
        while (#at < len(#body) && contains(" \t", #body[#at])) {
            #at++;
        }
        if (#at == len(#body)) {
            throw Undecodable("a multipart body that ends before its closing boundary");
        }
        if (!starts_with(#body, "\r\n", #at)) {
            throw Undecodable("a multipart boundary line with more after the boundary");
        }
        #at += 2;
    }
}

// One part of a multipart/form-data body: a text field when it has no filename, a file when it has one
kind MultipartPart {
    fn _(pub #name, pub #filename, #content_type, #content);

    // What a handler is given: a field's text, or a file's map
    pub fn value() {
        if (#filename == null) {
            return #content;
        }

        return {"filename" => #filename, "content_type" => #content_type, "content" => #content};
    }
}

// The part whose text, between two boundary lines, is $text: its header lines, an empty line, its content
fn multipart_part($text) {
    [$head, $content] = part_head_and_content($text);
    $headers = part_headers($head);
    $disposition = $headers["content-disposition"] ?? null;
    if ($disposition == null) {
        throw Undecodable("a multipart part without a Content-Disposition");
    }
    [$type, $parameters] = header_parameters($disposition);
    if ($type != "form-data") {
        throw Undecodable("a multipart part whose Content-Disposition is " .. quote($type) .. ", not form-data");
    }
    refuse_extended_parameters($parameters);
    $name = $parameters["name"] ?? "";
    if ($name == "") {
        throw Undecodable("a multipart part without a name");
    }
    $content_type = trim($headers["content-type"] ?? "");
    if (starts_with(lower($content_type), "multipart/")) {
        throw Undecodable("a multipart part that is itself multipart");
    }
    $encoding = lower(trim($headers["content-transfer-encoding"] ?? "binary"));
    if (!in_array($encoding, TRANSFER_ENCODINGS)) {
        throw Undecodable("a multipart part sent as " .. quote($encoding) .. ", not as its bytes");
    }
    $filename = $parameters["filename"] ?? null;
    if ($filename == null && !utf8_valid($content)) {
        throw Undecodable("text that isn't UTF-8");
    }
    if ($content_type == "") {
        $content_type = FILE_TYPE;
    }

    return MultipartPart($name, $filename, $content_type, $content);
}

/*
 * RFC 7578 forbids RFC 5987's filename* and RFC 2231's continuations (filename*0, filename*1, ...),
 * so any name with a * in it: honouring one would be a second decoding to get right, and ignoring
 * it would read a file whose only filename is there as a text field
 */
fn refuse_extended_parameters($parameters) {
    foreach (keys($parameters) as $key) {
        if (contains($key, "*")) {
            throw Undecodable("a multipart part with a " .. quote($key) .. " parameter, which RFC 7578 forbids");
        }
    }
}

fn part_head_and_content($text) {
    if (starts_with($text, "\r\n")) {
        return ["", slice($text, 2)];
    }
    $blank = index_of($text, "\r\n\r\n");
    if ($blank == null) {
        throw Undecodable("a multipart part whose headers don't end in an empty line");
    }
    if ($blank > MAX_PART_HEAD) {
        throw Undecodable("a multipart part with more than " .. MAX_PART_HEAD .. " bytes of headers");
    }

    return [slice($text, 0, $blank), slice($text, $blank + 4)];
}

// A part's header lines as a map from each lowercased name to its trimmed value
fn part_headers($head) {
    $headers = {};
    if ($head == "") {
        return $headers;
    }
    if (!utf8_valid($head)) {
        throw Undecodable("text that isn't UTF-8");
    }
    foreach (split($head, "\r\n") as $line) {
        [$name, $value] = part_header($line);
        if (has_key($headers, $name)) {
            throw Undecodable("a multipart part that gives " .. quote($name) .. " twice");
        }
        $headers[$name] = $value;
    }

    return $headers;
}

fn part_header($line) {
    if (contains($line, "\r") || contains($line, "\n")) {
        throw Undecodable("a multipart part's header line with a lone CR or LF");
    }
    $colon = index_of($line, ":");
    if ($colon == null) {
        throw Undecodable("a multipart part's header line without a colon: " .. quote($line));
    }
    $name = lower(slice($line, 0, $colon));
    if ($name == "" || contains($name, " ") || contains($name, "\t")) {
        throw Undecodable("a multipart part's header line without a name: " .. quote($line));
    }

    return [$name, trim(slice($line, $colon + 1))];
}

/*
 * A header's value read as a lowercased first word and its parameters ("form-data; name=\"a\""
 * is ["form-data", {"name" => "a"}]), each name lowercased, each value a token or a quoted string.
 * A quoted string runs to the next quote with every byte kept, a backslash too: browsers send a
 * quote as %22 and a backslash as it is, so reading backslash escapes would change or refuse real
 * filenames.
 */
fn header_parameters($value) {
    $semicolon = index_of($value, ";") ?? len($value);
    $first = lower(trim(slice($value, 0, $semicolon)));
    $reader = ParameterReader($value, $semicolon);

    return [$first, $reader.parameters()];
}

kind ParameterReader {
    #text;
    #at;

    fn _($text, $at) {
        #text = $text;
        #at = $at;
    }

    // From just after the first word: each "; name=value", as a map
    pub fn parameters() {
        $parameters = {};
        while (true) {
            #skip_space();
            if (#at == len(#text)) {
                return $parameters;
            }
            if (#text[#at] != ";") {
                throw Undecodable("a header parameter without a ; before it in " .. quote(#text));
            }
            #at++;
            #skip_space();
            if (#at == len(#text) || #text[#at] == ";") {
                continue;
            }
            [$name, $value] = #parameter();
            if (has_key($parameters, $name)) {
                throw Undecodable("a header parameter " .. quote($name) .. " given twice in " .. quote(#text));
            }
            $parameters[$name] = $value;
        }
    }

    fn parameter() {
        $equals = index_of(#text, "=", #at);
        $semicolon = index_of(#text, ";", #at) ?? len(#text);
        if ($equals == null || $equals > $semicolon) {
            throw Undecodable("a header parameter without a value in " .. quote(#text));
        }
        $name = lower(trim(slice(#text, #at, $equals - #at)));
        if (!is_token($name)) {
            throw Undecodable("a header parameter whose name isn't a token in " .. quote(#text));
        }
        #at = $equals + 1;
        #skip_space();
        if (#at < len(#text) && #text[#at] == "\"") {
            return [$name, #quoted()];
        }
        $end = index_of(#text, ";", #at) ?? len(#text);
        $token = trim(slice(#text, #at, $end - #at));
        if (!is_token($token)) {
            throw Undecodable("a header parameter whose value isn't a token or a quoted string in " .. quote(#text));
        }
        #at = $end;

        return [$name, $token];
    }

    // A quoted string from its opening quote through the next one, the bytes between as they are
    fn quoted() {
        $close = index_of(#text, "\"", #at + 1);
        if ($close == null) {
            throw Undecodable("a header parameter whose quoted string never ends in " .. quote(#text));
        }
        $text = slice(#text, #at + 1, $close - #at - 1);
        #at = $close + 1;

        return $text;
    }

    fn skip_space() {
        while (#at < len(#text) && contains(" \t", #text[#at])) {
            #at++;
        }
    }
}

// Who the client is, behind proxies the program trusts

const MAX_ADDRESS_LENGTH = 45;   // the longest IPv6 text, an IPv4 address in its last 32 bits

/**
 * The address of the client that made $request, as text, or null when the connection's peer
 * isn't known. Without $trusted_proxies it is the request's "remote_address", the other end of
 * the connection, and the X-Forwarded-For header is never read: any client can send one, so
 * believing it by default would let a client choose its own address.
 *
 * Behind a proxy, name it: $trusted_proxies is a list of addresses, compared as text with the
 * connection's address and with the header's entries. When the connection comes from one of them,
 * X-Forwarded-For is read from the right, the end the proxy added to, and the first entry that
 * isn't a trusted proxy is the client. The entries to its left are whatever the client sent
 * before any proxy saw it, so reading from the left would believe the client again. An entry
 * that is empty or isn't an address ends the walk at the last hop a trusted proxy vouched for,
 * and so does a missing header, or one whose every entry is trusted.
 *
 * With nginx on the same machine in front of the app, adding the address it sees to the header
 * (`proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`), the app asks
 *
 *     $address = http::client_address($request, ["127.0.0.1"]);
 *
 * A request from 127.0.0.1 with `X-Forwarded-For: 10.9.9.9, 203.0.113.5` gives "203.0.113.5",
 * the address nginx saw, and not "10.9.9.9", which the client wrote itself. A request from
 * anywhere else gives its own address, whatever its header says.
 *
 * A $trusted_proxies that isn't a list of strings is an error.
 *
 * ponytail: addresses only, compared as text: no CIDR ranges ("10.0.0.0/8") and no canonical form
 * for IPv6, so "::1" and "0:0:0:0:0:0:0:1" are different entries. A range type and an address
 * parser would lift both.
 */
pub fn client_address($request, $trusted_proxies = []) {
    check_trusted_proxies($trusted_proxies);
    $vouched = $request["remote_address"];
    if ($vouched == null || !in_array($vouched, $trusted_proxies)) {
        return $vouched;
    }
    foreach (reverse(forwarded_hops($request)) as $hop) {
        if (!is_address($hop)) {
            return $vouched;
        }
        if (!in_array($hop, $trusted_proxies)) {
            return $hop;
        }
        $vouched = $hop;
    }

    return $vouched;
}

fn check_trusted_proxies($trusted_proxies) {
    if (type_of($trusted_proxies) != "list") {
        throw "http::client_address() expects a list of addresses, got " .. type_of($trusted_proxies);
    }
    foreach ($trusted_proxies as $proxy) {
        if (type_of($proxy) != "string") {
            throw "http::client_address() expects each trusted proxy to be a string, got " .. type_of($proxy);
        }
    }
}

// X-Forwarded-For's entries, left to right; repeated headers were joined with ", " when read
fn forwarded_hops($request) {
    $header = $request["headers"]["x-forwarded-for"] ?? "";
    if (trim($header) == "") {
        return [];
    }

    return map(split($header, ","), trim);
}

// Whether $text could be an address: four dotted numbers, or IPv6's hex digits and colons
fn is_address($text) {
    if ($text == "" || len($text) > MAX_ADDRESS_LENGTH) {
        return false;
    }
    if (contains($text, ":")) {
        return is_ipv6_text($text);
    }

    return is_ipv4($text);
}

fn is_ipv4($text) {
    $parts = split($text, ".");
    if (len($parts) != 4) {
        return false;
    }
    foreach ($parts as $part) {
        if ($part == "" || len($part) > 3 || !all_digits($part) || to_int($part) > 255) {
            return false;
        }
    }

    return true;
}

// Only the characters and at least the two colons IPv6 text has; not a full parse
fn is_ipv6_text($text) {
    if (len(split($text, ":")) < 3) {
        return false;
    }
    foreach (split($text, "") as $c) {
        if (!is_hex_digit($c) && $c != ":" && $c != ".") {
            return false;
        }
    }

    return true;
}

// Cookies, and signed sessions built on them

const SESSION_COOKIE = "session";
const COOKIE_OPTIONS = {"path" => "/", "http_only" => true, "secure" => false, "same_site" => "Lax", "max_age" => null};

/**
 * The request's Cookie header as a map from each cookie's name to its value, url_decode()d. A
 * cookie with a bad percent-escape, or a name or value that isn't UTF-8 once decoded, is left out
 * rather than refusing the request: the header carries every cookie the browser holds for the
 * domain, another site's among them, which the program never set and can't clear.
 */
pub fn cookies($request) {
    $cookies = {};
    foreach (sent_cookies($request) as $name => $value) {
        $decoded = decoded(() -> text_decode($value), null);
        if ($decoded != null && utf8_valid($name)) {
            $cookies[$name] = $decoded;
        }
    }

    return $cookies;
}

// The request's Cookie header as a map from each cookie's name to its value as sent
fn sent_cookies($request) {
    $header = $request["headers"]["cookie"] ?? "";
    $cookies = {};
    foreach (split($header, ";") as $pair) {
        $pair = trim($pair);
        $equals = index_of($pair, "=");
        if ($pair == "" || $equals == null) {
            continue;
        }
        $cookies[trim(slice($pair, 0, $equals))] = trim(slice($pair, $equals + 1));
    }

    return $cookies;
}

/**
 * $response with a Set-Cookie header added for $name, its value url_encode()d (a response can
 * carry several, each written as a line of its own). $options:
 *
 * - "path", a Path attribute, "/" by default;
 * - "http_only", an HttpOnly attribute, true by default: a cookie a page's own JavaScript can't
 *   read is one XSS can't steal;
 * - "secure", a Secure attribute, false by default, since a plain http:// site couldn't send the
 *   cookie back;
 * - "same_site", "Lax" by default, which stops a cookie going out on a cross-site request that
 *   isn't a plain navigation, the common CSRF vector;
 * - "max_age", a Max-Age attribute in seconds, a session cookie with none.
 */
pub fn set_cookie($response, $name, $value, $options = {}) {
    $headers = $response["headers"] ?? {};
    $existing = $headers["Set-Cookie"] ?? [];
    if (type_of($existing) != "list") {
        $existing = [$existing];
    }
    $existing[] = cookie_header($name, $value, $options);
    $headers["Set-Cookie"] = $existing;
    $response["headers"] = $headers;

    return $response;
}

fn cookie_header($name, $value, $options) {
    check_token("cookie name", $name);
    $options = cookie_options($options);
    $parts = ["$name=" .. url_encode(to_string($value))];
    if ($options["path"] != null) {
        $parts[] = "Path=" .. $options["path"];
    }
    if ($options["max_age"] != null) {
        $parts[] = "Max-Age=" .. $options["max_age"];
    }
    if ($options["secure"]) {
        $parts[] = "Secure";
    }
    if ($options["http_only"]) {
        $parts[] = "HttpOnly";
    }
    if ($options["same_site"] != null) {
        $parts[] = "SameSite=" .. $options["same_site"];
    }

    return join($parts, "; ");
}

fn cookie_options($options) {
    return with_defaults("http::set_cookie()", $options, COOKIE_OPTIONS);
}

// $options over $defaults, refusing a name $defaults doesn't have, in $who's words
fn with_defaults($who, $options, $defaults) {
    if (type_of($options) != "map") {
        throw "$who expects a map of options, got " .. type_of($options);
    }
    foreach ($options as $name => $value) {
        if (!has_key($defaults, $name)) {
            throw "$who has no option " .. quote($name) .. ": only " .. join(keys($defaults), ", ");
        }
    }

    return {...$defaults, ...$options};
}

/**
 * The session the request's session cookie holds, read and verified (crypto::sign() and
 * crypto::equals(), on a json::encode()d map), or {} for no cookie or one that doesn't check out:
 * a forged, tampered or expired cookie is routine, not an error a handler must catch
 */
pub fn session($request, $secret) {
    // Only the session's own cookie is decoded, so another site's cookie on the domain can't end it
    $sent = sent_cookies($request)[SESSION_COOKIE] ?? null;
    if ($sent == null) {
        return {};
    }
    $signed = url_decode($sent, null);
    if ($signed == null) {
        return {};
    }
    $payload = crypto::unsign($signed, $secret);
    if ($payload == null) {
        return {};
    }
    try {
        $session = json::decode($payload);
    } catch (Error $e) {
        return {};
    }

    return type_of($session) == "map" ? $session : {};
}

/**
 * $response with the session's Set-Cookie added, signed with $secret: session()'s other
 * direction. $options are set_cookie()'s.
 */
pub fn session_cookie($response, $session, $secret, $options = {}) {
    $payload = crypto::sign(json::encode($session), $secret);

    return set_cookie($response, SESSION_COOKIE, $payload, $options);
}

/**
 * The session with a CSRF token if it had none: check $session["csrf_token"] after calling
 */
pub fn csrf_token($session) {
    $session["csrf_token"] ??= crypto::token();

    return $session;
}

/**
 * Whether $submitted, the token a form sent, is the session's CSRF token, compared with
 * crypto::equals() as a signature is; false when the session has none
 */
pub fn verify_csrf($session, $submitted) {
    $token = $session["csrf_token"] ?? null;

    return $token != null && type_of($submitted) == "string" && crypto::equals($token, $submitted);
}

/*
 * Middleware for a web app's Router, added in this order, the first outermost:
 *
 *   $app.use(http::security_headers());
 *   $app.use(http::sessions($secret, {"secure" => true}));
 *   $app.use(http::csrf());
 *   $app.use($authentication);              // the app's own: only it knows what a user is
 *
 * A login builds a new session map rather than changing the old one, with a fresh crypto::token() as
 * its "csrf_token", so nothing planted before it carries over: that is the app's to write, since
 * only the app knows what logging in is.
 */

const SECURITY_HEADERS = {
    "Content-Security-Policy" => "default-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'",
    "X-Content-Type-Options" => "nosniff",
    "Referrer-Policy" => "same-origin",
};
const MINIMUM_SECRET = 32;
const SESSION_MAX_AGE = 1209600;      // two weeks, in seconds
const UNSAFE_METHODS = ["POST", "PUT", "PATCH", "DELETE"];
const CSRF_OPTIONS = {"field" => "_csrf", "failure" => null};
const CSRF_HEADER = "x-csrf-token";
const CSRF_REFUSAL = "Forbidden: this form has expired. Go back, reload the page and try again.";

/**
 * Middleware that adds security headers to every response that doesn't set them itself (a route
 * can give its own Content-Security-Policy): a Content-Security-Policy allowing only this site,
 * X-Content-Type-Options: nosniff and Referrer-Policy: same-origin. $options maps a header name
 * to the value to send instead, or to null to send none; names are matched ignoring case. Add it
 * first, so a refusal and a redirect from the middleware after it get the headers too:
 *
 *     $app.use(http::security_headers());
 *     $app.use(http::sessions($secret, {"secure" => true}));
 *     $app.use(http::csrf());
 */
pub fn security_headers($options = {}) {
    $headers = security_header_values($options);

    return ($request, $next) -> with_missing_headers($next($request), $headers);
}

fn security_header_values($options) {
    if (type_of($options) != "map") {
        throw "http::security_headers() expects a map of options, got " .. type_of($options);
    }
    $headers = SECURITY_HEADERS;
    foreach ($options as $name => $value) {
        check_token("header name", $name);
        if ($value != null && type_of($value) != "string") {
            throw "http::security_headers() takes a string or null for " .. quote($name) .. ", not " .. type_of($value);
        }
        $headers = without_key($headers, header_key($headers, $name) ?? $name);
        if ($value != null) {
            $headers[$name] = $value;
        }
    }

    return $headers;
}

// $response with each of $headers it doesn't already set, whatever the case of its own names
fn with_missing_headers($response, $headers) {
    if (type_of($response) != "map") {
        return $response;
    }
    $given = $response["headers"] ?? {};
    foreach ($headers as $name => $value) {
        if (header_key($given, $name) == null) {
            $given[$name] = $value;
        }
    }
    $response["headers"] = $given;

    return $response;
}

// The key $headers spells $name with, ignoring case, or null
fn header_key($headers, $name) {
    foreach (keys($headers) as $key) {
        if (lower($key) == lower($name)) {
            return $key;
        }
    }

    return null;
}

/**
 * Middleware that gives the handler $request["session"], the session from its signed cookie
 * with a CSRF token always in it, and $request["flash"], the message the last request left for
 * this one (null if none), which is not in the session. A handler changes the session by adding
 * "session" to its response (http::with_session()); the middleware takes that key out again and
 * writes the cookie only if the session differs from what the cookie held, so a flash is shown
 * once: the next session has none unless the handler set one. $secret must be at least 32 bytes.
 * $options are http::set_cookie()'s, "max_age" two weeks by default.
 */
pub fn sessions(string $secret, $options = {}) {
    if (len($secret) < MINIMUM_SECRET) {
        throw "http::sessions() needs a secret of at least " .. MINIMUM_SECRET .. " bytes, not " .. len($secret) .. ": a short one can be guessed, and every session forged with it";
    }
    $cookie_options = with_defaults("http::sessions()", $options, {...COOKIE_OPTIONS, "max_age" => SESSION_MAX_AGE});

    return ($request, $next) -> around_session($request, $next, $secret, $cookie_options);
}

fn around_session($request, $next, $secret, $cookie_options) {
    $stored = session($request, $secret);
    $started = csrf_token($stored);
    $request["flash"] = $started["flash"] ?? null;
    $request["session"] = without_key($started, "flash");
    $response = $next($request);
    if (type_of($response) != "map") {
        return $response;
    }
    $kept = $response["session"] ?? $request["session"];
    if (type_of($kept) != "map") {
        throw "a response's \"session\" is a map, not " .. type_of($kept);
    }
    $response = without_key($response, "session");
    // Against the cookie as it came, not $started: a new visitor's token is a change to keep
    if ($kept == $stored) {
        return $response;
    }

    return session_cookie($response, $kept, $secret, $cookie_options);
}

fn without_key($map, $key) {
    if (has_key($map, $key)) {
        delete $map[$key];
    }

    return $map;
}

/**
 * $response asking http::sessions() to keep $session: `return http::with_session($page, $session);`
 */
pub fn with_session(map $response, map $session): map {
    return {...$response, "session" => $session};
}

/**
 * This request's session with $message in it for the next page to show once, as
 * $request["flash"]: give it to with_session()
 */
pub fn flash(map $request, string $message): map {
    $session = $request["session"];
    $session["flash"] = $message;

    return $session;
}

/**
 * Middleware that refuses a POST, PUT, PATCH or DELETE with a 403 unless it carries the session's
 * token, in the form field "_csrf" or the X-CSRF-Token header, and, if the browser sent an Origin,
 * that Origin is this host. $options: "field", the form field's name, and "failure", a function
 * from the request to the response to answer with instead. It needs http::sessions() before it,
 * and says so on the first request otherwise.
 */
pub fn csrf($options = {}) {
    $options = with_defaults("http::csrf()", $options, CSRF_OPTIONS);
    $field = $options["field"];
    if (type_of($field) != "string") {
        throw "http::csrf() takes a string for \"field\", not " .. type_of($field);
    }
    $failure = $options["failure"] ?? ($request -> plain(403, CSRF_REFUSAL));
    if (type_of($failure) != "function") {
        throw "http::csrf() takes a function for \"failure\", not " .. type_of($failure);
    }

    return ($request, $next) -> {
        if (!has_key($request, "session")) {
            throw "http::csrf() needs the session: add http::sessions() to the Router before it";
        }
        if (in_array($request["method"], UNSAFE_METHODS) && !from_this_site($request, $field)) {
            return $failure($request);
        }

        return $next($request);
    };
}

// Whether a request that changes something carries the session's token and, if it says, our Origin
fn from_this_site($request, $field) {
    $submitted = $request["headers"][CSRF_HEADER] ?? form_field($request, $field);

    return verify_csrf($request["session"], $submitted) && same_origin($request);
}

/*
 * A form's field, or null for a body that isn't a form or can't be decoded, so a hostile request
 * is refused, not a 500
 */
fn form_field($request, $field) {
    return form($request, {})[$field] ?? null;
}

// Whether the Origin the browser sent, if it sent one, is the host it sent the request to
fn same_origin($request) {
    $origin = $request["headers"]["origin"] ?? null;
    if ($origin == null) {
        return true;
    }
    $host = $request["headers"]["host"] ?? "";

    return $origin == "http://" .. $host || $origin == "https://" .. $host;
}

// A test client: requests answered as http::serve() answers them, with no socket

const TEST_CLIENT_OPTIONS = {"host" => "example.test", "remote_address" => "192.0.2.1", "max_body" => 1048576};

/**
 * A browser for one site, answered by $handler as http::serve() would answer it, with no server
 * or socket: for testing a handler.
 *
 *     $client = http::TestClient($app.handler());
 *     $page = $client.get("/login");
 *     $done = $client.post("/login", {"_csrf" => http::form_token($page), "email" => "ada@example.com"});
 *     expect("logging in goes home", $done["headers"]["location"], "/");
 *     expect("and is remembered", $client.session(SECRET)["user_id"], 1);
 *
 * - Each request method gives the response as http::request() does,
 *   {"status" => 200, "headers" => {"content-type" => "text/html; charset=utf-8", ...}, "body" => "..."}.
 * - Each request is written out as HTTP and read by the server's own code, and the response
 *   written as the server writes it and read back by the client's own, so a test sees what a
 *   browser would: the same refusals (a 400 for a bad header, a 413 for too big a body), a 500
 *   for a handler that raises (logged as http::serve() logs it), an Html body as text with its
 *   Content-Type, and lower-cased header names, a repeated header's values joined with ", ".
 * - Cookies a response sets are kept and sent back with every later request, as one site's are:
 *   Path, Domain, Secure and Expires are not read, and a Max-Age of 0 or less forgets the cookie.
 * - A redirect is followed only when asked, with follow().
 * - $options: "host", the Host header sent ("example.test", a name kept for examples),
 *   "remote_address", the address the requests come from ("192.0.2.1", kept for documentation;
 *   null for a client the system no longer knows), and "max_body", as http::serve() takes it, so
 *   an app is tested against its own limit.
 */
pub kind TestClient {
    #handler;
    #options;
    #server_options;
    #cookies = {};
    #last_target = "/";   // what a relative redirect is resolved against

    /**
     * A client of $handler with no cookies yet; $options as above
     */
    fn _($handler, $options = {}) {
        #handler = $handler;
        #options = with_defaults("http::TestClient()", $options, TEST_CLIENT_OPTIONS);
        #server_options = server_options({"max_body" => #options["max_body"]});
    }

    /**
     * A GET request for $target, a path with its query ("/search?q=gaz"), with $headers
     */
    pub fn get(string $target, map $headers = {}): map {
        return #request("GET", $target, $headers);
    }

    /**
     * A POST request of a form, $fields form-encoded as a browser sends them
     */
    pub fn post(string $target, map $fields, map $headers = {}): map {
        $form_headers = {"content-type" => FORM_TYPE, ...$headers};

        return #request("POST", $target, $form_headers, form_body($fields));
    }

    /**
     * A request of any method with $body as it is: for JSON,
     * `$client.request("PUT", "/api/todo/1", {"content-type" => "application/json"}, json::encode($todo))`.
     * Header names may be written in any case; a Cookie header given here is sent instead of the
     * kept cookies.
     */
    pub fn request(string $method, string $target, map $headers = {}, string $body = ""): map {
        check_token("method", $method);
        if (contains($target, "\r") || contains($target, "\n") || contains($target, "\0")) {
            throw "HTTP error: the target has a line break or NUL byte in it";
        }
        #last_target = $target;
        $bytes = #exchange(request_text($method, $target, #headers_for($headers, $body), $body));
        #keep_cookies($bytes);

        return read_response(Reader(null, $bytes), $method);
    }

    /**
     * Where a redirect $response sends the browser, fetched with a GET; a relative Location is
     * read against the last request's target. A Location on another site is an error.
     */
    pub fn follow(map $response): map {
        // ponytail: a 307 or 308 after a POST is followed with a GET too; keeping the method would need the request kept
        $location = $response["headers"]["location"] ?? null;
        if (!in_array($response["status"], REDIRECT_STATUSES) || $location == null) {
            throw "http::TestClient can't follow a " .. $response["status"] .. " response: it is not a redirect";
        }

        return #get(#target_of($location));
    }

    /**
     * The value of the cookie $name as the browser holds it (as sent, still url_encode()d), or null
     */
    pub fn cookie(string $name): ?string {
        return #cookies[$name] ?? null;
    }

    /**
     * Take the cookie $name away, as a browser does when its site's data is cleared
     */
    pub fn forget(string $name) {
        if (has_key(#cookies, $name)) {
            delete #cookies[$name];
        }
    }

    /**
     * The session the kept session cookie holds, read as http::sessions() reads it with $secret
     * (its "csrf_token" is the one a form must carry), or {} if there is none
     */
    pub fn session(string $secret): map {
        return http::session({"headers" => {"cookie" => #cookie_header()}}, $secret);
    }

    // The response's bytes, as http::serve() writes them for this request's bytes
    fn exchange(string $text): string {
        $address = #options["remote_address"];
        $answer = answer(Reader(null, $text), null, #handler, $address, #server_options, false);

        return $answer[0];
    }

    // $headers, checked and lower-cased, with what a browser sends without being asked
    fn headers_for(map $headers, string $body): map {
        $given = {};
        foreach ($headers as $name => $value) {
            $given[lower($name)] = checked_header($name, $value);
        }
        $sent = {"host" => #options["host"]};
        if (len(#cookies) > 0) {
            $sent["cookie"] = #cookie_header();
        }
        if ($body != "" && !has_key($given, "transfer-encoding")) {
            $sent["content-length"] = to_string(len($body));
        }

        return {...$sent, ...$given};
    }

    fn cookie_header(): string {
        $pairs = map(keys(#cookies), $name -> $name .. "=" .. #cookies[$name]);

        return join($pairs, "; ");
    }

    // Each Set-Cookie line of a response's head kept, or forgotten if it has expired
    fn keep_cookies(string $bytes) {
        $head = slice($bytes, 0, index_of($bytes, "\r\n\r\n"));
        foreach (split($head, "\r\n") as $line) {
            $colon = index_of($line, ":");
            if ($colon != null && lower(slice($line, 0, $colon)) == "set-cookie") {
                #keep_cookie(trim(slice($line, $colon + 1)));
            }
        }
    }

    fn keep_cookie(string $value) {
        $attributes = map(split($value, ";"), trim);
        $pair = $attributes[0];
        $equals = index_of($pair, "=");
        if ($equals == null || $equals == 0) {
            return;
        }
        $name = slice($pair, 0, $equals);
        if (has_expired(slice($attributes, 1))) {
            #forget($name);
            return;
        }
        #cookies[$name] = slice($pair, $equals + 1);
    }

    // A Location as a target on this site, http or https
    fn target_of(string $location): string {
        $here = parse_url("http://" .. #options["host"] .. #last_target);
        $there = parse_url(resolve($here, $location));
        if ($there["host_header"] != $here["host_header"]) {
            throw "http::TestClient follows a redirect only to its own site, not to " .. quote($location);
        }

        return $there["path"];
    }
}

/**
 * The CSRF token in a page's form, as web::csrf_field() writes it, for a test to post back as a
 * browser would: `$client.post("/todos", {"_csrf" => http::form_token($page), ...})`. $field is
 * the name http::csrf() was given, "_csrf" unless it said. A page without one is an error.
 */
pub fn form_token(map $response, string $field = "_csrf"): string {
    $before = "<input type=\"hidden\" name=\"$field\" value=\"";
    $body = $response["body"];
    $start = index_of($body, $before);
    if ($start == null) {
        throw "no CSRF field " .. quote($field) .. " in the page";
    }
    $start += len($before);

    return slice($body, $start, index_of($body, "\"", $start) - $start);
}

// A request as a client writes it: its line, its headers, an empty line and the body
fn request_text(string $method, string $target, map $headers, string $body): string {
    $lines = ["$method $target HTTP/1.1"];
    foreach ($headers as $name => $value) {
        $lines[] = "$name: $value";
    }

    return join($lines, "\r\n") .. "\r\n\r\n" .. $body;
}

fn form_body(map $fields): string {
    $pairs = map(keys($fields), $name -> url_encode($name) .. "=" .. url_encode(to_string($fields[$name])));

    return join($pairs, "&");
}

// Whether a Set-Cookie's attributes say the cookie is gone: a Max-Age of 0 or less
fn has_expired(list $attributes): bool {
    foreach ($attributes as $attribute) {
        $equals = index_of($attribute, "=");
        if ($equals != null && lower(slice($attribute, 0, $equals)) == "max-age") {
            return to_int(slice($attribute, $equals + 1), 1) <= 0;
        }
    }

    return false;
}
