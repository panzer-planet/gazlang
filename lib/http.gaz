// HTTP/1.1 for GazLang, on the socket builtins (TLS for https): http::get($url,
// $headers = {}), http::post($url, $body, $headers = {}) and http::request($method,
// $url, $headers = {}, $body = null). Each returns
// {"status" => 200, "headers" => {"content-type" => "text/plain", ...}, "body" => "..."}.
//
// - Any status is a response, 404 and 500 included. A request that gets no response (no such
//   host, refused, a certificate that doesn't check out, a malformed response) is an error.
// - https checks the server's certificate against the system's trusted ones and the host name.
// - Redirects are followed, up to 20. A 303 becomes a GET (a HEAD stays a HEAD), and so does a
//   POST after a 301 or 302, as browsers do; the others keep the method and body. Authorization
//   and Cookie headers are dropped when a redirect leaves the scheme, host and port.
// - Response header names are lowercased; a repeated header's values are joined with ", ".
// - Host, Content-Length, Connection and Transfer-Encoding are written here; giving one is an
//   error. No Content-Type is sent unless given.
// - Each connection waits 30 seconds at most to connect and for each read.
// - ponytail: one connection per request (Connection: close); keeping it alive would save the
//   handshake for several requests to one server. Redirect targets' ./ and ../ are left for the
//   server to resolve.

namespace http;

include "chars.gaz" use is_alnum, is_digit, is_hex_digit;
include "date.gaz";
include "crypto.gaz";
include "json.gaz";

const MAX_REDIRECTS = 20;
const MAX_HEAD = 65536;      // a request's line and headers, in bytes

pub fn get($url, $headers = {}) {
    return request("GET", $url, $headers);
}

pub fn post($url, $body, $headers = {}) {
    return request("POST", $url, $headers, $body);
}

pub fn request($method, $url, $headers = {}, $body = null) {
    check_token("method", $method);
    if ($body != null && type_of($body) != "string") {
        throw "HTTP error: the body must be a string, got " .. type_of($body);
    }
    // By lowercased name: [the name as given, its value]
    $sent = {};
    foreach ($headers as $name => $value) {
        check_token("header name", $name);
        $value = to_string($value);
        if (contains($value, "\r") || contains($value, "\n") || contains($value, "\0")) {
            throw "HTTP error: header $name has a line break or NUL byte in its value";
        }
        if (in_array(lower($name), ["host", "content-length", "connection", "transfer-encoding"])) {
            throw "HTTP error: header $name is written by http::request";
        }
        $sent[lower($name)] = [$name, $value];
    }
    $target = parse_url($url);
    $redirects = 0;
    while (true) {
        $response = exchange($method, $target, $sent, $body);
        $location = $response["headers"]["location"] ?? null;
        if (!in_array($response["status"], [301, 302, 303, 307, 308]) || $location == null) {
            return $response;
        }
        if ($redirects == MAX_REDIRECTS) {
            throw "HTTP error: more than " .. MAX_REDIRECTS .. " redirects";
        }
        $redirects++;
        $next = parse_url(resolve($target, $location));
        $status = $response["status"];
        if ($status == 303 && $method != "HEAD" || ($status == 301 || $status == 302) && $method == "POST") {
            $method = "GET";
            $body = null;
            if (has_key($sent, "content-type")) {
                delete $sent["content-type"];
            }
        }
        // Credentials are for the server they were written for
        if ($next["origin"] != $target["origin"]) {
            foreach (["authorization", "cookie"] as $name) {
                if (has_key($sent, $name)) {
                    delete $sent[$name];
                }
            }
        }
        $target = $next;
    }
}

// One request on its own connection, and its response
fn exchange($method, $target, $sent, $body) {
    $lines = ["$method {$target["path"]} HTTP/1.1", "Host: {$target["host_header"]}"];
    foreach ({"user-agent" => ["User-Agent", "gazlang"], "accept" => ["Accept", "*/*"]} as $key => $default) {
        $sent[$key] ??= $default;
    }
    foreach ($sent as [$name, $value]) {
        $lines[] = "$name: $value";
    }
    $lines[] = "Connection: close";
    if ($body != null) {
        $lines[] = "Content-Length: " .. len($body);
    }
    $socket = socket_open($target["host"], $target["port"], $target["scheme"] == "https");
    try {
        socket_write($socket, join($lines, "\r\n") .. "\r\n\r\n" .. ($body ?? ""));
        return read_response(Reader($socket), $method);
    } finally {
        socket_close($socket);
    }
}

// {"scheme", "host", "port", "path", "host_header", "origin"} from an http or https URL
fn parse_url($url) {
    if (type_of($url) != "string") {
        throw "HTTP error: a URL must be a string, got " .. type_of($url);
    }
    $shown = slice(to_string([$url]), 1, -1);
    // Nothing a request line can't carry: no space or control character
    foreach (split($url, "") as $c) {
        if (ord($c) <= 32 || ord($c) == 127) {
            throw "HTTP error: bad URL: $shown";
        }
    }
    $scheme_end = index_of($url, "://");
    if ($scheme_end == null) {
        throw "HTTP error: bad URL: $shown";
    }
    $scheme = lower(slice($url, 0, $scheme_end));
    if ($scheme != "http" && $scheme != "https") {
        throw "HTTP error: only http and https URLs, got $shown";
    }
    $rest = slice($url, $scheme_end + 3);
    $fragment = index_of($rest, "#");
    if ($fragment != null) {
        $rest = slice($rest, 0, $fragment);
    }
    // The authority ends at the path or the query
    $end = len($rest);
    foreach (["/", "?"] as $c) {
        $at = index_of($rest, $c);
        if ($at != null && $at < $end) {
            $end = $at;
        }
    }
    $authority = slice($rest, 0, $end);
    $path = slice($rest, $end);
    if ($path == "" || starts_with($path, "?")) {
        $path = "/" .. $path;
    }
    if (contains($authority, "@")) {
        throw "HTTP error: a URL can't carry credentials; send an Authorization header: $shown";
    }
    // [::1]:8080 or name:8080
    $port_text = "";
    if (starts_with($authority, "[")) {
        $close = index_of($authority, "]");
        if ($close == null) {
            throw "HTTP error: bad URL: $shown";
        }
        $host = slice($authority, 1, $close - 1);
        $after = slice($authority, $close + 1);
        if ($after != "") {
            if (!starts_with($after, ":")) {
                throw "HTTP error: bad URL: $shown";
            }
            $port_text = slice($after, 1);
        }
    } else {
        $colon = index_of($authority, ":");
        $host = $colon == null ? $authority : slice($authority, 0, $colon);
        $port_text = $colon == null ? "" : slice($authority, $colon + 1);
    }
    $host = lower($host);
    $default_port = $scheme == "https" ? 443 : 80;
    $port = $default_port;
    if ($port_text != "") {
        if (len($port_text) > 5 || !all_digits($port_text) || to_int($port_text) < 1 || to_int($port_text) > 65535) {
            throw "HTTP error: bad port in URL: $shown";
        }
        $port = to_int($port_text);
    }
    if ($host == "") {
        throw "HTTP error: no host in URL: $shown";
    }
    $host_header = (contains($host, ":") ? "[$host]" : $host) .. ($port == $default_port ? "" : ":$port");
    return {"scheme" => $scheme, "host" => $host, "port" => $port, "path" => $path,
        "host_header" => $host_header, "origin" => "$scheme://$host_header"};
}

// Where a Location header points, from the URL that sent it
fn resolve($target, $location) {
    // Absolute when what comes before :// is a scheme, not a relative path or query holding a URL
    $scheme_end = index_of($location, "://");
    if ($scheme_end != null && $scheme_end > 0) {
        $absolute = true;
        foreach (split(slice($location, 0, $scheme_end), "") as $c) {
            if (!is_alnum($c) && !contains("+-.", $c)) {
                $absolute = false;
            }
        }
        if ($absolute) {
            return $location;
        }
    }
    if (starts_with($location, "//")) {
        return $target["scheme"] .. ":" .. $location;
    }
    if (starts_with($location, "/")) {
        return $target["origin"] .. $location;
    }
    $query = index_of($target["path"], "?");
    $path = $query == null ? $target["path"] : slice($target["path"], 0, $query);
    if (starts_with($location, "?")) {
        return $target["origin"] .. $path .. $location;
    }
    $parts = split($path, "/");
    $parts[len($parts) - 1] = $location;
    return $target["origin"] .. join($parts, "/");
}

// Reads a message from a socket: lines up to a delimiter, a count of bytes, or the rest
kind Reader {
    #data = "";         // read but not taken yet

    // With a $deadline (a monotonic_time()), a read that would start after it is refused (408)
    fn _(#socket, #deadline = null);

    // Whether anything has been read but not taken
    pub fn pending() {
        return #data != "";
    }

    // Read more; false at the end of the stream
    fn more() {
        if (#deadline != null && monotonic_time() > #deadline) {
            throw Refusal(408, "HTTP error: the request took too long to arrive");
        }
        $chunk = socket_read(#socket);
        if ($chunk == "") {
            return false;
        }
        #data ..= $chunk;
        return true;
    }

    /*
     * Up to $delimiter, which is dropped; null if the stream ends first. With a $limit, a line
     * that runs past that many bytes is refused (431) rather than read into memory forever.
     */
    pub fn line($delimiter, $limit = null) {
        $from = 0;
        while (true) {
            $at = index_of(#data, $delimiter, $from);
            if ($at != null && ($limit == null || $at <= $limit)) {
                $line = slice(#data, 0, $at);
                #data = slice(#data, $at + len($delimiter));
                return $line;
            }
            if ($limit != null && len(#data) > $limit) {
                throw Refusal(431, "HTTP error: more than $limit bytes without a line end");
            }
            // A delimiter may straddle what is here and what comes next
            $from = max(0, len(#data) - len($delimiter) + 1);
            if (!#more()) {
                return null;
            }
        }
    }

    // Exactly $n bytes; an error if the stream ends first
    pub fn bytes($n) {
        $parts = [];
        while (len(#data) < $n) {
            $parts[] = #data;
            $n -= len(#data);
            #data = "";
            if (!#more()) {
                throw "HTTP error: the connection closed in the middle of the body";
            }
        }
        $parts[] = slice(#data, 0, $n);
        #data = slice(#data, $n);
        return join($parts, "");
    }

    // Everything until the stream ends
    pub fn rest() {
        $parts = [#data];
        #data = "";
        while (true) {
            $chunk = socket_read(#socket);
            if ($chunk == "") {
                return join($parts, "");
            }
            $parts[] = $chunk;
        }
    }
}

fn read_response($reader, $method) {
    while (true) {
        $head = $reader.line("\r\n\r\n");
        if ($head == null) {
            throw "HTTP error: the connection closed before a response came";
        }
        $lines = split($head, "\r\n");
        // "HTTP/1.1 200 OK"
        $words = split($lines[0], " ");
        if (len($words) < 2 || !starts_with($words[0], "HTTP/1.") || len($words[1]) != 3 || !all_digits($words[1])) {
            throw "HTTP error: not an HTTP response: " .. slice(to_string([slice($lines[0], 0, 100)]), 1, -1);
        }
        $status = to_int($words[1]);
        $headers = {};
        foreach (slice($lines, 1) as $line) {
            $colon = index_of($line, ":");
            if ($colon == null) {
                continue;
            }
            $name = lower(trim(slice($line, 0, $colon)));
            $value = trim(slice($line, $colon + 1));
            $headers[$name] = has_key($headers, $name) ? $headers[$name] .. ", " .. $value : $value;
        }
        // An interim response (103 Early Hints, say) comes before the real one
        if ($status < 200) {
            continue;
        }
        $body = match {
            $method == "HEAD" || $status == 204 || $status == 304 => "",
            contains(lower($headers["transfer-encoding"] ?? ""), "chunked") => read_chunked($reader),
            has_key($headers, "content-length") => $reader.bytes(content_length($headers["content-length"])),
            default => $reader.rest(),
        };
        return {"status" => $status, "headers" => $headers, "body" => $body};
    }
}

fn content_length($text) {
    if ($text == "" || len($text) > 18 || !all_digits($text)) {
        throw "HTTP error: bad Content-Length: " .. slice(to_string([$text]), 1, -1);
    }
    return to_int($text);
}

/*
 * Chunks, each a size in hex (maybe with ;extensions) and that many bytes, up to a size of 0
 * and trailer lines, which are skipped. With a $limit (a server's), a body that adds up to more
 * is refused (413), and so is a size or trailer line past a few KB.
 */
fn read_chunked($reader, $limit = null) {
    $parts = [];
    $total = 0;
    $line_limit = $limit == null ? null : MAX_HEAD;
    while (true) {
        $line = $reader.line("\r\n", $line_limit);
        if ($line == null) {
            throw "HTTP error: the connection closed in the middle of the body";
        }
        $size_text = trim(split($line, ";")[0]);
        if ($size_text == "" || len($size_text) > 15) {
            throw "HTTP error: bad chunk size: " .. slice(to_string([$line]), 1, -1);
        }
        $size = 0;
        foreach (split(lower($size_text), "") as $c) {
            $digit = index_of("0123456789abcdef", $c);
            if ($digit == null) {
                throw "HTTP error: bad chunk size: " .. slice(to_string([$line]), 1, -1);
            }
            $size = $size * 16 + $digit;
        }
        $total += $size;
        if ($limit != null && $total > $limit) {
            throw Refusal(413, "HTTP error: a body of more than $limit bytes");
        }
        if ($size == 0) {
            while (true) {
                $trailer = $reader.line("\r\n", $line_limit);
                if ($trailer == null || $trailer == "") {
                    return join($parts, "");
                }
            }
        }
        $parts[] = $reader.bytes($size);
        if ($reader.line("\r\n", $line_limit) != "") {
            throw "HTTP error: a chunk is longer than its size says";
        }
    }
}

fn all_digits($text) {
    foreach (split($text, "") as $c) {
        if (!is_digit($c)) {
            return false;
        }
    }
    return true;
}

// A method or header name must be an HTTP token, which keeps it from ending a line
fn check_token($what, $name) {
    if (type_of($name) != "string" || $name == "") {
        throw "HTTP error: bad $what: " .. slice(to_string([$name]), 1, -1);
    }
    foreach (split($name, "") as $c) {
        if (!is_alnum($c) && !contains('!#$%&\'*+-.^_`|~', $c)) {
            throw "HTTP error: bad $what: " .. slice(to_string([$name]), 1, -1);
        }
    }
}

/*
 * The server: http::serve($listener, $handler, $options = {}) answers connections on a
 * socket_listen() listener for ever, one request per connection, each by calling
 * $handler($request) with
 *
 *   {"method" => "GET", "path" => "/users/7", "query" => "tab=posts", "headers" => {...}, "body" => ""}
 *
 * (header names lowercased, a repeated header's values joined with ", ", the path and query as they
 * came, not decoded) and writing what it returns, a map of "status" (200 if left out), "headers"
 * and "body" (a string, "" if left out, or a template's Html, which is text/html unless a
 * Content-Type says otherwise). A header's value is a string, or a list of strings to write it as
 * that many lines (Set-Cookie, which RFC 6265 forbids joining with a comma). With workers() first,
 * each worker serves on its own.
 *
 * - A request that isn't well formed HTTP/1.x is answered 400 (431 for a head over 64KB, 413 for a
 *   body over "max_body", 501 for a transfer coding other than chunked, 505 for another HTTP
 *   version) without calling the handler. One with both Content-Length and Transfer-Encoding is
 *   refused too, as the way requests are smuggled past a proxy.
 * - A handler that raises, or returns what can't be written (a header with a line break in it, a
 *   Content-Length of its own), is answered 500, and the error goes to standard error.
 * - Content-Length, Connection and Date are written here. No Content-Type unless given.
 * - A HEAD request gets the headers the body would have, without it.
 * - Options: "timeout", seconds each read and write may wait (10); "request_timeout", seconds the
 *   whole request may take to arrive (30), after which it is answered 408, so a client trickling a
 *   byte at a time can't hold a worker; and "max_body", in bytes (1MB).
 * - It returns when its worker is asked to stop (SIGTERM, see workers()), once the request in hand
 *   is answered.
 * - ponytail: one request per connection (Connection: close), keep-alive waiting for a program that
 *   needs it. The request's deadline is checked before each read, so it can overrun by one
 *   "timeout"; writing the response has only the per-write timeout. TLS is a proxy's job in front.
 */

const REASONS = {
    100 => "Continue", 200 => "OK", 201 => "Created", 202 => "Accepted", 204 => "No Content",
    301 => "Moved Permanently", 302 => "Found", 303 => "See Other", 304 => "Not Modified",
    307 => "Temporary Redirect", 308 => "Permanent Redirect", 400 => "Bad Request",
    401 => "Unauthorized", 403 => "Forbidden", 404 => "Not Found", 405 => "Method Not Allowed",
    408 => "Request Timeout", 409 => "Conflict", 410 => "Gone", 413 => "Content Too Large",
    415 => "Unsupported Media Type", 417 => "Expectation Failed", 422 => "Unprocessable Content",
    429 => "Too Many Requests", 431 => "Request Header Fields Too Large",
    500 => "Internal Server Error", 501 => "Not Implemented", 502 => "Bad Gateway",
    503 => "Service Unavailable", 504 => "Gateway Timeout", 505 => "HTTP Version Not Supported",
};
const SERVER_OPTIONS = {"timeout" => 10, "request_timeout" => 30, "max_body" => 1048576, "max_requests" => null};
const DAY_NAMES = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
const MONTH_NAMES = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];

// A request refused before the handler sees it, with the status to answer
kind Refusal extends Error {
    fn _(pub #status, $message) {
        ##_($message);
    }
}

pub fn serve($listener, $handler, $options = {}) {
    $options = server_options($options);
    // PHP-FPM's pm.max_requests: retiring a worker after N requests throws away whatever state it
    // built up over its life, belt and suspenders next to the process boundary between workers
    $max_requests = $options["max_requests"];
    $served = 0;
    // Null once a worker is asked to stop: the request in hand has been answered
    while (($socket = socket_accept($listener, $options["timeout"])) != null) {
        handle($socket, $handler, $options);
        $served++;
        if ($max_requests != null && $served >= $max_requests) {
            worker_recycle();
        }
    }
}

// One connection: its request read, answered and the connection closed, whatever happens
pub fn handle($socket, $handler, $options = {}) {
    $options = server_options($options);
    try {
        $request = null;
        try {
            $deadline = monotonic_time() + $options["request_timeout"];
            $request = read_request(Reader($socket, $deadline), $socket, $options["max_body"]);
        } catch (Refusal $e) {
            send_quietly($socket, refusal($e.status));
        } catch (Error $e) {
            // Cut off, timed out or malformed: say so, if anyone is still listening
            send_quietly($socket, refusal(400));
        }
        if ($request != null) {
            $head = $request["method"] == "HEAD";
            $response = null;
            try {
                $response = write_response($handler($request), $head);
            } catch (Error $e) {
                print_error("http::serve: {$request["method"]} {$request["path"]}: " .. describe_error($e) .. "\n");
            } catch ($e) {
                print_error("http::serve: {$request["method"]} {$request["path"]}: the handler raised $e\n");
            }
            send_quietly($socket, $response ?? refusal(500, $head));
        }
    } finally {
        socket_close($socket);
    }
}

fn server_options($options) {
    if (type_of($options) != "map") {
        throw "http::serve() expects a map of options, got " .. type_of($options);
    }
    foreach ($options as $name => $value) {
        if (!has_key(SERVER_OPTIONS, $name)) {
            throw "http::serve() has no option " .. slice(to_string([$name]), 1, -1) .. ": only " .. join(keys(SERVER_OPTIONS), ", ");
        }
    }
    return {...SERVER_OPTIONS, ...$options};
}

// The request on a connection, or null if it closed before sending anything
fn read_request($reader, $socket, $max_body) {
    $head = $reader.line("\r\n\r\n", MAX_HEAD);
    if ($head == null) {
        if ($reader.pending()) {
            throw Refusal(400, "HTTP error: the connection closed in the middle of the head");
        }
        return null;
    }
    $lines = split($head, "\r\n");
    // "GET /path?query HTTP/1.1"
    $words = split($lines[0], " ");
    if (len($words) != 3) {
        throw Refusal(400, "HTTP error: bad request line");
    }
    [$method, $target, $version] = $words;
    if ($version != "HTTP/1.1" && $version != "HTTP/1.0") {
        throw Refusal(starts_with($version, "HTTP/") ? 505 : 400, "HTTP error: bad version");
    }
    check_request_token($method);
    if (!(starts_with($target, "/") || $target == "*" && $method == "OPTIONS") || has_control($target)) {
        throw Refusal(400, "HTTP error: bad request target");
    }
    $headers = {};
    foreach (slice($lines, 1) as $line) {
        $colon = index_of($line, ":");
        if ($colon == null || has_control($line, true)) {
            throw Refusal(400, "HTTP error: bad header line");
        }
        // No space before the colon, and no line folded onto the one before
        $name = lower(slice($line, 0, $colon));
        check_request_token($name);
        $value = trim(slice($line, $colon + 1));
        $headers[$name] = has_key($headers, $name) ? $headers[$name] .. ", " .. $value : $value;
    }
    if ($version == "HTTP/1.1" && !has_key($headers, "host")) {
        throw Refusal(400, "HTTP error: no Host header");
    }
    $query = index_of($target, "?");
    $request = {
        "method" => $method,
        "path" => $query == null ? $target : slice($target, 0, $query),
        "query" => $query == null ? "" : slice($target, $query + 1),
        "headers" => $headers,
        "body" => "",
    };
    $chunked = has_key($headers, "transfer-encoding");
    $length = has_key($headers, "content-length") ? content_length($headers["content-length"]) : 0;
    if ($chunked && has_key($headers, "content-length")) {
        throw Refusal(400, "HTTP error: both Content-Length and Transfer-Encoding");
    }
    if ($chunked && lower($headers["transfer-encoding"]) != "chunked") {
        throw Refusal(501, "HTTP error: a transfer coding other than chunked");
    }
    if ($length > $max_body) {
        throw Refusal(413, "HTTP error: a body of more than $max_body bytes");
    }
    if (!$chunked && $length == 0) {
        return $request;
    }
    // A client that waits to hear the body is wanted before sending it
    if (has_key($headers, "expect")) {
        if (lower($headers["expect"]) != "100-continue") {
            throw Refusal(417, "HTTP error: an expectation other than 100-continue");
        }
        socket_write($socket, "HTTP/1.1 100 Continue\r\n\r\n");
    }
    $request["body"] = $chunked ? read_chunked($reader, $max_body) : $reader.bytes($length);
    return $request;
}

fn check_request_token($name) {
    try {
        check_token("token", $name);
    } catch (Error $e) {
        throw Refusal(400, $e.message);
    }
}

// Whether a string has a byte below 33 or DEL (with $spaces, a space or tab is fine)
fn has_control($text, $spaces = false) {
    foreach (split($text, "") as $c) {
        $byte = ord($c);
        if (($byte < 33 || $byte == 127) && !($spaces && ($c == " " || $c == "\t"))) {
            return true;
        }
    }
    return false;
}

// The bytes of a handler's response, which is checked as a request's headers are
fn write_response($response, $head) {
    if (type_of($response) != "map") {
        throw "the handler returned " .. type_of($response) .. ", not a map of status, headers and body";
    }
    foreach ($response as $key => $value) {
        if (!in_array($key, ["status", "headers", "body"])) {
            throw "a response has status, headers and body, not " .. slice(to_string([$key]), 1, -1);
        }
    }
    $status = $response["status"] ?? 200;
    $body = $response["body"] ?? "";
    $headers = $response["headers"] ?? {};
    if (type_of($status) != "int" || $status < 200 || $status > 599) {
        throw "a response's status must be an int from 200 to 599, got " .. slice(to_string([$status]), 1, -1);
    }
    if (type_of($headers) != "map") {
        throw "a response's headers must be a map, got " .. type_of($headers);
    }
    if (is_html($body)) {
        $headers = with_html_type($headers);
        $body = to_string($body);
    }
    if (type_of($body) != "string") {
        throw "a response's body must be a string or Html, got " .. type_of($body);
    }
    $bodiless = $status == 204 || $status == 304;
    if ($bodiless && $body != "") {
        throw "a $status response has no body";
    }
    $lines = [status_line($status), "Date: " .. http_date(time()), "Connection: close"];
    foreach ($headers as $name => $value) {
        check_token("header name", $name);
        if (in_array(lower($name), ["content-length", "connection", "transfer-encoding", "date"])) {
            throw "HTTP error: header $name is written by http::serve";
        }
        // A list writes one line per value, since a repeated header (Set-Cookie above all,
        // whose values RFC 6265 forbids joining with a comma: an Expires attribute has one of
        // its own) needs more than one line; anything else is the one value it always was.
        foreach (type_of($value) == "list" ? $value : [$value] as $one) {
            $one = to_string($one);
            if (contains($one, "\r") || contains($one, "\n") || contains($one, "\0")) {
                throw "HTTP error: header $name has a line break or NUL byte in its value";
            }
            $lines[] = "$name: $one";
        }
    }
    if (!$bodiless) {
        $lines[] = "Content-Length: " .. len($body);
    }
    return join($lines, "\r\n") .. "\r\n\r\n" .. ($head ? "" : $body);
}

// A template's result, the builtin kind Html (which only a program using it has)
fn is_html($body) {
    return type_of($body) == "object" && kind_name($body) == "Html";
}

// An Html body is text/html unless the handler said otherwise
fn with_html_type($headers) {
    foreach (keys($headers) as $name) {
        if (lower($name) == "content-type") {
            return $headers;
        }
    }
    $headers["Content-Type"] = "text/html; charset=utf-8";

    return $headers;
}

// A response the server writes itself: the status and its reason, as plain text
fn refusal($status, $head = false) {
    $text = (REASONS[$status] ?? "Error") .. "\n";
    return write_response({"status" => $status, "headers" => {"Content-Type" => "text/plain"}, "body" => $text}, $head);
}

fn status_line($status) {
    return "HTTP/1.1 $status " .. (REASONS[$status] ?? "");
}

// Sent if the other end still listens; a client that has gone away is no error of the server's
fn send_quietly($socket, $bytes) {
    try {
        socket_write($socket, $bytes);
    } catch (Error $e) {
    }
}

fn describe_error($e) {
    $where = $e.file == null ? "line {$e.line}" : "{$e.file}:{$e.line}";
    $text = "{$e.message} at $where";
    foreach ($e.trace as $call) {
        $text ..= "\n    $call";
    }
    return $text;
}

// Seconds since 1970 as HTTP writes a date: "Sat, 08 Aug 2026 14:02:09 GMT"
pub fn http_date($time) {
    $days = intdiv($time, 86400);
    $seconds = $time - $days * 86400;
    if ($seconds < 0) {
        $days--;
        $seconds += 86400;
    }
    [$year, $month, $day] = date::civil($days);
    $clock = map([intdiv($seconds, 3600), intdiv($seconds, 60) % 60, $seconds % 60], $n -> ($n < 10 ? "0" : "") .. $n);
    return DAY_NAMES[date::weekday($days)] .. ", " .. ($day < 10 ? "0" : "") .. "$day "
        .. MONTH_NAMES[$month - 1] .. " $year " .. join($clock, ":") .. " GMT";
}

/*
 * A static file server: http::serve_static($dir) is a handler for http::serve() (or a
 * Router's not_found()) that answers from files under $dir.
 *
 * - The path is percent-decoded and split into segments, as a Router's is; a segment of ".."
 *   is refused the same way a missing file is, a 404, rather than resolved and hoped to land
 *   inside $dir: the two look alike to whoever asked, which is the point. So is a segment that
 *   decodes to hold a "/" (%2F is never a separator here), or "..%2f" would be a ".." too.
 * - A path ending in "/", or one naming a directory, looks for "index.html" inside it.
 * - Content-Type comes from the extension (CONTENT_TYPES); anything else is
 *   application/octet-stream.
 */
const CONTENT_TYPES = {
    "html" => "text/html; charset=utf-8", "css" => "text/css", "js" => "text/javascript",
    "json" => "application/json", "png" => "image/png", "jpg" => "image/jpeg",
    "jpeg" => "image/jpeg", "gif" => "image/gif", "svg" => "image/svg+xml",
    "ico" => "image/x-icon", "webp" => "image/webp", "txt" => "text/plain",
    "pdf" => "application/pdf", "woff" => "font/woff", "woff2" => "font/woff2",
    "ttf" => "font/ttf", "wasm" => "application/wasm", "mp4" => "video/mp4",
};

pub fn serve_static($dir) {
    return $request -> {
        $segments = decoded_segments($request["path"]);
        if ($segments == null || leaves_directory($segments)) {
            return plain(404, "Not Found");
        }
        $path = len($segments) == 0 ? $dir : $dir .. "/" .. join($segments, "/");
        if (ends_with($path, "/")) {
            $path ..= "index.html";
        } else if (is_dir($path)) {
            $path ..= "/index.html";
        }
        if (!file_exists($path) || is_dir($path)) {
            return plain(404, "Not Found");
        }

        return {"status" => 200, "headers" => {"Content-Type" => file_content_type($path)}, "body" => read_file($path)};
    };
}

// Whether decoded segments could name anything but a path down from the directory: a segment of
// ".." goes up, and a segment holding a "/" (it was %2F) is several, so "..%2f" is a ".." the
// check on whole segments never sees
fn leaves_directory($segments) {
    foreach ($segments as $segment) {
        if ($segment == ".." || contains($segment, "/")) {
            return true;
        }
    }

    return false;
}

// The extension after the last "."; none of the table's is application/octet-stream
fn file_content_type($path) {
    $parts = split($path, ".");
    $extension = len($parts) > 1 ? lower(last($parts)) : "";

    return CONTENT_TYPES[$extension] ?? "application/octet-stream";
}

/*
 * Routing requests to handlers, for http::serve():
 *
 *   $app = http::Router();
 *   $app.get("/users/:id", $request -> ({"body" => "user {$request["params"]["id"]}"}));
 *   $app.post("/users", $create_user);
 *   $app.use(($request, $next) -> $next($request));      // middleware
 *   http::serve($listener, $app.handler());
 *
 * - A pattern is a path whose segments are literal or :name. A :name takes one whole segment,
 *   never an empty one, percent-decoded, into $request["params"]; the handler gets the request
 *   with them in it. A %2F in a segment is a / in its value, never a separator.
 * - The first route added that matches wins.
 * - A path that matches with another method is a 405 with an Allow header; a GET route answers
 *   HEAD too. A path nothing matches is a 404, or what not_found() was given.
 * - A path that only matches with its trailing slash added or taken away is a 308 redirect to
 *   that spelling, so a link written either way works and each page has one URL.
 * - A bad percent-escape in the path is a 400.
 * - Middleware is ($request, $next) -> response, and wraps everything, the 404s included; the
 *   first added is the outermost.
 */
pub kind Router {
    #routes = [];
    #middleware = [];
    #not_found_handler = null;

    pub fn get($pattern, $handler) {
        #add("GET", $pattern, $handler);
    }

    pub fn post($pattern, $handler) {
        #add("POST", $pattern, $handler);
    }

    pub fn put($pattern, $handler) {
        #add("PUT", $pattern, $handler);
    }

    pub fn patch($pattern, $handler) {
        #add("PATCH", $pattern, $handler);
    }

    pub fn delete($pattern, $handler) {
        #add("DELETE", $pattern, $handler);
    }

    // Any other method, by name
    pub fn route($method, $pattern, $handler) {
        #add($method, $pattern, $handler);
    }

    pub fn use($middleware) {
        #middleware[] = $middleware;
    }

    pub fn not_found($handler) {
        #not_found_handler = $handler;
    }

    // The function to give http::serve(): the router with its middleware around it
    pub fn handler() {
        $dispatch = $request -> #dispatch($request);
        foreach (reverse(#middleware) as $middleware) {
            $dispatch = wrap($middleware, $dispatch);
        }

        return $dispatch;
    }

    fn add($method, $pattern, $handler) {
        #routes[] = Route($method, $pattern, $handler);
    }

    fn dispatch($request) {
        $segments = decoded_segments($request["path"]);
        if ($segments == null) {
            return plain(400, "Bad Request");
        }

        $allowed = [];
        foreach (#routes as $route) {
            $params = $route.match($segments);
            if ($params == null) {
                continue;
            }
            if ($route.answers($request["method"])) {
                return $route.run($request, $params);
            }
            $allowed[] = $route.method;
        }

        if (len($allowed) > 0) {
            return method_not_allowed($allowed);
        }

        return #elsewhere($request, $segments);
    }

    // No route has this path: its other spelling, or not found
    fn elsewhere($request, $segments) {
        $other = other_spelling($request["path"]);
        if ($other != null && #has_path(decoded_segments($other))) {
            return redirect($other, $request["query"]);
        }
        if (#not_found_handler != null) {
            return (#not_found_handler)($request);
        }

        return plain(404, "Not Found");
    }

    fn has_path($segments) {
        foreach (#routes as $route) {
            if ($route.match($segments) != null) {
                return true;
            }
        }

        return false;
    }
}

// One route: a method, a pattern cut into segments, and its handler
kind Route {
    #segments;
    #handler;

    fn _(pub #method, $pattern, $handler) {
        #segments = pattern_segments($pattern);
        #handler = $handler;
    }

    // The params the path's segments give this route, or null when it doesn't match
    pub fn match($segments) {
        if (len($segments) != len(#segments)) {
            return null;
        }
        $params = {};
        foreach (#segments as $i => $expected) {
            if (!is_param($expected)) {
                if ($expected != $segments[$i]) {
                    return null;
                }
                continue;
            }
            // A :name takes a whole segment, never an empty one: /users/ is not /users/:id
            if ($segments[$i] == "") {
                return null;
            }
            $params[param_name($expected)] = $segments[$i];
        }

        return $params;
    }

    pub fn answers($method) {
        return $method == #method || $method == "HEAD" && #method == "GET";
    }

    pub fn run($request, $params) {
        $request["params"] = $params;

        return (#handler)($request);
    }
}

// A pattern's segments, checked: "/users/:id" is ["users", ":id"]
fn pattern_segments($pattern) {
    if (type_of($pattern) != "string" || !starts_with($pattern, "/")) {
        throw "A route's pattern starts with /, got " .. slice(to_string([$pattern]), 1, -1);
    }
    $segments = segments($pattern);
    $names = [];
    foreach ($segments as $segment) {
        if (!is_param($segment)) {
            continue;
        }
        $name = param_name($segment);
        if ($name == "") {
            throw "A : in a route's pattern needs a name: $pattern";
        }
        if (in_array($name, $names)) {
            throw "A route's pattern names :$name twice: $pattern";
        }
        $names[] = $name;
    }

    return $segments;
}

// "/users/7" is ["users", "7"], and "/" is []
fn segments($path) {
    if ($path == "/") {
        return [];
    }

    return split(slice($path, 1), "/");
}

// A request path's segments, each percent-decoded, or null when an escape is bad
fn decoded_segments($path) {
    try {
        return map(segments($path), url_decode);
    } catch (Error $e) {
        return null;
    }
}

fn is_param($segment) {
    return starts_with($segment, ":");
}

fn param_name($segment) {
    return slice($segment, 1);
}

// The path with its trailing slash taken away or added, or null for "/"
fn other_spelling($path) {
    if ($path == "/") {
        return null;
    }
    if (ends_with($path, "/")) {
        return slice($path, 0, -1);
    }

    return $path .. "/";
}

fn wrap($middleware, $next) {
    return $request -> $middleware($request, $next);
}

fn redirect($path, $query) {
    $location = $path;
    if ($query != "") {
        $location ..= "?" .. $query;
    }

    return {"status" => 308, "headers" => {"Location" => $location}, "body" => ""};
}

fn method_not_allowed($methods) {
    $allowed = [];
    foreach ($methods as $method) {
        if (!in_array($method, $allowed)) {
            $allowed[] = $method;
        }
    }
    if (in_array("GET", $allowed)) {
        $allowed[] = "HEAD";
    }
    $response = plain(405, "Method Not Allowed");
    $response["headers"]["Allow"] = join($allowed, ", ");

    return $response;
}

fn plain($status, $text) {
    return {"status" => $status, "headers" => {"Content-Type" => "text/plain"}, "body" => $text .. "\n"};
}

/*
 * Decoding what a request carries: percent-escapes, query strings and form bodies.
 *
 * - http::url_decode($text) undoes percent-escapes (%20 is a space), as RFC 3986 has them: a
 *   + stays a +. A % that isn't followed by two hex digits is an error.
 * - http::url_encode($text) is the other way: everything but letters, digits and - . _ ~ as %XX.
 * - http::query($request) is the query string as a map of strings, and http::form($request) a
 *   form body (Content-Type application/x-www-form-urlencoded) the same way. In both, + is a
 *   space, as HTML forms send it. A key given twice keeps its last value; http::query_all()
 *   and http::form_all() give every value, as a list for each key.
 */

const UNRESERVED = "-._~";
const FORM_TYPE = "application/x-www-form-urlencoded";
const HEX = "0123456789ABCDEF";

pub fn url_decode($text) {
    $decoded = "";
    $at = 0;
    while (true) {
        $percent = index_of($text, "%", $at);
        if ($percent == null) {
            return $decoded .. slice($text, $at);
        }
        $decoded ..= slice($text, $at, $percent - $at) .. escaped_byte($text, $percent);
        $at = $percent + 3;
    }
}

pub fn url_encode($text) {
    $encoded = "";
    foreach (split($text, "") as $c) {
        if (is_alnum($c) || contains(UNRESERVED, $c)) {
            $encoded ..= $c;
        } else {
            $encoded ..= percent_escape($c);
        }
    }

    return $encoded;
}

pub fn query($request) {
    return last_values(query_all($request));
}

pub fn query_all($request) {
    return decode_pairs($request["query"]);
}

pub fn form($request) {
    return last_values(form_all($request));
}

pub fn form_all($request) {
    check_form_type($request);

    return decode_pairs($request["body"]);
}

// The byte the escape at $percent stands for: "%41" is "A"
fn escaped_byte($text, $percent) {
    $digits = slice($text, $percent + 1, 2);
    if (len($digits) < 2 || !is_hex_digit($digits[0]) || !is_hex_digit($digits[1])) {
        $escape = slice($text, $percent, 3);
        throw "bad percent-escape " .. slice(to_string([$escape]), 1, -1) .. " at $percent";
    }

    return chr(hex_digit($digits[0]) * 16 + hex_digit($digits[1]));
}

fn hex_digit($c) {
    return index_of(HEX, upper($c));
}

fn percent_escape($c) {
    $byte = ord($c);

    return "%" .. HEX[intdiv($byte, 16)] .. HEX[$byte % 16];
}

/*
 * "a=1&b=x+y&a=2" as {"a" => ["1", "2"], "b" => ["x y"]}, keys in the order they first come:
 * empty pieces are skipped, and a piece without = is a key whose value is ""
 */
fn decode_pairs($text) {
    $pairs = {};
    foreach (split($text, "&") as $piece) {
        if ($piece == "") {
            continue;
        }
        [$key, $value] = key_and_value($piece);
        $pairs[$key] ??= [];
        $pairs[$key][] = $value;
    }

    return $pairs;
}

fn key_and_value($piece) {
    $parts = split($piece, "=", 2);
    $key = form_decode($parts[0]);
    $value = "";
    if (len($parts) == 2) {
        $value = form_decode($parts[1]);
    }

    return [$key, $value];
}

// A form's text: + is a space, then percent-escapes
fn form_decode($text) {
    return url_decode(replace($text, "+", " "));
}

fn last_values($all) {
    return map($all, $values -> last($values));
}

fn check_form_type($request) {
    $type = $request["headers"]["content-type"] ?? "";
    $media_type = lower(trim(split($type, ";")[0]));
    if ($media_type != FORM_TYPE) {
        throw "http::form() needs a body sent as " .. FORM_TYPE .. ", not " .. slice(to_string([$type]), 1, -1);
    }
}

/*
 * Cookies, and signed sessions built on them.
 *
 * - http::cookies($request) is the Cookie header as a map, url_decode()d.
 * - http::set_cookie($response, $name, $value, $options = {}) returns $response with a
 *   Set-Cookie header added (a response can carry several: see write_response() above).
 *   $options: "path" (a Path attribute, "/" by default), "http_only" (an HttpOnly attribute,
 *   true by default: a cookie a page's own JavaScript can't read is one XSS can't steal),
 *   "secure" (a Secure attribute, false by default, since a plain http:// site couldn't send
 *   the cookie back), "same_site" ("Lax" by default, which stops a cookie going out on a
 *   cross-site request that isn't a plain navigation, the common CSRF vector) and "max_age" (a
 *   Max-Age attribute in seconds, a session cookie with none).
 * - http::session($request, $secret) reads and verifies the session cookie (crypto::sign() and
 *   crypto::equals(), on a json::encode()d map) and gives the map, or {} for no cookie or one
 *   that doesn't check out: a forged, tampered or expired cookie is routine, not an error a
 *   handler must catch.
 * - http::session_cookie($response, $session, $secret, $options = {}) is the other direction:
 *   $response with the session's Set-Cookie added.
 * - http::csrf_token($session) gets or makes a CSRF token in the session, returning the session
 *   (a handler saves it with session_cookie() as any other session change); http::verify_csrf()
 *   checks one a form submitted, with crypto::equals() as a signature is checked.
 */

const SESSION_COOKIE = "session";
const COOKIE_OPTIONS = {"path" => "/", "http_only" => true, "secure" => false, "same_site" => "Lax", "max_age" => null};

pub fn cookies($request) {
    $header = $request["headers"]["cookie"] ?? "";
    $cookies = {};
    foreach (split($header, ";") as $pair) {
        $pair = trim($pair);
        $equals = index_of($pair, "=");
        if ($pair == "" || $equals == null) {
            continue;
        }
        $cookies[trim(slice($pair, 0, $equals))] = url_decode(trim(slice($pair, $equals + 1)));
    }

    return $cookies;
}

pub fn set_cookie($response, $name, $value, $options = {}) {
    $headers = $response["headers"] ?? {};
    $existing = $headers["Set-Cookie"] ?? [];
    if (type_of($existing) != "list") {
        $existing = [$existing];
    }
    $existing[] = cookie_header($name, $value, $options);
    $headers["Set-Cookie"] = $existing;
    $response["headers"] = $headers;

    return $response;
}

fn cookie_header($name, $value, $options) {
    check_token("cookie name", $name);
    $options = cookie_options($options);
    $parts = ["$name=" .. url_encode(to_string($value))];
    if ($options["path"] != null) {
        $parts[] = "Path=" .. $options["path"];
    }
    if ($options["max_age"] != null) {
        $parts[] = "Max-Age=" .. $options["max_age"];
    }
    if ($options["secure"]) {
        $parts[] = "Secure";
    }
    if ($options["http_only"]) {
        $parts[] = "HttpOnly";
    }
    if ($options["same_site"] != null) {
        $parts[] = "SameSite=" .. $options["same_site"];
    }

    return join($parts, "; ");
}

fn cookie_options($options) {
    foreach ($options as $name => $value) {
        if (!has_key(COOKIE_OPTIONS, $name)) {
            throw "http::set_cookie() has no option " .. slice(to_string([$name]), 1, -1) .. ": only " .. join(keys(COOKIE_OPTIONS), ", ");
        }
    }

    return {...COOKIE_OPTIONS, ...$options};
}

pub fn session($request, $secret) {
    $signed = cookies($request)[SESSION_COOKIE] ?? null;
    if ($signed == null) {
        return {};
    }
    $payload = crypto::unsign($signed, $secret);
    if ($payload == null) {
        return {};
    }
    try {
        $session = json::decode($payload);
    } catch (Error $e) {
        return {};
    }

    return type_of($session) == "map" ? $session : {};
}

pub fn session_cookie($response, $session, $secret, $options = {}) {
    $payload = crypto::sign(json::encode($session), $secret);

    return set_cookie($response, SESSION_COOKIE, $payload, $options);
}

// The session with a CSRF token if it had none: check $session["csrf_token"] after calling
pub fn csrf_token($session) {
    $session["csrf_token"] ??= crypto::token();

    return $session;
}

pub fn verify_csrf($session, $submitted) {
    $token = $session["csrf_token"] ?? null;

    return $token != null && type_of($submitted) == "string" && crypto::equals($token, $submitted);
}
