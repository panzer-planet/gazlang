// Higher-order functions for GazLang: map, filter, reduce and sort, taking function values.
//
// Each takes a list or a map:
// - map($x, $f): $f($value) for each element; a list gives a list, a map a map with the same keys.
// - filter($x, $keep): the elements for which $keep($value) is true; a list gives a list,
//   a map a map with the kept keys.
// - reduce($x, $f, $initial): folds left, $f($carry, $value) from $initial.
// - sort($x, $compare): a new list of the values, ordered by $compare($a, $b), which
//   returns a negative number, zero or a positive number (write $a <=> $b). A stable merge
//   sort, so equal items keep their order.

fn map($x, $f) {
    if (type_of($x) == "list") {
        $list = [];
        foreach ($x as $value) {
            $list[] = $f($value);
        }
        return $list;
    }
    $map = {};
    foreach ($x as $key => $value) {
        $map[$key] = $f($value);
    }
    return $map;
}

fn filter($x, $keep) {
    if (type_of($x) == "list") {
        $list = [];
        foreach ($x as $value) {
            if ($keep($value)) {
                $list[] = $value;
            }
        }
        return $list;
    }
    $map = {};
    foreach ($x as $key => $value) {
        if ($keep($value)) {
            $map[$key] = $value;
        }
    }
    return $map;
}

fn reduce($x, $f, $initial) {
    $carry = $initial;
    foreach ($x as $value) {
        $carry = $f($carry, $value);
    }
    return $carry;
}

fn sort($x, $compare) {
    $list = values($x);
    if (len($list) < 2) {
        return $list;
    }

    $middle = intdiv(len($list), 2);
    $left = sort(slice($list, 0, $middle), $compare);
    $right = sort(slice($list, $middle), $compare);

    $merged = [];
    $l = 0;
    $r = 0;
    while ($l < len($left) && $r < len($right)) {
        // Take from the right only when it must come first, so equal items stay in order
        if ($compare($right[$r], $left[$l]) < 0) {
            $merged[] = $right[$r++];
        } else {
            $merged[] = $left[$l++];
        }
    }
    // One side is used up: the rest of the other follows as it is
    return [...$merged, ...slice($left, $l), ...slice($right, $r)];
}
