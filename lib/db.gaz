/**
 * Databases: SQLite and PostgreSQL behind one interface, on the db_open(), db_run() and db_close()
 * builtins, which a driver's library (libsqlite3, libpq) is built into the VM for, if it was found.
 *
 *   $db = db::open("sqlite:app.db");          // or "sqlite::memory:", or "postgres://user@host/name"
 *   $db.exec(db::sql"create table users (id integer primary key, name text)");
 *   $name = "Ada";
 *   $db.exec(db::sql"insert into users (name) values ({$name})");
 *   foreach ($db.query(db::sql"select * from users where name = {$name}") as $user) { echo $user["name"]; }
 *   $db.transaction($db -> { $db.exec(db::sql"delete from users"); });     // rolled back if it raises
 *
 * SQL is written `db::sql"..."`, and what it interpolates is sent apart from it, so nothing in a
 * value is ever read as SQL: a `Db` writes each database's own placeholders (`?` for SQLite, `$1`
 * for PostgreSQL) and refuses anything that isn't one, so a plain string can't reach the database
 * by accident. The ways round are deliberate and visible: `db::raw($text)`, for SQL built some
 * other way, and building a fragment through `kind_of()` of one, since a constructor is always
 * reachable. The `db_run()` builtin underneath still takes a string and a list of parameters.
 *
 * Only `{$`, `{@` and `{#` start an interpolation, so a fragment or a name is put in a variable
 * first: `$column = db::ident("name");` then `{$column}`.
 *
 * A row is a map from column name to value (a repeated name keeps the last); int, float, bool
 * (PostgreSQL only) and null come back as themselves and everything else as a string. Errors are
 * catchable, and say which database gave them. With values the SQL is one statement; without, it
 * may be a script, and the last statement's result is the one given.
 */
namespace db;

import "std/chars.gaz" use char_at, span, is_digit, is_alpha, is_alnum;

/**
 * A connection to a database, made by db::open(), whose methods each take one
 * `db::sql"..."` and refuse anything else
 */
pub kind Db {
    #handle;
    #placeholder;
    #depth = 0;

    /**
     * A connection to the database $url names (see db::open())
     */
    fn _($url) {
        #handle = db_open($url);
        #placeholder = placeholder_for($url);
    }

    /**
     * {"rows" => [row, ...], "changes" => rows an insert, update or delete changed}
     */
    pub fn run($sql) {
        return #result($sql, "run");
    }

    /**
     * The rows, each a map from column name to value
     */
    pub fn query($sql) {
        return #result($sql, "query")["rows"];
    }

    /**
     * The first row, or null when there is none
     */
    pub fn row($sql) {
        return #result($sql, "row")["rows"][0] ?? null;
    }

    /**
     * The first column of the first row, or null when there is none
     */
    pub fn value($sql) {
        $row = #result($sql, "value")["rows"][0] ?? null;
        return $row == null ? null : values($row)[0];
    }

    /**
     * How many rows an insert, update or delete changed
     */
    pub fn exec($sql) {
        return #result($sql, "exec")["changes"];
    }

    /**
     * Runs $work with this database between begin and commit, gives what it returns, and rolls
     * back and raises again if it raises. Inside another transaction it is a savepoint instead.
     */
    pub fn transaction($work) {
        $savepoint = "gaz_savepoint_" .. #depth;
        db_run(#handle, #depth == 0 ? "begin" : "savepoint " .. $savepoint);
        #depth++;
        try {
            $result = $work(#);
            /* Inside the try, so a commit the database refuses is rolled back like a failure of the work */
            db_run(#handle, #depth == 1 ? "commit" : "release " .. $savepoint);
        } catch ($e) {
            #depth--;
            db_run(#handle, #depth == 0 ? "rollback" : "rollback to " .. $savepoint);
            throw $e;
        }
        #depth--;
        return $result;
    }

    /**
     * Close the connection; closing it twice is fine, and it closes by itself when the last
     * reference to it goes
     */
    pub fn close() {
        db_close(#handle);
    }

    // Runs an Sql, rendered for this database; anything else is refused, naming the method
    fn result($sql, $method) {
        if (!is_a($sql, Sql)) {
            throw "Db.{$method}() takes db::sql\"...\", not " .. described($sql) .. ': write db::sql"select ... where id = {$id}", or db::raw($text) for SQL built some other way';
        }
        [$text, $params] = $sql.render(#placeholder);
        return db_run(#handle, $text, $params);
    }
}

// Each database's placeholders, by the URL's scheme, as db_open() reads it
fn placeholder_for($url) {
    if (starts_with($url, "sqlite:")) {
        return question_mark;
    }
    return numbered;
}

fn question_mark($n) {
    return "?";
}

fn numbered($n) {
    return '$' .. $n;
}

/**
 * A connection to the database $url names: "sqlite:app.db", "sqlite::memory:" for one in
 * memory, or "postgres://user:password@host:port/name" (postgresql:// too). A driver the VM was
 * built without, or a database that can't be opened, is an error.
 */
pub fn open($url) {
    return Db($url);
}

// What a value sent to the database may be, and what an in (...) list may hold
const SCALARS = ["int", "float", "string", "bool", "null"];
// How SQLite and PostgreSQL number a parameter in the text: ?1, $1
const NUMBERED_PLACEHOLDERS = ["?", '$'];

/*
 * A piece of SQL with its values kept apart, made by the tag `db::sql"..."`, or by `db::raw()`. The
 * text parts are always one more than the values. Nothing about it changes once it is made, and
 * printing it shows the SQL with `?` for each value, never the values, which may be secrets. Not
 * `pub`, so no program writes `db::Sql(...)` from a string by accident: only the tag and `raw()`
 * make one.
 */
kind Sql {
    #strings;
    #values;

    fn _(list $strings, list $values) {
        if (len($strings) != len($values) + 1) {
            throw "db::Sql() takes one more text part than values, got " .. len($strings) .. " and " .. len($values);
        }
        foreach ($strings as $text) {
            if (type_of($text) != "string") {
                throw "db::Sql() takes strings as its text parts, got " .. described($text);
            }
        }
        foreach ($values as $value) {
            check_value($value);
        }
        #strings = $strings;
        #values = $values;
    }

    /*
     * The SQL for one database and the values to send with it, as `[$text, $params]`.
     * `$placeholder` gives the text for the Nth value, counted from 1 across every fragment spliced
     * in: `$n -> "?"` for SQLite, `$n -> '$' .. $n` for PostgreSQL. A `Db` calls it for you.
     */
    pub fn render($placeholder): list {
        $rendering = Rendering($placeholder);
        #write_into($rendering);
        return [$rendering.text, $rendering.params];
    }

    pub fn to_string(): string {
        return #render(question_mark)[0];
    }

    fn write_into($rendering) {
        foreach (#values as $i => $value) {
            $rendering.write(#strings[$i]);
            #write_value($rendering, $value);
        }
        $rendering.write(last(#strings));
    }

    fn write_value($rendering, $value) {
        if (is_a($value, Sql)) {
            $value.write_into($rendering);
            return;
        }
        if (is_a($value, Ident)) {
            $rendering.write($value.quoted());
            return;
        }
        if (type_of($value) == "list") {
            #write_list($rendering, $value);
            return;
        }
        $rendering.parameter($value);
    }

    // A list is one placeholder for each item, in parentheses, for in (...)
    fn write_list($rendering, $items) {
        $rendering.write("(");
        foreach ($items as $i => $item) {
            if ($i > 0) {
                $rendering.write(", ");
            }
            $rendering.parameter($item);
        }
        $rendering.write(")");
    }
}

// The text being written and the values it has taken so far
kind Rendering {
    pub #text = "";
    pub #params = [];
    #placeholder;

    fn _($placeholder) {
        #placeholder = $placeholder;
    }

    pub fn write($text) {
        #text ..= $text;
    }

    pub fn parameter($value) {
        #params[] = $value;
        $placeholder = #placeholder;
        #text ..= $placeholder(len(#params));
    }
}

/**
 * A name in the SQL (a table or a column) that can't be a parameter, written `"name"` with each `"`
 * in it doubled, so any text is one name and never more SQL. Quoted names keep their case in
 * PostgreSQL: `"Name"` and `name` are different columns there. A dot is part of the name, so a table
 * in a schema is two, `{$schema}.{$table}`, each a `db::ident()`.
 */
pub kind Ident {
    #name;

    /**
     * The name $name; an empty one, or one holding a NUL byte, is an error
     */
    fn _(string $name) {
        if ($name == "") {
            throw "db::ident() can't take an empty name";
        }
        if (contains($name, "\0")) {
            throw "db::ident() can't take a name holding a NUL byte";
        }
        #name = $name;
    }

    /**
     * The name in double quotes, a `"` in it doubled
     */
    pub fn quoted(): string {
        return '"' .. replace(#name, '"', '""') .. '"';
    }

    /**
     * The name as the SQL shows it, quoted()
     */
    pub fn to_string(): string {
        return #quoted();
    }
}

/**
 * The tag: `db::sql"select * from users where id = {$id}"` is SQL whose values are sent apart from
 * it, so nothing in them is ever read as SQL. A value may be:
 *
 * - an int, float, string, bool or null: one parameter;
 * - a list of those: `(?, ?, ?)`, for `where id in {$ids}`; an empty list is an error, since
 *   `in ()` isn't SQL and what no items should mean (nothing, or everything) is the program's to say;
 * - another `db::sql"..."`: spliced in, its values numbered along with the rest, so a condition can
 *   be built apart and added or left out;
 * - `db::ident($name)`: a table or column name, quoted.
 *
 * The text can't hold `$1` or `?1`: that is how PostgreSQL and SQLite number parameters, so it
 * would be read as whichever value has that number. Nor can it hold what looks like a call in
 * braces, `{db::ident($c)}`, which is text, since only `{$`, `{@` and `{#` start an
 * interpolation. Interpolate a variable instead; `db::raw()` is the way round a false alarm, such
 * as `$1` inside an SQL string literal or a `$$...$$` function body.
 */
pub fn sql(list $strings, list $values): Sql {
    foreach ($strings as $text) {
        check_text($text);
    }
    return Sql($strings, $values);
}

/**
 * SQL built some other way, used as it is, with no values: a migration read from a file, or a
 * statement put together by code that is trusted to do so. Every use is a place to check by hand.
 */
pub fn raw(string $text): Sql {
    return Sql([$text], []);
}

/**
 * A table or column name for a `db::sql"..."`, written quoted (see `Ident`)
 */
pub fn ident(string $name): Ident {
    return Ident($name);
}

/*
 * What the tag refuses in its text: a numbered placeholder, which the database would bind to
 * whichever value has that number, and a call written where only a variable is interpolated.
 */
fn check_text($text) {
    foreach (NUMBERED_PLACEHOLDERS as $mark) {
        check_no_numbered_placeholder($text, $mark);
    }
    check_no_call($text);
}

fn check_no_numbered_placeholder($text, $mark) {
    foreach (positions($text, $mark) as $at) {
        $next = char_at($text, $at + 1);
        if (is_digit($next)) {
            throw "db::sql text can't hold " .. $mark .. $next .. ": interpolate the value instead";
        }
    }
}

// `{db::ident($c)}` in the text is text: only `{$`, `{@` and `{#` start an interpolation
fn check_no_call($text) {
    foreach (positions($text, "{") as $at) {
        $call = call_at($text, $at + 1);
        if ($call != null) {
            throw "db::sql text holds {" .. $call .. '}: only a variable is interpolated, so write $value = ' .. $call .. ' first, then {$value}';
        }
    }
}

/*
 * What looks like a call written at $start, shown as `db::ident(...)`, `upper(...)` or
 * `Kind::NAME`: a name followed by `(`, or a qualified one. Null for anything else, so `'{1,2}'`,
 * `'{a,b}'` and `'{"k": 1}'` stay text.
 */
fn call_at($text, $start) {
    $at = $start;
    $qualified = false;
    while (is_name_start(char_at($text, $at))) {
        $at += span($text, $at, is_name_char);
        if (!starts_with($text, "::", $at)) {
            break;
        }
        $at += 2;
        $qualified = true;
    }
    if ($at > $start && char_at($text, $at) == "(") {
        return slice($text, $start, $at - $start) .. "(...)";
    }
    if ($qualified) {
        return slice($text, $start, $at - $start);
    }
    return null;
}

fn is_name_start($c) {
    return is_alpha($c) || $c == "_";
}

fn is_name_char($c) {
    return is_alnum($c) || $c == "_";
}

// Where $needle starts in $text, each time, left to right
fn positions($text, $needle) {
    $found = [];
    $at = index_of($text, $needle);
    while ($at != null) {
        $found[] = $at;
        if ($at + 1 >= len($text)) {
            break;
        }
        $at = index_of($text, $needle, $at + 1);
    }
    return $found;
}

fn check_value($value) {
    if (is_a($value, Sql) || is_a($value, Ident) || in_array(type_of($value), SCALARS)) {
        return;
    }
    if (type_of($value) != "list") {
        throw "db::sql can't send " .. described($value) .. ': a value is an int, float, string, bool or null, a list of those, a db::sql"..." or a db::ident()';
    }
    if (len($value) == 0) {
        throw "db::sql can't put an empty list in (...): decide what no items means";
    }
    foreach ($value as $item) {
        if (!in_array(type_of($item), SCALARS)) {
            throw "db::sql can't put " .. described($item) .. " in a list: an in (...) list holds ints, floats, strings, bools and nulls";
        }
    }
}

// A value's type for a message: "a string", "an int", "null", "a Point"
fn described($value) {
    $type = type_of($value);
    if ($type == "object") {
        $type = kind_name($value);
    }
    if ($type == "null") {
        return "null";
    }
    if ($type == "int") {
        return "an int";
    }
    return "a " .. $type;
}
