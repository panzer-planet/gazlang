/**
 * Databases: SQLite and PostgreSQL behind one interface, on the db_open(), db_run(), db_error() and
 * db_close() builtins, which a driver's library (libsqlite3, libpq) is built into the VM for, if it was found.
 *
 *   $db = db::open("sqlite:app.db");          // or "sqlite::memory:", or "postgres://user@host/name"
 *   $db.exec(db::sql"create table users (id integer primary key, name text)");
 *   $name = "Ada";
 *   $db.exec(db::sql"insert into users (name) values ({$name})");
 *   foreach ($db.query(db::sql"select * from users where name = {$name}") as $user) { echo $user["name"]; }
 *   $db.transaction($db -> { $db.exec(db::sql"delete from users"); });     // rolled back if it raises
 *
 * SQL is written `db::sql"..."`, and what it interpolates is sent apart from it, so nothing in a
 * value is ever read as SQL: a `Db` writes each database's own placeholders (`?` for SQLite, `$1`
 * for PostgreSQL) and refuses anything that isn't one, so a plain string can't reach the database
 * by accident. The ways round are deliberate and visible: `db::raw($text)`, for SQL built some
 * other way, and building a fragment through `kind_of()` of one, since a constructor is always
 * reachable. The `db_run()` builtin underneath still takes a string and a list of parameters.
 *
 * Only `{$`, `{@`, `{#` and a constant's `{NAME}` start an interpolation, so a fragment or a name
 * is put in a variable first: `$column = db::ident("name");` then `{$column}`. A constant is a
 * value like a variable's, bound as a parameter.
 *
 * A row is a map from column name to value (a repeated name keeps the last); int, float, bool
 * (PostgreSQL only) and null come back as themselves and everything else as a string. With values
 * the SQL is one statement; without, it may be a script, and the last statement's result is the one
 * given.
 *
 * Errors are catchable, and say which database gave them. One the database itself gave is a
 * `db::Failure`, which carries the database's own code and a `db::Problem` that is the same for
 * both databases, so a program tells a taken email from anything else without reading the message:
 *
 *   try {
 *       $db.exec(db::sql"insert into users (email) values ({$email})");
 *   } catch (db::Failure $e) {
 *       if ($e.problem != db::Problem::Unique) { throw $e; }
 *       // the email is taken
 *   }
 */
namespace db;

import "std/chars.gaz" use char_at, span, is_digit, is_alpha, is_alnum;

/**
 * A connection to a database, made by db::open(), whose methods each take one
 * `db::sql"..."` and refuse anything else
 */
pub kind Db {
    #handle;
    #driver;
    #placeholder;
    #depth = 0;

    /**
     * A connection to the database $url names (see db::open())
     */
    fn _($url) {
        #handle = db_open($url);
        #driver = driver_for($url);
        #placeholder = #driver == SQLITE ? question_mark : numbered;
    }

    /**
     * {"rows" => [row, ...], "changes" => rows an insert, update or delete changed}
     */
    pub fn run($sql) {
        return #result($sql, "run");
    }

    /**
     * The rows, each a map from column name to value
     */
    pub fn query($sql) {
        return #result($sql, "query")["rows"];
    }

    /**
     * The first row, or null when there is none
     */
    pub fn row($sql) {
        return #result($sql, "row")["rows"][0] ?? null;
    }

    /**
     * The first column of the first row, or null when there is none
     */
    pub fn value($sql) {
        $row = #result($sql, "value")["rows"][0] ?? null;
        return $row == null ? null : values($row)[0];
    }

    /**
     * How many rows an insert, update or delete changed
     */
    pub fn exec($sql) {
        return #result($sql, "exec")["changes"];
    }

    /**
     * Runs $work with this database between begin and commit, gives what it returns, and rolls
     * back and raises again if it raises. Inside another transaction it is a savepoint instead.
     */
    pub fn transaction($work) {
        $savepoint = "gaz_savepoint_" .. #depth;
        #execute(#depth == 0 ? "begin" : "savepoint " .. $savepoint);
        #depth++;
        try {
            $result = $work(#);
            /* Inside the try, so a commit the database refuses is rolled back like a failure of the work */
            #execute(#depth == 1 ? "commit" : "release " .. $savepoint);
        } catch ($e) {
            #depth--;
            #execute(#depth == 0 ? "rollback" : "rollback to " .. $savepoint);
            throw $e;
        }
        #depth--;
        return $result;
    }

    /**
     * Close the connection; closing it twice is fine, and it closes by itself when the last
     * reference to it goes
     */
    pub fn close() {
        db_close(#handle);
    }

    // Runs an Sql, rendered for this database; anything else is refused, naming the method
    fn result($sql, $method) {
        if (!is_a($sql, Sql)) {
            throw "Db.{$method}() takes db::sql\"...\", not " .. described($sql) .. ': write db::sql"select ... where id = {$id}", or db::raw($text) for SQL built some other way';
        }
        [$text, $params] = $sql.render(#placeholder);
        return #execute($text, $params);
    }

    /*
     * db_run(), with what the database refused raised as a Failure. An error db_error() has nothing
     * for (a closed handle, a parameter no database could store) was gaz's to find, and goes on as
     * it is.
     */
    fn execute($text, $params = []) {
        try {
            return db_run(#handle, $text, $params);
        } catch (Error $e) {
            $fields = db_error(#handle);
            if ($fields == null) {
                throw $e;
            }
            throw Failure($e.message, #driver, $fields);
        }
    }
}

const SQLITE = "sqlite";
const POSTGRES = "postgres";

// Which database the URL is, by its scheme, as db_open() reads it
fn driver_for($url) {
    if (starts_with($url, "sqlite:")) {
        return SQLITE;
    }
    return POSTGRES;
}

fn question_mark($n) {
    return "?";
}

fn numbered($n) {
    return '$' .. $n;
}

/**
 * What went wrong, the same whichever database said so (see Failure). Each database's codes map to
 * one of these as `docs/library.md` lists them; everything else is Other.
 */
pub enum Problem {
    /**
     * A row would repeat a value a unique index or primary key allows once: an email already taken
     */
    Unique;
    /**
     * A row would point at one that isn't there, or a row others point at would go
     */
    ForeignKey;
    /**
     * A column that can't be null would be
     */
    NotNull;
    /**
     * A row fails a check constraint
     */
    Check;
    /**
     * The transaction lost to another (a serialization failure or a deadlock) and can't go on: rolled
     * back, as Db.transaction() does, and run again from the start, it can succeed
     */
    Retry;
    /**
     * A lock another connection holds wasn't let go of in time: the statement can be tried again
     */
    Busy;
    /**
     * The connection to the server is gone, or the server is shutting down
     */
    Disconnected;
    /**
     * Anything else: a syntax error, a missing table, a value of the wrong type...
     */
    Other;
}

/**
 * An error the database itself gave, not gaz: its message is the database's own words after
 * `sqlite:` or `postgres:`, as an Error's always was, and the rest is what the database said about
 * it, for a program to act on.
 */
pub kind Failure extends Error {
    /**
     * "sqlite" or "postgres"
     */
    pub #driver;
    /**
     * The database's own code: SQLite's extended result code, an int (2067 for a unique
     * constraint), or PostgreSQL's SQLSTATE, five characters ("23505"). PostgreSQL gives null for
     * an error libpq made itself, but 08006 when the connection is gone.
     */
    pub #code;
    /**
     * SQLite's name for its code ("SQLITE_CONSTRAINT_UNIQUE"), or null for PostgreSQL, whose code
     * is its own name, or a code this gaz doesn't know
     */
    pub #name;
    /**
     * The constraint that failed ("users_email_key") as PostgreSQL gives it; null when it doesn't,
     * and always with SQLite, which only names it in its message
     */
    pub #constraint;
    /**
     * The table the error is about, or null (see constraint)
     */
    pub #table;
    /**
     * The column the error is about, or null (see constraint)
     */
    pub #column;
    /**
     * What went wrong, the same for both databases
     */
    pub Problem #problem;

    /**
     * A failure with $message, from the $driver database ("sqlite" or "postgres"), and $fields as
     * db_error() gives them: `{"code" => ...}`, and with PostgreSQL "constraint", "table" and
     * "column"
     */
    fn _(string $message, string $driver, map $fields) {
        ##_($message);
        #driver = $driver;
        #code = $fields["code"] ?? null;
        #constraint = $fields["constraint"] ?? null;
        #table = $fields["table"] ?? null;
        #column = $fields["column"] ?? null;
        if ($driver == SQLITE) {
            #name = SQLITE_NAMES[#code] ?? null;
            #problem = sqlite_problem(#code);
        } else {
            #name = null;
            #problem = postgres_problem(#code);
        }
    }
}

// SQLite's result codes, primary and extended, by number, from sqlite3.h
const SQLITE_NAMES = {
    1 => "SQLITE_ERROR",
    2 => "SQLITE_INTERNAL",
    3 => "SQLITE_PERM",
    4 => "SQLITE_ABORT",
    5 => "SQLITE_BUSY",
    6 => "SQLITE_LOCKED",
    7 => "SQLITE_NOMEM",
    8 => "SQLITE_READONLY",
    9 => "SQLITE_INTERRUPT",
    10 => "SQLITE_IOERR",
    11 => "SQLITE_CORRUPT",
    12 => "SQLITE_NOTFOUND",
    13 => "SQLITE_FULL",
    14 => "SQLITE_CANTOPEN",
    15 => "SQLITE_PROTOCOL",
    16 => "SQLITE_EMPTY",
    17 => "SQLITE_SCHEMA",
    18 => "SQLITE_TOOBIG",
    19 => "SQLITE_CONSTRAINT",
    20 => "SQLITE_MISMATCH",
    21 => "SQLITE_MISUSE",
    22 => "SQLITE_NOLFS",
    23 => "SQLITE_AUTH",
    24 => "SQLITE_FORMAT",
    25 => "SQLITE_RANGE",
    26 => "SQLITE_NOTADB",
    257 => "SQLITE_ERROR_MISSING_COLLSEQ",
    261 => "SQLITE_BUSY_RECOVERY",
    262 => "SQLITE_LOCKED_SHAREDCACHE",
    264 => "SQLITE_READONLY_RECOVERY",
    266 => "SQLITE_IOERR_READ",
    267 => "SQLITE_CORRUPT_VTAB",
    270 => "SQLITE_CANTOPEN_NOTEMPDIR",
    275 => "SQLITE_CONSTRAINT_CHECK",
    279 => "SQLITE_AUTH_USER",
    513 => "SQLITE_ERROR_RETRY",
    516 => "SQLITE_ABORT_ROLLBACK",
    517 => "SQLITE_BUSY_SNAPSHOT",
    518 => "SQLITE_LOCKED_VTAB",
    520 => "SQLITE_READONLY_CANTLOCK",
    522 => "SQLITE_IOERR_SHORT_READ",
    523 => "SQLITE_CORRUPT_SEQUENCE",
    526 => "SQLITE_CANTOPEN_ISDIR",
    531 => "SQLITE_CONSTRAINT_COMMITHOOK",
    769 => "SQLITE_ERROR_SNAPSHOT",
    773 => "SQLITE_BUSY_TIMEOUT",
    776 => "SQLITE_READONLY_ROLLBACK",
    778 => "SQLITE_IOERR_WRITE",
    779 => "SQLITE_CORRUPT_INDEX",
    782 => "SQLITE_CANTOPEN_FULLPATH",
    787 => "SQLITE_CONSTRAINT_FOREIGNKEY",
    1032 => "SQLITE_READONLY_DBMOVED",
    1034 => "SQLITE_IOERR_FSYNC",
    1038 => "SQLITE_CANTOPEN_CONVPATH",
    1043 => "SQLITE_CONSTRAINT_FUNCTION",
    1288 => "SQLITE_READONLY_CANTINIT",
    1290 => "SQLITE_IOERR_DIR_FSYNC",
    1294 => "SQLITE_CANTOPEN_DIRTYWAL",
    1299 => "SQLITE_CONSTRAINT_NOTNULL",
    1544 => "SQLITE_READONLY_DIRECTORY",
    1546 => "SQLITE_IOERR_TRUNCATE",
    1550 => "SQLITE_CANTOPEN_SYMLINK",
    1555 => "SQLITE_CONSTRAINT_PRIMARYKEY",
    1802 => "SQLITE_IOERR_FSTAT",
    1811 => "SQLITE_CONSTRAINT_TRIGGER",
    2058 => "SQLITE_IOERR_UNLOCK",
    2067 => "SQLITE_CONSTRAINT_UNIQUE",
    2314 => "SQLITE_IOERR_RDLOCK",
    2323 => "SQLITE_CONSTRAINT_VTAB",
    2570 => "SQLITE_IOERR_DELETE",
    2579 => "SQLITE_CONSTRAINT_ROWID",
    2826 => "SQLITE_IOERR_BLOCKED",
    2835 => "SQLITE_CONSTRAINT_PINNED",
    3082 => "SQLITE_IOERR_NOMEM",
    3091 => "SQLITE_CONSTRAINT_DATATYPE",
    3338 => "SQLITE_IOERR_ACCESS",
    3594 => "SQLITE_IOERR_CHECKRESERVEDLOCK",
    3850 => "SQLITE_IOERR_LOCK",
    4106 => "SQLITE_IOERR_CLOSE",
    4362 => "SQLITE_IOERR_DIR_CLOSE",
    4618 => "SQLITE_IOERR_SHMOPEN",
    4874 => "SQLITE_IOERR_SHMSIZE",
    5130 => "SQLITE_IOERR_SHMLOCK",
    5386 => "SQLITE_IOERR_SHMMAP",
    5642 => "SQLITE_IOERR_SEEK",
    5898 => "SQLITE_IOERR_DELETE_NOENT",
    6154 => "SQLITE_IOERR_MMAP",
    6410 => "SQLITE_IOERR_GETTEMPPATH",
    6666 => "SQLITE_IOERR_CONVPATH",
    6922 => "SQLITE_IOERR_VNODE",
    7178 => "SQLITE_IOERR_AUTH",
    7434 => "SQLITE_IOERR_BEGIN_ATOMIC",
    7690 => "SQLITE_IOERR_COMMIT_ATOMIC",
    7946 => "SQLITE_IOERR_ROLLBACK_ATOMIC",
    8202 => "SQLITE_IOERR_DATA",
    8458 => "SQLITE_IOERR_CORRUPTFS",
    8714 => "SQLITE_IOERR_IN_PAGE",
};

// The low byte of an extended SQLite code is its primary one: SQLITE_BUSY_SNAPSHOT's is SQLITE_BUSY
const SQLITE_PRIMARY_MASK = 255;

// What an SQLite code is, by its extended name first and then its primary one
fn sqlite_problem(int $code): Problem {
    $problem = match (SQLITE_NAMES[$code] ?? null) {
        "SQLITE_CONSTRAINT_UNIQUE", "SQLITE_CONSTRAINT_PRIMARYKEY", "SQLITE_CONSTRAINT_ROWID" => Problem::Unique,
        "SQLITE_CONSTRAINT_FOREIGNKEY" => Problem::ForeignKey,
        "SQLITE_CONSTRAINT_NOTNULL" => Problem::NotNull,
        "SQLITE_CONSTRAINT_CHECK" => Problem::Check,
        "SQLITE_BUSY_SNAPSHOT" => Problem::Retry,
        default => null,
    };
    if ($problem != null) {
        return $problem;
    }
    return match (SQLITE_NAMES[$code & SQLITE_PRIMARY_MASK] ?? null) {
        "SQLITE_BUSY", "SQLITE_LOCKED" => Problem::Busy,
        default => Problem::Other,
    };
}

// SQLSTATE's class 08, connection exception
const CONNECTION_CLASS = "08";

// What a SQLSTATE is, by PostgreSQL's appendix of error codes
fn postgres_problem($sqlstate): Problem {
    if ($sqlstate == null) {
        return Problem::Other;
    }
    if (starts_with($sqlstate, CONNECTION_CLASS)) {
        return Problem::Disconnected;
    }
    return match ($sqlstate) {
        "23505" => Problem::Unique,                             // unique_violation
        "23503" => Problem::ForeignKey,                         // foreign_key_violation
        "23502" => Problem::NotNull,                            // not_null_violation
        "23514" => Problem::Check,                              // check_violation
        "40001", "40P01" => Problem::Retry,                     // serialization_failure, deadlock_detected
        "55P03" => Problem::Busy,                               // lock_not_available
        "57P01", "57P02", "57P03" => Problem::Disconnected,     // admin_shutdown, crash_shutdown, cannot_connect_now
        default => Problem::Other,
    };
}

/**
 * A connection to the database $url names: "sqlite:app.db", "sqlite::memory:" for one in
 * memory, or "postgres://user:password@host:port/name" (postgresql:// too). A driver the VM was
 * built without, or a database that can't be opened, is an error.
 */
pub fn open($url) {
    return Db($url);
}

// What a value sent to the database may be, and what an in (...) list may hold
const SCALARS = ["int", "float", "string", "bool", "null"];
// How SQLite and PostgreSQL number a parameter in the text: ?1, $1
const NUMBERED_PLACEHOLDERS = ["?", '$'];

/*
 * A piece of SQL with its values kept apart, made by the tag `db::sql"..."`, or by `db::raw()`. The
 * text parts are always one more than the values. Nothing about it changes once it is made, and
 * printing it shows the SQL with `?` for each value, never the values, which may be secrets. Not
 * `pub`, so no program writes `db::Sql(...)` from a string by accident: only the tag and `raw()`
 * make one.
 */
kind Sql {
    #strings;
    #values;

    fn _(list $strings, list $values) {
        if (len($strings) != len($values) + 1) {
            throw "db::Sql() takes one more text part than values, got " .. len($strings) .. " and " .. len($values);
        }
        foreach ($strings as $text) {
            if (type_of($text) != "string") {
                throw "db::Sql() takes strings as its text parts, got " .. described($text);
            }
        }
        foreach ($values as $value) {
            check_value($value);
        }
        #strings = $strings;
        #values = $values;
    }

    /*
     * The SQL for one database and the values to send with it, as `[$text, $params]`.
     * `$placeholder` gives the text for the Nth value, counted from 1 across every fragment spliced
     * in: `$n -> "?"` for SQLite, `$n -> '$' .. $n` for PostgreSQL. A `Db` calls it for you.
     */
    pub fn render($placeholder): list {
        $rendering = Rendering($placeholder);
        #write_into($rendering);
        return [$rendering.text, $rendering.params];
    }

    pub fn to_string(): string {
        return #render(question_mark)[0];
    }

    fn write_into($rendering) {
        foreach (#values as $i => $value) {
            $rendering.write(#strings[$i]);
            #write_value($rendering, $value);
        }
        $rendering.write(last(#strings));
    }

    fn write_value($rendering, $value) {
        if (is_a($value, Sql)) {
            $value.write_into($rendering);
            return;
        }
        if (is_a($value, Ident)) {
            $rendering.write($value.quoted());
            return;
        }
        if (type_of($value) == "list") {
            #write_list($rendering, $value);
            return;
        }
        $rendering.parameter($value);
    }

    // A list is one placeholder for each item, in parentheses, for in (...)
    fn write_list($rendering, $items) {
        $rendering.write("(");
        foreach ($items as $i => $item) {
            if ($i > 0) {
                $rendering.write(", ");
            }
            $rendering.parameter($item);
        }
        $rendering.write(")");
    }
}

// The text being written and the values it has taken so far
kind Rendering {
    pub #text = "";
    pub #params = [];
    #placeholder;

    fn _($placeholder) {
        #placeholder = $placeholder;
    }

    pub fn write($text) {
        #text ..= $text;
    }

    pub fn parameter($value) {
        #params[] = $value;
        $placeholder = #placeholder;
        #text ..= $placeholder(len(#params));
    }
}

/**
 * A name in the SQL (a table or a column) that can't be a parameter, written `"name"` with each `"`
 * in it doubled, so any text is one name and never more SQL. Quoted names keep their case in
 * PostgreSQL: `"Name"` and `name` are different columns there. A dot is part of the name, so a table
 * in a schema is two, `{$schema}.{$table}`, each a `db::ident()`.
 */
pub kind Ident {
    #name;

    /**
     * The name $name; an empty one, or one holding a NUL byte, is an error
     */
    fn _(string $name) {
        if ($name == "") {
            throw "db::ident() can't take an empty name";
        }
        if (contains($name, "\0")) {
            throw "db::ident() can't take a name holding a NUL byte";
        }
        #name = $name;
    }

    /**
     * The name in double quotes, a `"` in it doubled
     */
    pub fn quoted(): string {
        return '"' .. replace(#name, '"', '""') .. '"';
    }

    /**
     * The name as the SQL shows it, quoted()
     */
    pub fn to_string(): string {
        return #quoted();
    }
}

/**
 * The tag: `db::sql"select * from users where id = {$id}"` is SQL whose values are sent apart from
 * it, so nothing in them is ever read as SQL. A value may be:
 *
 * - an int, float, string, bool or null: one parameter;
 * - a list of those: `(?, ?, ?)`, for `where id in {$ids}`; an empty list is an error, since
 *   `in ()` isn't SQL and what no items should mean (nothing, or everything) is the program's to say;
 * - another `db::sql"..."`: spliced in, its values numbered along with the rest, so a condition can
 *   be built apart and added or left out;
 * - `db::ident($name)`: a table or column name, quoted.
 *
 * The text can't hold `$1` or `?1`: that is how PostgreSQL and SQLite number parameters, so it
 * would be read as whichever value has that number. Nor can it hold what looks like a call in
 * braces, `{db::ident($c)}`, which is text, since only `{$`, `{@`, `{#` and a constant's
 * `{NAME}` start an interpolation. Interpolate a variable instead; `db::raw()` is the way round a
 * false alarm, such as `$1` inside an SQL string literal or a `$$...$$` function body.
 */
pub fn sql(list $strings, list $values): Sql {
    foreach ($strings as $text) {
        check_text($text);
    }
    return Sql($strings, $values);
}

/**
 * SQL built some other way, used as it is, with no values: a migration read from a file, or a
 * statement put together by code that is trusted to do so. Every use is a place to check by hand.
 */
pub fn raw(string $text): Sql {
    return Sql([$text], []);
}

/**
 * A table or column name for a `db::sql"..."`, written quoted (see `Ident`)
 */
pub fn ident(string $name): Ident {
    return Ident($name);
}

/*
 * What the tag refuses in its text: a numbered placeholder, which the database would bind to
 * whichever value has that number, and a call written where only a variable or a constant is
 * interpolated.
 */
fn check_text($text) {
    foreach (NUMBERED_PLACEHOLDERS as $mark) {
        check_no_numbered_placeholder($text, $mark);
    }
    check_no_call($text);
}

fn check_no_numbered_placeholder($text, $mark) {
    foreach (positions($text, $mark) as $at) {
        $next = char_at($text, $at + 1);
        if (is_digit($next)) {
            throw "db::sql text can't hold " .. $mark .. $next .. ": interpolate the value instead";
        }
    }
}

/*
 * `{db::ident($c)}` in the text is text: only `{$`, `{@`, `{#` and a constant's name alone,
 * `{NAME}`, start an interpolation
 */
fn check_no_call($text) {
    foreach (positions($text, "{") as $at) {
        $call = call_at($text, $at + 1);
        if ($call != null) {
            throw "db::sql text holds {" .. $call .. '}: only a variable or a constant is interpolated, so write $value = ' .. $call .. ' first, then {$value}';
        }
    }
}

/*
 * What looks like a call written at $start, shown as `db::ident(...)` or `upper(...)`: a name,
 * qualified or not, followed by `(`. Null for anything else, so `'{1,2}'`, `'{a,b}'` and
 * `'{"k": 1}'` stay text.
 */
fn call_at($text, $start) {
    $at = $start;
    while (is_name_start(char_at($text, $at))) {
        $at += span($text, $at, is_name_char);
        if (!starts_with($text, "::", $at)) {
            break;
        }
        $at += 2;
    }
    if ($at > $start && char_at($text, $at) == "(") {
        return slice($text, $start, $at - $start) .. "(...)";
    }
    return null;
}

fn is_name_start($c) {
    return is_alpha($c) || $c == "_";
}

fn is_name_char($c) {
    return is_alnum($c) || $c == "_";
}

// Where $needle starts in $text, each time, left to right
fn positions($text, $needle) {
    $found = [];
    $at = index_of($text, $needle);
    while ($at != null) {
        $found[] = $at;
        if ($at + 1 >= len($text)) {
            break;
        }
        $at = index_of($text, $needle, $at + 1);
    }
    return $found;
}

fn check_value($value) {
    if (is_a($value, Sql) || is_a($value, Ident) || in_array(type_of($value), SCALARS)) {
        return;
    }
    if (type_of($value) != "list") {
        throw "db::sql can't send " .. described($value) .. ': a value is an int, float, string, bool or null, a list of those, a db::sql"..." or a db::ident()';
    }
    if (len($value) == 0) {
        throw "db::sql can't put an empty list in (...): decide what no items means";
    }
    foreach ($value as $item) {
        if (!in_array(type_of($item), SCALARS)) {
            throw "db::sql can't put " .. described($item) .. " in a list: an in (...) list holds ints, floats, strings, bools and nulls";
        }
    }
}

// A value's type for a message: "a string", "an int", "null", "a Point"
fn described($value) {
    $type = type_of($value);
    if ($type == "object") {
        $type = kind_name($value);
    }
    if ($type == "null") {
        return "null";
    }
    if ($type == "int") {
        return "an int";
    }
    return "a " .. $type;
}
