// Helpers for lists, in GazLang rather than as builtins, so they take no name from any program
// that doesn't include this file
namespace lists;

// The elements of a list of lists, in order, one level deep: [[1, 2], [], [3]] is [1, 2, 3]
pub fn flatten($lists) {
    if (type_of($lists) != "list") {
        error("lists::flatten() expects a list of lists, got " .. type_of($lists));
    }
    $all = [];
    foreach ($lists as $list) {
        if (type_of($list) != "list") {
            error("lists::flatten() expects a list of lists, got " .. type_of($list) .. " among them");
        }
        foreach ($list as $element) {
            $all[] = $element;
        }
    }
    return $all;
}

// The element whose key is largest, the first of them on a tie: $key($x) is called once for
// each element and the keys compared with <=>, so a list of keys breaks ties in order
pub fn max_by($xs, $key) {
    return extreme($xs, $key, 1, "max_by");
}

// The element whose key is smallest, the first of them on a tie
pub fn min_by($xs, $key) {
    return extreme($xs, $key, -1, "min_by");
}

fn extreme($xs, $key, $sign, $name) {
    if (type_of($xs) != "list") {
        error("lists::{$name}() expects a non-empty list, got " .. type_of($xs));
    }
    if ($xs == []) {
        error("lists::{$name}() expects a non-empty list");
    }
    [$best, $best_key] = [$xs[0], $key($xs[0])];
    foreach (slice($xs, 1) as $x) {
        $k = $key($x);
        if (($k <=> $best_key) == $sign) {
            [$best, $best_key] = [$x, $k];
        }
    }
    return $best;
}
