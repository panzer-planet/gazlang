/*
 * Widgets for a full-screen terminal program, on lib/term.gaz.
 *
 * Nothing draws to the terminal directly. Everything draws into a Screen, a grid of cells, and
 * $screen.render() gives the escape sequences that change what the terminal shows into what the
 * grid holds, and only that: a row that hasn't changed costs one comparison, and one that has
 * is redrawn from its first changed cell to its last. So a program clears and redraws its whole
 * interface every frame without flicker, and a test draws into a Screen and reads $screen.lines()
 * without a terminal.
 *
 *     $screen = tui::Screen(80, 24);
 *     tui::box($screen, 1, 1, 30, 5, "Title");
 *     tui::label($screen, 3, 3, 26, "hello", "bold");
 *     print($screen.render());
 *
 * Interactive widgets (Menu, TextField) take keys from term::Input and draw themselves; choose()
 * and ask() are each one of them run as a screen of its own.
 */
namespace tui;

include "term.gaz";

/* Corners top left, top right, bottom left, bottom right, then across and down */
const BORDERS = {
    "single" => ["┌", "┐", "└", "┘", "─", "│"],
    "double" => ["╔", "╗", "╚", "╝", "═", "║"],
    "round" => ["╭", "╮", "╰", "╯", "─", "│"],
    "heavy" => ["┏", "┓", "┗", "┛", "━", "┃"],
    "ascii" => ["+", "+", "+", "+", "-", "|"],
};

/*
 * The screen as a grid of cells, each [character, style], columns and rows counted from 1.
 * Drawing outside it is clipped, so a widget that doesn't fit is cut off, not an error.
 */
pub kind Screen {
    #cells = [];
    #blank = [];
    #shown = null;
    #caret = null;

    fn _(pub #cols, pub #rows) {
        #reset();
    }

    /* Every cell blank and nothing known about what the terminal shows */
    fn reset() {
        #blank = [];
        for ($c = 0; $c < #cols; $c++) {
            #blank[] = [" ", ""];
        }
        #cells = [];
        for ($r = 0; $r < #rows; $r++) {
            #cells[] = #blank;
        }
        #shown = null;
        #caret = null;
    }

    /* Blank every cell */
    pub fn clear() {
        #cells = [];
        for ($r = 0; $r < #rows; $r++) {
            #cells[] = #blank;
        }
        #caret = null;
    }

    /* The size to be $cols by $rows: blank, and the terminal to be drawn again in full */
    pub fn resize($cols, $rows) {
        #cols = $cols;
        #rows = $rows;
        #reset();
    }

    /*
     * Take the terminal's size (term_size(), which is polled: nothing tells a program the window
     * changed). True when it was different, and the screen is blank and to be drawn in full.
     */
    pub fn fit() {
        $size = term_size();
        if ($size["cols"] == #cols && $size["rows"] == #rows) {
            return false;
        }
        #resize($size["cols"], $size["rows"]);
        return true;
    }

    /* Forget what the terminal shows, so the next render draws everything (after something else drew) */
    pub fn invalidate() {
        #shown = null;
    }

    /*
     * $text from column $col of row $row in $style (a term::style() spec, "" for none). One
     * character to a cell; ponytail: a wide character (CJK, emoji) takes two columns but one cell,
     * which shifts what follows it on the row, and a control character is drawn as it is.
     */
    pub fn put($col, $row, $text, $style = "") {
        if ($row < 1 || $row > #rows) {
            return null;
        }
        $at = $col;
        foreach (term::chars($text) as $char) {
            if ($at >= 1 && $at <= #cols) {
                #cells[$row - 1][$at - 1] = [$char, $style];
            }
            $at++;
        }
    }

    /* A $width by $height rectangle of $char in $style */
    pub fn fill($col, $row, $width, $height, $char = " ", $style = "") {
        $line = repeat($char, max($width, 0));
        for ($i = 0; $i < $height; $i++) {
            #put($col, $row + $i, $line, $style);
        }
    }

    /* Where the terminal's cursor goes after a render (a text field's), or none */
    pub fn cursor($col, $row) {
        #caret = [$col, $row];
    }

    /* The whole screen as a Rect, for a view to cut up */
    pub fn bounds() {
        return Rect(1, 1, #cols, #rows);
    }

    /* Each row as plain text, for a test to read */
    pub fn lines() {
        $lines = [];
        foreach (#cells as $row) {
            $line = "";
            foreach ($row as $cell) {
                $line ..= $cell[0];
            }
            $lines[] = $line;
        }
        return $lines;
    }

    /* What a cell is, as [character, style] */
    pub fn cell($col, $row) {
        return #cells[$row - 1][$col - 1];
    }

    /*
     * The escape sequences that make the terminal show this screen. The first render clears the
     * terminal and draws what isn't blank; after that only what has changed since the last one.
     */
    pub fn render() {
        $full = #shown == null;
        $out = $full ? term::RESET .. term::clear() : "";
        for ($r = 0; $r < #rows; $r++) {
            $row = #cells[$r];
            if ($full ? $row == #blank : $row == #shown[$r]) {
                continue;
            }
            $first = 0;
            $last = #cols - 1;
            if ($full) {
                /* the clear made the blanks at either end so already */
                while ($row[$first] == [" ", ""]) {
                    $first++;
                }
                while ($row[$last] == [" ", ""]) {
                    $last--;
                }
            } else {
                while ($row[$first] == #shown[$r][$first]) {
                    $first++;
                }
                while ($row[$last] == #shown[$r][$last]) {
                    $last--;
                }
            }
            $out ..= term::move_to($first + 1, $r + 1);
            $style = "";
            for ($c = $first; $c <= $last; $c++) {
                $cell = $row[$c];
                if ($cell[1] != $style) {
                    if ($style != "") {
                        $out ..= term::RESET;
                    }
                    $style = $cell[1];
                    if ($style != "") {
                        $out ..= term::start($style);
                    }
                }
                $out ..= $cell[0];
            }
            if ($style != "") {
                $out ..= term::RESET;
            }
        }
        #shown = #cells;
        if (#caret == null) {
            return $out .. term::hide_cursor();
        }
        return $out .. term::move_to(#caret[0], #caret[1]) .. term::show_cursor();
    }
}

/*
 * A rectangle of the screen: where it starts (columns and rows count from 1) and how big. A view
 * is given one to draw in and cuts it up with the split_ methods for its parts, so it does no
 * column arithmetic of its own, and a part that doesn't fit is smaller, never negative.
 */
pub kind Rect {
    fn _(pub #col, pub #row, pub #width, pub #height);

    /* Shrunk by $n on every side, to nothing at the least */
    pub fn inset($n = 1) {
        return Rect(#col + $n, #row + $n, max(#width - 2 * $n, 0), max(#height - 2 * $n, 0));
    }

    /* [the first $width columns, the rest] */
    pub fn split_left($width) {
        $left = min(max($width, 0), #width);
        return [Rect(#col, #row, $left, #height), Rect(#col + $left, #row, #width - $left, #height)];
    }

    /* [the rest, the last $width columns] */
    pub fn split_right($width) {
        $right = min(max($width, 0), #width);
        return [Rect(#col, #row, #width - $right, #height), Rect(#col + #width - $right, #row, $right, #height)];
    }

    /* [the first $height rows, the rest] */
    pub fn split_top($height) {
        $top = min(max($height, 0), #height);
        return [Rect(#col, #row, #width, $top), Rect(#col, #row + $top, #width, #height - $top)];
    }

    /* [the rest, the last $height rows] */
    pub fn split_bottom($height) {
        $bottom = min(max($height, 0), #height);
        return [Rect(#col, #row, #width, #height - $bottom), Rect(#col, #row + #height - $bottom, #width, $bottom)];
    }
}

/* ---- Drawing ----------------------------------------------------------------------------- */

/*
 * $text in a field $width wide, cut off if longer and padded if shorter, $align "left", "center"
 * or "right"
 */
pub fn label($screen, $col, $row, $width, $text, $style = "", $align = "left") {
    if ($width <= 0) {
        return null;
    }
    $chars = slice(term::chars($text), 0, $width);
    $gap = $width - len($chars);
    $before = match ($align) {
        "left" => 0,
        "center" => intdiv($gap, 2),
        "right" => $gap,
    };
    $screen.put($col, $row, repeat(" ", $before) .. join($chars, "") .. repeat(" ", $gap - $before), $style);
}

/*
 * A box $width by $height with its top left at $col, $row, its inside blank, and $title in the
 * top edge. $border is single, double, round, heavy or ascii.
 */
pub fn box($screen, $col, $row, $width, $height, $title = "", $style = "", $border = "single") {
    if (!has_key(BORDERS, $border)) {
        error("tui::box: unknown border \"" .. $border .. "\"");
    }
    if ($width < 2 || $height < 2) {
        return null;
    }
    [$top_left, $top_right, $bottom_left, $bottom_right, $across, $down] = BORDERS[$border];
    $top = repeat($across, $width - 2);
    if ($title != "" && $width >= 5) {
        $words = slice(term::chars(" " .. $title .. " "), 0, $width - 3);
        $top = $across .. join($words, "") .. repeat($across, $width - 3 - len($words));
    }
    $screen.put($col, $row, $top_left .. $top .. $top_right, $style);
    for ($i = 1; $i < $height - 1; $i++) {
        $screen.put($col, $row + $i, $down .. repeat(" ", $width - 2) .. $down, $style);
    }
    $screen.put($col, $row + $height - 1, $bottom_left .. repeat($across, $width - 2) .. $bottom_right, $style);
}

/*
 * A bar $width wide, $fraction (0 to 1) of it filled, and the percentage at its end
 */
pub fn progress($screen, $col, $row, $width, $fraction, $style = "green") {
    $bar = $width - 5;
    if ($bar < 1) {
        return null;
    }
    $fraction = max(0, min(1, $fraction));
    $filled = to_int(round($fraction * $bar));
    $screen.put($col, $row, repeat("█", $filled), $style);
    $screen.put($col + $filled, $row, repeat("░", $bar - $filled), "dim");
    label($screen, $col + $bar, $row, 5, to_int(round($fraction * 100)) .. "%", "", "right");
}

/* $text in a field $width wide, numbers on the right */
fn cell_text($value, $width) {
    $text = to_string($value);
    $gap = max($width - term::width($text), 0);
    $number = type_of($value) == "int" || type_of($value) == "float";
    return $number ? repeat(" ", $gap) .. $text : $text .. repeat(" ", $gap);
}

/* $cells with "" added to make $count of them */
fn padded($cells, $count) {
    while (len($cells) < $count) {
        $cells[] = "";
    }
    return $cells;
}

/*
 * A table: $headers a list of names, $rows a list of lists, columns as wide as their widest
 * cell and numbers aligned on the right; a header or a row shorter than the rest is blank where it
 * stops. Gives how many rows it took (two more than $rows).
 */
pub fn table($screen, $col, $row, $headers, $rows, $style = "") {
    /* as many columns as the longest of them, a short row or header being blank in the rest */
    $columns = len($headers);
    foreach ($rows as $cells) {
        $columns = max($columns, len($cells));
    }
    $headers = padded($headers, $columns);
    foreach ($rows as $n => $cells) {
        $rows[$n] = padded($cells, $columns);
    }
    $widths = map($headers, $h -> term::width(to_string($h)));
    foreach ($rows as $cells) {
        foreach ($cells as $i => $cell) {
            $widths[$i] = max($widths[$i], term::width(to_string($cell)));
        }
    }
    $rule = join(map($widths, $w -> repeat("─", $w)), "─┼─");
    $line = [];
    foreach ($headers as $i => $header) {
        $line[] = cell_text($header, $widths[$i]);
    }
    $screen.put($col, $row, join($line, " │ "), "bold");
    $screen.put($col, $row + 1, $rule, "dim");
    foreach ($rows as $n => $cells) {
        $line = [];
        foreach ($cells as $i => $cell) {
            $line[] = cell_text($cell, $widths[$i]);
        }
        $screen.put($col, $row + 2 + $n, join($line, " │ "), $style);
    }
    return len($rows) + 2;
}

/* ---- Widgets that take keys -------------------------------------------------------------- */

/* $text cut to $width characters and padded to it, on the left when $right */
fn fitted($text, $width, $right) {
    $chars = slice(term::chars($text), 0, $width);
    $gap = $width - len($chars);
    return $right ? repeat(" ", $gap) .. join($chars, "") : join($chars, "") .. repeat(" ", $gap);
}

/*
 * A table you move about in: a header, rows that scroll, a selected row, and columns that sort.
 * $headers are the column names and $rows a list of lists of cells; a column whose cells are all
 * numbers is aligned on the right. $style_of($row, $index), if given, says what style a row is
 * drawn in ($index is where it is in $rows, however they are sorted now), so a table can mark
 * the user's own club. Cells in a column must be alike, or sorting on it is an error.
 *
 * handle() gives "select" for enter and null for anything else. Keys: the arrows or j and k, home
 * and end or g and G, page up and down; "." and "," (or > and <) sort by the next or previous
 * column, "o" turns the order round and "x" goes back to the order the rows came in.
 */
pub kind Table {
    #headers;
    #rows = [];
    #style_of;
    #numeric = [];
    /* Indexes into #rows in the order shown, and where in that order the selection is */
    #order = [];
    #cursor = 0;
    #top = 0;
    #page = 10;
    #column = null;
    #descending = false;

    fn _($headers, $rows, $style_of = null) {
        #headers = $headers;
        #style_of = $style_of;
        #rows = $rows;
        #analyse();
        #reorder(null);
    }

    /* Which columns are all numbers */
    fn analyse() {
        #numeric = [];
        foreach (#headers as $i => $header) {
            $all = len(#rows) > 0;
            foreach (#rows as $row) {
                $type = type_of($row[$i]);
                $all = $all && ($type == "int" || $type == "float");
            }
            #numeric[] = $all;
        }
    }

    /* Put #order right for the rows and the sort, keeping the row at index $keep selected */
    fn reorder($keep) {
        #order = [];
        for ($i = 0; $i < len(#rows); $i++) {
            #order[] = $i;
        }
        if (#column != null) {
            $rows = #rows;
            $column = #column;
            #order = #descending
                ? sort(#order, ($a, $b) -> $rows[$b][$column] <=> $rows[$a][$column])
                : sort(#order, ($a, $b) -> $rows[$a][$column] <=> $rows[$b][$column]);
        }
        if ($keep != null) {
            foreach (#order as $position => $index) {
                if ($index == $keep) {
                    #cursor = $position;
                }
            }
        }
        #cursor = max(min(#cursor, len(#order) - 1), 0);
    }

    /* Which of the rows is selected, as its index in the rows given, or null when there are none */
    pub fn selected_index() {
        return len(#order) == 0 ? null : #order[#cursor];
    }

    pub fn selected_row() {
        $index = #selected_index();
        return $index == null ? null : #rows[$index];
    }

    /* Show other rows, keeping the selection on the same index where there still is one */
    pub fn set_rows($rows) {
        $keep = #selected_index();
        #rows = $rows;
        #analyse();
        #reorder($keep != null && $keep < len($rows) ? $keep : null);
    }

    /* Sort on column $column (from 0), the least first unless $descending */
    pub fn sort_by($column, $descending = false) {
        if ($column < 0 || $column >= len(#headers)) {
            error("tui::Table has no column {$column}");
        }
        $keep = #selected_index();
        #column = $column;
        #descending = $descending;
        #reorder($keep);
    }

    /* [column, descending] it is sorted by, or null */
    pub fn sorted_by() {
        return #column == null ? null : [#column, #descending];
    }

    pub fn handle($key) {
        $last = max(len(#order) - 1, 0);
        match (term::name($key)) {
            "up", "k" => { #cursor = max(#cursor - 1, 0); }
            "down", "j" => { #cursor = min(#cursor + 1, $last); }
            "home", "g" => { #cursor = 0; }
            "end", "G" => { #cursor = $last; }
            "page_up" => { #cursor = max(#cursor - #page, 0); }
            "page_down" => { #cursor = min(#cursor + #page, $last); }
            ".", ">" => { #sort_by(#column == null ? 0 : min(#column + 1, len(#headers) - 1), #descending); }
            ",", "<" => { #sort_by(#column == null ? 0 : max(#column - 1, 0), #descending); }
            "o" => {
                if (#column != null) {
                    #sort_by(#column, !#descending);
                }
            }
            "x" => {
                $keep = #selected_index();
                #column = null;
                #descending = false;
                #reorder($keep);
            }
            "enter" => {
                if (len(#order) > 0) {
                    return "select";
                }
            }
            default => {}
        }
        return null;
    }

    /* The width of each column: what its widest cell needs, less where the rest is too wide for $available */
    fn widths($available) {
        $widths = [];
        foreach (#headers as $i => $header) {
            /* one more than the header, for the mark of the column sorted on */
            $width = term::width(to_string($header)) + 1;
            foreach (#rows as $row) {
                $width = max($width, term::width(to_string($row[$i])));
            }
            $widths[] = $width;
        }
        $total = sum($widths) + 2 * max(len($widths) - 1, 0);
        while ($total > $available) {
            $widest = 0;
            foreach ($widths as $i => $width) {
                if ($width > $widths[$widest]) {
                    $widest = $i;
                }
            }
            if ($widths[$widest] <= 3) {
                break;
            }
            $widths[$widest]--;
            $total--;
        }
        return $widths;
    }

    /* Draw it in $rect, the selection showing as such only when $focused */
    pub fn draw($screen, $rect, $focused = true) {
        if ($rect.width < 1 || $rect.height < 1) {
            return null;
        }
        $widths = #widths($rect.width);
        $visible = $rect.height - 1;
        #page = max($visible - 1, 1);
        if (#cursor < #top) {
            #top = #cursor;
        }
        if (#cursor >= #top + $visible) {
            #top = #cursor - $visible + 1;
        }

        $at = $rect.col;
        foreach (#headers as $i => $header) {
            $mark = #column == $i ? (#descending ? "▼" : "▲") : "";
            $text = fitted(to_string($header) .. $mark, $widths[$i], #numeric[$i]);
            label($screen, $at, $rect.row, $widths[$i], $text, #column == $i ? "bold underline" : "bold");
            $at += $widths[$i] + 2;
        }

        $style_of = #style_of;
        for ($line = 0; $line < $visible && #top + $line < len(#order); $line++) {
            $position = #top + $line;
            $index = #order[$position];
            $row = #rows[$index];
            $cells = [];
            foreach ($row as $i => $cell) {
                $cells[] = fitted(to_string($cell), $widths[$i], #numeric[$i]);
            }
            $style = $style_of == null ? "" : $style_of($row, $index);
            if ($position == #cursor) {
                $style = trim($style .. ($focused ? " inverse" : " bold"));
            }
            label($screen, $rect.col, $rect.row + 1 + $line, $rect.width, join($cells, "  "), $style);
        }
    }
}

/*
 * A list to choose from, in a box. handle() takes a key, and gives "select" for enter,
 * "cancel" for escape, q or ctrl+c, and null for anything else, which it has dealt with itself
 * (the arrows, j and k, home and end, page up and down).
 */
pub kind Menu {
    #items;
    #title;
    #selected = 0;
    #top = 0;
    #page = 10;

    fn _($items, $title = "") {
        #items = $items;
        #title = $title;
    }

    /* Which item is selected, as an index, and as the item */
    pub fn index() { return #selected; }
    pub fn item() { return #items[#selected]; }

    pub fn handle($key) {
        /* an empty menu has nothing to move to, and nothing to select */
        $last = max(len(#items) - 1, 0);
        match (term::name($key)) {
            "up", "k" => { #selected = max(#selected - 1, 0); }
            "down", "j" => { #selected = min(#selected + 1, $last); }
            "home", "g" => { #selected = 0; }
            "end", "G" => { #selected = $last; }
            "page_up" => { #selected = max(#selected - #page, 0); }
            "page_down" => { #selected = min(#selected + #page, $last); }
            "enter" => {
                if (len(#items) > 0) {
                    return "select";
                }
            }
            "escape", "q", "ctrl+c", "eof" => { return "cancel"; }
            default => {}
        }
        return null;
    }

    /* Draw it in a box $width by $height, scrolled so the selected item shows */
    pub fn draw($screen, $col, $row, $width, $height) {
        box($screen, $col, $row, $width, $height, #title);
        $visible = $height - 2;
        #page = max($visible - 1, 1);
        if (#selected < #top) {
            #top = #selected;
        }
        if (#selected >= #top + $visible) {
            #top = #selected - $visible + 1;
        }
        for ($i = 0; $i < $visible && #top + $i < len(#items); $i++) {
            $on = #top + $i == #selected;
            label($screen, $col + 1, $row + 1 + $i, $width - 2, ($on ? "> " : "  ") .. #items[#top + $i], $on ? "inverse" : "");
        }
    }
}

/*
 * A line of text being edited. handle() takes a key and gives "submit" for enter, "cancel" for
 * escape or ctrl+c, and null otherwise: typing inserts, and backspace, delete, the arrows,
 * home and end (or ctrl+a and ctrl+e), ctrl+u (delete to the start) and ctrl+k (to the end) edit.
 */
pub kind TextField {
    #chars;
    #at;
    #left = 0;

    fn _($value = "") {
        #chars = term::chars($value);
        #at = len(#chars);
    }

    pub fn value() { return join(#chars, ""); }

    pub fn handle($key) {
        $typed = term::text($key);
        if ($typed != null) {
            #chars = [...slice(#chars, 0, #at), $typed, ...slice(#chars, #at)];
            #at++;
            return null;
        }
        match (term::name($key)) {
            "backspace" => {
                if (#at > 0) {
                    #chars = [...slice(#chars, 0, #at - 1), ...slice(#chars, #at)];
                    #at--;
                }
            }
            "delete" => { #chars = [...slice(#chars, 0, #at), ...slice(#chars, #at + 1)]; }
            "left" => { #at = max(#at - 1, 0); }
            "right" => { #at = min(#at + 1, len(#chars)); }
            "home", "ctrl+a" => { #at = 0; }
            "end", "ctrl+e" => { #at = len(#chars); }
            "ctrl+u" => {
                #chars = slice(#chars, #at);
                #at = 0;
            }
            "ctrl+k" => { #chars = slice(#chars, 0, #at); }
            "enter" => { return "submit"; }
            "escape", "ctrl+c", "eof" => { return "cancel"; }
            default => {}
        }
        return null;
    }

    /* Draw it $width wide, scrolled sideways to keep the cursor in view, and put the cursor there */
    pub fn draw($screen, $col, $row, $width, $style = "underline") {
        if ($width <= 0) {
            return null;
        }
        /* not scrolled further than the text needs, or deleting leaves it off the left edge */
        #left = min(#left, max(len(#chars) - $width + 1, 0));
        if (#at < #left) {
            #left = #at;
        }
        if (#at > #left + $width - 1) {
            #left = #at - $width + 1;
        }
        label($screen, $col, $row, $width, join(slice(#chars, #left, $width), ""), $style);
        $screen.cursor($col + #at - #left, $row);
    }
}

/* ---- Whole screens ----------------------------------------------------------------------- */

/*
 * A steady beat: when the next one is due, given the time now (seconds from monotonic_time(); it
 * is passed in, so it can be tested with times made up). A beat that comes late doesn't make up
 * for it with two: the next is an interval from when it came.
 */
pub kind Metronome {
    #next;

    fn _(#interval, $now) {
        #next = $now + #interval;
    }

    /* Whether a beat is due */
    pub fn due($now) { return $now >= #next; }

    /* Seconds until the next beat, or 0 when it is due */
    pub fn wait($now) { return max(#next - $now, 0); }

    /* A beat has been taken at $now */
    pub fn beat($now) {
        #next += #interval;
        if (#next <= $now) {
            #next = $now + #interval;
        }
    }
}

/*
 * Run $draw($screen) and $handle($key) on a screen of its own until $handle gives something
 * other than null, which is what this gives; input that ends gives null. Keys come from $input
 * (a term::Input), or from a new one. A program that shows one screen after another passes the
 * same one to each: keys that arrived together (typed ahead) are in it, and would be lost with a
 * new Input made for each screen.
 *
 * With $tick, time passes too: when no key has been pressed for $interval seconds, $tick() is
 * called and the screen drawn again, so a screen can move by itself (a clock, a match being
 * played). It ends the screen as $handle does, by giving something other than null.
 * The beat is steady: a key held down (auto-repeat) doesn't hold it up, since each wait is until the
 * next beat is due, kept by monotonic_time() in a Metronome, and not a full $interval from the key.
 */
pub fn interact($draw, $handle, $input = null, $tick = null, $interval = 0.25) {
    $input ??= term::Input();
    $metronome = $tick == null ? null : Metronome($interval, monotonic_time());
    return term::fullscreen(() -> {
        $size = term_size();
        $screen = Screen($size["cols"], $size["rows"]);
        while (true) {
            $screen.fit();
            $screen.clear();
            $draw($screen);
            print($screen.render());
            if ($metronome == null) {
                $key = $input.read();
            } else {
                $now = monotonic_time();
                $key = $metronome.due($now) ? null : $input.read($metronome.wait($now));
            }
            if ($key == null) {
                // the beat is due: time passes, whether or not keys have been coming
                $result = $tick();
                if ($result != null) {
                    return $result;
                }
                $metronome.beat(monotonic_time());
                continue;
            }
            if ($key["key"] == "eof") {
                return null;
            }
            $result = $handle($key);
            if ($result != null) {
                return $result;
            }
        }
    });
}

/* A box of $width by $height in the middle of $screen, as [col, row] of its top left */
pub fn centered($screen, $width, $height) {
    return [max(intdiv($screen.cols - $width, 2), 0) + 1, max(intdiv($screen.rows - $height, 2), 0) + 1];
}

/*
 * Choose one of $items in a menu of a screen of its own: its index, or null if cancelled or
 * there is nothing to choose. $input is interact()'s. Needs a terminal.
 */
pub fn choose($items, $title = "", $input = null) {
    if (len($items) == 0) {
        return null;
    }
    $menu = Menu($items, $title);
    $picked = interact(
        $screen -> {
            $width = min($screen.cols, max(term::width($title) + 6, 4 + reduce($items, ($most, $item) -> max($most, term::width(to_string($item))), 0)));
            $height = min($screen.rows, len($items) + 2);
            [$col, $row] = centered($screen, $width, $height);
            $menu.draw($screen, $col, $row, $width, $height);
        },
        $key -> $menu.handle($key),
        $input
    );
    return $picked == "select" ? $menu.index() : null;
}

/*
 * Ask a question on a screen of its own and give the answer, or null if cancelled. $initial is
 * what the field starts with. $input is interact()'s. Needs a terminal.
 */
pub fn ask($question, $initial = "", $input = null) {
    $field = TextField($initial);
    $answered = interact(
        $screen -> {
            $width = min($screen.cols, max(term::width($question) + 4, 40));
            [$col, $row] = centered($screen, $width, 4);
            box($screen, $col, $row, $width, 4, $question);
            $field.draw($screen, $col + 2, $row + 2, $width - 4);
        },
        $key -> $field.handle($key),
        $input
    );
    return $answered == "submit" ? $field.value() : null;
}
