/**
 * Widgets for a full-screen terminal program, on lib/term.gaz.
 *
 * Nothing draws to the terminal directly. Everything draws into a Screen, a grid of cells, and
 * $screen.render() gives the escape sequences that change what the terminal shows into what the
 * grid holds, and only that: a row that hasn't changed costs one comparison, and one that has
 * is redrawn from its first changed cell to its last. So a program clears and redraws its whole
 * interface every frame without flicker, and a test draws into a Screen and reads $screen.lines()
 * without a terminal.
 *
 *     $screen = tui::Screen(80, 24);
 *     $panel = tui::Rect(1, 1, 30, 5);
 *     tui::box($screen, $panel, "Title");
 *     tui::label($screen, $panel.inset(2), "hello", "bold");
 *     print($screen.render());
 *
 * Everything that draws takes a Rect, a part of the screen, and a view cuts the one it is given
 * into parts with the split_ methods, so only Screen.put() and Screen.cursor() speak in columns.
 * Interactive widgets (List, Table, Menu, TextField) take keys from term::Input, answer with an Outcome
 * or null, and draw themselves; choose() and ask() are each one of them run as a screen of its
 * own. A View is what a full-screen program's shell asks of each section it shows. Screen.put()
 * clips only to the screen; a Pane (screen.pane($rect)) is a part of it that nothing drawn into
 * it leaves, which every drawing function takes as it would a Screen.
 */
namespace tui;

import "std/term.gaz";
import "std/text.gaz" use quote;

/* Corners top left, top right, bottom left, bottom right, then across and down */
const BORDERS = {
    "single" => ["┌", "┐", "└", "┘", "─", "│"],
    "double" => ["╔", "╗", "╚", "╝", "═", "║"],
    "round" => ["╭", "╮", "╰", "╯", "─", "│"],
    "heavy" => ["┏", "┓", "┗", "┛", "━", "┃"],
    "ascii" => ["+", "+", "+", "+", "-", "|"],
};

// A wide character's columns, and a continuation's: the cell after a wide character, which holds nothing
const WIDE = 2;
const CONTINUATION = 0;

/**
 * One cell of a Screen: a character (a base character with any combining marks joined to it, as
 * one string), the columns it takes, and its term::Style. A character is 1 column wide, or 2 for
 * a wide one (CJK, an emoji), which takes two cells: its own, and after it a continuation, a Cell
 * of width 0 holding "" that render() and lines() pass over, so a reader tells it from a blank by
 * its width. A Cell is a value: two with the same character, width and style are ==, which the
 * Screen's diff relies on.
 */
pub readonly kind Cell {
    static #shared_blank = null;

    /**
     * The cell showing $character in $style, $width columns wide
     */
    fn _(pub #character, pub #width, pub term::Style #style);

    /**
     * The blank cell, a space in no style: one shared value, which every blank cell is
     */
    pub static fn blank() {
        #shared_blank ??= Cell(" ", 1, term::Style::of(""));
        return #shared_blank;
    }

    /**
     * Whether it is the second cell of a wide character, which holds nothing of its own
     */
    pub fn is_continuation() {
        return #width == CONTINUATION;
    }

    /**
     * Whether it is a wide character, which takes this cell and the next
     */
    pub fn is_wide() {
        return #width == WIDE;
    }
}

/* Where the terminal's cursor is put after a render, columns and rows from 1 */
kind Caret {
    fn _(pub #col, pub #row);
}

/**
 * The screen as a grid of Cells, columns and rows counted from 1. Drawing outside it is clipped,
 * so a widget that doesn't fit is cut off, not an error. Text is placed by columns, as the
 * terminal draws it: a wide character (CJK, an emoji) takes two cells, a combining mark joins the
 * character before it in one, and a control character is refused (see put()).
 */
pub kind Screen {
    #cells = [];
    #blank = [];
    #whole = null;
    #shown = null;
    #caret = null;

    /**
     * A blank screen $cols wide and $rows high, of which the terminal is known to show nothing yet
     */
    fn _(pub #cols, pub #rows) {
        #reset();
    }

    /* Every cell blank and nothing known about what the terminal shows */
    fn reset() {
        #whole = Rect(1, 1, #cols, #rows);
        #blank = [];
        for ($c = 0; $c < #cols; $c++) {
            #blank[] = Cell::blank();
        }
        #cells = [];
        for ($r = 0; $r < #rows; $r++) {
            #cells[] = #blank;
        }
        #shown = null;
        #caret = null;
    }

    /**
     * Blank every cell and forget the cursor, for the next frame to be drawn on: what the
     * terminal shows is kept, so render() still sends only what changed
     */
    pub fn clear() {
        #cells = [];
        for ($r = 0; $r < #rows; $r++) {
            #cells[] = #blank;
        }
        #caret = null;
    }

    /**
     * Become $cols by $rows, blank and with nothing known about the terminal, so the next render
     * draws everything: for a size a program chooses (fit() is for the terminal's)
     */
    pub fn resize($cols, $rows) {
        #cols = $cols;
        #rows = $rows;
        #reset();
    }

    /**
     * Resize to the terminal's size (term_size()), only if that differs from the screen's. True
     * when it did, and the screen is then blank and to be drawn in full. interact() calls it on every pass, and term::Input.read()
     * gives the key "resize" when the window changes, so a program on it needs nothing more.
     */
    pub fn fit() {
        $size = term_size();
        if ($size["cols"] == #cols && $size["rows"] == #rows) {
            return false;
        }
        #resize($size["cols"], $size["rows"]);
        return true;
    }

    /**
     * Keep every cell but forget what the terminal shows, so the next render draws them all:
     * after something else drew on the terminal (clear() is the cells, this is the terminal)
     */
    pub fn invalidate() {
        #shown = null;
    }

    /**
     * $text from column $col of row $row in $style (a term::style() spec or a term::Style, "" for
     * none), placed by columns as the terminal draws it (utf8_width()): a character takes a cell,
     * a wide one (CJK, an emoji) two, and a combining mark joins the character before it in its
     * cell (one with nothing before it in the text is drawn over a space, so a put never reaches
     * back before $col). What falls outside the screen is clipped, a wide character as a whole:
     * one with a column on the screen and a column off it is a blank in the one on it, never
     * half a character. Writing over half of a wide character blanks its other half, as a
     * terminal does. A control character (a byte below 32, or 127) is an error: the terminal
     * would do something with it (a tab moves to its own tab stop, an escape starts a sequence)
     * that the grid can't know, and the grid's promise is that the terminal shows what it holds;
     * expand tabs before drawing, and give a style as $style, not as escape sequences in $text.
     */
    pub fn put($col, $row, $text, $style = "") {
        #put_within($col, $row, $text, $style, #whole);
    }

    /**
     * put() clipped to $rect instead of the screen: nothing outside $rect is drawn, a wide
     * character with a column in it and a column out of it being a blank in the one in it, as at
     * the screen's edge. The columns and rows are the screen's, as put()'s: a Pane gives its
     * views their own, from its top left, and calls this.
     */
    pub fn put_in($rect, $col, $row, $text, $style = "") {
        $clip = $rect.within(#whole);
        if ($clip.is_empty()) {
            return null;
        }
        #put_within($col, $row, $text, $style, $clip);
    }

    /* put() inside $clip, a Rect already on the screen and not empty */
    fn put_within($col, $row, $text, $style, $clip) {
        $first = $clip.col;
        $last = $clip.col + $clip.width - 1;
        if ($row < $clip.row || $row >= $clip.row + $clip.height) {
            return null;
        }
        $style = term::Style::of($style);
        $r = $row - 1;
        $at = $col;
        /* the character read last isn't placed until the next is read, since a mark joins it */
        $pending = null;
        $pending_width = 0;
        foreach (term::chars($text) as $char) {
            $width = utf8_width($char);
            if ($width == 0 && $pending != null) {
                $pending ..= $char;
                continue;
            }
            if (len($char) == 1 && (ord($char) < 32 || ord($char) == 127)) {
                throw "tui: a cell can't hold the control character " .. quote($char)
                    .. ": expand tabs before drawing, and give a style as put()'s \$style";
            }
            if ($pending != null) {
                /* a one-column character on the screen, the common case, is placed here rather
                   than by place() and set(): a frame drawn in full is twelve thousand of these,
                   and each call is a frame of its own */
                if ($pending_width == 1 && $at >= $first && $at <= $last) {
                    $old = #cells[$r][$at - 1];
                    if ($old.width != 1) {
                        #free_half($r, $at - 1, $old);
                    }
                    #cells[$r][$at - 1] = Cell($pending, 1, $style);
                    $at++;
                } else {
                    $at = #place($r, $at, $pending, $pending_width, $style, $first, $last);
                }
            }
            if ($width == 0) {
                $char = " " .. $char;
                $width = 1;
            }
            $pending = $char;
            $pending_width = $width;
        }
        if ($pending != null) {
            #place($r, $at, $pending, $pending_width, $style, $first, $last);
        }
    }

    /*
     * $char, $width columns wide, at column $at of row index $r in $style, or clipped to columns
     * $first to $last: gives the column after it. A wide character that doesn't fit at an edge is a blank in the column it
     * has on the screen, in the style, so a styled field keeps its background to its edge.
     */
    fn place($r, $at, $char, $width, $style, $first, $last) {
        $end = $at + $width - 1;
        if ($at >= $first && $end <= $last) {
            if ($width == WIDE) {
                #set_wide($r, $at - 1, $char, $style);
            } else {
                #set($r, $at - 1, Cell($char, 1, $style));
            }
        } else if ($width == WIDE && $at == $last) {
            #set($r, $at - 1, Cell(" ", 1, $style));
        } else if ($width == WIDE && $end == $first) {
            #set($r, $first - 1, Cell(" ", 1, $style));
        }
        return $end + 1;
    }

    /*
     * $cell at column index $c of row $r. A wide character with half under it loses its other
     * half, which becomes the blank, as a terminal does when one is written over.
     */
    fn set($r, $c, $cell) {
        $old = #cells[$r][$c];
        if ($old.width != 1) {
            #free_half($r, $c, $old);
        }
        #cells[$r][$c] = $cell;
    }

    /*
     * $old, half of a wide character at column index $c of row $r, is being written over: its
     * other half becomes the blank
     */
    fn free_half($r, $c, $old) {
        if ($old.width == CONTINUATION) {
            #cells[$r][$c - 1] = Cell::blank();
        } else {
            #cells[$r][$c + 1] = Cell::blank();
        }
    }

    /* The wide character $char at column indexes $c and $c + 1 of row $r, its halves' neighbours as set()'s */
    fn set_wide($r, $c, $char, $style) {
        if (#cells[$r][$c].width == CONTINUATION) {
            #cells[$r][$c - 1] = Cell::blank();
        }
        if (#cells[$r][$c + 1].width == WIDE) {
            #cells[$r][$c + 2] = Cell::blank();
        }
        #cells[$r][$c] = Cell($char, WIDE, $style);
        #cells[$r][$c + 1] = Cell("", CONTINUATION, $style);
    }

    /**
     * $rect filled with $char in $style; a wide $char fills the width in columns, so an odd
     * width leaves its last column as it was
     */
    pub fn fill($rect, $char = " ", $style = "") {
        $line = repeat($char, intdiv(max($rect.width, 0), max(utf8_width($char), 1)));
        for ($i = 0; $i < $rect.height; $i++) {
            #put($rect.col, $rect.row + $i, $line, $style);
        }
    }

    /**
     * Where the terminal's cursor goes after a render (a text field's), or none
     */
    pub fn cursor($col, $row) {
        #caret = Caret($col, $row);
    }

    /**
     * The whole screen as a Rect, for a view to cut up
     */
    pub fn bounds() {
        return Rect(1, 1, #cols, #rows);
    }

    /**
     * Each row as plain text, for a test to read: each wide character once, so a row's text is
     * as wide as the screen in columns, not in characters
     */
    pub fn lines() {
        $lines = [];
        foreach (#cells as $row) {
            $line = "";
            foreach ($row as $cell) {
                $line ..= $cell.character;
            }
            $lines[] = $line;
        }
        return $lines;
    }

    /**
     * The text inside $rect (clipped to the screen) as a list of its rows, for a test to read
     * without slicing bytes: by cells, so a wide character is there once and a continuation never
     * (a wide character cut in two by the Rect's left edge is left out, and one cut by its right
     * edge is kept whole), and without the blanks at the end of each row. A box's edges are
     * text like any other.
     */
    pub fn text($rect) {
        $inside = $rect.within(#bounds());
        $rows = [];
        for ($i = 0; $i < $inside.height; $i++) {
            $line = "";
            foreach (slice(#cells[$inside.row + $i - 1], $inside.col - 1, $inside.width) as $cell) {
                $line ..= $cell.character;
            }
            $rows[] = trim_end($line);
        }
        return $rows;
    }

    /**
     * A Pane on $rect: what a part of the screen is given to draw in, never leaving it
     */
    pub fn pane($rect) {
        return Pane(#, $rect);
    }

    /**
     * The screen as text to read, which gaz --tty prints: a ruler of columns, each row numbered
     * (both from 1, as put() counts them, and without the spaces at its end), then the styled
     * text, since a row's text can't show which item is inverse or bold, and where the cursor is.
     *
     *              10        20
     *        1 ┌─ Menu ─────┐
     *        2 │> First     │
     *     styles:
     *        2  2-12  inverse  "> First"
     */
    pub fn snapshot() {
        $margin = len(to_string(#rows)) + 1;
        $out = trim_end(repeat(" ", $margin) .. #ruler()) .. "\n";
        foreach (#lines() as $i => $line) {
            $out ..= trim_end(format_row($i + 1, $margin) .. $line) .. "\n";
        }
        $runs = #styled_runs($margin);
        if (len($runs) > 0) {
            $out ..= "styles:\n" .. join($runs, "");
        }
        if (#caret != null) {
            $out ..= "cursor: column " .. #caret.col .. ", row " .. #caret.row .. "\n";
        }
        return $out;
    }

    // Every tenth column's number, its last digit over that column
    fn ruler() {
        $ruler = "";
        for ($col = 10; $col <= #cols; $col += 10) {
            $number = to_string($col);
            $ruler ..= repeat(" ", $col - len($ruler) - len($number)) .. $number;
        }
        return $ruler;
    }

    // Each stretch of a row in one style that has a letter or digit in it (a border tells nothing), a line each, naming the style's spec
    fn styled_runs($margin) {
        $runs = [];
        foreach (#cells as $r => $row) {
            $start = 0;
            for ($c = 1; $c <= #cols; $c++) {
                if ($c < #cols && $row[$c].style == $row[$start].style) {
                    continue;
                }
                $style = $row[$start].style;
                $text = trim_end(join(map(slice($row, $start, $c - $start), $cell -> $cell.character), ""));
                if (!$style.is_plain() && has_word($text)) {
                    $runs[] = format_row($r + 1, $margin) .. " " .. ($start + 1) .. "-" .. $c .. "  " .. $style.spec
                        .. "  " .. quote($text) .. "\n";
                }
                $start = $c;
            }
        }
        return $runs;
    }

    /**
     * The Cell at column $col of row $row: its character, width and style
     */
    pub fn cell($col, $row) {
        return #cells[$row - 1][$col - 1];
    }

    /**
     * The escape sequences that make the terminal show this screen. The first render clears the
     * terminal and draws what isn't blank; after that only what has changed since the last one,
     * each row from its first changed cell to its last, a wide character always whole.
     */
    pub fn render() {
        $full = #shown == null;
        $out = $full ? term::RESET .. term::clear() : "";
        $blank = Cell::blank();
        for ($r = 0; $r < #rows; $r++) {
            $row = #cells[$r];
            if ($full ? $row == #blank : $row == #shown[$r]) {
                continue;
            }
            $first = 0;
            $last = #cols - 1;
            if ($full) {
                /* the clear made the blanks at either end so already */
                while ($row[$first] == $blank) {
                    $first++;
                }
                while ($row[$last] == $blank) {
                    $last--;
                }
            } else {
                while ($row[$first] == #shown[$r][$first]) {
                    $first++;
                }
                while ($row[$last] == #shown[$r][$last]) {
                    $last--;
                }
            }
            if ($row[$first].width == CONTINUATION) {
                // a run never starts on a continuation: the wide character before it is drawn whole
                $first--;
            }
            $out ..= term::move_to($first + 1, $r + 1);
            $style = $blank.style;
            for ($c = $first; $c <= $last; $c++) {
                $cell = $row[$c];
                if ($cell.style != $style) {
                    if (!$style.is_plain()) {
                        $out ..= term::RESET;
                    }
                    $style = $cell.style;
                    $out ..= $style.sequence;
                }
                $out ..= $cell.character;
            }
            if (!$style.is_plain()) {
                $out ..= term::RESET;
            }
        }
        #shown = #cells;
        if (#caret == null) {
            return $out .. term::hide_cursor();
        }
        return $out .. term::move_to(#caret.col, #caret.row) .. term::show_cursor();
    }
}

/* $text cut to what fits in $width columns, and the columns that takes */
kind Fit {
    fn _(pub #text, pub #columns);
}

/*
 * As much of $text as fits in $width columns, by utf8_width(): a wide character that doesn't fit
 * ends it, so one is never cut in half; a combining mark joins the character before it, and one
 * starting the text counts a column, as put() draws it over a space
 */
fn fit($text, $width) {
    $kept = "";
    $columns = 0;
    foreach (term::chars($text) as $char) {
        $takes = utf8_width($char);
        if ($takes == 0 && $kept == "") {
            $takes = 1;
        }
        if ($columns + $takes > $width) {
            break;
        }
        $kept ..= $char;
        $columns += $takes;
    }
    return Fit($kept, $columns);
}

/**
 * A rectangle of the screen: where it starts (columns and rows count from 1) and how big. Every
 * drawing function takes one, and a view is given one to draw in and cuts it up with the split_
 * methods, inset() and line() for its parts, so it does no column arithmetic of its own; a part
 * that doesn't fit is smaller, never negative, and one of no width or height draws nothing.
 */
pub kind Rect {
    /**
     * The rectangle $width by $height with its top left at column $col, row $row
     */
    fn _(pub #col, pub #row, pub #width, pub #height);

    /**
     * Shrunk by $cols on the left and the right and $rows at the top and the bottom, to nothing
     * at the least: inset(1) is the inside of a box drawn in it
     */
    pub fn inset($cols = 1, $rows = $cols) {
        return Rect(#col + $cols, #row + $rows, max(#width - 2 * $cols, 0), max(#height - 2 * $rows, 0));
    }

    /**
     * Row $n of the rectangle (from 0) as a Rect one row high, for a label on it; past the last
     * row it has no height, so a label there draws nothing
     */
    pub fn line($n) {
        return Rect(#col, #row + $n, #width, $n >= 0 && $n < #height ? 1 : 0);
    }

    /**
     * Whether nothing can be drawn in it: no width or no height
     */
    pub fn is_empty() {
        return #width <= 0 || #height <= 0;
    }

    /**
     * The part of it in $outer: where the two overlap, of no size if they don't
     */
    pub fn within($outer) {
        $left = max(#col, $outer.col);
        $top = max(#row, $outer.row);
        $right = min(#col + #width, $outer.col + $outer.width);
        $bottom = min(#row + #height, $outer.row + $outer.height);
        return Rect($left, $top, max($right - $left, 0), max($bottom - $top, 0));
    }

    /**
     * What is left after taking $n columns off its left side (all of them at the most)
     */
    pub fn without_left($n) {
        return #split_left($n)[1];
    }

    /**
     * What is left after taking $n columns off its right side
     */
    pub fn without_right($n) {
        return #split_right($n)[0];
    }

    /**
     * What is left after taking $n rows off its top
     */
    pub fn without_top($n) {
        return #split_top($n)[1];
    }

    /**
     * What is left after taking $n rows off its bottom
     */
    pub fn without_bottom($n) {
        return #split_bottom($n)[0];
    }

    /**
     * [the first $width columns, the rest]
     */
    pub fn split_left($width) {
        $left = min(max($width, 0), #width);
        return [Rect(#col, #row, $left, #height), Rect(#col + $left, #row, #width - $left, #height)];
    }

    /**
     * [the rest, the last $width columns]
     */
    pub fn split_right($width) {
        $right = min(max($width, 0), #width);
        return [Rect(#col, #row, #width - $right, #height), Rect(#col + #width - $right, #row, $right, #height)];
    }

    /**
     * [the first $height rows, the rest]
     */
    pub fn split_top($height) {
        $top = min(max($height, 0), #height);
        return [Rect(#col, #row, #width, $top), Rect(#col, #row + $top, #width, #height - $top)];
    }

    /**
     * [the rest, the last $height rows]
     */
    pub fn split_bottom($height) {
        $bottom = min(max($height, 0), #height);
        return [Rect(#col, #row, #width, #height - $bottom), Rect(#col, #row + #height - $bottom, #width, $bottom)];
    }
}

/**
 * A part of a Screen to draw in, whose edges nothing drawn into it crosses. It has Screen's
 * drawing methods (put(), fill(), cursor(), bounds(), cols, rows, pane()), but counted from its
 * own top left, (1, 1), so a view given a Pane draws as it would into a whole Screen of that
 * size: `$pane = $screen.pane($rect); $view.draw($pane, $pane.bounds());`. The drawing functions
 * (label(), box(), table(), ...) and the widgets' draw() only call those methods, so they take a
 * Screen or a Pane alike. Clipping is by columns as the screen's is: a wide character half in
 * the Pane is a blank in the half that is.
 */
pub kind Pane {
    #screen;
    #rect;

    /**
     * Its width in columns
     */
    pub #cols;

    /**
     * Its height in rows
     */
    pub #rows;

    /**
     * The part of $screen (a Screen) in $rect, in the screen's own columns and rows; what of
     * $rect is off the screen is not in the Pane
     */
    fn _($screen, $rect) {
        #screen = $screen;
        #rect = $rect.within($screen.bounds());
        #cols = #rect.width;
        #rows = #rect.height;
    }

    /**
     * All of it as a Rect, (1, 1) to its size, for a view to cut up
     */
    pub fn bounds() {
        return Rect(1, 1, #rect.width, #rect.height);
    }

    /**
     * $text from column $col of row $row, counted from the Pane's top left, as Screen.put() draws
     * it, and clipped to the Pane
     */
    pub fn put($col, $row, $text, $style = "") {
        #screen.put_in(#rect, #rect.col + $col - 1, #rect.row + $row - 1, $text, $style);
    }

    /**
     * $rect (the Pane's own columns and rows) filled as Screen.fill() fills, clipped to the Pane
     */
    pub fn fill($rect, $char = " ", $style = "") {
        #screen.fill(#absolute($rect).within(#rect), $char, $style);
    }

    /**
     * Where the terminal's cursor goes: column $col of row $row of the Pane. A place outside the
     * Pane is not set, so the cursor stays where it was.
     */
    pub fn cursor($col, $row) {
        if ($col >= 1 && $col <= #rect.width && $row >= 1 && $row <= #rect.height) {
            #screen.cursor(#rect.col + $col - 1, #rect.row + $row - 1);
        }
    }

    /**
     * A Pane on $rect (this Pane's own columns and rows), which is inside this one
     */
    pub fn pane($rect) {
        return Pane(#screen, #absolute($rect).within(#rect));
    }

    /* $rect, counted from the Pane's top left, in the screen's columns and rows */
    fn absolute($rect) {
        return Rect(#rect.col + $rect.col - 1, #rect.row + $rect.row - 1, $rect.width, $rect.height);
    }
}

/* ---- Drawing ----------------------------------------------------------------------------- */

/**
 * $text on the first row of $rect, filling its width: cut off if longer (a wide character that
 * doesn't fit is left out whole) and padded if shorter, $align "left", "center" or "right". A
 * $rect of no width or height draws nothing.
 */
pub fn label($screen, $rect, $text, $style = "", $align = "left") {
    if ($rect.is_empty()) {
        return null;
    }
    $fit = fit($text, $rect.width);
    $gap = $rect.width - $fit.columns;
    $before = match ($align) {
        "left" => 0,
        "center" => intdiv($gap, 2),
        "right" => $gap,
    };
    $screen.put($rect.col, $rect.row, repeat(" ", $before) .. $fit.text .. repeat(" ", $gap - $before), $style);
}

/**
 * A box on the edges of $rect, its inside blank, and $title in the top edge; $rect.inset() is
 * the inside, to draw in. $border is single, double, round, heavy or ascii.
 */
pub fn box($screen, $rect, $title = "", $style = "", $border = "single") {
    if (!has_key(BORDERS, $border)) {
        throw "tui::box: unknown border \"" .. $border .. "\"";
    }
    $width = $rect.width;
    if ($width < 2 || $rect.height < 2) {
        return null;
    }
    [$top_left, $top_right, $bottom_left, $bottom_right, $across, $down] = BORDERS[$border];
    $top = repeat($across, $width - 2);
    if ($title != "" && $width >= 5) {
        $fit = fit(" " .. $title .. " ", $width - 3);
        $top = $across .. $fit.text .. repeat($across, $width - 3 - $fit.columns);
    }
    $screen.put($rect.col, $rect.row, $top_left .. $top .. $top_right, $style);
    for ($i = 1; $i < $rect.height - 1; $i++) {
        $screen.put($rect.col, $rect.row + $i, $down .. repeat(" ", $width - 2) .. $down, $style);
    }
    $screen.put($rect.col, $rect.row + $rect.height - 1, $bottom_left .. repeat($across, $width - 2) .. $bottom_right, $style);
}

// What progress() keeps at the bar's end for the percentage: " 100%"
const PERCENTAGE_WIDTH = 5;

/**
 * A bar across the first row of $rect, $fraction (0 to 1) of it filled, and the percentage at
 * its end
 */
pub fn progress($screen, $rect, $fraction, $style = "green") {
    $bar = $rect.width - PERCENTAGE_WIDTH;
    if ($bar < 1 || $rect.height < 1) {
        return null;
    }
    $fraction = max(0, min(1, $fraction));
    $filled = to_int(round($fraction * $bar));
    $screen.put($rect.col, $rect.row, repeat("█", $filled), $style);
    $screen.put($rect.col + $filled, $rect.row, repeat("░", $bar - $filled), "dim");
    [, $percentage] = $rect.line(0).split_right(PERCENTAGE_WIDTH);
    label($screen, $percentage, to_int(round($fraction * 100)) .. "%", "", "right");
}

/* $text in a field $width wide, numbers on the right */
fn cell_text($value, $width) {
    $text = to_string($value);
    $gap = max($width - term::width($text), 0);
    $number = type_of($value) == "int" || type_of($value) == "float";
    return $number ? repeat(" ", $gap) .. $text : $text .. repeat(" ", $gap);
}

/* $cells with "" added to make $count of them */
fn padded($cells, $count) {
    while (len($cells) < $count) {
        $cells[] = "";
    }
    return $cells;
}

/**
 * A table from the top of $rect: $headers a list of names, $rows a list of lists, columns as
 * wide as their widest cell and numbers aligned on the right; a header or a row shorter than the
 * rest is blank where it stops. As many rows as fit under the header and its rule, each cut off
 * at $rect's width (table_width() says what it wants). Gives how many rows of $rect it took
 * (two more than the rows shown).
 */
pub fn table($screen, $rect, $headers, $rows, $style = "") {
    [$headers, $rows] = squared($headers, $rows);
    $widths = column_widths($headers, $rows);
    $rule = join(map($widths, $w -> repeat("─", $w)), "─┼─");
    $line = [];
    foreach ($headers as $i => $header) {
        $line[] = cell_text($header, $widths[$i]);
    }
    label($screen, $rect.line(0), join($line, TABLE_SEPARATOR), "bold");
    label($screen, $rect.line(1), $rule, "dim");
    $shown = slice($rows, 0, max($rect.height - 2, 0));
    foreach ($shown as $n => $cells) {
        $line = [];
        foreach ($cells as $i => $cell) {
            $line[] = cell_text($cell, $widths[$i]);
        }
        label($screen, $rect.line(2 + $n), join($line, TABLE_SEPARATOR), $style);
    }
    return min(len($shown) + 2, max($rect.height, 0));
}

/* ---- Widgets that take keys -------------------------------------------------------------- */

/**
 * What a widget's handle($key) gives, so a caller matches on a case (tui::Outcome::Select) and a
 * misspelling is an error when the program is read. The cases a widget ends with:
 *
 *  - Select: enter on a List, a Table or a Menu (when there is something selected)
 *  - Cancel: a Menu's cancel keys (escape, q and ctrl+c unless it is given others) and the end
 *    of the input; escape, ctrl+c and the end of the input on a TextField
 *  - Submit: enter on a TextField
 *
 * and the two that say whether the key was the widget's: Ignored for a key that isn't its
 * business (a List's or Menu's letters that don't move it, a Table's sort keys when it is not
 * sortable(), a TextField's keys that don't edit), and null for a key it took with nothing to
 * report (moving, typing, sorting). So a program gives its focused widget the key first and takes
 * Ignored for itself, which is how a prompt line, a buffer and a list share the keyboard.
 */
pub enum Outcome {
    /**
     * Enter on a List, a Table or a Menu: the row or item selected is the answer
     */
    Select;
    /**
     * A Menu's cancel keys, escape or ctrl+c on a TextField, or the end of the input: no answer
     */
    Cancel;
    /**
     * Enter on a TextField: its text is the answer
     */
    Submit;
    /**
     * The key is not the widget's business, and it did nothing with it
     */
    Ignored;
}

/* $text cut to $width columns and padded to it, on the left when $right */
fn fitted($text, $width, $right) {
    $fit = fit($text, $width);
    $gap = $width - $fit.columns;
    return $right ? repeat(" ", $gap) .. $fit.text : $fit.text .. repeat(" ", $gap);
}

/**
 * The width table() draws $headers and $rows at, for fitting what goes beside it
 */
pub fn table_width($headers, $rows) {
    [$headers, $rows] = squared($headers, $rows);
    $widths = column_widths($headers, $rows);
    return sum($widths) + TABLE_GAP * max(len($widths) - 1, 0);
}

// What table() puts between columns, and how many columns that takes on the screen
const TABLE_SEPARATOR = " │ ";
const TABLE_GAP = 3;

// $headers and $rows with as many cells each as the longest of them, a short row or header blank in the rest
fn squared($headers, $rows) {
    $columns = len($headers);
    foreach ($rows as $cells) {
        $columns = max($columns, len($cells));
    }
    return [padded($headers, $columns), map($rows, $cells -> padded($cells, $columns))];
}

// Each column's width: its widest cell, the header included
fn column_widths($headers, $rows) {
    $widths = map($headers, $h -> term::width(to_string($h)));
    foreach ($rows as $cells) {
        foreach ($cells as $i => $cell) {
            $widths[$i] = max($widths[$i], term::width(to_string($cell)));
        }
    }
    return $widths;
}

/**
 * $text cut into lines no wider than $width columns: at spaces, keeping its own line breaks, and
 * a word wider than a whole line cut where it must be, never through a wide character (a width
 * of 1 still gives a wide character a line of its own, which is clipped when drawn)
 */
pub fn wrap($text, $width) {
    $width = max($width, 1);
    $lines = [];
    foreach (split($text, "\n") as $paragraph) {
        $before = len($lines);
        $line = "";
        foreach (split($paragraph, " ") as $word) {
            while (term::width($word) > $width) {
                // a word too long for any line starts one of its own, and is cut into whole lines
                if ($line != "") {
                    $lines[] = $line;
                    $line = "";
                }
                $fit = fit($word, $width);
                if ($fit.text == "") {
                    $fit = fit($word, WIDE);
                }
                $lines[] = $fit.text;
                $word = slice($word, len($fit.text));
            }
            if ($word == "" && $line == "" && len($lines) > $before) {
                // the word was whole lines exactly, so nothing of it is left to start the next
                continue;
            }
            if ($line == "") {
                $line = $word;
            } else if (term::width($line) + 1 + term::width($word) <= $width) {
                $line ..= " " .. $word;
            } else {
                $lines[] = $line;
                $line = $word;
            }
        }
        if ($line != "" || len($lines) == $before) {
            // a paragraph is a line at the least, and never ends in an empty line it didn't have
            $lines[] = $line;
        }
    }
    return $lines;
}

/**
 * $text wrapped into $rect, as much of it as fits, in $style; gives how many lines it took
 */
pub fn paragraph($screen, $rect, $text, $style = "") {
    $lines = slice(wrap($text, $rect.width), 0, max($rect.height, 0));
    foreach ($lines as $i => $line) {
        label($screen, $rect.line($i), $line, $style);
    }
    return len($lines);
}

/**
 * A key hint: the keys and what they do, Hint("j/k", "move"), said "j/k move" by hints() and
 * in its own columns by key_help(); or a prompt, Hint::prompt("Who goes off?"), text with no
 * keys, said as it is by hints() and left out by key_help(). A View's hints() gives a list of
 * them.
 */
pub readonly kind Hint {
    /**
     * The hint that $keys do $what; $keys "" for a prompt
     */
    fn _(pub #keys, pub #what);

    /**
     * A prompt: $text with no keys, for a line of hints to say as it is
     */
    pub static fn prompt($text) {
        return Hint("", $text);
    }

    /**
     * Whether it is a prompt rather than keys
     */
    pub fn is_prompt() {
        return #keys == "";
    }

    /**
     * The hint as one line of hints says it: the keys, a space and what they do, or the prompt
     */
    pub fn text() {
        return #is_prompt() ? #what : #keys .. " " .. #what;
    }
}

// What hints() puts between two hints
const HINT_GAP = "  ";

/**
 * A line of key hints on the first row of $rect: as many whole ones of $hints (a list of Hint)
 * as fit, two spaces between them, and $more at the right end ("? keys") when given, for where
 * the rest are
 */
pub fn hints($screen, $rect, $hints, $more = "", $style = "dim") {
    $line = $rect.line(0);
    $room = $line;
    if ($more != "" && $line.width >= term::width($more)) {
        [$room, $end] = $line.split_right(term::width($more));
        $room = $room.split_right(len(HINT_GAP))[0];
        label($screen, $end, $more, $style);
    }
    $text = "";
    foreach ($hints as $hint) {
        $next = $text == "" ? $hint.text() : $text .. HINT_GAP .. $hint.text();
        if (term::width($next) > $room.width) {
            break;
        }
        $text = $next;
    }
    label($screen, $room, $text, $style);
}

/* A line of key_help(): a group's heading, or a hint under it */
kind HelpLine {
    fn _(pub #heading, pub #hint = null);

    /* What it says in the keys column and in the column after it; a heading has no keys */
    pub fn keys() {
        return #hint == null ? "" : #hint.keys;
    }

    pub fn what() {
        return #hint == null ? #heading : #hint.what;
    }
}

// Columns between a box's edge and its text, and between the keys and what they do, in key_help()
const HELP_MARGIN = 2;
const HELP_GAP = 2;

/**
 * Every key there is, in a box in the middle of $screen, over what is there: $groups is a map
 * of a heading to its hints as hints() takes them, {"Squad" => $view.hints(), "Everywhere" =>
 * $keys} (a prompt is left out). What doesn't fit the screen is cut off.
 */
pub fn key_help($screen, $groups, $title = "Keys") {
    $lines = [];
    foreach ($groups as $heading => $group) {
        if (len($lines) > 0) {
            $lines[] = HelpLine("");
        }
        $lines[] = HelpLine($heading);
        foreach (filter($group, $hint -> !$hint.is_prompt()) as $hint) {
            $lines[] = HelpLine("", $hint);
        }
    }
    $keys_width = reduce($lines, ($most, $line) -> max($most, term::width($line.keys())), 0);
    $inner = reduce($lines, ($most, $line) -> max($most, $line.keys() == "" ? term::width($line.what()) : $keys_width + HELP_GAP + term::width($line.what())), term::width($title) + 4);
    $width = min($screen.cols, $inner + 2 * HELP_MARGIN);
    $height = min($screen.rows, len($lines) + 2);
    $box = centered($screen, $width, $height);
    $screen.fill($box);
    box($screen, $box, $title, "cyan");
    $inside = $box.inset(HELP_MARGIN, 1);
    foreach (slice($lines, 0, $inside.height) as $i => $line) {
        $at = $inside.line($i);
        if ($line.keys() == "") {
            label($screen, $at, $line.what(), "bold");
        } else {
            [$keys, $rest] = $at.split_left($keys_width);
            $what = $rest.without_left(HELP_GAP);
            label($screen, $keys, $line.keys(), "cyan");
            label($screen, $what, $line.what());
        }
    }
}

/*
 * A selection in a scrolling window of items: how many there are, which is selected, which is the
 * first showing, and how far a page moves. List, Table and Menu each keep one and give it the
 * keys that move, so the three move alike and scroll alike.
 */
kind Selection {
    // Rows a page moves before a draw has said how many show
    const FIRST_PAGE = 10;

    #selected = 0;
    #top = 0;
    #page = #FIRST_PAGE;

    fn _(#count = 0);

    /* Which item is selected, from 0 (0 when there are none) */
    pub fn index() {
        return #selected;
    }

    /* Whether there is anything to select */
    pub fn has_any() {
        return #count > 0;
    }

    /* The number of items is now $count: the selection stays where it was, or on the last item */
    pub fn set_count($count) {
        #count = $count;
        #selected = max(min(#selected, #count - 1), 0);
    }

    /* Select item $index, or the nearest one there is */
    pub fn select($index) {
        #selected = max(min($index, #count - 1), 0);
    }

    /*
     * Move for $key if it is a key that moves (the arrows or j and k, home and end or g and G,
     * page up and down) and say whether it was one. An empty selection stays on 0.
     */
    pub fn move($key) {
        $last = max(#count - 1, 0);
        match (term::name($key)) {
            "up", "k" => { #selected = max(#selected - 1, 0); }
            "down", "j" => { #selected = min(#selected + 1, $last); }
            "home", "g" => { #selected = 0; }
            "end", "G" => { #selected = $last; }
            "page_up" => { #selected = max(#selected - #page, 0); }
            "page_down" => { #selected = min(#selected + #page, $last); }
            default => { return false; }
        }
        return true;
    }

    /*
     * $visible items fit where it is drawn: a page is one less, and the first showing is moved
     * only as far as the selection needs. Gives the index of the first item showing.
     */
    pub fn scroll($visible) {
        if ($visible < 1) {
            return #top;
        }
        #page = max($visible - 1, 1);
        if (#selected < #top) {
            #top = #selected;
        }
        if (#selected >= #top + $visible) {
            #top = #selected - $visible + 1;
        }
        return #top;
    }
}

/**
 * A scrolling list of items with a selection, drawn on a Rect with no box or header: the selected
 * item is inverse when the list has the focus and bold when not, as a Table's row is. $items are
 * strings, or values printed as to_string() prints them. $style_of($item, $index), if given, says
 * what style an item is drawn in ($index is where it is in the items).
 *
 * handle() claims only movement (the arrows or j and k, home and end or g and G, page up and
 * down) and gives Outcome::Select for enter; any other key is not its business, and handle()
 * gives Outcome::Ignored for it, so a program takes the keys it wants for itself.
 */
pub kind List {
    #items;
    #style_of;
    #at;
    #on = "";
    #off = "";

    /**
     * A list of $items, the first selected
     */
    fn _($items, $style_of = null) {
        #items = $items;
        #style_of = $style_of;
        #at = Selection(len($items));
    }

    /**
     * Mark the selected item with $on and the others with $off, in front of each (two spaces
     * wide each is usual: "> " and "  "), for where inverse or bold alone is too little. Gives the
     * list, so it can follow the constructor.
     */
    pub fn marked($on = "> ", $off = "  ") {
        #on = $on;
        #off = $off;
        return #;
    }

    /**
     * Which item is selected, as its index in the items, or null when there are none
     */
    pub fn selected_index() {
        return #at.has_any() ? #at.index() : null;
    }

    /**
     * The selected item as it was given, or null when there are none
     */
    pub fn selected_item() {
        return #at.has_any() ? #items[#at.index()] : null;
    }

    /**
     * Select item $index, or the nearest one there is
     */
    pub fn select($index) {
        #at.select($index);
    }

    /**
     * Show other items, keeping the selection on the same index where there still is one (and on
     * the last item where there are fewer than that)
     */
    pub fn set_items($items) {
        #items = $items;
        #at.set_count(len($items));
    }

    /**
     * Take a key: null for movement, which has moved the selection; Outcome::Select for enter
     * (null on an empty list, which has nothing to select); Outcome::Ignored for any other key
     */
    pub fn handle($key) {
        if (#at.move($key)) {
            return null;
        }
        if (term::name($key) == "enter") {
            return #at.has_any() ? Outcome::Select : null;
        }
        return Outcome::Ignored;
    }

    /**
     * Draw it in $rect, scrolled so the selected item shows, the selected item showing as such
     * only when $focused
     */
    pub fn draw($screen, $rect, $focused = true) {
        $top = #at.scroll($rect.height);
        $style_of = #style_of;
        for ($line = 0; $line < $rect.height && $top + $line < len(#items); $line++) {
            $index = $top + $line;
            $item = #items[$index];
            $style = term::Style::of($style_of == null ? "" : $style_of($item, $index));
            $on = $index == #at.index();
            if ($on) {
                $style = $style.with($focused ? "inverse" : "bold");
            }
            label($screen, $rect.line($line), ($on ? #on : #off) .. to_string($item), $style);
        }
    }
}

/**
 * How a Table is sorted: the column (from 0) and whether the greatest comes first
 */
pub readonly kind Sort {
    /**
     * Sorted on $column, the greatest first when $descending
     */
    fn _(pub #column, pub #descending);
}

/**
 * A table you move about in: a header, rows that scroll, a selected row, and columns that sort.
 * $headers are the column names and $rows a list of lists of cells; a column whose cells are all
 * numbers is aligned on the right. $style_of($row, $index), if given, says what style a row is
 * drawn in ($index is where it is in $rows, however they are sorted now), so a table can mark
 * the user's own club. Cells in a column must be alike, or sorting on it is an error.
 *
 * handle() gives Outcome::Select for enter, null for a key it took and Outcome::Ignored for any
 * other. Keys: the arrows or j and
 * k, home and end or g and G, page up and down; "." and "," (or > and <) sort by the next or
 * previous column shown, "o" turns the order round and "x" goes back to the order the rows came
 * in.
 *
 * A table too wide for where it is drawn leaves out the columns drop_when_narrow() names, then
 * squeezes the widest of the rest.
 */
pub kind Table {
    // Columns between two of its columns
    const COLUMN_GAP = 2;

    #headers;
    #rows = [];
    #style_of;
    #numeric = [];
    /* Columns to leave out when there isn't room, the first first; and those left out last drawn */
    #droppable = [];
    #hidden = [];
    /* Indexes into #rows in the order shown; the selection is a position in that order */
    #order = [];
    #at = Selection();
    #keys_sort = true;
    #column = null;
    #descending = false;

    /**
     * A table of $rows under $headers, in the order given, the first row selected
     */
    fn _($headers, $rows, $style_of = null) {
        #headers = $headers;
        #style_of = $style_of;
        #rows = $rows;
        #analyse();
        #reorder(null);
    }

    /**
     * When the table is too wide, leave out $columns (indexes from 0) in that order, as many as it
     * takes, before squeezing any: a name cut to four letters says less than a column not shown.
     * Gives the table, so it can follow the constructor.
     */
    pub fn drop_when_narrow($columns) {
        #droppable = $columns;
        return #;
    }

    /* Which columns are all numbers */
    fn analyse() {
        #numeric = [];
        foreach (#headers as $i => $header) {
            $all = len(#rows) > 0;
            foreach (#rows as $row) {
                $type = type_of($row[$i]);
                $all = $all && ($type == "int" || $type == "float");
            }
            #numeric[] = $all;
        }
    }

    /* Put #order right for the rows and the sort, keeping the row at index $keep selected */
    fn reorder($keep) {
        #order = [];
        for ($i = 0; $i < len(#rows); $i++) {
            #order[] = $i;
        }
        if (#column != null) {
            $rows = #rows;
            $column = #column;
            #order = #descending
                ? sort(#order, ($a, $b) -> $rows[$b][$column] <=> $rows[$a][$column])
                : sort(#order, ($a, $b) -> $rows[$a][$column] <=> $rows[$b][$column]);
        }
        #at.set_count(len(#order));
        if ($keep != null) {
            foreach (#order as $position => $index) {
                if ($index == $keep) {
                    #at.select($position);
                }
            }
        }
    }

    /**
     * Which of the rows is selected, as its index in the rows given, or null when there are none
     */
    pub fn selected_index() {
        return len(#order) == 0 ? null : #order[#at.index()];
    }

    /**
     * The selected row, as it was given, or null when there are none
     */
    pub fn selected_row() {
        $index = #selected_index();
        return $index == null ? null : #rows[$index];
    }

    /**
     * Select the row at $index in the rows given (however they are sorted now), or the nearest
     * one there is
     */
    pub fn select($index) {
        #reorder(max(min($index, len(#rows) - 1), 0));
    }

    /**
     * Whether the keys that sort (. , o x < >) do: on by default. Off, they do nothing, so a
     * program can take them for its own. Gives the table, so it can follow the constructor.
     */
    pub fn sortable($on = true) {
        #keys_sort = $on;
        return #;
    }

    /**
     * Show other rows, keeping the selection on the same index where there still is one
     */
    pub fn set_rows($rows) {
        $keep = #selected_index();
        #rows = $rows;
        #analyse();
        #reorder($keep != null && $keep < len($rows) ? $keep : null);
    }

    /**
     * Sort on column $column (from 0), the least first unless $descending
     */
    pub fn sort_by($column, $descending = false) {
        if ($column < 0 || $column >= len(#headers)) {
            throw "tui::Table has no column {$column}";
        }
        $keep = #selected_index();
        #column = $column;
        #descending = $descending;
        #reorder($keep);
    }

    /**
     * The Sort it is sorted by, or null when the rows are in the order given
     */
    pub fn sorted_by() {
        return #column == null ? null : Sort(#column, #descending);
    }

    /**
     * Take a key: null for movement and sorting, which the table has dealt with itself (see the
     * keys above); Outcome::Select for enter (null with no rows); Outcome::Ignored for any other
     * key, the sort keys included when it is not sortable()
     */
    pub fn handle($key) {
        if (#at.move($key)) {
            return null;
        }
        $name = term::name($key);
        if ($name == "enter") {
            return len(#order) > 0 ? Outcome::Select : null;
        }
        if (#keys_sort && #sort_key($name)) {
            return null;
        }
        return Outcome::Ignored;
    }

    /* Sort for $name if it is a sorting key, and say whether it was one */
    fn sort_key($name) {
        match ($name) {
            ".", ">" => { #sort_by(#shown_column(#column == null ? 0 : #column + 1, 1), #descending); }
            ",", "<" => { #sort_by(#shown_column(#column == null ? 0 : #column - 1, -1), #descending); }
            "o" => {
                if (#column != null) {
                    #sort_by(#column, !#descending);
                }
            }
            "x" => {
                $keep = #selected_index();
                #column = null;
                #descending = false;
                #reorder($keep);
            }
            default => { return false; }
        }
        return true;
    }

    /*
     * The first column from $column on, going by $step, that was shown when last drawn; the
     * nearest the other way at an end, as sorting stops at the last column
     */
    fn shown_column($column, $step) {
        $last = len(#headers) - 1;
        $start = max(min($column, $last), 0);
        foreach ([$step, -$step] as $direction) {
            for ($c = $start; $c >= 0 && $c <= $last; $c += $direction) {
                if (!in_array($c, #hidden)) {
                    return $c;
                }
            }
        }
        return $start;
    }

    /*
     * The width of each column: what its widest cell needs, less where the rest is too wide for
     * $available; null for one left out (see drop_when_narrow())
     */
    fn widths($available) {
        $widths = [];
        foreach (#headers as $i => $header) {
            /* one more than the header, for the mark of the column sorted on */
            $width = term::width(to_string($header)) + 1;
            foreach (#rows as $row) {
                $width = max($width, term::width(to_string($row[$i])));
            }
            $widths[] = $width;
        }
        $total = sum($widths) + #COLUMN_GAP * max(len($widths) - 1, 0);
        foreach (#droppable as $column) {
            if ($total <= $available) {
                break;
            }
            $total -= $widths[$column] + #COLUMN_GAP;
            $widths[$column] = null;
        }
        while ($total > $available) {
            $widest = 0;
            foreach ($widths as $i => $width) {
                if ($width != null && $width > ($widths[$widest] ?? 0)) {
                    $widest = $i;
                }
            }
            if ($widths[$widest] <= 3) {
                break;
            }
            $widths[$widest]--;
            $total--;
        }
        return $widths;
    }

    /**
     * Draw it in $rect, the selection showing as such only when $focused
     */
    pub fn draw($screen, $rect, $focused = true) {
        if ($rect.width < 1 || $rect.height < 1) {
            return null;
        }
        $widths = #widths($rect.width);
        #hidden = [];
        foreach ($widths as $i => $width) {
            if ($width == null) {
                #hidden[] = $i;
            }
        }
        $visible = $rect.height - 1;
        $top = #at.scroll($visible);

        $rest = $rect.line(0);
        foreach (#headers as $i => $header) {
            if ($widths[$i] == null) {
                continue;
            }
            $mark = #column == $i ? (#descending ? "▼" : "▲") : "";
            $text = fitted(to_string($header) .. $mark, $widths[$i], #numeric[$i]);
            [$cell, $rest] = $rest.split_left($widths[$i]);
            label($screen, $cell, $text, #column == $i ? "bold underline" : "bold");
            $rest = $rest.without_left(#COLUMN_GAP);
        }

        $style_of = #style_of;
        for ($line = 0; $line < $visible && $top + $line < len(#order); $line++) {
            $position = $top + $line;
            $index = #order[$position];
            $row = #rows[$index];
            $cells = [];
            foreach ($row as $i => $cell) {
                if ($widths[$i] != null) {
                    $cells[] = fitted(to_string($cell), $widths[$i], #numeric[$i]);
                }
            }
            $style = term::Style::of($style_of == null ? "" : $style_of($row, $index));
            if ($position == #at.index()) {
                $style = $style.with($focused ? "inverse" : "bold");
            }
            label($screen, $rect.line(1 + $line), join($cells, repeat(" ", #COLUMN_GAP)), $style);
        }
    }
}

/**
 * A list to choose from, in a box: a List with a title, and keys that cancel. handle() gives
 * Outcome::Select for enter, Outcome::Cancel for one of the cancel keys (escape, q or ctrl+c
 * unless the menu is given others) or the end of the input, null for movement, and
 * Outcome::Ignored for any other key.
 */
pub kind Menu {
    #list;
    #title;
    #cancel_keys;

    /**
     * A menu of $items, strings, with $title on its box, the first selected. $cancel_keys are the
     * keys (as term::name() writes them) that cancel: a program that quits on q gives it
     * ["escape"] and takes q itself.
     */
    fn _($items, $title = "", $cancel_keys = ["escape", "q", "ctrl+c"]) {
        #list = List($items).marked();
        #title = $title;
        #cancel_keys = $cancel_keys;
    }

    /**
     * Which item is selected, as its index in the items, or null when there are none
     */
    pub fn selected_index() { return #list.selected_index(); }

    /**
     * The selected item, or null when there are none
     */
    pub fn selected_item() { return #list.selected_item(); }

    /**
     * Take a key: Outcome::Select for enter, Outcome::Cancel for a cancel key, null for movement,
     * and Outcome::Ignored for any other key
     */
    pub fn handle($key) {
        $name = term::name($key);
        if ($name == "eof" || in_array($name, #cancel_keys)) {
            return Outcome::Cancel;
        }
        return #list.handle($key);
    }

    /**
     * Draw it in a box on $rect, scrolled so the selected item shows, the selection showing as
     * such only when $focused
     */
    pub fn draw($screen, $rect, $focused = true) {
        box($screen, $rect, #title);
        #list.draw($screen, $rect.inset(1), $focused);
    }
}

/**
 * A line of text being edited. handle() takes a key and gives Outcome::Submit for enter,
 * Outcome::Cancel for escape or ctrl+c, and null otherwise: typing inserts, and backspace,
 * delete, the arrows, home and end (or ctrl+a and ctrl+e), ctrl+u (delete to the start) and
 * ctrl+k (to the end) edit. The cursor moves by characters (term::chars()) and is drawn by
 * columns, after a wide character two along.
 */
pub kind TextField {
    #chars;
    #style = "underline";
    /* The cursor, as the index of the character it is before; and the first character shown */
    #at;
    #left = 0;

    /**
     * A field holding $value, the cursor at its end
     */
    fn _($value = "") {
        #chars = term::chars($value);
        #at = len(#chars);
    }

    /**
     * Draw in $style (a term::style() spec or a term::Style; "underline" unless said) from now
     * on. Gives the field, so it can follow the constructor.
     */
    pub fn styled($style) {
        #style = $style;
        return #;
    }

    /**
     * The text in the field
     */
    pub fn value() { return join(#chars, ""); }

    /**
     * Take a key: Outcome::Submit for enter, Outcome::Cancel for escape, ctrl+c or the end of the
     * input, null for a key that edits the text (see above), and Outcome::Ignored for any other
     */
    pub fn handle($key) {
        $typed = term::text($key);
        if ($typed != null) {
            #chars = [...slice(#chars, 0, #at), $typed, ...slice(#chars, #at)];
            #at++;
            return null;
        }
        match (term::name($key)) {
            "backspace" => {
                if (#at > 0) {
                    #chars = [...slice(#chars, 0, #at - 1), ...slice(#chars, #at)];
                    #at--;
                }
            }
            "delete" => { #chars = [...slice(#chars, 0, #at), ...slice(#chars, #at + 1)]; }
            "left" => { #at = max(#at - 1, 0); }
            "right" => { #at = min(#at + 1, len(#chars)); }
            "home", "ctrl+a" => { #at = 0; }
            "end", "ctrl+e" => { #at = len(#chars); }
            "ctrl+u" => {
                #chars = slice(#chars, #at);
                #at = 0;
            }
            "ctrl+k" => { #chars = slice(#chars, 0, #at); }
            "enter" => { return Outcome::Submit; }
            "escape", "ctrl+c", "eof" => { return Outcome::Cancel; }
            default => { return Outcome::Ignored; }
        }
        return null;
    }

    /**
     * Draw it across the first row of $rect, scrolled sideways to keep the cursor in view, and
     * put the cursor there when $focused: an unfocused field shows its text and leaves the
     * cursor to the view that has the keys
     */
    pub fn draw($screen, $rect, $focused = true) {
        if ($rect.is_empty()) {
            return null;
        }
        #scroll($rect.width);
        label($screen, $rect, join(slice(#chars, #left), ""), #style);
        if ($focused) {
            $screen.cursor($rect.col + #columns(#left, #at), $rect.row);
        }
    }

    /* The columns the characters from index $from up to $to take */
    fn columns($from, $to) {
        return utf8_width(join(slice(#chars, $from, max($to - $from, 0)), ""));
    }

    /*
     * Move #left so that the cursor, and the column of its own it needs after the text, are
     * within $width columns: not scrolled further than the text needs (or deleting leaves it off
     * the left edge), and never past the cursor
     */
    fn scroll($width) {
        while (#left > 0 && #columns(#left - 1, len(#chars)) + 1 <= $width) {
            #left--;
        }
        if (#at < #left) {
            #left = #at;
        }
        while (#columns(#left, #at) > $width - 1) {
            #left++;
        }
    }
}

/* ---- Views ------------------------------------------------------------------------------- */

/**
 * What a full-screen program's shell asks of each section it shows: a title, how to draw it in
 * a Rect, what a key does to it and what its keys are. The shell cuts the screen up, draws the
 * frame and routes each key to the view it belongs to; a view only answers. A view changes
 * nothing outside itself: handle() gives null, or a value the shell carries out (an action of
 * the program's own, a kind for each), so what a key does to the program is in one place. A
 * View is the shell's unit, not a widget's, so its handle() keeps that contract and has no
 * Ignored of its own: one built on a widget decides what to do with the widget's
 * Outcome::Ignored (nothing, usually, which is null, or a key of its own to take).
 *
 *     kind Inbox extends tui::View {
 *         fn _(#messages);
 *         pub fn title() { return "Inbox"; }
 *         pub fn draw($screen, $rect, $focused) { ... }
 *         pub fn handle($key) { ... }
 *         pub fn hints() { return [tui::Hint("j/k", "move")]; }
 *     }
 */
pub abstract kind View {
    /**
     * What it is called, for a border, a menu or a heading
     */
    pub abstract fn title();

    /**
     * Draw it in $rect; $focused is whether keys are going to this view, so it can show its
     * selection as such
     */
    pub abstract fn draw($screen, $rect, $focused);

    /**
     * Take a key that reached the view: null when the view dealt with it, or a value for the
     * shell to act on
     */
    pub abstract fn handle($key);

    /**
     * What its keys do, a list of Hint, for a line of hints and the list key_help() shows;
     * none unless the view says
     */
    pub fn hints() {
        return [];
    }
}

/* ---- Whole screens ----------------------------------------------------------------------- */

/**
 * A steady beat: when the next one is due, given the time now (seconds from monotonic_time(); it
 * is passed in, so it can be tested with times made up). A beat that comes late doesn't make up
 * for it with two: the next is an interval from when it came.
 */
pub kind Metronome {
    #next;

    /**
     * A beat every $interval seconds, the first due $interval after $now
     */
    fn _(#interval, $now) {
        #next = $now + #interval;
    }

    /**
     * Whether a beat is due
     */
    pub fn due($now) { return $now >= #next; }

    /**
     * Seconds until the next beat, or 0 when it is due
     */
    pub fn wait($now) { return max(#next - $now, 0); }

    /**
     * A beat has been taken at $now
     */
    pub fn beat($now) {
        #next += #interval;
        if (#next <= $now) {
            #next = $now + #interval;
        }
    }
}

/**
 * Run $draw($screen) and $handle($key) on a screen of its own until $handle gives something
 * other than null (or Outcome::Ignored, which a widget's handle() gives for a key that isn't its
 * business, so one can be passed straight in), which is what this gives; input that ends gives
 * null. Keys come from $input
 * (a term::Input), or from a new one. A program that shows one screen after another passes the
 * same one to each: keys that arrived together (typed ahead) are in it, and would be lost with a
 * new Input made for each screen.
 *
 * With $tick, time passes too: when no key has been pressed for $interval seconds, $tick() is
 * called and the screen drawn again, so a screen can move by itself (a clock, a match being
 * played). It ends the screen as $handle does, by giving something other than null.
 * The beat is steady: a key held down (auto-repeat) doesn't hold it up, since each wait is until the
 * next beat is due, kept by monotonic_time() in a Metronome, and not a full $interval from the key.
 *
 * Under gaz --tty nothing is drawn to a terminal: the screen is printed as $screen.snapshot()
 * where the keys say `snap`, and when it ends.
 */
pub fn interact($draw, $handle, $input = null, $tick = null, $interval = 0.25) {
    $input ??= term::Input();
    $metronome = $tick == null ? null : Metronome($interval, monotonic_time());
    return term::fullscreen(() -> {
        $size = term_size();
        $screen = Screen($size["cols"], $size["rows"]);
        while (true) {
            $screen.fit();
            $screen.clear();
            $draw($screen);
            if (!term_is_virtual()) {
                print($screen.render());
            }
            $key = next_key($input, $metronome);
            if ($key == null) {
                // the beat is due: time passes, whether or not keys have been coming
                $result = $tick();
                if ($result != null) {
                    return leave($screen, $input, $result);
                }
                $metronome.beat(monotonic_time());
                continue;
            }
            if (term_is_virtual() && $key["key"] == "snap") {
                show($screen, $input);
                continue;
            }
            if ($key["key"] == "resize") {
                // the window changed: the top of the loop fits the screen to it and draws it again
                continue;
            }
            if ($key["key"] == "eof") {
                if (term_is_virtual()) {
                    show($screen, $input, "the keys ran out");
                }
                return null;
            }
            $result = $handle($key);
            if ($result != null && $result != Outcome::Ignored) {
                return leave($screen, $input, $result);
            }
        }
    });
}

// The next key from $input, or null when $metronome's beat is due first
fn next_key($input, $metronome) {
    $timeout = null;
    if ($metronome != null) {
        $now = monotonic_time();
        if ($metronome.due($now)) {
            return null;
        }
        $timeout = $metronome.wait($now);
    }
    // under gaz --tty, a snap in the keys is one too
    return term_is_virtual() ? $input.read_or_snap($timeout) : $input.read($timeout);
}

// $row's number, right-aligned in $width columns
fn format_row($row, $width) {
    $number = to_string($row);
    return repeat(" ", $width - len($number) - 1) .. $number .. " ";
}

// $text without the spaces at its end
fn trim_end($text) {
    $end = len($text);
    while ($end > 0 && $text[$end - 1] == " ") {
        $end--;
    }
    return slice($text, 0, $end);
}

// Whether $text has an ASCII letter or digit in it
fn has_word($text) {
    for ($i = 0; $i < len($text); $i++) {
        $c = ord($text[$i]);
        if (($c >= 48 && $c <= 57) || ($c >= 65 && $c <= 90) || ($c >= 97 && $c <= 122)) {
            return true;
        }
    }
    return false;
}

// Under gaz --tty, $screen as text, headed by the keys that led to it and why it was shown
fn show($screen, $input, $why = "") {
    $typed = $input.typed();
    $heading = $typed == "" ? "at the start" : "after: " .. $typed;
    print("=== " .. $heading .. ($why == "" ? "" : " (" .. $why .. ")") .. " ===\n" .. $screen.snapshot());
}

// $result, which ends a screen; under gaz --tty the screen is shown first, as the last one seen
fn leave($screen, $input, $result) {
    if (term_is_virtual()) {
        show($screen, $input, "the screen ended");
    }
    return $result;
}

/**
 * The Rect $width by $height in the middle of $screen; one too big for the screen starts at its
 * top left corner
 */
pub fn centered($screen, $width, $height) {
    return Rect(max(intdiv($screen.cols - $width, 2), 0) + 1, max(intdiv($screen.rows - $height, 2), 0) + 1, $width, $height);
}

/**
 * Choose one of $items in a menu of a screen of its own: its index, or null if cancelled or
 * there is nothing to choose. $input is interact()'s. Needs a terminal.
 */
pub fn choose($items, $title = "", $input = null) {
    if (len($items) == 0) {
        return null;
    }
    $menu = Menu($items, $title);
    $picked = interact(
        $screen -> {
            $width = min($screen.cols, max(term::width($title) + 6, 4 + reduce($items, ($most, $item) -> max($most, term::width(to_string($item))), 0)));
            $height = min($screen.rows, len($items) + 2);
            $menu.draw($screen, centered($screen, $width, $height));
        },
        $key -> $menu.handle($key),
        $input
    );
    return $picked == Outcome::Select ? $menu.selected_index() : null;
}

// The rows of ask()'s box: the question in the top edge, a blank row, the field, the bottom edge
const ASK_HEIGHT = 4;
const ASK_WIDTH = 40;

/**
 * Ask a question on a screen of its own and give the answer, or null if cancelled. $initial is
 * what the field starts with. $input is interact()'s. Needs a terminal.
 */
pub fn ask($question, $initial = "", $input = null) {
    $field = TextField($initial);
    $answered = interact(
        $screen -> {
            $width = min($screen.cols, max(term::width($question) + 4, ASK_WIDTH));
            $box = centered($screen, $width, ASK_HEIGHT);
            box($screen, $box, $question);
            $field.draw($screen, $box.inset(2, 1).line(1));
        },
        $key -> $field.handle($key),
        $input
    );
    return $answered == Outcome::Submit ? $field.value() : null;
}
