/**
 * A small regular expression engine for GazLang: regex::matches($s, $pattern) tests whether
 * $s matches $pattern in full, regex::search($s, $pattern) whether $pattern occurs anywhere in
 * $s, regex::find($s, $pattern) the start index of the first (leftmost) match, or null,
 * regex::groups($s, $pattern) what the first match and each group in it took, and
 * regex::replace($s, $pattern, $with) every match replaced.
 *
 * Syntax: literal bytes, "." (any byte), "*" "+" "?" (repetition, greedy), "|" (alternation,
 * the first that matches wins), "(...)" (a group, which captures), "[...]" and "[^...]"
 * (character classes, with "a-z" ranges), "^" and "$" (start/end of string anchors).
 *
 * Escapes: "\" before anything but a letter or a digit is that byte ("\.", "\\", "\/");
 * "\t", "\n" and "\r" are a tab, a newline and a carriage return; "\d" a digit, "\w" a word
 * byte (a letter, a digit or "_") and "\s" a space (space, tab, newline or carriage return),
 * with "\D", "\W" and "\S" anything else, on their own or inside "[...]" ("[\d_]", "[^\s]").
 * The shorthands are std/chars.gaz's is_digit, is_alnum plus "_", and is_space, so they are
 * ASCII and read bytes, as everything here does. Any other letter or digit after "\" is an
 * error, so "\q" can't quietly mean "q". In a double-quoted string each "\" is written "\\";
 * a single-quoted one keeps it as it is: '\d+\.\d+'.
 *
 * No counted repetition: "{" and "}" are literal bytes, so regex::matches("a{3}", "a{3}") is
 * true and regex::matches("aaa", "a{3}") false.
 *
 * Which match is found is the leftmost, and of those the one the greedy repetitions and the
 * earlier alternatives give. No backreferences, no lookahead: patterns compile to a Thompson
 * NFA (Pike's VM, each thread carrying where its groups started and ended; plain GazLang) and
 * run in time linear in the string for a given pattern, so there is no catastrophic backtracking.
 *
 * The time for each byte of the string grows with the size of the compiled pattern, so that size
 * is capped: a pattern that compiles to more than 2000 instructions (each byte, range or
 * shorthand inside a "[...]" counting one more) is an error before anything is matched, and so
 * is one with more than 100 groups, since each thread carries a slot for each group's start and
 * end and copies them as it passes one. A date or an email address compiles to tens of
 * instructions and a few groups, an alternation of a hundred words to under a thousand
 * instructions, so only a pattern built to be expensive comes near either.
 */
namespace regex;

import "std/chars.gaz";

/*
 * The most instructions a pattern may compile to, and the most groups it may have, which
 * together bound the work done for each byte of the string: a group's slots are copied each
 * time a thread passes its "(" or ")", so groups cost by their number squared. At both limits a
 * byte costs about what it does at 2000 instructions without groups. ponytail: a trusted
 * pattern can't raise them; that needs an options argument or a compiled pattern value, once a
 * program has a bigger pattern to run.
 */
const MAX_INSTRUCTIONS = 2000;
const MAX_GROUPS = 100;

kind Parser {
    #pat;
    #pos;
    #len;
    // Groups so far, numbered from 1 by their "(" in the pattern, as the list groups() gives
    pub #groups = 0;

    fn _($pat) {
        #pat = $pat;
        #pos = 0;
        #len = len($pat);
    }

    fn peek() {
        if (#pos >= #len) { return null; }
        return #pat[#pos];
    }

    fn advance() {
        $c = #pat[#pos];
        #pos += 1;
        return $c;
    }

    fn expect($c) {
        if (#peek() != $c) {
            throw "regex: expected '" .. $c .. "' at " .. #pos .. " in /" .. #pat .. "/";
        }
        #advance();
    }

    pub fn parse() {
        $node = #parse_alt();
        if (#pos != #len) {
            throw "regex: unexpected '" .. #peek() .. "' at " .. #pos .. " in /" .. #pat .. "/";
        }
        return $node;
    }

    fn parse_alt() {
        $parts = [#parse_concat()];
        while (#peek() == "|") {
            #advance();
            $parts[] = #parse_concat();
        }
        if (len($parts) == 1) { return $parts[0]; }
        return {"op" => "alt", "parts" => $parts};
    }

    fn parse_concat() {
        $parts = [];
        while (#peek() != null && #peek() != "|" && #peek() != ")") {
            $parts[] = #parse_repeat();
        }
        if (len($parts) == 0) { return {"op" => "empty"}; }
        if (len($parts) == 1) { return $parts[0]; }
        return {"op" => "concat", "parts" => $parts};
    }

    fn parse_repeat() {
        $atom = #parse_atom();
        $c = #peek();
        if ($c == "*") { #advance(); return {"op" => "star", "child" => $atom}; }
        if ($c == "+") { #advance(); return {"op" => "plus", "child" => $atom}; }
        if ($c == "?") { #advance(); return {"op" => "opt", "child" => $atom}; }
        return $atom;
    }

    fn parse_atom() {
        $c = #peek();
        if ($c == null) {
            throw "regex: unexpected end of pattern in /" .. #pat .. "/";
        }
        if ($c == "(") {
            #advance();
            #groups += 1;
            if (#groups > MAX_GROUPS) {
                throw "regex: a pattern can have at most " .. MAX_GROUPS .. " groups, and this one (" .. #len .. " bytes) has more";
            }
            $n = #groups;
            $node = #parse_alt();
            #expect(")");
            return {"op" => "group", "n" => $n, "child" => $node};
        }
        if ($c == "[") { return #parse_class(); }
        if ($c == ".") { #advance(); return {"op" => "any"}; }
        if ($c == "^") { #advance(); return {"op" => "bol"}; }
        if ($c == "$") { #advance(); return {"op" => "eol"}; }
        if ($c == "\\") { return #escape(); }
        #advance();
        return {"op" => "lit", "c" => ord($c)};
    }

    fn parse_class() {
        #advance(); // '['
        $negate = false;
        if (#peek() == "^") {
            $negate = true;
            #advance();
        }
        $ranges = [];
        $chars = [];
        $sets = [];
        $first = true;
        while (#peek() != "]" || $first) {
            if (#peek() == null) {
                throw "regex: unterminated '[' in /" .. #pat .. "/";
            }
            $first = false;
            $at = #pos;
            $lo = #class_item();
            if ($lo["op"] == "class") {
                if (#starts_range()) {
                    #refuse_shorthand_range($at);
                }
                $sets[] = $lo["sets"][0];
            } else if (#starts_range()) {
                #advance(); // '-'
                $hi_at = #pos;
                $hi = #class_item();
                if ($hi["op"] == "class") {
                    #refuse_shorthand_range($hi_at);
                }
                if ($lo["c"] > $hi["c"]) {
                    #refuse_backwards_range($at, $lo["c"], $hi["c"]);
                }
                $ranges[] = [$lo["c"], $hi["c"]];
            } else {
                $chars[] = $lo["c"];
            }
        }
        #advance(); // ']'
        return {"op" => "class", "negate" => $negate, "ranges" => $ranges, "chars" => $chars, "sets" => $sets};
    }

    // Whether a "-" comes next with something after it other than the closing "]"
    fn starts_range() {
        $after = chars::char_at(#pat, #pos + 1);
        return #peek() == "-" && $after != "]" && $after != "";
    }

    // A shorthand is a set of bytes, so it can't be either end of a range
    fn refuse_shorthand_range($at) {
        $shorthand = slice(#pat, $at, 2);
        throw "regex: a range can't start or end at '" .. $shorthand .. "' at " .. $at .. " in /" .. #pat .. "/";
    }

    // A range whose end comes before its start would match nothing, which is never what was meant
    fn refuse_backwards_range($at, $lo, $hi) {
        $written = chr($lo) .. "-" .. chr($hi);
        $meant = chr($hi) .. "-" .. chr($lo);
        throw "regex: the range '" .. $written .. "' at " .. $at .. " in /" .. #pat .. "/ is backwards: write '" .. $meant .. "'";
    }

    // One byte of a class, as a literal, or a shorthand as a class
    fn class_item() {
        if (#peek() == "\\") { return #escape(); }
        return {"op" => "lit", "c" => ord(#advance())};
    }

    // What "\" and the byte after it mean, as a literal or a class of one shorthand
    fn escape() {
        $at = #pos;
        #advance(); // '\'
        $e = #peek();
        if ($e == null) {
            throw "regex: dangling '\\' in /" .. #pat .. "/";
        }
        #advance();
        if (in_array($e, ["d", "D", "w", "W", "s", "S"])) {
            $set = [shorthand($e), $e != lower($e)];
            return {"op" => "class", "negate" => false, "ranges" => [], "chars" => [], "sets" => [$set]};
        }
        $control = {"t" => "\t", "n" => "\n", "r" => "\r"};
        if (has_key($control, $e)) {
            return {"op" => "lit", "c" => ord($control[$e])};
        }
        if (chars::is_alnum($e)) {
            throw "regex: unknown escape '\\" .. $e .. "' at " .. $at .. " in /" .. #pat .. "/";
        }
        return {"op" => "lit", "c" => ord($e)};
    }
}

// The predicate of a shorthand's lowercase letter, std/chars.gaz's own
fn shorthand($letter) {
    return match (lower($letter)) {
        "d" => chars::is_digit,
        "w" => is_word,
        "s" => chars::is_space,
    };
}

// A letter, a digit or "_": what a name is made of
fn is_word($c) {
    return chars::is_alnum($c) || $c == "_";
}

// A pattern too big to run, named by its length since quoting it would be as long
fn refuse_size($pattern) {
    throw "regex: a pattern can compile to at most " .. MAX_INSTRUCTIONS .. " instructions, and this one (" .. len($pattern) .. " bytes) needs more";
}

/*
 * Compiles an AST to a flat instruction list ("prog"): char/any/class/bol/eol consume or
 * assert, split/jmp are epsilon transitions (split's x first, the greedy or earlier way), save
 * records the position in a slot (group n's start in 2n, its end in 2n + 1), match ends the
 * program. Instructions flow to the next index by default; split and jmp give explicit
 * targets, patched in once the size of what they jump over is known.
 */
kind Compiler {
    pub #prog;
    #pattern;
    // The instructions so far, and the entries of each class, which are tested one by one
    #size = 0;

    fn _($pattern) {
        #prog = [];
        #pattern = $pattern;
    }

    pub fn emit($instr) {
        #prog[] = $instr;
        #count(1);
        return len(#prog) - 1;
    }

    // Stops as soon as the program is too big, so refusing a huge pattern costs no more
    fn count($n) {
        #size += $n;
        if (#size > MAX_INSTRUCTIONS) {
            refuse_size(#pattern);
        }
    }

    pub fn compile($node) {
        $op = $node["op"];
        if ($op == "empty") { return; }
        if ($op == "lit") { #emit({"op" => "char", "c" => $node["c"]}); return; }
        if ($op == "any") { #emit({"op" => "any"}); return; }
        if ($op == "class") {
            #emit($node);
            #count(len($node["ranges"]) + len($node["chars"]) + len($node["sets"]));
            return;
        }
        if ($op == "bol") { #emit({"op" => "bol"}); return; }
        if ($op == "eol") { #emit({"op" => "eol"}); return; }
        if ($op == "concat") {
            foreach ($node["parts"] as $part) { #compile($part); }
            return;
        }
        if ($op == "group") {
            #emit({"op" => "save", "slot" => 2 * $node["n"]});
            #compile($node["child"]);
            #emit({"op" => "save", "slot" => 2 * $node["n"] + 1});
            return;
        }
        if ($op == "alt") {
            $parts = $node["parts"];
            $jmp_idxs = [];
            for ($i = 0; $i < len($parts) - 1; $i += 1) {
                $split_idx = #emit({"op" => "split", "x" => 0, "y" => 0});
                #prog[$split_idx]["x"] = len(#prog);
                #compile($parts[$i]);
                $jmp_idxs[] = #emit({"op" => "jmp", "target" => 0});
                #prog[$split_idx]["y"] = len(#prog);
            }
            #compile($parts[len($parts) - 1]);
            $end = len(#prog);
            foreach ($jmp_idxs as $jmp_idx) { #prog[$jmp_idx]["target"] = $end; }
            return;
        }
        if ($op == "star") {
            $l1 = len(#prog);
            $split_idx = #emit({"op" => "split", "x" => 0, "y" => 0});
            #prog[$split_idx]["x"] = len(#prog);
            #compile($node["child"]);
            #emit({"op" => "jmp", "target" => $l1});
            #prog[$split_idx]["y"] = len(#prog);
            return;
        }
        if ($op == "plus") {
            $l1 = len(#prog);
            #compile($node["child"]);
            $split_idx = #emit({"op" => "split", "x" => $l1, "y" => 0});
            #prog[$split_idx]["y"] = len(#prog);
            return;
        }
        if ($op == "opt") {
            $split_idx = #emit({"op" => "split", "x" => 0, "y" => 0});
            #prog[$split_idx]["x"] = len(#prog);
            #compile($node["child"]);
            #prog[$split_idx]["y"] = len(#prog);
            return;
        }
        throw "regex: internal error, unknown node '" .. $op .. "'";
    }
}

/*
 * The program for $pattern, and how many groups it has. No instruction takes more than five
 * bytes of the pattern (a range of two escapes, "\.-\/"), so a longer pattern is refused before
 * it is read.
 */
fn compile($pattern) {
    if (len($pattern) > 5 * MAX_INSTRUCTIONS) {
        refuse_size($pattern);
    }
    $parser = Parser($pattern);
    $ast = $parser.parse();
    $c = Compiler($pattern);
    $c.compile($ast);
    $c.emit({"op" => "match"});
    return [$c.prog, $parser.groups];
}

fn class_matches($instr, $byte) {
    $hit = false;
    foreach ($instr["ranges"] as $range) {
        if ($byte >= $range[0] && $byte <= $range[1]) { $hit = true; }
    }
    foreach ($instr["chars"] as $c) {
        if ($byte == $c) { $hit = true; }
    }
    foreach ($instr["sets"] as [$predicate, $negated]) {
        if ($predicate(chr($byte)) != $negated) { $hit = true; }
    }
    if ($instr["negate"]) { return !$hit; }
    return $hit;
}

fn consumes($instr, $byte) {
    $op = $instr["op"];
    if ($op == "char") { return $instr["c"] == $byte; }
    if ($op == "any") { return true; }
    if ($op == "class") { return class_matches($instr, $byte); }
    return false;
}

fn blanks($n) {
    $r = [];
    for ($i = 0; $i < $n; $i += 1) { $r[] = false; }
    return $r;
}

/*
 * Runs a program (Pike's thread-list NFA simulation, no backtracking) against $s from $start.
 * The threads of a step are in priority order, and each carries its slots. When one reaches
 * match it is the best that can end here, so the threads after it are dropped, while those
 * before it run on in case they match later: that is what makes the repetitions greedy and
 * the first alternative win. Unanchored also starts a new thread at every later position, at
 * the lowest priority, until something has matched, so the match found is the leftmost; full
 * only counts a match that ends at the end of $s.
 */
kind Matcher {
    #prog;
    #slots;
    #len_s;
    #mark;
    #list;

    fn _($compiled, $len_s) {
        [#prog, $groups] = $compiled;
        #slots = 2 * ($groups + 1);
        #len_s = $len_s;
    }

    /*
     * Follows epsilon transitions (split, jmp, save, satisfied anchors) from $pc, adding every
     * byte-consuming or match instruction reached to #list with the slots that led to it, each
     * instruction only once per step (the first way there has the priority).
     */
    fn add($pc, $sp, $slots) {
        if (#mark[$pc]) { return; }
        #mark[$pc] = true;
        $instr = #prog[$pc];
        $op = $instr["op"];
        if ($op == "jmp") {
            #add($instr["target"], $sp, $slots);
        } else if ($op == "split") {
            #add($instr["x"], $sp, $slots);
            #add($instr["y"], $sp, $slots);
        } else if ($op == "save") {
            $slots[$instr["slot"]] = $sp;
            #add($pc + 1, $sp, $slots);
        } else if ($op == "bol") {
            if ($sp == 0) {
                #add($pc + 1, $sp, $slots);
            }
        } else if ($op == "eol") {
            if ($sp == #len_s) {
                #add($pc + 1, $sp, $slots);
            }
        } else {
            #list[] = [$pc, $slots];
        }
    }

    // A thread starting at $sp, at the lowest priority
    fn start($sp) {
        $slots = [$sp];
        for ($i = 1; $i < #slots; $i += 1) {
            $slots[] = null;
        }
        #add(0, $sp, $slots);
    }

    // The slots of the match found (the whole match in 0 and 1), or null
    pub fn run($s, $start, $unanchored, $full) {
        #list = [];
        #mark = blanks(len(#prog));
        #start($start);
        $matched = null;
        $sp = $start;
        while (true) {
            $at_end = $sp >= #len_s;
            $byte = null;
            if (!$at_end) {
                $byte = ord($s[$sp]);
            }
            $threads = #list;
            #list = [];
            #mark = blanks(len(#prog));
            foreach ($threads as [$pc, $slots]) {
                $instr = #prog[$pc];
                if ($instr["op"] == "match") {
                    if ($full && !$at_end) {
                        continue;
                    }
                    // The best match ending here: the threads after it have lower priority
                    $slots[1] = $sp;
                    $matched = $slots;
                    break;
                }
                if (!$at_end && consumes($instr, $byte)) {
                    #add($pc + 1, $sp + 1, $slots);
                }
            }
            if ($at_end) {
                break;
            }
            if ($matched == null && $unanchored) {
                #start($sp + 1);
            }
            $nothing_left = len(#list) == 0;
            if ($nothing_left && ($matched != null || !$unanchored)) {
                break;
            }
            $sp += 1;
        }
        return $matched;
    }
}

/**
 * Whether $s matches $pattern in full (as if anchored at both ends).
 */
pub fn matches($s, $pattern) {
    return Matcher(compile($pattern), len($s)).run($s, 0, false, true) != null;
}

/**
 * The start index of the first (leftmost) place $pattern occurs in $s, or null.
 */
pub fn find($s, $pattern) {
    $slots = Matcher(compile($pattern), len($s)).run($s, 0, true, false);
    return $slots == null ? null : $slots[0];
}

/**
 * Whether $pattern occurs anywhere in $s.
 */
pub fn search($s, $pattern) {
    return find($s, $pattern) != null;
}

/**
 * What the first match took, and each group in it: [whole match, group 1, group 2, ...] with
 * groups numbered by their "(" from the left, a group that took no part null, and a group
 * repeated what it took the last time. Null when nothing matches.
 */
pub fn groups($s, $pattern) {
    $slots = Matcher(compile($pattern), len($s)).run($s, 0, true, false);
    if ($slots == null) {
        return null;
    }
    return taken($s, $slots);
}

// What the match whose slots are $slots took, and each of its groups, as groups() gives them
fn taken($s, $slots) {
    $taken = [];
    for ($group = 0; $group * 2 < len($slots); $group++) {
        $taken[] = captured($s, $slots, $group);
    }
    return $taken;
}

// What group $group took, from its slots, or null when it took no part
fn captured($s, $slots, $group) {
    $from = $slots[2 * $group];
    $to = $slots[2 * $group + 1];
    if ($from == null || $to == null) {
        return null;
    }
    return slice($s, $from, $to - $from);
}

/**
 * $s with every match of $pattern replaced, looking for the next match where the last ended.
 * An empty match replaces nothing and the search moves on a byte: replace("abc", "x*", "-") is
 * "-a-b-c-".
 *
 * $with is a string or a function. In a string, "$0" is the whole match, "$1" to "$9" (and on,
 * as many digits as follow) a group, numbered by its "(" from the left, and "$$" a "$"; a group
 * that took no part gives "". A group the pattern hasn't got, or a "$" followed by anything
 * else, is an error before anything is replaced:
 *
 *     regex::replace("2026-10-05", '(\d+)-(\d+)-(\d+)', "$3/$2/$1")   // "05/10/2026"
 *     regex::replace("5", '\d', "$$$0")                               // "$5"
 *
 * A function is given each match's groups, as regex::groups() gives them, and returns the
 * replacement, which must be a string:
 *
 *     regex::replace("a1b22", '\d+', $g -> to_string(to_int($g[0]) * 2))   // "a2b44"
 */
pub fn replace($s, $pattern, $with) {
    $compiled = compile($pattern);
    [, $groups] = $compiled;
    $replacement = replacement($with, $groups, $pattern);
    $matcher = Matcher($compiled, len($s));
    $out = "";
    $at = 0;
    while ($at <= len($s)) {
        $slots = $matcher.run($s, $at, true, false);
        if ($slots == null) {
            break;
        }
        [$from, $to] = [$slots[0], $slots[1]];
        $out ..= slice($s, $at, $from - $at) .. $replacement(taken($s, $slots));
        if ($to == $from) {
            $out ..= slice($s, $from, 1);
            $to += 1;
        }
        $at = $to;
    }
    // An empty match at the very end steps past it, with nothing left to copy
    if ($at > len($s)) {
        return $out;
    }
    return $out .. slice($s, $at);
}

// $with as a function from a match's groups to its replacement, checked before any match
fn replacement($with, $groups, $pattern) {
    if (type_of($with) == "function") {
        return $taken -> checked_text($with($taken));
    }
    if (type_of($with) != "string") {
        throw "regex: replace() takes a string or a function, not " .. type_of($with);
    }
    $pieces = pieces($with, $groups, $pattern);
    return $taken -> filled($pieces, $taken);
}

// A replacement's pieces with each group number replaced by what it took, "" for no part
fn filled($pieces, $taken) {
    $text = "";
    foreach ($pieces as $piece) {
        if (type_of($piece) == "int") {
            $text ..= $taken[$piece] ?? "";
        } else {
            $text ..= $piece;
        }
    }
    return $text;
}

// What a function given as $with returned, which must be a string
fn checked_text($text) {
    if (type_of($text) != "string") {
        throw "regex: replace()'s function must return a string, not " .. type_of($text);
    }
    return $text;
}

/*
 * A replacement string read once: its text and the group numbers in it, in order, each group
 * one the pattern has.
 */
fn pieces($with, $groups, $pattern) {
    $pieces = [];
    $at = 0;
    while (true) {
        $dollar = index_of($with, "$", $at);
        if ($dollar == null) {
            $pieces[] = slice($with, $at);
            return $pieces;
        }
        $pieces[] = slice($with, $at, $dollar - $at);
        $at = $dollar + 1;
        $digits = chars::span($with, $at, chars::is_digit);
        if (chars::char_at($with, $at) == "$") {
            $pieces[] = "$";
            $at += 1;
        } else if ($digits == 0) {
            throw "regex: a '$' in a replacement names a group ($0, $1, ...): write $$ for a '$', at " .. $dollar .. " in \"" .. $with .. "\"";
        } else {
            $group = to_int(slice($with, $at, $digits));
            if ($group > $groups) {
                throw "regex: the replacement names group " .. $group .. ", and /" .. $pattern .. "/ has " .. $groups;
            }
            $pieces[] = $group;
            $at += $digits;
        }
    }
}
