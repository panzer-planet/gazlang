// Prints a file's tokens as `gazlang --tokens -f FILE` does, one LINE TYPE VALUE per line:
// php bin/gazlang -f selfhost/tokens.gaz -- FILE
include "lexer.gaz";

if (len(args()) != 1) {
    print_error("Usage: gazlang -f selfhost/tokens.gaz -- FILE\n");
    exit(2);
}

$lexer = Lexer(read_file(args()[0]));
try {
    $type = null;
    while ($type != "EOF") {
        $token = $lexer.get_next_token();
        echo $token;
        $type = $token.type;
    }
} catch (LexError $e) {
    // Raised again from the top level, so no trace of the lexer's calls is printed under it
    error($e.message);
}
