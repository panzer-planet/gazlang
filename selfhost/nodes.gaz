// The tree selfhost/parser.gaz builds: a port of src/AST, one class per node, with the PHP
// classes' names and fields, so the two parsers can be read side by side.
//
// parts() is every field the PHP parser writes, by name, in the order the PHP class declares
// them. GazLang can't list an object's fields, so each node lists its own: selfhost/ast.gaz
// prints a tree from it, and the parser walks one to find the variables a lambda uses.
//
// This file has no top level code, so it can be included.

abstract class AST {
    #line = null;
    #file = null;

    abstract fn parts();
}

// A node that is one token: a literal or a variable
abstract class TokenValueNodeAST extends AST {
    #token;
    #value;

    fn _($token) {
        #token = $token;
        #value = $token.value;
    }

    fn parts() {
        return {"token" => #token, "value" => #value};
    }
}

class NumAST extends TokenValueNodeAST {}

class StringAST extends TokenValueNodeAST {}

class NullAST extends TokenValueNodeAST {
    fn _($token) {
        ##_($token);
        #value = null;
    }
}

class BooleanAST extends TokenValueNodeAST {
    fn _($token) {
        ##_($token);
        #value = $token.type == "TRUE";
    }
}

// #value is the token's text, "$name" or "@name"
class VariableAST extends TokenValueNodeAST {
    fn is_global() {
        return #value[0] == "@";
    }
}

class UnaryOpAST extends AST {
    #op;
    #expr;

    fn _($op, $expr) {
        #op = $op;
        #expr = $expr;
    }

    fn parts() {
        return {"op" => #op, "expr" => #expr};
    }
}

class BinOpAST extends AST {
    #left;
    #token;
    #op;
    #right;

    fn _($left, $op, $right) {
        #left = $left;
        #token = $op;
        #op = $op;
        #right = $right;
    }

    fn parts() {
        return {"left" => #left, "token" => #token, "op" => #op, "right" => #right};
    }
}

class TernaryAST extends AST {
    #condition;
    #then;
    #else;

    fn _($condition, $then, $else) {
        #condition = $condition;
        #then = $then;
        #else = $else;
    }

    fn parts() {
        return {"condition" => #condition, "then" => #then, "else" => #else};
    }
}

abstract class AbstractStatementAST extends AST {
    #expr;

    fn _($expr) {
        #expr = $expr;
    }

    fn parts() {
        return {"expr" => #expr};
    }
}

class StatementAST extends AbstractStatementAST {}

class EchoStatementAST extends AbstractStatementAST {}

class CompoundAST extends AST {
    #statements = [];

    fn parts() {
        return {"statements" => #statements};
    }
}

// A list [1, 2] or, with #map, a map {"k" => 1}; each entry is [key, value], the key null in a list
class ArrayLiteralAST extends AST {
    #entries;
    #map;

    fn _($entries, $map = false) {
        #entries = $entries;
        #map = $map;
    }

    fn parts() {
        return {"entries" => #entries, "map" => #map};
    }
}

// $target[$index], or $target[] when #index is null
class IndexAST extends AST {
    #target;
    #index;

    fn _($target, $index) {
        #target = $target;
        #index = $index;
    }

    fn parts() {
        return {"target" => #target, "index" => #index};
    }
}

// $target.name, or #name when the target is a ThisAST
class PropertyAST extends AST {
    #target;
    #name;
    // Whether a #name is a field rather than a method, which the parser knows once the classes are resolved
    #field = false;
    // A #name's MemberUse, which the parser checks once the classes are resolved; not part of the tree
    #use = null;

    fn _($target, $name) {
        #target = $target;
        #name = $name;
    }

    fn parts() {
        return {"target" => #target, "name" => #name, "field" => #field};
    }
}

// A call on a value: $f(1), pick()(2)
class CallValueAST extends AST {
    #callee;
    #args;

    fn _($callee, $args) {
        #callee = $callee;
        #args = $args;
    }

    fn parts() {
        return {"callee" => #callee, "args" => #args};
    }
}

// $obj.name(args) or #name(args)
class MethodCallAST extends AST {
    #property;
    #args;

    fn _($property, $args) {
        #property = $property;
        #args = $args;
    }

    fn parts() {
        return {"property" => #property, "args" => #args};
    }
}

// A call by name: add(1, 2)
class FunctionCallAST extends AST {
    #name;
    #args;

    fn _($name, $args) {
        #name = $name;
        #args = $args;
    }

    fn parts() {
        return {"name" => #name, "args" => #args};
    }
}

// A bare function or class name used as a value
class FunctionRefAST extends AST {
    #name;

    fn _($name) {
        #name = $name;
    }

    fn parts() {
        return {"name" => #name};
    }
}

// = and the compound assignments; #token says which
class AssignAST extends AST {
    #left;
    #token;
    #right;

    fn _($left, $token, $right) {
        #left = $left;
        #token = $token;
        #right = $right;
    }

    fn parts() {
        return {"left" => #left, "token" => #token, "right" => #right};
    }
}

class IncrementAST extends AST {
    #target;
    #op;
    #prefix;

    fn _($target, $op, $prefix) {
        #target = $target;
        #op = $op;
        #prefix = $prefix;
    }

    fn parts() {
        return {"target" => #target, "op" => #op, "prefix" => #prefix};
    }
}

// [$a, $b] on the left of = or in a foreach
class ListPatternAST extends AST {
    #targets;

    fn _($targets) {
        #targets = $targets;
    }

    fn parts() {
        return {"targets" => #targets};
    }
}

class LambdaAST extends AST {
    #params;
    #defaults;
    #arity;
    #body;
    // The outer variables it uses, which are copied into the closure when it is created
    #captures;
    // The captured name that holds the closure itself ($f = <lambda using $f>), or null
    #self = null;

    fn _($params, $defaults, $arity, $body, $captures) {
        #params = $params;
        #defaults = $defaults;
        #arity = $arity;
        #body = $body;
        #captures = $captures;
    }

    fn parts() {
        return {"params" => #params, "defaults" => #defaults, "arity" => #arity, "body" => #body, "captures" => #captures, "self" => #self};
    }
}

// #subject is null when the arms are conditions; each arm is [values, body, is_block],
// the values null for the default arm
class MatchAST extends AST {
    #subject;
    #arms;

    fn _($subject, $arms) {
        #subject = $subject;
        #arms = $arms;
    }

    fn parts() {
        return {"subject" => #subject, "arms" => #arms};
    }
}

// The variable or # that a path of elements and fields starts at, or null if it starts anywhere else
fn path_root($node) {
    while (is_a($node, IndexAST) || is_a($node, PropertyAST)) {
        $node = $node.target;
    }

    return is_a($node, VariableAST) || is_a($node, ThisAST) ? $node : null;
}

// # alone, the object a method runs on
class ThisAST extends AST {
    fn parts() {
        return {};
    }
}

// #else_if is the IfStatementAST of an else if, #else_body the block of an else; at most one is set
class IfStatementAST extends AST {
    #condition;
    #if_body;
    #else_if;
    #else_body;

    fn _($condition, $if_body, $else_if = null, $else_body = null) {
        #condition = $condition;
        #if_body = $if_body;
        #else_if = $else_if;
        #else_body = $else_body;
    }

    fn parts() {
        return {"condition" => #condition, "if_body" => #if_body, "else_if" => #else_if, "else_body" => #else_body};
    }
}

// #step is a for loop's third clause, which runs after the body and on continue
class WhileStatementAST extends AST {
    #condition;
    #body;
    #step;

    fn _($condition, $body, $step = null) {
        #condition = $condition;
        #body = $body;
        #step = $step;
    }

    fn parts() {
        return {"condition" => #condition, "body" => #body, "step" => #step};
    }
}

// #key is null without one; #value is a variable or a list pattern of them
class ForeachStatementAST extends AST {
    #iterable;
    #key;
    #value;
    #body;

    fn _($iterable, $key, $value, $body) {
        #iterable = $iterable;
        #key = $key;
        #value = $value;
        #body = $body;
    }

    fn parts() {
        return {"iterable" => #iterable, "key" => #key, "value" => #value, "body" => #body};
    }
}

// break or continue; #token says which
class LoopControlAST extends AST {
    #token;

    fn _($token) {
        #token = $token;
    }

    fn parts() {
        return {"token" => #token};
    }
}

class ReturnStatementAST extends AST {
    #expr;

    fn _($expr) {
        #expr = $expr;
    }

    fn parts() {
        return {"expr" => #expr};
    }
}

class DeleteStatementAST extends AST {
    #target;

    fn _($target) {
        #target = $target;
    }

    fn parts() {
        return {"target" => #target};
    }
}

// A function, or a method when #class names its class; an abstract method's body is empty
class FunctionDeclarationAST extends AST {
    #name;
    #params;
    #defaults;
    #body;
    #arity;
    #class = null;
    #abstract = false;

    fn _($name, $params, $defaults, $body, $arity) {
        #name = $name;
        #params = $params;
        #defaults = $defaults;
        #body = $body;
        #arity = $arity;
    }

    fn parts() {
        return {
            "name" => #name, "params" => #params, "defaults" => #defaults, "body" => #body,
            "arity" => #arity, "class" => #class, "abstract" => #abstract,
        };
    }
}

// ##name, the parent class's version of a method: a bound method, or a call when #args is a list
class ParentMethodAST extends AST {
    #name;
    #args;
    // The class whose version runs, which the parser knows once the classes are resolved
    #definer = "";

    fn _($name, $args) {
        #name = $name;
        #args = $args;
    }

    fn parts() {
        return {"name" => #name, "args" => #args, "definer" => #definer};
    }
}

// Each catch is [class name or null, variable, block]
class TryStatementAST extends AST {
    #body;
    #catches;
    #finally;

    fn _($body, $catches, $finally) {
        #body = $body;
        #catches = $catches;
        #finally = $finally;
    }

    fn parts() {
        return {"body" => #body, "catches" => #catches, "finally" => #finally};
    }
}

class ClassDeclarationAST extends AST {
    #name;
    #parent;
    #abstract;
    // Each declared field's default, or null, by name
    #fields = {};
    // The line each field is declared on, for errors about it
    #field_lines = {};
    // Each declared method's FunctionDeclarationAST, by name
    #methods = {};
    // Worked out once the whole program is read: every field, the parent's first, with the
    // class that declares it; every concrete method with the class whose version runs; and
    // every abstract method still to be defined, with the class that declares it
    #layout = {};
    #members = {};
    #abstract_methods = {};
    // Whether those three have been worked out
    #resolved = false;

    fn _($name, $parent, $abstract) {
        #name = $name;
        #parent = $parent;
        #abstract = $abstract;
    }

    fn parts() {
        return {
            "name" => #name, "parent" => #parent, "abstract" => #abstract, "fields" => #fields,
            "field_lines" => #field_lines, "methods" => #methods, "layout" => #layout,
            "members" => #members, "abstract_methods" => #abstract_methods,
        };
    }
}
