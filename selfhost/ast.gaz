// Prints a file's tree as `gazlang --ast -f FILE` does (see src/AST/Dumper.php for the format):
// php bin/gazlang -f selfhost/ast.gaz -- FILE
include "parser.gaz";

class Dumper {
    // What AST\Dumper leaves out: where a node is, which the "@" lines and each node's line
    // show, the code generator's (existing), bookkeeping derived from what is shown (resolved),
    // or standing in for PHP's side tables keyed by object (use and class_use, which PHP's nodes
    // don't have)
    const SKIPPED = ["line", "file", "existing", "resolved", "use", "class_use"];

    // The file of the last node that had a line, false before the first
    #file = false;

    // Print a tree. Each thing still to print is [label, value, indentation], the label being
    // what it is to its parent with the ": " after it, or nothing for the root. A stack
    // rather than recursion: a chain of operators is as deep on its left as it is long.
    fn dump($root) {
        $stack = [["", $root, ""]];
        while (len($stack) > 0) {
            $last = len($stack) - 1;
            [$label, $value, $indent] = $stack[$last];
            delete $stack[$last];

            $type = type_of($value);
            $children = null;
            if ($type == "object" && is_a($value, AST)) {
                // A node nothing was read for, like a block, has no line and belongs to no file
                if ($value.line != null && $value.file != #file) {
                    #file = $value.file;
                    echo "@ " .. #literal($value.file);
                }
                // "class NumAST" without the "class " and the "AST"
                $name = slice(to_string(class_of($value)), 6, -3);
                echo $indent .. $label .. $name .. ($value.line == null ? "" : " {$value.line}");
                $children = fields($value);
                foreach (#SKIPPED as $name) {
                    if (has_key($children, $name)) {
                        delete $children[$name];
                    }
                }
            } else if ($type == "object") {
                // A token, which prints as --tokens shows it
                echo $indent .. $label .. $value;
            } else if (($type == "list" || $type == "map") && !#is_plain($value)) {
                echo $indent .. slice($label, 0, -1);
                $children = $value;
            } else {
                echo $indent .. $label .. #literal($value);
            }

            // A node's fields or a list or map's elements, each labelled with its name or key.
            // The last goes on first, so the first comes off, and is printed, next.
            if ($children != null) {
                $labels = keys($children);
                for ($i = len($labels) - 1; $i >= 0; $i--) {
                    $stack[] = ["{$labels[$i]}: ", $children[$labels[$i]], $indent .. "  "];
                }
            }
        }
    }

    // A plain value as a literal: a list prints its elements as literals, so a string is
    // quoted as the lexer read it. PHP can't tell an empty map from an empty list, so both are [].
    fn literal($value) {
        return $value == {} ? "[]" : slice(to_string([$value]), 1, -1);
    }

    // Whether a list or map holds only scalars, at any depth, so it can be written as a literal
    fn is_plain($values) {
        foreach ($values as $value) {
            $type = type_of($value);
            if ($type == "object" || (($type == "list" || $type == "map") && !#is_plain($value))) {
                return false;
            }
        }

        return true;
    }
}

if (len(args()) != 1) {
    print_error("Usage: gazlang -f selfhost/ast.gaz -- FILE\n");
    exit(2);
}

$path = args()[0];
try {
    $root = Parser(Lexer(read_file($path)), $path).parse();
} catch (ParseError $e) {
    // Raised again from the top level, so no trace of the parser's calls is printed under it
    error($e.message);
}
Dumper().dump($root);
